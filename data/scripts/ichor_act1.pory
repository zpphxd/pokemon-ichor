// Phase 2, Act I on the mainland: scripts shared between maps.
// design/phase2/BUILD.md lists them; design/phase2/SCRIPT.md has the words.

text Ichor_Text_NameNausikles { "NAUSIKLES" }

// ---------------------------------------------------------------------------
// The Euploia's ferry (SCRIPT.md Part 2, "Nausikles as the ferry").
// In Act I it runs Akti and Emporion. The revised map puts Aigina's stop in
// Act II: world-act2 sets FLAG_ICHOR_FERRY_TO_AEGINA at its beat 46, which
// opens the stop and Aigina Town's north gate, and adds the choice here. On a
// quay Nausikles puts the player on deck; on deck, "Ready to make port?" sails
// to the chosen quay. The destination rides in FLAG_ICHOR_FERRY_TO_EMPORION
// (clear: Akti), because temp vars don't survive the warp to the deck.
// ---------------------------------------------------------------------------

// Called from Nausikles on a quay. VAR_0x8004: the quay he stands on
// (0 Akti, 1 Aigina, 2 Emporion).
script Ichor_EventScript_FerryQuay {
    lock
    faceplayer
    setspeaker(Ichor_Text_NameNausikles)
    setvar(VAR_ICHOR_FERRY_DEST, 0)
    msgbox(format("Where to? Wind's fair, more or less."))
    if (flag(FLAG_ICHOR_AKROPOLIS_RECOVERED)) {
        dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
            "AKTI", "EMPORION", "ASTYRA", "KALDERA", "STAY")
        if (var(VAR_RESULT) < 4) {
            copyvar(VAR_ICHOR_FERRY_DEST, VAR_RESULT)
            addvar(VAR_ICHOR_FERRY_DEST, 1)
            goto(Ichor_EventScript_FerryBoard)
        }
    } elif (var(VAR_0x8004) == 2) {
        dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, "AKTI", "STAY")
        if (var(VAR_RESULT) == 0) {
            clearflag(FLAG_ICHOR_FERRY_TO_EMPORION)
            goto(Ichor_EventScript_FerryBoard)
        }
    } else {
        dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, "EMPORION", "STAY")
        if (var(VAR_RESULT) == 0) {
            setflag(FLAG_ICHOR_FERRY_TO_EMPORION)
            goto(Ichor_EventScript_FerryBoard)
        }
    }
    msgbox(format("Suit yourself. I'll be here. The boat'll be here. Probably."))
    release
}

script Ichor_EventScript_FerryBoard {
    msgbox(format("Good. Mind the oars. They don't mind you."))
    closemessage
    playse(SE_EXIT)
    fadescreen(FADE_TO_BLACK)
    // The deck's boarding tile (BUILD.md's arrival table).
    warp(MAP_TRIREME_EUPLOIA_DECK, 0)
    waitstate
    release
}

// Called from Nausikles on deck once FLAG_ICHOR_CROSSING_DONE is set.
script Ichor_EventScript_FerryDeck {
    lock
    faceplayer
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("Ready to make port?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("No rush. The sea's not going anywhere. That's its whole trick."))
        release
        end
    }
    closemessage
    fadescreen(FADE_TO_BLACK)
    // world-act2 adds an Aigina destination of its own.
    if (var(VAR_ICHOR_FERRY_DEST) == 4) {
        warpsilent(MAP_KALDERA, 19, 34)
    } elif (var(VAR_ICHOR_FERRY_DEST) == 3) {
        warpsilent(MAP_ASTYRA_HARBOR, 24, 13)
    } elif (var(VAR_ICHOR_FERRY_DEST) == 2) {
        warpsilent(MAP_EMPORION_HARBOR, 30, 16)
    } elif (var(VAR_ICHOR_FERRY_DEST) == 1) {
        warpsilent(MAP_AKTI_TOWN, 9, 10)
    } elif (flag(FLAG_ICHOR_FERRY_TO_EMPORION)) {
        // Emporion's quay, the Euploia's berth (BUILD.md's arrival table)
        warpsilent(MAP_EMPORION_HARBOR, 30, 16)
    } else {
        warpsilent(MAP_AKTI_TOWN, 9, 10)
    }
    waitstate
    release
}

// ---------------------------------------------------------------------------
// The end of beat 10C: the Euploia makes Emporion, and beat 11 plays on her
// berth in the harbor district (data/maps/EmporionHarbor/scripts.pory). The ferry
// is bound for Akti from there.
// ---------------------------------------------------------------------------
script Ichor_EventScript_EuploiaMakesEmporion {
    setflag(FLAG_ICHOR_CROSSING_DONE)
    clearflag(FLAG_ICHOR_FERRY_TO_EMPORION)
    fadescreen(FADE_TO_BLACK)
    warpsilent(MAP_EMPORION_HARBOR, 30, 16)
    waitstate
}
