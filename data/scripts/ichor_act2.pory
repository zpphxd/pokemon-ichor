// Act II's shared scene scripts (design/phase3/BUILD.md: the scenes agent's file).
// Scripts here are called from more than one map, or will be when later batches
// land: receiving the act's relics and pages, so the obtain text and the flags
// they set live in one place.

// The Girdle of Herakles (beat 34, Silenos's contest): a relic, so it is the engine's
// item. The engine sets FLAG_ICHOR_GOT_GIRDLE_OF_HERAKLES whenever it enters the bag
// (ENGINE_API.md §2, "Giving a relic"), and the drum in the Neistan Gate checks it.
script EventScript_IchorAct2_ReceiveGirdle {
    setspeaker(SP_NAME_NONE)
    giveitem(ITEM_GIRDLE_OF_HERAKLES)
    closemessage
}

// Daedalus's pages (LABYRINTH.md): page III, the theater's crane, from Silenos.
// The pages are FLAG_ICHOR_PAGES_START + n, page I at + 0.
script EventScript_IchorAct2_ReceiveDaedalusPage3 {
    setflag(FLAG_ICHOR_PAGES_START + 2)
    setspeaker(SP_NAME_NONE)
    playfanfare(MUS_ICHOR_OBTAIN_KEY_ITEM)
    message(format("{PLAYER} received Daedalus's page III!"))
    waitmessage
    waitfanfare
    closemessage
}

// ICHOR_STUB_DIG: excavation isn't built, but its names are fixed (ENGINE_API §8):
//   a daily spot:    setvar(VAR_0x8004, <spot>), setvar(VAR_0x8005, ICHOR_DIG_ACT_II),
//                    goto(EventScript_IchorDigSpot)
//   a one-time find: setvar(VAR_0x8004, <find>), setvar(VAR_0x8005, ITEM_...),
//                    goto(EventScript_IchorDigFixed)
// Act II's dig sites set what they can of that now and go here instead, which plays
// what §8 says both do without the Trowel (nobody has one yet). When excavation lands,
// each site's goto becomes the engine's name.
script EventScript_IchorAct2_DigStub {
    msgbox(format("The ground here has been turned. Something might be buried."), MSGBOX_SIGN)
    end
}
