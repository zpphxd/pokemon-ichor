Kythera_Text_SpeakerEudoros::
# 26 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "EUDOROS$"

Kythera_Text_EudorosIntro::
# 28 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Can't sleep. Nobody can. Might as well\n"
	.string "battle.$"

Kythera_Text_EudorosDefeat::
# 32 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "There. Now I'm tired. Thank you.$"

Kythera_Text_EudorosAfter::
# 36 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Twelve ships, no lamps. Nobody rows dark\n"
	.string "unless ashamed.$"

Kythera_Text_SpeakerKerdon::
# 40 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KERDON$"

Kythera_Text_KerdonIntro::
# 42 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I bought forty jars of oil for Kythera.\n"
	.string "Then the Titans took the boats.$"

Kythera_Text_KerdonDefeat::
# 46 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "A loss. Another loss. It's a theme.$"

Kythera_Text_KerdonAfter::
# 50 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Who needs oil when nobody can sail?\n"
	.string "Nobody. That's who.$"

Kythera_Text_SpeakerKimolos::
# 58 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KIMOLOS$"

Kythera_Text_KimolosIntro::
# 60 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Off the trireme? Everyone's off a\n"
	.string "trireme. Battle while they fill up.$"

Kythera_Text_KimolosDefeat::
# 64 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Beaten before the jars are full. A\n"
	.string "record.$"

Kythera_Text_KimolosAfter::
# 68 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The Titans watered here last night.\n"
	.string "Forty boats. Not one fish bought.$"

Kythera_Text_SpeakerTheion::
# 72 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "THEION$"

Kythera_Text_TheionIntro::
# 74 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The master wants edges. Glass edges. I\n"
	.string "want my lunch. You'll do.$"

Kythera_Text_TheionDefeat::
# 78 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Cut. Should've seen that coming. It's\n"
	.string "glass.$"

Kythera_Text_TheionAfter::
# 82 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The Hand's crews dug all night. I fell\n"
	.string "asleep. They left me. Again.$"

Kythera_Text_SpeakerKymaios::
# 90 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KYMAIOS$"

Kythera_Text_KymaiosIntro::
# 92 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "All the way out here? You're braver than\n"
	.string "you look. Or wetter.$"

Kythera_Text_KymaiosDefeat::
# 96 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Under I go.$"

Kythera_Text_KymaiosAfter::
# 100 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Ships pass all night. No lamps. I keep my\n"
	.string "head down.$"

Kythera_Text_SpeakerAntalkidas::
# 104 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "ANTALKIDAS$"

Kythera_Text_AntalkidasIntro::
# 106 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "This channel's mine. Pay the toll. The\n"
	.string "toll's a battle.$"

Kythera_Text_AntalkidasDefeat::
# 110 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Peace, then. On your terms.$"

Kythera_Text_AntalkidasAfter::
# 114 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Anydros has no water. Fig tree died of\n"
	.string "thirst. Nobody lives there.$"

Kythera_Text_SpeakerNikandros::
# 118 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "NIKANDROS$"

Kythera_Text_NikandrosIntro::
# 120 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The Myrtoan's rough. So am I. Battle?$"

Kythera_Text_NikandrosDefeat::
# 124 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Rough, but not tough. Noted.$"

Kythera_Text_NikandrosAfter::
# 128 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Don't go round Malea. You'll forget your\n"
	.string "mother's name.$"

Kythera_Text_SpeakerHagne::
# 132 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "HAGNE$"

Kythera_Text_HagneIntro::
# 134 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "There's a whole temple under us. One\n"
	.string "column sticks up. Mine.$"

Kythera_Text_HagneDefeat::
# 138 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The column wins. It always does.$"

Kythera_Text_HagneAfter::
# 142 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Something shiny at its foot. I'm saving\n"
	.string "it. Take it. I'll find another.$"

Kythera_Text_SpeakerAktaios::
# 148 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "AKTAIOS$"

Kythera_Text_AktaiosIntro::
# 150 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Swam out from Melos for sponges. Found\n"
	.string "you instead.$"

Kythera_Text_AktaiosDefeat::
# 154 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Back to the sponges, then.$"

Kythera_Text_AktaiosAfter::
# 158 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The stakes mark the trireme lane. Deep\n"
	.string "water. Keep this side of them.$"

Kythera_Text_SpeakerNerine::
# 162 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "NERINE$"

Kythera_Text_NerineIntro::
# 164 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You came through the gap? That's my\n"
	.string "gap. Battle for it.$"

Kythera_Text_NerineDefeat::
# 168 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Fine. We'll share it.$"

Kythera_Text_NerineAfter::
# 172 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The rocks make lanes. Swim the lanes\n"
	.string "and you never get lost. Mostly.$"

Kythera_Text_SpeakerPhorbas::
# 176 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "PHORBAS$"

Kythera_Text_PhorbasIntro::
# 178 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I pulled my boat up here to sleep. The\n"
	.string "tide took the boat. I kept the sandbar.$"

Kythera_Text_PhorbasDefeat::
# 182 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I'm losing everything today.$"

Kythera_Text_PhorbasAfter::
# 186 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "If you see a boat with an eye painted\n"
	.string "on the bow, it's mine. Push it this way.$"

Kythera_Text_SpeakerLampros::
# 190 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "LAMPROS$"

Kythera_Text_LamprosIntro::
# 192 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "One goat on this whole island, and he\n"
	.string "eats my bait. Battle.$"

Kythera_Text_LamprosDefeat::
# 196 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Even the goat beats me.$"

Kythera_Text_LamprosAfter::
# 200 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "A hundred goats here once. The Titans\n"
	.string "took ninety-nine. They left the rude\l"
	.string "one.$"

Kythera_Text_SpeakerPsamathe::
# 204 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "PSAMATHE$"

Kythera_Text_PsamatheIntro::
# 206 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I was counting the rocks in this line.\n"
	.string "You made me lose count.$"

Kythera_Text_PsamatheDefeat::
# 210 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Forty-one. Or forty. Start again.$"

Kythera_Text_PsamatheAfter::
# 214 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Malea's cliffs make the swell. Ride it.\n"
	.string "Don't fight it.$"

Kythera_Text_SpeakerPelagon::
# 218 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "PELAGON$"

Kythera_Text_PelagonIntro::
# 220 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Open sea, open water, open battle.\n"
	.string "Ready?$"

Kythera_Text_PelagonDefeat::
# 224 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Closed. Battle closed.$"

Kythera_Text_PelagonAfter::
# 228 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "There's a drowned temple east of here.\n"
	.string "Hagne says it's hers. Everything's\l"
	.string "Hagne's.$"

Kythera_Text_SpeakerKleitos::
# 232 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KLEITOS$"

Kythera_Text_KleitosIntro::
# 234 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I fish under Malea. The Titans won't row\n"
	.string "this close. Scared of the cliffs.$"

Kythera_Text_KleitosDefeat::
# 238 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Braver than a Titan. Not hard.$"

Kythera_Text_KleitosAfter::
# 242 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Round Malea and you forget your home,\n"
	.string "they say. I've been round a hundred\l"
	.string "times. Where do I live?$"

Kythera_Text_SpeakerDoros::
# 246 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "DOROS$"

Kythera_Text_DorosIntro::
# 248 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Quiet. I'm fishing by a grave. It's\n"
	.string "respectful fishing.$"

Kythera_Text_DorosDefeat::
# 252 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Very respectful. Very beaten.$"

Kythera_Text_DorosAfter::
# 256 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Myrtilos is buried up there. Or his name\n"
	.string "is. The sea kept the rest.$"

Kythera_Text_SpeakerMolybdos::
# 264 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "MOLYBDOS$"

Kythera_Text_MolybdosDefeat::
# 266 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Lead sinks. Should've seen that coming.$"

Kythera_Text_SpeakerAmphitos::
# 274 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "AMPHITOS$"

Kythera_Text_AmphitosIntro::
# 276 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Shh. The fish are thinking. Oh, all right.\n"
	.string "Battle.$"

Kythera_Text_AmphitosDefeat::
# 280 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The fish saw that. They'll never respect\n"
	.string "me now.$"

Kythera_Text_AmphitosAfter::
# 284 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Aphrodite came out of this sea. She\n"
	.string "could send fish.$"

Kythera_Text_SpeakerSkopas::
# 288 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "SKOPAS$"

Kythera_Text_SkopasIntro::
# 290 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Stand still. No, don't. I need you to\n"
	.string "move for this.$"

Kythera_Text_SkopasDefeat::
# 294 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Wonderful. Do it again. No, don't.$"

Kythera_Text_SkopasAfter::
# 298 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I came to carve the goddess. The marble\n"
	.string "here's pink. She'd look sunburnt.$"

Kythera_Text_SpeakerPontinos::
# 302 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "PONTINOS$"

Kythera_Text_PontinosIntro::
# 304 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You walked out here? On the reef?\n"
	.string "Brave. Or tide-blind.$"

Kythera_Text_PontinosDefeat::
# 308 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Sunk. Like a sponge.$"

Kythera_Text_PontinosAfter::
# 312 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The tide comes in at dusk. I won't come\n"
	.string "for you.$"

Kythera_Text_SpeakerKassiteros::
# 316 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KASSITEROS$"

Kythera_Text_KassiterosIntro::
# 318 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "For Knossa! Everything floats\n"
	.string "eventually. Help me push.$"

Kythera_Text_KassiterosDefeat::
# 322 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You could've just helped me push.$"

Kythera_Text_KassiterosAfter::
# 326 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "It's not even downhill to Knossa. Why\n"
	.string "are we pushing it uphill?$"

Kythera_Text_SpeakerPhilotes::
# 334 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "PHILOTES$"

Kythera_Text_PhilotesIntro::
# 336 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "She doesn't know I exist. Battle me.\n"
	.string "Distract me.$"

Kythera_Text_PhilotesDefeat::
# 340 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Even my Pokémon don't love me back.$"

Kythera_Text_PhilotesAfter::
# 344 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Look at him, by the pool. That's what\n"
	.string "love does. I'm going to be like that.$"

Kythera_Text_SpeakerKalamis::
# 348 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KALAMIS$"

Kythera_Text_KalamisIntro::
# 350 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Quiet. You'll scare the echo.$"

Kythera_Text_KalamisDefeat::
# 354 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Beaten.\p"
	.string "VOICE: …beaten.\p"
	.string "Yes, thank you.$"

Kythera_Text_KalamisAfter::
# 360 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I found a pink stone in a fish once. My\n"
	.string "Aphrell went all beautiful.$"

Kythera_Text_SpeakerKolymbos::
# 364 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KOLYMBOS$"

Kythera_Text_KolymbosIntro::
# 366 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Who's there? Light, then you. Fine.\n"
	.string "Battle.$"

Kythera_Text_KolymbosDefeat::
# 370 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Down I go.$"

Kythera_Text_KolymbosAfter::
# 374 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The voice repeats you. Don't say\n"
	.string "anything twice.$"

Kythera_Text_SpeakerAnthousa::
# 382 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "ANTHOUSA$"

Kythera_Text_AnthousaIntro::
# 384 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You turned round to look at me. Good.\n"
	.string "Always look at a lady.$"

Kythera_Text_AnthousaDefeat::
# 388 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Lovely. Truly lovely.$"

Kythera_Text_AnthousaAfter::
# 392 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The stand mirrors turn. Point one down\n"
	.string "your path.$"

Kythera_Text_SpeakerRhodanthe::
# 396 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "RHODANTHE$"

Kythera_Text_RhodantheIntro::
# 398 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The statues watched you all the way\n"
	.string "here. So did I.$"

Kythera_Text_RhodantheDefeat::
# 402 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You didn't look away once. I'm\n"
	.string "impressed.$"

Kythera_Text_RhodantheAfter::
# 406 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "She planted the first pomegranate.\n"
	.string "Here, we say.$"

Kythera_Text_SpeakerGalatea::
# 410 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "GALATEA$"

Kythera_Text_GalateaIntro::
# 412 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You looked away. Everyone does, in the\n"
	.string "end.\p"
	.string "Don't be embarrassed. I spent a long\n"
	.string "time being looked at.\p"
	.string "I was perfect once. Marble. Then\n"
	.string "someone loved me, and I cracked.\p"
	.string "It's the best thing that ever happened\n"
	.string "to me.\p"
	.string "I've cracked all over since.\p"
	.string "My statues are the ones who stayed\n"
	.string "perfect.\p"
	.string "They hate being looked away from.\p"
	.string "Show me what you love. And whether\n"
	.string "you'll let it change.$"

Kythera_Text_GalateaDefeat::
# 423 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "There. A crack. They always start\n"
	.string "somewhere.$"

Kythera_Text_SpeakerLykidas::
# 431 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "LYKIDAS$"

Kythera_Text_LykidasIntro::
# 433 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The falls stopped singing. So I sing to\n"
	.string "the goats. Battle?$"

Kythera_Text_LykidasDefeat::
# 437 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Even the goats looked sorry for me.$"

Kythera_Text_LykidasAfter::
# 441 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "A poet wrote about a goatherd called\n"
	.string "Lykidas. A better one.$"

Kythera_Text_SpeakerKerinthos::
# 445 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KERINTHOS$"

Kythera_Text_KerinthosIntro::
# 447 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Careful! The hives. Battle me over\n"
	.string "there. No, there.$"

Kythera_Text_KerinthosDefeat::
# 451 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The bees saw. They'll talk.$"

Kythera_Text_KerinthosAfter::
# 455 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The bees went quiet with the falls. Odd,\n"
	.string "isn't it?$"

Kythera_Text_SpeakerMopsos::
# 459 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "MOPSOS$"

Kythera_Text_MopsosIntro::
# 461 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The birds told me you'd cross. They\n"
	.string "didn't say whether you'd win.$"

Kythera_Text_MopsosDefeat::
# 465 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The birds never say whether. Only that.$"

Kythera_Text_MopsosAfter::
# 469 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Every bird here flew east a week ago.\n"
	.string "Then back.$"

Kythera_Text_SpeakerThestylis::
# 473 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "THESTYLIS$"

Kythera_Text_ThestylisIntro::
# 475 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You climbed the falls? With a horn? Show\n"
	.string "me what else you've got.$"

Kythera_Text_ThestylisDefeat::
# 479 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Cut down. Like a reed.$"

Kythera_Text_ThestylisAfter::
# 483 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Reeds grow back. That's the nice thing\n"
	.string "about reeds.$"

Kythera_Text_SpeakerBathyllos::
# 491 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "BATHYLLOS$"

Kythera_Text_BathyllosIntro::
# 493 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Out here on purpose? Me too. The\n"
	.string "sponges are better past the stakes.$"

Kythera_Text_BathyllosDefeat::
# 497 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Back to the bottom with me.$"

Kythera_Text_BathyllosAfter::
# 501 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Old Skyllias says there's a box of\n"
	.string "wheels out here. Mad.$"

Kythera_Text_SpeakerEuthykles::
# 505 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "EUTHYKLES$"

Kythera_Text_EuthyklesIntro::
# 507 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "They took every boat but mine. Battle,\n"
	.string "to celebrate.$"

Kythera_Text_EuthyklesDefeat::
# 511 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Lost to someone without a boat.\n"
	.string "Embarrassing.$"

Kythera_Text_EuthyklesAfter::
# 515 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I'm not going in till they've gone. I\n"
	.string "sleep on the islet.$"

Kythera_Text_SpeakerMyrsine::
# 519 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "MYRSINE$"

Kythera_Text_MyrsineIntro::
# 521 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "That wreck's mine. I found it. Well.\n"
	.string "Skyllias found it. I found it second.$"

Kythera_Text_MyrsineDefeat::
# 525 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Second again.$"

Kythera_Text_MyrsineAfter::
# 529 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Something shiny's in the ribs. You've\n"
	.string "got longer arms.$"

Kythera_Text_SpeakerAkamas::
# 535 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "AKAMAS$"

Kythera_Text_AkamasIntro::
# 537 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Making for the islet? You'll have to get\n"
	.string "past Euthykles. And me.$"

Kythera_Text_AkamasDefeat::
# 541 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Just Euthykles, then.$"

Kythera_Text_AkamasAfter::
# 545 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Euthykles rows that gap all day. He's\n"
	.string "lonely. Talk to him after.$"

Kythera_Text_SpeakerEione::
# 549 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "EIONE$"

Kythera_Text_EioneIntro::
# 551 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "This sandbar's my lookout. I saw you\n"
	.string "coming a long way off.$"

Kythera_Text_EioneDefeat::
# 555 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Saw you coming. Didn't see that.$"

Kythera_Text_EioneAfter::
# 559 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "At low water you can see the wreck's\n"
	.string "ribs from here. Like a fish on a plate.$"

Kythera_Text_SpeakerNauplios::
# 563 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "NAUPLIOS$"

Kythera_Text_NaupliosIntro::
# 565 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "My great-grandfather lit fires on the\n"
	.string "cliffs to bring ships onto the rocks. I\l"
	.string "just battle.$"

Kythera_Text_NaupliosDefeat::
# 569 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "He'd be ashamed. Or proud. Hard to say.$"

Kythera_Text_NaupliosAfter::
# 573 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "That wreck on the reef? Not one of\n"
	.string "ours. Probably.$"

Kythera_Text_SpeakerLykon::
# 577 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "LYKON$"

Kythera_Text_LykonIntro::
# 579 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Halt. Nobody walks the Foam Road\n"
	.string "unchallenged. My rule.$"

Kythera_Text_LykonDefeat::
# 583 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Rules are rules. You win.$"

Kythera_Text_LykonAfter::
# 587 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Skandeia's gate is mine to keep.\n"
	.string "Paphia's yours to reach.$"

Kythera_Text_SpeakerTheano::
# 591 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "THEANO$"

Kythera_Text_TheanoIntro::
# 593 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I walk to the temple every spring. Walk\n"
	.string "with me a while. Battle first.$"

Kythera_Text_TheanoDefeat::
# 597 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The goddess would have liked that one.$"

Kythera_Text_TheanoAfter::
# 601 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "From up here her temple's roof shows\n"
	.string "over the trees. Pink as a shell.$"

Kythera_Text_SpeakerKymodoke::
# 605 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "KYMODOKE$"

Kythera_Text_KymodokeIntro::
# 607 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "You swam out to my islet! Nobody does.\n"
	.string "Battle me, then go away.$"

Kythera_Text_KymodokeDefeat::
# 611 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Back to the waves with me.$"

Kythera_Text_KymodokeAfter::
# 615 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Pearls wash up here. Not from oysters.\n"
	.string "From the foam, my gran says.$"

Kythera_Text_SpeakerMenalkas::
# 619 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "MENALKAS$"

Kythera_Text_MenalkasIntro::
# 621 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "My flock grazes this clifftop. You've\n"
	.string "trodden on their supper.$"

Kythera_Text_MenalkasDefeat::
# 625 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Fine. Fine. They'll eat the thrift\n"
	.string "instead.$"

Kythera_Text_MenalkasAfter::
# 629 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Sheep don't care for the sea. They face\n"
	.string "inland. Wise animals.$"

Kythera_Text_SpeakerAmaryllis::
# 633 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "AMARYLLIS$"

Kythera_Text_AmaryllisIntro::
# 635 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Myrtle for the temple's garlands. Don't\n"
	.string "trample the grove.$"

Kythera_Text_AmaryllisDefeat::
# 639 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "My basket! Well. Myrtle grows back.$"

Kythera_Text_AmaryllisAfter::
# 643 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Aphrodite hid behind a myrtle when she\n"
	.string "came ashore. Bare as a pebble.$"

Kythera_Text_SpeakerDaphnis::
# 647 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "DAPHNIS$"

Kythera_Text_DaphnisIntro::
# 649 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Quiet up the valley today. Too quiet.\n"
	.string "Fight me, so there's some noise.$"

Kythera_Text_DaphnisDefeat::
# 653 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "There. That was noise.$"

Kythera_Text_DaphnisAfter::
# 657 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I used to pipe to the sheep by the\n"
	.string "falls. You can't pipe over silence.$"

Kythera_Text_SpeakerOpora::
# 661 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "OPORA$"

Kythera_Text_OporaIntro::
# 663 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Berries for the Naiads. These are mine.\n"
	.string "Get your own!$"

Kythera_Text_OporaDefeat::
# 667 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Take a berry. Take two. The trees are\n"
	.string "generous.$"

Kythera_Text_OporaAfter::
# 671 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Krenaia wants first fruits. Three. The\n"
	.string "Naiads can count.$"

Kythera_Text_SpeakerPegaios::
# 675 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "PEGAIOS$"

Kythera_Text_PegaiosIntro::
# 677 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "I keep the pool clean for the Naiads.\n"
	.string "You're tracking mud.$"

Kythera_Text_PegaiosDefeat::
# 681 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The Naiads saw that. They're laughing\n"
	.string "at me. Silently.$"

Kythera_Text_PegaiosAfter::
# 685 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "The falls make no sound. I've stopped\n"
	.string "hearing my own prayers.$"

Kythera_Text_SpeakerDexithea::
# 689 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "DEXITHEA$"

Kythera_Text_DexitheaIntro::
# 691 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Pilgrims leave the shrine a ribbon. I\n"
	.string "leave a battle.$"

Kythera_Text_DexitheaDefeat::
# 695 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "A good offering.$"

Kythera_Text_DexitheaAfter::
# 699 "data/scripts/ichor_act3_kythera_trainers.pory"
	.string "Mopsos reads birds at the ford. He\n"
	.string "reads them wrong. Don't tell him.$"
