// The post-game's opening on Kalliste (design/POSTGAME.md §1; design/postgame/BUILD.md,
// batch 1, the akti row): the heralds of the Olympic truce everywhere, Kleon at Elaia's
// well (LABORS.md scene 0, its Elaia half), Elaia's people after the epilogue, and at
// Akti the Euploia given (ODYSSEY.md scene 1), Phaedon healing and Elpis.
//
// Everything here waits for FLAG_ICHOR_POSTGAME, which world-act3's epilogue sets last.
// The slice's maps call in with one line each: their ON_TRANSITION calls the map's
// set-up below, and an NPC's script hands over to this file with
//     if (flag(FLAG_ICHOR_POSTGAME)) { goto(EventScript_IchorPg_...) }
// People who exist only in the post-game hide behind FLAG_TEMP_18 and up, set in
// ON_TRANSITION while the post-game is off, so no permanent hide flag is spent.
//
// The crew's recruitment scenes are in ichor_postgame_crew.pory.

text IchorPg_Name_Kleon { "KLEON" }
text IchorPg_Name_Nausikles { "NAUSIKLES" }
text IchorPg_Name_Alethea { "ALETHEA" }
text IchorPg_Name_Phaedon { "PHAEDON" }
text IchorPg_Name_Elpis { "ELPIS" }
text IchorPg_Name_Halia { "HALIA" }
text IchorPg_Name_Korinna { "KORINNA" }
text IchorPg_Name_Philon { "PHILON" }
text IchorPg_Name_Gylippos { "GYLIPPOS" }
text IchorPg_Name_Kydippe { "KYDIPPE" }
text IchorPg_Name_Glykera { "GLYKERA" }
text IchorPg_Name_Kimon { "KIMON" }
text IchorPg_Name_Daphne { "DAPHNE" }
text IchorPg_Name_Hydna { "HYDNA" }

// ===========================================================================
// The heralds of the truce (spondophoroi). VAR_0x8004 is the town, an
// ICHOR_HERALD_* id (include/constants/ichor_postgame.h). Each town's herald
// object runs its wrapper below; design/postgame/PLACEMENTS.md places them.
// ===========================================================================

script EventScript_IchorHerald {
    lock
    faceplayer
    msgbox(format("The truce is declared. Every road to Olympia is safe."))
    switch (var(VAR_0x8004)) {
        case ICHOR_HERALD_ELAIA:
            msgbox(format("From Kalliste? Take ship at Akti for the mainland first.\p"
                          "Then west, and over the Alpheios. Olympia's on the far bank."))
        case ICHOR_HERALD_AKTI:
            msgbox(format("The Euploia will carry you to the mainland.\p"
                          "From Emporion, west by Nemea to Arkadia, then down the Alpheios."))
        case ICHOR_HERALD_EMPORION:
            msgbox(format("West by Nemea, and up into Arkadia.\p"
                          "Then follow the Alpheios down. It runs right past the games."))
        case ICHOR_HERALD_ELEUSA:
            msgbox(format("West to Emporion, then Nemea and Arkadia.\p"
                          "The Alpheios carries you the rest of the way."))
        case ICHOR_HERALD_THYRSA:
            msgbox(format("Down to Kirrha, and the ferry over to Aigion.\p"
                          "Up the gorge into Arkadia, then west down the Alpheios."))
        case ICHOR_HERALD_ARKADIA:
            msgbox(format("You're nearly there. Take the road west, down the Alpheios.\p"
                          "When you hear the crowd, you've arrived."))
        case ICHOR_HERALD_ASTYRA:
            msgbox(format("Out by Daphni to Eleusa, then west to Emporion.\p"
                          "Nemea, Arkadia, and the Alpheios after that."))
        case ICHOR_HERALD_KALDERA:
            msgbox(format("Ships go west to Kythera. Cross to Gytheion from there.\p"
                          "Up through Lakonia to Arkadia, then down the Alpheios."))
        case ICHOR_HERALD_KYTHERA:
            msgbox(format("Cross to Gytheion and walk up the Eurotas to Lakonia.\p"
                          "North to Arkadia, then west along the Alpheios."))
        case ICHOR_HERALD_AMNISOS:
            msgbox(format("Sail for Kythera, then cross to Gytheion.\p"
                          "Lakonia, Arkadia, the Alpheios. A long road. A safe one."))
        case ICHOR_HERALD_LAKONIA:
            msgbox(format("North past Stymphalia to Arkadia, then west down the Alpheios.\p"
                          "Even Lakonians walk it unarmed this month. They hate it."))
        case ICHOR_HERALD_DELPHOI:
            msgbox(format("Down to Kirrha, and the ferry to Aigion.\p"
                          "Up through the gorge into Arkadia, and down the Alpheios."))
        case ICHOR_HERALD_OLYMPUS:
            msgbox(format("Every road runs downhill from here. Take the one with the crowd.\p"
                          "Back to Delphoi, the ferry, Arkadia. Then down the Alpheios."))
        case ICHOR_HERALD_TAINARON:
            msgbox(format("Back up the Mani to Lakonia, then north to Arkadia.\p"
                          "The Alpheios takes you west from there."))
        case ICHOR_HERALD_OLYMPIA:
            msgbox(format("You've walked one of them. Welcome to Olympia.\p"
                          "Leave your quarrels on the far bank. Zeus is watching."))
    }
    release
}

script EventScript_IchorHerald_Elaia {
    setvar(VAR_0x8004, ICHOR_HERALD_ELAIA)
    goto(EventScript_IchorHerald)
}

