// Ichor: the Labyrinth (design/LABYRINTH.md §5; design/ENGINE_API.md §6;
// src/ichor_labyrinth.c).

// ---------------------------------------------------------------------------
// Ariadne's Thread: Relic Ring → THREAD, on a threaded map
// ---------------------------------------------------------------------------

script EventScript_IchorThreadMenu {
    lockall
    message(format("The thread runs back into the dark."))
    waitmessage
    special(Ichor_BuildThreadMenu)
    dynmultistack(0, 0, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    switch (var(VAR_RESULT)) {
        case 0: goto(EventScript_IchorThreadTieOff)
        case 1: goto(EventScript_IchorThreadReturn)
        case 2: goto(EventScript_IchorThreadWindIn)
    }
    closemessage
    releaseall
    end
}

script EventScript_IchorThreadTieOff {
    special(Ichor_ThreadTieOff)
    msgbox(format("{PLAYER} tied the thread off at the bronze ring. The spool is full again."), MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}

script EventScript_IchorThreadReturn {
    if (flag(FLAG_ICHOR_THREAD_NO_RETURN)) {
        msgbox(format("The thread shakes in your hand. Walk it."), MSGBOX_DEFAULT)
        closemessage
        releaseall
        end
    }
    special(Ichor_BuildThreadReturnMenu)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("The thread isn't tied off anywhere yet."), MSGBOX_DEFAULT)
        closemessage
        releaseall
        end
    }
    message(format("Follow the thread back to…"))
    waitmessage
    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        closemessage
        releaseall
        end
    }
    copyvar(VAR_0x8004, VAR_RESULT)
    closemessage
    special(Ichor_ThreadReturnTo)
    if (var(VAR_RESULT) == TRUE) {
        waitstate
    }
    releaseall
    end
}

script EventScript_IchorThreadWindIn {
    special(Ichor_ThreadWindIn)
    msgbox(format("{PLAYER} wound the thread back in."), MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}

script EventScript_IchorThreadLow {
    lockall
    msgbox(format("The spool is nearly empty."), MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}

// ---------------------------------------------------------------------------
// Asterion
// ---------------------------------------------------------------------------

script EventScript_IchorAsterionKnockdown {
    lockall
    playse(SE_M_MEGA_KICK)
    msgbox(format("Asterion's charge sends you sprawling!"), MSGBOX_DEFAULT)
    closemessage
    special(Ichor_AsterionKnockdown)
    waitstate
}

script EventScript_IchorAsterionBrokeWall {
    lockall
    setvar(VAR_0x8004, 2)  // vertical pan
    setvar(VAR_0x8005, 2)  // horizontal pan
    setvar(VAR_0x8006, 6)  // shakes
    setvar(VAR_0x8007, 2)  // delay
    special(ShakeCamera)
    waitstate
    releaseall
    end
}

// ---------------------------------------------------------------------------
// Daedalus's dials (LABYRINTH §5.5). The dial's bg event:
//   copyvar(VAR_0x8004, VAR_ICHOR_LABYRINTH)  // the dials' positions
//   setvar(VAR_0x8005, 0)                     // this dial's bit
//   call(EventScript_IchorDial)
//   copyvar(VAR_ICHOR_LABYRINTH, VAR_0x8004)  // saved back, turned or not
//   then, by VAR_RESULT: 0 or 1 is the wall's new position; 0xFF, nothing turned.
//   Swap the wall's metatiles, special(DrawWholeMapView), releaseall.
// ---------------------------------------------------------------------------

script EventScript_IchorDial {
    lockall
    copyvar(VAR_0x8006, VAR_0x8004)
    copyvar(VAR_0x8007, VAR_0x8005)
    checkitem(ITEM_LABRYS)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("A bronze wheel with a socket shaped like a double axe."), MSGBOX_DEFAULT)
        copyvar(VAR_0x8004, VAR_0x8006)
        setvar(VAR_RESULT, 0xFF)
        return
    }
    call(EventScript_IchorAskOrAuto)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("A bronze wheel with a socket shaped like a double axe.\pFit the Labrys and turn it?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == NO) {
            closemessage
            copyvar(VAR_0x8004, VAR_0x8006)
            setvar(VAR_RESULT, 0xFF)
            return
        }
    }
    copyvar(VAR_0x8004, VAR_0x8006)
    copyvar(VAR_0x8005, VAR_0x8007)
    special(Ichor_TurnDial)
    copyvar(VAR_0x8006, VAR_RESULT)  // VAR_0x8004 now holds the turned positions
    playse(SE_M_STRENGTH)
    msgbox(format("{PLAYER} fitted the Labrys and turned the dial.\pSomewhere, stone grinds against stone."), MSGBOX_DEFAULT)
    closemessage
    copyvar(VAR_RESULT, VAR_0x8006)
    return
}

// ---------------------------------------------------------------------------
// The Titan disguise (LABYRINTH §5.6): walking into a Titanborn while disguised
// ---------------------------------------------------------------------------

script EventScript_IchorRecruitBump {
    lockall
    msgbox(format("Watch it, recruit."), MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}
