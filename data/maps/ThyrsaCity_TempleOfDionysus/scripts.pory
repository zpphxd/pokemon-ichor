// The Temple of Dionysus at Thyrsa: the Three-Act Play, Lasos and Hierophant Thespis
// (design/phase3/SCRIPT.md beat 31 and Part 5).
//
// The room is designed in tools/ichor/maps/temple_dionysus.py, which writes map.json's
// events and the stage scripts below (between the markers). Three acts run north from
// the door, each a room in two halves: the wings (a mask rack, a program, an actor) and,
// through the skene's doors, the stage before the painted audience. The skene roof above
// Act III, where Thespis waits, is reached only by the god-machine.
//
// The play's state:
//   VAR_ICHOR_THREE_ACT_PLAY  0 Act I open, 1 Act I done (its curtain drawn back),
//                             2 Act II done, 3 the play done and the god-machine down
//                             (FLAG_ICHOR_THREE_ACT_PLAY_DONE), 4 riding up to the roof,
//                             5 the Mask Laurel given. (SCRIPT.md's FLAG_ICHOR_PLAY_ACT_1 and
//                             _ACT_2 are this var's 1 and 2.)
//   VAR_ICHOR_PLAY_MISSES     wrong entrances in Act III, for the audience's hint
//   VAR_TEMP_1                the mask worn: 0 none, 1 comic, 2 tragic, 3 satyr
//   VAR_TEMP_2                entrances made in the act being played
//   VAR_TEMP_3                the act whose rack the worn mask came from (its peg shows empty)
//   VAR_TEMP_4, VAR_TEMP_5    Theodoros, Mynniskos: waved the player through in their mask
// The masks: wearing one is VAR_TEMP_1, shown by its empty peg on the rack and a line when
// it goes on. Masks are kept from act to act (the racks remember where each came from) and
// all go back on their pegs when the player leaves the temple.
// The doors (1 ivy, 2 crown, 3 goat) are coord events on each doorway, live while their
// act is being played. Stepping in from the wings is an entrance; stepping back from the
// stage just walks through.
//
// ICHOR_STUB_MUSIC: map.json plays MUS_ICHOR_TEMPLE_HERMES until MUS_ICHOR_TEMPLE_DIONYSUS
// (SCRIPT.md Part 9, cue 17) exists. Thespis's battle plays the Hierophant music, as Ione's.

mapscripts ThyrsaCity_TempleOfDionysus_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // After the laurel Thespis comes down from the roof and stands by the altar.
        if (flag(FLAG_BADGE04_GET)) {
            setobjectxyperm(LOCALID_DIONYSUS_THESPIS, 13, 44)
            setobjectmovementtype(LOCALID_DIONYSUS_THESPIS, MOVEMENT_TYPE_FACE_LEFT)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        call(ThyrsaCity_TempleOfDionysus_EventScript_DrawStage)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ICHOR_THREE_ACT_PLAY, 4: ThyrsaCity_TempleOfDionysus_EventScript_OnTheRoof
    ]
}

// --- Stage scripts: generated by tools/ichor/maps/temple_dionysus.py from the room. Do not edit. ---

// Draws the stage from the play's state: the curtains of finished acts drawn back,
// and the god-machine's arm swung down once the play is done.
script ThyrsaCity_TempleOfDionysus_EventScript_DrawStage {
    if (var(VAR_ICHOR_THREE_ACT_PLAY) >= 1) {
        setmetatile(18, 31, METATILE_TempleDionysus_CurtainOpen_L, FALSE)
        setmetatile(19, 31, METATILE_TempleDionysus_CurtainOpen_R, FALSE)
    }
    if (var(VAR_ICHOR_THREE_ACT_PLAY) >= 2) {
        setmetatile(1, 19, METATILE_TempleDionysus_CurtainOpen_L, FALSE)
        setmetatile(2, 19, METATILE_TempleDionysus_CurtainOpen_R, FALSE)
    }
    if (var(VAR_ICHOR_THREE_ACT_PLAY) >= 3) {
        setmetatile(10, 2, METATILE_TempleDionysus_MastTop_Lowered, TRUE)
        setmetatile(10, 3, METATILE_TempleDionysus_Mast_Lowered, TRUE)
        setmetatile(10, 4, METATILE_TempleDionysus_Arm_Lowered, FALSE)
        setmetatile(10, 5, METATILE_TempleDionysus_DeckFaceArm_Lowered, TRUE)
        setmetatile(10, 6, METATILE_TempleDionysus_TierBackArm_Lowered, TRUE)
        setmetatile(10, 7, METATILE_TempleDionysus_TierFrontArm_Lowered, TRUE)
        setmetatile(10, 8, METATILE_TempleDionysus_Hook_Lowered, TRUE)
    }
    return
}

// Every peg full, then the peg of the mask the player wears (VAR_TEMP_1) on the rack
// it came from (VAR_TEMP_3) empty.
script ThyrsaCity_TempleOfDionysus_EventScript_DrawRacks {
    setmetatile(13, 36, METATILE_TempleDionysus_Peg_Comic, TRUE)
    setmetatile(1, 24, METATILE_TempleDionysus_Peg_Comic, TRUE)
    setmetatile(2, 24, METATILE_TempleDionysus_Peg_Tragic, TRUE)
    setmetatile(3, 24, METATILE_TempleDionysus_Peg_Satyr, TRUE)
    setmetatile(1, 12, METATILE_TempleDionysus_Peg_Comic, TRUE)
    setmetatile(2, 12, METATILE_TempleDionysus_Peg_Tragic, TRUE)
    setmetatile(3, 12, METATILE_TempleDionysus_Peg_Satyr, TRUE)
    if (var(VAR_TEMP_3) == 1 && var(VAR_TEMP_1) == 1) {
        setmetatile(13, 36, METATILE_TempleDionysus_Peg_Comic_Empty, TRUE)
    }
    if (var(VAR_TEMP_3) == 2 && var(VAR_TEMP_1) == 1) {
        setmetatile(1, 24, METATILE_TempleDionysus_Peg_Comic_Empty, TRUE)
    }
    if (var(VAR_TEMP_3) == 2 && var(VAR_TEMP_1) == 2) {
        setmetatile(2, 24, METATILE_TempleDionysus_Peg_Tragic_Empty, TRUE)
    }
    if (var(VAR_TEMP_3) == 2 && var(VAR_TEMP_1) == 3) {
        setmetatile(3, 24, METATILE_TempleDionysus_Peg_Satyr_Empty, TRUE)
    }
    if (var(VAR_TEMP_3) == 3 && var(VAR_TEMP_1) == 1) {
        setmetatile(1, 12, METATILE_TempleDionysus_Peg_Comic_Empty, TRUE)
    }
    if (var(VAR_TEMP_3) == 3 && var(VAR_TEMP_1) == 2) {
        setmetatile(2, 12, METATILE_TempleDionysus_Peg_Tragic_Empty, TRUE)
    }
    if (var(VAR_TEMP_3) == 3 && var(VAR_TEMP_1) == 3) {
        setmetatile(3, 12, METATILE_TempleDionysus_Peg_Satyr_Empty, TRUE)
    }
    return
}

// A wrong entrance: back down into the wings and along to the act's rack (the screen
// is black while this plays).
script ThyrsaCity_TempleOfDionysus_EventScript_WalkBackToRack {
    if (var(VAR_0x8005) == 1 && var(VAR_0x8004) == 1) {
        applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Back_Act1_Ivy)
    } elif (var(VAR_0x8005) == 2 && var(VAR_0x8004) == 1) {
        applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Back_Act2_Ivy)
    } elif (var(VAR_0x8005) == 2 && var(VAR_0x8004) == 2) {
        applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Back_Act2_Crown)
    } elif (var(VAR_0x8005) == 2 && var(VAR_0x8004) == 3) {
        applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Back_Act2_Goat)
    } elif (var(VAR_0x8005) == 3 && var(VAR_0x8004) == 1) {
        applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Back_Act3_Ivy)
    } elif (var(VAR_0x8005) == 3 && var(VAR_0x8004) == 2) {
        applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Back_Act3_Crown)
    } elif (var(VAR_0x8005) == 3 && var(VAR_0x8004) == 3) {
        applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Back_Act3_Goat)
    }
    waitmovement(0)
    return
}

movement ThyrsaCity_TempleOfDionysus_Movement_Back_Act1_Ivy {
    walk_faster_down
    walk_faster_right * 8
    face_up
}

movement ThyrsaCity_TempleOfDionysus_Movement_Back_Act2_Ivy {
    walk_faster_down
    walk_faster_left * 3
    face_up
}

movement ThyrsaCity_TempleOfDionysus_Movement_Back_Act2_Crown {
    walk_faster_down
    walk_faster_left * 8
    face_up
}

movement ThyrsaCity_TempleOfDionysus_Movement_Back_Act2_Goat {
    walk_faster_down
    walk_faster_left * 13
    face_up
}

movement ThyrsaCity_TempleOfDionysus_Movement_Back_Act3_Ivy {
    walk_faster_down
    walk_faster_left * 3
    face_up
}

movement ThyrsaCity_TempleOfDionysus_Movement_Back_Act3_Crown {
    walk_faster_down
    walk_faster_left * 8
    face_up
}

movement ThyrsaCity_TempleOfDionysus_Movement_Back_Act3_Goat {
    walk_faster_down
    walk_faster_left * 13
    face_up
}

// --- End of generated stage scripts. ---

// --- Lasos, the god's image, the altar ----------------------------------------------------

// The first step inside the door.
script ThyrsaCity_TempleOfDionysus_EventScript_LasosWelcome {
    if (flag(FLAG_ICHOR_MET_LASOS)) {
        end
    }
    lockall
    applymovement(LOCALID_DIONYSUS_LASOS, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    call(ThyrsaCity_TempleOfDionysus_EventScript_LasosWelcomeText)
    releaseall
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Lasos {
    lock
    faceplayer
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameLasos)
    if (flag(FLAG_BADGE04_GET)) {
        msgbox(format(
            "You found the part they left out. Most people never notice it's missing.\p"
            "The play's over. The god's still clapping. You can't hear it, but he is."))
    } elif (!flag(FLAG_ICHOR_MET_LASOS)) {
        call(ThyrsaCity_TempleOfDionysus_EventScript_LasosWelcomeText)
    } else {
        msgbox(format(
            "I've taught Thyrsa's choruses the god's song for fifty years.\p"
            "They sing it worse every year. I love them anyway.\p"
            "Shall I go over the rules again?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            call(ThyrsaCity_TempleOfDionysus_EventScript_LasosRules)
        }
    }
    release
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_LasosWelcomeText {
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameLasos)
    msgbox(format("Welcome to the god's own stage. This is where Thyrsa learns its parts."))
    call(ThyrsaCity_TempleOfDionysus_EventScript_LasosRules)
    msgbox(format(
        "Which audience? Oh, there's always an audience. Somewhere.\p"
        "The Masked Player waits above, by the god-machine.\p"
        "He's in a mood. Someone stole his masks. All but one."))
    setflag(FLAG_ICHOR_MET_LASOS)
    return
}

script ThyrsaCity_TempleOfDionysus_EventScript_LasosRules {
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameLasos)
    msgbox(format(
        "Every play has a program. Read it. Then wear the right face.\p"
        "Come on by the right door, in the right mask, and the play goes on.\p"
        "Come on wrong, and the audience will tell you so."))
    return
}

// The old wooden image from Eleutherai, on its low base inside the door.
script ThyrsaCity_TempleOfDionysus_EventScript_Image {
    lock
    msgbox(format("An old wooden statue. A cheerful face, like a happy dog. Very worn."))
    // ICHOR_STUB_GARLAND: Oinoe's errand (SCRIPT.md Part 2, Eleutherai). When the rooms
    // agent's FLAG_ICHOR_OINOE_GARLAND and FLAG_ICHOR_GARLAND_LAID and the key item
    // ITEM_IVY_GARLAND exist, add here:
    //   if (flag(FLAG_ICHOR_OINOE_GARLAND) && !flag(FLAG_ICHOR_GARLAND_LAID)) {
    //       msgbox(format("You lay Oinoe's garland at its feet. “From Eleutherai.”\p"
    //                     "For a moment the wood smells of wine."))
    //       removeitem(ITEM_IVY_GARLAND)
    //       setflag(FLAG_ICHOR_GARLAND_LAID)
    //   }
    release
    end
}

// The god's great altar in his orchestra (offerings count double, SYSTEMS.md §3).
script ThyrsaCity_TempleOfDionysus_EventScript_Altar {
    // ICHOR_STUB_RITES: goto(EventScript_IchorTempleAltar_Dionysus) once the rites land.
    msgbox(format("The great altar of Dionysus. Ivy grows over it, and the stone is stained with wine."),
        MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Krater {
    msgbox(format("A big krater for mixing wine with water. Someone drank the wine and left the water."),
        MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Thyrsoi {
    msgbox(format("Fennel staves wound with ivy, a pine cone on each tip. The maenads' thyrsoi."),
        MSGBOX_SIGN)
    end
}

// --- The programs, the racks, the doors ---------------------------------------------------

script ThyrsaCity_TempleOfDionysus_EventScript_Program_Act1 {
    if (flag(FLAG_BADGE04_GET)) {
        msgbox(format("ACT I. FIN."), MSGBOX_SIGN)
        end
    }
    msgbox(format("ACT I.\nEnter the Comic, by the ivy door."), MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Program_Act2 {
    if (flag(FLAG_BADGE04_GET)) {
        msgbox(format("ACT II. FIN."), MSGBOX_SIGN)
        end
    }
    msgbox(format(
        "ACT II.\n"
        "Enter the one who weeps, from the king's house.\p"
        "Then the one who laughs, from the vines."), MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Program_Act3 {
    if (flag(FLAG_BADGE04_GET)) {
        msgbox(format("ACT III. FIN."), MSGBOX_SIGN)
        end
    }
    msgbox(format(
        "ACT III.\n"
        "Enter the one who laughs. Then the one who weeps.\p"
        "And then…\p"
        "The rest of the scroll is torn away."), MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Rack_Act1 {
    setvar(VAR_0x8005, 1)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Rack)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Rack_Act2 {
    setvar(VAR_0x8005, 2)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Rack)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Rack_Act3 {
    setvar(VAR_0x8005, 3)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Rack)
}

// VAR_0x8005: the act whose rack this is. Act I's holds only the comic mask.
script ThyrsaCity_TempleOfDionysus_EventScript_Rack {
    lockall
    setspeaker(SP_NAME_NONE)
    if (var(VAR_0x8005) == 1) {
        msgbox(format("A rack with one mask on it: a laughing one."))
        message(format("Which will you wear?"))
        waitmessage
        dynmultichoice(21, 7, FALSE, 2, 0, DYN_MULTICHOICE_CB_NONE,
            ThyrsaCity_TempleOfDionysus_Text_Comic, ThyrsaCity_TempleOfDionysus_Text_None)
        switch (var(VAR_RESULT)) {
            case 0: setvar(VAR_0x8006, 1)
            case 1: setvar(VAR_0x8006, 0)
            default: setvar(VAR_0x8006, 0xFF)
        }
    } else {
        msgbox(format("A rack of masks: one laughing, one weeping, one with goat's ears."))
        message(format("Which will you wear?"))
        waitmessage
        dynmultichoice(21, 3, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE,
            ThyrsaCity_TempleOfDionysus_Text_Comic, ThyrsaCity_TempleOfDionysus_Text_Tragic,
            ThyrsaCity_TempleOfDionysus_Text_Satyr, ThyrsaCity_TempleOfDionysus_Text_None)
        switch (var(VAR_RESULT)) {
            case 0: setvar(VAR_0x8006, 1)
            case 1: setvar(VAR_0x8006, 2)
            case 2: setvar(VAR_0x8006, 3)
            case 3: setvar(VAR_0x8006, 0)
            default: setvar(VAR_0x8006, 0xFF)
        }
    }
    if (var(VAR_0x8006) == 0xFF) {
        closemessage
        releaseall
        end
    }
    if (var(VAR_0x8006) == 0) {
        if (var(VAR_TEMP_1) == 0) {
            closemessage
            releaseall
            end
        }
        setvar(VAR_TEMP_1, 0)
        setvar(VAR_TEMP_3, 0)
        playse(SE_CLICK)
        call(ThyrsaCity_TempleOfDionysus_EventScript_DrawRacks)
        special(DrawWholeMapView)
        msgbox(format("{PLAYER} hung the mask back on its peg."))
        releaseall
        end
    }
    if (var(VAR_TEMP_1) == VAR_0x8006 && var(VAR_TEMP_3) == VAR_0x8005) {
        msgbox(format("{PLAYER} is wearing that one already."))
        releaseall
        end
    }
    copyvar(VAR_TEMP_1, VAR_0x8006)
    copyvar(VAR_TEMP_3, VAR_0x8005)
    playse(SE_CLICK)
    call(ThyrsaCity_TempleOfDionysus_EventScript_DrawRacks)
    special(DrawWholeMapView)
    switch (var(VAR_TEMP_1)) {
        case 1: msgbox(format("{PLAYER} put on the comic mask."))
        case 2: msgbox(format("{PLAYER} put on the tragic mask."))
        default: msgbox(format("{PLAYER} put on the satyr mask."))
    }
    releaseall
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Door_Act1_Ivy {
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 1)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Entrance)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Door_Act2_Ivy {
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 2)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Entrance)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Door_Act2_Crown {
    setvar(VAR_0x8004, 2)
    setvar(VAR_0x8005, 2)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Entrance)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Door_Act2_Goat {
    setvar(VAR_0x8004, 3)
    setvar(VAR_0x8005, 2)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Entrance)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Door_Act3_Ivy {
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 3)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Entrance)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Door_Act3_Crown {
    setvar(VAR_0x8004, 2)
    setvar(VAR_0x8005, 3)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Entrance)
}

script ThyrsaCity_TempleOfDionysus_EventScript_Door_Act3_Goat {
    setvar(VAR_0x8004, 3)
    setvar(VAR_0x8005, 3)
    goto(ThyrsaCity_TempleOfDionysus_EventScript_Entrance)
}

// VAR_0x8004: the door (1 ivy, 2 crown, 3 goat); VAR_0x8005: the act.
script ThyrsaCity_TempleOfDionysus_EventScript_Entrance {
    // Stepping back off the stage into the wings is no entrance.
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if (var(VAR_RESULT) != DIR_NORTH) {
        end
    }
    lockall
    setspeaker(SP_NAME_NONE)
    call(ThyrsaCity_TempleOfDionysus_EventScript_ExpectedDoor)
    if (var(VAR_TEMP_1) == VAR_0x8004 && var(VAR_0x8004) == VAR_0x8006) {
        goto(ThyrsaCity_TempleOfDionysus_EventScript_RightEntrance)
    }
    goto(ThyrsaCity_TempleOfDionysus_EventScript_WrongEntrance)
}

// The programs' entrances: the door (and its mask) expected next, in VAR_0x8006.
script ThyrsaCity_TempleOfDionysus_EventScript_ExpectedDoor {
    switch (var(VAR_0x8005)) {
        case 1:
            setvar(VAR_0x8006, 1)
        case 2:
            if (var(VAR_TEMP_2) == 0) {
                setvar(VAR_0x8006, 2)
            } else {
                setvar(VAR_0x8006, 1)
            }
        default:
            if (var(VAR_TEMP_2) == 0) {
                setvar(VAR_0x8006, 1)
            } elif (var(VAR_TEMP_2) == 1) {
                setvar(VAR_0x8006, 2)
            } else {
                setvar(VAR_0x8006, 3)
            }
    }
    return
}

script ThyrsaCity_TempleOfDionysus_EventScript_RightEntrance {
    applymovement(LOCALID_PLAYER, ThyrsaCity_TempleOfDionysus_Movement_Enter)
    waitmovement(0)
    if (var(VAR_0x8004) == 2) {
        playse(SE_M_ENCORE2)
        msgbox(format("The painted audience gasps. Somewhere in the back, someone sobs."))
    } else {
        playse(SE_APPLAUSE)
        msgbox(format("The painted audience roars with laughter. Painted, but somehow loud."))
    }
    waitse
    addvar(VAR_TEMP_2, 1)
    if ((var(VAR_0x8005) == 1 && var(VAR_TEMP_2) >= 1) || (var(VAR_0x8005) == 2 && var(VAR_TEMP_2) >= 2)) {
        goto(ThyrsaCity_TempleOfDionysus_EventScript_ActDone)
    }
    if (var(VAR_0x8005) == 3 && var(VAR_TEMP_2) >= 3) {
        goto(ThyrsaCity_TempleOfDionysus_EventScript_PlayDone)
    }
    releaseall
    end
}

// Acts I and II: the curtain at the stage's end draws back on the stair to the next act.
script ThyrsaCity_TempleOfDionysus_EventScript_ActDone {
    setvar(VAR_TEMP_2, 0)
    copyvar(VAR_ICHOR_THREE_ACT_PLAY, VAR_0x8005)
    playse(SE_PIKE_CURTAIN_OPEN)
    call(ThyrsaCity_TempleOfDionysus_EventScript_DrawStage)
    special(DrawWholeMapView)
    waitse
    if (var(VAR_0x8005) == 1) {
        msgbox(format("At the stage's east end, the curtain draws back. A stair goes up."))
    } else {
        msgbox(format("At the stage's west end, the curtain draws back. A stair goes up."))
    }
    releaseall
    end
}

// Act III's third entrance: the play is done, and the god-machine swings its arm down.
script ThyrsaCity_TempleOfDionysus_EventScript_PlayDone {
    setvar(VAR_TEMP_2, 0)
    setflag(FLAG_ICHOR_THREE_ACT_PLAY_DONE)
    setvar(VAR_ICHOR_THREE_ACT_PLAY, 3)
    closemessage
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaCity_TempleOfDionysus_Movement_CameraUp4)
    waitmovement(0)
    playse(SE_ELEVATOR)
    call(ThyrsaCity_TempleOfDionysus_EventScript_DrawStage)
    special(DrawWholeMapView)
    waitse
    msgbox(format("Above the audience, the god-machine creaks. Its arm swings down over the stage."))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaCity_TempleOfDionysus_Movement_CameraDown4)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_WrongEntrance {
    playse(SE_BOO)
    msgbox(format("The audience is silent. Somewhere in the dark, someone boos."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    call(ThyrsaCity_TempleOfDionysus_EventScript_WalkBackToRack)
    fadescreen(FADE_FROM_BLACK)
    // The safety valve (SCRIPT.md Part 5): Act III's audience, then Theodoros, help out.
    if (var(VAR_0x8005) == 3) {
        addvar(VAR_ICHOR_PLAY_MISSES, 1)
        if (var(VAR_ICHOR_PLAY_MISSES) >= 2) {
            msgbox(format("A whisper from the painted audience: “A tragedy needs its goats.”"))
        }
        if (var(VAR_ICHOR_PLAY_MISSES) >= 4 && defeated(TRAINER_ICHOR_THEODOROS)) {
            setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameTheodoros)
            msgbox(format("You've used the ivy and the crown. Has anyone used that third door?"))
        }
    }
    releaseall
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_PaintedCrownDoor {
    msgbox(format("A palace door with a crown over it. It's only painted on the canvas."), MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_PaintedGoatDoor {
    msgbox(format("A rough door with goat horns over it. It's only painted on the canvas."), MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Curtain_Act1 {
    if (var(VAR_ICHOR_THREE_ACT_PLAY) >= 1) {
        end
    }
    msgbox(format("A heavy curtain hangs across the stair. The act isn't over yet."), MSGBOX_SIGN)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Curtain_Act2 {
    if (var(VAR_ICHOR_THREE_ACT_PLAY) >= 2) {
        end
    }
    msgbox(format("A heavy curtain hangs across the stair. The act isn't over yet."), MSGBOX_SIGN)
    end
}

// --- The actors --------------------------------------------------------------------------
// Each wears a mask. In the same mask as his, the player is waved through, once per mask
// (with nothing to do, his script has no effect, so his sight lets the player pass).
// In any other, he battles them once; after that he steps aside whatever they wear.

script ThyrsaCity_TempleOfDionysus_EventScript_Mynniskos {
    if (!defeated(TRAINER_ICHOR_MYNNISKOS) && var(VAR_TEMP_1) == 2) {
        if (var(VAR_TEMP_5) == 1) {
            end
        }
        lock
        faceplayer
        setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameMynniskos)
        msgbox(format("Same face, same side. Go on."))
        closemessage
        setvar(VAR_TEMP_5, 1)
        getobjectxy(LOCALID_DIONYSUS_MYNNISKOS, CURRENT_POSITION, VAR_0x8008, VAR_0x8009)
        if (var(VAR_0x8009) == 38) {
            applymovement(LOCALID_DIONYSUS_MYNNISKOS, ThyrsaCity_TempleOfDionysus_Movement_BackToPost1)
        } else {
            applymovement(LOCALID_DIONYSUS_MYNNISKOS, Common_Movement_FaceUp)
        }
        waitmovement(0)
        release
        end
    }
    trainerbattle_single(TRAINER_ICHOR_MYNNISKOS,
        format("Wrong face for my scene! I'm waiting for the tragedy.\pOff with you! …Or fight me for the stage."),
        format("Exit, pursued by a weasel."))
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameMynniskos)
    msgbox(format("A face for every scene. That's all acting is. Pick the right one."), MSGBOX_AUTOCLOSE)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Thettalos {
    if (!defeated(TRAINER_ICHOR_THETTALOS) && var(VAR_TEMP_1) == 3) {
        lock
        faceplayer
        setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThettalos)
        msgbox(format("Same face, same side. Go on."))
        release
        end
    }
    trainerbattle_single(TRAINER_ICHOR_THETTALOS,
        format("Nobody comes to the satyrs' corner unless they're lost. Are you lost? Good!"),
        format("Tragic. Actually tragic."))
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThettalos)
    msgbox(format("The cues tell you who: weeping, laughing, a tail.\pThe doors tell you where. Read both."),
        MSGBOX_AUTOCLOSE)
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Theodoros {
    if (!defeated(TRAINER_ICHOR_THEODOROS) && var(VAR_TEMP_1) == 1) {
        if (var(VAR_TEMP_4) == 1) {
            end
        }
        lock
        faceplayer
        setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameTheodoros)
        msgbox(format("Same face, same side. Go on."))
        closemessage
        setvar(VAR_TEMP_4, 1)
        // back to his post by the doors, watching across the wings
        getobjectxy(LOCALID_DIONYSUS_THEODOROS, CURRENT_POSITION, VAR_0x8008, VAR_0x8009)
        if (var(VAR_0x8009) == 14) {
            applymovement(LOCALID_DIONYSUS_THEODOROS, ThyrsaCity_TempleOfDionysus_Movement_BackToPost1)
        } else {
            applymovement(LOCALID_DIONYSUS_THEODOROS, Common_Movement_FaceUp)
        }
        waitmovement(0)
        release
        end
    }
    trainerbattle_single(TRAINER_ICHOR_THEODOROS,
        format("The third act! Everyone's nervous in the third act. Show me your nerve."),
        format("Bravo. Truly. I never say that."))
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameTheodoros)
    msgbox(format("The program forgets the last entrance. Every year. On purpose.\p"
                  "Ask yourself what a tragedy is missing."), MSGBOX_AUTOCLOSE)
    end
}

// --- The god-machine, the roof, Thespis ---------------------------------------------------

script ThyrsaCity_TempleOfDionysus_EventScript_Hook {
    if (var(VAR_ICHOR_THREE_ACT_PLAY) < 3) {
        end
    }
    lockall
    setspeaker(SP_NAME_NONE)
    if (flag(FLAG_BADGE04_GET)) {
        msgbox(format("The god-machine's hook. Its rope is tied off now: the god has made his exit."))
        releaseall
        end
    }
    msgbox(format("The god-machine's hook hangs at your shoulder. A god's entrance, by rope.\p"
                  "Hold on?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    closemessage
    playse(SE_ELEVATOR)
    fadescreen(FADE_TO_BLACK)
    waitse
    setvar(VAR_ICHOR_THREE_ACT_PLAY, 4)
    warpsilent(MAP_THYRSA_CITY_TEMPLE_OF_DIONYSUS, 11, 4)
    waitstate
    end
}

// VAR_ICHOR_THREE_ACT_PLAY is 4 from the hook to the laurel. On the roof, that is the
// player's arrival by the machine; anywhere else, they lost to Thespis and came back in
// by the door, and the machine waits on the stage again.
script ThyrsaCity_TempleOfDionysus_EventScript_OnTheRoof {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8005) > 4) {
        setvar(VAR_ICHOR_THREE_ACT_PLAY, 3)
        end
    }
    lockall
    goto(ThyrsaCity_TempleOfDionysus_EventScript_ThespisScene)
}

script ThyrsaCity_TempleOfDionysus_EventScript_ThespisScene {
    applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
    applymovement(LOCALID_DIONYSUS_THESPIS, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThespis)
    msgbox(format("An entrance from the machine! Like a god! The audience loves that."))
    closemessage
    // He stands, turns his back a moment, and turns round in the comic mask.
    // ICHOR_STUB_TRAINER_ART: swap his walker's tragic face for the comic one while his
    // back is turned, once the sprites agent's Thespis has both masks.
    applymovement(LOCALID_DIONYSUS_THESPIS, ThyrsaCity_TempleOfDionysus_Movement_ThespisTurns)
    waitmovement(0)
    playse(SE_CLICK)
    waitse
    msgbox(format(
        "I'm Thespis. The first fool who stepped out of the chorus and spoke alone.\p"
        "That's all an actor is. Somebody who stepped out.\p"
        "You read the program. You found the part it left out.\p"
        "They took my masks, you know. Every one but this old face."))
    setspeaker(SP_NAME_NONE)
    msgbox(format("He touches the mask on his face. It blinks. It's a Prosomime."))
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThespis)
    msgbox(format(
        "She's been with me forty years. She'll do.\p"
        "A good actor only needs one face. The rest are for showing off.\p"
        "Places, please!"))
    closemessage
    trainerbattle_no_intro(TRAINER_ICHOR_THESPIS_1, format("Curtain! …And what a curtain."))
    goto(ThyrsaCity_TempleOfDionysus_EventScript_ThespisDefeated)
}

script ThyrsaCity_TempleOfDionysus_EventScript_ThespisDefeated {
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThespis)
    msgbox(format(
        "Well. That's the review, then. A good one.\p"
        "The Mask Laurel. Ivy and laurel together. The god likes both."))
    setflag(FLAG_BADGE04_GET)
    setvar(VAR_ICHOR_THREE_ACT_PLAY, 5)
    // ICHOR_STUB_RITES: Dionysus Favor +15 (SCRIPT.md beat 31): setvar(VAR_0x8004,
    // ICHOR_GOD_DIONYSUS), setvar(VAR_0x8005, ICHOR_FAVOR_LAUREL), special(Ichor_AddFavor).
    setspeaker(SP_NAME_NONE)
    message(format("{PLAYER} received the Mask Laurel from Thespis!"))
    waitmessage
    call(Common_EventScript_PlayGymBadgeFanfare)
    call(ThyrsaCity_TempleOfDionysus_EventScript_GiveToxic)
    // The Star Chart's Crater, constellation 2 (SYSTEMS.md §8: Laurel 4).
    setflag(FLAG_ICHOR_CONSTELLATIONS_START + 1)
    setspeaker(SP_NAME_NONE)
    playse(SE_SHINY)
    msgbox(format("A cup of stars fills a patch of your Star Chart. The Crater: the god's own cup."))
    waitse
    // Dionysus's rite (SYSTEMS.md §3): the Hierophant teaches it, with one free Wine.
    // ICHOR_STUB_RITES and ICHOR_STUB_OFFERINGS: call EventScript_IchorHierophantRite with
    // VAR_0x8004 = ICHOR_GOD_DIONYSUS; it gives ITEM_WINE and sets the Hierophant's-offering
    // flag (FLAG_ICHOR_GIFTS_START + 4 * ICHOR_GOD_DIONYSUS + 3). Until then the lines play
    // and the Wine is skipped.
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThespis)
    msgbox(format(
        "The god likes wine. Unwatered. He's not a fussy god, but he has standards.\p"
        "Pour it on his altar and see what he does. Nobody ever knows."))
    msgbox(format(
        "The play's tonight. With my masks or without them.\p"
        "I'll be backstage. If anything goes wrong, come and find me.\p"
        "Something always goes wrong on a first night. That's how you know it's theater."))
    closemessage
    // He steps onto the crane's hook and is lowered out of sight.
    applymovement(LOCALID_DIONYSUS_THESPIS, ThyrsaCity_TempleOfDionysus_Movement_ThespisToHook)
    waitmovement(0)
    playse(SE_ELEVATOR)
    applymovement(LOCALID_DIONYSUS_THESPIS, ThyrsaCity_TempleOfDionysus_Movement_ThespisLowered)
    waitmovement(0)
    waitse
    fadescreen(FADE_TO_BLACK)
    warpsilent(MAP_THYRSA_CITY_TEMPLE_OF_DIONYSUS, 10, 46)
    waitstate
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_GiveToxic {
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThespis)
    msgbox(format("And Toxic. A slow poison. Like a long second act."))
    checkitemspace(ITEM_TM06)
    if (var(VAR_RESULT) == FALSE) {
        setspeaker(SP_NAME_NONE)
        msgbox(gText_TooBadBagIsFull)
        return
    }
    setvar(VAR_0x8006, ITEM_TM06)
    additem(ITEM_TM06)
    setflag(FLAG_ICHOR_GOT_TM_TOXIC)
    setspeaker(SP_NAME_NONE)
    playfanfare(MUS_OBTAIN_TMHM)
    message(format("{PLAYER} received TM06, Toxic!"))
    waitmessage
    showitemdescription
    waitfanfare
    waitbuttonpress
    hideitemdescription
    return
}

// On the roof he plays his scene on the player's arrival (OnTheRoof); after the laurel he
// stands by the altar inside the door.
script ThyrsaCity_TempleOfDionysus_EventScript_Thespis {
    lock
    faceplayer
    if (!flag(FLAG_BADGE04_GET)) {
        goto(ThyrsaCity_TempleOfDionysus_EventScript_ThespisScene)
    }
    if (!flag(FLAG_ICHOR_GOT_TM_TOXIC)) {
        call(ThyrsaCity_TempleOfDionysus_EventScript_GiveToxic)
        release
        end
    }
    setspeaker(ThyrsaCity_TempleOfDionysus_Text_NameThespis)
    msgbox(format("Comedy or tragedy? Ask me tomorrow. Today I'm both."))
    // ICHOR_STUB_RITES: gift I, TM Swagger at Dionysus Favor 30 (SCRIPT.md beat 31):
    // setvar(VAR_0x8004, ICHOR_GOD_DIONYSUS), call(EventScript_IchorHierophantGift); its
    // line is "The god's pleased with you. He told me in a dream. He was very drunk."
    release
    end
}

script ThyrsaCity_TempleOfDionysus_EventScript_Thunder {
    msgbox(format("A bronze sheet hung in a frame. Shake it, and the god thunders over the audience."),
        MSGBOX_SIGN)
    end
}

// --- Text and movement -------------------------------------------------------------------

text ThyrsaCity_TempleOfDionysus_Text_NameLasos { "LASOS" }
text ThyrsaCity_TempleOfDionysus_Text_NameMynniskos { "MYNNISKOS" }
text ThyrsaCity_TempleOfDionysus_Text_NameThettalos { "THETTALOS" }
text ThyrsaCity_TempleOfDionysus_Text_NameTheodoros { "THEODOROS" }
text ThyrsaCity_TempleOfDionysus_Text_NameThespis { "THESPIS" }
text ThyrsaCity_TempleOfDionysus_Text_Comic { "COMIC" }
text ThyrsaCity_TempleOfDionysus_Text_Tragic { "TRAGIC" }
text ThyrsaCity_TempleOfDionysus_Text_Satyr { "SATYR" }
text ThyrsaCity_TempleOfDionysus_Text_None { "NONE" }

// A right entrance: through the doorway and out onto the stage.
movement ThyrsaCity_TempleOfDionysus_Movement_Enter { walk_up * 3 }
movement ThyrsaCity_TempleOfDionysus_Movement_BackToPost1 { walk_down face_up }
movement ThyrsaCity_TempleOfDionysus_Movement_CameraUp4 { walk_up * 4 }
movement ThyrsaCity_TempleOfDionysus_Movement_CameraDown4 { walk_down * 4 }
movement ThyrsaCity_TempleOfDionysus_Movement_ThespisTurns {
    face_up
    delay_16 * 3
    face_right
}
movement ThyrsaCity_TempleOfDionysus_Movement_ThespisToHook { walk_right * 3 face_down }
movement ThyrsaCity_TempleOfDionysus_Movement_ThespisLowered { delay_16 set_invisible }
