mapscripts Daphni_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        special(Ichor_ReleaseTimeOfDay)
        setrespawn(HEAL_LOCATION_DAPHNI)
    }
}

// Generated by tools/ichor/maps/sacredway.py; edit the builder, not this file.

script Daphni_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_DAPHNI_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}

script Daphni_EventScript_Merchant {
    goto(ArkadiaApproach_EventScript_Merchant)
}

script Daphni_EventScript_Guide {
    lock
    faceplayer
    msgbox(format("The pass opens onto Astyra.\pThe city's full of people who know exactly when the world ends. None of them agree what to do until then."))
    release
}

script Daphni_EventScript_Daphne {
    lock
    faceplayer
    msgbox(format("I'm Daphne. Like the laurel! Like the lady who ran from Apollo and turned into a tree.\pPapa cuts the laurel for the god's crowns. He says I'm not allowed to turn into one."))
    release
}

script Daphni_EventScript_Traveler {
    lock
    faceplayer
    msgbox(format("A Persian king sat on this rock once, they say, to watch his ships win at Salamis.\p"
                  "He watched them sink instead. Kings should sit lower.\p"
                  "Me? I came from the east, across the water. Past the Troad, where a city burned for a woman.\p"
                  "There's a whole world out there your herms don't reach. Not yet."))
    setflag(FLAG_ICHOR_DAPHNI_TRAVELER_TOLD)
    release
}

script Daphni_EventScript_Sign {
    msgbox(format("DAPHNI\nApollo's laurels at the top of the Sacred Way.\pWest: the pass and Eleusa. East: the Kephisos and Astyra."), MSGBOX_SIGN)
    end
}

script Daphni_EventScript_Altar {
    msgbox(format("Apollo Daphnaios's altar. A laurel crown lies on it, still green."), MSGBOX_SIGN)
    end
}

script Daphni_EventScript_Laurel {
    lockall
    if (flag(FLAG_ICHOR_DAPHNI_CORD_CUT)) {
        msgbox(format("The prayer laurel. Where the cord was, the bark is healing over."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("Someone tied a little prayer to the laurel.\pThe string has cut into its bark."), MSGBOX_DEFAULT)
    checkitem(ITEM_DEMETERS_SICKLE)
    if (var(VAR_RESULT) == FALSE) {
        releaseall
        end
    }
    msgbox(format("Cut the cord free with Demeter's Sickle? The prayer stays on the branch."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setvar(VAR_0x8004, ITEM_DEMETERS_SICKLE)
        call(EventScript_IchorRelicPose)
        playse(SE_M_CUT)
        setflag(FLAG_ICHOR_DAPHNI_CORD_CUT)
        msgbox(format("The cord falls away. The little prayer stays tucked in the leaves."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Daphni_EventScript_Fountain {
    msgbox(format("The pilgrims' fountain. Everyone on the Sacred Way washes the road off here,\pgoing out to the Mysteries and coming home from them."), MSGBOX_SIGN)
    end
}

script Daphni_EventScript_Seat {
    msgbox(format("A stone seat cut in the rock, looking south over the gulf to Salamis."), MSGBOX_SIGN)
    end
}
