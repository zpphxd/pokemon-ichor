// Eleusa Village: the village of the Mysteries. design/phase2/SCRIPT.md, "Eleusa
// Village" (Part 2), its signs, Part 6's items, and beats 19, 20 and 22.
//
// The layout and map.json's events come from tools/ichor/maps/eleusa.py, which
// also writes the generated block at the end of this file. This file holds the
// village's everyday life (its people, signs and stubs) and its story scenes:
//   beat 19  Krokis's gate: the saffron thread, once, on the road in from Route 5
//   beat 20  arrival (FLAG_ICHOR_ARRIVED_ELEUSA, the fly flag) and Kleon in the square
//   beat 22  the procession arrives as the player walks out of the Telesterion with the
//            Harvest Laurel; Kerykos's YES closes the doors and the night of the
//            Mysteries plays in the Telesterion (its scripts.pory)
// The morning after (beats 24-25) comes with the next batch.
//
// Temp vars: VAR_TEMP_8 is 1 once the saffron thread is tied (Krokis's gate triggers
// read it); VAR_TEMP_9 is 1 while the procession's arrival waits to play (ON_FRAME).
//
// Stubs, until the engine session's batches land (design/phase2/BUILD.md):
//   ICHOR_STUB_RITES   Demeter's field shrine shows its text, nothing about prayer
//   ICHOR_STUB_DIG     the fields' two daily dig spots show the turned earth only
//   ICHOR_STUB_SPRITE  the initiates walk as pilgrims and youths, Eudemos as an elder

mapscripts EleusaVillage_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // beat 20: the first step in, and Eleusa is a place the Wings can find
        setflag(FLAG_ICHOR_ARRIVED_ELEUSA)
        setflag(FLAG_ICHOR_VISITED_ELEUSA)
        if (flag(FLAG_ICHOR_SAFFRON_THREAD)) {
            setvar(VAR_TEMP_8, 1)
        }
        call(EleusaVillage_EventScript_PlaceCast)
    }
    MAP_SCRIPT_ON_LOAD {
        if (!flag(FLAG_ICHOR_SANCTUM_OPEN)) {
            call(EleusaVillage_EventScript_ShutPloutonion)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_9, 1: EleusaVillage_EventScript_ProcessionArrives
    ]
}

// Who is in the village: Kleon waits in the square until the Mysteries begin; the
// procession is here from the Harvest Laurel until then. Its arrival plays once, on
// the first step out with the Laurel.
script EleusaVillage_EventScript_PlaceCast {
    if (flag(FLAG_ICHOR_MYSTERIES_BEGUN)) {
        setflag(FLAG_ICHOR_HIDE_KLEON_ELEUSA)
        setflag(FLAG_ICHOR_HIDE_PROCESSION_ELEUSA)
        return
    }
    clearflag(FLAG_ICHOR_HIDE_KLEON_ELEUSA)
    if (flag(FLAG_BADGE03_GET)) {
        clearflag(FLAG_ICHOR_HIDE_PROCESSION_ELEUSA)
        if (!flag(FLAG_ICHOR_PROCESSION_ARRIVED)) {
            setvar(VAR_TEMP_9, 1)
        }
    } else {
        setflag(FLAG_ICHOR_HIDE_PROCESSION_ELEUSA)
    }
    return
}

