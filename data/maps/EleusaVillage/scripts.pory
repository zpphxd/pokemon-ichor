// ---------------------------------------------------------------------------
// Beat 19: Krokis's gate
// ---------------------------------------------------------------------------

// The road in from Route 5 crosses the trigger two steps short of her stool. The
// player steps up beside her (above her, at (8, 26)) and holds out a hand.
script EleusaVillage_EventScript_KrokisGate {
    lockall
    setvar(VAR_TEMP_8, 1)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    switch (var(VAR_0x8005)) {
        case 24:
            applymovement(OBJ_EVENT_ID_PLAYER, EleusaVillage_Movement_ToKrokisFrom24)
        case 25:
            applymovement(OBJ_EVENT_ID_PLAYER, EleusaVillage_Movement_ToKrokisFrom25)
        case 26:
            applymovement(OBJ_EVENT_ID_PLAYER, EleusaVillage_Movement_ToKrokisFrom26)
        default:
            applymovement(OBJ_EVENT_ID_PLAYER, EleusaVillage_Movement_ToKrokisFrom27)
    }
    waitmovement(0)
    turnobject(LOCALID_ELEUSA_KROKIS, DIR_NORTH)
    call(EleusaVillage_EventScript_SaffronThread)
    releaseall
    end
}

movement EleusaVillage_Movement_ToKrokisFrom24 { walk_right * 2 walk_down * 2 face_down }
movement EleusaVillage_Movement_ToKrokisFrom25 { walk_right * 2 walk_down face_down }
movement EleusaVillage_Movement_ToKrokisFrom26 { walk_right * 2 face_down }
movement EleusaVillage_Movement_ToKrokisFrom27 { walk_up walk_right * 2 face_down }

// The saffron thread (SCRIPT.md beat 19): tied three times, and three times it slides
// off the player's wrist into the dust. Never explained here (Alethea mentions it
// once, in beat 25).
script EleusaVillage_EventScript_SaffronThread {
    setspeaker(EleusaVillage_Text_NameKrokis)
    msgbox(format("Welcome to Eleusa, traveler. Hold out your right hand.\p"
                  "My family's tied the saffron thread on pilgrims for a thousand years.\p"
                  "Right wrist, and the Kore keeps you safe below. There."))
    closemessage
    call(EleusaVillage_EventScript_ThreadSlips)
    msgbox(format("…Hm. Bad knot. Again."))
    closemessage
    call(EleusaVillage_EventScript_ThreadSlips)
    msgbox(format("That's never… Once more."))
    closemessage
    call(EleusaVillage_EventScript_ThreadSlips)
    // She looks at it for a long while.
    applymovement(LOCALID_ELEUSA_KROKIS, Common_Movement_QuestionMark)
    waitmovement(0)
    delay(60)
    msgbox(format("Well! It must be the damp. It's been very damp this year.\p"
                  "Go on in.\p"
                  "Go on."))
    closemessage
    setspeaker(SP_NAME_NONE)
    setflag(FLAG_ICHOR_SAFFRON_THREAD)
    return
}

// She ties it (a soft sound), and it slides off: hold 30 frames.
script EleusaVillage_EventScript_ThreadSlips {
    playse(SE_M_STRING_SHOT)
    delay(30)
    applymovement(LOCALID_ELEUSA_KROKIS, EleusaVillage_Movement_KrokisTies)
    waitmovement(0)
    delay(30)
    return
}

movement EleusaVillage_Movement_KrokisTies { walk_in_place_up }

// Spoken to: the thread first, if the gate hasn't played (the player came in some
// other way); then the damp.
script EleusaVillage_EventScript_Krokis {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_SAFFRON_THREAD)) {
        setvar(VAR_TEMP_8, 1)
        call(EleusaVillage_EventScript_SaffronThread)
        release
        end
    }
    setspeaker(EleusaVillage_Text_NameKrokis)
    msgbox(format("Well! It must be the damp. It's been very damp this year."))
    release
}

// ---------------------------------------------------------------------------
// Beat 20: Kleon in the square
// ---------------------------------------------------------------------------

script EleusaVillage_EventScript_Kleon {
    lock
    faceplayer
    setspeaker(EleusaVillage_Text_NameKleon)
    if (flag(FLAG_BADGE03_GET)) {
        // After the trial, before the Mysteries: he never found Chloe in the dark.
        msgbox(format("You got Chloe's laurel? …I never found her. In the dark.\p"
                      "I ran into eleven pillars. Doso counted.\p"
                      "She says I went down fine. I just never came back up.\p"
                      "Doesn't matter. I'll get it later. Nothing in the dark matters."))
    } else {
        msgbox(format("I'm getting initiated. Tonight, when the procession gets here.\p"
                      "Not because I'm scared of anything. Because it's educational.\p"
                      "Educational and nothing else."))
    }
    release
}

// ---------------------------------------------------------------------------
// Beat 22: the procession arrives
// ---------------------------------------------------------------------------

// Out of the Telesterion with the Harvest Laurel: the procession has come up the Sacred
// Way and filled the court. It plays on the first step out of the hall, on the steps
// (25, 12) where its stair lands the player: Alethea comes up to them, and Kerykos steps
// over from his place beside the door. (Coming into the village any other way, the
// procession is simply there, and the arrival waits for the next walk out of the hall.)
script EleusaVillage_EventScript_ProcessionArrives {
    setvar(VAR_TEMP_9, 2)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) != 25 || var(VAR_0x8005) != 12) {
        end
    }
    lockall
    setflag(FLAG_ICHOR_PROCESSION_ARRIVED)
    delay(16)
    applymovement(LOCALID_ELEUSA_ALETHEA, EleusaVillage_Movement_AletheaToSteps)
    waitmovement(0)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
    setspeaker(EleusaVillage_Text_NameAlethea)
    msgbox(format("We made it! Very slowly. Every step of the way. On purpose.\p"
                  "I sent word to Daphne with one of Kerykos's runners. She's coming.\p"
                  "She hates boats. She'll arrive cross."))
    closemessage
    applymovement(LOCALID_ELEUSA_KERYKOS, EleusaVillage_Movement_KerykosToPlayer)
    waitmovement(0)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_EAST)
    setspeaker(EleusaVillage_Text_NameKerykos)
    msgbox(format("{PLAYER}! A laurel from my cousin! Did she say anything? Anything at all?\p"
                  "…“Good.” Ha! That's practically a speech, for Chloe.\p"
                  "The Mysteries open when the doors close. Heal up first.\p"
                  "Once those doors shut, they don't open till it's done."))
    closemessage
    setspeaker(SP_NAME_NONE)
    applymovement(LOCALID_ELEUSA_KERYKOS, EleusaVillage_Movement_KerykosBack)
    applymovement(LOCALID_ELEUSA_ALETHEA, EleusaVillage_Movement_AletheaBack)
    waitmovement(LOCALID_ELEUSA_KERYKOS)
    waitmovement(LOCALID_ELEUSA_ALETHEA)
    releaseall
    end
}

movement EleusaVillage_Movement_AletheaToSteps { walk_right walk_up face_up }
movement EleusaVillage_Movement_AletheaBack { walk_down walk_left face_up }
movement EleusaVillage_Movement_KerykosToPlayer { walk_left face_left }
movement EleusaVillage_Movement_KerykosBack { walk_right face_left }

// Kerykos on the Telesterion's steps: YES closes the doors on the night of the Mysteries.
script EleusaVillage_EventScript_Kerykos {
    lock
    faceplayer
    setspeaker(EleusaVillage_Text_NameKerykos)
    msgbox(format("Ready? Doors are closing."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Don't be long. I hate waiting quietly. I hate it loudly too."))
        release
        end
    }
    closemessage
    setspeaker(SP_NAME_NONE)
    setflag(FLAG_ICHOR_MYSTERIES_BEGUN)
    fadescreen(FADE_TO_BLACK)
    // The Telesterion's ON_TRANSITION sees FLAG_ICHOR_MYSTERIES_BEGUN and seats everyone.
    warpsilent(MAP_ELEUSA_VILLAGE_TEMPLE_OF_DEMETER, 13, 17)
    waitstate
    release
    end
}

script EleusaVillage_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(EleusaVillage_Text_NameAlethea)
    msgbox(format("I sent word to Daphne with one of Kerykos's runners. She's coming.\p"
                  "She hates boats. She'll arrive cross."))
    release
}

script EleusaVillage_EventScript_Eudemos {
    lock
    faceplayer
    setspeaker(EleusaVillage_Text_NameEudemos)
    msgbox(format("Every year since there was a year, the procession walks to Eleusa."))
    release
}

