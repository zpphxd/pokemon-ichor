mapscripts Nemea_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_NEMEA)
    }
}

// Generated by tools/ichor/maps/nemea.py; edit the builder, not this file.

script Nemea_EventScript_Sign {
    msgbox(format("NEMEA\nWhere the Games are held for Zeus.\pWest: Arkadia. East: the Tretos road to Emporion."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_Zeus {
    msgbox(format("The altar of Zeus's old temple. Its columns lie in drums across the paving.\p"
                  "A shepherd has left a little wool at the foot of the stone."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_LionCave {
    msgbox(format("A warning stele: THE LION'S DEN. KEEP OUT.\p"
                  "The den has two mouths. A great boulder seals the low one.\p"
                  "The other is high in the cliff. Something breathes inside."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_Mound {
    msgbox(format("The mound of Opheltes, the baby the Games were first held for.\pVictors still leave a sprig of wild celery here."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_Spring {
    msgbox(format("The Langia spring. Its water falls from a cleft in the stone.\p"
                  "Behind the fall there's a hollow, and the gleam of something old.\p"
                  "You'd need to climb the water itself to reach it."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_HighMouth {
    msgbox(format("Handholds cut long ago climb to the den's high mouth.\pClaw marks score the rock beside them."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_Track {
    msgbox(format("A turning post of the stadium. Runners round it and race back."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_Tunnel {
    msgbox(format("The athletes' tunnel, where runners came out to the crowd.\pIts far end is bricked up. Someone has scratched a pair of wings on the bricks."), MSGBOX_SIGN)
    end
}

script Nemea_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_NEMEA_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}

script Nemea_EventScript_Merchant {
    goto(ArkadiaApproach_EventScript_Merchant)
}

script Nemea_EventScript_Guide {
    lock
    faceplayer
    msgbox(format("Down from Arkadia? Then you've seen the new moon.\pEmporion lies east, through the Tretos. Take a light; the pass runs under the hill.\pStay on the road. I still count my goats twice."))
    release
}

script Nemea_EventScript_Runner {
    lock
    faceplayer
    msgbox(format("We train for the next Games. One lap of the track, there and back.\pThe old runners say a pair of winged sandals once ran it in a breath.\pIf you ever find wings for your feet, come race me."))
    release
}

script Nemea_EventScript_Discus {
    lock
    faceplayer
    msgbox(format("The prize here is a crown of wild celery. It wilts in a week.\pThat's the point. You have to keep winning."))
    release
}

script Nemea_EventScript_Keeper {
    lock
    faceplayer
    msgbox(format("I sweep Zeus's paving. Every drum you see was a column once.\pHerakles dedicated the Games here, after the lion. Its den is up in the crag.\pIt's been sealed since. Some nights, it isn't quiet."))
    release
}
