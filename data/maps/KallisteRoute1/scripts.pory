// Route 1: Elaia Village to Akti Town, beat 5. Text from design/phase1/SCRIPT.md,
// Part 2 (Route 1 roster) and Part 3 (Route 1 trainers).
// Layout and events are generated by tools/ichor/maps/route1.py.

mapscripts KallisteRoute1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // The flock moves off the road once Kronion Hill is quiet again.
        if (flag(FLAG_ICHOR_RUINS_CLEARED)) {
            setflag(FLAG_ICHOR_HIDE_ROUTE1_FLOCK)
        }
    }
}

// --- named speakers (name box); unnamed townsfolk and animals have none -----
text KallisteRoute1_Text_SpeakerAmaryllis { "AMARYLLIS" }
text KallisteRoute1_Text_SpeakerTityros { "TITYROS" }
text KallisteRoute1_Text_SpeakerPhyllis { "PHYLLIS" }
text KallisteRoute1_Text_SpeakerKomatas { "KOMATAS" }
text KallisteRoute1_Text_SpeakerAgis { "AGIS" }
text KallisteRoute1_Text_SpeakerPolyeidos { "POLYEIDOS" }

// --- the carter and her Mudbray (south grove) --------------------------------
script KallisteRoute1_EventScript_Carter {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_GOT_MOOMOO_MILK)) {
        msgbox(format("Thirsty? Here, my last bottle. Fresh this morning."))
        giveitem(ITEM_MOOMOO_MILK)
        if (var(VAR_RESULT) == FALSE) {
            goto(Common_EventScript_ShowBagIsFull)
        }
        setflag(FLAG_ICHOR_GOT_MOOMOO_MILK)
    }
    msgbox(format("It's goat's milk. The bottle says Moomoo. Don't ask me why."))
    closemessage
    call(KallisteRoute1_EventScript_MudbrayBrays)
    release
}

script KallisteRoute1_EventScript_Mudbray {
    lock
    call(KallisteRoute1_EventScript_MudbrayBrays)
    release
}

script KallisteRoute1_EventScript_MudbrayBrays {
    playmoncry(SPECIES_MUDBRAY, CRY_MODE_NORMAL)
    msgbox(format("Hrrrnk!"))
    waitmoncry
    closemessage
}

// --- the youth sitting on the field wall ------------------------------------
script KallisteRoute1_EventScript_WallYouth {
    msgbox(format("No partner for me. Daphne said “next year.”\pShe said that last year too. I'm starting to see a pattern."), MSGBOX_NPC)
}

// --- Wooloo -----------------------------------------------------------------
script KallisteRoute1_EventScript_GrazingWooloo {
    lock
    faceplayer
    playmoncry(SPECIES_WOOLOO, CRY_MODE_NORMAL)
    msgbox(format("Baa?"))
    waitmoncry
    release
}

// Amaryllis's flock, planted across the road until the ruins are cleared.
script KallisteRoute1_EventScript_FlockWooloo {
    lock
    playmoncry(SPECIES_WOOLOO, CRY_MODE_NORMAL)
    msgbox(format("Baaa."))
    waitmoncry
    release
}

script KallisteRoute1_EventScript_Amaryllis {
    setspeaker(KallisteRoute1_Text_SpeakerAmaryllis)
    if (!flag(FLAG_ICHOR_RUINS_CLEARED)) {
        msgbox(format("They won't budge. Not one of them. Not since sunrise.\pThe ground's been humming up on Kronion Hill. Feel it?\pSheep know things. Mostly about grass. But they know things."), MSGBOX_NPC)
    } else {
        msgbox(format("They're moving! The humming stopped and they just… went.\pWhatever you did up there, the flock thanks you. Baa."), MSGBOX_NPC)
    }
}

// --- the olive farmer under the big olive -----------------------------------
script KallisteRoute1_EventScript_OliveFarmer {
    // The post-game: a bent olive root for Diktys's boat (data/scripts/ichor_postgame_crew.pory)
    if (flag(FLAG_ICHOR_POSTGAME) && flag(FLAG_ICHOR_PG_DIKTYS_ASKED) && !flag(FLAG_ICHOR_PG_GOT_BIG_ROOT)) {
        goto(EventScript_IchorPgCrew_OliveFarmerRoot)
    }
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_GOT_ROUTE1_SITRUS)) {
        msgbox(format("I'd give you oil, but you can't carry oil. Take a berry."))
        giveitem(ITEM_SITRUS_BERRY)
        if (var(VAR_RESULT) == FALSE) {
            goto(Common_EventScript_ShowBagIsFull)
        }
        setflag(FLAG_ICHOR_GOT_ROUTE1_SITRUS)
    }
    msgbox(format("Pick the olives, rest in the shade. That's the whole secret."))
    release
}

// --- trainers, south to north ------------------------------------------------
script KallisteRoute1_EventScript_Tityros {
    trainerbattle_single(TRAINER_ICHOR_TITYROS, KallisteRoute1_Text_TityrosIntro, KallisteRoute1_Text_TityrosDefeat)
    setspeaker(KallisteRoute1_Text_SpeakerTityros)
    msgbox(format("Sheep are easy. Stand still, look like grass."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_Text_TityrosIntro {
    format("You've got a partner? Let's see if it can herd!")
}

text KallisteRoute1_Text_TityrosDefeat {
    format("Scattered my flock! It'll take all afternoon to round them up.")
}

script KallisteRoute1_EventScript_Phyllis {
    trainerbattle_single(TRAINER_ICHOR_PHYLLIS, KallisteRoute1_Text_PhyllisIntro, KallisteRoute1_Text_PhyllisDefeat)
    setspeaker(KallisteRoute1_Text_SpeakerPhyllis)
    msgbox(format("Every olive tree on Kalliste came from one cutting. Or so Gran says."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_Text_PhyllisIntro {
    format("Festival day and I'm still picking. Battle me, I need a break.")
}

text KallisteRoute1_Text_PhyllisDefeat {
    format("That's fair. My Smoliv were up since dawn too.")
}

script KallisteRoute1_EventScript_Komatas {
    trainerbattle_single(TRAINER_ICHOR_KOMATAS, KallisteRoute1_Text_KomatasIntro, KallisteRoute1_Text_KomatasDefeat)
    setspeaker(KallisteRoute1_Text_SpeakerKomatas)
    msgbox(format("Got locked in a cedar chest once, as a boy.\pBees fed me honey till I got out."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_Text_KomatasIntro {
    format("My goats climb anything. Let's see you climb this battle!")
}

text KallisteRoute1_Text_KomatasDefeat {
    format("Ha! Good. The bees liked you. That's rare.")
}

script KallisteRoute1_EventScript_Agis {
    trainerbattle_single(TRAINER_ICHOR_AGIS, KallisteRoute1_Text_AgisIntro, KallisteRoute1_Text_AgisDefeat)
    setspeaker(KallisteRoute1_Text_SpeakerAgis)
    msgbox(format("Kleon? He's been racing his prophecy since he could walk.\pHe'll catch it, too. That's what worries me."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_Text_AgisIntro {
    format("A Lakonian brings one spear to a fight. One is enough.")
}

text KallisteRoute1_Text_AgisDefeat {
    format("…Two spears next time.")
}

script KallisteRoute1_EventScript_Polyeidos {
    trainerbattle_single(TRAINER_ICHOR_POLYEIDOS, KallisteRoute1_Text_PolyeidosIntro, KallisteRoute1_Text_PolyeidosDefeat)
    setspeaker(KallisteRoute1_Text_SpeakerPolyeidos)
    msgbox(format("They're all flying away from the hill. Every one. Since dawn."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_Text_PolyeidosIntro {
    format("The birds are wrong today. Let me see if you're wrong too.")
}

text KallisteRoute1_Text_PolyeidosDefeat {
    format("You're not wrong. The birds still are.")
}

// --- herms ---------------------------------------------------------------------
script KallisteRoute1_EventScript_HermSouth {
    msgbox(format("A herm of Hermes marks the road.\pNorth: Akti Town. South: Elaia Village."), MSGBOX_SIGN)
}

script KallisteRoute1_EventScript_HermFork {
    msgbox(format("East: Kronion Hill. North: Akti Town."), MSGBOX_SIGN)
}

script KallisteRoute1_EventScript_HermNorth {
    msgbox(format("North: Akti Town. Mind the nets."), MSGBOX_SIGN)
}
