// The ring's state, drawn on load and after every change: lit braziers, opened
// doors and gates. Ichor_DrawThread goes after it.
script LabyrinthRing4_EventScript_DrawState {
    if (flag(FLAG_TEMP_4)) {
        setmetatile(44, 33, 0x234, FALSE)
        setmetatile(45, 33, 0x235, FALSE)
    } else {
        setmetatile(44, 33, 0x3CB, TRUE)
        setmetatile(45, 33, 0x3CB, TRUE)
    }
}

// Daedalus's floor seal Stair: the stair down is grated: three drums, and the third must go in first or wait
script LabyrinthRing4_EventScript_PlatesStair {
    if (flag(FLAG_TEMP_4)) {
        end
    }
    setvar(VAR_TEMP_9, 0)
    getobjectxy(LOCALID_LABYRINTHRING4_Stair_DRUM0, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 40 && var(VAR_0x8008) == 38) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 43 && var(VAR_0x8008) == 38) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 42 && var(VAR_0x8008) == 37) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_LABYRINTHRING4_Stair_DRUM1, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 40 && var(VAR_0x8008) == 38) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 43 && var(VAR_0x8008) == 38) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 42 && var(VAR_0x8008) == 37) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_LABYRINTHRING4_Stair_DRUM2, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 40 && var(VAR_0x8008) == 38) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 43 && var(VAR_0x8008) == 38) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 42 && var(VAR_0x8008) == 37) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_TEMP_9) == 3) {
        lockall
        setflag(FLAG_TEMP_4)
        call(LabyrinthRing4_EventScript_DrawState)
        special(DrawWholeMapView)
        playse(SE_DOOR)
        msgbox(format("Bronze clanks deep in the wall. Something has opened."), MSGBOX_DEFAULT)
        releaseall
    }
}

script LabyrinthRing4_EventScript_LeverStair {
    lockall
    msgbox(format("A bronze lever with a double axe for a handle: Daedalus's reset.\pPull it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        warpsilent(MAP_LABYRINTH_RING4, 46, 38)
        waitstate
    }
    releaseall
}

script LabyrinthRing4_EventScript_Remains1 {
    msgbox(format("A snapped spear, Titan-made, and claw marks on the rock beside it."), MSGBOX_SIGN)
}

script LabyrinthRing4_EventScript_Remains2 {
    msgbox(format("Chalked on the barracks wall: DRIVE IT WITH THE TORCHES. IT HATES THE TORCHES."), MSGBOX_SIGN)
}

script LabyrinthRing4_EventScript_Remains3 {
    msgbox(format("Bones, a broken shield with an owl on it, and a pack. The owl is Astyra's."), MSGBOX_SIGN)
}

// Hook for later (Hephaestus's Hammer (post-game)): the Titans' deepest dig, sealed by a great boulder only Hephaestus's Hammer breaks (post-game)
script LabyrinthRing4_EventScript_Lair4 {
    lockall
    if (!flag(FLAG_ICHOR_R4_STATIC)) {
        msgbox(format("Something shifts in the dark at the end of the passage."), MSGBOX_DEFAULT)
        closemessage
        setwildbattle(SPECIES_GEOGRIP, 56)
        dowildbattle
        setflag(FLAG_ICHOR_R4_STATIC)
    } else {
        msgbox(format("Old scratches on the rock. Whatever lived here has gone."), MSGBOX_DEFAULT)
    }
    releaseall
}

// The Turning (LABYRINTH §7): the turned layout, from tools/ichor/maps/labyrinth_turning.py.
script LabyrinthRing4_EventScript_TurningWalls {
    setmetatile(9, 14, 0x23A, TRUE)
    setmetatile(10, 14, 0x251, TRUE)
    setmetatile(11, 14, 0x251, TRUE)
    setmetatile(12, 14, 0x239, TRUE)
    setmetatile(9, 15, 0x240, TRUE)
    setmetatile(10, 15, 0x261, TRUE)
    setmetatile(11, 15, 0x25F, TRUE)
    setmetatile(12, 15, 0x23C, TRUE)
    setmetatile(32, 37, 0x24C, TRUE)
    setmetatile(33, 37, 0x248, TRUE)
    setmetatile(32, 38, 0x24C, TRUE)
    setmetatile(33, 38, 0x248, TRUE)
    setmetatile(32, 39, 0x24C, TRUE)
    setmetatile(33, 39, 0x248, TRUE)
    setmetatile(32, 40, 0x239, TRUE)
    setmetatile(33, 40, 0x23A, TRUE)
    if (var(VAR_TEMP_D) != 0) {
        setmetatile(32, 37, 0x25B, TRUE)
        setmetatile(33, 37, 0x25D, TRUE)
        setmetatile(32, 38, 0x320, FALSE)
        setmetatile(33, 38, 0x32B, FALSE)
        setmetatile(32, 39, 0x32B, FALSE)
        setmetatile(33, 39, 0x320, FALSE)
        setmetatile(32, 40, 0x251, TRUE)
        setmetatile(33, 40, 0x251, TRUE)
    }
    if (var(VAR_TEMP_E) != 0) {
        setmetatile(9, 14, 0x248, TRUE)
        setmetatile(10, 14, 0x320, FALSE)
        setmetatile(11, 14, 0x32B, FALSE)
        setmetatile(12, 14, 0x24C, TRUE)
        setmetatile(9, 15, 0x248, TRUE)
        setmetatile(10, 15, 0x32B, FALSE)
        setmetatile(11, 15, 0x320, FALSE)
        setmetatile(12, 15, 0x24C, TRUE)
    }
}

script LabyrinthRing4_EventScript_TurningBreak0 {
    lockall
    setvar(VAR_TEMP_D, 1)
    playse(SE_M_EARTHQUAKE)
    msgbox(format("The wall ahead grinds shut across the passage."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_0x8004, 2)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, 10)
    setvar(VAR_0x8007, 3)
    special(ShakeCamera)
    waitstate
    playse(SE_M_MEGA_KICK)
    setmetatile(32, 37, 0x25B, TRUE)
    setmetatile(33, 37, 0x25D, TRUE)
    setmetatile(32, 38, 0x320, FALSE)
    setmetatile(33, 38, 0x32B, FALSE)
    setmetatile(32, 39, 0x32B, FALSE)
    setmetatile(33, 39, 0x320, FALSE)
    setmetatile(32, 40, 0x251, TRUE)
    setmetatile(33, 40, 0x251, TRUE)
    special(Ichor_DrawThread)
    special(DrawWholeMapView)
    msgbox(format("Then it bursts. Horns, a tail, a cloud of dust, and Asterion is gone ahead.\pHe's clearing the way."), MSGBOX_DEFAULT)
    closemessage
    releaseall
}

