// The Agora of Thyrsa, a covered market hall (SCRIPT.md Part 2, Thyrsa; stock: Part 6).
// Room: tools/ichor/maps/thyrsa_rooms.py. Two counters at right angles: goods down the
// west side (the stallkeeper at (0,5), talked to from (2,5)), wine and offerings along
// the north wall (her stallkeeper at (4,2), from (4,4)), festival masks over it. The
// mask-seller stands in the hall until the Dionysia is done.
//
// The wine counter sells the offerings (SCRIPT.md Part 6): Olive Oil 200, Barley Cake
// 150 and Wine 300, the engine's items at SYSTEMS.md §3's prices.

mapscripts ThyrsaCity_Agora_MapScripts {}

script ThyrsaCity_Agora_EventScript_GoodsKeeper {
    lock
    faceplayer
    msgbox(format("Goods for the road! Balls, salves, rope. Everything but wine.\p"
                  "Wine's the other counter. Everyone finds it."))
    if (flag(FLAG_BADGE04_GET)) {
        pokemart(ThyrsaCity_Agora_Mart_AfterMaskLaurel)
    } else {
        pokemart(ThyrsaCity_Agora_Mart_Goods)
    }
    msgbox(format("Mind the masks on your way out. They stare."))
    release
}

mart ThyrsaCity_Agora_Mart_Goods {
    ITEM_GREAT_BALL
    ITEM_SUPER_POTION
    ITEM_HYPER_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_AWAKENING
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_FULL_HEAL
    ITEM_REVIVE
    ITEM_SUPER_REPEL
    ITEM_ESCAPE_ROPE
}

mart ThyrsaCity_Agora_Mart_AfterMaskLaurel {
    ITEM_GREAT_BALL
    ITEM_ULTRA_BALL
    ITEM_SUPER_POTION
    ITEM_HYPER_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_AWAKENING
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_FULL_HEAL
    ITEM_REVIVE
    ITEM_SUPER_REPEL
    ITEM_MAX_REPEL
    ITEM_ESCAPE_ROPE
}

script ThyrsaCity_Agora_EventScript_WineKeeper {
    lock
    faceplayer
    msgbox(format("Wine for the god? Wine for you? It's the same wine."))
    pokemart(ThyrsaCity_Agora_Mart_Offerings)
    release
}

mart ThyrsaCity_Agora_Mart_Offerings {
    ITEM_WINE
    ITEM_OLIVE_OIL
    ITEM_BARLEY_CAKE
}

script ThyrsaCity_Agora_EventScript_MaskSeller {
    msgbox(format("Masks! Comic, tragic, satyr! Be someone else for a night!\p"
                  "Masks don't work in battle. Nothing works in battle except battling."), MSGBOX_NPC)
}

script ThyrsaCity_Agora_EventScript_Customer {
    msgbox(format("Grapes, figs, cheese, wine. Then the play. Then more wine.\p"
                  "That's the festival. My husband calls it a pilgrimage."), MSGBOX_NPC)
}

script ThyrsaCity_Agora_EventScript_ChalkBoard {
    msgbox(format("Today's prices, in chalk. Wine is up. Someone has added: “So is everyone.”"), MSGBOX_SIGN)
}

script ThyrsaCity_Agora_EventScript_Vat {
    msgbox(format("A treading vat, empty and scrubbed, waiting for the vintage. Its staves are purple to the brim."),
           MSGBOX_SIGN)
}

script ThyrsaCity_Agora_EventScript_Pyramid {
    msgbox(format("Amphorae of wine, stacked into a pyramid. Nobody wants to take the top one."), MSGBOX_SIGN)
}
