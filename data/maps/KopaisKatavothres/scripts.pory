const KV_BRAZIER = FLAG_ICHOR_BRAZIERS_START + 0x5A
mapscripts KopaisKatavothres_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(KV_BRAZIER)) {
            call(KopaisKatavothres_EventScript_Lit)
        }
    }
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(KV_BRAZIER)) {
            setflashlevel(0)
        }
    }
}

// Generated by tools/ichor/maps/kopais.py; edit the builder, not this file.

script KopaisKatavothres_EventScript_DIPSAS {
    trainerbattle_single(TRAINER_ICHOR_KOPAIS_DIPSAS, format("Every drain mapped, every drop counted. You're a drop."), format("Uncounted."))
    msgbox(format("Kronos wants to know where all the water goes. So do I, now."), MSGBOX_AUTOCLOSE)
    end
}

script KopaisKatavothres_EventScript_AGAMEDES {
    trainerbattle_single(TRAINER_ICHOR_KOPAIS_AGAMEDES, format("Trophonios built Apollo's temple with his brother. Then the earth took him."), format("It takes everyone eventually."))
    msgbox(format("Lebadeia's just beyond the light. Mind the water."), MSGBOX_AUTOCLOSE)
    end
}

script KopaisKatavothres_EventScript_EastStele {
    msgbox(format("THE KATAVOTHRES.\nHere Kopais goes under the mountain."), MSGBOX_SIGN)
    end
}

script KopaisKatavothres_EventScript_WestStele {
    msgbox(format("THE KATAVOTHRES.\nOut to the Herkyna and Lebadeia."), MSGBOX_SIGN)
    end
}

script KopaisKatavothres_EventScript_Handholds {
    msgbox(format("Chalk marks and old handholds climb the wet rock.\pA draught comes down from somewhere above."), MSGBOX_SIGN)
    end
}

script KopaisKatavothres_EventScript_Brazier {
    setvar(VAR_0x8004, KV_BRAZIER)
    setvar(VAR_0x8005, TRUE)
    call(EventScript_IchorBrazier)
    if (flag(KV_BRAZIER)) {
        call(KopaisKatavothres_EventScript_Lit)
        special(DrawWholeMapView)
    }
    releaseall
}

script KopaisKatavothres_EventScript_Lit {
    setmetatile(21, 7, 0x2FA, TRUE)
    setmetatile(22, 7, 0x2FB, TRUE)
    setmetatile(21, 8, 0x302, TRUE)
    setmetatile(22, 8, 0x303, TRUE)
    return
}
