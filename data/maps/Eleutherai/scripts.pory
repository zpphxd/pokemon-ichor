// Eleutherai, the free town at Mt. Kithairon's foot: beat 27 (the plinth of the
// god who left) and the town's roster. Text from design/phase3/SCRIPT.md: beat 27
// and Part 2 (Eleutherai). Its three houses are the rooms agent's maps (warps 0-2).
// Layout and events are generated by tools/ichor/maps/kithairon.py.
//
// Staging: the empty plinth is at (5,13) on the old temple's paving; Alethea
// stands below it at (5,14), Oinoe sweeps the step at (5,17). The fort stands on
// its rock to the north-east, entered by a stair under its gate at (23,14-15).

mapscripts Eleutherai_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_ICHOR_VISITED_ELEUTHERAI)
    }
}

text Eleutherai_Text_SpeakerAlethea { "ALETHEA" }
text Eleutherai_Text_SpeakerOinoe { "OINOE" }
text Eleutherai_Text_SpeakerSentry { "SENTRY" }
text Eleutherai_Text_SpeakerOldMan { "OLD MAN" }
text Eleutherai_Text_GiveWater { "GIVE WATER" }
text Eleutherai_Text_NotNow { "NOT NOW" }

// --- beat 27: the plinth ------------------------------------------------------------
script Eleutherai_EventScript_Plinth {
    msgbox(format("A stone plinth, swept clean. Nothing stands on it.\pCut into the front: DIONYSOS ELEUTHEREUS. HE WHO SETS FREE."), MSGBOX_SIGN)
}

script Eleutherai_EventScript_Alethea {
    lockall
    hidefollower
    applymovement(LOCALID_ELEUTHERAI_ALETHEA, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Eleutherai_Text_SpeakerAlethea)
    msgbox(format("The god's statue stood here. Wood, very old. A face like a happy dog."))
    msgbox(format("Thyrsa borrowed it for the first Dionysia. To carry in the procession."))
    msgbox(format("That was three hundred years ago. They never brought it back."))
    closemessage
    applymovement(LOCALID_ELEUTHERAI_OINOE, Common_Movement_FaceUp)
    waitmovement(0)
    setspeaker(Eleutherai_Text_SpeakerOinoe)
    msgbox(format("They will. When he's ready."))
    msgbox(format("I sweep his step every morning. My mother did. Her mother did."))
    msgbox(format("A god likes to come home to a clean step."))
    setspeaker(Eleutherai_Text_SpeakerAlethea)
    msgbox(format("In three hundred years, has anyone asked Thyrsa to return it?"))
    setspeaker(Eleutherai_Text_SpeakerOinoe)
    msgbox(format("Ask a god to come home? You don't ask. You sweep."))
    closemessage
    // Oinoe goes back to sweeping. Alethea turns to the player.
    applymovement(LOCALID_ELEUTHERAI_OINOE, Eleutherai_Movement_Sweep)
    waitmovement(0)
    applymovement(LOCALID_ELEUTHERAI_ALETHEA, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Eleutherai_Text_SpeakerAlethea)
    msgbox(format("“He who sets free.” Eleutherai means free. Did you know?"))
    msgbox(format("A free town, with an empty plinth. I like that more than I should."))
    msgbox(format("I'll see you at the camp below Thyrsa. The herald says you can't miss it."))
    msgbox(format("You can smell it from the pass, apparently."))
    closemessage
    // Alethea walks north up the road, round whichever side the player isn't on.
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 6) {
        applymovement(LOCALID_ELEUTHERAI_ALETHEA, Eleutherai_Movement_AletheaLeaveWest)
    } else {
        applymovement(LOCALID_ELEUTHERAI_ALETHEA, Eleutherai_Movement_AletheaLeaveEast)
    }
    waitmovement(0)
    removeobject(LOCALID_ELEUTHERAI_ALETHEA)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_ELEUTHERAI)
    releaseall
}

movement Eleutherai_Movement_Sweep {
    face_left
    delay_16
    face_right
    delay_16
    face_up
}

// from (5,14) round the temple's south step to the road, then north
movement Eleutherai_Movement_AletheaLeaveEast {
    walk_right * 2
    walk_down * 3
    walk_right * 3
    walk_up * 10
}

// the same, when the player stands at (6,14)
movement Eleutherai_Movement_AletheaLeaveWest {
    walk_down * 2
    walk_right * 2
    walk_down
    walk_right * 3
    walk_up * 10
}

script Eleutherai_EventScript_Oinoe {
    lock
    faceplayer
    setspeaker(Eleutherai_Text_SpeakerOinoe)
    msgbox(format("I sweep his step every morning. My mother did. Her mother did.\pA god likes to come home to a clean step."))
    closemessage
    applymovement(LOCALID_ELEUTHERAI_OINOE, Common_Movement_FaceUp)
    waitmovement(0)
    release
}

// --- the town's people -----------------------------------------------------------------
script Eleutherai_EventScript_Sentry {
    lock
    faceplayer
    setspeaker(Eleutherai_Text_SpeakerSentry)
    msgbox(format("Thyrsa's land that way. Astyra's land this way. We're in the middle.\pEleutherai means free. Nobody owns us. We just keep the road.\pThyrsa says we're theirs. Astyra says we're theirs. We say “hm.”"))
    release
}

script Eleutherai_EventScript_ShepherdBoy {
    msgbox(format("Maenads came down off the mountain last night, singing.\pMother made me hide in the pen. With the sheep.\pThe sheep didn't seem worried. I think the sheep knew them."), MSGBOX_NPC)
}

// The old man at the trough: a theoxenia decoy (SYSTEMS.md section 10). He has a
// shadow, and a follower ignores him.
script Eleutherai_EventScript_OldMan {
    lock
    faceplayer
    setspeaker(Eleutherai_Text_SpeakerOldMan)
    if (flag(FLAG_ICHOR_THEOXENIA_START + 0x20)) {
        msgbox(format("Off you go. Mind the maenads. They don't mind you."))
        release
        end
    }
    message(format("Water, child? My cup's too far down the trough. My back won't bend."))
    waitmessage
    dynmultichoice(20, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, Eleutherai_Text_GiveWater, Eleutherai_Text_NotNow)
    if (var(VAR_RESULT) != 0) {
        closemessage
        release
        end
    }
    // With Fresh Water in the bag he takes one; otherwise you fill his cup at the trough.
    checkitem(ITEM_FRESH_WATER)
    if (var(VAR_RESULT) == TRUE) {
        removeitem(ITEM_FRESH_WATER)
    }
    setspeaker(Eleutherai_Text_SpeakerOldMan)
    msgbox(format("Ah. Kind. Here, it's not much. A fig from my sack."))
    giveitem(ITEM_FIGY_BERRY)
    if (var(VAR_RESULT) == FALSE) {
        goto(Common_EventScript_ShowBagIsFull)
    }
    // A theoxenia decoy (FLAG_ICHOR_THEOXENIA_START + 0x20): Zeus Xenios +1 Favor, once.
    setflag(FLAG_ICHOR_THEOXENIA_START + 0x20)
    setvar(VAR_0x8004, ICHOR_GOD_ZEUS)
    setvar(VAR_0x8005, 1)
    special(Ichor_AddFavor)
    setspeaker(Eleutherai_Text_SpeakerOldMan)
    msgbox(format("Off you go. Mind the maenads. They don't mind you."))
    release
}

script Eleutherai_EventScript_Sheep {
    lock
    faceplayer
    playmoncry(SPECIES_WOOLOO, CRY_MODE_NORMAL)
    msgbox(format("Baa."))
    waitmoncry
    release
}

// --- signs ---------------------------------------------------------------------------------
script Eleutherai_EventScript_SignPlinth {
    msgbox(format("DIONYSOS ELEUTHEREUS. HE WHO SETS FREE."), MSGBOX_SIGN)
}

script Eleutherai_EventScript_SignNorth {
    msgbox(format("North: the Kithairon pass. Mind the maenads."), MSGBOX_SIGN)
}

script Eleutherai_EventScript_Trough {
    msgbox(format("Spring water, cold off the mountain, running through a stone trough."), MSGBOX_SIGN)
}
