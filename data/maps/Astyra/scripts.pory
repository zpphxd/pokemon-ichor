mapscripts Astyra_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        special(Ichor_ReleaseTimeOfDay)
        setflag(FLAG_ICHOR_VISITED_ASTYRA)
        // The League, L-1: Kerykos reads the Archon's decree the morning after the Stair.
        if (flag(FLAG_ICHOR_ACT3_COMPLETE) && !flag(FLAG_ICHOR_LEAGUE_DECREE)) {
            clearflag(FLAG_ICHOR_HIDE_DECREE_CROWD)
        } else {
            setflag(FLAG_ICHOR_HIDE_DECREE_CROWD)
        }
    }
}

// ---------------------------------------------------------------------------
// The League (design/LEAGUE.md)
// ---------------------------------------------------------------------------

// The road to Olympus. Placeholder until Route 29, Thermopylai, Route 30 and the
// Vale of Tempe are built: then the Ascent connects to Tempe and this goes.
script Astyra_EventScript_Muleteer {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameMuleteer)
    call(Ichor_League_EventScript_CheckLaurels)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("Olympus? I carry pilgrims to the foot of the Ascent.\pBut the guard turns back anyone without all eight Laurels. Saves us both a trip."))
        release
        end
    }
    msgbox(format("Eight Laurels! You're for the Archon, then.\pThe Tempe road's washed out. I'll take you round by the coast to the foot of the Ascent. Up you get?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("When you're ready. The goat's in no hurry."))
        release
        end
    }
    msgbox(format("Mind the goat."))
    closemessage
    warp(MAP_ASCENT_1F, 42, 27)
    waitstate
    release
}

// L-1: the decree.
script Astyra_EventScript_Kerykos {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameKerykos)
    msgbox(format("Hear the Archon's decree! Hermes remembers everyone who passes, so listen well.\pAt the new moon, the Archon carries Medon's Knot to Delphoi, and fate will be made safe again."))
    setspeaker(Ichor_League_Text_NameKerykos)
    msgbox(format("Until then he sits on Olympus, as the law says, to answer any challenger.\p…That's the decree. Between us? The merchants are hoarding grain and Lakonia's sharpening spears.\pAnd the Pythia's laughing in her temple. I've never heard her laugh."))
    setflag(FLAG_ICHOR_LEAGUE_DECREE)
    release
}
text Astyra_Text_NamePhaedon { "PHAEDON" }
text Astyra_Text_NameElpis { "ELPIS" }
text Astyra_Text_NameDaphne { "DAPHNE" }
text Astyra_Text_NameAlethea { "ALETHEA" }
script Astyra_EventScript_Preacher {
    msgbox(format("Ask any seer. Every thread ends on the same day.\pThey won't tell you why. We will.\pNo more moments. Only the hour."), MSGBOX_NPC)
}
script Astyra_EventScript_Herald {
    msgbox(format("The Archon's proclamation:\pIf it is written, meet it with dignity.\pMy sister asked the Oracle. Same day as mine. Same as everyone."), MSGBOX_NPC)
}
script Astyra_EventScript_Merchant {
    goto(ArkadiaApproach_EventScript_Merchant)
}
script Astyra_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(Astyra_Text_NameAlethea)
    msgbox(format("The Archon has to see the program. The little hook, the forged readings. All of it.\pIf I put it in front of everyone, they can't look away."))
    release
}
script Astyra_EventScript_Clerk {
    lock
    faceplayer
    if (flag(FLAG_ICHOR_ASTYRA_OSTRACISM_DONE)) {
        msgbox(format("The people have voted. The decree stands.\pThe Library will keep the record."))
    } elif (!flag(FLAG_ICHOR_MET_PHAEDON)) {
        msgbox(format("A long journey? Phaedon's Asclepeion is west of here.\pThe Assembly can wait until your Pokémon are well."))
    } elif (!flag(FLAG_ICHOR_MET_ELPIS) || !flag(FLAG_ICHOR_PHAEDON_DAPHNE_VISIT)) {
        msgbox(format("Daphne called at Phaedon's house. His daughter wanted company.\pAcross the square, the little door east of the Asclepeion."))
    } elif (!flag(FLAG_ICHOR_DAPHNE_ASTYRA)) {
        msgbox(format("Daphne left her papers at the Library.\pAsk her about them before the Assembly starts."))
    } else {
        msgbox(format("The Assembly is called. Through the Stoa door beside me.\pBring your evidence."))
    }
    release
}
script Astyra_EventScript_PlaceRoadAlethea {
    if (flag(FLAG_ICHOR_ASTYRA_OSTRACISM_DONE) && !flag(FLAG_ICHOR_ALETHEA_CONFESSED)) {
        clearflag(FLAG_ICHOR_HIDE_ALETHEA_R16)
        addobject(LOCALID_ROUTE16_CAPITAL_PASS_ALETHEA)
        setvar(VAR_0x8004, TIME_NIGHT)
        special(Ichor_HoldTimeOfDay)
    } else {
        setflag(FLAG_ICHOR_HIDE_ALETHEA_R16)
        removeobject(LOCALID_ROUTE16_CAPITAL_PASS_ALETHEA)
    }
    return
}
script Astyra_EventScript_RoadAlethea {
    lock
    faceplayer
    setspeaker(Astyra_Text_NameAlethea)
    msgbox(format("Ten years. That's how long an ostracism lasts.\pI'll be old. Truthfully, very old.\pCan I tell you something? About my Klotheia?"))
    msgbox(format("I said Halia called me exhausting. She did. That wasn't the reading.\pShe said: You'll tell the truth all your life…\pand they'll call you a liar."))
    msgbox(format("So I say truthfully. Every time. In case it helps.\pIt doesn't. But I like to have it on the record."))
    msgbox(format("The Titans are going up the Akropolis tonight. I heard the Keeper's men.\pCome on."))
    setflag(FLAG_ICHOR_ALETHEA_CONFESSED)
    closemessage
    removeobject(LOCALID_ROUTE16_CAPITAL_PASS_ALETHEA)
    release
}
script Astyra_EventScript_Guard {
    if (flag(FLAG_ICHOR_AKROPOLIS_RAID_DONE)) {
        msgbox(format("The stairs are open. Mind the broken stone.\pThe caretaker is still up there."), MSGBOX_NPC)
    } elif (flag(FLAG_ICHOR_ALETHEA_CONFESSED)) {
        msgbox(format("Someone's breaking stone up there.\pThe captain has the sealed order. Straight up the steps."), MSGBOX_NPC)
    } else {
        msgbox(format("The Akropolis is closed by the Archon's order.\pThe inscription? Read it if you like. Just stay below the steps."), MSGBOX_NPC)
    }
}
script Astyra_EventScript_Sign {
    msgbox(format("ASTYRA\pAsclepeion: west. Library: north.\nAgora and Stoa: east."), MSGBOX_SIGN)
    end
}
script Astyra_EventScript_ClinicSign {
    msgbox(format("ASCLEPEION\pPhaedon. Come in, whoever you are."), MSGBOX_SIGN)
    end
}
script Astyra_EventScript_HouseSign {
    msgbox(format("PHAEDON AND ELPIS\pPlease knock softly."), MSGBOX_SIGN)
    end
}
script Astyra_EventScript_LibrarySign {
    msgbox(format("THE LIBRARY OF ASTYRA\pPut it back where you found it."), MSGBOX_SIGN)
    end
}
script Astyra_EventScript_Kodros {
    msgbox(format("KING KODROS\pHe walked into the spears for his city. The Oracle asked it."), MSGBOX_SIGN)
    end
}
script Astyra_EventScript_Kairos {
    msgbox(format("KAIROS\pA runner on a razor. Long hair in front, none behind.\pSeize him as he comes.\pSomeone has scratched a sickle across his face."), MSGBOX_SIGN)
    end
}
script Astyra_EventScript_Perdix {
    msgbox(format("PERDIX\pThe clever boy fell from these walls.\pAthena caught him before the stones could, and made him a partridge."), MSGBOX_SIGN)
    end
}

// ---------------------------------------------------------------------------
// The awe pass: the first sight of the capital, the Pnyx, the fountain house
// ---------------------------------------------------------------------------

// Through the Dipylon for the first time: the camera runs up the Panathenaic
// Way, past the agora, to the rock and Athena's spear over it (AWE_PASS §3).
script Astyra_EventScript_Reveal {
    if (flag(FLAG_ICHOR_ASTYRA_REVEAL)) {
        end
    }
    lockall
    setflag(FLAG_ICHOR_ASTYRA_REVEAL)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Astyra_Movement_CameraUpTheWay)
    waitmovement(0)
    delay(60)
    msgbox(format("Astyra. The rock stands over the city, the Parthenon on top.\pAnd above them all, Athena in bronze, her spear up in the sun.\pSailors say they can see that spear tip from the open sea."))
    closemessage
    delay(20)
    applymovement(OBJ_EVENT_ID_CAMERA, Astyra_Movement_CameraBack)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}
movement Astyra_Movement_CameraUpTheWay {
    walk_slow_right * 2
    walk_right * 12
    walk_up * 6
    walk_fast_up * 17
    walk_slow_up * 7
    step_end
}
movement Astyra_Movement_CameraBack {
    walk_fast_down * 30
    walk_fast_left * 14
    step_end
}

// The Pnyx: the speaker's platform, and the whole rock from it.
script Astyra_EventScript_Bema {
    lockall
    msgbox(format("THE PNYX\pStand here and speak, and the whole city can answer.\pLook up at the rock?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    closemessage
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Astyra_Movement_CameraPnyx)
    waitmovement(0)
    delay(60)
    msgbox(format("The Akropolis, wall to wall. Promachos looks out over the sea road."))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, Astyra_Movement_CameraPnyxBack)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}
movement Astyra_Movement_CameraPnyx {
    walk_up * 6
    walk_left * 12
    walk_slow_up * 10
    step_end
}
movement Astyra_Movement_CameraPnyxBack {
    walk_fast_down * 16
    walk_fast_right * 12
    step_end
}

script Astyra_EventScript_Fountain {
    msgbox(format("THE NINE SPOUTS\pA bronze lion pours the spring's water.\pIt's cold even in summer."), MSGBOX_SIGN)
    end
}
