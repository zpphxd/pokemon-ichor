// Route 7, the Kronia grounds: beat 29 (the feast that never closes) and the
// route's roster. Text from design/phase3/SCRIPT.md: beat 29, Part 2 (Route 7)
// and Part 3 (Route 7 trainers, the Titanborn at the tables). Layout and events
// are generated by tools/ichor/maps/kithairon.py.
//
// The camp must feel good: everyone in it is happy, fed and kind, and nobody
// battles the player unless the player asks. The only cold note is the reader.
//
// Staging: the road comes up out of the pasture onto the camp's south edge at
// (20-21, 16), the greeter's trigger; he stands at (23,15). Kleon sits on the
// bench at (26,13) with Alethea at (28,13); their trigger runs across the road at
// row 12, and the player sits down at (24,13). The reader's table is (29-30, 15),
// the reader beside it at (31,15). The stewards' tent is at (30-33, 6-8).

mapscripts Route7_KroniaGrounds_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_ICHOR_KRONIA_SEEN)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            setvar(VAR_TEMP_1, 0)
        }
        if (flag(FLAG_ICHOR_HIDE_KLEON_KRONIA)) {
            setvar(VAR_TEMP_2, 1)
        } else {
            setvar(VAR_TEMP_2, 0)
        }
        // The first reader sits until he goes for someone who reads better, or
        // the Dionysia is over; then a different reader takes his stool.
        if (flag(FLAG_ICHOR_KRONIA_READER_GONE) || flag(FLAG_ICHOR_DIONYSIA_DONE)) {
            setflag(FLAG_TEMP_4)
        }
        if (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
            setflag(FLAG_TEMP_5)
        }
    }
}

text Route7_KroniaGrounds_Text_SpeakerKronist { "KRONIST" }
text Route7_KroniaGrounds_Text_SpeakerKleon { "KLEON" }
text Route7_KroniaGrounds_Text_SpeakerAlethea { "ALETHEA" }
text Route7_KroniaGrounds_Text_SpeakerReader { "READER" }
text Route7_KroniaGrounds_Text_SpeakerTitanborn { "TITANBORN" }
text Route7_KroniaGrounds_Text_SpeakerMaster { "MASTER" }
text Route7_KroniaGrounds_Text_SpeakerSteward { "STEWARD" }
text Route7_KroniaGrounds_Text_SpeakerBaker { "BAKER" }
text Route7_KroniaGrounds_Text_SpeakerMother { "MOTHER" }
text Route7_KroniaGrounds_Text_SpeakerChild { "CHILD" }
text Route7_KroniaGrounds_Text_SpeakerPilgrim { "PILGRIM" }
text Route7_KroniaGrounds_Text_SpeakerCrowd { "CROWD" }
text Route7_KroniaGrounds_Text_SpeakerKomos { "KOMOS" }
text Route7_KroniaGrounds_Text_SpeakerHagnon { "HAGNON" }
text Route7_KroniaGrounds_Text_SpeakerArgillos { "ARGILLOS" }
text Route7_KroniaGrounds_Text_SpeakerKeramos { "KERAMOS" }
text Route7_KroniaGrounds_Text_SpeakerPlinthos { "PLINTHOS" }
text Route7_KroniaGrounds_Text_SpeakerGypsos { "GYPSOS" }
text Route7_KroniaGrounds_Text_NorYours { "NOR YOURS" }
text Route7_KroniaGrounds_Text_Silence { "…" }
text Route7_KroniaGrounds_Text_Kalliste { "KALLISTE" }
text Route7_KroniaGrounds_Text_Nowhere { "NOWHERE" }

// --- beat 29: the greeting ---------------------------------------------------------------
script Route7_KroniaGrounds_EventScript_GreeterScene {
    lockall
    hidefollower
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 20) {
        applymovement(OBJ_EVENT_ID_PLAYER, Route7_KroniaGrounds_Movement_StepEast)
        waitmovement(0)
    }
    // A Kronist steps into the road with a basket of bread.
    applymovement(LOCALID_ROUTE7_GREETER, Route7_KroniaGrounds_Movement_GreeterIn)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKronist)
    msgbox(format("Welcome! Welcome to the Kronia! Take bread. It's free. All of it."))
    message(format("May your thread never be cut!"))
    waitmessage
    dynmultichoice(20, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, Route7_KroniaGrounds_Text_NorYours, Route7_KroniaGrounds_Text_Silence)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKronist)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("Ha! You know the words already! Come in, come in."))
    } else {
        msgbox(format("Shy! That's all right. Under Kronos, nobody had to say anything."))
    }
    // He hands over a Barley Cake: today's loaf counts as the daily one.
    if (!flag(FLAG_DAILY_ICHOR_KRONIST_BREAD)) {
        giveitem(ITEM_BARLEY_CAKE)
        setflag(FLAG_DAILY_ICHOR_KRONIST_BREAD)
    }
    setflag(FLAG_ICHOR_KRONIA_SEEN)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKronist)
    msgbox(format("The masters pour the wine today. The servants put their feet up."))
    msgbox(format("That's how it was, under Kronos. Every day. Not just one."))
    msgbox(format("It'll be that way again. Soon. Sit anywhere."))
    closemessage
    applymovement(LOCALID_ROUTE7_GREETER, Route7_KroniaGrounds_Movement_GreeterBack)
    waitmovement(0)
    setvar(VAR_TEMP_1, 1)
    releaseall
}

movement Route7_KroniaGrounds_Movement_StepEast {
    walk_right
}

// from (23,15): down into the road beside the player at (21,16)
movement Route7_KroniaGrounds_Movement_GreeterIn {
    walk_down
    walk_left
    face_left
}

movement Route7_KroniaGrounds_Movement_GreeterBack {
    walk_right
    walk_up
    face_down
}

// One loaf a day, from any Kronist in Aethos (FLAG_DAILY_ICHOR_KRONIST_BREAD).
script Route7_KroniaGrounds_EventScript_Greeter {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKronist)
    if (!flag(FLAG_DAILY_ICHOR_KRONIST_BREAD)) {
        msgbox(format("Bread! Take it. The golden age pays."))
        giveitem(ITEM_BARLEY_CAKE)
        setflag(FLAG_DAILY_ICHOR_KRONIST_BREAD)
    } else {
        msgbox(format("May your thread never be cut!"))
    }
    release
}

// --- beat 29: Kleon at the tables ----------------------------------------------------------
script Route7_KroniaGrounds_EventScript_KleonScene {
    lockall
    hidefollower
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKleon)
    msgbox(format("{PLAYER}! Over here! Sit! It's free! All of it!"))
    closemessage
    // Over to the bench's free end, beside Kleon.
    getplayerxy(VAR_0x8004, VAR_0x8005)
    switch (var(VAR_0x8004)) {
        case 20:
            applymovement(OBJ_EVENT_ID_PLAYER, Route7_KroniaGrounds_Movement_SitFrom20)
        case 21:
            applymovement(OBJ_EVENT_ID_PLAYER, Route7_KroniaGrounds_Movement_SitFrom21)
        case 22:
            applymovement(OBJ_EVENT_ID_PLAYER, Route7_KroniaGrounds_Movement_SitFrom22)
        default:
            applymovement(OBJ_EVENT_ID_PLAYER, Route7_KroniaGrounds_Movement_SitFrom23)
    }
    waitmovement(0)
    applymovement(LOCALID_ROUTE7_KLEON, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKleon)
    msgbox(format("Bread, cheese, figs, olives. That man poured my wine. He owns the vineyard."))
    setspeaker(Route7_KroniaGrounds_Text_SpeakerAlethea)
    msgbox(format("Kleon. These are the Titans."))
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKleon)
    msgbox(format("I know! Very generous, for villains. Have a fig."))
    closemessage
    // He pulls the leaves from his belt and holds them up.
    applymovement(LOCALID_ROUTE7_KLEON, Common_Movement_FaceUp)
    waitmovement(0)
    playse(SE_SELECT)
    applymovement(LOCALID_ROUTE7_KLEON, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKleon)
    msgbox(format("Look. The Mask Laurel. Yesterday."))
    msgbox(format("Thespis had a mask for everything. I just went through all of them."))
    msgbox(format("That's three each. Mine's got ivy on it. Yours has wheat on it."))
    msgbox(format("Ivy's better. Everyone knows that."))
    msgbox(format("One of them offered to read my thread. Free. A true one, he said."))
    msgbox(format("I said no."))
    msgbox(format("I've got one already. From Delphoi. “Young and glorious.”"))
    msgbox(format("I don't need two."))
    setspeaker(Route7_KroniaGrounds_Text_SpeakerAlethea)
    msgbox(format("Truthfully, that's the most sensible thing you've ever said."))
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKleon)
    msgbox(format("I know. It frightened me too."))
    msgbox(format("The play's tomorrow night. All of Aethos is going. A new one, by nobody."))
    msgbox(format("Front row for me. If anyone famous is in it, I'll see them first."))
    closemessage
    // He stands, stuffs a loaf in his cloak and jogs north to the gate.
    applymovement(LOCALID_ROUTE7_KLEON, Route7_KroniaGrounds_Movement_KleonLeave)
    waitmovement(0)
    removeobject(LOCALID_ROUTE7_KLEON)
    setflag(FLAG_ICHOR_HIDE_KLEON_KRONIA)
    applymovement(LOCALID_ROUTE7_ALETHEA, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerAlethea)
    msgbox(format("Free bread, free wine, free fates."))
    msgbox(format("Truthfully, nothing is free. Somebody's paying for this."))
    msgbox(format("I'm going up into the city. I'll find you there."))
    closemessage
    applymovement(LOCALID_ROUTE7_ALETHEA, Route7_KroniaGrounds_Movement_AletheaLeave)
    waitmovement(0)
    removeobject(LOCALID_ROUTE7_ALETHEA)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_KRONIA)
    setvar(VAR_TEMP_2, 1)
    releaseall
}

movement Route7_KroniaGrounds_Movement_SitFrom20 {
    walk_right * 4
    walk_down
    face_right
}

movement Route7_KroniaGrounds_Movement_SitFrom21 {
    walk_right * 3
    walk_down
    face_right
}

movement Route7_KroniaGrounds_Movement_SitFrom22 {
    walk_right * 2
    walk_down
    face_right
}

movement Route7_KroniaGrounds_Movement_SitFrom23 {
    walk_right
    walk_down
    face_right
}

// from the bench at (26,13): round behind the player, onto the road, north
movement Route7_KroniaGrounds_Movement_KleonLeave {
    walk_fast_down
    walk_fast_left * 4
    walk_fast_up * 14
}

movement Route7_KroniaGrounds_Movement_AletheaLeave {
    walk_down
    walk_left * 6
    walk_up * 14
}

script Route7_KroniaGrounds_EventScript_Kleon {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKleon)
    msgbox(format("{PLAYER}! Over here! Sit! It's free! All of it!"))
    release
}

script Route7_KroniaGrounds_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerAlethea)
    msgbox(format("Truthfully, nothing is free. Somebody's paying for this."))
    release
}

// --- beat 29: the reader who can't read you -------------------------------------------------
script Route7_KroniaGrounds_EventScript_Reader {
    lockall
    applymovement(LOCALID_ROUTE7_READER, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerReader)
    msgbox(format("Sit, friend. Give me your hand. Your true thread, read for nothing."))
    msgbox(format("The Archon's seers tell you what you are. We tell you what you could be."))
    message(format("Your name first. …{PLAYER}. Good. And where are you from?"))
    waitmessage
    dynmultichoice(20, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, Route7_KroniaGrounds_Text_Kalliste, Route7_KroniaGrounds_Text_Nowhere)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerReader)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("Kalliste."))
    } else {
        msgbox(format("Everyone's from somewhere."))
        closemessage
        // He looks down at your sandals.
        applymovement(LOCALID_ROUTE7_READER, Route7_KroniaGrounds_Movement_LookDown)
        waitmovement(0)
        setspeaker(Route7_KroniaGrounds_Text_SpeakerReader)
        msgbox(format("Island sand. Kalliste?"))
    }
    closemessage
    // He doesn't take the player's hand.
    delay(30)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerReader)
    msgbox(format("…Elaia's island. The one with the old olive."))
    msgbox(format("Wait here. Don't go anywhere."))
    msgbox(format("I'll fetch someone who reads… better."))
    closemessage
    // He stands quickly and walks north to the big tent behind the stage.
    applymovement(LOCALID_ROUTE7_READER, Route7_KroniaGrounds_Movement_ReaderLeave)
    waitmovement(0)
    removeobject(LOCALID_ROUTE7_READER)
    setflag(FLAG_ICHOR_KRONIA_READER_GONE)
    releaseall
}

movement Route7_KroniaGrounds_Movement_LookDown {
    face_down
    delay_16
    delay_16
    face_left
}

movement Route7_KroniaGrounds_Movement_ReaderLeave {
    walk_fast_up * 5
    walk_fast_left
    walk_up
}

script Route7_KroniaGrounds_EventScript_ReaderAfter {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerReader)
    msgbox(format("Readings are closed for you, friend. Orders."))
    msgbox(format("Nothing personal. Have some bread."))
    release
}

script Route7_KroniaGrounds_EventScript_ReaderTable {
    if (flag(FLAG_ICHOR_KRONIA_READER_GONE) && !flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("The reader's stool is empty. His bread has gone cold."), MSGBOX_SIGN)
    } else {
        msgbox(format("A painted sign: TRUE READINGS. FREE. YOUR THREAD, AS IT SHOULD BE."), MSGBOX_SIGN)
    }
}

script Route7_KroniaGrounds_EventScript_TentGuard {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerTitanborn)
    msgbox(format("Stewards' tent. Nobody goes in. Not even me, and I'm very important."))
    release
}

script Route7_KroniaGrounds_EventScript_StewardsTent {
    msgbox(format("The stewards' tent. Its flap is laced shut from inside."), MSGBOX_SIGN)
}

// --- the camp's people ---------------------------------------------------------------------
// The Kronist on the stage: his sermon, a few lines at a time.
script Route7_KroniaGrounds_EventScript_StageKronist {
    lock
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKronist)
    random(3)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("Under Kronos, friends, nobody grew old. The bread never ran out."))
            msgbox(format("The masters poured the wine. Every day was today. Nobody was buried."))
        case 1:
            msgbox(format("Then the cutting started. The Archons' priests read your thread."))
            msgbox(format("They tell you how it ends. They call that peace. It's a cage!"))
        default:
            msgbox(format("Kronos will come back. The cutting will stop. The feast won't end."))
            msgbox(format("May your threads never be cut, friends! All of you!"))
            setspeaker(Route7_KroniaGrounds_Text_SpeakerCrowd)
            msgbox(format("Nor yours!"))
    }
    release
}

script Route7_KroniaGrounds_EventScript_Master {
    lock
    setspeaker(Route7_KroniaGrounds_Text_SpeakerMaster)
    msgbox(format("One day a year, I pour for my steward. That's the Kronia."))
    setspeaker(Route7_KroniaGrounds_Text_SpeakerSteward)
    msgbox(format("He spills. Every year. It's my favorite day."))
    msgbox(format("Under Kronos, they say, it was every day. Masters and servants, one table."))
    setspeaker(Route7_KroniaGrounds_Text_SpeakerMaster)
    msgbox(format("Every day? …I'd need a lot more wine."))
    release
}

script Route7_KroniaGrounds_EventScript_Steward {
    goto(Route7_KroniaGrounds_EventScript_Master)
}

script Route7_KroniaGrounds_EventScript_Baker {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerBaker)
    msgbox(format("Free bread! Who pays? The golden age pays!"))
    msgbox(format("…And a big man from Emporion. In silver. But mostly the golden age."))
    release
}

script Route7_KroniaGrounds_EventScript_Mother {
    lock
    setspeaker(Route7_KroniaGrounds_Text_SpeakerMother)
    msgbox(format("The seer at Delphoi said my son's thread is short. A year. Maybe two."))
    msgbox(format("The Titans say no thread will ever be cut again. Not his. Not anyone's."))
    msgbox(format("Which would you believe?"))
    release
}

script Route7_KroniaGrounds_EventScript_Child {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerChild)
    msgbox(format("The nice man says we'll never grow up! Never! Not ever!"))
    release
}

script Route7_KroniaGrounds_EventScript_ChildB {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerChild)
    msgbox(format("I'm going to be seven forever. Seven's the best."))
    release
}

script Route7_KroniaGrounds_EventScript_LostPilgrim {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerPilgrim)
    msgbox(format("I followed the maenads up. I wanted to see the god."))
    msgbox(format("I danced all night. I don't remember where I put my sandals."))
    msgbox(format("I think I saw him. I think he was the one with the sandals."))
    release
}

// --- the Titanborn at the tables: "for fun, it's a feast!" ------------------------------------
script Route7_KroniaGrounds_EventScript_Argillos {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerArgillos)
    if (defeated(TRAINER_ICHOR_GRUNT_ARGILLOS)) {
        msgbox(format("At the Kronia my master pours my wine. One day a year. Kronos says every day."))
        release
        end
    }
    msgbox(format("Battle? For fun! It's a feast! Nobody works today!"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_ARGILLOS, Route7_KroniaGrounds_Text_ArgillosDefeat)
        setspeaker(Route7_KroniaGrounds_Text_SpeakerArgillos)
        msgbox(format("At the Kronia my master pours my wine. One day a year. Kronos says every day."))
    }
    release
}

text Route7_KroniaGrounds_Text_ArgillosDefeat {
    format("Ha! Well fought. Have a fig.")
}

script Route7_KroniaGrounds_EventScript_Keramos {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKeramos)
    if (defeated(TRAINER_ICHOR_GRUNT_KERAMOS)) {
        msgbox(format("The rich get readings at Delphoi and plan round them.\pI got told I'd stay poor. I'd like a turn being surprised."))
        release
        end
    }
    msgbox(format("Fight? Sure. Feast day. Everyone's equal at a feast."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_KERAMOS, Route7_KroniaGrounds_Text_KeramosDefeat)
        setspeaker(Route7_KroniaGrounds_Text_SpeakerKeramos)
        msgbox(format("The rich get readings at Delphoi and plan round them.\pI got told I'd stay poor. I'd like a turn being surprised."))
    }
    release
}

text Route7_KroniaGrounds_Text_KeramosDefeat {
    format("Equal till the fighting starts.")
}

script Route7_KroniaGrounds_EventScript_Plinthos {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerPlinthos)
    if (defeated(TRAINER_ICHOR_GRUNT_PLINTHOS)) {
        msgbox(format("My thread ends on the same day as my baby's.\pEither we all die that day, or nobody ever dies again. I know what I'm betting on."))
        release
        end
    }
    msgbox(format("A battle, at a feast? …All right. It's what you young ones do."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_PLINTHOS, Route7_KroniaGrounds_Text_PlinthosDefeat)
        setspeaker(Route7_KroniaGrounds_Text_SpeakerPlinthos)
        msgbox(format("My thread ends on the same day as my baby's.\pEither we all die that day, or nobody ever dies again. I know what I'm betting on."))
    }
    release
}

text Route7_KroniaGrounds_Text_PlinthosDefeat {
    format("You're good. Fast. My little one's going to be fast.")
}

script Route7_KroniaGrounds_EventScript_Gypsos {
    lock
    faceplayer
    setspeaker(Route7_KroniaGrounds_Text_SpeakerGypsos)
    // Gypsos's homecoming: tablet #3, read by Alethea (Part 2, Route 7).
    if (flag(FLAG_ICHOR_PROPHECY_3_READ)) {
        goto(Route7_KroniaGrounds_EventScript_GypsosHomecoming)
    }
    if (defeated(TRAINER_ICHOR_GRUNT_GYPSOS)) {
        msgbox(format("Seer said I'd die in a war. Titans don't go to wars. Titans stop them."))
        release
        end
    }
    msgbox(format("A fight? I'm off duty. …Go on, then. For fun."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_GYPSOS, Route7_KroniaGrounds_Text_GypsosDefeat)
        setspeaker(Route7_KroniaGrounds_Text_SpeakerGypsos)
        msgbox(format("Seer said I'd die in a war. Titans don't go to wars. Titans stop them."))
    }
    release
}

text Route7_KroniaGrounds_Text_GypsosDefeat {
    format("Good thing this wasn't a real war.")
}

script Route7_KroniaGrounds_EventScript_GypsosHomecoming {
    msgbox(format("What's that? A tablet? …That's mine. That's my question."))
    msgbox(format("I buried that under Mother's fig. How did you-"))
    closemessage
    // He reads it.
    delay(60)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerGypsos)
    msgbox(format("“You'll come home.” It says come home."))
    msgbox(format("The seer read it out to me. “Die in the next war.” Out loud."))
    msgbox(format("…He read it wrong. Or somebody wrote it wrong."))
    closemessage
    // He takes off the bronze helmet and holds it a while.
    applymovement(LOCALID_ROUTE7_GYPSOS, Common_Movement_FaceDown)
    waitmovement(0)
    delay(40)
    applymovement(LOCALID_ROUTE7_GYPSOS, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerGypsos)
    msgbox(format("I joined so I'd never have to go to the war. Titans stop wars, they said."))
    msgbox(format("Turns out I was always coming home. I just had to go and do it."))
    closemessage
    // He hands the tablet back, sets the helmet on the table and walks north.
    applymovement(LOCALID_ROUTE7_GYPSOS, Route7_KroniaGrounds_Movement_GypsosLeave)
    waitmovement(0)
    removeobject(LOCALID_ROUTE7_GYPSOS)
    setflag(FLAG_ICHOR_GYPSOS_WENT_HOME)
    release
}

movement Route7_KroniaGrounds_Movement_GypsosLeave {
    walk_down
    walk_left * 7
    walk_up * 14
}

// --- the north face: trainers ------------------------------------------------------------------
script Route7_KroniaGrounds_EventScript_Komos {
    trainerbattle_single(TRAINER_ICHOR_KOMOS, Route7_KroniaGrounds_Text_KomosIntro, Route7_KroniaGrounds_Text_KomosDefeat)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerKomos)
    msgbox(format("I'm in the Dionysia's satyr play every year.\pI'm the one at the back who falls over."), MSGBOX_AUTOCLOSE)
}

text Route7_KroniaGrounds_Text_KomosIntro {
    format("A satyr! A real one! Goat legs! …They're trousers. Battle anyway!")
}

text Route7_KroniaGrounds_Text_KomosDefeat {
    format("Undone! My trousers too.")
}

script Route7_KroniaGrounds_EventScript_Hagnon {
    trainerbattle_single(TRAINER_ICHOR_HAGNON, Route7_KroniaGrounds_Text_HagnonIntro, Route7_KroniaGrounds_Text_HagnonDefeat)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerHagnon)
    msgbox(format("They say the feast never closes. I've been walking toward it for three days."), MSGBOX_AUTOCLOSE)
}

text Route7_KroniaGrounds_Text_HagnonIntro {
    format("Nearly there! I can smell the bread! One battle, then bread!")
}

text Route7_KroniaGrounds_Text_HagnonDefeat {
    format("Bread first, next time. Then battle.")
}

// --- the banner, the herm, signs ------------------------------------------------------------
script Route7_KroniaGrounds_EventScript_Banner {
    msgbox(format("A painted banner: a golden field, people dancing, no one old.\pIn the corner, a water clock lies smashed, its water running into the grass.\pUnder it, in gold letters: NO MORE HOURS."), MSGBOX_SIGN)
}

// The great herm doubles as the fork's sign; then the engine's anointing
// (ENGINE_API.md section 4: HERM_AETHOS_ROUTE_7, landing at (24,16)).
script Route7_KroniaGrounds_EventScript_GreatHerm {
    lockall
    msgbox(format("A great herm at the mountain's foot, hung with fresh ivy. Someone left it bread.\pNorth: the feast, and Thyrsa. East: the river. South: up Kithairon."))
    call(EventScript_IchorAnointHerm)
    releaseall
}

// ICHOR_STUB_DIG: a daily dig spot by the river (SYSTEMS.md section 5). Its index
// comes from the ichor-engine session; then this becomes:
//   setvar(VAR_0x8004, <spot>)  setvar(VAR_0x8005, ICHOR_DIG_ACT_II)
//   goto(EventScript_IchorDigSpot)
script Route7_KroniaGrounds_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

script Route7_KroniaGrounds_EventScript_SignSouth {
    msgbox(format("ROUTE 7 · THE KRONIA GROUNDS\pSouth: Mt. Kithairon. North: down to the Asopos plain and Thyrsa."), MSGBOX_SIGN)
}

script Route7_KroniaGrounds_EventScript_SignKronia {
    msgbox(format("THE KRONIA. EVERYONE EATS. NO ONE PAYS. NO ONE GROWS OLD."), MSGBOX_SIGN)
}

script Route7_KroniaGrounds_EventScript_SignNorth {
    msgbox(format("THYRSA. THE ELEKTRAN GATE. One of seven."), MSGBOX_SIGN)
}

// --- the route standard's trainers (MAP_DESIGN section 8) ----------------------
text Route7_KroniaGrounds_Text_SpeakerSimos { "SIMOS" }

script Route7_KroniaGrounds_EventScript_Simos {
    trainerbattle_single(TRAINER_ICHOR_SIMOS, Route7_KroniaGrounds_Text_SimosIntro, Route7_KroniaGrounds_Text_SimosDefeat)
    setspeaker(Route7_KroniaGrounds_Text_SpeakerSimos)
    msgbox(format("The Kronists say there were no satyrs in the golden age. Rude."), MSGBOX_AUTOCLOSE)
}

text Route7_KroniaGrounds_Text_SimosIntro {
    format("Free bread! Free wine! Free battles! I made the last one up.")
}

text Route7_KroniaGrounds_Text_SimosDefeat {
    format("I should have stayed at the tables.")
}
