script Route7_KroniaGrounds_EventScript_Stone {
    msgbox(format("An old stele on a grassy mound. A sickle and a swaddled stone are cut into it.\pUnder them: HE SWALLOWED IT, AND WAS FOOLED."), MSGBOX_SIGN)
    end
}

script Route7_KroniaGrounds_EventScript_Handholds {
    msgbox(format("Old handholds climb the scree face here, worn smooth.\pSomeone with the knack could climb up to the ledge."), MSGBOX_SIGN)
    end
}

script Route7_KroniaGrounds_EventScript_Baker {
    lock
    faceplayer
    msgbox(format("Sit. Masters carry the bread today. Hungry people eat it."))
    special(HealPlayerParty)
    if (!flag(FLAG_ICHOR_KRONIA_BREAD)) {
        giveitem(ITEM_BARLEY_CAKE, 2)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_KRONIA_BREAD)
        }
    }
    msgbox(format("No oath. No payment. Take your time."))
    release
}

script Route7_KroniaGrounds_EventScript_Kronist {
    lock
    faceplayer
    msgbox(format("The old readers sell you an ending. We offer a beginning.\p"
                  "May your thread never be cut."))
    release
}

script Route7_KroniaGrounds_EventScript_Feaster {
    lock
    faceplayer
    msgbox(format("At the Kronia the masters wait on the servants. One day a year.\p"
                  "The Titanborn say it could be every day. The bread is good, anyway."))
    release
}
