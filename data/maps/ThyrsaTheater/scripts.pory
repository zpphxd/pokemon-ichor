// Thyrsa's theater: the Dionysia (beat 32), Kleon's third battle (beat 33) and the
// theater's people (Part 2). Text from design/phase3/SCRIPT.md, beats 32-33 and
// Part 2; the staging follows STORY.md §6.3 as SCRIPT.md lays it out. Layout and
// events are generated by tools/ichor/maps/theater.py.
//
// The map, in the GBA's oblique view: the skene at the top with its three doors
// (ivy at x=14, the palace's crown at 19-20, the goat at 25, their lower cells on
// row 5), the stage on rows 6-7, the steps down at (19-20, 8), the orchestra's
// circle round the thymele (19-20, 12-13), and the cavea fanning out below to the
// top gate on row 33. The player's seat is (18,18), Alethea's (17,18), Kleon's
// (16,17), all in the front row. The skene's back door is (30,7), in the east wing.
//
// The play's stage is VAR_ICHOR_DIONYSIA (constants/ichor_act2_scene.h). Every
// entrance warps the player out of the skene's wings onto a stage door's cell;
// this map's ON_FRAME plays it and warps them back. The trance's pulse is C
// (src/ichor_act2_scene.c): ON_RESUME restarts it for the stage the play is at.
//
// Stubs: ICHOR_STUB_MUSIC (the tragedy plays the Titan theme, the held drone the
// Hollow's, the satyr play Elaia's tune, Thyrsa's map music Emporion's).

mapscripts ThyrsaTheater_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(ThyrsaTheater_EventScript_Setup)
    }
    MAP_SCRIPT_ON_LOAD {
        call(ThyrsaTheater_EventScript_DrawStage)
    }
    MAP_SCRIPT_ON_RESUME {
        if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_PLAY && var(VAR_ICHOR_DIONYSIA) <= DIONYSIA_WAKING) {
            special(Ichor_TheaterDusk)
            special(Ichor_TheaterTranceResume)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: ThyrsaTheater_EventScript_OnFrame
    ]
}

text ThyrsaTheater_Name_Worker { "WORKER" }
text ThyrsaTheater_Name_Cleaner { "CLEANER" }
text ThyrsaTheater_Name_Herald { "HERALD" }
text ThyrsaTheater_Name_Alethea { "ALETHEA" }
text ThyrsaTheater_Name_Chorus { "CHORUS LEADER" }
text ThyrsaTheater_Name_Fates { "FATES" }
text ThyrsaTheater_Name_Audience { "AUDIENCE" }
text ThyrsaTheater_Name_Silenos { "SILENOS" }
text ThyrsaTheater_Name_Thespis { "THESPIS" }
text ThyrsaTheater_Name_King { "THE KING" }
text ThyrsaTheater_Name_Grunt { "GRUNT" }
text ThyrsaTheater_Name_Kleon { "KLEON" }

// ---------------------------------------------------------------------------
// Who is here, and how the stage looks, at each stage of the play
// ---------------------------------------------------------------------------

script ThyrsaTheater_EventScript_Setup {
    clearflag(FLAG_DONT_TRANSITION_MUSIC)
    // the looks that change mid-scene (SPRITES.md's swap)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_ALETHEA_SEATED)
    setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ICHOR_GOLD_MASK_KING_KNEEL)
    setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ICHOR_KLEON_SEATED)
    setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ICHOR_KLEON_SEATED)
    // the workers only sweep before the play
    if (var(VAR_ICHOR_DIONYSIA) != DIONYSIA_NONE) {
        setflag(FLAG_TEMP_1B)
    }
    // the masks, Thespis and Silenos only appear mid-scene
    setflag(FLAG_TEMP_11)
    setflag(FLAG_TEMP_12)
    setflag(FLAG_TEMP_13)
    setflag(FLAG_TEMP_14)
    setflag(FLAG_TEMP_15)
    // the herald only opens the play
    if (var(VAR_ICHOR_DIONYSIA) != DIONYSIA_PLAY) {
        setflag(FLAG_TEMP_16)
    }
    if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_PLAY && var(VAR_ICHOR_DIONYSIA) <= DIONYSIA_WAKING) {
        clearflag(FLAG_ICHOR_HIDE_DIONYSIA_CAST)
        special(Ichor_TheaterDusk)
    } else {
        setflag(FLAG_ICHOR_HIDE_DIONYSIA_CAST)
        setflag(FLAG_TEMP_17)
        setflag(FLAG_TEMP_18)
        setflag(FLAG_TEMP_19)
        setflag(FLAG_TEMP_1A)
    }
    switch (var(VAR_ICHOR_DIONYSIA)) {
        case DIONYSIA_PLAY:
            // the play begins: everyone who makes an entrance waits behind a door
            setflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
            setflag(FLAG_TEMP_17)
            setflag(FLAG_TEMP_18)
            setflag(FLAG_TEMP_19)
            setflag(FLAG_TEMP_1A)
            setobjectxyperm(LOCALID_THEATER_CHORUS, THEATER_DOOR_CROWN_X, THEATER_DOOR_Y)
            setobjectxyperm(LOCALID_THEATER_BEE, THEATER_DOOR_IVY_X, THEATER_DOOR_Y)
            setobjectxyperm(LOCALID_THEATER_ACTOR, 20, THEATER_DOOR_Y)
            setobjectxyperm(LOCALID_THEATER_KING, 20, THEATER_DOOR_Y)
            setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ICHOR_GOLD_MASK_KING)
        case DIONYSIA_ENTRANCE_1:
            clearflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
            savebgm(MUS_ICHOR_HOLLOW)   // ICHOR_STUB_MUSIC: the held drone
        case DIONYSIA_ENTRANCE_2:
            clearflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
            setobjectxyperm(LOCALID_THEATER_JAR, 18, 10)
            savebgm(MUS_ICHOR_ELAIA)    // ICHOR_STUB_MUSIC: MUS_ICHOR_SATYR_PLAY
        case DIONYSIA_ENTRANCE_3:
            setflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
            setobjectxyperm(LOCALID_THEATER_JAR, 18, 10)
            savebgm(MUS_ICHOR_ELAIA)    // ICHOR_STUB_MUSIC: MUS_ICHOR_SATYR_PLAY
        case DIONYSIA_WAKING:
            setflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
            setobjectxyperm(LOCALID_THEATER_JAR, 18, 10)
        default:
            setflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
    }
    // beat 33: Kleon waits on the stage's edge; afterwards a cleaner on the tiers
    if (var(VAR_ICHOR_DIONYSIA) == DIONYSIA_OVER) {
        // the next time the player enters: Kleon on the stage's edge, and the
        // stage's steps run his scene
        clearflag(FLAG_ICHOR_HIDE_KLEON_THEATER)
        setvar(VAR_TEMP_2, 1)
    } else {
        setflag(FLAG_ICHOR_HIDE_KLEON_THEATER)
    }
    if (var(VAR_ICHOR_DIONYSIA) == DIONYSIA_EMPTY) {
        clearflag(FLAG_ICHOR_HIDE_THEATER_CLEANER)
    } else {
        setflag(FLAG_ICHOR_HIDE_THEATER_CLEANER)
    }
}

// The audience, the torches, the play's props, the opened door and the handprint.
script ThyrsaTheater_EventScript_DrawStage {
    if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_PLAY && var(VAR_ICHOR_DIONYSIA) <= DIONYSIA_WAKING) {
        special(Ichor_TheaterFillSeats)
        if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_ENTRANCE_2) {
            setmetatile(12, 6, METATILE_Theater_LoomFallen_Top, FALSE)
            setmetatile(12, 7, METATILE_Theater_LoomFallen_Bottom, TRUE)
        } else {
            setmetatile(12, 6, METATILE_Theater_Loom_Top, FALSE)
            setmetatile(12, 7, METATILE_Theater_Loom_Bottom, TRUE)
        }
        setmetatile(27, 6, METATILE_Theater_Vine_Top, FALSE)
        setmetatile(27, 7, METATILE_Theater_Vine_Bottom, TRUE)
        // the door an entrance comes through stands open
        call(ThyrsaTheater_EventScript_OpenArrivalDoor)
    }
    if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_PLAY && var(VAR_ICHOR_DIONYSIA) <= DIONYSIA_OVER) {
        call(ThyrsaTheater_EventScript_LightTorches)
    }
    if (flag(FLAG_ICHOR_SAW_PROGRAM_HOOK)) {
        call(ThyrsaTheater_EventScript_InkyHand)
    }
}

script ThyrsaTheater_EventScript_LightTorches {
    setmetatile(15, 9, METATILE_Theater_TorchLit_Head, FALSE)
    setmetatile(15, 10, METATILE_Theater_TorchLit_Foot, TRUE)
    setmetatile(24, 9, METATILE_Theater_TorchLit_Head, FALSE)
    setmetatile(24, 10, METATILE_Theater_TorchLit_Foot, TRUE)
    setmetatile(15, 15, METATILE_Theater_TorchLit_Head, FALSE)
    setmetatile(15, 16, METATILE_Theater_TorchLit_Foot, TRUE)
    setmetatile(24, 15, METATILE_Theater_TorchLit_Head, FALSE)
    setmetatile(24, 16, METATILE_Theater_TorchLit_Foot, TRUE)
}

script ThyrsaTheater_EventScript_InkyHand {
    setmetatile(19, 12, METATILE_Theater_ThymeleInk_TL, TRUE)
    setmetatile(20, 12, METATILE_Theater_ThymeleInk_TR, TRUE)
    setmetatile(19, 13, METATILE_Theater_ThymeleInk_BL, TRUE)
    setmetatile(20, 13, METATILE_Theater_ThymeleInk_BR, TRUE)
}

script ThyrsaTheater_EventScript_OpenArrivalDoor {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8005) != THEATER_DOOR_Y) {
        return
    }
    switch (var(VAR_0x8004)) {
        case THEATER_DOOR_IVY_X:
            call(ThyrsaTheater_EventScript_OpenIvy)
        case THEATER_DOOR_CROWN_X:
        case 20:
            call(ThyrsaTheater_EventScript_OpenCrown)
        case THEATER_DOOR_GOAT_X:
            call(ThyrsaTheater_EventScript_OpenGoat)
    }
}

script ThyrsaTheater_EventScript_OpenIvy {
    setmetatile(14, 4, METATILE_Theater_DoorIvyOpen_Top, TRUE)
    setmetatile(14, 5, METATILE_Theater_DoorIvyOpen_Bottom, TRUE)
}

script ThyrsaTheater_EventScript_CloseIvy {
    setmetatile(14, 4, METATILE_Theater_DoorIvy_Top, TRUE)
    setmetatile(14, 5, METATILE_Theater_DoorIvy_Bottom, TRUE)
    special(DrawWholeMapView)
}

script ThyrsaTheater_EventScript_OpenCrown {
    setmetatile(19, 4, METATILE_Theater_DoorCrownOpen_TopL, TRUE)
    setmetatile(20, 4, METATILE_Theater_DoorCrownOpen_TopR, TRUE)
    setmetatile(19, 5, METATILE_Theater_DoorCrownOpen_BottomL, TRUE)
    setmetatile(20, 5, METATILE_Theater_DoorCrownOpen_BottomR, TRUE)
}

script ThyrsaTheater_EventScript_CloseCrown {
    setmetatile(19, 4, METATILE_Theater_DoorCrown_TopL, TRUE)
    setmetatile(20, 4, METATILE_Theater_DoorCrown_TopR, TRUE)
    setmetatile(19, 5, METATILE_Theater_DoorCrown_BottomL, TRUE)
    setmetatile(20, 5, METATILE_Theater_DoorCrown_BottomR, TRUE)
    special(DrawWholeMapView)
}

script ThyrsaTheater_EventScript_OpenGoat {
    setmetatile(25, 4, METATILE_Theater_DoorGoatOpen_Top, TRUE)
    setmetatile(25, 5, METATILE_Theater_DoorGoatOpen_Bottom, TRUE)
}

script ThyrsaTheater_EventScript_CloseGoat {
    setmetatile(25, 4, METATILE_Theater_DoorGoat_Top, TRUE)
    setmetatile(25, 5, METATILE_Theater_DoorGoat_Bottom, TRUE)
    special(DrawWholeMapView)
}

// ---------------------------------------------------------------------------
// What runs on arrival
// ---------------------------------------------------------------------------

script ThyrsaTheater_EventScript_OnFrame {
    setvar(VAR_TEMP_0, 1)
    switch (var(VAR_ICHOR_DIONYSIA)) {
        case DIONYSIA_PLAY:
            goto(ThyrsaTheater_EventScript_ThePlay)
        case DIONYSIA_ENTRANCE_1:
        case DIONYSIA_ENTRANCE_2:
        case DIONYSIA_ENTRANCE_3:
            getplayerxy(VAR_0x8004, VAR_0x8005)
            if (var(VAR_0x8005) == THEATER_DOOR_Y) {
                goto(ThyrsaTheater_EventScript_Entrance)
            }
        case DIONYSIA_OVER:
            // beat 33: the torches gutter; no music until the battle
            fadeoutbgm(1)
    }
}

// Beat 32's setup: with the Mask Laurel (the city's keeper lets the player in
// once it's won), the first step down into the cavea begins the play.
script ThyrsaTheater_EventScript_TakeYourSeat {
    if (!flag(FLAG_BADGE04_GET)) {
        end
    }
    lockall
    playse(SE_APPLAUSE)
    setspeaker(SP_NAME_NONE)
    msgbox(format("Dusk. The torches are lit, and the whole city pours in."))
    closemessage
    setflag(FLAG_ICHOR_DIONYSIA_BEGUN)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_PLAY)
    playse(SE_APPLAUSE)
    fadescreen(FADE_TO_BLACK)
    warpsilent(MAP_THYRSA_THEATER, 18, 18)
    waitstate
}

// ---------------------------------------------------------------------------
// Beat 32: The Unwoven
// ---------------------------------------------------------------------------

script ThyrsaTheater_EventScript_ThePlay {
    lockall
    hidefollower
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
    special(SpawnCameraObject)
    playse(SE_APPLAUSE)
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraUp4)
    waitmovement(0)
    delay(30)
    // the herald raps his staff
    applymovement(LOCALID_THEATER_HERALD, Common_Movement_WalkInPlaceFasterDown)
    playse(SE_BANG)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Herald)
    msgbox(format("Thyrsa! Aethos! The god is home!"))
    setspeaker(ThyrsaTheater_Name_Herald)
    msgbox(format("The Dionysia's first play. A tragedy in four scenes."))
    setspeaker(ThyrsaTheater_Name_Herald)
    msgbox(format("Its name is The Unwoven. Its author asks to stay unknown."))
    closemessage
    // murmurs; Alethea opens the program
    playse(SE_M_ENCORE)
    applymovement(LOCALID_THEATER_ALETHEA, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("“The Unwoven.” Huh."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("There's no name where the playwright goes. Just a sort of… squiggle."))
    closemessage
    applymovement(LOCALID_THEATER_ALETHEA, Common_Movement_FaceUp)
    waitmovement(0)
    // the tragedy: the herald withdraws, the chorus leader comes out of the palace door
    playbgm(MUS_ICHOR_TITAN, FALSE)   // ICHOR_STUB_MUSIC: MUS_ICHOR_DIONYSIA_TRAGEDY
    applymovement(LOCALID_THEATER_HERALD, ThyrsaTheater_Movement_HeraldWithdraws)
    waitmovement(0)
    removeobject(LOCALID_THEATER_HERALD)
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraUp5)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_OpenCrown)
    special(DrawWholeMapView)
    playse(SE_DOOR)
    clearflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
    addobject(LOCALID_THEATER_CHORUS)
    applymovement(LOCALID_THEATER_CHORUS, ThyrsaTheater_Movement_ChorusToThymele)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_CloseCrown)

    // Scene one. The blind hour.
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("Hear it, Thyrsa. Hear what the Oracle would never say."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("Thirteen years ago, on a night with no moon in it,"))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("the Pythia of Delphoi opened her mouth to prophesy,"))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("and for one hour she saw nothing. Nothing at all."))
    setspeaker(ThyrsaTheater_Name_Fates)
    msgbox(format("Nothing. Nothing. Nothing."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("The Loom stood still. The spindle would not turn."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("Somewhere in the world, something had been taken."))
    closemessage

    // Scene two. The stolen thread: the bee-woman creeps out of the ivy door
    call(ThyrsaTheater_EventScript_OpenIvy)
    special(DrawWholeMapView)
    playse(SE_DOOR)
    clearflag(FLAG_TEMP_17)
    addobject(LOCALID_THEATER_BEE)
    applymovement(LOCALID_THEATER_BEE, ThyrsaTheater_Movement_BeeCreeps)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_CloseIvy)
    clearflag(FLAG_TEMP_18)
    addobject(LOCALID_THEATER_JAR)
    applymovement(LOCALID_THEATER_FATE_1, ThyrsaTheater_Movement_Spin)
    applymovement(LOCALID_THEATER_FATE_2, ThyrsaTheater_Movement_Spin)
    applymovement(LOCALID_THEATER_FATE_3, ThyrsaTheater_Movement_Spin)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("There was a bee-woman, who crept down where the three old women spin."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("She waited till they slept. She put her hand into the Loom."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("She stole a thread. A little one, not yet woven. Her own child's."))
    setspeaker(ThyrsaTheater_Name_Fates)
    msgbox(format("Thief. Thief. Thief."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("She ran with it to the edge of the sea, and hid it under a tree."))
    closemessage

    // Scene three. The cursed child: the actor in the petasos, alone in the orchestra
    call(ThyrsaTheater_EventScript_OpenCrown)
    special(DrawWholeMapView)
    playse(SE_DOOR)
    clearflag(FLAG_TEMP_1A)
    addobject(LOCALID_THEATER_ACTOR)
    applymovement(LOCALID_THEATER_ACTOR, ThyrsaTheater_Movement_ActorToCenter)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_CloseCrown)
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("The child was born with nothing in its hands."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("No thread to spin. No length to measure. Nothing to cut."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("The gods looked down for it, and could not find it."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("So they cursed it, the way gods curse what they can't see."))
    closemessage
    // in the front row, Kleon turns from the stage to look at the player
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraDown5)
    waitmovement(0)
    applymovement(LOCALID_THEATER_KLEON_SEAT, Common_Movement_FaceRight)
    waitmovement(0)
    delay(60)
    applymovement(LOCALID_THEATER_KLEON_SEAT, Common_Movement_FaceUp)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Fates)
    msgbox(format("Unwoven. Unwoven. Unwoven."))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraUp5)
    waitmovement(0)

    // Scene four. The sickle and the Loom: the gold-masked king kneels behind the actor
    applymovement(LOCALID_THEATER_ACTOR, ThyrsaTheater_Movement_RaiseSickle)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_OpenCrown)
    special(DrawWholeMapView)
    playse(SE_DOOR)
    clearflag(FLAG_TEMP_19)
    addobject(LOCALID_THEATER_KING)
    applymovement(LOCALID_THEATER_KING, ThyrsaTheater_Movement_KingComesOut)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_CloseCrown)
    // he kneels and covers his face
    copyobjectxytoperm(LOCALID_THEATER_KING)
    setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ICHOR_GOLD_MASK_KING_KNEEL)
    removeobject(LOCALID_THEATER_KING)
    addobject(LOCALID_THEATER_KING)
    applymovement(LOCALID_THEATER_FATE_1, Common_Movement_FaceLeft)
    applymovement(LOCALID_THEATER_FATE_2, Common_Movement_FaceLeft)
    applymovement(LOCALID_THEATER_FATE_3, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("But a curse is a kind of gift, Thyrsa. Listen."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("The cursed child shall carry the old sickle down to the Loom."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("It shall cut the hours loose, and the hours shall stop."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("And the king who weeps shall weep no more."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("No thread cut. No child buried. The feast that never ends."))
    setspeaker(ThyrsaTheater_Name_Chorus)
    msgbox(format("This is the end of the story. There is nothing after it."))
    setspeaker(ThyrsaTheater_Name_Fates)
    msgbox(format("Nothing after. Nothing after."))
    closemessage

    // the purple pulse begins on the audience and grows
    special(Ichor_TheaterTranceStart)
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraDown7)
    waitmovement(0)
    delay(90)
    setspeaker(ThyrsaTheater_Name_Audience)
    msgbox(format("…Nothing after…"))
    closemessage
    fadeoutbgm(2)   // the music falls to a held drone
    playbgm(MUS_ICHOR_HOLLOW, FALSE)   // ICHOR_STUB_MUSIC: the drone
    applymovement(LOCALID_THEATER_ALETHEA, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("{PLAYER}. Look at them."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("They're not blinking. Nobody's blinking."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("Kleon too."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("I was reading the program. Truthfully, I always read the program."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("The masks. Look at the actors' masks. They're looking at the crowd."))
    closemessage

    // the masks' painted eyes turn along the tiers, block by block, and pass over the player
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraUp4)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_MasksLook)
    setspeaker(SP_NAME_NONE)
    msgbox(format("The masks look at everyone in the theater. None of them look at you."))
    closemessage

    // a door bangs: Silenos's head pokes out of the parodos
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraToParodos)
    waitmovement(0)
    playse(SE_BANG)
    clearflag(FLAG_TEMP_15)
    addobject(LOCALID_THEATER_SILENOS)
    applymovement(LOCALID_THEATER_SILENOS, ThyrsaTheater_Movement_Beckon)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Silenos)
    msgbox(format("Psst! You! The awake ones! Backstage. Quick, before the next chorus."))
    closemessage
    removeobject(LOCALID_THEATER_SILENOS)
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraFromParodos)
    waitmovement(0)
    special(RemoveCameraObject)
    // the player and Alethea get up and go down the aisle to the parodos
    copyobjectxytoperm(LOCALID_THEATER_ALETHEA)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_ALETHEA)
    removeobject(LOCALID_THEATER_ALETHEA)
    addobject(LOCALID_THEATER_ALETHEA)
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_PlayerToAisle)
    applymovement(LOCALID_THEATER_ALETHEA, ThyrsaTheater_Movement_AletheaToAisle)
    waitmovement(0)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_BACKSTAGE)
    setflag(FLAG_DONT_TRANSITION_MUSIC)
    fadescreen(FADE_TO_BLACK)
    warpsilent(MAP_THYRSA_THEATER_SKENE, 11, 4)
    waitstate
}

// The cast turn their masks along the tiers, and the gold of their eyes runs over
// each pair of blocks in turn (Ichor_TheaterGaze); then back to the crowd.
script ThyrsaTheater_EventScript_MasksLook {
    applymovement(LOCALID_THEATER_BEE, Common_Movement_FaceLeft)
    applymovement(LOCALID_THEATER_ACTOR, Common_Movement_FaceLeft)
    applymovement(LOCALID_THEATER_FATE_3, Common_Movement_FaceLeft)
    waitmovement(0)
    special(Ichor_TheaterGaze)
    applymovement(LOCALID_THEATER_BEE, Common_Movement_FaceRight)
    applymovement(LOCALID_THEATER_ACTOR, Common_Movement_FaceRight)
    applymovement(LOCALID_THEATER_FATE_3, Common_Movement_FaceRight)
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_THEATER_BEE, Common_Movement_FaceDown)
    applymovement(LOCALID_THEATER_ACTOR, Common_Movement_FaceDown)
    applymovement(LOCALID_THEATER_FATE_3, Common_Movement_FaceDown)
    waitmovement(0)
}

// ---------------------------------------------------------------------------
// The three entrances (beat 32; Part 5's verb on the great stage)
// ---------------------------------------------------------------------------

// The player came out of a stage door wearing VAR_ICHOR_DIONYSIA_MASK. The play
// wants the comic mask by the ivy door, then the tragic by the crown, then the
// satyr by the goat; anything else is a wrong entrance.
script ThyrsaTheater_EventScript_Entrance {
    lockall
    hidefollower
    getplayerxy(VAR_0x8004, VAR_0x8005)
    delay(20)
    switch (var(VAR_ICHOR_DIONYSIA)) {
        case DIONYSIA_ENTRANCE_1:
            if (var(VAR_0x8004) == THEATER_DOOR_IVY_X && var(VAR_ICHOR_DIONYSIA_MASK) == DIONYSIA_MASK_COMIC) {
                goto(ThyrsaTheater_EventScript_ComicEntrance)
            }
        case DIONYSIA_ENTRANCE_2:
            if ((var(VAR_0x8004) == THEATER_DOOR_CROWN_X || var(VAR_0x8004) == 20)
             && var(VAR_ICHOR_DIONYSIA_MASK) == DIONYSIA_MASK_TRAGIC) {
                goto(ThyrsaTheater_EventScript_TragicEntrance)
            }
        case DIONYSIA_ENTRANCE_3:
            if (var(VAR_0x8004) == THEATER_DOOR_GOAT_X && var(VAR_ICHOR_DIONYSIA_MASK) == DIONYSIA_MASK_SATYR) {
                goto(ThyrsaTheater_EventScript_SatyrEntrance)
            }
    }
    goto(ThyrsaTheater_EventScript_WrongEntrance)
}

// Nobody laughs. The masks' eyes slide over the player and back to the crowd.
script ThyrsaTheater_EventScript_WrongEntrance {
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
    waitmovement(0)
    setspeaker(SP_NAME_NONE)
    if (flag(FLAG_ICHOR_HIDE_CHORUS_LEADER)) {
        msgbox(format("Nobody laughs. The tiers murmur: “Nothing after…”"))
    } else {
        msgbox(format("Nobody laughs."))
        msgbox(format("The chorus leader's voice carries over you: “There is nothing after it.”"))
    }
    closemessage
    applymovement(LOCALID_THEATER_BEE, Common_Movement_FaceUp)
    applymovement(LOCALID_THEATER_ACTOR, Common_Movement_FaceUp)
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_THEATER_BEE, Common_Movement_FaceDown)
    applymovement(LOCALID_THEATER_ACTOR, Common_Movement_FaceDown)
    waitmovement(0)
    goto(ThyrsaTheater_EventScript_BackToTheWings)
}

// Fade, and the player is back in the wings, in front of the door they used,
// still wearing the mask.
script ThyrsaTheater_EventScript_BackToTheWings {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    setflag(FLAG_DONT_TRANSITION_MUSIC)
    fadescreen(FADE_TO_BLACK)
    if (var(VAR_0x8004) <= 16) {
        warpsilent(MAP_THYRSA_THEATER_SKENE, SKENE_DOOR_IVY_X, 3)
    } elif (var(VAR_0x8004) <= 22) {
        warpsilent(MAP_THYRSA_THEATER_SKENE, SKENE_DOOR_CROWN_X, 3)
    } else {
        warpsilent(MAP_THYRSA_THEATER_SKENE, SKENE_DOOR_GOAT_X, 3)
    }
    waitstate
}

// 1. The comic mask by the ivy door: a stumble, the Fates' loom falls flat, and the
// bee-woman's jar rolls into the orchestra.
script ThyrsaTheater_EventScript_ComicEntrance {
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_Stumble)
    waitmovement(0)
    playse(SE_BANG)
    setmetatile(12, 6, METATILE_Theater_LoomFallen_Top, FALSE)
    setmetatile(12, 7, METATILE_Theater_LoomFallen_Bottom, TRUE)
    special(DrawWholeMapView)
    applymovement(LOCALID_THEATER_JAR, ThyrsaTheater_Movement_JarRolls)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_CloseIvy)
    setspeaker(SP_NAME_NONE)
    msgbox(format("Somewhere in the lowest tiers, somebody snorts."))
    closemessage
    // the first laugh: the low pair's pulse stops, and the satyr play's music cuts in
    playse(SE_APPLAUSE)
    playbgm(MUS_ICHOR_ELAIA, FALSE)   // ICHOR_STUB_MUSIC: MUS_ICHOR_SATYR_PLAY
    setvar(VAR_0x8004, THEATER_PAIR_LOW)
    special(Ichor_TheaterTranceRelease)
    delay(90)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_ENTRANCE_2)
    goto(ThyrsaTheater_EventScript_BackToTheWings)
}

// 2. The tragic mask by the palace door: on their knees beside the king, wailing,
// much more loudly than the king. The chorus leader looks, then backs into the
// palace door and is gone.
script ThyrsaTheater_EventScript_TragicEntrance {
    if (var(VAR_0x8004) == THEATER_DOOR_CROWN_X) {
        applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_ToKingFromLeft)
    } else {
        applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_ToKingFromRight)
    }
    waitmovement(0)
    call(ThyrsaTheater_EventScript_CloseCrown)
    playse(SE_M_SCREECH)
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_Wail)
    waitmovement(0)
    applymovement(LOCALID_THEATER_KING, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_King)
    msgbox(format("…That's my part."))
    closemessage
    playse(SE_APPLAUSE)
    setvar(VAR_0x8004, THEATER_PAIR_MID)
    special(Ichor_TheaterTranceRelease)
    applymovement(LOCALID_THEATER_KING, Common_Movement_FaceDown)
    // the chorus leader turns his white face to the player, and holds it there
    applymovement(LOCALID_THEATER_CHORUS, Common_Movement_FaceUp)
    waitmovement(0)
    delay(90)
    call(ThyrsaTheater_EventScript_OpenCrown)
    special(DrawWholeMapView)
    applymovement(LOCALID_THEATER_CHORUS, ThyrsaTheater_Movement_ChorusBacksAway)
    waitmovement(0)
    removeobject(LOCALID_THEATER_CHORUS)
    setflag(FLAG_ICHOR_HIDE_CHORUS_LEADER)
    call(ThyrsaTheater_EventScript_CloseCrown)
    delay(30)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_ENTRANCE_3)
    goto(ThyrsaTheater_EventScript_BackToTheWings)
}

// 3. The satyr mask by the goat door: Silenos staggers on behind with a wineskin.
// Then the laugh runs round the whole cavea and the trance breaks.
script ThyrsaTheater_EventScript_SatyrEntrance {
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_Bound)
    waitmovement(0)
    setobjectxyperm(LOCALID_THEATER_SILENOS, THEATER_DOOR_GOAT_X, THEATER_DOOR_Y)
    clearflag(FLAG_TEMP_15)
    addobject(LOCALID_THEATER_SILENOS)
    applymovement(LOCALID_THEATER_SILENOS, ThyrsaTheater_Movement_SilenosStaggers)
    waitmovement(0)
    call(ThyrsaTheater_EventScript_CloseGoat)
    setspeaker(ThyrsaTheater_Name_Silenos)
    msgbox(format("Satyrs! Satyrs, everyone! The play's not over! It's never over!"))
    closemessage
    // he takes the sickle out of the petasos actor's hands...
    applymovement(LOCALID_THEATER_SILENOS, ThyrsaTheater_Movement_SilenosToActor)
    waitmovement(0)
    applymovement(LOCALID_THEATER_ACTOR, Common_Movement_FaceUp)
    waitmovement(0)
    playse(SE_M_CUT)
    delay(20)
    // ...squints at it, and cuts grapes off the prop vine
    applymovement(LOCALID_THEATER_SILENOS, ThyrsaTheater_Movement_SilenosToVine)
    waitmovement(0)
    playse(SE_M_CUT)
    setmetatile(27, 6, METATILE_Theater_VineCut_Top, FALSE)
    setmetatile(27, 7, METATILE_Theater_VineCut_Bottom, TRUE)
    special(DrawWholeMapView)
    setspeaker(ThyrsaTheater_Name_Silenos)
    msgbox(format("Lovely blade, this. Bit blunt for a Loom. Grand for a vineyard."))
    closemessage
    // he picks up the bee-woman's jar and drinks from it
    applymovement(LOCALID_THEATER_SILENOS, ThyrsaTheater_Movement_SilenosToJar)
    waitmovement(0)
    removeobject(LOCALID_THEATER_JAR)
    playse(SE_M_SWAGGER)
    applymovement(LOCALID_THEATER_SILENOS, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Silenos)
    msgbox(format("Ugh! It's honey! Who brings honey to a Dionysia?"))
    closemessage
    // the laugh starts in the top blocks and runs down and round the whole cavea
    playse(SE_APPLAUSE)
    special(Ichor_TheaterTranceWake)
    playse(SE_APPLAUSE)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_WAKING)
    goto(ThyrsaTheater_EventScript_TranceBreaks)
}

// ---------------------------------------------------------------------------
// The trance breaks: the masks let go, the actor fights, the program's hook
// ---------------------------------------------------------------------------

script ThyrsaTheater_EventScript_TranceBreaks {
    delay(30)
    playse(SE_M_ENCORE)
    // the masks lift off the actors' faces and drift over the orchestra into the skene
    setobjectxyperm(LOCALID_THEATER_MASK_1, 14, 7)
    setobjectxyperm(LOCALID_THEATER_MASK_2, 21, 7)
    setobjectxyperm(LOCALID_THEATER_MASK_3, 20, 10)
    clearflag(FLAG_TEMP_11)
    clearflag(FLAG_TEMP_12)
    clearflag(FLAG_TEMP_13)
    addobject(LOCALID_THEATER_MASK_1)
    addobject(LOCALID_THEATER_MASK_2)
    addobject(LOCALID_THEATER_MASK_3)
    applymovement(LOCALID_THEATER_MASK_1, ThyrsaTheater_Movement_MaskRises)
    applymovement(LOCALID_THEATER_MASK_2, ThyrsaTheater_Movement_MaskRises)
    applymovement(LOCALID_THEATER_MASK_3, ThyrsaTheater_Movement_MaskRises)
    waitmovement(0)
    setspeaker(SP_NAME_NONE)
    msgbox(format("The masks float off the actors' faces. They were never masks. They're Prosomime."))
    closemessage
    call(ThyrsaTheater_EventScript_OpenCrown)
    call(ThyrsaTheater_EventScript_OpenIvy)
    special(DrawWholeMapView)
    applymovement(LOCALID_THEATER_MASK_1, ThyrsaTheater_Movement_Mask1Home)
    applymovement(LOCALID_THEATER_MASK_2, ThyrsaTheater_Movement_Mask2Home)
    applymovement(LOCALID_THEATER_MASK_3, ThyrsaTheater_Movement_Mask3Home)
    waitmovement(0)
    removeobject(LOCALID_THEATER_MASK_1)
    removeobject(LOCALID_THEATER_MASK_2)
    removeobject(LOCALID_THEATER_MASK_3)
    setflag(FLAG_TEMP_11)
    setflag(FLAG_TEMP_12)
    setflag(FLAG_TEMP_13)
    // Thespis, at the skene's door
    clearflag(FLAG_TEMP_14)
    addobject(LOCALID_THEATER_THESPIS)
    setspeaker(ThyrsaTheater_Name_Thespis)
    msgbox(format("My children. You've been in bad company."))
    closemessage
    call(ThyrsaTheater_EventScript_CloseIvy)

    // the actor in the petasos throws down the hat and the cloak: a Titanborn
    applymovement(LOCALID_THEATER_ACTOR, ThyrsaTheater_Movement_ActorFurious)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_PlayerFacesActor)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Grunt)
    msgbox(format("That was my play! I'm the hero! It said so!"))
    setspeaker(ThyrsaTheater_Name_Grunt)
    msgbox(format("They read it to me! Free! A true reading! “You'll be a hero!”"))
    setspeaker(ThyrsaTheater_Name_Grunt)
    msgbox(format("I was being one! In front of everybody! And now look!"))
    closemessage
    trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_BORBOROS, ThyrsaTheater_Text_BorborosDefeat)
    setspeaker(ThyrsaTheater_Name_Grunt)
    msgbox(format("…The man in the white mask said this was the last play anyone would need."))
    closemessage
    // he runs off through the parodos; the rest of the cast have already fled
    applymovement(LOCALID_THEATER_ACTOR, ThyrsaTheater_Movement_ActorFlees)
    waitmovement(0)
    removeobject(LOCALID_THEATER_ACTOR)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_THEATER_BEE)
    removeobject(LOCALID_THEATER_FATE_1)
    removeobject(LOCALID_THEATER_FATE_2)
    removeobject(LOCALID_THEATER_FATE_3)
    removeobject(LOCALID_THEATER_KING)
    removeobject(LOCALID_THEATER_THESPIS)
    setflag(FLAG_TEMP_14)
    // the handprint where the chorus leader stood
    call(ThyrsaTheater_EventScript_InkyHand)
    special(DrawWholeMapView)
    fadescreen(FADE_FROM_BLACK)
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_PlayerToThymele)
    waitmovement(0)
    setspeaker(SP_NAME_NONE)
    msgbox(format("Black ink on the altar's lip, in the shape of a hand. Four fingers and a thumb."))
    msgbox(format("Someone was holding on very hard."))
    closemessage

    // the program: Alethea comes down from the seats
    copyobjectxytoperm(LOCALID_THEATER_ALETHEA)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_ALETHEA)
    removeobject(LOCALID_THEATER_ALETHEA)
    addobject(LOCALID_THEATER_ALETHEA)
    applymovement(LOCALID_THEATER_ALETHEA, ThyrsaTheater_Movement_AletheaToPlayer)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    waitmovement(0)
    special(Ichor_ShowProgram)
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("Look. Where the name should be."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("It's the hook. The same little hook. Under the owl, in Emporion."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("Whoever signed that notice wrote this play. Or wants us to think so."))
    closemessage
    special(Ichor_HideProgram)
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("A play about a child with no thread, who carries a sickle to a Loom."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("{PLAYER}, they know about you. And they put you on a stage."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("The bee-woman was a lie. The curse was a lie. I'd stake my trowels on it."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("Truthfully, I don't know what the truth is. But it wasn't that."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("I'm starting a list."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("One. Emporion, the notice, the hook under the owl."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("Two. Thyrsa, the program, the hook where a name should be."))
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("I hope it stays a short list."))
    closemessage
    setflag(FLAG_ICHOR_SAW_PROGRAM_HOOK)
    setflag(FLAG_ICHOR_DIONYSIA_DONE)

    // in the front row, Kleon stares at the empty stage; he gets up and walks out
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraToKleon)
    waitmovement(0)
    applymovement(LOCALID_THEATER_KLEON_SEAT, Common_Movement_FaceRight)
    waitmovement(0)
    delay(30)
    copyobjectxytoperm(LOCALID_THEATER_KLEON_SEAT)
    setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ICHOR_KLEON)
    removeobject(LOCALID_THEATER_KLEON_SEAT)
    addobject(LOCALID_THEATER_KLEON_SEAT)
    applymovement(LOCALID_THEATER_KLEON_SEAT, ThyrsaTheater_Movement_KleonWalksOut)
    waitmovement(0)
    removeobject(LOCALID_THEATER_KLEON_SEAT)
    setflag(FLAG_ICHOR_HIDE_DIONYSIA_CAST)
    applymovement(OBJ_EVENT_ID_CAMERA, ThyrsaTheater_Movement_CameraFromKleon)
    waitmovement(0)
    special(RemoveCameraObject)

    // Thespis, after: in the skene door, a Prosomime on each arm and one on his head
    setobjectxyperm(LOCALID_THEATER_THESPIS, 20, THEATER_DOOR_Y)
    clearflag(FLAG_TEMP_14)
    call(ThyrsaTheater_EventScript_OpenCrown)
    special(DrawWholeMapView)
    addobject(LOCALID_THEATER_THESPIS)
    applymovement(LOCALID_THEATER_THESPIS, Common_Movement_WalkDown)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_PlayerToThespis)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Thespis)
    msgbox(format("Thyrsa laughed. The god will be pleased. He was always a better comic."))
    setspeaker(ThyrsaTheater_Name_Thespis)
    msgbox(format("They'll talk about that play for a year. Every word of it."))
    setspeaker(ThyrsaTheater_Name_Thespis)
    msgbox(format("I'd rather they talked about the ending. The one you gave them."))
    setspeaker(ThyrsaTheater_Name_Thespis)
    msgbox(format("Go and see Silenos, in the skene. He wants to see you. He always does."))
    closemessage
    applymovement(LOCALID_THEATER_THESPIS, Common_Movement_WalkUp)
    waitmovement(0)
    removeobject(LOCALID_THEATER_THESPIS)
    call(ThyrsaTheater_EventScript_CloseCrown)
    applymovement(LOCALID_THEATER_ALETHEA, ThyrsaTheater_Movement_AletheaLeaves)
    waitmovement(0)
    removeobject(LOCALID_THEATER_ALETHEA)
    setflag(FLAG_ICHOR_HIDE_THESPIS_SKENE)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_OVER)
    fadedefaultbgm
    releaseall
}

text ThyrsaTheater_Text_BorborosDefeat {
    format("Heroes don't lose in the last scene! It's in all the plays!")
}

// ---------------------------------------------------------------------------
// Beat 33: Kleon's third battle, in the empty theater
// ---------------------------------------------------------------------------

script ThyrsaTheater_EventScript_KleonApproach {
    if (flag(FLAG_ICHOR_KLEON_BATTLE_3_DONE)) {
        setvar(VAR_TEMP_2, 0)
        end
    }
    lockall
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 19) {
        applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_UpToKleonLeft)
    } else {
        applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaTheater_Movement_UpToKleonRight)
    }
    waitmovement(0)
    goto(ThyrsaTheater_EventScript_KleonScene)
}

script ThyrsaTheater_EventScript_KleonEmpty {
    if (flag(FLAG_ICHOR_KLEON_BATTLE_3_DONE)) {
        end
    }
    lockall
    goto(ThyrsaTheater_EventScript_KleonScene)
}

script ThyrsaTheater_EventScript_KleonScene {
    hidefollower
    // he turns the hat round and round
    applymovement(LOCALID_THEATER_KLEON, ThyrsaTheater_Movement_TurnTheHat)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("Did you like it? Your play?"))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("Four scenes. A chorus. A gold mask crying over you. Very moving."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("Before the trance, I turned round. Did you see? I turned round."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("I wanted to see if you knew. You didn't. You looked like a goat in a storm."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("The whole of Aethos sat in those seats looking at you."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("Nobody's ever put me on a stage. I've been trying since I was seven."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("I asked Pindaros for an ode. The poet. He writes them for winners."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("He said he doesn't write in advance."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("In advance! I've got a prophecy! It's all in advance!"))
    closemessage
    // he drops the hat and stands
    playse(SE_LEDGE)
    copyobjectxytoperm(LOCALID_THEATER_KLEON)
    setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ICHOR_KLEON)
    removeobject(LOCALID_THEATER_KLEON)
    addobject(LOCALID_THEATER_KLEON)
    applymovement(LOCALID_THEATER_KLEON, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("Battle me. Here. Where the stage was."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("If anyone's left in the seats, they can watch this instead."))
    closemessage
    setflag(FLAG_ICHOR_NO_WHITEOUT)
    switch (var(VAR_STARTER_MON)) {
        case 0:
            trainerbattle_no_intro(TRAINER_ICHOR_KLEON_3_NEBREL, ThyrsaTheater_Text_KleonDefeat)
        case 1:
            trainerbattle_no_intro(TRAINER_ICHOR_KLEON_3_KYNDER, ThyrsaTheater_Text_KleonDefeat)
        default:
            trainerbattle_no_intro(TRAINER_ICHOR_KLEON_3_HIPLING, ThyrsaTheater_Text_KleonDefeat)
    }
    clearflag(FLAG_ICHOR_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    setspeaker(ThyrsaTheater_Name_Kleon)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_ICHOR_WON_KLEON_3)
        msgbox(format("…Fine. You're the hero of the play."))
        setspeaker(ThyrsaTheater_Name_Kleon)
        msgbox(format("I'm the friend. The one who loses in the second act so you look good."))
    } else {
        msgbox(format("Ha! There! Somebody write that down!"))
        setspeaker(ThyrsaTheater_Name_Kleon)
        msgbox(format("See? Nothing in my reading about you. Not a word."))
        setspeaker(ThyrsaTheater_Name_Kleon)
        msgbox(format("…It didn't feel like anything. Winning. Isn't that odd."))
    }
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("There's a Huntress in Arkadia. Kallisto. Nobody's beaten her this month."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("Not one trainer. Not one."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("If I beat her, someone'll write it down. Even Pindaros."))
    setspeaker(ThyrsaTheater_Name_Kleon)
    msgbox(format("Don't follow me. You'll only get a play about that too."))
    closemessage
    // he walks up the cavea's steps and out of the top gate
    applymovement(LOCALID_THEATER_KLEON, ThyrsaTheater_Movement_KleonLeaves)
    waitmovement(0)
    removeobject(LOCALID_THEATER_KLEON)
    setflag(FLAG_ICHOR_HIDE_KLEON_THEATER)
    setflag(FLAG_ICHOR_KLEON_BATTLE_3_DONE)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_EMPTY)
    setvar(VAR_TEMP_2, 0)
    fadedefaultbgm
    releaseall
}

text ThyrsaTheater_Text_KleonDefeat {
    format("No. Not here. Not on a stage.")
}

// ---------------------------------------------------------------------------
// The theater's people and things (Part 2)
// ---------------------------------------------------------------------------

script ThyrsaTheater_EventScript_Worker {
    setspeaker(ThyrsaTheater_Name_Worker)
    msgbox(format("Seventeen thousand seats. I've swept every one. Twice."), MSGBOX_NPC)
    setspeaker(ThyrsaTheater_Name_Worker)
    msgbox(format("You'd think a god's theater would sweep itself. You'd be wrong."))
    setspeaker(ThyrsaTheater_Name_Worker)
    msgbox(format("The masks are gone, and the play's still on. That's Thespis for you."))
}

script ThyrsaTheater_EventScript_WorkerTiers {
    setspeaker(ThyrsaTheater_Name_Worker)
    msgbox(format("The masks are gone, and the play's still on. That's Thespis for you."), MSGBOX_NPC)
}

script ThyrsaTheater_EventScript_Cleaner {
    setspeaker(ThyrsaTheater_Name_Cleaner)
    msgbox(format("Best Dionysia in years. Everyone says so. Nobody can tell me why."), MSGBOX_NPC)
    setspeaker(ThyrsaTheater_Name_Cleaner)
    msgbox(format("Something about the satyrs. And the honey. Who brings honey to a play?"))
}

// The cast, Alethea and Kleon in their seats, the jar: nothing to say mid-play.
script ThyrsaTheater_EventScript_Cast {
    end
}

script ThyrsaTheater_EventScript_Jar {
    end
}

script ThyrsaTheater_EventScript_Thespis {
    end
}

script ThyrsaTheater_EventScript_AletheaSeat {
    setspeaker(ThyrsaTheater_Name_Alethea)
    msgbox(format("Shh. Truthfully, I'm reading the program."), MSGBOX_NPC)
}

script ThyrsaTheater_EventScript_KleonSeat {
    end
}

// The thymele is the god's altar (ENGINE_API §3): its line, then the rite's menu.
script ThyrsaTheater_EventScript_Thymele {
    lockall
    if (flag(FLAG_ICHOR_SAW_PROGRAM_HOOK)) {
        msgbox(format("Black ink on the altar's lip, in the shape of a hand. Four fingers and a thumb.\pSomeone was holding on very hard."))
    } else {
        msgbox(format("The thymele, the god's altar. A little fire burns on it, play or no play."))
    }
    goto(EventScript_IchorAltar_Dionysus)
}

script ThyrsaTheater_EventScript_StageDoor {
    if (flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("The stage. Three doors: ivy, a crown, a goat.\pYou could do it again. You'd need an audience."), MSGBOX_SIGN)
    } else {
        msgbox(format("The stage. Three doors: ivy, a crown, a goat. All shut."), MSGBOX_SIGN)
    }
}

script ThyrsaTheater_EventScript_WingWindow {
    msgbox(format("A painted window: vines, and a little goat peering out of them."), MSGBOX_SIGN)
}

// ---------------------------------------------------------------------------
// Movements. The camera starts on the player in the front row, (18,18).
// ---------------------------------------------------------------------------

movement ThyrsaTheater_Movement_CameraUp4 {
    walk_slow_up * 4
}

movement ThyrsaTheater_Movement_CameraUp5 {
    walk_slow_up * 5
}

movement ThyrsaTheater_Movement_CameraDown5 {
    walk_slow_down * 5
}

movement ThyrsaTheater_Movement_CameraDown7 {
    walk_slow_down * 7
}

// from (18,12) to the east parodos, and back down to the player in the front row
movement ThyrsaTheater_Movement_CameraToParodos {
    walk_right * 7
    walk_up * 3
}

movement ThyrsaTheater_Movement_CameraFromParodos {
    walk_down * 9
    walk_left * 7
}

// the herald walks off east, round the orchestra and out by the parodos
movement ThyrsaTheater_Movement_HeraldWithdraws {
    walk_right * 3
    walk_up * 6
    walk_right * 8
}

// from the palace door (19,5) to the thymele's west side (18,13)
movement ThyrsaTheater_Movement_ChorusToThymele {
    walk_slow_down * 5
    walk_slow_left
    walk_slow_down * 3
    face_down
}

// from the ivy door (14,5) down beside the Fates, (14,7): she kneels
movement ThyrsaTheater_Movement_BeeCreeps {
    walk_slow_down * 2
    face_left
    delay_16
    face_down
}

movement ThyrsaTheater_Movement_Spin {
    walk_in_place_slow_down * 2
}

// from the palace door (20,5) to the orchestra's center, (20,10)
movement ThyrsaTheater_Movement_ActorToCenter {
    walk_down * 5
    face_down
}

movement ThyrsaTheater_Movement_RaiseSickle {
    face_up
    delay_16
    face_down
    jump_in_place_down
}

// from the palace door (20,5) to (21,7), behind the actor
movement ThyrsaTheater_Movement_KingComesOut {
    walk_slow_down
    walk_slow_right
    walk_slow_down
    face_down
}

movement ThyrsaTheater_Movement_Beckon {
    walk_in_place_fast_left * 3
    face_left
}

// the player and Alethea up out of the front row and along the aisle
movement ThyrsaTheater_Movement_PlayerToAisle {
    walk_up
    walk_right * 4
    walk_up * 2
}

movement ThyrsaTheater_Movement_AletheaToAisle {
    delay_16
    walk_up
    walk_right * 4
    walk_up
}

// 1. The comic entrance: out of the ivy door (14,5), a stumble into the loom
movement ThyrsaTheater_Movement_Stumble {
    walk_fast_down
    walk_fast_left
    jump_in_place_left
    face_down
}

movement ThyrsaTheater_Movement_JarRolls {
    walk_fast_right * 4
    walk_fast_down * 3
    walk_fast_left
}

// 2. The tragic entrance: to (20,7), beside the kneeling king at (21,7)
movement ThyrsaTheater_Movement_ToKingFromLeft {
    walk_down
    walk_right
    walk_down
    face_right
}

movement ThyrsaTheater_Movement_ToKingFromRight {
    walk_down * 2
    face_right
}

movement ThyrsaTheater_Movement_Wail {
    jump_in_place_down
    walk_in_place_fast_down * 4
    jump_in_place_down
}

// the chorus leader backs from (18,13) to the palace door, his face to the player
movement ThyrsaTheater_Movement_ChorusBacksAway {
    lock_facing_direction
    walk_slow_up * 3
    walk_slow_right
    walk_slow_up * 5
    unlock_facing_direction
}

// 3. The satyr entrance: out of the goat door (25,5), bounding into the orchestra
movement ThyrsaTheater_Movement_Bound {
    jump_in_place_down
    walk_fast_down * 2
    jump_in_place_down
    walk_fast_down * 2
    face_down
}

// Silenos staggers out of the goat door after the player
movement ThyrsaTheater_Movement_SilenosStaggers {
    walk_slow_down
    walk_slow_right
    walk_slow_down
    face_down
}

// from (26,7) to the actor at (20,10): along the stage, down the steps
movement ThyrsaTheater_Movement_SilenosToActor {
    walk_up
    walk_left * 6
    walk_down * 3
    face_down
}

// back up onto the stage, to the prop vine at (27,6)-(27,7)
movement ThyrsaTheater_Movement_SilenosToVine {
    walk_up * 3
    walk_right * 6
    face_right
}

// down to the jar, rolled into the orchestra at (18,10)
movement ThyrsaTheater_Movement_SilenosToJar {
    walk_left * 6
    walk_down * 3
    walk_left
    walk_down
    face_left
}

movement ThyrsaTheater_Movement_MaskRises {
    walk_in_place_slow_down * 2
}

// the masks drift over the orchestra and in at the palace door (19,5)
movement ThyrsaTheater_Movement_Mask1Home {
    walk_slow_up * 2
}

movement ThyrsaTheater_Movement_Mask2Home {
    walk_slow_up
    walk_slow_left
    walk_slow_up
}

movement ThyrsaTheater_Movement_Mask3Home {
    walk_slow_up * 5
}

movement ThyrsaTheater_Movement_ActorFurious {
    jump_in_place_down
    walk_in_place_fast_down * 2
    face_left
}

movement ThyrsaTheater_Movement_PlayerFacesActor {
    face_left
}

// off through the west parodos
movement ThyrsaTheater_Movement_ActorFlees {
    walk_fast_up
    walk_fast_left * 20
}

// from where the satyr entrance left the player, (24,9), to below the thymele (19,14)
movement ThyrsaTheater_Movement_PlayerToThymele {
    walk_left * 2
    walk_down * 5
    walk_left * 3
    face_up
}

// Alethea from the front row, (18,17), to the player at (19,14)
movement ThyrsaTheater_Movement_AletheaToPlayer {
    walk_up
    walk_right * 3
    walk_up * 2
    face_up
}

movement ThyrsaTheater_Movement_CameraToKleon {
    walk_slow_down * 2
    walk_slow_left * 2
}

movement ThyrsaTheater_Movement_CameraFromKleon {
    walk_slow_right * 2
    walk_slow_up * 2
}

// Kleon from his seat (16,17) along the aisle and up the central stair to the top gate
movement ThyrsaTheater_Movement_KleonWalksOut {
    walk_up
    walk_right * 3
    walk_down * 17
}

// the player from below the thymele (19,14) round to the stage steps, facing Thespis
movement ThyrsaTheater_Movement_PlayerToThespis {
    walk_right
    walk_up * 5
    walk_left
    walk_up * 2
    face_up
}

movement ThyrsaTheater_Movement_AletheaLeaves {
    walk_down * 2
    walk_left
    walk_down * 16
}

// Beat 33: Kleon on the stage's edge, (22,7)
movement ThyrsaTheater_Movement_TurnTheHat {
    walk_in_place_slow_down * 3
}

// down the steps and up the central stair to the top gate
movement ThyrsaTheater_Movement_KleonLeaves {
    walk_up
    walk_left * 2
    walk_down
    walk_down * 26
}

// Beat 33: from the stage's steps up beside Kleon, (21,7), facing him at (22,7)
movement ThyrsaTheater_Movement_UpToKleonLeft {
    walk_up
    walk_right * 2
    face_right
}

movement ThyrsaTheater_Movement_UpToKleonRight {
    walk_up
    walk_right
    face_right
}
