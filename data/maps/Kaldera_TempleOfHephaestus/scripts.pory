script KalderaTemple_EventScript_Reset {
    setobjectxyperm(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_TEACH, 10, 38)
    setobjectmovementtype(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_TEACH, MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_RIGHT_UP_LEFT)
    setobjectxyperm(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_TESTONE, 9, 24)
    setobjectmovementtype(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_TESTONE, MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_RIGHT_UP_LEFT)
    setobjectxyperm(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_TESTTWO, 18, 24)
    setobjectmovementtype(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_TESTTWO, MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_RIGHT_UP_LEFT)
    setobjectxyperm(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_MASTERONE, 8, 10)
    setobjectmovementtype(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_MASTERONE, MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_RIGHT_UP_LEFT)
    setobjectxyperm(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_MASTERTWO, 14, 10)
    setobjectmovementtype(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_MASTERTWO, MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_RIGHT_UP_LEFT)
    setobjectxyperm(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_MASTERTHREE, 20, 10)
    setobjectmovementtype(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_MASTERTHREE, MOVEMENT_TYPE_WALK_SEQUENCE_DOWN_RIGHT_UP_LEFT)
    setobjectxyperm(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_DRUM, 20, 13)
    return
}
// End servant dials.
