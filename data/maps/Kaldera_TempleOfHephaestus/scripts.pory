mapscripts Kaldera_TempleOfHephaestus_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_FORGE_TEACH)) {
            setmetatile(14, 32, 0x201, FALSE)
        }
        if (flag(FLAG_ICHOR_FORGE_TEST)) {
            setmetatile(14, 18, 0x201, FALSE)
        }
        if (flag(FLAG_ICHOR_FORGE_MASTER)) {
            setmetatile(14, 5, 0x201, FALSE)
        }
    }
}
script Kaldera_TempleOfHephaestus_EventScript_Rule {
    lockall
    msgbox(format("Turn a dial when its servant stands on the pale plate.\pThe last loop needs a column drum pushed into its path.\pReset the moving servants and the drum? Solved gates stay open."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        clearflag(FLAG_TEMP_1)
        clearflag(FLAG_TEMP_2)
        clearflag(FLAG_TEMP_3)
        clearflag(FLAG_TEMP_4)
        clearflag(FLAG_TEMP_5)
        clearflag(FLAG_TEMP_6)
        call(KalderaTemple_EventScript_Reset)
        closemessage
        warp(MAP_KALDERA_TEMPLE_OF_HEPHAESTUS, 14, 44)
        waitstate
    }
    releaseall
}
script Kaldera_TempleOfHephaestus_EventScript_Servant {
    msgbox(format("Bronze feet. A warm seam down its back.\pThe dial controls its steps."), MSGBOX_NPC)
}
script KalderaTemple_EventScript_Dial {
    getobjectxy(VAR_0x8004, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8005) != VAR_0x8007 || var(VAR_0x8006) != VAR_0x8008) {
        msgbox(format("The servant is between plates. Watch its feet, then turn the dial."))
        return
    }
    if (var(VAR_0x8009) == 1) {
        getobjectxy(LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_DRUM, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
        if (var(VAR_0x8007) != 20 || var(VAR_0x8008) != 12) {
            msgbox(format("The last gear slips. Its loop needs a column drum just below the plate."))
            return
        }
    }
    setobjectxyperm(VAR_0x8004, VAR_0x8005, VAR_0x8006)
    setobjectmovementtype(VAR_0x8004, MOVEMENT_TYPE_FACE_DOWN)
    removeobject(VAR_0x8004)
    addobject(VAR_0x8004)
    copyvar(VAR_0x8004, VAR_0x800B)
    special(Ichor_SetFlagInVar)
    playse(SE_SWITCH)
    msgbox(format("The servant settles on the plate. A bronze tooth clicks home."))
    return
}
script KalderaTemple_EventScript_Check {
    if (!flag(FLAG_ICHOR_FORGE_TEACH) && flag(FLAG_TEMP_1)) {
        setflag(FLAG_ICHOR_FORGE_TEACH)
        setmetatile(14, 32, 0x201, FALSE)
        special(DrawWholeMapView)
        msgbox(format("The first shutter rises."))
    }
    if (!flag(FLAG_ICHOR_FORGE_TEST) && flag(FLAG_TEMP_2) && flag(FLAG_TEMP_3)) {
        setflag(FLAG_ICHOR_FORGE_TEST)
        setmetatile(14, 18, 0x201, FALSE)
        special(DrawWholeMapView)
        msgbox(format("Two feet of bronze. Two plates. The second shutter rises."))
    }
    if (!flag(FLAG_ICHOR_FORGE_MASTER) && flag(FLAG_TEMP_4) && flag(FLAG_TEMP_5) && flag(FLAG_TEMP_6)) {
        setflag(FLAG_ICHOR_FORGE_MASTER)
        setmetatile(14, 5, 0x201, FALSE)
        special(DrawWholeMapView)
        msgbox(format("Three servants stand together. The great anvil rings above."))
    }
    return
}
script Kaldera_TempleOfHephaestus_EventScript_SmithOne {
    trainerbattle_single(TRAINER_ICHOR_KALDERA_SMITH_ONE,
        format("The first thing a smith learns? When to stop."),
        format("There."))
    msgbox(format("Watch a full loop before you touch the dial."), MSGBOX_AUTOCLOSE)
}
script Kaldera_TempleOfHephaestus_EventScript_SmithTwo {
    trainerbattle_single(TRAINER_ICHOR_KALDERA_SMITH_TWO,
        format("I set the second dial a little slow."),
        format("You found my rhythm."))
    msgbox(format("Park one servant, then catch the other."), MSGBOX_AUTOCLOSE)
}
script Kaldera_TempleOfHephaestus_EventScript_SmithThree {
    trainerbattle_single(TRAINER_ICHOR_KALDERA_SMITH_THREE,
        format("Fire tests the metal. This part tests you."),
        format("No cracks."))
    msgbox(format("Push the drum one step north. Too far? The entrance tablet resets it."), MSGBOX_AUTOCLOSE)
}
script Kaldera_TempleOfHephaestus_EventScript_Talos {
    lock
    faceplayer
    setspeaker(Kaldera_Text_NameTalos)
    if (!flag(FLAG_BADGE06_GET)) {
        msgbox(format("You listened to their feet. Good.\pIron remembers every careless blow. Let's see what you remember."))
        trainerbattle_no_intro(TRAINER_ICHOR_KALDERA_TALOS, KalderaTemple_Text_Defeat)
        setflag(FLAG_BADGE06_GET)
        playfanfare(MUS_OBTAIN_BADGE)
        msgbox(format("{PLAYER} received the Forge Laurel!"))
        waitfanfare
    }
    setspeaker(Kaldera_Text_NameTalos)
    msgbox(format("Come below. There's something the old fire gave back.\pAnd something I should have told your teacher years ago."))
    closemessage
    callnative(StopMapMusic)
    warp(MAP_KALDERA_TELCHINES_FORGE, 20, 9)
    waitstate
    releaseall
}
text KalderaTemple_Text_Defeat { format("Tempered. Not hardened.") }

// Generated servant dials.

script Kaldera_TempleOfHephaestus_EventScript_DialTeach {
    lockall
    if (flag(FLAG_ICHOR_FORGE_TEACH) || flag(FLAG_TEMP_1)) {
        msgbox(format("The bronze feet are settled. The dial rests."))
        releaseall
        end
    }
    setvar(VAR_0x8004, LOCALID_KALDERA_TEMPLE_OF_HEPHAESTUS_TEACH)
    setvar(VAR_0x8005, 10)
    setvar(VAR_0x8006, 39)
    setvar(VAR_0x800B, FLAG_TEMP_1)
    setvar(VAR_0x8009, 0)
    call(KalderaTemple_EventScript_Dial)
    call(KalderaTemple_EventScript_Check)
    releaseall
}

