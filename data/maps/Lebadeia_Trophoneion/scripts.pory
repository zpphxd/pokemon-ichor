script Lebadeia_Trophoneion_EventScript_Mosaic {
    msgbox(format("A floor mosaic: a man going down a dark shaft feet first,\na honey cake in each hand, two snakes waiting below."), MSGBOX_SIGN)
    end
}

script Lebadeia_Trophoneion_EventScript_Statue {
    msgbox(format("TROPHONIOS. He built Apollo's temple at Delphoi with his brother.\pThe god paid them with sleep. The earth opened for him here."), MSGBOX_SIGN)
    end
}

script Lebadeia_Trophoneion_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_LEBADEIA_TROPHONEION_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}

script Lebadeia_Trophoneion_EventScript_Pithos {
    lockall
    setvar(VAR_0x8004, PC_LOCATION_OTHER)
    msgbox(Ichor_Text_PithosLook)
    call(Ichor_EventScript_PithosLiftLid)
    goto(Lebadeia_Trophoneion_EventScript_PithosMenu)
}

script Lebadeia_Trophoneion_EventScript_PithosMenu {
    message(Ichor_Text_PithosReach)
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        Ichor_Text_PithosOptionPokemon, Ichor_Text_PithosOptionThings, Ichor_Text_PithosOptionClose)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("The Pithos of Lebadeia opened."))
            msgbox(Ichor_Text_PithosPokemonRest)
            special(ShowPokemonStorageSystemPC)
            goto(Lebadeia_Trophoneion_EventScript_PithosMenu)
        case 1:
            msgbox(Ichor_Text_PithosThings)
            special(PlayerPC)
            goto(Lebadeia_Trophoneion_EventScript_PithosMenu)
    }
    msgbox(Ichor_Text_PithosClose)
    releaseall
}

