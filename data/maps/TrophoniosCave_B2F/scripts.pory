// Trophonios's cave, B2F: the deep (SCRIPT.md Part 5). Layout and events are
// generated by tools/ichor/maps/trophonios.py: the stair up (3,2), the spring
// (5,2)-(5,3), forks A (7,4), B (17,4) and C (17,11), the web den behind its
// curtain (16,8), the snake's cleft (20,11), the black pool (21-23, 12-14) with
// Melampos, the great boulder (19,14) and the dig behind it (18,14), and the
// oracle's chamber: brazier 2 (10,14), the hole (6-7, 16-17), the TM's ledge.
//
// ICHOR_STUB_MUSIC: MUS_ICHOR_HOLLOW is the cave's cue (Part 9).

const BRAZIER_FLAG = FLAG_ICHOR_BRAZIERS_START + 0x22

mapscripts TrophoniosCave_B2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setvar(VAR_TEMP_6, 0)                      // 1 while the map is fully lit
        getplayerxy(VAR_TEMP_4, VAR_TEMP_5)
        if (flag(BRAZIER_FLAG) && var(VAR_TEMP_4) < 12 && var(VAR_TEMP_5) > 12) {
            setflashlevel(0)                       // loaded inside the lit oracle's chamber
            setvar(VAR_TEMP_6, 1)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(BRAZIER_FLAG)) {
            call(TrophoniosCave_B2F_EventScript_SetBrazierLit)
        }
        if (flag(FLAG_ICHOR_TROPHONIOS_SNAKE_FED)) {
            setmetatile(20, 11, METATILE_Trophonios_Cleft_Empty, FALSE)
        }
    }
}

script TrophoniosCave_B2F_EventScript_SetBrazierLit {
    setmetatile(10, 14, METATILE_Trophonios_Brazier_LitTop, TRUE)
    setmetatile(10, 15, METATILE_Trophonios_Brazier_Lit, TRUE)
}

text TrophoniosCave_B2F_Text_SpeakerMelampos { "MELAMPOS" }

// --- the spring: the midpoint rest ------------------------------------------------------

script TrophoniosCave_B2F_EventScript_Spring {
    lockall
    msgbox(format("Cold water runs out of the rock and down into the dark."))
    msgbox(format("It's the same river as above, coming the other way. You feel rested."))
    closemessage
    playfanfare(MUS_HEAL)
    special(HealPlayerParty)
    waitfanfare
    releaseall
}

// --- the forks' chalk hands --------------------------------------------------------------
// Deviation (TILES_trophonios.md): the chalk shows faintly by torchlight too, because the
// engine's glow copy isn't loaded on douse yet; doused, each sign reads the hand.

script TrophoniosCave_B2F_EventScript_HandprintA {
    if (flag(FLAG_ICHOR_TORCH_DOUSED)) {
        msgbox(format("A chalk hand glows on the rock. Its fingers point east, along the wall."), MSGBOX_SIGN)
    } else {
        msgbox(format("Rough rock. Something pale is smeared on it, too faint to read by torchlight."), MSGBOX_SIGN)
    }
}

script TrophoniosCave_B2F_EventScript_HandprintB {
    if (flag(FLAG_ICHOR_TORCH_DOUSED)) {
        msgbox(format("A chalk hand glows on the rock. Its fingers point down, to the passage south."), MSGBOX_SIGN)
    } else {
        msgbox(format("Rough rock. Something pale is smeared on it, too faint to read by torchlight."), MSGBOX_SIGN)
    }
}

script TrophoniosCave_B2F_EventScript_HandprintC {
    if (flag(FLAG_ICHOR_TORCH_DOUSED)) {
        msgbox(format("A chalk hand glows on the rock, fingers pointing east. Under it, smaller: honey."), MSGBOX_SIGN)
    } else {
        msgbox(format("Rough rock. Something pale is smeared on it, too faint to read by torchlight."), MSGBOX_SIGN)
    }
}

// --- Mnesarete, past fork A ---------------------------------------------------------------
// Added for MAP_DESIGN section 8.4 (three trainers in a dungeon); not in SCRIPT.md. A pilgrim
// who drank from the springs in the wrong order, as Lebadeia's sign warns against.

text TrophoniosCave_B2F_Text_SpeakerMnesarete { "MNESARETE" }

script TrophoniosCave_B2F_EventScript_Mnesarete {
    trainerbattle_single(TRAINER_ICHOR_MNESARETE, TrophoniosCave_B2F_Text_MnesareteIntro, TrophoniosCave_B2F_Text_MnesareteDefeat)
    setspeaker(TrophoniosCave_B2F_Text_SpeakerMnesarete)
    msgbox(format("Mnemosyne first, then Lethe. I read the sign afterwards."))
    msgbox(format("Now I remember everything, except what I came down here for."), MSGBOX_AUTOCLOSE)
}

text TrophoniosCave_B2F_Text_MnesareteIntro {
    format("I drank the wrong spring first. I remember everything. Battle me. Give me something new.")
}

text TrophoniosCave_B2F_Text_MnesareteDefeat {
    format("That one I'll remember too. Thank you. I think.")
}

// --- the snake's cleft ---------------------------------------------------------------------
// The snake is an invisible object over the cleft's coils, hidden by
// FLAG_ICHOR_TROPHONIOS_SNAKE_FED. It is never named or shown.

script TrophoniosCave_B2F_EventScript_Snake {
    lock
    msgbox(format("Something coils in the cleft. It's very large, and very calm.\p"
                  "It's lying across the only way on."))
    checkitem(ITEM_HONEY)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("It isn't going to move for nothing. The pilgrims carried honey cakes."))
        closemessage
        release
        end
    }
    msgbox(format("Leave it some honey?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        closemessage
        release
        end
    }
    removeitem(ITEM_HONEY)
    msgbox(format("You set the honey down in the cleft.\p"
                  "After a while, the coils slide back into the rock. The way is open."))
    closemessage
    setmetatile(20, 11, METATILE_Trophonios_Cleft_Empty, FALSE)
    special(DrawWholeMapView)
    removeobject(LOCALID_TROPHONIOS_SNAKE)     // sets its hide flag
    setflag(FLAG_ICHOR_TROPHONIOS_SNAKE_FED)
    release
}

// --- the black pool, Melampos, the great boulder ------------------------------------------

script TrophoniosCave_B2F_EventScript_BlackPool {
    msgbox(format("The water is black, and perfectly still. It doesn't reflect the torch."), MSGBOX_SIGN)
}

script TrophoniosCave_B2F_EventScript_Melampos {
    trainerbattle_single(TRAINER_ICHOR_MELAMPOS, TrophoniosCave_B2F_Text_MelamposIntro, TrophoniosCave_B2F_Text_MelamposDefeat)
    setspeaker(TrophoniosCave_B2F_Text_SpeakerMelampos)
    msgbox(format("Birds don't fly down here. I've no idea what's going to happen."))
    msgbox(format("Lovely. Awful. Lovely."), MSGBOX_AUTOCLOSE)
}

text TrophoniosCave_B2F_Text_MelamposIntro {
    format("My ancestor rode into the earth. I walked. It seemed more polite.")
}

text TrophoniosCave_B2F_Text_MelamposDefeat {
    format("I didn't see that coming. Which is new.")
}

// ICHOR_STUB_DIG: the fixed find behind the great boulder, FLAG_ICHOR_DIG_FIXED_START + 0x12,
// a Rare Bone (Part 6). When the dig API lands (ENGINE_API section 8), this becomes:
//     setvar(VAR_0x8004, 0x12)
//     setvar(VAR_0x8005, ITEM_RARE_BONE)
//     goto(EventScript_IchorDigFixed)
script TrophoniosCave_B2F_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

// --- the oracle's chamber -----------------------------------------------------------------

// The lit zone (ENGINE_API section 2). VAR_TEMP_6 guards the engine's
// EventScript_IchorEnterLitZone, which never finishes if the light is already full
// (TrophoniosCave_B1F/scripts.pory says why).
script TrophoniosCave_B2F_EventScript_EnterOracle {
    if (flag(BRAZIER_FLAG)) {
        if (var(VAR_TEMP_6) == 0) {
            setvar(VAR_0x8004, BRAZIER_FLAG)
            call(EventScript_IchorEnterLitZone)
            setvar(VAR_TEMP_6, 1)
        }
    } elif (var(VAR_TEMP_6) == 1) {
        call(EventScript_IchorLeaveLitZone)
        setvar(VAR_TEMP_6, 0)
    }
}

script TrophoniosCave_B2F_EventScript_LeaveOracle {
    if (var(VAR_TEMP_6) == 1) {
        call(EventScript_IchorLeaveLitZone)
        setvar(VAR_TEMP_6, 0)
    }
}

script TrophoniosCave_B2F_EventScript_Brazier {
    setvar(VAR_0x8004, BRAZIER_FLAG)
    setvar(VAR_0x8005, TRUE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        setvar(VAR_TEMP_6, 1)
        call(TrophoniosCave_B2F_EventScript_SetBrazierLit)
        special(DrawWholeMapView)
    }
    releaseall
}

script TrophoniosCave_B2F_EventScript_Cakes {
    msgbox(format("Honey cakes by the hole, left by the last pilgrim down. They've gone hard."), MSGBOX_SIGN)
}

script TrophoniosCave_B2F_EventScript_Bread {
    msgbox(format("A basket of loaves. Nobody has eaten them. Nobody was meant to."), MSGBOX_SIGN)
}

// Beat 35C. The first YES: black, 120 frames of nothing, then up onto the throne of
// Mnemosyne on B1F, where its ON_TRANSITION plays the reading. Every later YES is the
// way out: Lebadeia's warp 3, the grille (a door: the player steps out in front of it).
script TrophoniosCave_B2F_EventScript_Hole {
    lockall
    msgbox(format("A hole in the floor, round and black. A cold draft comes up out of it.\p"
                  "The pilgrims go through feet first. Lie down and go?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_ICHOR_TROPHONIOS_READING)) {
        msgbox(format("Feet first. You're getting good at this."))
        closemessage
        warp(MAP_LEBADEIA, 3)
        waitstate
    }
    closemessage
    fadeoutbgm(1)
    fadescreen(FADE_TO_BLACK)
    delay(120)
    setflag(FLAG_ICHOR_TROPHONIOS_READING)
    warpsilent(MAP_TROPHONIOS_CAVE_B1F, 12, 5)
    waitstate
}
