mapscripts Route14_Tretos_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_BRAZIERS_START + 0x2E)) {
            call(Route14_Tretos_EventScript_Lit)
        }
        call(Route14_Tretos_EventScript_DrawWebs)
    }
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_ICHOR_BRAZIERS_START + 0x2E)) {
            setflashlevel(0)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_9, 0: Route14_Tretos_EventScript_RedrawWebs
    ]
}

// Generated by tools/ichor/maps/nemea.py; edit the builder, not this file.

script Route14_Tretos_EventScript_LYSANDRA {
    trainerbattle_single(TRAINER_ICHOR_TRETOS_LYSANDRA, format("Hecate keeps the roads under the hills. I keep her lamps lit."), format("Your light's brighter."))
    msgbox(format("Light the old brazier. The Tretos stays bright for whoever comes after."), MSGBOX_AUTOCLOSE)
    end
}

script Route14_Tretos_EventScript_Stele {
    msgbox(format("Claw marks, each as long as an arm, run along the wall and away north.\pToward Nemea. Toward the den."), MSGBOX_SIGN)
    end
}

script Route14_Tretos_EventScript_Brazier {
    setvar(VAR_0x8004, FLAG_ICHOR_BRAZIERS_START + 0x2E)
    setvar(VAR_0x8005, TRUE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        call(Route14_Tretos_EventScript_Lit)
        special(DrawWholeMapView)
    }
    releaseall
}

script Route14_Tretos_EventScript_Lit {
    setmetatile(17, 4, 0x2FA, TRUE)
    setmetatile(18, 4, 0x2FB, TRUE)
    setmetatile(17, 5, 0x302, TRUE)
    setmetatile(18, 5, 0x303, TRUE)
    return
}

script Route14_Tretos_EventScript_Web {
    setvar(VAR_TEMP_9, 0)
    goto(EventScript_IchorCobweb)
}

script Route14_Tretos_EventScript_Thornweb {
    setvar(VAR_TEMP_9, 0)
    goto(EventScript_IchorThornweb)
}

script Route14_Tretos_EventScript_RedrawWebs {
    setvar(VAR_TEMP_9, 1)
    call(Route14_Tretos_EventScript_DrawWebs)
    special(DrawWholeMapView)
    end
}

script Route14_Tretos_EventScript_DrawWebs {
    if (flag(FLAG_ICHOR_HIDE_TRETOS_WEB)) {
        setmetatile(14, 3, 0x2FF, FALSE)
        setmetatile(14, 4, 0x307, FALSE)
    } else {
        setmetatile(14, 3, 0x2FC, FALSE)
        setmetatile(14, 4, 0x304, FALSE)
    }
    if (flag(FLAG_ICHOR_HIDE_TRETOS_THORNWEB)) {
        setmetatile(22, 15, 0x2FF, FALSE)
        setmetatile(22, 16, 0x307, FALSE)
    } else {
        setmetatile(22, 15, 0x2FC, FALSE)
        setmetatile(22, 16, 0x304, FALSE)
    }
    return
}
