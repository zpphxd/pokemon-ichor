// The Pool of Mnemosyne (design/phase3/SCRIPT.md Part 2): a glade at the west end
// of the Cypress Wood, a round pool of still black water that reflects the stars at
// every hour, white poplars, asphodel, the stone seat where Mnaseas keeps it. A dead
// end that pays. Layout and events are generated by tools/ichor/maps/arkadia.py.
//
// Stubs: ICHOR_STUB_DIG (the Orpheus potsherd's fixed dig, the daily spot).

mapscripts PoolOfMnemosyne_MapScripts {}

text PoolOfMnemosyne_Name_Mnaseas { "MNASEAS" }

script PoolOfMnemosyne_EventScript_Mnaseas {
    lock
    faceplayer
    setspeaker(PoolOfMnemosyne_Name_Mnaseas)
    if (flag(FLAG_ICHOR_MNASEAS_TOLD)) {
        msgbox(format("A king came here once and wept all night. A thousand years ago."))
        setspeaker(PoolOfMnemosyne_Name_Mnaseas)
        msgbox(format("The pool still has it. If you know how to look. I don't."))
        release
        end
    }
    msgbox(format("This is Mnemosyne's pool. Memory's own."))
    setspeaker(PoolOfMnemosyne_Name_Mnaseas)
    msgbox(format("It remembers everything that ever happened in Aethos. Everything."))
    setspeaker(PoolOfMnemosyne_Name_Mnaseas)
    msgbox(format("Drink from it, and you'd remember it all. Every life. Every ending."))
    setspeaker(PoolOfMnemosyne_Name_Mnaseas)
    msgbox(format("Most people come all this way and decide they'd rather not."))
    setspeaker(PoolOfMnemosyne_Name_Mnaseas)
    msgbox(format("Looking's free. Looking's always free."))
    setflag(FLAG_ICHOR_MNASEAS_TOLD)
    release
}

// The pool. At night, the first time only, it shows something else (Open questions 2).
script PoolOfMnemosyne_EventScript_Pool {
    lockall
    gettimeofday
    if (var(VAR_0x8000) == TIME_NIGHT && !flag(FLAG_ICHOR_POOL_VISION)) {
        msgbox(format("Still black water. The stars are in it, and they don't move."))
        delay(30)
        msgbox(format("For a moment it shows a tree in the dark, and a woman under it."))
        delay(30)
        msgbox(format("Then only your own face."))
        setflag(FLAG_ICHOR_POOL_VISION)
        releaseall
        end
    }
    msgbox(format("Still black water. The stars are in it, and they don't move.\p"
                  "Your own face looks back at you."))
    releaseall
}

script PoolOfMnemosyne_EventScript_Sign {
    msgbox(format("THE POOL OF MNEMOSYNE\nRemember to leave as you found it."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: a potsherd of amphora #8 (Orpheus), a fixed dig at the foot of the
// oldest poplar (Part 6). The dig API replaces this with EventScript_IchorDigFixed.
script PoolOfMnemosyne_EventScript_OldPoplar {
    msgbox(format("The oldest poplar. At its foot the earth has been turned.\p"
                  "Something is buried here."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: a daily dig spot inside the ring of poplars (Part 6).
script PoolOfMnemosyne_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}
