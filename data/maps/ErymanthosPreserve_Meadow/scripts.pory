script ErymanthosPreserve_Meadow_EventScript_Sign {
    msgbox(format("THE HIGH MEADOW\nAbove the trees the wind comes off the snow. The cold birds nest here."), MSGBOX_SIGN)
    end
}

script ErymanthosPreserve_Meadow_EventScript_SignTop {
    msgbox(format("KEEP OUT. THE BOAR'S GROUND.\nBy order of the keeper. Nobody has caught it. Nobody should try."), MSGBOX_SIGN)
    end
}

script ErymanthosPreserve_Meadow_EventScript_FallenOaks {
    lockall
    msgbox(format("Young oaks lie across the gap, torn up by the roots. Their bark is scored with tusks "
                  "as long as your arm.\p"
                  "No blade will clear these. Something has to be done about whatever tore them up."))
    releaseall
}

script ErymanthosPreserve_Meadow_EventScript_Herder {
    lock
    faceplayer
    msgbox(format("I graze my goats up here in summer. Not by the gap. Never by the gap.\p"
                  "The boar came down off Erymanthos the year my father was born. Herakles himself "
                  "dragged it off, they say. Then another came. There's always another."))
    release
}
