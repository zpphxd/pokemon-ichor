// Route 6, the Eleutherai Road: beat 26 (the vines and the herald) and the
// road's roster. Text from design/phase3/SCRIPT.md: beat 26, Part 2 (Route 6)
// and Part 3 (Route 6 trainers). Layout and events are generated by
// tools/ichor/maps/kithairon.py.
//
// Staging (map coordinates): the road comes up from Eleusa at x 45-46. At row 21
// an old vine stock, too thick to cut, stands at (45,21), and a thicket of young
// vines fills the gap beside it at (46,21): a thorn-thicket object running
// EventScript_CutTree (Demeter's Sickle), hidden for good by
// FLAG_ICHOR_HIDE_ELEUTHERAI_VINES once cut. Alethea waits at (47,22). The herald
// stands at (45,17) behind his barrier pole across row 18; the trigger is two
// rows south of it, at (45,20) and (46,20).

mapscripts Route6_EleutheraiRoad_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_ICHOR_ACT2_BEGUN)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            setvar(VAR_TEMP_1, 0)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_HIDE_HERALD_BARRIER)) {
            call(Route6_EleutheraiRoad_EventScript_SetRoadOpen)
        }
    }
}

// The barrier's two cells become road again (aethos's limestone road, 0x1D9).
script Route6_EleutheraiRoad_EventScript_SetRoadOpen {
    setmetatile(45, 18, 0x1D9, FALSE)
    setmetatile(46, 18, 0x1D9, FALSE)
}

text Route6_EleutheraiRoad_Text_SpeakerAlethea { "ALETHEA" }
text Route6_EleutheraiRoad_Text_SpeakerHerald { "HERALD" }
text Route6_EleutheraiRoad_Text_SpeakerIkarios { "IKARIOS" }
text Route6_EleutheraiRoad_Text_SpeakerPythodoros { "PYTHODOROS" }
text Route6_EleutheraiRoad_Text_SpeakerBotrys { "BOTRYS" }
text Route6_EleutheraiRoad_Text_SpeakerAstylos { "ASTYLOS" }

// --- the vines (beat 26) --------------------------------------------------------
// The young vines are a thorn-thicket object (EventScript_CutTree: the engine
// asks for Demeter's Sickle); the old stock beside them is scenery.
script Route6_EleutheraiRoad_EventScript_VineStock {
    msgbox(format("An old vine stock, thick as a man's leg, grown right across the road.\pThe god's own. Nobody cuts these."), MSGBOX_SIGN)
}

script Route6_EleutheraiRoad_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerAlethea)
    msgbox(format("Ready when you are. Truthfully, I've been ready since breakfast."))
    release
}

script Route6_EleutheraiRoad_EventScript_Herald {
    lock
    faceplayer
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerHerald)
    msgbox(format("Hear me! Hear me, road! Hear me, vines!"))
    release
}

// --- the herald (beat 26) -------------------------------------------------------
script Route6_EleutheraiRoad_EventScript_HeraldScene {
    lockall
    hidefollower
    // Line the player up on the road's west lane, facing the barrier.
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 46) {
        applymovement(OBJ_EVENT_ID_PLAYER, Route6_EleutheraiRoad_Movement_StepWest)
        waitmovement(0)
    }
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    // Alethea walks up from the vines and stops beside the player.
    applymovement(LOCALID_ROUTE6_ALETHEA, Route6_EleutheraiRoad_Movement_AletheaUp)
    waitmovement(0)
    // The herald blows his horn: a long, cracked note. A Lophops flies out of
    // the vines in disgust.
    playse(SE_M_SING)
    waitse
    playmoncry(SPECIES_LOPHOPS, CRY_MODE_NORMAL)
    waitmoncry
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerHerald)
    msgbox(format("Hear me! Hear me, road! Hear me, vines!"))
    msgbox(format("The Dionysia begins in Thyrsa! The god comes home to his city!"))
    msgbox(format("The play is ready! Every road to Thyrsa is open!"))
    msgbox(format("Go up, go up, and bring a cup!"))
    closemessage
    // He lifts the barrier pole and shoulders it like an oar.
    applymovement(LOCALID_ROUTE6_HERALD, Route6_EleutheraiRoad_Movement_HeraldLift)
    waitmovement(0)
    playse(SE_M_STRENGTH)
    call(Route6_EleutheraiRoad_EventScript_SetRoadOpen)
    special(DrawWholeMapView)
    waitse
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerHerald)
    msgbox(format("You two. Thyrsa's over the mountain. Two days' walk."))
    msgbox(format("One, if you're Lakonian. One went by yesterday at a dead run."))
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerAlethea)
    msgbox(format("Kleon. Of course."))
    msgbox(format("Truthfully, I'm relieved. I thought he'd broken his neck on the vines."))
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerHerald)
    msgbox(format("There's a new play this year, they say. Nobody knows who wrote it."))
    msgbox(format("A tragedy. Thyrsa loves a tragedy. Then it loves the satyrs more."))
    closemessage
    // He walks off south toward Eleusa; the two step aside to let him by.
    applymovement(OBJ_EVENT_ID_PLAYER, Route6_EleutheraiRoad_Movement_StepWest)
    applymovement(LOCALID_ROUTE6_ALETHEA, Route6_EleutheraiRoad_Movement_StepEast)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    applymovement(LOCALID_ROUTE6_ALETHEA, Common_Movement_FaceLeft)
    applymovement(LOCALID_ROUTE6_HERALD, Route6_EleutheraiRoad_Movement_HeraldLeave)
    waitmovement(0)
    removeobject(LOCALID_ROUTE6_HERALD)
    setflag(FLAG_ICHOR_HIDE_HERALD_BARRIER)
    delay(20)
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerHerald)
    msgbox(format("The god comes home! Bring a cup!"))
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerAlethea)
    msgbox(format("A new play by nobody. My favorite kind of mystery."))
    msgbox(format("I'll walk with you as far as Thyrsa. I want to dig in the Kadmeia."))
    msgbox(format("Kadmos's own city. They say his house is still under it. Somewhere."))
    msgbox(format("I'll go ahead and read the stones. I read slower than you walk."))
    closemessage
    applymovement(LOCALID_ROUTE6_ALETHEA, Route6_EleutheraiRoad_Movement_AletheaLeave)
    waitmovement(0)
    removeobject(LOCALID_ROUTE6_ALETHEA)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_ROUTE6)
    setflag(FLAG_ICHOR_ACT2_BEGUN)
    setvar(VAR_TEMP_1, 1)
    releaseall
}

movement Route6_EleutheraiRoad_Movement_StepWest {
    walk_left
}

movement Route6_EleutheraiRoad_Movement_StepEast {
    walk_right
}

// from (47,22): round the vines' east end onto the road, up to (46,20)
movement Route6_EleutheraiRoad_Movement_AletheaUp {
    walk_left
    walk_up * 2
    face_up
}

movement Route6_EleutheraiRoad_Movement_HeraldLift {
    face_down
    jump_in_place_down
}

movement Route6_EleutheraiRoad_Movement_HeraldLeave {
    walk_down * 10
}

// from (47,20): back onto the road and north up the terrace
movement Route6_EleutheraiRoad_Movement_AletheaLeave {
    walk_left
    walk_up * 6
}

// --- the road's people ----------------------------------------------------------
script Route6_EleutheraiRoad_EventScript_VineDresser {
    msgbox(format("These are the god's own vines. The first he ever gave away.\pTo a man called Ikarios. He shared the wine with the shepherds.\pThey'd never been drunk before. They thought he'd poisoned them.\pIt went very badly for Ikarios. Wine's like that. Pour it slowly."), MSGBOX_NPC)
}

script Route6_EleutheraiRoad_EventScript_CartDriver {
    msgbox(format("Broke a wheel on the third terrace. Forty jars, all for the Dionysia.\pThe god's going to have to come and fetch them himself.\p…He does that, you know. Turns up when the wine's in trouble."), MSGBOX_NPC)
}

script Route6_EleutheraiRoad_EventScript_Pilgrim {
    msgbox(format("Thyrsa! The god's own city, and his own festival!\pI go every year. I never remember the plays. I remember the wine."), MSGBOX_NPC)
}

script Route6_EleutheraiRoad_EventScript_PilgrimB {
    msgbox(format("There's a new tragedy this year. Very mysterious. No author.\pThat's either very good or very bad. I can't wait."), MSGBOX_NPC)
}

// --- the drum on the cellar steps (the Girdle) ----------------------------------
// The drum is a column drum (EventScript_StrengthBoulder). Once it has been
// pushed off the steps and the player stands where it lay, it stays moved.
script Route6_EleutheraiRoad_EventScript_DrumMoved {
    setflag(FLAG_ICHOR_HIDE_ROUTE6_DRUM)
}

// --- trainers, in road order ------------------------------------------------------
script Route6_EleutheraiRoad_EventScript_Ikarios {
    trainerbattle_single(TRAINER_ICHOR_IKARIOS, Route6_EleutheraiRoad_Text_IkariosIntro, Route6_EleutheraiRoad_Text_IkariosDefeat)
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerIkarios)
    msgbox(format("The god gave the first vine to an Ikarios. We've been nervous ever since."), MSGBOX_AUTOCLOSE)
}

text Route6_EleutheraiRoad_Text_IkariosIntro {
    format("My grandfather's grandfather was an Ikarios too. Bad-luck name. Battle?")
}

text Route6_EleutheraiRoad_Text_IkariosDefeat {
    format("Pressed flat. Like a grape.")
}

script Route6_EleutheraiRoad_EventScript_Pythodoros {
    trainerbattle_single(TRAINER_ICHOR_PYTHODOROS, Route6_EleutheraiRoad_Text_PythodorosIntro, Route6_EleutheraiRoad_Text_PythodorosDefeat)
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerPythodoros)
    msgbox(format("They say the god walks in the procession, in disguise.\pI'll look at everyone's feet."), MSGBOX_AUTOCLOSE)
}

text Route6_EleutheraiRoad_Text_PythodorosIntro {
    format("To the Dionysia! I've walked from Emporion! Battle me. I need a rest!")
}

text Route6_EleutheraiRoad_Text_PythodorosDefeat {
    format("That was not restful.")
}

script Route6_EleutheraiRoad_EventScript_Botrys {
    trainerbattle_single(TRAINER_ICHOR_BOTRYS, Route6_EleutheraiRoad_Text_BotrysIntro, Route6_EleutheraiRoad_Text_BotrysDefeat)
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerBotrys)
    msgbox(format("Pick from the bottom. The top bunches belong to the birds. And the god."), MSGBOX_AUTOCLOSE)
}

text Route6_EleutheraiRoad_Text_BotrysIntro {
    format("Picking season! Help me or battle me. …Battle me.")
}

text Route6_EleutheraiRoad_Text_BotrysDefeat {
    format("Squashed!")
}

script Route6_EleutheraiRoad_EventScript_Astylos {
    trainerbattle_single(TRAINER_ICHOR_ASTYLOS, Route6_EleutheraiRoad_Text_AstylosIntro, Route6_EleutheraiRoad_Text_AstylosDefeat)
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerAstylos)
    msgbox(format("I carry the Archon's notices, up the mountain and down.\pMostly bad news, lately."), MSGBOX_AUTOCLOSE)
}

text Route6_EleutheraiRoad_Text_AstylosIntro {
    format("Message for Thyrsa! Can't stop! …Well. I can stop for this.")
}

text Route6_EleutheraiRoad_Text_AstylosDefeat {
    format("Late! The message will keep. It's about lateness.")
}

// --- the great herm, the dig, signs -------------------------------------------------
// The great herm doubles as the fork's sign; then the engine's anointing
// (ENGINE_API.md section 4: HERM_AETHOS_ROUTE_6, landing at (34,8)).
script Route6_EleutheraiRoad_EventScript_GreatHerm {
    lockall
    msgbox(format("A great herm, hung with ivy and old garlands. Hermes's face, worn smooth.\pNorth: Eleutherai and Kithairon. East: the hill path."))
    call(EventScript_IchorAnointHerm)
    releaseall
}

// ICHOR_STUB_DIG: a daily dig spot on the spur (SYSTEMS.md section 5). Its index
// comes from the ichor-engine session; then this becomes:
//   setvar(VAR_0x8004, <spot>)  setvar(VAR_0x8005, ICHOR_DIG_ACT_II)
//   goto(EventScript_IchorDigSpot)
script Route6_EleutheraiRoad_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

script Route6_EleutheraiRoad_EventScript_SignSouth {
    msgbox(format("ROUTE 6 · THE ELEUTHERAI ROAD\pSouth: Eleusa Village. North: Eleutherai, and the road over Kithairon."), MSGBOX_SIGN)
}

script Route6_EleutheraiRoad_EventScript_SignPress {
    msgbox(format("Tread barefoot. The god hates sandals in the wine."), MSGBOX_SIGN)
}

script Route6_EleutheraiRoad_EventScript_SignNorth {
    msgbox(format("ELEUTHERAI. The free town. Water, a cook, and a view."), MSGBOX_SIGN)
}

// --- the route standard's trainers (MAP_DESIGN section 8) ----------------------
text Route6_EleutheraiRoad_Text_SpeakerDorkis { "DORKIS" }

script Route6_EleutheraiRoad_EventScript_Dorkis {
    trainerbattle_single(TRAINER_ICHOR_DORKIS, Route6_EleutheraiRoad_Text_DorkisIntro, Route6_EleutheraiRoad_Text_DorkisDefeat)
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerDorkis)
    msgbox(format("Ikarios says the good grapes are at the top. Ikarios is short."), MSGBOX_AUTOCLOSE)
}

text Route6_EleutheraiRoad_Text_DorkisIntro {
    format("You walked through my row! Grape juice on your sandals. Battle!")
}

text Route6_EleutheraiRoad_Text_DorkisDefeat {
    format("Ah. Squashed like the rest of them.")
}

text Route6_EleutheraiRoad_Text_SpeakerPhilinna { "PHILINNA" }

script Route6_EleutheraiRoad_EventScript_Philinna {
    trainerbattle_single(TRAINER_ICHOR_PHILINNA, Route6_EleutheraiRoad_Text_PhilinnaIntro, Route6_EleutheraiRoad_Text_PhilinnaDefeat)
    setspeaker(Route6_EleutheraiRoad_Text_SpeakerPhilinna)
    msgbox(format("Two boys were born in that cave. One built a wall by singing. Imagine."), MSGBOX_AUTOCLOSE)
}

text Route6_EleutheraiRoad_Text_PhilinnaIntro {
    format("I came to see Antiope's cave before the festival. You too? Battle first!")
}

text Route6_EleutheraiRoad_Text_PhilinnaDefeat {
    format("The cave will wait. It's waited this long.")
}
