// Route 22, the Cretan Sea: Kaldera (east, Act II's) to Melos (west), optional,
// by Surf (design/phase4/SCRIPT.md Part 2, "Route 22, past Melos"). The story
// crosses it on the Euploia's deck. Layout: tools/ichor/maps/kythera_seas.py.
//
// TODO(act2): the east seam with Kaldera, once Kaldera's map exists; its 8
// columns nearest the seam are aethos-only.
// Music: MUS_ICHOR_FOAM_ROAD isn't written yet; Act I's road theme stands in.

mapscripts Route22_CretanSea_MapScripts {}

script Route22_CretanSea_EventScript_Kymaios {
    trainerbattle_single(TRAINER_ICHOR_KYMAIOS, Kythera_Text_KymaiosIntro, Kythera_Text_KymaiosDefeat)
    setspeaker(Kythera_Text_SpeakerKymaios)
    msgbox(Kythera_Text_KymaiosAfter, MSGBOX_AUTOCLOSE)
}

