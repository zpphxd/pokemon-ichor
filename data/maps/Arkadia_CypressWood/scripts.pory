// The Cypress Wood (design/phase3/SCRIPT.md beats 42-43, Part 2, Part 3). Layout and
// events are generated by tools/ichor/maps/arkadia.py.
//
// The map: the way in is the gate's mats on the bottom row (32-33, 29), back to
// Arkadia's warp 7. North through band 1 (rows 24-27), west along rows 22-23, then
// up the narrow (column 19) between two great trunks, past Euadne (18,21), into the
// stump clearing, where the trigger (19,18) starts beat 42. West of the clearing,
// band 2 (columns 5-8) and Lysippe, then the Pool's glade off the west edge (rows
// 13-15). Off the main line: the north spur to Agapenor's kiln and the vixen's
// hollow behind its hedge (19,3); the north-east glade (Hekaerge); the south-east
// glade (Mainalos); the tomb spur (Melanippe, the Tomb of Kallisto).
//
// The Wood is always in deep shade: its floor and canopy are drawn dark, so the
// clock's tables still apply. Beat 42 holds the tint at night while it plays
// (Ichor_HoldTimeOfDay); beat 43 lets it go.
//
// Stubs: ICHOR_STUB_MUSIC (the bare night theme and Kleon's lyre), ICHOR_STUB_DIG
// (tablet #5's fixed dig, the daily spot), ICHOR_STUB_AETHOS_DEX (Skylaps and
// Kerdovix are stand-ins).

mapscripts Arkadia_CypressWood_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(Arkadia_CypressWood_EventScript_Setup)
    }
}

text Arkadia_CypressWood_Name_Kleon { "KLEON" }
text Arkadia_CypressWood_Name_Alethea { "ALETHEA" }
text Arkadia_CypressWood_Name_Unknown { "???" }
text Arkadia_CypressWood_Name_Iapetos { "IAPETOS" }
text Arkadia_CypressWood_Name_Skylaps { "SKYLAPS" }
text Arkadia_CypressWood_Name_Euadne { "EUADNE" }
text Arkadia_CypressWood_Name_Agapenor { "AGAPENOR" }
text Arkadia_CypressWood_Name_Hekaerge { "HEKAERGE" }
text Arkadia_CypressWood_Name_Mainalos { "MAINALOS" }
text Arkadia_CypressWood_Name_Lysippe { "LYSIPPE" }
text Arkadia_CypressWood_Name_Melanippe { "MELANIPPE" }

script Arkadia_CypressWood_EventScript_Setup {
    // the looks that change mid-scene (SPRITES.md's swap)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_KLEON_STUMP)
    setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ICHOR_ALETHEA)
    // Iapetos, Alethea, the hound and the vixen only appear in the scene
    setflag(FLAG_TEMP_11)
    setflag(FLAG_TEMP_12)
    setflag(FLAG_TEMP_13)
    setflag(FLAG_TEMP_14)
    // the vixen in her den: after the Moon Laurel, at night, until met
    setflag(FLAG_TEMP_15)
    if (flag(FLAG_BADGE05_GET) && !flag(FLAG_ICHOR_STATIC_VIXEN_DEN)) {
        gettimeofday
        if (var(VAR_0x8000) == TIME_NIGHT) {
            clearflag(FLAG_TEMP_15)
        }
    }
}

script Arkadia_CypressWood_EventScript_Nothing {
    end
}

script Arkadia_CypressWood_EventScript_Kleon {
    lock
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Don't. Whatever you're going to say. Don't."))
    release
}

// ---------------------------------------------------------------------------
// Beat 42: Kleon's new moon. STORY.md §7.2, word for word, with §6.4's staging.
// ---------------------------------------------------------------------------

script Arkadia_CypressWood_EventScript_NewMoon {
    if (flag(FLAG_ICHOR_KLEON_JOINED_TITANS)) {
        setvar(VAR_TEMP_1, 1)
        end
    }
    lockall
    hidefollower
    setvar(VAR_TEMP_1, 1)
    // Night, no moon, whatever the clock says.
    setvar(VAR_0x8004, TIME_NIGHT)
    special(Ichor_HoldTimeOfDay)
    // ICHOR_STUB_MUSIC: MUS_ICHOR_ARKADIA_NIGHT_BARE (the night theme without its
    // drums); the Hollow's drone stands in.
    fadeoutbgm(1)
    playbgm(MUS_ICHOR_HOLLOW, FALSE)
    // into the clearing; Alethea comes up the narrow behind
    clearflag(FLAG_TEMP_12)
    addobject(LOCALID_WOOD_ALETHEA)
    applymovement(OBJ_EVENT_ID_PLAYER, Arkadia_CypressWood_Movement_IntoClearing)
    applymovement(LOCALID_WOOD_ALETHEA, Arkadia_CypressWood_Movement_AletheaUp)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    waitmovement(LOCALID_WOOD_ALETHEA)
    // the camera holds on him before he speaks; he doesn't turn round
    delay(60)
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Don't. Whatever you're going to say. Don't."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("…She didn't even look at me. Kallisto. The whole match."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("She looked at the sky. And she won anyway. Six to nothing."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Six to nothing."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("You know what her acolytes said? “Poor thing. He's fated.”"))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Like it already happened. Like I'm a story they've heard."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("“Die young and glorious.” Well. I'm young."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Where's the glorious part? When does that start?"))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Kleon, she's beaten everyone this month. She's-"))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("She beat everyone. She crushed me. There's a difference."))
    closemessage
    // a twig snaps; at the tree line on the far side, a figure fades in
    playse(SE_LEDGE)
    delay(20)
    clearflag(FLAG_TEMP_11)
    addobject(LOCALID_WOOD_IAPETOS)
    setvar(VAR_0x8004, LOCALID_WOOD_IAPETOS)
    special(Ichor_ObjectFadeIn)
    delay(24)
    applymovement(LOCALID_WOOD_ALETHEA, Common_Movement_FaceUp)
    waitmovement(0)
    setspeaker(Arkadia_CypressWood_Name_Unknown)
    msgbox(format("Six to nothing. I watched. It was very hard to watch."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Who are you?"))
    setspeaker(Arkadia_CypressWood_Name_Unknown)
    msgbox(format("A writer, of a sort. I write down what people are."))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("The Titans call me Iapetos. You can call me whatever helps."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("{PLAYER}. That's a Titan."))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("And you're Daphne's girl. The one who digs. Hello."))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("Kleon. May I tell you something true?"))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("The thread they read you was a poor one. Badly made."))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("“Young and glorious,” and nothing after. No deed. No place."))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("That's not a fate. That's a shrug."))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("Kallisto's fate is better written. That's why she won."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("…What's that supposed to mean?"))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("It means threads can be read again. Better. By someone careful."))
    // he holds out a wax tablet: fresh wax, a neat hand, a little hook at the end
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("Here's a better thread."))
    special(Ichor_ShowKleonTablet)
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("“Kleon of Lakonia shall slay the starry bull…"))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("…beneath the house of the double axe, and his glory shall never die.”"))
    closemessage
    special(Ichor_HideKleonTablet)
    delay(60)
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Never die."))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("Never."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("That's forged. Kleon, look at the wax. It's soft. He wrote it tonight."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Threads are read at Delphoi. Not by men in masks in the woods."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("And what did Delphoi read for me? “Die young.” Thanks, Delphoi."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("I'm telling you the truth."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Everybody's telling me the truth! I'd like a better one!"))
    closemessage
    // a pause; Kleon stands and turns to the player for the first time
    delay(30)
    // he rises off the stump (the stump walker's rise), then stands as himself
    applymovement(LOCALID_WOOD_KLEON, Arkadia_CypressWood_Movement_StandUp)
    waitmovement(0)
    copyobjectxytoperm(LOCALID_WOOD_KLEON)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_KLEON)
    removeobject(LOCALID_WOOD_KLEON)
    addobject(LOCALID_WOOD_KLEON)
    applymovement(LOCALID_WOOD_KLEON, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Everyone's got a story about you. Even the Titans. They wrote you a play."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("I just want one that's mine."))
    closemessage
    // he walks to the tree line and takes the tablet
    applymovement(LOCALID_WOOD_KLEON, Arkadia_CypressWood_Movement_KleonToMask)
    waitmovement(0)
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("There. That wasn't hard. May your thread never be cut."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("…Nor yours?"))
    setspeaker(Arkadia_CypressWood_Name_Iapetos)
    msgbox(format("Good. You'll pick it up."))
    closemessage
    // Iapetos steps back into the dark
    setvar(VAR_0x8004, LOCALID_WOOD_IAPETOS)
    special(Ichor_ObjectFadeOut)
    delay(20)
    removeobject(LOCALID_WOOD_IAPETOS)
    // Kleon goes back to the stump and sweeps his six Poké Balls into his bag
    applymovement(LOCALID_WOOD_KLEON, Arkadia_CypressWood_Movement_KleonToBalls)
    waitmovement(0)
    playse(SE_BALL)
    removeobject(LOCALID_WOOD_BALLS)
    delay(20)
    applymovement(LOCALID_WOOD_KLEON, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Don't follow me. I mean it this time."))
    setspeaker(Arkadia_CypressWood_Name_Kleon)
    msgbox(format("Next time we fight, it's written that I win."))
    closemessage
    // he walks into the trees after the mask. The music drops out.
    // ICHOR_STUB_MUSIC: MUS_ICHOR_KLEON_MINOR, a single lyre, once; silence stands in.
    fadeoutbgm(2)
    applymovement(LOCALID_WOOD_KLEON, Arkadia_CypressWood_Movement_KleonAway)
    waitmovement(0)
    setvar(VAR_0x8004, LOCALID_WOOD_KLEON)
    special(Ichor_ObjectFadeOut)
    delay(20)
    removeobject(LOCALID_WOOD_KLEON)
    delay(30)
    applymovement(LOCALID_WOOD_ALETHEA, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("…He didn't believe me."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("People don't. I'm used to it."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Truthfully, I'm not."))
    closemessage
    setflag(FLAG_ICHOR_KLEON_JOINED_TITANS)
    goto(Arkadia_CypressWood_EventScript_StormHound)
}

// ---------------------------------------------------------------------------
// Beat 43: the storm-hound and the vixen
// ---------------------------------------------------------------------------

script Arkadia_CypressWood_EventScript_StormHound {
    delay(40)
    // a crackle, like dry pine catching
    playse(SE_M_THUNDERBOLT2)
    setobjectxyperm(LOCALID_WOOD_KERDOVIX, 10, 13)
    setobjectxyperm(LOCALID_WOOD_SKYLAPS, 9, 13)
    clearflag(FLAG_TEMP_14)
    clearflag(FLAG_TEMP_13)
    addobject(LOCALID_WOOD_KERDOVIX)
    addobject(LOCALID_WOOD_SKYLAPS)
    // the vixen bolts out of the cypresses on the left, the hound one step behind;
    // they circle the stump twice, and she slips into the trees where the mask went
    applymovement(LOCALID_WOOD_KERDOVIX, Arkadia_CypressWood_Movement_VixenRuns)
    applymovement(LOCALID_WOOD_SKYLAPS, Arkadia_CypressWood_Movement_HoundRuns)
    waitmovement(LOCALID_WOOD_KERDOVIX)
    removeobject(LOCALID_WOOD_KERDOVIX)
    waitmovement(LOCALID_WOOD_SKYLAPS)
    // the hound stops at the tree line and stares into the dark, ears flat
    delay(60)
    applymovement(LOCALID_WOOD_SKYLAPS, Arkadia_CypressWood_Movement_HoundToAlethea)
    waitmovement(0)
    // it sits down beside Alethea, panting; she kneels by it
    copyobjectxytoperm(LOCALID_WOOD_ALETHEA)
    setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ICHOR_ALETHEA_KNEEL)
    removeobject(LOCALID_WOOD_ALETHEA)
    addobject(LOCALID_WOOD_ALETHEA)
    delay(30)
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("…You didn't catch her."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("You were never going to, were you."))
    closemessage
    playmoncry(SPECIES_SKYLAPS, CRY_MODE_NORMAL)
    setspeaker(Arkadia_CypressWood_Name_Skylaps)
    msgbox(format("Grrrff."))
    waitmoncry
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("There's a story about you. A hound that catches everything it chases."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("And a fox that can't be caught. Somebody set them running, and…"))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("That's all. They just run. Nobody ever gets to the end of it."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Truthfully, I think we're going to get along."))
    closemessage
    setflag(FLAG_ICHOR_ALETHEA_GOT_SKYLAPS)
    // she stands and brushes off her knees
    copyobjectxytoperm(LOCALID_WOOD_ALETHEA)
    setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ICHOR_ALETHEA)
    removeobject(LOCALID_WOOD_ALETHEA)
    addobject(LOCALID_WOOD_ALETHEA)
    applymovement(LOCALID_WOOD_ALETHEA, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Did you see the end of his tablet? The last line?"))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("A little hook. The same as the program at Thyrsa."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("The same as the notice in Emporion, under the Archon's owl."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("That's three. Three forgeries, one hand. I've been keeping a list."))
    call(Arkadia_CypressWood_EventScript_ReadTablets)
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("I'm taking it to Astyra."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("The Archon has a Keeper of Records. It's his whole job."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Knowing a true record from a forged one. Nobody in Aethos is better."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("If anyone can read this hand, it's him. He'll know whose it is."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("The huntresses won't let anyone down the east road till the hunt's done."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("So I'll go round. North, the ferry, back through Eleusa. I'm good at walking."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("You win your laurel. Then come to the capital."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("I'll be the one with the list, outside the Archon's door. Truthfully."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("The Pool's just through there. Mnemosyne's. Like the spring at Lebadeia."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Not-forgetting. That's what my name means."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("Truthfully, tonight I'd like to forget a little."))
    closemessage
    // Alethea and Skylaps walk out east, toward the wood gate
    applymovement(LOCALID_WOOD_ALETHEA, Arkadia_CypressWood_Movement_AletheaLeaves)
    applymovement(LOCALID_WOOD_SKYLAPS, Arkadia_CypressWood_Movement_HoundLeaves)
    waitmovement(LOCALID_WOOD_ALETHEA)
    waitmovement(LOCALID_WOOD_SKYLAPS)
    removeobject(LOCALID_WOOD_ALETHEA)
    removeobject(LOCALID_WOOD_SKYLAPS)
    special(Ichor_ReleaseTimeOfDay)
    fadedefaultbgm
    releaseall
}

// Alethea reads any prophecy tablet in the Bag she hasn't read (Part 6): tablet #3
// (Thyrsa's soldier) and tablet #5 (Kallisto's) can be found by now.
script Arkadia_CypressWood_EventScript_ReadTablets {
    setvar(VAR_0x8007, 0)
    if (flag(FLAG_ICHOR_PROPHECY_3) && !flag(FLAG_ICHOR_PROPHECY_3_READ)) {
        setvar(VAR_0x8007, 1)
    }
    if (flag(FLAG_ICHOR_PROPHECY_START + 4) && !flag(FLAG_ICHOR_PROPHECY_START + 12)) {
        setvar(VAR_0x8007, 1)
    }
    if (var(VAR_0x8007) == 0) {
        return
    }
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("And those lead tablets you dug up. Those too. Give them here."))
    setspeaker(Arkadia_CypressWood_Name_Alethea)
    msgbox(format("I'll copy them out tonight. Every scraped line, every hook."))
    if (flag(FLAG_ICHOR_PROPHECY_3) && !flag(FLAG_ICHOR_PROPHECY_3_READ)) {
        setspeaker(Arkadia_CypressWood_Name_Alethea)
        msgbox(format("A lead tablet. People scratch their questions on these, for the Oracle.\p"
                      "“Hippias, son of Eudora, soldier of Thyrsa. Will I come home?”\p"
                      "And the answer, over it: “You'll die in the next war.”\p"
                      "…Tilt it to the light. See the scratches underneath?\p"
                      "Someone scraped the first answer off and wrote a new one. Neatly.\p"
                      "The old one says: “You'll come home from the next war.”\p"
                      "And at the end of the new one, a little hook.\p"
                      "Another one for my list. Truthfully, I'm not enjoying this list."))
        setflag(FLAG_ICHOR_PROPHECY_3_READ)
    }
    if (flag(FLAG_ICHOR_PROPHECY_START + 4) && !flag(FLAG_ICHOR_PROPHECY_START + 12)) {
        setspeaker(Arkadia_CypressWood_Name_Alethea)
        msgbox(format("A reading. On lead, the kind they scratch at Dodona. Hold it to the light.\p"
                      "Somebody scraped this and wrote over it. Neatly. Very neatly.\p"
                      "Underneath, the old letters are still there. “Show mercy at the new moon.”\p"
                      "They took out one word. One. “Mercy” became “no mercy.”\p"
                      "And they signed it. The same little hook.\p"
                      "{PLAYER}. Somebody wrote tonight's fight before it happened. Kleon's loss.\p"
                      "Somebody wanted him beaten that badly."))
        setflag(FLAG_ICHOR_PROPHECY_START + 12)
    }
}

movement Arkadia_CypressWood_Movement_StandUp { nurse_joy_bow }
movement Arkadia_CypressWood_Movement_IntoClearing { walk_up * 2 walk_left face_up }
movement Arkadia_CypressWood_Movement_AletheaUp { walk_up * 5 face_up }
movement Arkadia_CypressWood_Movement_KleonToMask { walk_up * 3 walk_right * 4 face_right }
movement Arkadia_CypressWood_Movement_KleonToBalls { walk_left * 3 walk_down * 2 face_down }
movement Arkadia_CypressWood_Movement_KleonAway { walk_up * 2 walk_right * 4 }
movement Arkadia_CypressWood_Movement_VixenRuns {
    walk_fast_right * 4
    walk_fast_up walk_fast_right * 2 walk_fast_down * 2 walk_fast_left * 2 walk_fast_up
    walk_fast_up walk_fast_right * 2 walk_fast_down * 2 walk_fast_left * 2 walk_fast_up
    walk_fast_up walk_fast_right * 5 walk_fast_up * 2 walk_fast_right
}
movement Arkadia_CypressWood_Movement_HoundRuns {
    walk_fast_right * 5
    walk_fast_up walk_fast_right * 2 walk_fast_down * 2 walk_fast_left * 2 walk_fast_up
    walk_fast_up walk_fast_right * 2 walk_fast_down * 2 walk_fast_left * 2 walk_fast_up
    walk_fast_up walk_fast_right * 5 walk_fast_up * 2 face_right
}
movement Arkadia_CypressWood_Movement_HoundToAlethea { walk_right walk_down * 6 face_left }
movement Arkadia_CypressWood_Movement_AletheaLeaves { walk_right walk_down walk_left walk_down * 5 }
movement Arkadia_CypressWood_Movement_HoundLeaves { delay_16 walk_down walk_left walk_down * 5 }

// ---------------------------------------------------------------------------
// The Wood's trainers (Part 3; the four after Euadne and Agapenor are the route
// standard's, MAP_DESIGN §8)
// ---------------------------------------------------------------------------

script Arkadia_CypressWood_EventScript_Euadne {
    trainerbattle_single(TRAINER_ICHOR_EUADNE, Arkadia_CypressWood_Text_EuadneIntro, Arkadia_CypressWood_Text_EuadneDefeat)
    setspeaker(Arkadia_CypressWood_Name_Euadne)
    msgbox(format("The Huntress went to her tomb at sunset. The mound, down the south path.\p"
                  "She knelt and dug a little hole with her hands.\p"
                  "Then she came back without her bag."), MSGBOX_AUTOCLOSE)
}

text Arkadia_CypressWood_Text_EuadneIntro {
    format("Nobody walks the Wood at the new moon. Except wolves. And you.")
}

text Arkadia_CypressWood_Text_EuadneDefeat {
    format("You're not a wolf. Wolves lose better.")
}

script Arkadia_CypressWood_EventScript_Agapenor {
    trainerbattle_single(TRAINER_ICHOR_AGAPENOR, Arkadia_CypressWood_Text_AgapenorIntro, Arkadia_CypressWood_Text_AgapenorDefeat)
    setspeaker(Arkadia_CypressWood_Name_Agapenor)
    if (flag(FLAG_BADGE05_GET)) {
        msgbox(format("She sleeps behind my kiln, you know. The vixen. Nights. I leave her the crusts."),
               MSGBOX_AUTOCLOSE)
    } else {
        msgbox(format("There's a vixen around here nobody's ever caught. Nobody. Ever.\p"
                      "There's a hound that's never missed. They've been at it longer than the trees."),
               MSGBOX_AUTOCLOSE)
    }
}

text Arkadia_CypressWood_Text_AgapenorIntro {
    format("In the Wood, at night? You must be lost. Or you must want a battle.")
}

text Arkadia_CypressWood_Text_AgapenorDefeat {
    format("Not lost, then. Just good.")
}

script Arkadia_CypressWood_EventScript_Hekaerge {
    trainerbattle_single(TRAINER_ICHOR_HEKAERGE, Arkadia_CypressWood_Text_HekaergeIntro, Arkadia_CypressWood_Text_HekaergeDefeat)
    setspeaker(Arkadia_CypressWood_Name_Hekaerge)
    msgbox(format("There's a hollow trunk at the glade's west edge. Mushrooms in it, big as fists."),
           MSGBOX_AUTOCLOSE)
}

text Arkadia_CypressWood_Text_HekaergeIntro {
    format("Far-shooter, they call the goddess. I'm still working on the far part.")
}

text Arkadia_CypressWood_Text_HekaergeDefeat {
    format("Too close. Always too close.")
}

script Arkadia_CypressWood_EventScript_Mainalos {
    trainerbattle_single(TRAINER_ICHOR_MAINALOS, Arkadia_CypressWood_Text_MainalosIntro, Arkadia_CypressWood_Text_MainalosDefeat)
    setspeaker(Arkadia_CypressWood_Name_Mainalos)
    msgbox(format("My kiln went cold the night the wolves came through. I sit with it anyway."),
           MSGBOX_AUTOCLOSE)
}

text Arkadia_CypressWood_Text_MainalosIntro {
    format("Charcoal's slow work. A battle's quicker. Go on, then.")
}

text Arkadia_CypressWood_Text_MainalosDefeat {
    format("Burned through. Like a bad kiln.")
}

script Arkadia_CypressWood_EventScript_Lysippe {
    trainerbattle_single(TRAINER_ICHOR_LYSIPPE, Arkadia_CypressWood_Text_LysippeIntro, Arkadia_CypressWood_Text_LysippeDefeat)
    setspeaker(Arkadia_CypressWood_Name_Lysippe)
    msgbox(format("Mnaseas has sat by that water longer than he'll say. Ask him. He won't answer."),
           MSGBOX_AUTOCLOSE)
}

text Arkadia_CypressWood_Text_LysippeIntro {
    format("The Pool's past me. Nobody drinks from it. Shall we fight instead?")
}

text Arkadia_CypressWood_Text_LysippeDefeat {
    format("You didn't even blink. Good.")
}

script Arkadia_CypressWood_EventScript_Melanippe {
    trainerbattle_single(TRAINER_ICHOR_MELANIPPE, Arkadia_CypressWood_Text_MelanippeIntro, Arkadia_CypressWood_Text_MelanippeDefeat)
    setspeaker(Arkadia_CypressWood_Name_Melanippe)
    msgbox(format("On clear nights the Great Bear stands right over the mound. Look up."),
           MSGBOX_AUTOCLOSE)
}

text Arkadia_CypressWood_Text_MelanippeIntro {
    format("This is the first Kallisto's tomb. Mind your feet on her mound.")
}

text Arkadia_CypressWood_Text_MelanippeDefeat {
    format("You walk softly for someone who wins like that.")
}

// ---------------------------------------------------------------------------
// The kiln, the den, the tomb, the signs
// ---------------------------------------------------------------------------

script Arkadia_CypressWood_EventScript_DuskBalls {
    finditem(ITEM_DUSK_BALL, 2)
}

script Arkadia_CypressWood_EventScript_Hedge {
    msgbox(format("The cypresses grow close here. Something small has worn a low path under them."),
           MSGBOX_SIGN)
}

// The vixen's den (Part 4): a Kerdovix asleep, after the Moon Laurel, at night.
script Arkadia_CypressWood_EventScript_SleepingVixen {
    lock
    msgbox(format("A silver-red vixen, curled asleep in the hollow."))
    closemessage
    waitse
    playmoncry(SPECIES_KERDOVIX, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_KERDOVIX, 34)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_ICHOR_STATIC_VIXEN_DEN)
        removeobject(LOCALID_WOOD_VIXEN)
    } elif (var(VAR_RESULT) == B_OUTCOME_MON_FLED) {
        // she's gone for tonight; she sleeps here again tomorrow night
        removeobject(LOCALID_WOOD_VIXEN)
    }
    release
}

script Arkadia_CypressWood_EventScript_Stump {
    if (!flag(FLAG_ICHOR_KLEON_JOINED_TITANS)) {
        end
    }
    msgbox(format("An old cypress stump, cut flat.\pScratches on its edge, where something sat in a row."),
           MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: prophecy tablet #5, a fixed dig by the shrine (Part 6). The dig
// API replaces this: setvar(VAR_0x8004, <find index>), setvar(VAR_0x8005, <the
// tablet>), goto(EventScript_IchorDigFixed), with FLAG_ICHOR_PROPHECY_START + 4.
script Arkadia_CypressWood_EventScript_TabletEarth {
    msgbox(format("The earth by the shrine has been turned, and not long ago, by hand.\p"
                  "Something is buried here."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: a daily dig spot at the mound's foot (Part 6).
script Arkadia_CypressWood_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

script Arkadia_CypressWood_EventScript_SignGate {
    msgbox(format("THE CYPRESS WOOD\nWest: the Pool of Mnemosyne. Keep to the path.\p"
                  "The path is the only sure thing."), MSGBOX_SIGN)
}

script Arkadia_CypressWood_EventScript_SignTomb {
    msgbox(format("THE TOMB OF KALLISTO. She hunted here. She sleeps here. She shines up there."),
           MSGBOX_SIGN)
}

script Arkadia_CypressWood_EventScript_SignPool {
    msgbox(format("West: the Pool of Mnemosyne. East: the stump clearing, and Arkadia."), MSGBOX_SIGN)
}
