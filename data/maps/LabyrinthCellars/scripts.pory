script LabyrinthCellars_EventScript_Drop {
    lockall
    msgbox(format("The floor at the back gives way!"), MSGBOX_DEFAULT)
    closemessage
    playse(SE_FALL)
    warp(MAP_LABYRINTH_CELLARS, 24)
    waitstate
}
