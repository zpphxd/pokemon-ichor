// The player's house, 2F: the player's room (beat 1A). A new game starts at
// (5,5), the rug at the foot of the kline (src/new_game.c). The stairs are
// (8,1); the gate is the tile in front of them, (8,2).

mapscripts ElaiaVillage_PlayersHouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_ELAIA_VILLAGE)
    }
}

script ElaiaVillage_PlayersHouse_2F_EventScript_StairGate {
    lockall
    setspeaker(SP_NAME_MOM)
    msgbox(format("{PLAYER}! Did you fill your water clock?\pFestival day! You can't be late on festival day!"))
    closemessage
    applymovement(LOCALID_PLAYER, Common_Movement_WalkDown)
    waitmovement(0)
    releaseall
}

script ElaiaVillage_PlayersHouse_2F_EventScript_WaterClock {
    lockall
    if (!flag(FLAG_ICHOR_SET_WATER_CLOCK)) {
        msgbox(format("Your klepsydra. Water drips from the top bowl to the bottom one.\pIt's run dry. Better fill it and set the hour."))
        closemessage
        fadescreen(FADE_TO_BLACK)
        special(StartWallClock)
        // The clock takes over the screen at the end of this frame; the delay
        // parks the script until the field comes back (as vanilla's clock does).
        delay(30)
        call(ElaiaVillage_PlayersHouse_2F_EventScript_ChooseDifficulty)
        call(ElaiaVillage_PlayersHouse_2F_EventScript_ChooseOath)
        setflag(FLAG_ICHOR_SET_WATER_CLOCK)
        msgbox(format("Drip… drip… drip. Good as new."))
    } else {
        msgbox(format("Drip… drip… The water says it's still today."))
    }
    releaseall
}

script ElaiaVillage_PlayersHouse_2F_EventScript_ChooseDifficulty {
    if (!flag(FLAG_ICHOR_DIFFICULTY_CHOSEN)) {
        msgbox(format("Every road begins with a choice.\pMortal is an easier journey. Hero is the usual challenge.\pSpartan limits your level, uses set battles, and forbids battle items.\pIts trainers fight smarter. You may still throw Pithoi to catch Pokémon.\pChoose carefully. This road stays with this save."))
        while (!flag(FLAG_ICHOR_DIFFICULTY_CHOSEN)) {
            message(format("Which road will you take?"))
            waitmessage
            multichoicedefault(0, 0, MULTI_ICHOR_DIFFICULTY, TRUE, 1)
            copyvar(VAR_0x8004, VAR_RESULT)
            switch (var(VAR_RESULT)) {
                case 0:
                    msgbox(format("Take the Mortal road?"), MSGBOX_YESNO)
                case 1:
                    msgbox(format("Take the Hero road?"), MSGBOX_YESNO)
                case 2:
                    msgbox(format("Take the Spartan road?"), MSGBOX_YESNO)
            }
            if (var(VAR_RESULT) == YES) {
                specialvar(VAR_RESULT, Ichor_ChooseDifficulty)
                if (var(VAR_RESULT) == FALSE) {
                    msgbox(format("That choice could not be saved. Try again."))
                }
            }
        }
    }
    return
}

script ElaiaVillage_PlayersHouse_2F_EventScript_ChooseOath {
    if (flag(FLAG_ICHOR_OATH_CHOICE_PENDING) && !flag(FLAG_ICHOR_GOT_STARTER)) {
        msgbox(format("One more choice, separate from your road: the Oath of the Styx.\pIt is optional. Only the first wild encounter in each named area may be caught.\pIf it gets away, that area's chance is gone.\pA fallen partner can never battle or be healed again. They rest in the sealed Urn.\pThe Urn grows into empty Pithos jars. Keep a jar free; fallen partners may wait with you if it fills.\pIf your party falls, a living partner from storage can take their place.\pIf none remain, or there is no room to recover one, you return to the title.\pYour last manual save is unchanged. You may load it again.\pYou choose this rule only once, before your first partner."))
        while (flag(FLAG_ICHOR_OATH_CHOICE_PENDING)) {
            message(format("Swear the Oath of the Styx?"))
            waitmessage
            multichoicedefault(0, 0, MULTI_YESNO, TRUE, 1)
            setvar(VAR_0x8004, FALSE)
            setvar(VAR_0x8005, TRUE)
            if (var(VAR_RESULT) == 0) {
                msgbox(format("Fallen partners stay fallen. Bind this journey to the Oath?"), MSGBOX_YESNO)
                if (var(VAR_RESULT) == YES) {
                    setvar(VAR_0x8004, TRUE)
                } else {
                    setvar(VAR_0x8005, FALSE)
                }
            }
            if (var(VAR_0x8005) == TRUE) {
                specialvar(VAR_RESULT, Ichor_ChooseStartingOath)
                if (var(VAR_RESULT) == FALSE) {
                    msgbox(format("That choice could not be saved. Try again."))
                }
            }
        }
        if (var(VAR_0x8004) == TRUE) {
            msgbox(format("The Styx has heard you. The Urn waits for those who fall."))
        } else {
            msgbox(format("No Oath binds this journey. Your partners follow the usual rules."))
        }
    }
    return
}

script ElaiaVillage_PlayersHouse_2F_EventScript_Kibotos {
    lockall
    msgbox(format("Your kibotos. Spare gear and keepsakes go in here."))
    special(PlayerPC)
    releaseall
}

script ElaiaVillage_PlayersHouse_2F_EventScript_Knucklebones {
    msgbox(format("Your knucklebones. Record against Mom: 0 wins, 212 losses."), MSGBOX_SIGN)
}

script ElaiaVillage_PlayersHouse_2F_EventScript_Window {
    msgbox(format("Bees drift past. Down in the square, someone's tuning a lyre."), MSGBOX_SIGN)
}

script ElaiaVillage_PlayersHouse_2F_EventScript_Scrolls {
    msgbox(format("Scrolls about heroes. You've drawn mustaches on all of them."), MSGBOX_SIGN)
}
