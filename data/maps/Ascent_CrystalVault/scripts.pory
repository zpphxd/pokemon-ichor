// The Crystal Vault (design/maps/Ascent_CrystalVault.md): a hall of frozen ichor
// behind the Icefall's chained door (the Labrys). The crystal giant sleeps here.
// Generated by tools/ichor/maps/ascent_glacier.py: edit the builder, not this file.

mapscripts Ascent_CrystalVault_MapScripts {}

script Ascent_CrystalVault_EventScript_Krystolos {
    lock
    faceplayer
    msgbox(format("A giant of crystal sits on the ice, gold light slow in its chest.\pIt opens its eyes."), MSGBOX_DEFAULT)
    closemessage
    playmoncry(SPECIES_KRYSTOLOS, CRY_MODE_ENCOUNTER)
    waitmoncry
    setwildbattle(SPECIES_KRYSTOLOS, 64)
    dowildbattle
    setflag(FLAG_ICHOR_VAULT_KRYSTOLOS)
    removeobject(VAR_LAST_TALKED)
    release
}

// A fixed dig (ENGINE_API §8, fixed index 0x38): an ostrakon frozen into the floor.
script Ascent_CrystalVault_EventScript_Dig {
    setvar(VAR_0x8004, 0x38)
    setvar(VAR_0x8005, ICHOR_FIND_OSTRAKON)
    goto(EventScript_IchorDigFixed)
}

script Ascent_CrystalVault_EventScript_Argyros {
    trainerbattle_single(TRAINER_ICHOR_VAULT_ARGYROS,
        format("Don't touch the gold ones. They're mine. I came down the crack in the roof for them.\pCan't get back up it, mind you. That's a problem for later."),
        format("Fine. Take a gold one."))
    msgbox(format("The crack goes all the way up to the glacier. I slid down it.\pClimbing up it again would take hands like a goat's."), MSGBOX_AUTOCLOSE)
}

script Ascent_CrystalVault_EventScript_Crack {
    msgbox(format("A crack in the vault's roof, light coming down it from very far up.\pIce-slick and sheer. No one is climbing up that without a crook and a goat's nerve."), MSGBOX_SIGN)
}

script Ascent_CrystalVault_EventScript_Inscription {
    msgbox(format("Letters cut in the ice by a careful hand:\p“Here the Giants struck Zeus's shield, and what ran out was not blood but ichor,\pgold and cold. It would not soak into the mountain. It stood up.”"), MSGBOX_SIGN)
}

script Ascent_CrystalVault_EventScript_ThreadUp {
    lockall
    msgbox(format("Ariadne's Thread hangs down the crack, tied off far above on the Glacier.\p"
                  "Climb back up it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_BIND)
        fadescreen(FADE_TO_BLACK)
        warpsilent(MAP_ASCENT_GLACIER, 14, 12)
        waitstate
    }
    releaseall
}

// --- the gods' easter eggs (tools/ichor/maps/ascent_eggs.py) ---
script Ascent_CrystalVault_EventScript_EggApple {
    msgbox(format("Something gold is wedged between two crystals: an apple, scratched FOR THE FAIREST.\pEris threw one of these once and started a war. Best not to toss it to anyone."), MSGBOX_SIGN)
}

script Ascent_CrystalVault_EventScript_EggWheel {
    msgbox(format("Deep inside one crystal, a gold wheel turns, very slowly.\pThe crystal hasn't moved in an age. The wheel has never stopped."), MSGBOX_SIGN)
}
