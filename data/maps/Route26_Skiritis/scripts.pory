script Route26_Skiritis_EventScript_SouthSign {
    msgbox(format("ROUTE 26\nNorth past the training grounds to Lake Stymphalia."), MSGBOX_SIGN)
    end
}

script Route26_Skiritis_EventScript_ForkSign {
    msgbox(format("SOUTH: LAKONIA. NORTH: STYMPHALIA.\nEAST: the old altar."), MSGBOX_SIGN)
    end
}

script Route26_Skiritis_EventScript_Herm {
    lockall
    msgbox(format("SOUTH: LAKONIA. NORTH: STYMPHALIA.\pA herm of Hermes, at the crossing of the boys' road and the scouts'."))
    call(EventScript_IchorAnointHerm)
    releaseall
}

script Route26_Skiritis_EventScript_Herakles {
    msgbox(format("A bridge onto the island, with a statue of Herakles at its head.\pThe other bridge has Lykourgos. You choose your bridge, and then you fight."), MSGBOX_SIGN)
    end
}

script Route26_Skiritis_EventScript_Lykourgos {
    msgbox(format("Lykourgos the lawgiver, bearded, with his staff.\pUnder him: NO WALLS. THE WALLS OF LAKONIA ARE ITS MEN."), MSGBOX_SIGN)
    end
}

script Route26_Skiritis_EventScript_Phoibaion {
    msgbox(format("The Phoibaion. Two teams made their offering here before the fight.\pA puppy for the war god, in the old days. Now it's honey."), MSGBOX_SIGN)
    end
}

script Route26_Skiritis_EventScript_Columns {
    lockall
    if (flag(FLAG_ICHOR_ACT3_COMPLETE)) {
        msgbox(format("The road below is empty. A helmet lies in the dust, upside down, full of rain."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Below the ridge, a line of bronze helmets marches north. It doesn't end.\p"
                      "Some of them are singing. Some of them are boys."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Route26_Skiritis_EventScript_Post {
    msgbox(format("The turning post. Cadets round it a hundred times a day.\pThe stone's worn smooth on one side only."), MSGBOX_SIGN)
    end
}
