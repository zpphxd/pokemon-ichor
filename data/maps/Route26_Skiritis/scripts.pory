script Route26_Skiritis_EventScript_ANAXILAS {
    trainerbattle_single(TRAINER_ICHOR_ANAXILAS, format("Lap forty! Or forty-one. Battle me while I count."), format("Now I've lost the count AND the battle."))
    msgbox(format("The island's past the field. Two bridges. Pick one and don't fall in."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_R26_DROMAS {
    trainerbattle_single(TRAINER_ICHOR_R26_DROMAS, format("Out of my lane! …Fine. In it, then. Battle!"), format("I'd have won if it was a race."))
    msgbox(format("Cadets run the track barefoot, in winter. It's character. Apparently."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_ANAXANDROS {
    trainerbattle_single(TRAINER_ICHOR_ANAXANDROS, format("Herakles's bridge is my team's. Cross it and you're on my side. Or in the moat."), format("…Fine. You're on my side. Welcome to the team. We lost."))
    msgbox(format("Out by Lykourgos's bridge. Nobody ever says thank you to Lykourgos."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_R26_PALAISTES {
    trainerbattle_single(TRAINER_ICHOR_R26_PALAISTES, format("You're on the island, so you're in the fight. Those are the rules."), format("Thrown in. Spiritually."))
    msgbox(format("Last team standing on the island wins. I'm standing. Sort of."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_R26_ARGEIOS {
    trainerbattle_single(TRAINER_ICHOR_R26_ARGEIOS, format("I fell out of the column. On purpose. Don't tell them."), format("They'll never notice. That's the sad part."))
    msgbox(format("The altar's older than the school. The boys still leave it honey."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_R26_PHRYNON {
    trainerbattle_single(TRAINER_ICHOR_R26_PHRYNON, format("The birds over the ridge fly north with the columns. I'm counting both."), format("Counted out."))
    msgbox(format("Every column that goes north, nothing comes back south. Not even birds."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_R26_KRYPTIS {
    trainerbattle_single(TRAINER_ICHOR_R26_KRYPTIS, format("Skiritai scouts learn the terrace first. Down's easy. Up's the lesson."), format("Lesson learned. By me."))
    msgbox(format("Hop the walls to get home quick. Climbing back is your problem."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_DIENEKES {
    trainerbattle_single(TRAINER_ICHOR_DIENEKES, format("Seen you coming for a mile. That's the job. Now, the other job."), format("Should've seen that coming too."))
    msgbox(format("They say the Titans' arrows will blot out the sun.\pGood. We'll fight in the shade."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_R26_AIPOLOS {
    trainerbattle_single(TRAINER_ICHOR_R26_AIPOLOS, format("My goats graze the scouts' meadow. The scouts graze my goats."), format("Even the goats saw that."))
    msgbox(format("From the rise you can see the lake. Don't look at the birds too long."), MSGBOX_AUTOCLOSE)
    end
}

script Route26_Skiritis_EventScript_Runner {
    lock
    faceplayer
    msgbox(format("Run. Turn at the post. Run. That's the whole agoge, really."))
    release
}

script Route26_Skiritis_EventScript_Wrestler {
    lock
    faceplayer
    msgbox(format("Two teams. One island. Last team standing on it wins.\pI've been thrown in four times this morning.\pI'm winning, though. Spiritually."))
    release
}

script Route26_Skiritis_EventScript_WrestlerTwo {
    lock
    faceplayer
    if (flag(FLAG_ICHOR_GOT_R26_WRESTLERS_BAND)) {
        msgbox(format("Herakles's side always loses. Don't tell Anaxandros."))
        release
        end
    }
    msgbox(format("You came over Herakles's bridge and you're still dry? Respect.\p"
                  "Here. The team's headband. We lost anyway."))
    giveitem(ITEM_MUSCLE_BAND)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_ICHOR_GOT_R26_WRESTLERS_BAND)
    }
    release
}

