// ---------------------------------------------------------------------------
// Beat 30: the Elektran Gate. The first step inside sets the arrival flags and
// the gatekeeper comes over from his bench by the west tower (23,37). One
// trigger per gate column, so he stops just north of the player.
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_ArrivalX26 {
    setvar(VAR_0x8008, 26)
    goto(ThyrsaCity_EventScript_Arrival)
}

script ThyrsaCity_EventScript_ArrivalX27 {
    setvar(VAR_0x8008, 27)
    goto(ThyrsaCity_EventScript_Arrival)
}

script ThyrsaCity_EventScript_ArrivalX28 {
    setvar(VAR_0x8008, 28)
    goto(ThyrsaCity_EventScript_Arrival)
}

script ThyrsaCity_EventScript_ArrivalX29 {
    setvar(VAR_0x8008, 29)
    goto(ThyrsaCity_EventScript_Arrival)
}

script ThyrsaCity_EventScript_Arrival {
    lockall
    setvar(VAR_TEMP_1, 1)
    setflag(FLAG_ICHOR_ARRIVED_THYRSA)
    setflag(FLAG_ICHOR_VISITED_THYRSA)
    playse(SE_PIN)
    applymovement(LOCALID_THYRSA_GATEKEEPER, Common_Movement_ExclamationMark)
    waitmovement(0)
    switch (var(VAR_0x8008)) {
        case 26: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperToX26)
        case 27: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperToX27)
        case 28: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperToX28)
        default: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperToX29)
    }
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    setspeaker(ThyrsaCity_Name_Gatekeeper)
    msgbox(format("Seven gates, stranger, and you came in by the Elektran. Good choice.\p"
                  "It's the one with the bread smell. Thanks to that lot outside.\p"
                  "Asclepeion's by the spring, there. The Agora's under the awnings.\p"
                  "The theater's on the east hill. The god's temple is right at the top.\p"
                  "Thespis is our Hierophant. The Masked Player.\p"
                  "Though he's short of masks this week. Somebody robbed the skene.\p"
                  "Every mask in the place. Three nights ago. Right before the festival.\p"
                  "Play's going on anyway. Thyrsa doesn't cancel a Dionysia.\p"
                  "West gate's shut till it's over. By the god's order.\p"
                  "Everyone stays for the play. Even the people who'd rather not."))
    closemessage
    switch (var(VAR_0x8008)) {
        case 26: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperFromX26)
        case 27: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperFromX27)
        case 28: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperFromX28)
        default: applymovement(LOCALID_THYRSA_GATEKEEPER, ThyrsaCity_Movement_KeeperFromX29)
    }
    waitmovement(0)
    releaseall
}

movement ThyrsaCity_Movement_KeeperToX26 { walk_up * 2 walk_right * 3 walk_down }
movement ThyrsaCity_Movement_KeeperToX27 { walk_up * 2 walk_right * 4 walk_down }
movement ThyrsaCity_Movement_KeeperToX28 { walk_up * 2 walk_right * 5 walk_down }
movement ThyrsaCity_Movement_KeeperToX29 { walk_up * 2 walk_right * 6 walk_down }
movement ThyrsaCity_Movement_KeeperFromX26 { walk_up walk_left * 3 walk_down * 2 face_right }
movement ThyrsaCity_Movement_KeeperFromX27 { walk_up walk_left * 4 walk_down * 2 face_right }
movement ThyrsaCity_Movement_KeeperFromX28 { walk_up walk_left * 5 walk_down * 2 face_right }
movement ThyrsaCity_Movement_KeeperFromX29 { walk_up walk_left * 6 walk_down * 2 face_right }

script ThyrsaCity_EventScript_Gatekeeper {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Gatekeeper)
    if (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("Asclepeion's by the spring, there. The Agora's under the awnings.\p"
                      "The theater's on the east hill. The god's temple is right at the top."))
    } else {
        msgbox(format("Seven gates, stranger. Thyrsa uses three. Mind you pick one."))
    }
    release
}

// ---------------------------------------------------------------------------
// Beat 30: Manto on the Kadmeia's wall walk. The first time she talks, then the
// day's omen (SYSTEMS.md §6; Part 2).
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_Manto {
    lock
    setspeaker(ThyrsaCity_Name_Manto)
    if (!flag(FLAG_ICHOR_MET_MANTO)) {
        msgbox(format("Footsteps. Small ones. And a Pokémon walking proud beside them.\p"
                      "Come here, child. I'm blind. I'm not rude.\p"
                      "My great-great-grandfather was Teiresias.\p"
                      "Blind as a stone, and saw everything.\p"
                      "I've been blind sixty years. Lately I'm blind in the other way too.\p"
                      "The birds still fly. I listen to them. They've started flying the wrong way."))
        closemessage
        faceplayer
        delay(60)
        setspeaker(ThyrsaCity_Name_Manto)
        msgbox(format("…Hm. You're there. I can hear you breathing.\p"
                      "But when I listen for what comes after you, there's nothing.\p"
                      "Like a doorway with no room behind it.\p"
                      "Don't fret. Most days I can't hear what comes after my own breakfast."))
        setflag(FLAG_ICHOR_MET_MANTO)
    }
    faceplayer
    call(ThyrsaCity_EventScript_MantoOmen)
    release
}

// ICHOR_STUB_OMENS: the engine's omens (IchorSave's omenKind and omenEntry, SYSTEMS.md
// §6) aren't wired yet. Manto picks from the entries progress allows: the rare
// visitor once the Dionysia is over and until it has been met, otherwise the swarm
// or the fog. Only the visitor has an effect here (the Thyrsivy in the old
// trellises); the swarm on Route 6 and the fog on Kithairon wait for the engine.
script ThyrsaCity_EventScript_MantoOmen {
    setspeaker(ThyrsaCity_Name_Manto)
    msgbox(format("Sit. I'll tell you what the birds told me. They talk too much."))
    setspeaker(ThyrsaCity_Name_Manto)
    if (flag(FLAG_ICHOR_DIONYSIA_DONE) && (!flag(FLAG_ICHOR_OMEN_THYRSIVY_TOLD) || !flag(FLAG_ICHOR_HIDE_OMEN_THYRSIVY))) {
        msgbox(format("Today: The swallows wouldn't land in the old vines today.\p"
                      "Something's standing in them that isn't a vine."))
        setflag(FLAG_ICHOR_OMEN_THYRSIVY_TOLD)
        clearflag(FLAG_ICHOR_HIDE_OMEN_THYRSIVY)
    } else {
        random(2)
        if (var(VAR_RESULT) == 0) {
            msgbox(format("Today: The crows went low over the vine terraces on the mountain road.\p"
                          "Something's crawling in the vines."))
        } else {
            msgbox(format("Today: Fog on Kithairon. The ones with webs like it."))
        }
    }
    setspeaker(ThyrsaCity_Name_Manto)
    msgbox(format("That's all. The birds don't do detail. Neither do I."))
}

// ---------------------------------------------------------------------------
// Beat 30: Alethea kneels by Semele's chamber with a trowel, until she goes west.
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Alethea)
    msgbox(format("Semele's chamber. Zeus came to her as lightning. She didn't survive it.\p"
                  "The baby did. That was Dionysus. And the room's been smoking ever since.\p"
                  "Truthfully, it's probably a hot spring. Don't tell the priests I said so."))
    // ICHOR_STUB_DIG: prophecy tablet #3 is a fixed dig under Eudora's fig (the rooms
    // agent's map). flags.h names its flags in FLAG_ICHOR_PROPHECY_START's range.
    if (flag(FLAG_ICHOR_PROPHECY_3) && !flag(FLAG_ICHOR_PROPHECY_3_READ)) {
        call(ThyrsaCity_EventScript_TabletThree)
    }
    release
}

script ThyrsaCity_EventScript_TabletThree {
    setspeaker(ThyrsaCity_Name_Alethea)
    msgbox(format("A lead tablet. People scratch their questions on these, for the Oracle.\p"
                  "“Hippias, son of Eudora, soldier of Thyrsa. Will I come home?”\p"
                  "And the answer, over it: “You'll die in the next war.”\p"
                  "…Tilt it to the light. See the scratches underneath?\p"
                  "Someone scraped the first answer off and wrote a new one. Neatly.\p"
                  "The old one says: “You'll come home from the next war.”\p"
                  "And at the end of the new one, a little hook.\p"
                  "Another one for my list. Truthfully, I'm not enjoying this list."))
    setflag(FLAG_ICHOR_PROPHECY_3_READ)
}

// ---------------------------------------------------------------------------
// The Neistan Gate (Part 2): shut for the festival, then a drum in the arch, then
// the Girdle's first use; and beat 34's last scene, Alethea going west.
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_NeistanGuard {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Guard)
    if (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("Gate's shut for the festival. By the god's order.\p"
                      "Everyone stays for the play. Even the people who'd rather not.\p"
                      "Especially them. They need it most."))
    } elif (!flag(FLAG_ICHOR_NEISTAN_DRUM_MOVED)) {
        msgbox(format("The god's cart caught the gate column last night. Brought a drum down.\p"
                      "Six men couldn't shift it. We'd need Herakles. Or his belt.\p"
                      "Silenos has his belt, they say. In the skene. He'd never part with it.\p"
                      "Win it off him, and the gate's yours."))
    } else {
        msgbox(format("Gate's open. Off you go, west. Kopais, Lebadeia, the gulf."))
    }
    release
}

// The drum is the engine's column drum (ENGINE_API §2): its object runs
// EventScript_StrengthBoulder, which braces the Girdle of Herakles, and then the
// player pushes it west out of (9,24). Stepping into the cell it filled is the push
// that frees the gate (coord event at (9,24), VAR_TEMP_4 == 0): the drum, rolling now,
// goes on out of the arch and onto the verge, and the scene plays.
script ThyrsaCity_EventScript_DrumPushed {
    lockall
    setvar(VAR_TEMP_4, 1)
    playse(SE_M_STRENGTH)
    applymovement(LOCALID_THYRSA_NEISTAN_DRUM, ThyrsaCity_Movement_DrumRolls)
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaCity_Movement_PlayerStepsBack)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    waitmovement(LOCALID_THYRSA_NEISTAN_DRUM)
    waitse
    setflag(FLAG_ICHOR_NEISTAN_DRUM_MOVED)
    setflag(FLAG_ICHOR_HIDE_NEISTAN_DRUM)
    applymovement(LOCALID_THYRSA_NEISTAN_GUARD_B, Common_Movement_FaceUp)
    waitmovement(0)
    setspeaker(ThyrsaCity_Name_Guard)
    msgbox(format("…Six men. Six! And a child in a big belt.\p"
                  "Gate's open. Off you go, west. Kopais, Lebadeia, the gulf.\p"
                  "Funny play, in the end. I laughed. I think I laughed.\p"
                  "I don't remember the middle."))
    closemessage
    if (!flag(FLAG_ICHOR_ALETHEA_WENT_WEST)) {
        call(ThyrsaCity_EventScript_AletheaGoesWest)
    }
    releaseall
}

// From (8,24), where the push left it: out of the arch and up onto the verge.
movement ThyrsaCity_Movement_DrumRolls { walk_slow_left walk_slow_up * 2 }
// The player steps back out of the arch to watch it go.
movement ThyrsaCity_Movement_PlayerStepsBack { delay_16 walk_right face_left }

// Beat 34: she runs up under the arch, once, and goes on ahead to Lebadeia.
script ThyrsaCity_EventScript_AletheaGoesWest {
    clearflag(FLAG_TEMP_12)
    addobject(LOCALID_THYRSA_ALETHEA_GATE)
    applymovement(LOCALID_THYRSA_ALETHEA_GATE, ThyrsaCity_Movement_AletheaRunsUp)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(ThyrsaCity_Name_Alethea)
    msgbox(format("You moved it! Six guards and a donkey couldn't. I watched.\p"
                  "The gate's open. The whole city's going home.\p"
                  "Nobody's talking about anything but the play.\p"
                  "I'm going on ahead. West.\p"
                  "There's a cave at Lebadeia I've wanted to see since I was six.\p"
                  "People go down into it and come up knowing things. Supposedly.\p"
                  "Meet me there. I'll be the one covered in mud.\p"
                  "And {PLAYER}. Whatever that play said, you're not cursed.\p"
                  "You're just unusual. Truthfully, so am I."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaCity_Movement_PlayerStepsAside)
    waitmovement(0)
    applymovement(LOCALID_THYRSA_ALETHEA_GATE, ThyrsaCity_Movement_AletheaGoesWest)
    waitmovement(0)
    removeobject(LOCALID_THYRSA_ALETHEA_GATE)
    setflag(FLAG_TEMP_12)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_THYRSA)
    setflag(FLAG_ICHOR_ALETHEA_WENT_WEST)
}

// Her object at the gate exists only during the scene; talking to it can't happen,
// but it gets her line all the same.
script ThyrsaCity_EventScript_AletheaGate {
    setspeaker(ThyrsaCity_Name_Alethea)
    msgbox(format("Meet me there. I'll be the one covered in mud."), MSGBOX_NPC)
}

// From (16,24) up the lane to the player at (10,24); then through the arch and away.
movement ThyrsaCity_Movement_AletheaRunsUp { walk_fast_left * 5 }
movement ThyrsaCity_Movement_PlayerStepsAside { walk_up face_down }
movement ThyrsaCity_Movement_AletheaGoesWest { walk_left * 9 }

// ---------------------------------------------------------------------------
// The Proitid Gate (east): the Euripus road is region E1's, batch 7. Its guard
// sits in the arch, so the gate is shut for now.
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_ProitidGuard {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Guard)
    msgbox(format("The Euripus road. The bridge to Euboia's at the end of it.\p"
                  "The Euripus bridge. It only opens when the current turns."))
    release
}

// ---------------------------------------------------------------------------
// The theater's high gate (beat 32's setup): before the laurel the keeper turns
// the player away; with it, the Dionysia begins inside.
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_TheaterKeeperStop {
    lockall
    applymovement(LOCALID_THYRSA_THEATER_KEEPER, Common_Movement_FaceLeft)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(ThyrsaCity_Name_Keeper)
    msgbox(format("Seats open for the play, and not before. Win your laurel.\p"
                  "The Masked Player likes his audience educated."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, ThyrsaCity_Movement_StepBackLeft)
    waitmovement(0)
    releaseall
}

movement ThyrsaCity_Movement_StepBackLeft { walk_left face_right }

script ThyrsaCity_EventScript_TheaterKeeper {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Keeper)
    if (!flag(FLAG_BADGE04_GET)) {
        msgbox(format("Seats open for the play, and not before. Win your laurel.\p"
                      "The Masked Player likes his audience educated."))
    } elif (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("A laurel! Go on up. Laurel-holders sit at the front."))
    } else {
        msgbox(format("Seventeen thousand seats, and every one of them empty again."))
    }
    release
}

// ---------------------------------------------------------------------------
// The square and the streets
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_Herald {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Herald)
    msgbox(format("The Dionysia! Tonight! A new tragedy! Seats are free, the god pays!\p"
                  "Laurel-holders sit at the front. The Masked Player's rule."))
    release
}

script ThyrsaCity_EventScript_Kronist {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Kronist)
    msgbox(format("Free bread at the gate, friends! The Kronia never closes!\p"
                  "Have you heard? The seers can't read past a certain day.\p"
                  "Every seer in Thyrsa. Ask them. Ask the blind woman on the wall.\p"
                  "They won't tell you why. We will. Come down to the feast."))
    release
}

// The blind beggar by the fountain house: a theoxenia decoy (SYSTEMS.md §10). His flag
// is in the engine's theoxenia block, decoys +0x20-0x27 (ENGINE_API §1): +0x21 is his.
// Kindness to a stranger is Zeus Xenios's: +1 Favor.
script ThyrsaCity_EventScript_Beggar {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Beggar)
    if (flag(FLAG_ICHOR_THEOXENIA_START + 0x21)) {
        msgbox(format("I can hear the spring. Sweetest sound in Thyrsa."))
        release
        end
    }
    message(format("The spring of Dirke, child? Which way? I've lost the wall."))
    waitmessage
    dynmultichoice(15, 4, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, ThyrsaCity_Text_ByTheAsclepeion,
                   ThyrsaCity_Text_ByTheTheater, ThyrsaCity_Text_UpTheKadmeia)
    setspeaker(ThyrsaCity_Name_Beggar)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("Ah. I can hear it now. Thank you. Here, a berry. All I've got."))
        giveitem(ITEM_PECHA_BERRY)
        if (var(VAR_RESULT) == FALSE) {
            call(Common_EventScript_ShowBagIsFull)
            release
            end
        }
        setvar(VAR_0x8004, ICHOR_GOD_ZEUS)
        setvar(VAR_0x8005, 1)
        special(Ichor_AddFavor)
        setflag(FLAG_ICHOR_THEOXENIA_START + 0x21)
    } else {
        msgbox(format("…That's not water I hear. That's an actor. Never mind, I'll ask again."))
    }
    release
}

text ThyrsaCity_Text_ByTheAsclepeion { "BY THE ASCLEPEION" }
text ThyrsaCity_Text_ByTheTheater { "BY THE THEATER" }
text ThyrsaCity_Text_UpTheKadmeia { "UP THE KADMEIA" }

script ThyrsaCity_EventScript_CitizenMasks {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Citizen)
    if (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("Someone stole Thespis's masks. All of them. Who steals masks?\p"
                      "Someone who wants a different face, my grandmother says."))
    } else {
        msgbox(format("That play. I keep thinking about it. The child with nothing in its hands.\p"
                      "My neighbor says the Titans paid for it. My neighbor says a lot of things."))
    }
    release
}

script ThyrsaCity_EventScript_CitizenSeer {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_Citizen)
    if (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("My seer can't read my thread past the spring. Nor my wife's.\p"
                      "She says it's her eyes. She's been saying that a lot."))
    } else {
        msgbox(format("I've never laughed like that. At a satyr. In the middle of a tragedy.\p"
                      "My cheeks still hurt. My wife says I cried first. I don't remember."))
    }
    release
}

script ThyrsaCity_EventScript_CitizenKadmos {
    setspeaker(ThyrsaCity_Name_Citizen)
    msgbox(format("Kadmos founded this city where a cow lay down. True story.\p"
                  "Then he killed a dragon, sowed its teeth, and armed men grew. Less true."),
           MSGBOX_NPC)
}

script ThyrsaCity_EventScript_CitizenIvy {
    setspeaker(ThyrsaCity_Name_Citizen)
    msgbox(format("Ivy's the god's plant. It grows on anything. It never lets go.\p"
                  "My husband says that's why I married him. I don't know what he means."),
           MSGBOX_NPC)
}

script ThyrsaCity_EventScript_CitizenCushion {
    setspeaker(ThyrsaCity_Name_Citizen)
    msgbox(format("Laurel-holders sit at the front. I've no laurel.\pI've a cushion."), MSGBOX_NPC)
}

script ThyrsaCity_EventScript_Child {
    setspeaker(ThyrsaCity_Name_Child)
    msgbox(format("We're maenads! Euoi!"), MSGBOX_NPC)
}

script ThyrsaCity_EventScript_Child2 {
    setspeaker(ThyrsaCity_Name_Child)
    msgbox(format("Mother says we can be maenads till dinner. Then we're children again."), MSGBOX_NPC)
}

// ---------------------------------------------------------------------------
// Trainers (Part 3)
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_Oinopion {
    trainerbattle_single(TRAINER_ICHOR_OINOPION, ThyrsaCity_Text_OinopionIntro, ThyrsaCity_Text_OinopionDefeat)
    setspeaker(ThyrsaCity_Name_Oinopion)
    msgbox(format("The god planted these vines when he was a boy.\p"
                  "They don't look a day over three hundred."), MSGBOX_AUTOCLOSE)
}

text ThyrsaCity_Text_OinopionIntro {
    format("My father was the god himself, my mother says. She says it about everyone.")
}

text ThyrsaCity_Text_OinopionDefeat {
    format("Crushed, and not even for wine.")
}

script ThyrsaCity_EventScript_Lenaia {
    trainerbattle_single(TRAINER_ICHOR_LENAIA, ThyrsaCity_Text_LenaiaIntro, ThyrsaCity_Text_LenaiaDefeat)
    setspeaker(ThyrsaCity_Name_Lenaia)
    msgbox(format("On the night of the play, every maenad in Thyrsa sits still. Just that one night."),
           MSGBOX_AUTOCLOSE)
}

text ThyrsaCity_Text_LenaiaIntro {
    format("City maenads dance in the vineyards. The mountain ones think we're soft.\pAre we?")
}

text ThyrsaCity_Text_LenaiaDefeat {
    format("…Soft.")
}

script ThyrsaCity_EventScript_Hegelochos {
    trainerbattle_single(TRAINER_ICHOR_HEGELOCHOS, ThyrsaCity_Text_HegelochosIntro, ThyrsaCity_Text_HegelochosDefeat)
    setspeaker(ThyrsaCity_Name_Hegelochos)
    msgbox(format("I said “weasel” instead of “calm” once. In a tragedy.\p"
                  "Thirty years ago. They still shout it at me."), MSGBOX_AUTOCLOSE)
}

text ThyrsaCity_Text_HegelochosIntro {
    format("“After the storm, I see a calm!” …My line. Battle me while I practice.")
}

text ThyrsaCity_Text_HegelochosDefeat {
    format("“After the storm, I see a weasel!” …No! Again!")
}

// ---------------------------------------------------------------------------
// The omen's visitor (Part 4): a Thyrsivy in the old trellises, Lv 28, once.
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_Thyrsivy {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_THYRSIVY, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_THYRSIVY, 28)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_RAN && var(VAR_RESULT) != B_OUTCOME_PLAYER_TELEPORTED
        && var(VAR_RESULT) != B_OUTCOME_LOST) {
        setflag(FLAG_ICHOR_HIDE_OMEN_THYRSIVY)
        removeobject(LOCALID_THYRSA_THYRSIVY)
    }
    release
}

// ---------------------------------------------------------------------------
// Signs and objects
// ---------------------------------------------------------------------------

script ThyrsaCity_EventScript_TownSign {
    msgbox(format("THYRSA CITY · THE GOD'S OWN CITY\p"
                  "North: the Kadmeia and the temple. East: the theater. West: the vineyards."),
           MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_KadmeiaSign {
    msgbox(format("THE KADMEIA. Kadmos's citadel. Semele's chamber. Watch your step: it smokes."),
           MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_TheaterSign {
    msgbox(format("THE THEATER OF DIONYSUS. Seventeen thousand seats. All of them free."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_NeistanSign {
    msgbox(format("West: Route 8, the Kopais shore, and Lebadeia."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_ProitidSign {
    msgbox(format("East: the Euripus, and the bridge to Euboia."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_SemeleChamber {
    msgbox(format("A roofless room wrapped in ivy. Smoke curls up from a crack in the floor.\p"
                  "They say Zeus came to her as lightning.\p"
                  "She was the only one who ever saw him as he is."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_SemeleCrack {
    msgbox(format("Warm air. Somewhere far down, something hums."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_BrickedGate {
    msgbox(format("A bricked-up gate. Thyrsa had seven. It uses three.\p"
                  "The others are for show. Or for armies. Or for poets, who need seven."),
           MSGBOX_SIGN)
}

// ICHOR_STUB_RELICS: Dionysus's Thyrsus (rite gift II) climbs the marked ivy to the
// wall-walk and the Big Nugget; until the rites land the ivy only describes itself.
script ThyrsaCity_EventScript_MarkedIvy {
    msgbox(format("Ivy, thick as a curtain, up the old terrace wall.\p"
                  "Someone has scratched a pinecone on a staff into the stone behind it."),
           MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_Dirke {
    msgbox(format("The spring of Dirke. The water is cold and very sweet."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_WinePress {
    msgbox(format("The old wine press. Its floor is stained purple to the rim."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_TempleFront {
    msgbox(format("The god's masks over the temple's doors. One laughs. One weeps."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_Statue {
    msgbox(format("The god in bronze, ivy in his hair, a thyrsus raised.\p"
                  "Somebody has tied a ribbon round his ankle for the festival."), MSGBOX_SIGN)
}

// The square's polish pass: the god's fountain, the tripods, the market, Eudora's gate.
script ThyrsaCity_EventScript_Fountain {
    msgbox(format("The god's fountain. Two bronze lions pour into the basin.\p"
                  "At the Dionysia, they say, it runs with wine. Today it's water. Mostly."),
           MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_Tripod {
    msgbox(format("A bronze tripod on a marble base: a prize for a play that won.\p"
                  "The base names the poet, the year and the chorus. The year is very old."),
           MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_YardGate {
    msgbox(format("A yard gate, barred from inside.\p"
                  "Over the wall: an old fig, and a red cloak on the washing line."), MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_WineSeller {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_WineSeller)
    if (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("New wine! Three days old! The god's own vintage!\p"
                      "Well. His neighbor's. The Agora sells it by the jar."))
    } else {
        msgbox(format("Sold out the night of the play. Every jar.\p"
                      "Nobody remembers drinking it. That's how you know it was good."))
    }
    release
}

script ThyrsaCity_EventScript_MaskSeller {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Name_MaskSeller)
    if (!flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        msgbox(format("Masks for the play! Wear one tonight and nobody can say it was you."))
    } else {
        msgbox(format("Half price. Since the play, nobody wants another face."))
    }
    release
}

script ThyrsaCity_EventScript_Grave {
    msgbox(format("An old grave by the road. Thyrsa buries its dead outside the gates."),
           MSGBOX_SIGN)
}

script ThyrsaCity_EventScript_Herm {
    msgbox(format("A herm of Hermes by the road.\pNorth: Thyrsa City. South: the Kronia grounds."),
           MSGBOX_SIGN)
}

// Thyrsa's two daily dig spots (Part 6: beside Semele's chamber and at the vineyards'
// edge), on Act II's table: the Persephone amphora's sherds. ICHOR_STUB_DIG: excavation
// isn't built (ENGINE_API §8) and the daily spot indices are the engine session's to
// give, so each goes to Act II's stand-in, which reads as §8 does without the Trowel.
// When it lands: setvar(VAR_0x8004, <spot>), setvar(VAR_0x8005, ICHOR_DIG_ACT_II),
// goto(EventScript_IchorDigSpot).
script ThyrsaCity_EventScript_DigSemele {
    goto(EventScript_IchorAct2_DigStub)
}

script ThyrsaCity_EventScript_DigVineyard {
    goto(EventScript_IchorAct2_DigStub)
}

// ---------------------------------------------------------------------------
// Manto's crows (SCRIPT.md Part 2, Manto's house): at the Elektran Gate in the
// evening or at night, the flock wheels over the Kronia and flies south.

script ThyrsaCity_EventScript_Crows {
    gettimeofday
    if (var(VAR_0x8000) < TIME_EVENING) {
        end
    }
    lockall
    setvar(VAR_TEMP_3, 1)
    clearflag(FLAG_TEMP_13)
    addobject(LOCALID_THYRSA_CROWS)
    applymovement(LOCALID_THYRSA_CROWS, ThyrsaCity_Movement_CrowsCircle)
    waitmovement(LOCALID_THYRSA_CROWS)
    msgbox(format("The crows circle the feast once, then fly south. Away from the city, against the wind."))
    applymovement(LOCALID_THYRSA_CROWS, ThyrsaCity_Movement_CrowsSouth)
    waitmovement(LOCALID_THYRSA_CROWS)
    removeobject(LOCALID_THYRSA_CROWS)
    setflag(FLAG_TEMP_13)
    setflag(FLAG_ICHOR_SAW_CROWS)
    releaseall
    end
}

movement ThyrsaCity_Movement_CrowsCircle {
    walk_fast_left * 2
    walk_fast_down
    walk_fast_right * 3
    walk_fast_up
    walk_fast_left
}

movement ThyrsaCity_Movement_CrowsSouth {
    walk_faster_down * 7
}
