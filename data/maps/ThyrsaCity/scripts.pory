text ThyrsaCity_Name_Beggar { "BEGGAR" }
text ThyrsaCity_Name_Citizen { "CITIZEN" }
text ThyrsaCity_Name_Child { "CHILD" }
text ThyrsaCity_Name_Oinopion { "OINOPION" }
text ThyrsaCity_Name_Lenaia { "LENAIA" }
