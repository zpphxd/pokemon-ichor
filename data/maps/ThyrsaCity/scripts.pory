text ThyrsaCity_Name_Manto { "MANTO" }
text ThyrsaCity_Name_Alethea { "ALETHEA" }
text ThyrsaCity_Name_Kronist { "KRONIST" }
text ThyrsaCity_Name_Herald { "HERALD" }
text ThyrsaCity_Name_Guard { "GUARD" }
