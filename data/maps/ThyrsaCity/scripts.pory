// Thyrsa City: the god's own city. SCRIPT.md beat 30 (the gatekeeper, Manto on the
// Kadmeia wall, Alethea at Semele's chamber), Part 2's Thyrsa City roster (the
// Neistan Gate in its three states, the Proitid Gate, the herald, the Kronist, the
// blind beggar, citizens, children, the signs and objects), Part 3's trainers, Part
// 4's omen visitor, Part 6's items, and beat 34's last scene, Alethea going west.
// Layout and events are generated by tools/ichor/maps/thyrsa.py.
//
// Scene state:
//   VAR_TEMP_1 == 0  the gatekeeper's welcome waits inside the Elektran Gate
//   VAR_TEMP_2 == 0  the theater keeper turns you back at the high gate (no laurel)
//   FLAG_TEMP_11     hides the guard who stands aside once the drum has fallen
//   FLAG_TEMP_12     hides Alethea at the Neistan Gate until her scene
//   VAR_TEMP_3 == 0  Manto's crows wait over the road outside the Elektran Gate
//   FLAG_TEMP_13     hides the crows until their scene
//   VAR_TEMP_4 == 0  the drum still fills the Neistan Gate: stepping into its cell
//                    (9,24), once it has been pushed, plays the gate's opening

mapscripts ThyrsaCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_ICHOR_VISITED_THYRSA)
        if (flag(FLAG_ICHOR_ARRIVED_THYRSA)) {
            setvar(VAR_TEMP_1, 1)
        }
        if (flag(FLAG_BADGE04_GET)) {
            setvar(VAR_TEMP_2, 1)
        }
        // The Neistan Gate: two guards across it for the festival; after the
        // Dionysia a drum in the arch and the guards beside it; then open.
        if (flag(FLAG_ICHOR_DIONYSIA_DONE)) {
            setflag(FLAG_ICHOR_HIDE_NEISTAN_GUARDS)
        } else {
            setflag(FLAG_TEMP_11)
        }
        if (!flag(FLAG_ICHOR_DIONYSIA_DONE) || flag(FLAG_ICHOR_NEISTAN_DRUM_MOVED)) {
            setflag(FLAG_ICHOR_HIDE_NEISTAN_DRUM)
            setvar(VAR_TEMP_4, 1)
        } else {
            clearflag(FLAG_ICHOR_HIDE_NEISTAN_DRUM)
        }
        setflag(FLAG_TEMP_12)
        // Manto's crows (her house's quest): only while she's waiting to hear of them.
        setflag(FLAG_TEMP_13)
        if (!flag(FLAG_ICHOR_MANTO_CROWS) || flag(FLAG_ICHOR_SAW_CROWS)) {
            setvar(VAR_TEMP_3, 1)
        }
        // The omen's visitor stands in the old trellises only once Manto has told it.
        if (!flag(FLAG_ICHOR_OMEN_THYRSIVY_TOLD)) {
            setflag(FLAG_ICHOR_HIDE_OMEN_THYRSIVY)
        }
    }
}

