// Ring VI, the Forge (design/LABYRINTH.md §6 Ring VI, Scenes G and H; LABYRINTH_MAZE.md;
// design/phase4/SCRIPT.md beat III-3K; design/maps/LabyrinthRing6.md).
// Layout and events: tools/ichor/maps/labyrinth_heart.py (48 x 48, mychos, firelit).
//
// Team Titan's headquarters, built into the rock where the house's stream falls on
// the old magma. Down the stair from Ring V: a landing, the teaching antechamber (one
// dial, one wall, one bronze sentry on a beat you can watch), then the Hall of Dials,
// a built maze with three dials on its north wall. The dials swing bronze bars across
// three corridors: west to the forge cavern (B A B), east to the archive (A B A, the
// clerks' setting the Titans leave it at), north-east to the vault (B B A, Page VI).
// The barracks south of the hall hold the alarm's runners; below them the landing,
// sealed in Titan wax until Hyperion falls, keeps the Mistress's shrine and the stair
// down to Ring VII. Three cave mazes never meet: the north-west caves off the
// antechamber, the forge's back caves behind Mimas, and the east caves (the barracks'
// side door, the archive's back grate, and the sinkhole from Ring V).
//
// Warps: 0-1 up to Ring V, 2-3 down to Ring VII, 4 the rope up to Ring V's grotto.
// Wheels: VAR_ICHOR_LABYRINTH bits 0-2 are W1-W3 (0 = A, 1 = B), bit 3 the teaching dial.

mapscripts LabyrinthRing6_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_ICHOR_FOLLOWERS_DISABLED)
        setvar(VAR_TEMP_1, 0)
        // the clerks' setting, the first time: wheel two at B, so the archive stands open
        if (!flag(FLAG_ICHOR_RING6_DIALS_SET)) {
            setflag(FLAG_ICHOR_RING6_DIALS_SET)
            call(LabyrinthRing6_EventScript_ClerksSetting)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        // ---- BEGIN GENERATED by tools/ichor/maps/labyrinth_heart.py: do not edit ----
    setvar(VAR_0x8004, 0x240)
    setvar(VAR_0x8005, 0x241)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x24B)
    setvar(VAR_0x8005, 0x24C)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x258)
    setvar(VAR_0x8005, 0x259)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x288)
    setvar(VAR_0x8005, 0x289)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 23)
    setvar(VAR_0x8005, 4)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING6_LANDING)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 25)
    setvar(VAR_0x8005, 23)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING6_DIALS)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 7)
    setvar(VAR_0x8005, 21)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING6_FORGE)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 24)
    setvar(VAR_0x8005, 41)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING6_SHRINE)
    special(Ichor_AddThreadAnchor)
    call(LabyrinthRing6_EventScript_OnLoadExtra)
    if (var(VAR_ICHOR_KNOSSA) == 17) {
        call(LabyrinthRing6_EventScript_TurningWalls)
    } else {
        setvar(VAR_TEMP_D, 1)
    }
    special(Ichor_DrawThread)
    // ---- END GENERATED ----
    }
}

text LabyrinthRing6_Text_NameHyperion { "HYPERION" }
text LabyrinthRing6_Text_NamePriestess { "PRIESTESS" }
text LabyrinthRing6_Text_NameAriadne { "ARIADNE" }

script LabyrinthRing6_EventScript_OnLoadExtra {
    call(LabyrinthRing6_EventScript_DrawBars)
    call(LabyrinthRing6_EventScript_DrawTeachWall)
    if (flag(FLAG_ICHOR_RING6_LANDING_OPEN)) {
        setmetatile(23, 32, METATILE_Mychos_SlabR, FALSE)
        setmetatile(24, 32, METATILE_Mychos_SlabL, FALSE)
    }
    if (flag(FLAG_ICHOR_RING6_ARCHIVE_BACK)) {
        setmetatile(42, 24, METATILE_Mychos_CaveFloor, FALSE)
    }
}

// ---------------------------------------------------------------------------
// Daedalus's dials (LABYRINTH §5.5)
// ---------------------------------------------------------------------------

// The wheels' positions into VAR_TEMP_5 (W1), VAR_TEMP_6 (W2), VAR_TEMP_7 (W3) and
// VAR_TEMP_4 (the teaching dial), 0 for A and 1 for B: turning a copy of the var reads
// a bit (Ichor_TurnDial answers the flipped position, so the bit was the other one).
script LabyrinthRing6_EventScript_ReadDials {
    copyvar(VAR_0x8004, VAR_ICHOR_LABYRINTH)
    setvar(VAR_0x8005, 0)
    special(Ichor_TurnDial)
    call(LabyrinthRing6_EventScript_FlipResult)
    copyvar(VAR_TEMP_5, VAR_RESULT)
    copyvar(VAR_0x8004, VAR_ICHOR_LABYRINTH)
    setvar(VAR_0x8005, 1)
    special(Ichor_TurnDial)
    call(LabyrinthRing6_EventScript_FlipResult)
    copyvar(VAR_TEMP_6, VAR_RESULT)
    copyvar(VAR_0x8004, VAR_ICHOR_LABYRINTH)
    setvar(VAR_0x8005, 2)
    special(Ichor_TurnDial)
    call(LabyrinthRing6_EventScript_FlipResult)
    copyvar(VAR_TEMP_7, VAR_RESULT)
    copyvar(VAR_0x8004, VAR_ICHOR_LABYRINTH)
    setvar(VAR_0x8005, 3)
    special(Ichor_TurnDial)
    call(LabyrinthRing6_EventScript_FlipResult)
    copyvar(VAR_TEMP_4, VAR_RESULT)
}

script LabyrinthRing6_EventScript_FlipResult {
    if (var(VAR_RESULT) == 0) {
        setvar(VAR_RESULT, 1)
    } else {
        setvar(VAR_RESULT, 0)
    }
}

script LabyrinthRing6_EventScript_ClerksSetting {
    // A B A: wheel one A, wheel two B, wheel three A
    setvar(VAR_0x8005, 0)
    setvar(VAR_0x8006, 0)
    call(LabyrinthRing6_EventScript_SetWheelTo)
    setvar(VAR_0x8005, 1)
    setvar(VAR_0x8006, 1)
    call(LabyrinthRing6_EventScript_SetWheelTo)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, 0)
    call(LabyrinthRing6_EventScript_SetWheelTo)
}

// Puts wheel VAR_0x8005 at VAR_0x8006, whichever way it stood.
script LabyrinthRing6_EventScript_SetWheelTo {
    copyvar(VAR_0x8004, VAR_ICHOR_LABYRINTH)
    special(Ichor_TurnDial)
    // VAR_RESULT is the flipped position; keep the flip only if it's the one we want
    if (var(VAR_0x8006) == 0) {
        if (var(VAR_RESULT) == 0) {
            copyvar(VAR_ICHOR_LABYRINTH, VAR_0x8004)
        }
    } else {
        if (var(VAR_RESULT) == 1) {
            copyvar(VAR_ICHOR_LABYRINTH, VAR_0x8004)
        }
    }
}

script LabyrinthRing6_EventScript_TurnWheel {
    // VAR_0x8005: the wheel's bit
    copyvar(VAR_0x8004, VAR_ICHOR_LABYRINTH)
    call(EventScript_IchorDial)
    copyvar(VAR_ICHOR_LABYRINTH, VAR_0x8004)
    if (var(VAR_RESULT) != 0xFF) {
        call(LabyrinthRing6_EventScript_DrawBars)
        call(LabyrinthRing6_EventScript_DrawTeachWall)
        special(DrawWholeMapView)
    }
    releaseall
}

script LabyrinthRing6_EventScript_Dial1 {
    setvar(VAR_0x8005, 0)
    goto(LabyrinthRing6_EventScript_TurnWheel)
}

script LabyrinthRing6_EventScript_Dial2 {
    setvar(VAR_0x8005, 1)
    goto(LabyrinthRing6_EventScript_TurnWheel)
}

script LabyrinthRing6_EventScript_Dial3 {
    setvar(VAR_0x8005, 2)
    goto(LabyrinthRing6_EventScript_TurnWheel)
}

script LabyrinthRing6_EventScript_TeachDial {
    setvar(VAR_0x8005, 3)
    goto(LabyrinthRing6_EventScript_TurnWheel)
}

script LabyrinthRing6_EventScript_DrawTeachWall {
    call(LabyrinthRing6_EventScript_ReadDials)
    if (var(VAR_TEMP_4) == 1) {
        setmetatile(23, 11, METATILE_Mychos_SlabL, FALSE)
        setmetatile(24, 11, METATILE_Mychos_SlabR, FALSE)
    } else {
        setmetatile(23, 11, METATILE_Mychos_DialFaceSeg, TRUE)
        setmetatile(24, 11, METATILE_Mychos_DialFaceSeg, TRUE)
    }
}

script LabyrinthRing6_EventScript_Lever {
    lockall
    msgbox(format("A bronze lever, stamped: RESET. CLERKS' SETTING.\nPull it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        call(LabyrinthRing6_EventScript_ClerksSetting)
        playse(SE_M_STRENGTH)
        call(LabyrinthRing6_EventScript_DrawBars)
        special(DrawWholeMapView)
        msgbox(format("Somewhere, three bars of bronze swing home."))
    }
    releaseall
}

// ---- BEGIN GENERATED BARS ----
script LabyrinthRing6_EventScript_DrawBars {
    call(LabyrinthRing6_EventScript_ReadDials)
    // the forge corridor
    if (var(VAR_TEMP_5) == 1) {
        setmetatile(12, 18, METATILE_Mychos_SlabL, FALSE)
    } else {
        setmetatile(12, 18, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    if (var(VAR_TEMP_6) == 0) {
        setmetatile(11, 18, METATILE_Mychos_SlabR, FALSE)
    } else {
        setmetatile(11, 18, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    if (var(VAR_TEMP_7) == 1) {
        setmetatile(10, 18, METATILE_Mychos_SlabL, FALSE)
    } else {
        setmetatile(10, 18, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    // the archive corridor
    if (var(VAR_TEMP_5) == 0) {
        setmetatile(35, 18, METATILE_Mychos_SlabR, FALSE)
    } else {
        setmetatile(35, 18, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    if (var(VAR_TEMP_6) == 1) {
        setmetatile(36, 18, METATILE_Mychos_SlabL, FALSE)
    } else {
        setmetatile(36, 18, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    if (var(VAR_TEMP_7) == 0) {
        setmetatile(37, 18, METATILE_Mychos_SlabR, FALSE)
    } else {
        setmetatile(37, 18, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    // the vault corridor
    if (var(VAR_TEMP_5) == 1) {
        setmetatile(34, 13, METATILE_Mychos_SlabR, FALSE)
    } else {
        setmetatile(34, 13, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    if (var(VAR_TEMP_6) == 1) {
        setmetatile(35, 13, METATILE_Mychos_SlabL, FALSE)
    } else {
        setmetatile(35, 13, METATILE_Mychos_DialFaceSeg, TRUE)
    }
    if (var(VAR_TEMP_7) == 0) {
        setmetatile(36, 13, METATILE_Mychos_SlabR, FALSE)
    } else {
        setmetatile(36, 13, METATILE_Mychos_DialFaceSeg, TRUE)
    }
}
// ---- END GENERATED BARS ----

// ---------------------------------------------------------------------------
// Things to read
// ---------------------------------------------------------------------------

script LabyrinthRing6_EventScript_Notice {
    msgbox(format("A slate on a nail:\p"
                  "CLERKS. Leave the wheels at the clerks' setting.\n"
                  "Wheel one up, wheel two down, wheel three up.\p"
                  "The archive only. The forge is the Hand's business. -I."), MSGBOX_SIGN)
}

script LabyrinthRing6_EventScript_Ledger {
    lockall
    if (!flag(FLAG_ICHOR_ARCHIVE_TABLET)) {
        call(LabyrinthRing6_EventScript_SceneHBody)
    }
    msgbox(format("A day-ledger lies open by the desk.\p"
                  "FORGE: down, up, down. Sign the Hand's book.\n"
                  "VAULT: by order only."))
    releaseall
}

script LabyrinthRing6_EventScript_Fresco {
    msgbox(format("Dancers on a blue ground, three of them, each holding a painted sign.\p"
                  "A rosette. A wave. A star, held up high.\p"
                  "The last one isn't dancing. She's arrived."), MSGBOX_SIGN)
}

script LabyrinthRing6_EventScript_Furnace {
    msgbox(format("The furnace roars in its wall. The heat makes your eyes water.\p"
                  "Three moulds stand empty by the anvil, each the shape of a jagged blade."), MSGBOX_SIGN)
}

script LabyrinthRing6_EventScript_Seal {
    lockall
    if (flag(FLAG_ICHOR_RING6_LANDING_OPEN)) {
        releaseall
        end
    }
    msgbox(format("A door sealed with a slab of Titan wax, pressed with a little hook.\p"
                  "BY ORDER. NONE BELOW TILL THE HAND SAYS."))
    releaseall
}

script LabyrinthRing6_EventScript_ArchiveGrate {
    lockall
    if (flag(FLAG_ICHOR_RING6_ARCHIVE_BACK)) {
        releaseall
        end
    }
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    if (var(VAR_TEMP_3) < 24) {
        msgbox(format("A bronze grate at the archive's back, barred on this side.\pYou lift the bar."))
        playse(SE_UNLOCK)
        setmetatile(42, 24, METATILE_Mychos_CaveFloor, FALSE)
        special(DrawWholeMapView)
        setflag(FLAG_ICHOR_RING6_ARCHIVE_BACK)
    } else {
        msgbox(format("A bronze grate. Shelves beyond it, and lamplight. It's barred from inside."))
    }
    releaseall
}

// The vault's chests (LABYRINTH §6: gold, a comet shard, a rare stone, a revive)
script LabyrinthRing6_EventScript_Chest1 {
    lockall
    if (!flag(FLAG_ICHOR_RING6_VAULT_1)) {
        setflag(FLAG_ICHOR_RING6_VAULT_1)
        msgbox(format("A Titan strongbox, its lid prised off."))
        giveitem(ITEM_BIG_NUGGET, 1)
    } else {
        msgbox(format("An empty strongbox."))
    }
    releaseall
}

script LabyrinthRing6_EventScript_Chest2 {
    lockall
    if (!flag(FLAG_ICHOR_RING6_VAULT_2)) {
        setflag(FLAG_ICHOR_RING6_VAULT_2)
        msgbox(format("A cedar chest, packed in straw."))
        giveitem(ITEM_COMET_SHARD, 1)
    } else {
        msgbox(format("An empty chest, and straw."))
    }
    releaseall
}

script LabyrinthRing6_EventScript_Chest3 {
    lockall
    if (!flag(FLAG_ICHOR_RING6_VAULT_3)) {
        setflag(FLAG_ICHOR_RING6_VAULT_3)
        msgbox(format("A small chest with a Minoan lock. It isn't locked."))
        giveitem(ITEM_MAX_REVIVE, 1)
    } else {
        msgbox(format("An empty chest."))
    }
    releaseall
}

script LabyrinthRing6_EventScript_Chest4 {
    lockall
    if (!flag(FLAG_ICHOR_RING6_VAULT_4)) {
        setflag(FLAG_ICHOR_RING6_VAULT_4)
        msgbox(format("Gold, stacked like bread. Someone has counted it twice."))
        giveitem(ITEM_BIG_NUGGET, 2)
    } else {
        msgbox(format("Someone else's gold, all gone."))
    }
    releaseall
}

// ---------------------------------------------------------------------------
// The bronze sentries and the alarm (LABYRINTH §6 Ring VI)
// ---------------------------------------------------------------------------

// A sentry that sees you rings; the next of the barracks' four comes running.
// After the fourth, "Nobody's left to answer the bell."
script LabyrinthRing6_EventScript_Alarm {
    playse(SE_M_HEAL_BELL)
    msgbox(format("BONNNG! The bronze sentry rings like a struck bell!"))
    if (!defeated(TRAINER_ICHOR_ANTHRAKOS)) {
        trainerbattle_no_intro(TRAINER_ICHOR_ANTHRAKOS, LabyrinthRing6_Text_AnthrakosDefeat)
    } elif (!defeated(TRAINER_ICHOR_PORINOS)) {
        trainerbattle_no_intro(TRAINER_ICHOR_PORINOS, LabyrinthRing6_Text_PorinosDefeat)
    } elif (!defeated(TRAINER_ICHOR_ARGILLOS)) {
        trainerbattle_no_intro(TRAINER_ICHOR_ARGILLOS, LabyrinthRing6_Text_ArgillosDefeat)
    } else {
        msgbox(format("The bell rings and rings. Nobody's left to answer it."))
    }
}

script LabyrinthRing6_EventScript_Sentry1 {
    lockall
    if (!defeated(TRAINER_ICHOR_ANTHRAKOS)) {
        msgbox(format("ANTHRAKOS: The bell rang! Somebody's- oh. You."))
    } elif (!defeated(TRAINER_ICHOR_PORINOS)) {
        msgbox(format("PORINOS: That bell again. I was eating."))
    } elif (!defeated(TRAINER_ICHOR_ARGILLOS)) {
        msgbox(format("ARGILLOS: Bell, bell, bell. I hear it in my sleep. Battle!"))
    }
    call(LabyrinthRing6_EventScript_Alarm)
    msgbox(format("The automaton's gears run down. It settles, humming, and is still."))
    setflag(FLAG_ICHOR_HIDE_SENTRY_1)
    removeobject(LOCALID_RING6_SENTRY_1)
    releaseall
}

