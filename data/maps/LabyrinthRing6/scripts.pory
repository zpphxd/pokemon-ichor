text LabyrinthRing6_Text_AnthrakosDefeat { format("ANTHRAKOS: Somebody else answer the next one.") }
text LabyrinthRing6_Text_PorinosDefeat { format("PORINOS: I was eating, and now I'm not, and I lost.") }
text LabyrinthRing6_Text_ArgillosDefeat { format("ARGILLOS: Ring it again and I'm not coming.") }

// ---------------------------------------------------------------------------
// The Gigas and the last of the barracks
// ---------------------------------------------------------------------------

script LabyrinthRing6_EventScript_Smyris {
    trainerbattle_single(TRAINER_ICHOR_SMYRIS, LabyrinthRing6_Text_SmyrisIntro, LabyrinthRing6_Text_SmyrisDefeat)
    msgbox(format("SMYRIS: That's everyone. Ring all you like now."), MSGBOX_AUTOCLOSE)
}

text LabyrinthRing6_Text_SmyrisIntro { format("SMYRIS: Last one in the barracks. They sent me. They always send me.") }
text LabyrinthRing6_Text_SmyrisDefeat { format("SMYRIS: That's everyone. Ring all you like now.") }

script LabyrinthRing6_EventScript_Mimas {
    if (!flag(FLAG_ICHOR_GOT_ELPIS_TABLET)) {
        lock
        faceplayer
        msgbox(format("MIMAS: Forge business needs the archive's stamp.\p"
                      "No stamp, no forge. The clerks keep the passes. East."))
        release
        end
    }
    trainerbattle_single(TRAINER_ICHOR_MIMAS, LabyrinthRing6_Text_MimasIntro, LabyrinthRing6_Text_MimasDefeat)
    msgbox(format("MIMAS: He'll roast you. Mostly not literally."), MSGBOX_AUTOCLOSE)
}

text LabyrinthRing6_Text_MimasIntro { format("MIMAS: The forge is the Hand's. Nobody walks into the Hand's forge.") }
text LabyrinthRing6_Text_MimasDefeat { format("MIMAS: …Nobody but you.") }

script LabyrinthRing6_EventScript_Alkyoneus {
    trainerbattle_single(TRAINER_ICHOR_ALKYONEUS, LabyrinthRing6_Text_AlkyoneusIntro, LabyrinthRing6_Text_AlkyoneusDefeat)
    msgbox(format("ALKYONEUS: The vault's that way. Don't tell the Voice I let you by."), MSGBOX_AUTOCLOSE)
}

text LabyrinthRing6_Text_AlkyoneusIntro { format("ALKYONEUS: Stand on my ground and you can't beat me. That's the rule.") }
text LabyrinthRing6_Text_AlkyoneusDefeat { format("ALKYONEUS: …You didn't stand on it. You moved me off it. Clever.") }

// ---------------------------------------------------------------------------
// Scene H: the archive, the forged prophecy (LABYRINTH §8 Scene H)
// ---------------------------------------------------------------------------

script LabyrinthRing6_EventScript_SceneH {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_ICHOR_ARCHIVE_TABLET)) {
        end
    }
    lockall
    call(LabyrinthRing6_EventScript_SceneHBody)
    releaseall
}

script LabyrinthRing6_EventScript_SceneHBody {
    msgbox(format("Shelves of wax tablets, each labelled in a neat hand."))
    msgbox(format("“KALLISTO OF ARKADIA. Revised.”\n“THE HARBOR-MASTER OF EMPORION. Revised.”"))
    msgbox(format("One tablet lies by itself, scraped and rewritten many times."))
    msgbox(format("“Kleon shall never lose.” That line is struck out."))
    msgbox(format("“Kleon shall win every…” Struck out."))
    msgbox(format("Then, in fresh wax: “Kleon of Lakonia shall slay the starry bull…"))
    msgbox(format("…beneath the house of the double axe, and his glory shall never die.”"))
    msgbox(format("In the margin: “Better. He'll run straight at it.”"))
    msgbox(format("A little hook for a signature."))
    giveitem(ITEM_KLEONS_DRAFT)
    setflag(FLAG_ICHOR_ARCHIVE_TABLET)
    msgbox(format("On the bottom shelf, one tablet is sealed shut with a blob of wax."))
    msgbox(format("“ELPIS, DAUGHTER OF PHAEDON. Revised.”"))
    msgbox(format("The seal is pressed with a little hook."))
    giveitem(ITEM_SEALED_TABLET)
    setflag(FLAG_ICHOR_GOT_ELPIS_TABLET)
    if (var(VAR_ICHOR_KNOSSA) < 13) {
        setvar(VAR_ICHOR_KNOSSA, 13)
    }
}

// ---------------------------------------------------------------------------
// Scene G: the forge, Hyperion (LABYRINTH §8 Scene G)
// ---------------------------------------------------------------------------

script LabyrinthRing6_EventScript_SceneG {
    setvar(VAR_TEMP_8, 1)
    if (defeated(TRAINER_ICHOR_HYPERION_KNOSSA)) {
        end
    }
    lockall
    call(LabyrinthRing6_EventScript_HyperionBattle)
    releaseall
}

script LabyrinthRing6_EventScript_Hyperion {
    lockall
    if (!defeated(TRAINER_ICHOR_HYPERION_KNOSSA)) {
        call(LabyrinthRing6_EventScript_HyperionBattle)
    }
    releaseall
}

script LabyrinthRing6_EventScript_HyperionBattle {
    applymovement(LOCALID_RING6_HYPERION, Common_Movement_FaceUp)
    waitmovement(0)
    playse(SE_M_EARTHQUAKE)
    setspeaker(LabyrinthRing6_Text_NameHyperion)
    msgbox(format("Well. Look who walked through the bull's yard and lived."))
    msgbox(format("Petros and Amathos told me about you. Kalliste. The tablet."))
    msgbox(format("I roasted them for it. Mostly not literally."))
    msgbox(format("You're late, Unwoven. The pieces are joined. It's gone to the heart."))
    msgbox(format("The master finishes it under the stars. I just do the hot part."))
    msgbox(format("Speaking of the hot part."))
    closemessage
    setspeaker(SP_NAME_NONE)
    trainerbattle_no_intro(TRAINER_ICHOR_HYPERION_KNOSSA, LabyrinthRing6_Text_HyperionDefeat)
    setspeaker(LabyrinthRing6_Text_NameHyperion)
    msgbox(format("Go on, then. Go and see him."))
    msgbox(format("You'll wish you'd stayed for the fire."))
    setspeaker(SP_NAME_NONE)
    if (!flag(FLAG_ICHOR_GOT_TM_FLARE)) {
        setflag(FLAG_ICHOR_GOT_TM_FLARE)
        msgbox(format("Hyperion tosses something over his shoulder without looking."))
        giveitem(ITEM_TM_OVERHEAT)
    }
    applymovement(LOCALID_RING6_HYPERION, LabyrinthRing6_Movement_HyperionLeaves)
    waitmovement(0)
    removeobject(LOCALID_RING6_HYPERION)
    setflag(FLAG_ICHOR_HIDE_HYPERION_KNOSSA)
    setflag(FLAG_ICHOR_RING6_LANDING_OPEN)
    setmetatile(23, 32, METATILE_Mychos_SlabR, FALSE)
    setmetatile(24, 32, METATILE_Mychos_SlabL, FALSE)
    special(DrawWholeMapView)
    if (var(VAR_ICHOR_KNOSSA) < 14) {
        setvar(VAR_ICHOR_KNOSSA, 14)
    }
    playse(SE_THUNDERSTORM_STOP)
    msgbox(format("Far off, wax cracks. Somewhere a sealed door gives."))
}

text LabyrinthRing6_Text_HyperionDefeat { format("HYPERION: Hot! HOT. Fine!") }

movement LabyrinthRing6_Movement_HyperionLeaves {
    walk_down
    walk_left * 3
    walk_down * 2
}

// ---------------------------------------------------------------------------
// The Mistress's shrine (the second heal; SCRIPT.md beat III-3K)
// ---------------------------------------------------------------------------

script LabyrinthRing6_EventScript_ShrinePriestess {
    lock
    faceplayer
    setspeaker(LabyrinthRing6_Text_NamePriestess)
    msgbox(format("The Mistress keeps this landing. Rest. You've earned the stair."))
    setspeaker(SP_NAME_NONE)
    call(Common_EventScript_OutOfCenterPartyHeal)
    checkitem(ITEM_HONEY)
    if (var(VAR_RESULT) == TRUE && !flag(FLAG_ICHOR_MISTRESS_HONEY)) {
        setspeaker(LabyrinthRing6_Text_NamePriestess)
        msgbox(format("Is that honey? For the Mistress?"))
        setspeaker(SP_NAME_NONE)
        msgbox(format("Offer a Honey?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            removeitem(ITEM_HONEY)
            setflag(FLAG_ICHOR_MISTRESS_HONEY)
            setspeaker(LabyrinthRing6_Text_NamePriestess)
            msgbox(format("“To the Mistress of the Labyrinth, one jar of honey.”"))
            msgbox(format("That's what the old tablets say. Word for word."))
            setspeaker(LabyrinthRing6_Text_NameAriadne)
            msgbox(format("Honey. Always honey. The old tablets say so."))
            setspeaker(SP_NAME_NONE)
            giveitem(ITEM_MAX_ELIXIR)
        }
    }
    release
}

