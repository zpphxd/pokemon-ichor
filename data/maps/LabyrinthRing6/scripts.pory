script LabyrinthRing6_EventScript_Hole2 {
    lockall
    msgbox(format("The floor is only a crust of flowstone over a hole. It gives!"), MSGBOX_DEFAULT)
    closemessage
    playse(SE_FALL)
    warp(MAP_LABYRINTH_RING6, 11)
    waitstate
    releaseall
}

script LabyrinthRing6_EventScript_Remains1 {
    msgbox(format("A smith's apron on the slag, Kaldera stitching. A note in the pocket:\pThey told us the collar was for a mule. No mule needs adamant."), MSGBOX_SIGN)
}

script LabyrinthRing6_EventScript_Remains2 {
    msgbox(format("A Titan bunk-roll and a letter, never sent: Ma, the boss says when the Loom\pstops nobody dies. Not even Gran. I'm doing it for Gran."), MSGBOX_SIGN)
}

script LabyrinthRing6_EventScript_Remains3 {
    msgbox(format("A bronze automaton lies on its face, a rope still knotted round one ankle.\pIts plinth, somewhere above, says: DO NOT UNTIE."), MSGBOX_SIGN)
}
