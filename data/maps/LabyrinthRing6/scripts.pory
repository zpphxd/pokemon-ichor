script LabyrinthRing6_EventScript_TurningBreak0 {
    lockall
    setvar(VAR_TEMP_D, 1)
    playse(SE_M_EARTHQUAKE)
    msgbox(format("The wall ahead grinds shut across the passage."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_0x8004, 2)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, 10)
    setvar(VAR_0x8007, 3)
    special(ShakeCamera)
    waitstate
    playse(SE_M_MEGA_KICK)
    setmetatile(29, 37, 0x225, TRUE)
    setmetatile(30, 37, 0x24B, FALSE)
    setmetatile(31, 37, 0x21C, TRUE)
    setmetatile(29, 38, 0x218, TRUE)
    setmetatile(30, 38, 0x240, FALSE)
    setmetatile(31, 38, 0x21C, TRUE)
