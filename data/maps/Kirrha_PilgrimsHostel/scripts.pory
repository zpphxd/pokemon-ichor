mapscripts Kirrha_PilgrimsHostel_MapScripts {}

// Generated by tools/ichor/maps/gulf.py; edit the builder, not this file.

script Kirrha_PilgrimsHostel_EventScript_RoadMap {
    msgbox(format("The road up the mountain, scratched by those who came back down.\pEach has drawn the falls bigger than the last."), MSGBOX_SIGN)
    end
}

script Kirrha_PilgrimsHostel_EventScript_Altar {
    msgbox(format("A little altar of Apollo, under the window that looks up the mountain."), MSGBOX_SIGN)
    end
}

script Kirrha_PilgrimsHostel_EventScript_Hearth {
    msgbox(format("The common hearth. A pot of lentils has been going since morning."), MSGBOX_SIGN)
    end
}

script Kirrha_PilgrimsHostel_EventScript_Kitchen {
    msgbox(format("Xenarete's kitchen hearth. Bread rising on the warm stones."), MSGBOX_SIGN)
    end
}

script Kirrha_PilgrimsHostel_EventScript_Xenarete {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_KIRRHA_WATER_GIFT)) {
        msgbox(format("Pilgrims, sailors, lost sheep, I feed them all.\pHere. Water from the Kastalian spring, carried down by the last priest who came.\pIt keeps a water-dweller strong."))
        giveitem(ITEM_MYSTIC_WATER)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_KIRRHA_WATER_GIFT)
        }
        release
        end
    }
    msgbox(format("Eat something before you climb anywhere."))
    release
}

script Kirrha_PilgrimsHostel_EventScript_Hesychia {
    lock
    faceplayer
    if (flag(FLAG_ICHOR_KIRRHA_BELL_GIFT)) {
        msgbox(format("Bees know the way home in the dark. So do daughters."))
        release
        end
    }
    if (flag(FLAG_ICHOR_KIRRHA_BEE_FOUND)) {
        msgbox(format("My bee! Pan kept it all these years.\p"
                      "I was a melissa once, a bee of Delphoi. So was a girl I loved,\p"
                      "who ran away to the islands. She had your eyes.\p"
                      "Take the hive bell. It brings a friend's heart close."))
        giveitem(ITEM_SOOTHE_BELL)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_KIRRHA_BELL_GIFT)
        }
        release
        end
    }
    msgbox(format("I left a gold bee in Pan's cave, up the goat path on the Schiste,\p"
                  "the year I left the god's service. I'm too old for the climb now.\p"
                  "If you go, look in Pan's niche. Bring a light."))
    setflag(FLAG_ICHOR_KIRRHA_BEE_ASKED)
    release
}

script Kirrha_PilgrimsHostel_EventScript_Lykinos {
    lock
    faceplayer
    msgbox(format("I've asked the god the same question for a year: when will the falls let us up?\pThe water answers. It says not yet."))
    release
}
