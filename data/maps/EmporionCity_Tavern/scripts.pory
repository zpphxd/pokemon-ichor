// The Dolphin, a harbor tavern (design/phase2/SCRIPT.md, Part 2; SYSTEMS.md §9).
// Room: tools/ichor/maps/emporion_rooms.py ("tavern"), on limen. The street door
// is the mat at (6..7, 8), warp 0. Its MAP_EMPORION_CITY dest_warp_id (0) is a
// placeholder until the city agent's door ids are known.
//
// Knucklebones: two regulars and a champion. Myrtale (1,6), at the worn table
// in the corner, is the champion: her first loss gives TM Fling and sets
// FLAG_ICHOR_KNUCKLEBONES_EMPORION. Strepsiades (2,5, cautious) pays Olive Oil
// x2 and Stratyllis (10,3, bold) Wine for a first win
// (FLAG_ICHOR_KNUCKLEBONES_STREPSIADES, _STRATYLLIS).
//
// Matches use the shared best-of-five engine (design/ENGINE_API.md §7).

mapscripts EmporionCity_Tavern_MapScripts {}

text EmporionCity_Tavern_Text_NameMyrtale { "MYRTALE" }
text EmporionCity_Tavern_Text_NameStrepsiades { "STREPSIADES" }
text EmporionCity_Tavern_Text_NameStratyllis { "STRATYLLIS" }

script EmporionCity_Tavern_EventScript_Myrtale {
    lock
    faceplayer
    setspeaker(EmporionCity_Tavern_Text_NameMyrtale)
    if (flag(FLAG_ICHOR_KNUCKLEBONES_EMPORION) || flag(FLAG_ICHOR_MYRTALE_PRIZE_PENDING)) {
        checkitem(ITEM_TM_FLING)
        if (var(VAR_RESULT) == FALSE || flag(FLAG_ICHOR_MYRTALE_PRIZE_PENDING)) {
            call(EmporionCity_Tavern_EventScript_MyrtalePrize)
            release
            end
        }
    }
    if (flag(FLAG_ICHOR_KNUCKLEBONES_EMPORION)) {
        msgbox(format("Come back any time. I like losing to people who'll come back."))
    } else {
        msgbox(format("Forty years at sea. Thirty-nine at this table. Sit.\p"
                      "Throw."))
    }
    bufferstring(STR_VAR_3, EmporionCity_Tavern_Text_NameMyrtale)
    setvar(VAR_0x8004, ICHOR_BONES_BOLD)
    call(EmporionCity_Tavern_EventScript_Match)
    if (var(VAR_RESULT) == TRUE && !flag(FLAG_ICHOR_KNUCKLEBONES_EMPORION)) {
        setflag(FLAG_ICHOR_MYRTALE_PRIZE_PENDING)
        call(EmporionCity_Tavern_EventScript_MyrtalePrize)
    } elif (var(VAR_RESULT) == FALSE) {
        setspeaker(EmporionCity_Tavern_Text_NameMyrtale)
        msgbox(format("Thirty-nine years. Sit again when you like."))
    }
    release
}

script EmporionCity_Tavern_EventScript_MyrtalePrize {
    setspeaker(EmporionCity_Tavern_Text_NameMyrtale)
    msgbox(format("Huh. Thirty-nine years.\p"
                  "Here. Fling. It's how you throw a thing so it counts."))
    setspeaker(SP_NAME_NONE)
    checkitem(ITEM_TM_FLING)
    if (var(VAR_RESULT) == FALSE) {
        giveitem(ITEM_TM_FLING)
        if (var(VAR_RESULT) == FALSE) {
            msgbox(format("Make room in your Bag, then come back for your scroll."))
            return
        }
    }
    setflag(FLAG_ICHOR_KNUCKLEBONES_EMPORION)
    clearflag(FLAG_ICHOR_MYRTALE_PRIZE_PENDING)
    setspeaker(EmporionCity_Tavern_Text_NameMyrtale)
    msgbox(format("Come back any time. I like losing to people who'll come back."))
    return
}

script EmporionCity_Tavern_EventScript_Strepsiades {
    lock
    faceplayer
    setspeaker(EmporionCity_Tavern_Text_NameStrepsiades)
    msgbox(format("I only rethrow the ones. That's my system.\p"
                  "My son says it's not a system. My son owes me money."))
    bufferstring(STR_VAR_3, EmporionCity_Tavern_Text_NameStrepsiades)
    setvar(VAR_0x8004, ICHOR_BONES_CAUTIOUS)
    call(EmporionCity_Tavern_EventScript_Match)
    if (var(VAR_RESULT) == TRUE && !flag(FLAG_ICHOR_KNUCKLEBONES_STREPSIADES)) {
        setspeaker(EmporionCity_Tavern_Text_NameStrepsiades)
        msgbox(format("Bah. The system needs work. Here, for the gods."))
        setspeaker(SP_NAME_NONE)
        checkitemspace(ITEM_OLIVE_OIL, 2)
        if (var(VAR_RESULT) == TRUE) {
            giveitem(ITEM_OLIVE_OIL, 2)
            if (var(VAR_RESULT) == TRUE) {
                setflag(FLAG_ICHOR_KNUCKLEBONES_STREPSIADES)
            }
        } else {
            msgbox(format("Make room in your Bag, then play again for the oil."))
        }
    }
    release
}

script EmporionCity_Tavern_EventScript_Stratyllis {
    lock
    faceplayer
    setspeaker(EmporionCity_Tavern_Text_NameStratyllis)
    msgbox(format("Aphrodite or nothing, dear. Aphrodite or nothing.\p"
                  "Mostly it's nothing. But oh, when it's Aphrodite."))
    bufferstring(STR_VAR_3, EmporionCity_Tavern_Text_NameStratyllis)
    setvar(VAR_0x8004, ICHOR_BONES_BOLD)
    call(EmporionCity_Tavern_EventScript_Match)
    if (var(VAR_RESULT) == TRUE && !flag(FLAG_ICHOR_KNUCKLEBONES_STRATYLLIS)) {
        setspeaker(EmporionCity_Tavern_Text_NameStratyllis)
        msgbox(format("Nothing again! Well. Take a cup to Dionysus for me."))
        setspeaker(SP_NAME_NONE)
        giveitem(ITEM_WINE, 1)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_KNUCKLEBONES_STRATYLLIS)
        }
    }
    release
}

// In: VAR_0x8004 opponent, STR_VAR_3 name.
// Out: VAR_RESULT TRUE (won), FALSE (lost) or 2 (declined).
script EmporionCity_Tavern_EventScript_Match {
    setspeaker(SP_NAME_NONE)
    msgbox(format("Play a game of knucklebones?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        setvar(VAR_RESULT, 2)
        return
    }
    closemessage
    call(EventScript_IchorKnucklebones)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("You win the game!"))
        setvar(VAR_RESULT, TRUE)
    } else {
        msgbox(format("You lose the game."))
        setvar(VAR_RESULT, FALSE)
    }
    return
}

script EmporionCity_Tavern_EventScript_BonesTable {
    msgbox(format("The knucklebones table. Its top is worn pale in a hollow, where the bones land."),
           MSGBOX_SIGN)
}

script EmporionCity_Tavern_EventScript_Mosaic {
    msgbox(format("A pebble mosaic of a leaping dolphin. The tavern's name, set in the floor."),
           MSGBOX_SIGN)
}

script EmporionCity_Tavern_EventScript_Rack {
    msgbox(format("Wine amphorae, racked two high. Chian, Thasian, and one marked “DON'T.”"),
           MSGBOX_SIGN)
}

script EmporionCity_Tavern_EventScript_Krater {
    msgbox(format("A big krater for mixing the wine with water. Three parts water, they say here."),
           MSGBOX_SIGN)
}

script EmporionCity_Tavern_EventScript_Nets {
    msgbox(format("Old nets hung up to dry, and a starfish nobody has taken down."), MSGBOX_SIGN)
}
