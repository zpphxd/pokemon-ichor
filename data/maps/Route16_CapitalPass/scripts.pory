mapscripts Route16_CapitalPass_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        special(Ichor_ReleaseTimeOfDay)
        call(Astyra_EventScript_PlaceRoadAlethea)
    }
}

// Generated by tools/ichor/maps/sacredway.py; edit the builder, not this file.

script Route16_CapitalPass_EventScript_NIKIAS {
    trainerbattle_single(TRAINER_ICHOR_R16_NIKIAS, format("The capital road starts here. So does the capital's watch."), format("You'll get through the gate."))
    msgbox(format("Astyra's over the hill. Follow the river, then climb."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_TIMARETE {
    trainerbattle_single(TRAINER_ICHOR_R16_TIMARETE, format("The Kephisos waters every olive from here to the walls. Don't trample them!"), format("You stepped lightly."))
    msgbox(format("Hop the stones at the ford. The river's colder than it looks."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_KLEOBIS {
    trainerbattle_single(TRAINER_ICHOR_R16_KLEOBIS, format("My mother asked the goddess for the best gift for her sons. We fell asleep and never woke.\p...That's my namesake's story, anyway. Battle?"), format("A deep sleep, that."))
    msgbox(format("The graves along here are the city's oldest. Walk softly."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_DIOTIMA {
    trainerbattle_single(TRAINER_ICHOR_R16_DIOTIMA, format("Love climbs from one beautiful thing to the next. Battles climb too."), format("A lovely climb."))
    msgbox(format("The philosophers walk in the olives south of here. Ask one anything. Bring lunch."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_ARISTON {
    trainerbattle_single(TRAINER_ICHOR_R16_ARISTON, format("Last flock before the walls. Show me your shepherding!"), format("Well herded."))
    msgbox(format("Up top you'll see it. The rock, and the god's house on it."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_EUBIOS {
    trainerbattle_single(TRAINER_ICHOR_R16_EUBIOS, format("The Dipylon's ahead. I read anyone who asks. You're asking."), format("A bright omen."))
    msgbox(format("Astyra. Mind your purse, your manners and your future."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_EXEKIAS {
    trainerbattle_single(TRAINER_ICHOR_R16_EXEKIAS, format("I paint the jars they bury with the dead. Black figures. Want to be one?"), format("You'd fire well."))
    msgbox(format("Potters' quarter, potters' graves. We keep each other company."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_SPEUSIPPOS {
    trainerbattle_single(TRAINER_ICHOR_R16_SPEUSIPPOS, format("My uncle teaches under these olives. I'm supposed to be learning. Battle instead!"), format("Uncle will hear of this."))
    msgbox(format("Talk to Aristokles. He loves a question. Hates an answer."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_MENEXENOS {
    trainerbattle_single(TRAINER_ICHOR_R16_MENEXENOS, format("Nobody uses the ditch road since the span fell. Nobody but me."), format("Ditch duty, done."))
    msgbox(format("The old border road crossed to that pier. Now only birds do."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_STRATON {
    trainerbattle_single(TRAINER_ICHOR_R16_STRATON, format("The city's walls start at the lookout. So does my patrol."), format("Patrol relieved."))
    msgbox(format("Take a moment at the seat. Everyone does, the first time."), MSGBOX_AUTOCLOSE)
    end
}

script Route16_CapitalPass_EventScript_Sign0 {
    msgbox(format("Route 16, the capital pass.\nWest: Daphni. East: the Kephisos, then Astyra."), MSGBOX_SIGN)
    end
}

script Route16_CapitalPass_EventScript_Sign1 {
    msgbox(format("Route 16.\nEast: Astyra's Dipylon gate. West: the Kerameikos, the Kephisos and Daphni."), MSGBOX_SIGN)
    end
}

script Route16_CapitalPass_EventScript_Herm {
    goto(EventScript_IchorGreatHerm)
}

script Route16_CapitalPass_EventScript_Tomb {
    msgbox(format("A family tomb, its door sealed with bronze stamped with a double axe.\pOld Knossian work. Whatever's inside was meant to stay there."), MSGBOX_SIGN)
    end
}

script Route16_CapitalPass_EventScript_Plots {
    msgbox(format("Grave stelai of the city's dead: a girl with her doves, a rider, an old man and his dog.\pA row of little oil jars stands in front of each."), MSGBOX_SIGN)
    end
}

script Route16_CapitalPass_EventScript_Shrine {
    msgbox(format("Niches cut for the Nymphs of the hill, with clay figures and a dried garland."), MSGBOX_SIGN)
    end
}

script Route16_CapitalPass_EventScript_Aristokles {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_R16_AKADEMIA_GIFT)) {
        msgbox(format("A visitor! Sit. I'm Aristokles, though my students call me the broad one.\p"
                      "Tell me: is a thing good because the gods love it, or do they love it because it's good?\p"
                      "...You don't know. Excellent. Neither do I. Take this, for the walk."))
        giveitem(ITEM_WISE_GLASSES)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_R16_AKADEMIA_GIFT)
        }
        release
        end
    }
    msgbox(format("Prometheus's altar is in this grove. The torch race starts there and runs to the city.\p"
                  "Whoever keeps the flame alight wins. Not whoever's fastest. Think about that."))
    release
}

script Route16_CapitalPass_EventScript_Seat {
    msgbox(format("A stone seat at the top of the climb. From here: the walls, the city's roofs,\p"
                  "and over them the rock, with the goddess's house on it, white as salt."), MSGBOX_SIGN)
    end
}

script Route16_CapitalPass_EventScript_View {
    lockall
    if (flag(FLAG_ICHOR_R16_AKROPOLIS_SEEN)) {
        releaseall
        end
    }
    setflag(FLAG_ICHOR_R16_AKROPOLIS_SEEN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Route16_CapitalPass_EventScript_Movement_CameraToRock)
    waitmovement(0)
    msgbox(format("Over the walls, the rock of the Akropolis rises out of the city.\p"
                  "On top, the columns of the goddess's house catch the light.\p"
                  "Astyra. The capital."), MSGBOX_DEFAULT)
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, Route16_CapitalPass_EventScript_Movement_CameraBack)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}

movement Route16_CapitalPass_EventScript_Movement_CameraToRock {
    walk_slow_up * 5
}

movement Route16_CapitalPass_EventScript_Movement_CameraBack {
    walk_slow_down * 5
}

script Route16_CapitalPass_EventScript_Span {
    lockall
    if (!flag(FLAG_ICHOR_GOT_DAEDALUS_WINGS)) {
        msgbox(format("The old border road's span lies in pieces in the ditch.\p"
                      "On the far pier something glints. Only something with wings could reach it."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("The fallen span. The far pier is a short glide away.\pSpread Daedalus's Wings?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_FLY)
        fadescreen(FADE_TO_WHITE)
        warpsilent(MAP_ROUTE16_CAPITAL_PASS, 61, 23)
        waitstate
    }
    releaseall
}

script Route16_CapitalPass_EventScript_SpanBack {
    lockall
    msgbox(format("The far pier of the fallen span. Glide back across?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_FLY)
        fadescreen(FADE_TO_WHITE)
        warpsilent(MAP_ROUTE16_CAPITAL_PASS, 57, 19)
        waitstate
    }
    releaseall
}
