mapscripts LakeStymphalia_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_ICHOR_STYMPHALIA_FLOCK_ROSE)) {
            setvar(VAR_TEMP_1, 1)
        }
    }
}

// Generated by tools/ichor/maps/stymphalia.py; edit the builder, not this file.

script LakeStymphalia_EventScript_KYKNOS {
    trainerbattle_single(TRAINER_ICHOR_KYKNOS, format("The birds here drop feathers like knives.\pI fish in a helmet. Battle me in one."), format("A feather went down my collar. I'm blaming you."))
    msgbox(format("Akanthis in the stilt hut says there's a monster in the deep reeds.\pShe says that about everything."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_STYM_HALIA {
    trainerbattle_single(TRAINER_ICHOR_STYM_HALIA, format("Shh. The eels come up when the birds go quiet."), format("Well, now nothing's quiet."))
    msgbox(format("Fish off the sand at dusk. The Karkitox come in to the reeds to feed."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_TITANBORN_BORBOROS {
    trainerbattle_single(TRAINER_ICHOR_TITANBORN_BORBOROS, format("In the golden age, do we still get to eat?\pI've asked three times. Nobody answers."), format("Nobody answers that either."))
    msgbox(format("The column won't wait. It never waits.\pI'm going to sit here a while. You can step over me."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_STYM_TENAGOS {
    trainerbattle_single(TRAINER_ICHOR_STYM_TENAGOS, format("Borboros sat down. I'm standing up. That's the difference between us."), format("…Maybe I'll sit down too."))
    msgbox(format("They march us past the lake so the birds can count us. Or so the birds don't eat us."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_MELAMPOUS {
    trainerbattle_single(TRAINER_ICHOR_MELAMPOUS, format("Bronze birds. They read nothing. I read them. Battle?"), format("The birds saw that coming. I didn't."))
    msgbox(format("The little ones nest in there, in the shallows.\pMornings and evenings. Wade in quiet."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_DONAX {
    trainerbattle_single(TRAINER_ICHOR_DONAX, format("Reeds for roofs. Reeds for pipes. Reeds for the cadets' beds. Reeds for you!"), format("I'll cut you a pipe to cry into."))
    msgbox(format("The south reeds grow back while you watch.\pI don't cut there. Nobody cuts there."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_STYM_ORNITHE {
    trainerbattle_single(TRAINER_ICHOR_STYM_ORNITHE, format("I lime the reeds for birds. Small ones. The big ones lime me."), format("Stuck. Again."))
    msgbox(format("Akanthis taught me. Forty years in these reeds and she still has both eyes."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_STYM_SKIRITES {
    trainerbattle_single(TRAINER_ICHOR_STYM_SKIRITES, format("Skiritai watch the west shore. I watch the Skiritai watch it."), format("Watched that. Didn't like it."))
    msgbox(format("The road climbs west into the hills. Scouts on every height, so mind your manners."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_STYM_LIMNAIA {
    trainerbattle_single(TRAINER_ICHOR_STYM_LIMNAIA, format("The reed wall moved. I swear it moved. Battle me so I stop thinking about it."), format("Thinking about it again."))
    msgbox(format("Cut it and it grows back before you've put the sickle down.\pEight pools behind it. I counted through the stems."), MSGBOX_AUTOCLOSE)
    end
}

script LakeStymphalia_EventScript_Akanthis {
    lock
    faceplayer
    msgbox(format("Sit. By the fire. Everyone who crosses gets a sit. Them's the rules."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    fadescreen(FADE_FROM_BLACK)
    // the hut is the road's rest stop: its herm on the shore goes live (MAP_DESIGN §2)
    setvar(VAR_0x8004, TOWN_HERM_STYMPHALIA)
    special(Ichor_RegisterTownHerm)
    if (flag(FLAG_ICHOR_HEARD_LERNIP_RUMOR)) {
        msgbox(format("Sit. Fire's still going."))
        release
        end
    }
    msgbox(format("Forty years I've limed birds in these reeds. Bronze ones, now. Mind your eyes.\p"
                  "There's a thing in the deep reeds. East, down the side boards.\p"
                  "Only in the rain. Swims up when the water's all rings.\p"
                  "Small. Green. Too many heads for a small green thing.\p"
                  "Three times in forty years, I've seen it. You've got young eyes.\p"
                  "Come back when it rains. The augur'll tell you when."))
    setflag(FLAG_ICHOR_HEARD_LERNIP_RUMOR)
    release
}

