script LakeStymphalia_EventScript_Flock {
    lockall
    setvar(VAR_TEMP_1, 1)
    setflag(FLAG_ICHOR_STYMPHALIA_FLOCK_ROSE)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, LakeStymphalia_Movement_CameraNorth)
    waitmovement(0)
    playse(SE_M_HARDEN)
    msgbox(format("Clink. Clink-clink. The reeds on the north shore shift like coins in a purse."))
    closemessage
    playmoncry(SPECIES_BELORNIS, CRY_MODE_ENCOUNTER)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD1, LakeStymphalia_Movement_Rise0)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD2, LakeStymphalia_Movement_Rise1)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD3, LakeStymphalia_Movement_Rise2)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD4, LakeStymphalia_Movement_Rise0)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD5, LakeStymphalia_Movement_Rise1)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD6, LakeStymphalia_Movement_Rise2)
    waitmovement(0)
    waitmoncry
    msgbox(format("A hundred bronze birds lift out of the reeds at once.\p"
                  "The light off their wings turns the whole marsh the color of a shield."))
    closemessage
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD1, LakeStymphalia_Movement_Settle0)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD2, LakeStymphalia_Movement_Settle1)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD3, LakeStymphalia_Movement_Settle2)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD4, LakeStymphalia_Movement_Settle0)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD5, LakeStymphalia_Movement_Settle1)
    applymovement(LOCALID_LAKE_STYMPHALIA_BIRD6, LakeStymphalia_Movement_Settle2)
    waitmovement(0)
    msgbox(format("They circle once, and settle. Every bronze head is turned toward the causeway.\pToward you."))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, LakeStymphalia_Movement_CameraSouth)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}

movement LakeStymphalia_Movement_CameraNorth { walk_up * 16 }
movement LakeStymphalia_Movement_CameraSouth { walk_down * 16 }
movement LakeStymphalia_Movement_Rise0 { fly_up walk_fast_left * 2 walk_fast_up walk_fast_right * 3 }
movement LakeStymphalia_Movement_Rise1 { fly_up walk_fast_right * 2 walk_fast_up walk_fast_left * 3 }
movement LakeStymphalia_Movement_Rise2 { fly_up walk_fast_up walk_fast_left walk_fast_right * 2 }
movement LakeStymphalia_Movement_Settle0 { walk_fast_left walk_fast_down fly_down }
movement LakeStymphalia_Movement_Settle1 { walk_fast_right walk_fast_down fly_down }
movement LakeStymphalia_Movement_Settle2 { walk_fast_left walk_fast_down fly_down }

script LakeStymphalia_EventScript_SouthSign {
    msgbox(format("LAKE STYMPHALIA\nKeep to the causeway. Mind the birds. They mind you."), MSGBOX_SIGN)
    end
}

script LakeStymphalia_EventScript_WestSign {
    msgbox(format("WEST: ROUTE 27, over the hills into Arkadia.\nEAST: the causeway, and Lakonia."), MSGBOX_SIGN)
    end
}

script LakeStymphalia_EventScript_HutDoor {
    msgbox(format("Akanthis's hut. Nets hang in the doorway, and the smoke smells of fish and thyme."), MSGBOX_SIGN)
    end
}

script LakeStymphalia_EventScript_NorthReeds {
    lockall
    msgbox(format("The reeds here are thick with roosting birds. Their feathers clink like coins.\p"
                  "As you step closer, a hundred bronze heads turn toward you at once.\pYou step back."), MSGBOX_DEFAULT)
    releaseall
}

script LakeStymphalia_EventScript_RegrowWall {
    lockall
    if (!flag(FLAG_ICHOR_GOT_DEMETERS_SICKLE)) {
        msgbox(format("A wall of reeds, green with new shoots. Behind it, water glints in rings."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A wall of reeds. You cut a path with Demeter's Sickle.\p"
                  "…By the time you look up, it's grown back.\p"
                  "Through the stems: eight pools in a ring, around a ninth."), MSGBOX_DEFAULT)
    releaseall
}

script LakeStymphalia_EventScript_FogBank {
    msgbox(format("A bank of mist sits on the north-east reeds and never lifts, even at noon.\pSomething big shifts inside it. One feather drifts out, bronze, as long as your arm."), MSGBOX_SIGN)
    end
}

script LakeStymphalia_EventScript_DeepReeds {
    msgbox(format("The deep reeds. The water here is black and still, and the stems close over your head.\pIn the mud at the edge, small prints. Three toes. Then nine."), MSGBOX_SIGN)
    end
}
