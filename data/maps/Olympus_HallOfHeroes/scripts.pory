// The Hall of Heroes, the cella of the Twelve (STORY.md L-9; Emerald's
// EverGrandeCity_HallOfFame, adapted). Aristeides walks the new Archon up the
// nave to the record stone; the stone takes the party's names, the Star Chart
// takes its last patch (the Unwoven, SYSTEMS.md §8 #24), and the Hall of Fame
// screen and the credits follow (special GameClear).

mapscripts Olympus_HallOfHeroes_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0: Olympus_HallOfHeroes_EventScript_FaceNorth
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ELITE_4_STATE, 9: Olympus_HallOfHeroes_EventScript_Enter
    ]
}

script Olympus_HallOfHeroes_EventScript_FaceNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

movement Olympus_HallOfHeroes_Movement_Nave { walk_up * 6 }
movement Olympus_HallOfHeroes_Movement_ArchonNave { walk_up * 5 }
movement Olympus_HallOfHeroes_Movement_ToStone { walk_up * 8 }

script Olympus_HallOfHeroes_EventScript_Enter {
    lockall
    setvar(VAR_ELITE_4_STATE, 10)
    if (!flag(FLAG_ICHOR_HIDE_ARCHON_SUMMIT)) {
        applymovement(LOCALID_OLYMPUS_HALL_OF_HEROES_ARISTEIDES, Olympus_HallOfHeroes_Movement_ArchonNave)
    }
    applymovement(LOCALID_PLAYER, Olympus_HallOfHeroes_Movement_Nave)
    waitmovement(0)
    if (!flag(FLAG_ICHOR_HIDE_ARCHON_SUMMIT)) {
        applymovement(LOCALID_OLYMPUS_HALL_OF_HEROES_ARISTEIDES, Common_Movement_WalkInPlaceFasterLeft)
        applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
        waitmovement(0)
        setspeaker(Ichor_League_Text_NameAristeides)
        msgbox(format("The Hall of Heroes. Not the ones the oracles named.\pThe ones the age remembers. Medon is here. So is his father.\pAnd so are you, now. You and every one of your partners."))
        closemessage
    } else {
        msgbox(format("The cella is quiet. Your names are already cut in the stone.\pThe stone has room for more."))
        closemessage
    }
    applymovement(LOCALID_PLAYER, Olympus_HallOfHeroes_Movement_ToStone)
    waitmovement(0)
    delay(20)
    playse(SE_M_MORNING_SUN)
    fadescreenspeed(FADE_TO_WHITE, 8)
    fadescreenspeed(FADE_FROM_WHITE, 8)
    waitse
    setvar(VAR_0x8004, 23)
    special(Ichor_PlaceConstellation)
    msgbox(format("The record stone takes your names, and your partners', one by one."))
    closemessage
    delay(30)
    setvar(VAR_TEMP_1, 1)
    call(EverGrandeCity_HallOfFame_EventScript_ResetEliteFour)
    setflag(FLAG_ICHOR_HIDE_ARCHON_SUMMIT)
    setflag(FLAG_IS_CHAMPION)
    setrespawn(HEAL_LOCATION_ELAIA_VILLAGE)
    fadescreenspeed(FADE_TO_BLACK, 24)
    special(GameClear)
    waitstate
    releaseall
}

script Olympus_HallOfHeroes_EventScript_Aristeides {
    msgbox(format("Go on. The stone's waiting."), MSGBOX_NPC)
}
