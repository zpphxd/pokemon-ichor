// The Euploia's deck. SCRIPT.md beats 10 (the crossing) and 10C (the last leg),
// the trireme roster (Part 2), the crossing's trainers (Part 3) and the deck's
// items (Part 6). The deck is drawn by tools/ichor/art/trireme_deck.py; the
// setmetatile scripts at the end of this file are generated by
// tools/ichor/maps/trireme.py.
//
// State:
//   VAR_TEMP_0 == 1  casting off: just boarded at the gangway tile (13,4) before the
//                    halcyon calm. The oars are out and the sail half full on load.
//   VAR_TEMP_0 == 3  beat 10C: the morning after the night at Aigina's inn
//   VAR_TEMP_1 == 1  the halcyon calm (the klepsydra runs backward)
//   VAR_TEMP_1 == 2  ...and the lookout has shouted: walking to the bow (x = 8)
//                    plays the nest. Kleon stands on the hatch, keeping the stroke.
//   VAR_TEMP_2 == 1  the player lost a snatcher battle
//   VAR_TEMP_3 == 1  Alethea has shown off her Spalunk this visit
// The calm never outlives a visit: Kleon blocks the hatch, and a reload starts
// it again from Nausikles.

mapscripts TriremeEuploia_Deck_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // the scene's people and birds wait off stage
        setflag(FLAG_ICHOR_HIDE_HALCYON_NEST)
        setflag(FLAG_ICHOR_HIDE_DECK_HARPECK)
        setflag(FLAG_TEMP_1)
        setflag(FLAG_TEMP_2)
        setflag(FLAG_TEMP_3)
        setflag(FLAG_TEMP_4)
        setflag(FLAG_TEMP_5)
        setflag(FLAG_TEMP_6)
        setflag(FLAG_TEMP_7)
        setflag(FLAG_TEMP_8)
        setflag(FLAG_TEMP_9)
        setflag(FLAG_TEMP_A)
        // Kleon's pose (design/phase2/SPRITES.md): green at the rail until the
        // set piece swaps him to his walker; reading his mother's tablet at night
        setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_KLEON_SEASICK)
        getplayerxy(VAR_0x8004, VAR_0x8005)
        if (flag(FLAG_ICHOR_AEGINA_NIGHT) && !flag(FLAG_ICHOR_CROSSING_DONE)) {
            // beat 10C: Kleon at the bow, not green at all; Alethea at the
            // rail; a clear morning
            setvar(VAR_TEMP_0, 3)
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_KLEON)
            setobjectxyperm(LOCALID_DECK_KLEON, 3, 6)
            setobjectmovementtype(LOCALID_DECK_KLEON, MOVEMENT_TYPE_FACE_LEFT)
            setobjectxyperm(LOCALID_DECK_ALETHEA, 7, 4)
            setobjectmovementtype(LOCALID_DECK_ALETHEA, MOVEMENT_TYPE_FACE_UP)
            setvar(VAR_0x8004, 10)
            special(Ichor_SetHoursOverride)
        } elif (flag(FLAG_ICHOR_BOARDED_EUPLOIA) && !flag(FLAG_ICHOR_SAVED_HALCYON_NEST)
                && var(VAR_0x8004) == 13 && var(VAR_0x8005) == 4) {
            setvar(VAR_TEMP_0, 1)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (var(VAR_TEMP_0) == 1) {
            call(TriremeDeck_EventScript_SailFill)
            call(TriremeDeck_EventScript_OarsOut)
        } elif (var(VAR_TEMP_0) == 3) {
            call(TriremeDeck_EventScript_CoastOn)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 1: TriremeDeck_EventScript_CastOff
        VAR_TEMP_0, 3: TriremeDeck_EventScript_LastLeg
    ]
}

// ---------------------------------------------------------------------------
// Speakers
// ---------------------------------------------------------------------------

text TriremeDeck_Text_NameKleon { "KLEON" }
text TriremeDeck_Text_NameAlethea { "ALETHEA" }
text TriremeDeck_Text_NamePronomos { "PRONOMOS" }
text TriremeDeck_Text_NameLookout { "LOOKOUT" }
text TriremeDeck_Text_NameSailor { "SAILOR" }
text TriremeDeck_Text_NamePhormion { "PHORMION" }
text TriremeDeck_Text_NameLykon { "LYKON" }

// ---------------------------------------------------------------------------
// Beat 10: casting off. The gangplank comes in, the oars come in, the sail fills.
// ---------------------------------------------------------------------------

script TriremeDeck_EventScript_CastOff {
    lockall
    setvar(VAR_TEMP_0, 2)
    delay(24)
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("Cast off! Oars in, lads! Let the wind do the work."))
    closemessage
    call(TriremeDeck_EventScript_OarsIn)
    special(DrawWholeMapView)
    delay(16)
    playse(SE_M_GUST)
    call(TriremeDeck_EventScript_SailFull)
    special(DrawWholeMapView)
    // never waitse on SE_M_GUST: it doesn't report finishing (Akti's softlock)
    delay(30)
    releaseall
}

// ---------------------------------------------------------------------------
// The people on deck
// ---------------------------------------------------------------------------

script TriremeDeck_EventScript_Kleon {
    lock
    setspeaker(TriremeDeck_Text_NameKleon)
    if (var(VAR_TEMP_1) != 0) {
        faceplayer
        msgbox(format("LEFT! And LEFT! And LEFT, RIGHT, LEFT!"))
    } else {
        // he stays bent over the rail while he talks, and heaves at the end
        msgbox(format("I'm fine. Lakonians never get seasick.\p"
                      "Lakonians fight on land. That's why. We've got loads of land.\p"
                      "Don't look at the water. I'm not looking at the water."))
        closemessage
        applymovement(LOCALID_DECK_KLEON, TriremeDeck_Movement_KleonHeave)
        waitmovement(LOCALID_DECK_KLEON)
        msgbox(format("Hrk."))
    }
    release
}

script TriremeDeck_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(TriremeDeck_Text_NameAlethea)
    if (var(VAR_TEMP_1) != 0) {
        msgbox(format("He's actually good at this.\pDon't ever tell him I said so."))
        release
        end
    }
    if (flag(FLAG_ICHOR_BATTLED_ALETHEA_DECK)) {
        msgbox(format("I'm going to get better. Slowly. But I'll get there."))
        release
        end
    }
    if (var(VAR_TEMP_3) == 0) {
        setvar(VAR_TEMP_3, 1)
        msgbox(format("Look! My first partner. A Spalunk.\p"
                      "It was asleep in the bottom of the dig pit on Kronion Hill.\p"
                      "It followed me home. It's blind. It doesn't care. It just digs.\p"
                      "Daphne said I needed a partner. So I dug one up. Literally."))
        setspeaker(TriremeDeck_Text_NameKleon)
        msgbox(format("A mole? You picked a mole?\pHrk."))
        setspeaker(TriremeDeck_Text_NameAlethea)
    }
    msgbox(format("{PLAYER}, would you battle me? Gently?\p"
                  "I've never done it with my own Pokémon. Only with books."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("That's all right. Ask me later. I'll be standing here, being nervous."))
        release
        end
    }
    msgbox(format("Thank you! Wait. Was I supposed to bow? Never mind!"))
    closemessage
    // A practice bout: losing it doesn't send the player home.
    setflag(FLAG_ICHOR_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_ICHOR_ALETHEA_DECK, TriremeDeck_Text_AletheaDefeat)
    clearflag(FLAG_ICHOR_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_LOST || var(VAR_RESULT) == B_OUTCOME_DREW) {
        special(HealPlayerParty)
    }
    setflag(FLAG_ICHOR_BATTLED_ALETHEA_DECK)
    setspeaker(TriremeDeck_Text_NameAlethea)
    msgbox(format("I'm going to get better. Slowly. But I'll get there."))
    release
}

text TriremeDeck_Text_AletheaDefeat {
    format("I lost, but correctly! I did every step!")
}

script TriremeDeck_EventScript_Pronomos {
    lock
    faceplayer
    setspeaker(TriremeDeck_Text_NamePronomos)
    if (var(VAR_TEMP_1) != 0) {
        msgbox(format("My reed! It split clean through!\pI can't keep the stroke!"))
    } else {
        msgbox(format("I'm the piper. When the wind drops, I play, and they row to it.\p"
                      "A trireme's a hundred and seventy men trying to agree. The aulos helps."))
    }
    release
}

// SCRIPT.md gives the lookout only his shout; his idle line is new (flagged in
// the report for the director).
script TriremeDeck_EventScript_Lookout {
    lock
    faceplayer
    setspeaker(TriremeDeck_Text_NameLookout)
    if (var(VAR_TEMP_1) == 2) {
        msgbox(format("Something in the water! Dead ahead!"))
    } else {
        msgbox(format("Sea. Sea. Gull. Sea. I'll tell you if that changes."))
    }
    closemessage
    applymovement(LOCALID_DECK_LOOKOUT, TriremeDeck_Movement_FaceLeft)
    waitmovement(0)
    release
}

script TriremeDeck_EventScript_Phormion {
    trainerbattle_single(TRAINER_ICHOR_PHORMION, TriremeDeck_Text_PhormionIntro, TriremeDeck_Text_PhormionDefeat)
    setspeaker(TriremeDeck_Text_NamePhormion)
    msgbox(format("A trireme's fast because it's light. So, no room for your bags."), MSGBOX_AUTOCLOSE)
}

text TriremeDeck_Text_PhormionIntro {
    format("Sea legs? Let's see if your Pokémon have them!")
}

text TriremeDeck_Text_PhormionDefeat {
    format("Sunk! In a flat calm, too.")
}

script TriremeDeck_EventScript_Lykon {
    trainerbattle_single(TRAINER_ICHOR_LYKON, TriremeDeck_Text_LykonIntro, TriremeDeck_Text_LykonDefeat)
    setspeaker(TriremeDeck_Text_NameLykon)
    msgbox(format("The Agora at Emporion! They sell things there nobody's invented yet."), MSGBOX_AUTOCLOSE)
}

text TriremeDeck_Text_LykonIntro {
    format("Everything's for sale. Even a battle. This one's free.")
}

text TriremeDeck_Text_LykonDefeat {
    format("Free, and I still lost on the deal.")
}

script TriremeDeck_EventScript_Klepsydra {
    lockall
    setspeaker(SP_NAME_NONE)
    if (var(VAR_TEMP_1) != 0) {
        msgbox(format("The water in the captain's klepsydra is dripping upward."))
    } else {
        msgbox(format("The captain's water clock.\pWater drips from the top bowl to the bottom one."))
    }
    releaseall
}

// ---------------------------------------------------------------------------
// Nausikles: the steering oar and the halcyon calm; later, the ferry
// ---------------------------------------------------------------------------

script TriremeDeck_EventScript_Nausikles {
    if (flag(FLAG_ICHOR_CROSSING_DONE)) {
        goto(Ichor_EventScript_FerryDeck)
    }
    lock
    faceplayer
    setspeaker(Ichor_Text_NameNausikles)
    if (flag(FLAG_ICHOR_SAVED_HALCYON_NEST)) {
        msgbox(format("We'll put in at Aigina for the night. Emporion in the morning."))
        release
        end
    }
    if (var(VAR_TEMP_1) != 0) {
        msgbox(format("Pull! We'll row her to Aigina if we have to!"))
        release
        end
    }
    msgbox(format("Aigina by dark, Emporion tomorrow, if the wind holds.\p"
                  "Winds always hold. Until they don't."))
    msgbox(format("Want to take the steering oar a moment? Just hold it straight."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Ha. Wise."))
        release
        end
    }
    closemessage
    goto(TriremeDeck_EventScript_TheCalm)
}

script TriremeDeck_EventScript_TheCalm {
    lockall
    hidefollower
    // The player takes the oar at (19,6), facing the tiller's knob; Nausikles,
    // at (19,7), stands by.
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 18) {
        applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_HelmFromWest)
    } elif (var(VAR_0x8005) == 8) {
        applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_HelmFromSouth)
    } else {
        applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_FaceRight)
    }
    waitmovement(0)
    applymovement(LOCALID_DECK_NAUSIKLES, TriremeDeck_Movement_FaceUp)
    waitmovement(0)
    delay(30)
    // the camera looks forward along the deck, so the whole sail is in view
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, TriremeDeck_Movement_CameraForward)
    waitmovement(0)

    // The calm: the sail sags, the wind and the music die away
    fadeoutbgm(2)
    call(TriremeDeck_EventScript_SailSag)
    call(TriremeDeck_EventScript_KlepsydraUp)
    special(DrawWholeMapView)
    setvar(VAR_TEMP_1, 1)
    delay(30)
    setspeaker(SP_NAME_NONE)
    msgbox(format("The sail sags. The wind is gone. The sea goes flat in every direction."))
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("…No. Not out here. We're past the islands.\p"
                  "One nest still out. Has to be. Aeolus won't blow while one's sitting.\p"
                  "OARS! Pronomos, the stroke!"))
    closemessage
    call(TriremeDeck_EventScript_OarsOut)
    special(DrawWholeMapView)
    // the aulos's two-note stroke
    playbgm(MUS_ICHOR_TRIREME, FALSE)
    delay(40)
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("Pull! We'll row her to Aigina if we have to!"))
    setspeaker(TriremeDeck_Text_NameAlethea)
    msgbox(format("Is that… normal?"))
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("Nothing's been normal since spring, girl. Pull!"))
    closemessage

    // The split reed: the aulos stops, the oars clatter out of time
    // ICHOR_STUB_MUSIC: SCRIPT.md Part 9 asks for a split-reed sound effect.
    playse(SE_M_SCREECH)
    fadeoutbgm(0)
    delay(10)
    playse(SE_M_DOUBLE_SLAP)
    delay(20)
    setspeaker(TriremeDeck_Text_NamePronomos)
    msgbox(format("My reed! It split clean through!\pI can't keep the stroke!"))
    closemessage

    // Kleon pushes off the rail and walks to the hatch, still green: his pose
    // swaps to his walker where he stands (SPRITES.md's recipe; removeobject
    // sets his hide flag, FLAG_ICHOR_CROSSING_DONE, so it is cleared again at
    // once). His template moves onto the hatch, so he is there whenever he
    // respawns in the calm.
    setobjectxyperm(LOCALID_DECK_KLEON, 7, 4)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_KLEON)
    removeobject(LOCALID_DECK_KLEON)
    addobject(LOCALID_DECK_KLEON)
    clearflag(FLAG_ICHOR_CROSSING_DONE)
    applymovement(LOCALID_DECK_KLEON, TriremeDeck_Movement_KleonToHatch)
    waitmovement(0)
    setobjectxyperm(LOCALID_DECK_KLEON, 14, 7)
    setobjectmovementtype(LOCALID_DECK_KLEON, MOVEMENT_TYPE_FACE_DOWN)
    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("…Lakonians march to the aulos.\p"
                  "Rowing's just marching. Sitting down.\p"
                  "LEFT! And LEFT! And LEFT, RIGHT, LEFT!"))
    closemessage
    // ICHOR_STUB_MUSIC: MUS_ICHOR_TRIREME's march variant for Kleon's stroke
    // (Dorian, drum-led) doesn't exist yet; the rowing song starts over instead.
    playbgm(MUS_ICHOR_TRIREME, FALSE)
    delay(30)
    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("FORWARD, SONS OF LAKONIA!\pAND EVERYONE ELSE'S SONS! AND DAUGHTERS! LEFT!"))
    setspeaker(TriremeDeck_Text_NameAlethea)
    msgbox(format("He's actually good at this.\pDon't ever tell him I said so."))
    closemessage
    delay(20)
    setspeaker(TriremeDeck_Text_NameLookout)
    msgbox(format("Something in the water! Dead ahead!"))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, TriremeDeck_Movement_CameraBack)
    waitmovement(0)
    special(RemoveCameraObject)
    // The player walks to the bow (the trigger line at x = 8). Until then the
    // klepsydra can be checked, running backward.
    setvar(VAR_TEMP_1, 2)
    releaseall
}

// From the trigger line at x = 8, whatever the row, to the bow at (3,6)
script TriremeDeck_EventScript_ToBowRow4 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_ToBowRow4)
    goto(TriremeDeck_EventScript_TheNest)
}

script TriremeDeck_EventScript_ToBowRow5 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_ToBowRow5)
    goto(TriremeDeck_EventScript_TheNest)
}

script TriremeDeck_EventScript_ToBowRow6 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_ToBowRow6)
    goto(TriremeDeck_EventScript_TheNest)
}

script TriremeDeck_EventScript_ToBowRow7 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_ToBowRow7)
    goto(TriremeDeck_EventScript_TheNest)
}

script TriremeDeck_EventScript_ToBowRow8 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_ToBowRow8)
    goto(TriremeDeck_EventScript_TheNest)
}

script TriremeDeck_EventScript_ToBowRow9 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_ToBowRow9)
    goto(TriremeDeck_EventScript_TheNest)
}

script TriremeDeck_EventScript_TheNest {
    waitmovement(0)
    hidefollower
    setvar(VAR_TEMP_1, 1)
    // Alethea follows the player to the bow from the mast
    setobjectxy(LOCALID_DECK_ALETHEA, 10, 7)
    addobject(LOCALID_DECK_ALETHEA)
    applymovement(LOCALID_DECK_ALETHEA, TriremeDeck_Movement_AletheaToBow)
    waitmovement(0)

    // The nest drifts across the glassy water toward the ram; two snatchers circle
    clearflag(FLAG_ICHOR_HIDE_HALCYON_NEST)
    addobject(LOCALID_DECK_NEST_EGGS)
    clearflag(FLAG_ICHOR_HIDE_DECK_HARPECK)
    addobject(LOCALID_DECK_HARPECK_1)
    addobject(LOCALID_DECK_HARPECK_2)
    applymovement(LOCALID_DECK_HARPECK_1, TriremeDeck_Movement_Circle)
    applymovement(LOCALID_DECK_HARPECK_2, TriremeDeck_Movement_Circle)
    applymovement(LOCALID_DECK_NEST_EGGS, TriremeDeck_Movement_Drift2)
    waitmovement(0)
    setspeaker(SP_NAME_NONE)
    msgbox(format("A floating nest, woven from seaweed and feathers.\p"
                  "It's drifting straight at the ram. Above it, two snatchers are diving."))
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("We can't turn! We'll lose the stroke!"))
    setspeaker(TriremeDeck_Text_NameAlethea)
    msgbox(format("Then we keep them off it! {PLAYER}, the bow!"))
    closemessage

    // Two scripted wild battles. Losing doesn't send the player home, and
    // there's no running from a snatcher at the nest.
    setvar(VAR_TEMP_2, 0)
    setflag(FLAG_ICHOR_NO_WHITEOUT)
    setflag(FLAG_ICHOR_NO_RUNNING)
    applymovement(LOCALID_DECK_HARPECK_1, TriremeDeck_Movement_Dive)
    waitmovement(0)
    playmoncry(SPECIES_HARPECK, CRY_MODE_ENCOUNTER)
    waitmoncry
    setwildbattle(SPECIES_HARPECK, 12)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_LOST || var(VAR_RESULT) == B_OUTCOME_DREW) {
        setvar(VAR_TEMP_2, 1)
    } else {
        removeobject(LOCALID_DECK_HARPECK_1)
    }
    setspeaker(SP_NAME_NONE)
    msgbox(format("The other one's diving!"))
    closemessage
    applymovement(LOCALID_DECK_HARPECK_2, TriremeDeck_Movement_Dive)
    waitmovement(0)
    playmoncry(SPECIES_HARPECK, CRY_MODE_ENCOUNTER)
    waitmoncry
    setwildbattle(SPECIES_HARPECK, 13)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_LOST || var(VAR_RESULT) == B_OUTCOME_DREW) {
        setvar(VAR_TEMP_2, 1)
    } else {
        removeobject(LOCALID_DECK_HARPECK_2)
    }
    clearflag(FLAG_ICHOR_NO_WHITEOUT)
    clearflag(FLAG_ICHOR_NO_RUNNING)
    if (var(VAR_TEMP_2) == 1) {
        special(HealPlayerParty)
    }

    // A third: Alethea's Spalunk drives it off, and any the player couldn't
    clearflag(FLAG_TEMP_3)
    addobject(LOCALID_DECK_HARPECK_3)
    applymovement(LOCALID_DECK_HARPECK_3, TriremeDeck_Movement_ThirdDives)
    waitmovement(0)
    setspeaker(TriremeDeck_Text_NameAlethea)
    msgbox(format("There's a third! Spalunk, go! Dig! …There's no dirt. Bite it!"))
    closemessage
    playse(SE_BALL_OPEN)
    clearflag(FLAG_TEMP_8)
    addobject(LOCALID_DECK_SPALUNK)
    delay(16)
    applymovement(LOCALID_DECK_SPALUNK, TriremeDeck_Movement_SpalunkUpTheRail)
    waitmovement(0)
    playse(SE_M_BITE)
    delay(12)
    playmoncry(SPECIES_HARPECK, CRY_MODE_FAINT)
    applymovement(LOCALID_DECK_HARPECK_3, TriremeDeck_Movement_FliesOff)
    if (var(VAR_TEMP_2) == 1) {
        applymovement(LOCALID_DECK_HARPECK_1, TriremeDeck_Movement_FliesOff)
        applymovement(LOCALID_DECK_HARPECK_2, TriremeDeck_Movement_FliesOff)
    }
    waitmovement(LOCALID_DECK_HARPECK_3)
    waitmoncry
    removeobject(LOCALID_DECK_HARPECK_3)
    if (var(VAR_TEMP_2) == 1) {
        removeobject(LOCALID_DECK_HARPECK_1)
        removeobject(LOCALID_DECK_HARPECK_2)
    }
    applymovement(LOCALID_DECK_SPALUNK, TriremeDeck_Movement_SpalunkBack)
    waitmovement(0)
    playse(SE_BALL)
    removeobject(LOCALID_DECK_SPALUNK)
    setspeaker(TriremeDeck_Text_NameAlethea)
    msgbox(format("I did it! I mean, it did it. I mostly shouted."))
    closemessage

    // The nest bumps the ram's bronze beak. A Galenyon drops out of the sky.
    applymovement(LOCALID_DECK_NEST_EGGS, TriremeDeck_Movement_Drift1)
    waitmovement(0)
    playse(SE_M_HARDEN)
    delay(30)
    clearflag(FLAG_TEMP_4)
    addobject(LOCALID_DECK_GALENYON)
    applymovement(LOCALID_DECK_GALENYON, TriremeDeck_Movement_GalenyonLands)
    waitmovement(0)
    playmoncry(SPECIES_GALENYON, CRY_MODE_NORMAL)
    waitmoncry
    delay(20)
    // One by one, the eggs crack: a peep, three times.
    // ICHOR_STUB_MUSIC: SCRIPT.md Part 9 asks for a chick's peep; a high cry stands in.
    removeobject(LOCALID_DECK_NEST_EGGS)
    clearflag(FLAG_TEMP_1)
    addobject(LOCALID_DECK_NEST_HATCHING)
    playmoncry(SPECIES_HALCYLING, CRY_MODE_HIGH_PITCH)
    waitmoncry
    delay(24)
    playmoncry(SPECIES_HALCYLING, CRY_MODE_HIGH_PITCH)
    waitmoncry
    delay(24)
    playmoncry(SPECIES_HALCYLING, CRY_MODE_HIGH_PITCH)
    waitmoncry
    removeobject(LOCALID_DECK_NEST_HATCHING)
    clearflag(FLAG_TEMP_2)
    addobject(LOCALID_DECK_NEST_EMPTY)
    clearflag(FLAG_TEMP_5)
    clearflag(FLAG_TEMP_6)
    clearflag(FLAG_TEMP_7)
    addobject(LOCALID_DECK_CHICK_1)
    addobject(LOCALID_DECK_CHICK_2)
    addobject(LOCALID_DECK_CHICK_3)
    setspeaker(SP_NAME_NONE)
    msgbox(format("The eggs are hatching. One, two, three."))
    closemessage
    delay(30)

    // The sail fills with a crack: the wind is back, and the sailing song
    playse(SE_M_GUST)
    call(TriremeDeck_EventScript_SailFill)
    special(DrawWholeMapView)
    delay(12)
    call(TriremeDeck_EventScript_SailFull)
    call(TriremeDeck_EventScript_OarsIn)
    call(TriremeDeck_EventScript_KlepsydraDown)
    special(DrawWholeMapView)
    setvar(VAR_TEMP_1, 0)
    delay(30)
    playbgm(MUS_ICHOR_TRIREME, FALSE)
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("WIND! Ha! The last of them's hatched!\p"
                  "That's halcyon days. Flat sea till the chicks are out.\p"
                  "Then Aeolus lets go."))
    closemessage

    // The Galenyon lifts two chicks onto its back and flies. The third stays.
    applymovement(LOCALID_DECK_CHICK_1, TriremeDeck_Movement_ChickToParent1)
    applymovement(LOCALID_DECK_CHICK_2, TriremeDeck_Movement_ChickToParent2)
    waitmovement(0)
    removeobject(LOCALID_DECK_CHICK_1)
    removeobject(LOCALID_DECK_CHICK_2)
    applymovement(LOCALID_DECK_GALENYON, TriremeDeck_Movement_GalenyonFlies)
    waitmovement(0)
    removeobject(LOCALID_DECK_GALENYON)
    // ...and hops onto the rail, then onto the player's petasos
    setobjectsubpriority(LOCALID_DECK_CHICK_3, MAP_TRIREME_EUPLOIA_DECK, 0)
    setobjectsubpriority(OBJ_EVENT_ID_PLAYER, MAP_TRIREME_EUPLOIA_DECK, 1)
    applymovement(LOCALID_DECK_CHICK_3, TriremeDeck_Movement_ChickToHat)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_FaceDown)
    waitmovement(0)
    setspeaker(SP_NAME_NONE)
    msgbox(format("A halcyon chick has hopped onto your hat. It doesn't look like leaving.\p"
                  "Take it with you?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        call(TriremeDeck_EventScript_TakeChick)
    } else {
        msgbox(format("The chick ruffles up, offended, and flies after its family."))
        closemessage
        applymovement(LOCALID_DECK_CHICK_3, TriremeDeck_Movement_FliesOff)
        waitmovement(0)
        removeobject(LOCALID_DECK_CHICK_3)
    }
    resetobjectsubpriority(OBJ_EVENT_ID_PLAYER, MAP_TRIREME_EUPLOIA_DECK)
    setflag(FLAG_ICHOR_SAVED_HALCYON_NEST)
    applymovement(LOCALID_DECK_NEST_EMPTY, TriremeDeck_Movement_NestAway)
    waitmovement(0)
    removeobject(LOCALID_DECK_NEST_EMPTY)

    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("Left… and… left… Are we there yet?"))
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("Not even close, lad. That calm cost us half a day.\p"
                  "We'll put in at Aigina for the night. Emporion in the morning."))
    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("Aigina's land, right? Solid land?"))
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("Solid as Lakonia."))
    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("…Bless Aigina."))
    closemessage
    goto(TriremeDeck_EventScript_NightLeg)
}

script TriremeDeck_EventScript_TakeChick {
    removeobject(LOCALID_DECK_CHICK_3)
    givemon(SPECIES_HALCYLING, 11, move1=MOVE_WATER_GUN, move2=MOVE_WING_ATTACK,
            move3=MOVE_QUICK_ATTACK, move4=MOVE_MIST)
    if (var(VAR_RESULT) == MON_CANT_GIVE) {
        msgbox(gText_NoMoreRoomForPokemon)
        return
    }
    copyvar(VAR_0x8008, VAR_RESULT)
    playfanfare(MUS_ICHOR_OBTAIN_MON)
    message(format("{PLAYER} received a Halcyling!"))
    waitmessage
    waitfanfare
    setflag(FLAG_ICHOR_GOT_HALCYLING)
    // the vanilla nickname prompt (it names the stand-in species until the dex lands)
    bufferspeciesname(STR_VAR_1, SPECIES_HALCYLING)
    msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
    if (var(VAR_0x8008) == MON_GIVEN_TO_PARTY) {
        if (var(VAR_RESULT) == YES) {
            call(Common_EventScript_GetGiftMonPartySlot)
            call(Common_EventScript_NameReceivedPartyMon)
        }
    } else {
        if (var(VAR_RESULT) == YES) {
            call(Common_EventScript_NameReceivedBoxMon)
        }
        call(Common_EventScript_TransferredToPC)
    }
    closemessage
}

// ---------------------------------------------------------------------------
// The night leg: Kleon's letter, the wrong-way tide, the trireme with no lamps
// ---------------------------------------------------------------------------

script TriremeDeck_EventScript_NightLeg {
    fadescreen(FADE_TO_BLACK)
    // the night tint, whatever the clock says, until the inn
    setvar(VAR_0x8004, 22)
    special(Ichor_SetHoursOverride)
    // Places for the night, live or respawned (anyone may be off screen).
    // Kleon is at the rail again, no longer green, reading his mother's
    // tablet: his pose swaps as in the calm, his hide flag cleared at once.
    setobjectxyperm(LOCALID_DECK_KLEON, 7, 4)
    setobjectmovementtype(LOCALID_DECK_KLEON, MOVEMENT_TYPE_FACE_UP)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ICHOR_KLEON_TABLET)
    removeobject(LOCALID_DECK_KLEON)
    addobject(LOCALID_DECK_KLEON)
    clearflag(FLAG_ICHOR_CROSSING_DONE)
    setobjectxyperm(LOCALID_DECK_ALETHEA, 10, 7)
    setobjectxy(LOCALID_DECK_ALETHEA, 10, 7)
    addobject(LOCALID_DECK_ALETHEA)
    turnobject(LOCALID_DECK_ALETHEA, DIR_SOUTH)
    setobjectxyperm(LOCALID_DECK_LOOKOUT, 9, 5)
    setobjectxy(LOCALID_DECK_LOOKOUT, 9, 5)
    addobject(LOCALID_DECK_LOOKOUT)
    turnobject(LOCALID_DECK_LOOKOUT, DIR_NORTH)
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_PlayerToNightRail)
    waitmovement(0)
    special(DrawWholeMapView)
    delay(30)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    applymovement(LOCALID_DECK_KLEON, TriremeDeck_Movement_FaceRight)
    waitmovement(0)
    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("{PLAYER}. Can't sleep either?\p"
                  "Letter from my mother. Came on the gull boat before we sailed.\p"
                  "My mother writes every week. Two lines. Lakonian.\p"
                  "“Eat. Don't be stupid.”\p"
                  "That's a long one, for her."))
    closemessage
    delay(30)

    // A creak. The water hisses along the hull, running forward. The ship
    // slides back a tile, then steadies.
    // ICHOR_STUB_MUSIC: no hull-creak sound yet; a door's creak stands in.
    playse(SE_DOOR)
    delay(10)
    playse(SE_M_SURF)
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_SlideAft)
    applymovement(LOCALID_DECK_KLEON, TriremeDeck_Movement_SlideAft)
    applymovement(LOCALID_DECK_LOOKOUT, TriremeDeck_Movement_SlideAft)
    setvar(VAR_0x8004, 2)
    setvar(VAR_0x8005, 0)
    setvar(VAR_0x8006, 4)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    waitstate
    waitmovement(0)
    delay(40)
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("There it goes again. The tide, running the wrong way.\p"
                  "Third night this month. Never seen it in forty years at sea."))
    closemessage
    delay(30)

    // A long dark shape slides past to starboard: no lamps, oars muffled in
    // leather, and for a moment a sickle on its furled sail
    applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_FaceUp)
    applymovement(LOCALID_DECK_KLEON, TriremeDeck_Movement_FaceUp)
    waitmovement(0)
    // the camera follows their eyes forward, past the sail to open water
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, TriremeDeck_Movement_CameraForward)
    waitmovement(0)
    clearflag(FLAG_TEMP_9)
    clearflag(FLAG_TEMP_A)
    addobject(LOCALID_DECK_DARK_BOW)
    addobject(LOCALID_DECK_DARK_STERN)
    applymovement(LOCALID_DECK_DARK_BOW, TriremeDeck_Movement_DarkTriremePasses)
    applymovement(LOCALID_DECK_DARK_STERN, TriremeDeck_Movement_DarkTriremePasses)
    waitmovement(LOCALID_DECK_DARK_STERN)
    removeobject(LOCALID_DECK_DARK_BOW)
    removeobject(LOCALID_DECK_DARK_STERN)
    delay(30)
    applymovement(OBJ_EVENT_ID_CAMERA, TriremeDeck_Movement_CameraBack)
    waitmovement(0)
    special(RemoveCameraObject)
    applymovement(LOCALID_DECK_LOOKOUT, TriremeDeck_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(TriremeDeck_Text_NameSailor)
    msgbox(format("No lights. No flag. Nobody rows at night without lights…\p"
                  "…unless they're ashamed of something.\p"
                  "Strange times. My cousin's just back from Delphoi.\p"
                  "The Pythia only says “soon” now. To everyone. About everything."))
    applymovement(LOCALID_DECK_KLEON, TriremeDeck_Movement_FaceRight)
    waitmovement(0)
    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("Soon what?"))
    setspeaker(TriremeDeck_Text_NameSailor)
    msgbox(format("That's what everyone asks."))
    closemessage
    delay(40)
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("Aigina. Bed, the lot of you."))
    closemessage
    // Aigina's quay: warp 0 is the arrival tile below the gangplank, where
    // Aigina's own script plays the arrival and keeps the night tint.
    warp(MAP_AEGINA_TOWN, 0)
    waitstate
    releaseall
}

// ---------------------------------------------------------------------------
// Beat 10C: the last leg. The player can't walk; the mainland comes up ahead.
// ---------------------------------------------------------------------------

script TriremeDeck_EventScript_LastLeg {
    lockall
    setvar(VAR_TEMP_0, 4)
    hidefollower
    delay(30)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 13 && var(VAR_0x8005) == 4) {
        // from the gangway to the starboard rail, where the coast is in view
        applymovement(OBJ_EVENT_ID_PLAYER, TriremeDeck_Movement_ToLastLegRail)
        waitmovement(0)
    }
    delay(30)
    setspeaker(Ichor_Text_NameNausikles)
    msgbox(format("There she is. Emporion. Harbor of the whole wide world.\p"
                  "Hold on to your purse. With both hands."))
    setspeaker(TriremeDeck_Text_NameAlethea)
    msgbox(format("That's the mainland. It's bigger than I thought. It just keeps going."))
    setspeaker(TriremeDeck_Text_NameKleon)
    msgbox(format("All of that. And somewhere in it, the next laurel."))
    closemessage
    delay(30)
    // The stub fades to black itself: fading here first would save a black
    // palette (FadeSelectedPals copies faded over unfaded on every fade out).
    call(Ichor_EventScript_EuploiaMakesEmporion)
    // ICHOR_STUB_EMPORION: until batch 2 makes the call above a warp to
    // Emporion's quay, the player stays on deck: the voyage cast goes ashore
    // (their flag is FLAG_ICHOR_CROSSING_DONE) and the coast drops astern.
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_DECK_KLEON)
    removeobject(LOCALID_DECK_ALETHEA)
    call(TriremeDeck_EventScript_CoastOff)
    special(DrawWholeMapView)
    fadescreen(FADE_FROM_BLACK)
    releaseall
}

// ---------------------------------------------------------------------------
// Movements
// ---------------------------------------------------------------------------

movement TriremeDeck_Movement_FaceUp { face_up }
movement TriremeDeck_Movement_FaceDown { face_down }
movement TriremeDeck_Movement_FaceLeft { face_left }
movement TriremeDeck_Movement_FaceRight { face_right }
// Kleon over the rail: the heave (his seasick pose walking in place)
movement TriremeDeck_Movement_KleonHeave { walk_in_place_slow_up * 3 }

// to the helm at (19,6), from beside Nausikles at (18,7) or below him at (19,8)
movement TriremeDeck_Movement_HelmFromWest { walk_up walk_right face_right }
movement TriremeDeck_Movement_HelmFromSouth { walk_left walk_up * 2 walk_right face_right }

// Kleon from the starboard rail (7,4) onto the hatch (14,7), still green
movement TriremeDeck_Movement_KleonToHatch {
    face_right
    walk_slow_right * 6
    walk_slow_down * 3
    walk_slow_right
    face_down
}

// the player from the trigger line at x = 8 to the bow at (3,6)
movement TriremeDeck_Movement_ToBowRow4 { walk_down * 2 walk_left * 5 face_left }
movement TriremeDeck_Movement_ToBowRow5 { walk_down walk_left * 5 face_left }
movement TriremeDeck_Movement_ToBowRow6 { walk_left * 5 face_left }
movement TriremeDeck_Movement_ToBowRow7 { walk_up walk_left * 5 face_left }
movement TriremeDeck_Movement_ToBowRow8 { walk_up * 2 walk_left * 5 face_left }
movement TriremeDeck_Movement_ToBowRow9 { walk_up * 3 walk_left * 5 face_left }

// Alethea from the mast (10,7) to (4,7), beside the player
movement TriremeDeck_Movement_AletheaToBow { walk_fast_left * 6 face_left }

// the snatchers wheel over the nest, then stoop at it
movement TriremeDeck_Movement_Circle {
    walk_right walk_down walk_left walk_up
    walk_right walk_down walk_left walk_up
}
movement TriremeDeck_Movement_Dive { walk_faster_down * 3 face_down }
movement TriremeDeck_Movement_ThirdDives { walk_faster_down * 6 face_down }
movement TriremeDeck_Movement_FliesOff { walk_faster_up * 4 walk_faster_left * 4 walk_faster_up * 4 }

// the nest drifting on the flat sea toward the ram
movement TriremeDeck_Movement_Drift2 { walk_slow_down * 2 }
movement TriremeDeck_Movement_Drift1 { walk_slow_down }
movement TriremeDeck_Movement_NestAway { walk_slow_left * 3 }

// Spalunk scrambles up the bow rail at (3,8) and bites
movement TriremeDeck_Movement_SpalunkUpTheRail { walk_fast_left face_left jump_in_place_left }
movement TriremeDeck_Movement_SpalunkBack { walk_right face_up }

// the Galenyon drops onto the ram at (1,9), and later lifts off
movement TriremeDeck_Movement_GalenyonLands { walk_faster_down * 7 face_down }
movement TriremeDeck_Movement_GalenyonFlies { face_up walk_faster_up * 8 walk_faster_left * 4 }
movement TriremeDeck_Movement_ChickToParent1 { jump_in_place_down walk_right walk_down }
movement TriremeDeck_Movement_ChickToParent2 { jump_in_place_down walk_down }

// the third chick: onto the rail at (2,7), across to (3,7), then a hop onto the
// player's hat at (3,5)
movement TriremeDeck_Movement_ChickToHat {
    jump_up
    jump_up
    jump_right
    jump_2_up
    face_down
}

// the night: the player from the bow (3,6) to the rail at (8,4), beside Kleon
movement TriremeDeck_Movement_PlayerToNightRail { walk_faster_right * 5 walk_faster_up * 2 face_left }

// the wrong-way tide: everyone slides a tile toward the stern
movement TriremeDeck_Movement_SlideAft { lock_facing_direction slide_right unlock_facing_direction }

// the dark trireme sliding past, west along the starboard horizon: out from
// behind the sail at (12,2)/(16,2) and off past the bow
movement TriremeDeck_Movement_DarkTriremePasses { walk_left * 22 }

// the camera looking forward along the deck, and back
movement TriremeDeck_Movement_CameraForward { walk_slow_left * 5 }
movement TriremeDeck_Movement_CameraBack { walk_slow_right * 5 }

// beat 10C: from the gangway (13,4) to the rail at (8,4)
movement TriremeDeck_Movement_ToLastLegRail { walk_left * 5 face_up }

