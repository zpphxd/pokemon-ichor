// Route 9, the Split Road: beat 36 (the crossroads, the lookout, the treasury
// ruin) and the road's roster. Text from design/phase3/SCRIPT.md: beat 36, Part 2
// (Route 9) and Part 3 (Route 9 trainers). Layout and events are generated by
// tools/ichor/maps/parnassos.py.
//
// Staging (map coordinates): the road comes in from Lebadeia on rows 20-21 and
// climbs the cleft (x 37-38) to the crossroads' paving. Alethea waits at (32,17);
// the crossroads scene fires on the paving's east edge, (34,16) and (34,17). The
// lookout scene fires at (11,7) and (11,8), with Alethea's lookout object at
// (13,8). The treasury's drums start at (17,23), (19,21) and (18,19); a drum
// pushed onto a gully's lip rolls in when the player steps where it stood.

mapscripts Route9_Schiste_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // beat 36A: Alethea walks on from Lebadeia with you
        if (flag(FLAG_ICHOR_VISITED_LEBADEIA) && !flag(FLAG_ICHOR_HIDE_ALETHEA_LEBADEIA)) {
            setflag(FLAG_ICHOR_HIDE_ALETHEA_LEBADEIA)
        }
        if (flag(FLAG_ICHOR_SCHISTE_ARRIVED)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            setvar(VAR_TEMP_1, 0)
        }
        if (flag(FLAG_ICHOR_ROUTE9_LOOKOUT_SEEN) || flag(FLAG_ICHOR_HIDE_ALETHEA_ROUTE9)) {
            setvar(VAR_TEMP_6, 1)
        } else {
            setvar(VAR_TEMP_6, 0)
        }
        if (flag(FLAG_ICHOR_HIDE_ALETHEA_ROUTE9) || !flag(FLAG_ICHOR_SCHISTE_ARRIVED)) {
            setvar(VAR_TEMP_5, 1)
        } else {
            setvar(VAR_TEMP_5, 0)
        }
        // the lookout's Alethea shows only in her scene
        setflag(FLAG_TEMP_14)
        // the treasury's drums: back where they fell, until the path is cleared
        if (flag(FLAG_ICHOR_HIDE_SCHISTE_DRUMS)) {
            setflag(FLAG_TEMP_11)
            setflag(FLAG_TEMP_12)
            setflag(FLAG_TEMP_13)
            setvar(VAR_TEMP_7, 1)
            setvar(VAR_TEMP_4, 1)
        }
        // ICHOR_STUB_OMENS: the omen's Enigmaw sits on the boundary stone once an
        // augur has told it (SYSTEMS.md section 6), until it is caught or beaten
        if (!flag(FLAG_ICHOR_OMEN_SCHISTE_TOLD) || flag(FLAG_ICHOR_OMEN_SCHISTE_ENIGMAW)) {
            setflag(FLAG_TEMP_15)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_HIDE_SCHISTE_DRUMS)) {
            call(Route9_Schiste_EventScript_SetDrumsAtRest)
        }
        if (flag(FLAG_ICHOR_ALTARS_START + 9)) {
            setmetatile(32, 15, METATILE_Parnassos_AltarApollo, TRUE)
        }
    }
}

// The three drums at rest: two down in the gully, one in the alcove where it stopped.
script Route9_Schiste_EventScript_SetDrumsAtRest {
    setmetatile(16, 19, METATILE_Parnassos_DrumGully, TRUE)
    setmetatile(15, 23, METATILE_Parnassos_DrumGully_B, TRUE)
    setmetatile(20, 21, METATILE_Parnassos_Drum, TRUE)
}

text Route9_Schiste_Text_SpeakerAlethea { "ALETHEA" }
text Route9_Schiste_Text_SpeakerXenodike { "XENODIKE" }
text Route9_Schiste_Text_SpeakerOldMan { "OLD MAN" }
text Route9_Schiste_Text_SpeakerKoretas { "KORETAS" }
text Route9_Schiste_Text_SpeakerOnomarchos { "ONOMARCHOS" }
text Route9_Schiste_Text_SpeakerPsephos { "PSEPHOS" }
text Route9_Schiste_Text_SpeakerPhayllos { "PHAYLLOS" }
text Route9_Schiste_Text_SpeakerLykoreus { "LYKOREUS" }

// --- beat 36A: where three roads meet --------------------------------------------------
script Route9_Schiste_EventScript_Crossroads {
    lockall
    setflag(FLAG_ICHOR_SCHISTE_ARRIVED)
    setvar(VAR_TEMP_1, 1)
    setvar(VAR_TEMP_5, 0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    applymovement(LOCALID_ROUTE9_ALETHEA, Common_Movement_FaceRight)
    waitmovement(0)
    // The camera climbs the north-west road: the cliffs, the falls, the roofs.
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Route9_Schiste_Movement_CameraToDelphoi)
    waitmovement(0)
    setspeaker(Route9_Schiste_Text_SpeakerAlethea)
    msgbox(format("That's Delphoi. Up there, between the cliffs."))
    msgbox(format("The Pythia's temple. The navel of the world, they say."))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, Route9_Schiste_Movement_CameraBack)
    waitmovement(0)
    special(RemoveCameraObject)
    setspeaker(Route9_Schiste_Text_SpeakerAlethea)
    msgbox(format("The road down to the right goes to Kirrha. Delphoi's harbor."))
    msgbox(format("Kleon will have gone that way. To the ferry. Arkadia's across the water."))
    msgbox(format("The road up to Delphoi starts at Kirrha. This path only goes to a lookout."))
    msgbox(format("…I want to see it anyway. From as close as we can get. Indulge me."))
    closemessage
    releaseall
}

movement Route9_Schiste_Movement_CameraToDelphoi {
    walk_fast_up * 10
    walk_fast_left * 22
}

movement Route9_Schiste_Movement_CameraBack {
    walk_fast_right * 22
    walk_fast_down * 10
}

script Route9_Schiste_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(Route9_Schiste_Text_SpeakerAlethea)
    if (flag(FLAG_ICHOR_ROUTE9_LOOKOUT_SEEN)) {
        msgbox(format("A house where everyone's holding their breath. I can't stop thinking it."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("The lookout's up the north-west path. Indulge me. Truthfully, I'll follow you."), MSGBOX_DEFAULT)
    }
    release
}

script Route9_Schiste_EventScript_AletheaLookout {
    lock
    faceplayer
    setspeaker(Route9_Schiste_Text_SpeakerAlethea)
    msgbox(format("Nobody's sacrificing. Nobody's asking anything."), MSGBOX_DEFAULT)
    release
}

// When you go on down toward Kirrha, Alethea goes ahead (beat 37A is hers there).
script Route9_Schiste_EventScript_TowardKirrha {
    setflag(FLAG_ICHOR_HIDE_ALETHEA_ROUTE9)
    setvar(VAR_TEMP_5, 1)
    setvar(VAR_TEMP_6, 1)
}

// --- beat 36B: the lookout -----------------------------------------------------------------
script Route9_Schiste_EventScript_Lookout {
    lockall
    setflag(FLAG_ICHOR_ROUTE9_LOOKOUT_SEEN)
    setvar(VAR_TEMP_6, 1)
    // Alethea comes up the goat path behind you and stops at your side.
    clearflag(FLAG_TEMP_14)
    addobject(LOCALID_ROUTE9_ALETHEA_LOOKOUT)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8005) == 7) {
        setobjectxy(LOCALID_ROUTE9_ALETHEA_LOOKOUT, 13, 8)
        applymovement(LOCALID_ROUTE9_ALETHEA_LOOKOUT, Route9_Schiste_Movement_AletheaUpBeside)
    } else {
        setobjectxy(LOCALID_ROUTE9_ALETHEA_LOOKOUT, 13, 7)
        applymovement(LOCALID_ROUTE9_ALETHEA_LOOKOUT, Route9_Schiste_Movement_AletheaDownBeside)
    }
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    // The camera lifts to the sanctuary: the temple, the theater, the falls.
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Route9_Schiste_Movement_CameraUp)
    waitmovement(0)
    setspeaker(Route9_Schiste_Text_SpeakerAlethea)
    msgbox(format("There it is. The navel of the world."))
    msgbox(format("Pilgrims come up here to look, before they go round by Kirrha."))
    msgbox(format("…There's no smoke. There's always smoke over Delphoi. From the altar."))
    msgbox(format("Nobody's sacrificing. Nobody's asking anything."))
    msgbox(format("Truthfully, it looks like a house where everyone's holding their breath."))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, Route9_Schiste_Movement_CameraDown)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}

movement Route9_Schiste_Movement_AletheaUpBeside {
    walk_left
    walk_up
    face_up
}

movement Route9_Schiste_Movement_AletheaDownBeside {
    walk_left
    walk_down
    face_up
}

movement Route9_Schiste_Movement_CameraUp {
    walk_slow_left * 2
    walk_slow_up * 3
}

movement Route9_Schiste_Movement_CameraDown {
    walk_down * 3
    walk_right * 2
}

script Route9_Schiste_EventScript_Falls {
    msgbox(format("High above, the Kastalian spring falls down its gorge in a white rope of water.\pA path climbs beside it from the valley below Kirrha, toward the temple."), MSGBOX_SIGN)
}

script Route9_Schiste_EventScript_Cairn {
    msgbox(format("A heap of small stones. Every pilgrim adds one, for the climb.\pSomebody has scratched a word on the top stone: SOON."), MSGBOX_SIGN)
}

// --- Xenodike on the lookout's bench (Kirrha's inn quest) --------------------------------
// ICHOR_STUB_KEY_ITEMS: the fig is FLAG_ICHOR_PYLADES_FIG until ITEM_PYLADES_FIG exists;
// then take it here with removeitem(ITEM_PYLADES_FIG).
script Route9_Schiste_EventScript_Xenodike {
    lock
    faceplayer
    setspeaker(Route9_Schiste_Text_SpeakerXenodike)
    if (flag(FLAG_ICHOR_PYLADES_FIG) && !flag(FLAG_ICHOR_XENODIKE_CAME_DOWN)) {
        msgbox(format("A fig on a string. That's Pylades. That idiot."))
        msgbox(format("…He's still waiting for me? Nine days?"))
        msgbox(format("I came to ask the god if he'd wait for me. If I went away to Astyra."))
        msgbox(format("I suppose I didn't need the god for that."))
        closemessage
        setflag(FLAG_ICHOR_XENODIKE_CAME_DOWN)
        applymovement(LOCALID_ROUTE9_XENODIKE, Route9_Schiste_Movement_XenodikeLeaves)
        waitmovement(0)
        removeobject(LOCALID_ROUTE9_XENODIKE)
        setflag(FLAG_ICHOR_HIDE_XENODIKE_LOOKOUT)
        release
        end
    }
    msgbox(format("I came to ask the god one question. I can see his house from here."))
    msgbox(format("When the altar smokes again, I'll go down and ask. Not before."))
    msgbox(format("Nine days. The goatherds bring me bread. I think they feel bad."), MSGBOX_DEFAULT)
    release
}

movement Route9_Schiste_Movement_XenodikeLeaves {
    walk_down
    walk_right * 5
}

// --- the crossroads' people, the stone, the omen ----------------------------------------
script Route9_Schiste_EventScript_OldMan {
    lock
    faceplayer
    setspeaker(Route9_Schiste_Text_SpeakerOldMan)
    msgbox(format("Three roads. Everybody stops here and argues about who goes first."))
    msgbox(format("I sit here so they argue with me instead. It's safer."), MSGBOX_DEFAULT)
    release
}

script Route9_Schiste_EventScript_Enigmaw {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_ENIGMAW, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_ENIGMAW, 32)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_RAN && var(VAR_RESULT) != B_OUTCOME_PLAYER_TELEPORTED
        && var(VAR_RESULT) != B_OUTCOME_LOST) {
        setflag(FLAG_ICHOR_OMEN_SCHISTE_ENIGMAW)
        removeobject(LOCALID_ROUTE9_ENIGMAW)
    }
    release
}

// The great herm doubles as the crossroads' sign; then the anointing (ENGINE_API section 4).
script Route9_Schiste_EventScript_GreatHerm {
    lockall
    msgbox(format("A great herm at the meeting of three roads. Hermes's face is worn smooth.\p“East: Lebadeia. North: Delphoi. South: Kirrha and the sea.”"))
    closemessage
    call(EventScript_IchorAnointHerm)
    releaseall
}

// --- Apollo's laurel shrine (desecrated; Psephos guards it) -----------------------------
script Route9_Schiste_EventScript_Shrine {
    lockall
    if (!flag(FLAG_ICHOR_HIDE_GRUNT_PSEPHOS)) {
        msgbox(format("A shrine of Apollo, under a laurel.\pSomeone has scratched a sickle across the god's face."))
        releaseall
        end
    }
    setvar(VAR_0x8004, ICHOR_GOD_APOLLO)
    setvar(VAR_0x8005, 9)
    goto(EventScript_IchorDesecratedAltar)
}

// The shrine's laurel gives one sprig a day (SYSTEMS.md section 3). Its daily flag is
// the laurel range's index 9, this agent's pick until the world-act2 session
// assigns the range: FLAG_DAILY_ICHOR_LAUREL_ROUTE9 in SCRIPT.md Part 8.
script Route9_Schiste_EventScript_LaurelTree {
    lockall
    if (flag(FLAG_DAILY_ICHOR_LAUREL_START + 9)) {
        msgbox(format("Apollo's laurel. You've taken today's sprig. Leave the rest for the god."))
        releaseall
        end
    }
    msgbox(format("Apollo's laurel, by the shrine. One sprig would do no harm."))
    closemessage
    setflag(FLAG_DAILY_ICHOR_LAUREL_START + 9)
    giveitem(ITEM_LAUREL_SPRIG)
    releaseall
}

// --- trainers, in road order -------------------------------------------------------------
script Route9_Schiste_EventScript_Koretas {
    trainerbattle_single(TRAINER_ICHOR_KORETAS, Route9_Schiste_Text_KoretasIntro, Route9_Schiste_Text_KoretasDefeat)
    setspeaker(Route9_Schiste_Text_SpeakerKoretas)
    msgbox(format("Goats sniffed a hole, and now there's a temple. That's how it goes.\pNobody ever builds a temple for the goats."), MSGBOX_AUTOCLOSE)
}

text Route9_Schiste_Text_KoretasIntro {
    format("My goats found the god's crack in the rock. Well. Great-grandad's did.")
}

text Route9_Schiste_Text_KoretasDefeat {
    format("The goats are laughing at me. I can tell.")
}

script Route9_Schiste_EventScript_Goat {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_KERAZAP, CRY_MODE_NORMAL)
    msgbox(format("A Kerazap, grazing. It bleats, and a spark jumps between its horns."), MSGBOX_DEFAULT)
    waitmoncry
    release
}

script Route9_Schiste_EventScript_Onomarchos {
    trainerbattle_single(TRAINER_ICHOR_ONOMARCHOS, Route9_Schiste_Text_OnomarchosIntro, Route9_Schiste_Text_OnomarchosDefeat)
    setspeaker(Route9_Schiste_Text_SpeakerOnomarchos)
    msgbox(format("Soon, the guards said. The Pythia says soon. Everyone says soon.\pI've decided to be happy now instead. It's quicker."), MSGBOX_AUTOCLOSE)
}

text Route9_Schiste_Text_OnomarchosIntro {
    format("Turned away at the gate! Nine days' walk! I need to hit something.")
}

text Route9_Schiste_Text_OnomarchosDefeat {
    format("…I feel a lot better, actually.")
}

script Route9_Schiste_EventScript_Psephos {
    trainerbattle_single(TRAINER_ICHOR_GRUNT_ROUTE9_PSEPHOS, Route9_Schiste_Text_PsephosIntro, Route9_Schiste_Text_PsephosDefeat, Route9_Schiste_EventScript_PsephosLeaves)
    setspeaker(Route9_Schiste_Text_SpeakerPsephos)
    msgbox(format("Soon nobody gets told anything, the Titans say.\pI'd like a turn being surprised."), MSGBOX_AUTOCLOSE)
}

// After the battle he walks off toward Kirrha.
script Route9_Schiste_EventScript_PsephosLeaves {
    lock
    setspeaker(Route9_Schiste_Text_SpeakerPsephos)
    msgbox(format("Soon nobody gets told anything, the Titans say.\pI'd like a turn being surprised."))
    closemessage
    applymovement(LOCALID_ROUTE9_PSEPHOS, Route9_Schiste_Movement_PsephosLeaves)
    waitmovement(0)
    removeobject(LOCALID_ROUTE9_PSEPHOS)
    setflag(FLAG_ICHOR_HIDE_GRUNT_PSEPHOS)
    release
}

// from (32,16): west along the paving, down past the stone, out the south-west corner
movement Route9_Schiste_Movement_PsephosLeaves {
    walk_left * 4
    walk_down * 4
    walk_left * 3
    walk_down * 2
}

text Route9_Schiste_Text_PsephosIntro {
    format("The rich come up here, ask the god, and plan their whole lives round it.\pI got told I'd be poor. By a village seer. For free. Fight me.")
}

text Route9_Schiste_Text_PsephosDefeat {
    format("Of course. Even you were written to win.")
}

script Route9_Schiste_EventScript_Phayllos {
    trainerbattle_single(TRAINER_ICHOR_PHAYLLOS, Route9_Schiste_Text_PhayllosIntro, Route9_Schiste_Text_PhayllosDefeat)
    setspeaker(Route9_Schiste_Text_SpeakerPhayllos)
    msgbox(format("If the god doesn't open up, there's no games. I'll just run. For nothing.\pRunning for nothing is still running. I've checked."), MSGBOX_AUTOCLOSE)
}

text Route9_Schiste_Text_PhayllosIntro {
    format("Training for the Pythian games! If there are any this year.")
}

text Route9_Schiste_Text_PhayllosDefeat {
    format("Out-run. On my own hill.")
}

script Route9_Schiste_EventScript_Lykoreus {
    trainerbattle_single(TRAINER_ICHOR_LYKOREUS, Route9_Schiste_Text_LykoreusIntro, Route9_Schiste_Text_LykoreusDefeat)
    setspeaker(Route9_Schiste_Text_SpeakerLykoreus)
    msgbox(format("The flood came, and wolves showed them the way up. Funny thing to trust.\pYou'd follow anything that seemed to know where it was going, though."), MSGBOX_AUTOCLOSE)
}

text Route9_Schiste_Text_LykoreusIntro {
    format("My ancestors climbed this mountain following wolves. I'm following sheep.")
}

text Route9_Schiste_Text_LykoreusDefeat {
    format("Wolves would've won.")
}

// --- beat 36C: the treasury ruin's drums ------------------------------------------------
// The drums are EventScript_StrengthBoulder objects (the Girdle: ENGINE_API section 2).
// A drum pushed west onto a gully's lip teeters there; when the player steps into the
// place it stood, it rolls over the edge. Each starts hidden by a temp flag, so
// walking off the map puts them all back; FLAG_ICHOR_HIDE_SCHISTE_DRUMS keeps them
// gone once the path is open.
script Route9_Schiste_EventScript_DrumRoll1 {
    lockall
    setvar(VAR_TEMP_7, 1)
    getobjectxy(LOCALID_ROUTE9_DRUM_1, CURRENT_POSITION, VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 16 && var(VAR_0x8005) == 23) {
        call(Route9_Schiste_EventScript_Rumble)
        applymovement(LOCALID_ROUTE9_DRUM_1, Route9_Schiste_Movement_DrumOverTheEdge)
        waitmovement(0)
        removeobject(LOCALID_ROUTE9_DRUM_1)
        setmetatile(15, 23, METATILE_Parnassos_DrumGully_B, TRUE)
        special(DrawWholeMapView)
        msgbox(format("The drum rolls over the edge. It's still rolling."))
        closemessage
    }
    releaseall
}

script Route9_Schiste_EventScript_DrumRoll3 {
    lockall
    setvar(VAR_TEMP_4, 1)
    getobjectxy(LOCALID_ROUTE9_DRUM_3, CURRENT_POSITION, VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 17 && var(VAR_0x8005) == 19) {
        call(Route9_Schiste_EventScript_Rumble)
        applymovement(LOCALID_ROUTE9_DRUM_3, Route9_Schiste_Movement_DrumOverTheEdge)
        waitmovement(0)
        removeobject(LOCALID_ROUTE9_DRUM_3)
        setmetatile(16, 19, METATILE_Parnassos_DrumGully, TRUE)
        special(DrawWholeMapView)
        msgbox(format("The drum rolls over the edge into the gully, after the first."))
        closemessage
        setflag(FLAG_ICHOR_HIDE_SCHISTE_DRUMS)
    }
    releaseall
}

script Route9_Schiste_EventScript_Rumble {
    playse(SE_M_STRENGTH)
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 1)
    setvar(VAR_0x8006, 8)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    waitstate
    return
}

movement Route9_Schiste_Movement_DrumOverTheEdge {
    jump_left
}

script Route9_Schiste_EventScript_TreasuryView {
    msgbox(format("The treasury's floor is still paved. Somebody's city kept its gold here once.\pAcross the water, the mountains of Arkadia stand up out of the haze."), MSGBOX_SIGN)
}

// --- the Sphinx's seat (a dead end that pays) --------------------------------------------
script Route9_Schiste_EventScript_SphinxSeat {
    msgbox(format("A flat rock high over the crossroads, strewn with big pale feathers.\pSomething large comes up here to watch the three roads."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: the gully's fixed dig, past the broken bridge (the Winged Talaria).
// Once digs exist: setvar(VAR_0x8004, 0x13), setvar(VAR_0x8005, <the ostrakon item>),
// goto(EventScript_IchorDigFixed). The find is the Ostrakon "PHAYLLOS. Runs past my
// house at dawn. Every dawn." (SCRIPT.md Part 6), FLAG_ICHOR_DIG_FIXED_START + 0x13.
script Route9_Schiste_EventScript_GullyDig {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

// --- signs ------------------------------------------------------------------------------------
script Route9_Schiste_EventScript_SignEast {
    msgbox(format("ROUTE 9 · THE SPLIT ROAD\pEast: Lebadeia. West: the crossroads, Delphoi and Kirrha."), MSGBOX_SIGN)
}

script Route9_Schiste_EventScript_SignCrossroads {
    msgbox(format("THE SPLIT ROAD. Here three roads meet.\pYield to carts. Somebody once didn't."), MSGBOX_SIGN)
}

script Route9_Schiste_EventScript_SignFork {
    msgbox(format("THE LOOKOUT. Delphoi, from below. The sacred road starts at Kirrha."), MSGBOX_SIGN)
}

script Route9_Schiste_EventScript_SignCutting {
    msgbox(format("The road to Kirrha. Beware of falling treasuries."), MSGBOX_SIGN)
}

script Route9_Schiste_EventScript_SignSouthWest {
    msgbox(format("KIRRHA, the harbor of Delphoi. The ferry to Achaea."), MSGBOX_SIGN)
}
