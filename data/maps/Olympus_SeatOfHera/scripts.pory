text Olympus_SeatOfHera_Text_Defeat { "Hm. You don't need a god for a father." }

script Olympus_SeatOfHera_EventScript_Olympias {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameOlympias)
    if (flag(FLAG_ICHOR_BEAT_OLYMPIAS)) {
        msgbox(format("The summit's through that door. The Archon's waiting at the altar.\pHe's a good man who did one brave thing and has been ashamed of it ever since.\pMothers notice these things."))
        release
        end
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    setspeaker(SP_NAME_NONE)
    msgbox(format("Olympias rises from Hera's throne. At the door behind you, a torch catches."), MSGBOX_DEFAULT)
    closemessage
    setmetatile(7, 24, 0x271, TRUE)
    setmetatile(7, 25, 0x279, TRUE)
    setmetatile(11, 24, 0x271, TRUE)
    setmetatile(11, 25, 0x279, TRUE)
    special(DrawWholeMapView)
    playse(SE_M_FLAME_WHEEL)
    delay(24)
    setmetatile(7, 19, 0x271, TRUE)
    setmetatile(7, 20, 0x279, TRUE)
    setmetatile(11, 19, 0x271, TRUE)
    setmetatile(11, 20, 0x279, TRUE)
    special(DrawWholeMapView)
    playse(SE_M_FLAME_WHEEL)
    delay(24)
    setmetatile(7, 14, 0x271, TRUE)
    setmetatile(7, 15, 0x279, TRUE)
    setmetatile(11, 14, 0x271, TRUE)
    setmetatile(11, 15, 0x279, TRUE)
    special(DrawWholeMapView)
    playse(SE_M_FLAME_WHEEL)
    delay(24)
    setmetatile(7, 9, 0x271, TRUE)
    setmetatile(7, 10, 0x279, TRUE)
    setmetatile(11, 9, 0x271, TRUE)
    setmetatile(11, 10, 0x279, TRUE)
    special(DrawWholeMapView)
    playse(SE_M_FLAME_WHEEL)
    delay(24)
    setmetatile(6, 3, 0x273, TRUE)
    setmetatile(6, 4, 0x27B, TRUE)
    setmetatile(12, 3, 0x273, TRUE)
    setmetatile(12, 4, 0x27B, TRUE)
    special(DrawWholeMapView)
    playse(SE_M_FLAMETHROWER)
    delay(30)
    msgbox(format("Fire runs up the aisle, column to column, to the braziers at her feet.\pEvery eye on the peacock columns catches the light, and the bronze serpents by the throne seem to lift their heads."), MSGBOX_DEFAULT)
    closemessage
    setspeaker(Ichor_League_Text_NameOlympias)
    msgbox(format("Hera's serpents keep this hall. She raised the Hydra, you know. She loved it.\pI told my son a god was his father. He believed me, and he conquered the world.\pWas I lying?\pNever mind. Let's see what you believe."))
    trainerbattle_no_intro(TRAINER_ICHOR_OLYMPIAS, Olympus_SeatOfHera_Text_Defeat)
    setflag(FLAG_ICHOR_BEAT_OLYMPIAS)
    setvar(VAR_ELITE_4_STATE, 8)
    call(Olympus_SeatOfHera_EventScript_SetOpen)
    call(Ichor_League_EventScript_DoorOpened)
    setspeaker(Ichor_League_Text_NameOlympias)
    msgbox(format("The summit's through that door. The Archon's waiting at the altar.\pHe's a good man who did one brave thing and has been ashamed of it ever since.\pMothers notice these things."))
    release
}
