mapscripts Olympus_SeatOfHera_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_BEAT_OLYMPIAS)) {
            call(Olympus_SeatOfHera_EventScript_SetOpen)
        }
        if (var(VAR_ELITE_4_STATE) == 7 || var(VAR_ELITE_4_STATE) == 8) {
            call(Olympus_SeatOfHera_EventScript_SetClosed)
        }
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0: Olympus_SeatOfHera_EventScript_FaceNorth
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ELITE_4_STATE, 6: Olympus_SeatOfHera_EventScript_WalkIn
    ]
}

script Olympus_SeatOfHera_EventScript_FaceNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script Olympus_SeatOfHera_EventScript_WalkIn {
    lockall
    call(Ichor_League_EventScript_WalkIn)
    call(Olympus_SeatOfHera_EventScript_SetClosed)
    special(DrawWholeMapView)
    setvar(VAR_ELITE_4_STATE, 7)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Olympus_SeatOfHera_EventScript_Movement_CameraUp)
    waitmovement(0)
    delay(50)
    applymovement(OBJ_EVENT_ID_CAMERA, Olympus_SeatOfHera_EventScript_Movement_CameraDown)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}

movement Olympus_SeatOfHera_EventScript_Movement_CameraUp { walk_up * 16 }
movement Olympus_SeatOfHera_EventScript_Movement_CameraDown { walk_fast_down * 16 }

script Olympus_SeatOfHera_EventScript_SetClosed {
    setmetatile(9, 27, 0x20E, TRUE)
