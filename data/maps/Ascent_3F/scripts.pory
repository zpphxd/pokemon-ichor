// Ascent 3F (design/maps/Ascent_3F.md): the terraces above the cloud, and the
// Propylaia's facade across the cliff top. Generated by tools/ichor/maps/propylon.py:
// edit the builder, not this file.

mapscripts Ascent_3F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Ascent_3F_EventScript_Keeper
}

// Polydamas stands aside once beaten.
script Ascent_3F_EventScript_Keeper {
    if (defeated(TRAINER_ICHOR_ASCENT_POLYDAMAS)) {
        setobjectxyperm(LOCALID_ASCENT_3F_POLYDAMAS, 20, 27)
        setobjectmovementtype(LOCALID_ASCENT_3F_POLYDAMAS, MOVEMENT_TYPE_FACE_RIGHT)
    }
}

movement Ascent_3F_Movement_CameraUp { walk_slow_up * 4 }
movement Ascent_3F_Movement_CameraDown { walk_down * 4 }
movement Ascent_3F_Movement_CameraUpFacade { walk_up * 8 walk_slow_up * 14 }
movement Ascent_3F_Movement_CameraPediment { walk_slow_left * 3 walk_slow_right * 6 walk_slow_left * 3 }
movement Ascent_3F_Movement_CameraFromFacade { walk_faster_down * 22 }
movement Ascent_3F_Movement_KeeperAside { walk_left face_right }

script Ascent_3F_EventScript_CloudBreak {
    if (flag(FLAG_ICHOR_SEEN_CLOUD_BREAK)) {
        end
    }
    lockall
    setflag(FLAG_ICHOR_SEEN_CLOUD_BREAK)
    fadescreenspeed(FADE_TO_WHITE, 4)
    playse(SE_M_GUST)
    delay(20)
    fadescreenspeed(FADE_FROM_WHITE, 2)
    msgbox(format("The white thins, and thins, and then there isn't any.\p"
                  "The cloud lies below you like a sea, all the way to the edge of the world.\p"
                  "For the first time since the foothills, there is sun."), MSGBOX_DEFAULT)
    closemessage
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Ascent_3F_Movement_CameraUp)
    waitmovement(0)
    delay(40)
    applymovement(OBJ_EVENT_ID_CAMERA, Ascent_3F_Movement_CameraDown)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}

// The first sight of the grand entrance: the camera climbs the facade to the pediment.
script Ascent_3F_EventScript_Pantheon {
    if (flag(FLAG_ICHOR_SEEN_PANTHEON)) {
        end
    }
    lockall
    setflag(FLAG_ICHOR_SEEN_PANTHEON)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Ascent_3F_Movement_CameraUpFacade)
    waitmovement(0)
    playse(SE_M_GUST)
    applymovement(OBJ_EVENT_ID_CAMERA, Ascent_3F_Movement_CameraPediment)
    waitmovement(0)
    delay(30)
    msgbox(format("At the top of the last stair, across the whole of the mountain's top:\p"
                  "the Propylaia. Column after column of white marble, bronze doors taller than a house,\p"
                  "and the Twelve in stone before it. Gold on the pediment: Zeus, with the thunderbolt in his fist.\p"
                  "Behind it, the four seats of the Pantheon. And above them all, the Archon."), MSGBOX_DEFAULT)
    closemessage
    delay(20)
    applymovement(OBJ_EVENT_ID_CAMERA, Ascent_3F_Movement_CameraFromFacade)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}

// Polydamas holds the last stair: step past him unbeaten and he steps across.
script Ascent_3F_EventScript_KeeperBlocks {
    if (defeated(TRAINER_ICHOR_ASCENT_POLYDAMAS)) {
        end
    }
    lockall
    applymovement(LOCALID_ASCENT_3F_POLYDAMAS, Common_Movement_FaceRight)
    waitmovement(0)
    msgbox(format("POLYDAMAS: The stair's mine. Nobody goes up who can't go through me."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, Common_Movement_WalkDown)
    waitmovement(0)
    applymovement(LOCALID_ASCENT_3F_POLYDAMAS, Common_Movement_FaceDown)
    waitmovement(0)
    releaseall
}

script Ascent_3F_EventScript_Polydamas {
    trainerbattle_single(TRAINER_ICHOR_ASCENT_POLYDAMAS,
        format("Polydamas of Skotoussa. I won the pankration at Olympia barehanded.\p"
               "The Archon set me on this stair. Nobody goes up who can't go through me."),
        format("…Through me. Go up, then."), Ascent_3F_EventScript_PolydamasAside)
    msgbox(format("The doors are just there. The hearth's lit inside, and the healer keeps it.\p"
                  "Warm your hands. You'll want them steady."), MSGBOX_AUTOCLOSE)
}

script Ascent_3F_EventScript_PolydamasAside {
    msgbox(format("I held up a cave roof once, so my friends could run.\p"
                  "You're heavier than a mountain. Go on."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_ASCENT_3F_POLYDAMAS, Ascent_3F_Movement_KeeperAside)
    waitmovement(0)
    setobjectxyperm(LOCALID_ASCENT_3F_POLYDAMAS, 20, 27)
    release
    end
}

script Ascent_3F_EventScript_Sthenelos {
    trainerbattle_single(TRAINER_ICHOR_ASCENT_STHENELOS,
        format("The stair begins here. So does the Archon's peace.\pDraw, challenger."),
        format("Peace kept. Barely."))
    msgbox(format("Three terraces, three stairs. Then the doors.\pDon't stop at the top to look at the view. Everyone does."), MSGBOX_AUTOCLOSE)
}

script Ascent_3F_EventScript_Hippias {
    trainerbattle_single(TRAINER_ICHOR_ASCENT_HIPPIAS,
        format("Sthenelos takes the left of the stair. I take the right.\pBetween us there's no way round."),
        format("We'll widen the stair, then."))
    msgbox(format("I've stood guard up here three winters. The cloud has never once been the same shape."), MSGBOX_AUTOCLOSE)
}

script Ascent_3F_EventScript_Gorgo {
    trainerbattle_single(TRAINER_ICHOR_ASCENT_GORGO,
        format("I held a rank in Team Titan. I had a tablet with my name on it.\pThe last draft. My draft. Do you know what it said?"),
        format("…It didn't say this."))
    msgbox(format("It said I'd stand at the master's right hand when the hours stopped.\pThe hours stopped. I was in a ditch outside Delphoi.\pFunny. I feel lighter."), MSGBOX_AUTOCLOSE)
}

script Ascent_3F_EventScript_Melite {
    trainerbattle_single(TRAINER_ICHOR_ASCENT_MELITE,
        format("Snow on the Twelve's own stair. Isn't it lovely?\pLet's see if you are."),
        format("Lovelier than I thought."))
    msgbox(format("Hypatia taught me once. She asked me who I was.\pI said my name. She said, “That's what they call you.”"), MSGBOX_AUTOCLOSE)
}

script Ascent_3F_EventScript_Korinna {
    trainerbattle_single(TRAINER_ICHOR_ASCENT_KORINNA,
        format("I sing the hymns on the processional way. Every pilgrim walks between Melite and me,\pand every pilgrim pays in a battle."),
        format("Paid in full."))
    msgbox(format("The tripods are offerings from every Archon there's been. Count them. One is missing.\pNobody knows whose."), MSGBOX_AUTOCLOSE)
}

// The watch-post: seen, you're sent back; under the Helm of Darkness, his eyes slide past.
script Ascent_3F_EventScript_WatchPost {
    if (flag(FLAG_ICHOR_HELM_ON)) {
        end
    }
    lockall
    playse(SE_PIN)
    msgbox(format("WATCHMAN: Halt. These are the Archon's stores.\p"
                  "Nobody comes in here that I can see. Back to the way."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
    waitmovement(0)
    releaseall
}

script Ascent_3F_EventScript_WatchMan {
    lock
    if (flag(FLAG_ICHOR_HELM_ON)) {
        msgbox(format("The watchman stares straight through you, at the stair.\p"
                      "“…Wind,” he mutters. “Only the wind.”"), MSGBOX_DEFAULT)
    } else {
        faceplayer
        msgbox(format("Twenty winters on this post. I've never once let in anyone I could see."), MSGBOX_DEFAULT)
    }
    release
}

// The empty plinth among the Twelve: after the credits it bears the champion's name.
script Ascent_3F_EventScript_ChampionStatue {
    lockall
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        msgbox(format("An empty plinth at the end of the Twelve, and new letters cut in it, still sharp:\p"
                      "{PLAYER}, WHO CLIMBED THE MOUNTAIN AND KEPT THE BOX.\p"
                      "There's no statue on it. Whoever cut the letters said you'd want to stand there yourself."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("An empty plinth at the end of the Twelve. The stone's been dressed, ready for letters.\p"
                      "Nobody's cut any yet."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_3F_EventScript_Statue_Hestia {
    msgbox(format("HESTIA OF THE HEARTH. Her hand is cupped round a flame of gold leaf.\pThe eldest of them, and the first one given every offering."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Hermes {
    msgbox(format("HERMES OF THE ROADS. Wings at his heels; the staff with two snakes.\pSomeone has left a coin on the plinth for the road down."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Demeter {
    msgbox(format("DEMETER OF THE GRAIN. A sheaf of wheat in her arms, carved so fine the ears look ripe.\pThere's snow on the sheaf. She doesn't look pleased about it."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Dionysus {
    msgbox(format("DIONYSUS, TWICE-BORN. A fennel staff with a pine cone on top.\pThe sculptor gave him a smile you can't quite trust."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Artemis {
    msgbox(format("ARTEMIS OF THE WILDS. A bow, a crescent in her hair.\pHer quiver's one arrow short."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Hephaestus {
    msgbox(format("HEPHAESTUS THE SMITH. The hammer, the tongs, a crutch he made himself.\pThe only statue here that looks like it could fix the others."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Aphrodite {
    msgbox(format("APHRODITE, FOAM-BORN. A scallop shell at her feet, a dove on her wrist.\pThe sculptor signed this one twice."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Apollo {
    msgbox(format("APOLLO OF THE LYRE. The lyre, the laurel, the far-shooting bow.\pThe wind makes his marble strings hum."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Ares {
    msgbox(format("ARES OF THE SPEAR. Helmet, spear, a shield with a boar on it.\pSomeone has polished his spearpoint very recently."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Poseidon {
    msgbox(format("POSEIDON, EARTH-SHAKER. The trident. Salt crusted at the base, this far from any sea."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Athena {
    msgbox(format("ATHENA OF THE CITY. Helm, aegis, the owl on her shoulder.\pThe owl is the only one here that looks back at you."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Statue_Hera {
    msgbox(format("HERA, QUEEN OF HEAVEN. A crown, a sceptre with a cuckoo on it,\pand a peacock's eye cut into the hem of her robe."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Basin {
    msgbox(format("The lustral basin by the doors, frozen over. A white dove drinks at a hole in the ice,\pand a scallop shell lies on the rim, pink inside. Someone always leaves one. Aphrodite's."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Shrine {
    msgbox(format("A stele of Zeus Ombrios, the rain-giver. Fragment V of the Olympian hymn:\p“From this height he saw every field below the cloud,\pand gave rain to the just and the unjust, since from up here he couldn't tell them apart.”"), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_Sockets {
    lockall
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        msgbox(format("Four sockets in a square, each the shape of a different key. Behind them, the barred stair.\p"
                      "Since the summit, the bronze hums when you come near, very low. Still barred.\p"
                      "Carved over it: STAND STILL."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Four sockets cut in a square in the stone, each the shape of a different key.\p"
                      "Behind them a stair climbs into the summit cone, barred with bronze.\p"
                      "Carved over it: STAND STILL."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_3F_EventScript_CloudBank {
    msgbox(format("Here the cloud never clears. It rolls up over the terrace's edge and won't go back down.\pInside it, something whinnies. The wind itself would have to be told to move it."), MSGBOX_SIGN)
}

script Ascent_3F_EventScript_SnowSign {
    msgbox(format("THE PROCESSIONAL WAY\nThree terraces, three stairs, the Propylaia.\pAbove the cloud, the mountain belongs to the Twelve."), MSGBOX_SIGN)
}
