mapscripts Aigion_Homarion_MapScripts {}

// Generated by tools/ichor/maps/gulf.py; edit the builder, not this file.

script Aigion_Homarion_EventScript_Altar {
    msgbox(format("The altar of Zeus Homagyrios, who gathers men.\pEvery king who sailed for Troy left a scratch on it."), MSGBOX_SIGN)
    end
}

script Aigion_Homarion_EventScript_Doors {
    msgbox(format("Bronze doors to the adyton, barred with a beam as thick as a mast.\pWax seals over the bar, each with a different city's stamp."), MSGBOX_SIGN)
    end
}

script Aigion_Homarion_EventScript_Tablets {
    msgbox(format("Bronze tablets: the oaths of the Achaean towns.\pThe oldest is in letters nobody can read any more."), MSGBOX_SIGN)
    end
}

script Aigion_Homarion_EventScript_Mosaic {
    msgbox(format("A host stepping out of his door to greet a traveller.\nZeus keeps the guest-right too."), MSGBOX_SIGN)
    end
}

script Aigion_Homarion_EventScript_Agesandros {
    lock
    faceplayer
    if (flag(FLAG_BADGE05_GET) && !flag(FLAG_ICHOR_AIGION_PRIEST_GIFT)) {
        msgbox(format("The Huntress's laurel. Then you've kept faith in Arkadia.\p"
                      "The god gathers those who keep faith. Wear this; it was a king's."))
        giveitem(ITEM_KINGS_ROCK)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_AIGION_PRIEST_GIFT)
        }
        release
        end
    }
    if (flag(FLAG_ICHOR_AIGION_PRIEST_GIFT)) {
        msgbox(format("The doors stay barred until the towns all agree to open them.\p"
                      "They have not agreed on anything for a thousand years."))
        release
        end
    }
    msgbox(format("This is where the kings gathered before Troy.\p"
                  "Come back with a laurel from Arkadia and the god will know your name."))
    release
}

script Aigion_Homarion_EventScript_Kleobis {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_AIGION_OATH_GIFT)) {
        msgbox(format("I rowed for the league when I was young. Forty oars and one oath.\pTake this. The sea gave it back to me, so it's lucky."))
        giveitem(ITEM_SHELL_BELL)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_AIGION_OATH_GIFT)
        }
        release
        end
    }
    msgbox(format("An oath is a rope. Pull it or it pulls you."))
    release
}
