// --- End of generated room scripts. ---

// --- The step-glass -----------------------------------------------------------------------

// A coord event on every floor tile of the run, live while VAR_TEMP_3 is 1.
script EmporionCity_TempleOfHermes_EventScript_Step {
    call(EmporionCity_TempleOfHermes_EventScript_Tick)
    end
}

// One step off the glass. Returns, unless the glass ran dry.
// ICHOR_STUB_INFO_PANEL: the start-menu info panel ("Step-glass: 120", SYSTEMS.md §2) is
// the engine session's. Until it lands, the glass speaks at half and at 30, and the
// step-glass by the door tells the count.
script EmporionCity_TempleOfHermes_EventScript_Tick {
    subvar(VAR_TEMP_2, 1)
    if (var(VAR_TEMP_2) == 0) {
        goto(EmporionCity_TempleOfHermes_EventScript_GlassDry)
    }
    if (var(VAR_TEMP_2) == 60) {
        msgbox(format("The step-glass is half run."))
        closemessage
    } elif (var(VAR_TEMP_2) == 30) {
        msgbox(format("The step-glass is running low."))
        closemessage
    }
    return
}

script EmporionCity_TempleOfHermes_EventScript_GlassDry {
    lockall
    setvar(VAR_TEMP_3, 0)
    // The Herald's Run stops dead.
    playbgm(MUS_DUMMY, FALSE)
    playse(SE_BALL_TRAY_BALL)
    msgbox(format("The last grain falls."))
    msgbox(format("The scrolls flap out of your hands and fly back to the door."))
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    msgbox(format(
        "Late! A herald is never late.\p"
        "He's sometimes early, and blames the wind."))
    setspeaker(SP_NAME_NONE)
    closemessage
    setflag(FLAG_ICHOR_HERALDS_RUN_FAILED)
    // Back to the door. The map reloads, so the scrolls are Kerykos's again; oiled herms stay oiled.
    warp(MAP_EMPORION_CITY_TEMPLE_OF_HERMES, 10, 22)
    waitstate
    end
}

// Before the run, the count's on the stand; after the Laurel, it's been put away.
script EmporionCity_TempleOfHermes_EventScript_StepGlass {
    lockall
    if (flag(FLAG_BADGE02_GET)) {
        msgbox(format(
            "The step-glass has been put away.\p"
            "Kerykos says you've nothing left to prove. Then he talks for ten minutes."))
    } elif (var(VAR_TEMP_3) == 1) {
        buffernumberstring(STR_VAR_1, VAR_TEMP_2)
        msgbox(format("The step-glass. Sand for {STR_VAR_1} more steps."))
    } else {
        msgbox(format("A tall step-glass. The sand falls one grain for every step you take."))
    }
    releaseall
    end
}

// --- The oil and the junction herms ----------------------------------------------------

// ICHOR_STUB_OFFERINGS: with the engine's ITEM_OLIVE_OIL, the jar gives one flask
// (checkitem / additem up to 3) and the herms take one (removeitem); until then the
// flasks are VAR_TEMP_5.
script EmporionCity_TempleOfHermes_EventScript_OilJar {
    lockall
    msgbox(format("A jar of temple oil, for the herms."))
    if (var(VAR_TEMP_5) < 3) {
        addvar(VAR_TEMP_5, 1)
        playse(SE_M_BUBBLE)
        msgbox(format("You fill a flask."))
    } else {
        msgbox(format("Your flasks are full."))
    }
    releaseall
    end
}

// Asks to oil a junction herm. VAR_RESULT is TRUE if the herm took the oil.
script EmporionCity_TempleOfHermes_EventScript_AskOil {
    msgbox(format("A herm of Hermes. His stone eyes stare straight ahead.\pOil his face?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        setvar(VAR_RESULT, FALSE)
        return
    }
    if (var(VAR_TEMP_5) == 0) {
        msgbox(format("You have no oil. There's a jar of it by the door."))
        setvar(VAR_RESULT, FALSE)
        return
    }
    subvar(VAR_TEMP_5, 1)
    setvar(VAR_RESULT, TRUE)
    return
}

script EmporionCity_TempleOfHermes_EventScript_HermTurns {
    closemessage
    playse(SE_M_STRENGTH)
    call(EmporionCity_TempleOfHermes_EventScript_DrawRoom)
    special(DrawWholeMapView)
    waitse
    msgbox(format("The oil runs down the stone. Slowly, the head turns."))
    releaseall
    end
}

script EmporionCity_TempleOfHermes_EventScript_HermOiled {
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        msgbox(format("The herm is looking at the dais. Pointedly."))
    } else {
        msgbox(format("The herm is looking that way. Pointedly."))
    }
    releaseall
    end
}

script EmporionCity_TempleOfHermes_EventScript_HermPlain {
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        msgbox(format("A herm of Hermes. He has turned to face the dais, like everyone else."))
        releaseall
        end
    }
    call(EmporionCity_TempleOfHermes_EventScript_AskOil)
    return
}

script EmporionCity_TempleOfHermes_EventScript_HermJ1 {
    lockall
    if (flag(FLAG_ICHOR_HERMES_HERM_J1)) {
        goto(EmporionCity_TempleOfHermes_EventScript_HermOiled)
    }
    call(EmporionCity_TempleOfHermes_EventScript_HermPlain)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_ICHOR_HERMES_HERM_J1)
        goto(EmporionCity_TempleOfHermes_EventScript_HermTurns)
    }
    releaseall
    end
}

