// --- The herald-herms -----------------------------------------------------------------------

// VAR_0x8004 is the herm: 1 the doorway (H1), 2 the sandal (H2), 3 the purse (H3).
script EmporionCity_TempleOfHermes_EventScript_HermH1 {
    lockall
    setvar(VAR_0x8004, 1)
    goto(EmporionCity_TempleOfHermes_EventScript_HeraldHerm)
}

script EmporionCity_TempleOfHermes_EventScript_HermH2 {
    lockall
    setvar(VAR_0x8004, 2)
    goto(EmporionCity_TempleOfHermes_EventScript_HeraldHerm)
}

script EmporionCity_TempleOfHermes_EventScript_HermH3 {
    lockall
    setvar(VAR_0x8004, 3)
    goto(EmporionCity_TempleOfHermes_EventScript_HeraldHerm)
}

script EmporionCity_TempleOfHermes_EventScript_HeraldHerm {
    if (var(VAR_TEMP_3) == 1) {
        // The run is on: the herm that's next takes its scroll.
        copyvar(VAR_0x8005, VAR_TEMP_1)
        addvar(VAR_0x8005, 1)
        if (var(VAR_0x8005) == VAR_0x8004) {
            goto(EmporionCity_TempleOfHermes_EventScript_Deliver)
        }
        if (var(VAR_TEMP_1) >= VAR_0x8004) {
            call(EmporionCity_TempleOfHermes_EventScript_Plaque)
            msgbox(format("Your scroll is already in the niche at its foot."))
        } else {
            switch (var(VAR_0x8004)) {
                case 1: msgbox(format("The plaque shows a doorway. This scroll isn't for this herm. Not yet."))
                case 2: msgbox(format("The plaque shows a sandal. This scroll isn't for this herm. Not yet."))
                default: msgbox(format("The plaque shows a purse. This scroll isn't for this herm. Not yet."))
            }
        }
        releaseall
        end
    }
    call(EmporionCity_TempleOfHermes_EventScript_Plaque)
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        msgbox(format("A sealed scroll sits in the niche at its foot."))
    }
    releaseall
    end
}

script EmporionCity_TempleOfHermes_EventScript_Plaque {
    switch (var(VAR_0x8004)) {
        case 1: msgbox(format("A herm with a bronze plaque: a doorway. “Hermes of the Threshold.”"))
        case 2: msgbox(format("A herm with a bronze plaque: a sandal. “Hermes of the Road.”"))
        default: msgbox(format("A herm with a bronze plaque: a purse. “Hermes of the Market.”"))
    }
    return
}

script EmporionCity_TempleOfHermes_EventScript_Deliver {
    call(EmporionCity_TempleOfHermes_EventScript_Plaque)
    msgbox(format("You slip the scroll into the niche at its foot."))
    closemessage
    addvar(VAR_TEMP_1, 1)
    if (var(VAR_TEMP_1) == 3) {
        goto(EmporionCity_TempleOfHermes_EventScript_LastScroll)
    }
    // The scroll shows in the niche, a relay torch on the dais catches, and every
    // oiled herm turns to the next herald-herm.
    call(EmporionCity_TempleOfHermes_EventScript_DrawRoom)
    special(DrawWholeMapView)
    playse(SE_M_HEAL_BELL)
    msgbox(format("Somewhere, a bell rings once."))
    waitse
    releaseall
    end
}

// The third scroll: the glass stops, the gate opens, the upper colonnade's turnstiles turn
// round, every herm faces the dais, and Kerykos is already up there.
script EmporionCity_TempleOfHermes_EventScript_LastScroll {
    setvar(VAR_TEMP_3, 0)
    setflag(FLAG_ICHOR_HERALDS_RUN_DONE)
    playse(SE_M_HEAL_BELL)
    msgbox(format("Somewhere, a bell rings three times."))
    waitse
    closemessage
    playse(SE_UNLOCK)
    call(EmporionCity_TempleOfHermes_EventScript_DrawRoom)
    special(DrawWholeMapView)
    setobjectxyperm(LOCALID_HERMES_KERYKOS, 10, 3)
    addobject(LOCALID_HERMES_KERYKOS)
    clearflag(FLAG_TEMP_4)
    waitse
    msgbox(format(
        "Bronze clangs overhead. The dais gate swings open.\p"
        "Every herm in the hall turns its head to the dais.\p"
        "Nearby, the turnstiles click round the other way."))
    releaseall
    end
}

// --- Kerykos ------------------------------------------------------------------------------

script EmporionCity_TempleOfHermes_EventScript_Kerykos {
    if (flag(FLAG_BADGE02_GET)) {
        goto(EmporionCity_TempleOfHermes_EventScript_KerykosAfter)
    }
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        goto(EmporionCity_TempleOfHermes_EventScript_KerykosDais)
    }
    lock
    faceplayer
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    if (!flag(FLAG_ICHOR_HERALDS_RUN_TOLD)) {
        msgbox(format(
            "You came! Everyone comes. I knew you'd come. I wrote it down.\p"
            "Welcome to the house of Hermes. Herald of the gods. Guide of roads.\p"
            "Friend of merchants, travelers, shepherds, liars and thieves.\p"
            "Mostly the last two. Don't tell the merchants.\p"
            "Kleon of Lakonia came through this morning. Sixty-one steps!\p"
            "Then he ran into a pillar. Then he beat me. In that order.\p"
            "Here's the rite. A herald carries the god's word.\p"
            "Fast, and to the right door.\p"
            "Three sealed scrolls. Three herald-herms, somewhere in my stoa.\p"
            "Deliver them in the order they're written. A herald always does.\p"
            "And this is the step-glass. It runs dry in a hundred and twenty steps.\p"
            "The herms in there are vain. Oil their faces and they'll point.\p"
            "There's oil by the door. Free. Don't tell the merchants that either."))
        setflag(FLAG_ICHOR_HERALDS_RUN_TOLD)
    } else {
        msgbox(format(
            "Three scrolls, three herms, a hundred and twenty steps.\p"
            "Oil the herms and they'll point. Turnstiles turn one way."))
    }
    msgbox(format("Ready?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format(
            "Nobody's ever ready. That's what makes it a race.\p"
            "Come back when you're less ready."))
        release
        end
    }
    msgbox(format("Then run, herald!"))
    goto(EmporionCity_TempleOfHermes_EventScript_StartRun)
}

script EmporionCity_TempleOfHermes_EventScript_StartRun {
    setspeaker(SP_NAME_NONE)
    msgbox(format(
        "{PLAYER} took three sealed scrolls.\p"
        "The first is addressed “To Hermes of the Threshold.”\p"
        "The second, “Of the Road.” The third, “Of the Market.”"))
    closemessage
    // He takes the short way. There's always a short way. (The step-glass, his table and
    // the oil jar hem him in, and the player is in front, so he hops the jar.)
    applymovement(LOCALID_HERMES_KERYKOS, EmporionCity_TempleOfHermes_Movement_KerykosOff)
    waitmovement(0)
    removeobject(LOCALID_HERMES_KERYKOS)
    setvar(VAR_TEMP_1, 0)
    // The glass: 120 steps on Hero. Mortal is 150 and Spartan 100 (SYSTEMS.md §12) once
    // the difficulty setting exists.
    setvar(VAR_TEMP_2, 120)
    setvar(VAR_TEMP_3, 1)
    call(EmporionCity_TempleOfHermes_EventScript_DrawRoom)
    special(DrawWholeMapView)
    // The Herald's Run from its first bar. ICHOR_STUB_MUSIC: SCRIPT.md Part 9's
    // MUS_ICHOR_HERALDS_RUN is MUS_ICHOR_TEMPLE_HERMES, the room's own song, for now.
    playbgm(MUS_ICHOR_TEMPLE_HERMES, FALSE)
    msgbox(format("The step-glass begins to run."))
    release
    end
}

// On the dais once the third scroll is home: the battle, then the Laurel.
script EmporionCity_TempleOfHermes_EventScript_KerykosDais {
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    // ICHOR_STUB_MUSIC: the Hierophant class plays MUS_ICHOR_BATTLE_RIVAL (src/pokemon.c)
    // until MUS_ICHOR_BATTLE_HIEROPHANT exists, as Ione's battle does.
    trainerbattle_single(TRAINER_ICHOR_KERYKOS_1, EmporionCity_TempleOfHermes_Text_KerykosIntro,
        format("Delivered! Signed, sealed, and soundly beaten!"),
        EmporionCity_TempleOfHermes_EventScript_KerykosDefeated, NO_MUSIC)
    // Beaten already, yet the laurel never changed hands: give it now.
    lock
    faceplayer
    goto(EmporionCity_TempleOfHermes_EventScript_KerykosDefeated)
}

script EmporionCity_TempleOfHermes_EventScript_KerykosDefeated {
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    msgbox(format("Well run, and well fought! Here. The Herald Laurel."))
    setflag(FLAG_BADGE02_GET)
    // The temple stays solved: every acolyte counts as beaten (MAP_DESIGN.md §4).
    settrainerflag(TRAINER_ICHOR_PODARGE)
    settrainerflag(TRAINER_ICHOR_EUCHIDAS)
    settrainerflag(TRAINER_ICHOR_PHILONIDES)
    // ICHOR_STUB_RITES: Hermes Favor +15 here, special(Ichor_AddFavor) with
    // VAR_0x8004 = ICHOR_GOD_HERMES and VAR_0x8005 = ICHOR_FAVOR_LAUREL (ENGINE_API.md §3).
    setspeaker(SP_NAME_NONE)
    message(format("{PLAYER} received the Herald Laurel from Kerykos!"))
    waitmessage
    call(Common_EventScript_PlayGymBadgeFanfare)
    call(EmporionCity_TempleOfHermes_EventScript_DrawRoom)
    special(DrawWholeMapView)
    goto(EmporionCity_TempleOfHermes_EventScript_GiveAerialAce)
}

script EmporionCity_TempleOfHermes_EventScript_GiveAerialAce {
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    msgbox(format("And Aerial Ace. It never misses. A herald's word always arrives."))
    checkitemspace(ITEM_TM40)
    if (var(VAR_RESULT) == FALSE) {
        setspeaker(SP_NAME_NONE)
        goto(Common_EventScript_ShowBagIsFull)
    }
    setvar(VAR_0x8006, ITEM_TM40)
    additem(ITEM_TM40)
    setflag(FLAG_ICHOR_GOT_TM_AERIAL_ACE)
    setspeaker(SP_NAME_NONE)
    playfanfare(MUS_OBTAIN_TMHM)
    message(format("{PLAYER} received TM40, Aerial Ace!"))
    waitmessage
    showitemdescription
    waitfanfare
    waitbuttonpress
    hideitemdescription
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    msgbox(format(
        "A secret. My family's been heralds at Eleusa for twenty generations.\p"
        "The Kerykes. We call the holy silence at the Mysteries. Every year.\p"
        "I ran off to sea. My cousin Chloe hasn't spoken to me since.\p"
        "That's not a feud. That's just Chloe. She doesn't speak to anyone much.\p"
        "The Sacred Way's shut for the Mysteries' truce. Only heralds walk it.\p"
        "That laurel says you're one of mine. Show it at the Sacred Gate.\p"
        "I'll be at Eleusa for the Mysteries. Someone has to shout “Silence!”\p"
        "It's the one night a year I'm paid to tell people to be quiet.\p"
        "I'm terrible at it."))
    call(EmporionCity_TempleOfHermes_EventScript_KerykosRite)
    release
    end
}

// ICHOR_STUB_RITES: EventScript_IchorHierophantRite (ENGINE_API.md §3) with VAR_0x8004 =
// ICHOR_GOD_HERMES teaches the rite and gives one loved offering on the first visit.
// Until the engine's rites land, Kerykos says it himself and gives Honey. The flag is
// the engine's own Hierophant's-offering flag for Hermes (FLAG_ICHOR_GIFTS_START +
// 4 * god + 3, Hermes is god 2), so the engine won't give it twice.
script EmporionCity_TempleOfHermes_EventScript_KerykosRite {
    if (flag(FLAG_ICHOR_GIFTS_START + 11)) {
        return
    }
    msgbox(format(
        "Last lesson, and it's free. That's my great altar, by the statue.\p"
        "Gifts left on a god's own altar count double. He's a merchant's god.\p"
        "And Hermes loves honey. Here. From my pockets. Don't ask what else is in them."))
    checkitemspace(ITEM_HONEY)
    if (var(VAR_RESULT) == FALSE) {
        return
    }
    setflag(FLAG_ICHOR_GIFTS_START + 11)
    setvar(VAR_0x8006, ITEM_HONEY)
    additem(ITEM_HONEY)
    setspeaker(SP_NAME_NONE)
    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} received a Honey!"))
    waitmessage
    waitfanfare
    waitbuttonpress
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    return
}

script EmporionCity_TempleOfHermes_EventScript_KerykosAfter {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_GOT_TM_AERIAL_ACE)) {
        goto(EmporionCity_TempleOfHermes_EventScript_GiveAerialAce)
    }
    setspeaker(EmporionCity_TempleOfHermes_Text_NameKerykos)
    // ICHOR_STUB_RITES: gift I (TM U-turn at Hermes Favor 30) is EventScript_IchorHierophantGift
    // with VAR_0x8004 = ICHOR_GOD_HERMES, and its lines are beat 15's, once Favor exists.
    call(EmporionCity_TempleOfHermes_EventScript_KerykosRite)
    msgbox(format(
        "Herms on every road! Oil them all. Hermes remembers.\p"
        "So do I. I have a list."))
    // The short way down, the one shortcut out once the temple's done (MAP_DESIGN.md §3).
    msgbox(format("Need the short way down? Everyone does."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox(format("Close your eyes. No peeking. It's a trade secret."))
        closemessage
        setspeaker(SP_NAME_NONE)
        playse(SE_WARP_IN)
        warp(MAP_EMPORION_CITY_TEMPLE_OF_HERMES, 10, 22)
        waitstate
    }
    release
    end
}

// --- Angelos, the temple guide ---------------------------------------------------------

script EmporionCity_TempleOfHermes_EventScript_Angelos {
    lock
    faceplayer
    setspeaker(EmporionCity_TempleOfHermes_Text_NameAngelos)
    if (flag(FLAG_BADGE02_GET)) {
        msgbox(format("Delivered, and on time! Hermes keep your roads short."))
    } elif (flag(FLAG_ICHOR_HERALDS_RUN_FAILED) && !flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        msgbox(format(
            "Stuck? The herms only point the way once they're oiled. They're vain.\p"
            "Like the herald. Don't tell him I said so. He'll tell everyone."))
    } else {
        msgbox(format(
            "Welcome, traveler. In the house of Hermes, every road's a short one.\p"
            "If you know where it goes.\p"
            "The herald's been waiting since dawn. And talking since dawn."))
    }
    release
    end
}

// --- The acolytes ------------------------------------------------------------------------

script EmporionCity_TempleOfHermes_EventScript_Podarge {
    trainerbattle_single(TRAINER_ICHOR_PODARGE,
        format("A herald who stops to chat is a late herald! …Let's chat. With Pokémon."),
        format("Delayed! Delivered late!"))
    setspeaker(EmporionCity_TempleOfHermes_Text_NamePodarge)
    msgbox(format("Oil a herm and it'll point. It's vain. Every herm in here is vain."), MSGBOX_AUTOCLOSE)
    end
}

script EmporionCity_TempleOfHermes_EventScript_Euchidas {
    trainerbattle_single(TRAINER_ICHOR_EUCHIDAS,
        format("My namesake ran to Delphoi and back in one day.\pThen he died. I want the first part."),
        format("Still breathing. In my family, that's a win."))
    setspeaker(EmporionCity_TempleOfHermes_Text_NameEuchidas)
    msgbox(format("Wrong turnstile, back to the start. Hermes thinks that's funny."), MSGBOX_AUTOCLOSE)
    end
}

// Optional: he faces the wall, so he only battles when spoken to.
script EmporionCity_TempleOfHermes_EventScript_Philonides {
    trainerbattle_single(TRAINER_ICHOR_PHILONIDES,
        format("I ran letters for a king once. He never said thank you. You can, after."),
        format("Thank you. …See? That wasn't hard."))
    setspeaker(EmporionCity_TempleOfHermes_Text_NamePhilonides)
    msgbox(format("Kerykos takes the short way. Everyone knows. Nobody knows where it is."), MSGBOX_AUTOCLOSE)
    end
}

// --- Things -------------------------------------------------------------------------------

script EmporionCity_TempleOfHermes_EventScript_Frieze {
    msgbox(format("A frieze of running figures. Every one has wings on his heels."), MSGBOX_SIGN)
    end
}

// ICHOR_STUB_RITES: EventScript_IchorTempleAltar_Hermes, the god's great altar (offerings
// count double), replaces this once the engine's rites land.
script EmporionCity_TempleOfHermes_EventScript_Altar {
    msgbox(format(
        "Hermes in bronze-capped marble, his petasos tipped back, his staff raised.\p"
        "At his feet, his great altar."), MSGBOX_SIGN)
    end
}

script EmporionCity_TempleOfHermes_EventScript_ScrollTable {
    if (var(VAR_TEMP_3) == 1 || flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        msgbox(format("Kerykos's table. Bare. The scrolls are out on the road."), MSGBOX_SIGN)
    } else {
        msgbox(format("Kerykos's table, laid with sealed scrolls. Red wax, blue ribbons."), MSGBOX_SIGN)
    }
    end
}

script EmporionCity_TempleOfHermes_EventScript_Pigeonholes {
    msgbox(format("Pigeonholes stuffed with letters, all waiting for a herald."), MSGBOX_SIGN)
    end
}

// --- Text and movement ----------------------------------------------------------------------

text EmporionCity_TempleOfHermes_Text_KerykosIntro {
    format(
        "There you are! I took the short way. There's always a short way.\p"
        "Don't tell the acolytes. They think I fly.\p"
        "Every scroll at the right door, in the right order. Hermes is pleased.\p"
        "I can tell. He's gone quiet. He's never quiet.\p"
        "Now let's see if you're as quick when Pokémon do the running!")
}

text EmporionCity_TempleOfHermes_Text_NameKerykos { "KERYKOS" }
text EmporionCity_TempleOfHermes_Text_NameAngelos { "ANGELOS" }
text EmporionCity_TempleOfHermes_Text_NamePodarge { "PODARGE" }
text EmporionCity_TempleOfHermes_Text_NameEuchidas { "EUCHIDAS" }
text EmporionCity_TempleOfHermes_Text_NamePhilonides { "PHILONIDES" }

// The turnstiles: through (two steps, carried) or back (a step back, still facing it).
movement EmporionCity_TempleOfHermes_Movement_ThroughUp { walk_up }
movement EmporionCity_TempleOfHermes_Movement_ThroughDown { walk_down }
movement EmporionCity_TempleOfHermes_Movement_ThroughLeft { walk_left }
movement EmporionCity_TempleOfHermes_Movement_ThroughRight { walk_right }
movement EmporionCity_TempleOfHermes_Movement_BackFromUp { lock_facing_direction walk_down unlock_facing_direction }
movement EmporionCity_TempleOfHermes_Movement_BackFromDown { lock_facing_direction walk_up unlock_facing_direction }
movement EmporionCity_TempleOfHermes_Movement_BackFromLeft { lock_facing_direction walk_right unlock_facing_direction }
movement EmporionCity_TempleOfHermes_Movement_BackFromRight { lock_facing_direction walk_left unlock_facing_direction }

// From his place by the oil jar: over the jar, and off up the stoa.
movement EmporionCity_TempleOfHermes_Movement_KerykosOff {
    jump_2_right
    walk_fast_up * 2
    walk_fast_right * 5
}

// --- Turnstiles --------------------------------------------------------------------------

// VAR_0x8004 is the way the turnstile turns (DIR_*), set by the turnstile's own script.
script EmporionCity_TempleOfHermes_EventScript_Turnstile {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if (var(VAR_RESULT) == VAR_0x8004) {
        goto(EmporionCity_TempleOfHermes_EventScript_TurnstilePass)
    }
    goto(EmporionCity_TempleOfHermes_EventScript_TurnstileBounce)
}

script EmporionCity_TempleOfHermes_EventScript_TurnstilePass {
    lockall
    playse(SE_ROTATING_GATE)
    if (var(VAR_TEMP_3) == 1) {
        // Onto the turnstile, and through it.
        call(EmporionCity_TempleOfHermes_EventScript_Tick)
        call(EmporionCity_TempleOfHermes_EventScript_Tick)
    }
    switch (var(VAR_0x8004)) {
        case DIR_NORTH: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_ThroughUp)
        case DIR_SOUTH: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_ThroughDown)
        case DIR_WEST: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_ThroughLeft)
        default: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_ThroughRight)
    }
    waitmovement(0)
    releaseall
    end
}

script EmporionCity_TempleOfHermes_EventScript_TurnstileBounce {
    lockall
    playse(SE_WALL_HIT)
    msgbox(format("The turnstile won't turn that way."))
    closemessage
    if (var(VAR_TEMP_3) == 1) {
        // Onto it, and back off it.
        call(EmporionCity_TempleOfHermes_EventScript_Tick)
        call(EmporionCity_TempleOfHermes_EventScript_Tick)
    }
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch (var(VAR_RESULT)) {
        case DIR_NORTH: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_BackFromUp)
        case DIR_SOUTH: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_BackFromDown)
        case DIR_WEST: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_BackFromLeft)
        default: applymovement(OBJ_EVENT_ID_PLAYER, EmporionCity_TempleOfHermes_Movement_BackFromRight)
    }
    waitmovement(0)
    releaseall
    end
}
