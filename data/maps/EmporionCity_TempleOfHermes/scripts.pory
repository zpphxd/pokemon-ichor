// The Temple of Hermes in Emporion: the Herald's Run, its acolytes and Hierophant Kerykos
// (design/phase2/SCRIPT.md beat 15, Part 3 and Part 5).
//
// The room is designed in tools/ichor/maps/temple_hermes.py, which writes map.json (every
// person, warp, turnstile, step counter and sign) and the room scripts between the
// markers below. Change the room there, never here.
//
// The run's state
//   VAR_TEMP_1  scrolls delivered, 0-3. A temp var: leaving the room or a dry glass
//               returns the scrolls to Kerykos.
//   VAR_TEMP_2  steps left in the step-glass.
//   VAR_TEMP_3  1 while the run is on. Every floor tile of the run has a coord event
//               that fires only then (EventScript_Step): one step off the glass. Those
//               scripts change only vars until the glass reaches a mark, so the engine
//               runs them without stopping the player.
//   VAR_TEMP_4  never set: the turnstiles' coord events test it against 0, so they are
//               always on.
//   VAR_TEMP_5  flasks of oil carried. ICHOR_STUB_OFFERINGS: the engine's Olive Oil
//               (ENGINE_API.md §3) replaces it; see EventScript_OilJar and _AskOil.
//   FLAG_ICHOR_HERMES_HERM_J1-J4  a junction herm is oiled. Permanent: a second run is easier.
//   FLAG_ICHOR_HERALDS_RUN_DONE   the third scroll is home. The dais gate stays open, the
//                                 upper colonnade's turnstiles stay turned, every herm
//                                 faces the dais, and Kerykos waits on his dais.
//
// A turnstile is a coord event on its tile (EventScript_Turnstile). Walked into the way
// it turns, it clicks round and carries the player through to the far side (two steps
// off the glass). Walked into the wrong way, it won't turn, and the player steps back.

mapscripts EmporionCity_TempleOfHermes_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // Kerykos waits by the oil jar until the run is done, then on his dais.
        if (flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
            setobjectxyperm(LOCALID_HERMES_KERYKOS, 10, 3)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        call(EmporionCity_TempleOfHermes_EventScript_DrawRoom)
    }
}

// --- Room scripts: generated by tools/ichor/maps/temple_hermes.py from the room. Do not edit. ---

// Draws every herm head, the delivered scrolls, the relay torches, the gate, the
// turnstiles that turn round, the table of scrolls and the step-glass from the state.
script EmporionCity_TempleOfHermes_EventScript_DrawRoom {
    call(EmporionCity_TempleOfHermes_EventScript_DrawHermJ1)
    call(EmporionCity_TempleOfHermes_EventScript_DrawHermJ2)
    call(EmporionCity_TempleOfHermes_EventScript_DrawHermJ3)
    call(EmporionCity_TempleOfHermes_EventScript_DrawHermJ4)
    call(EmporionCity_TempleOfHermes_EventScript_DrawHermH1)
    call(EmporionCity_TempleOfHermes_EventScript_DrawHermH2)
    call(EmporionCity_TempleOfHermes_EventScript_DrawHermH3)
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE) || var(VAR_TEMP_1) >= 1) {
        setmetatile(19, 20, METATILE_TempleHermes_Herm_ShaftScroll, TRUE)
    } else {
        setmetatile(19, 20, METATILE_TempleHermes_Herm_Shaft, TRUE)
    }
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE) || var(VAR_TEMP_1) >= 2) {
        setmetatile(19, 16, METATILE_TempleHermes_Herm_ShaftScroll, TRUE)
    } else {
        setmetatile(19, 16, METATILE_TempleHermes_Herm_Shaft, TRUE)
    }
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE) || var(VAR_TEMP_1) >= 3) {
        setmetatile(1, 9, METATILE_TempleHermes_Herm_ShaftScroll, TRUE)
    } else {
        setmetatile(1, 9, METATILE_TempleHermes_Herm_Shaft, TRUE)
    }
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE) || var(VAR_TEMP_1) >= 1) {
        setmetatile(5, 4, METATILE_TempleHermes_Props_TorchLit, TRUE)
    } else {
        setmetatile(5, 4, METATILE_TempleHermes_Props_TorchCold, TRUE)
    }
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE) || var(VAR_TEMP_1) >= 2) {
        setmetatile(15, 4, METATILE_TempleHermes_Props_TorchLit, TRUE)
    } else {
        setmetatile(15, 4, METATILE_TempleHermes_Props_TorchCold, TRUE)
    }
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        setmetatile(10, 6, METATILE_TempleHermes_Turnstile_GateHOpen, FALSE)
        setmetatile(6, 8, METATILE_TempleHermes_Turnstile_TurnE, FALSE)
        setmetatile(5, 8, METATILE_TempleHermes_Floor_Slab, FALSE)
        setmetatile(7, 8, METATILE_TempleHermes_Lane_ArrowE, FALSE)
        setmetatile(16, 10, METATILE_TempleHermes_Turnstile_TurnE, FALSE)
        setmetatile(15, 10, METATILE_TempleHermes_Floor_Slab, FALSE)
        setmetatile(17, 10, METATILE_TempleHermes_Lane_ArrowE, FALSE)
        setmetatile(16, 11, METATILE_TempleHermes_Turnstile_TurnW, FALSE)
        setmetatile(17, 11, METATILE_TempleHermes_Floor_Slab, FALSE)
        setmetatile(15, 11, METATILE_TempleHermes_Lane_ArrowW, FALSE)
    } else {
        setmetatile(10, 6, METATILE_TempleHermes_Turnstile_GateHShut, TRUE)
        setmetatile(6, 8, METATILE_TempleHermes_Turnstile_TurnW, FALSE)
        setmetatile(5, 8, METATILE_TempleHermes_Lane_ArrowW, FALSE)
        setmetatile(7, 8, METATILE_TempleHermes_Floor_Slab, FALSE)
        setmetatile(16, 10, METATILE_TempleHermes_Turnstile_TurnW, FALSE)
        setmetatile(15, 10, METATILE_TempleHermes_Lane_ArrowW, FALSE)
        setmetatile(17, 10, METATILE_TempleHermes_Floor_Slab, FALSE)
        setmetatile(16, 11, METATILE_TempleHermes_Turnstile_TurnE, FALSE)
        setmetatile(17, 11, METATILE_TempleHermes_Lane_ArrowE, FALSE)
        setmetatile(15, 11, METATILE_TempleHermes_Floor_Slab, FALSE)
    }
    if (var(VAR_TEMP_3) == 1 || flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        setmetatile(8, 19, METATILE_TempleHermes_ScrollTable_EmptyL, TRUE)
        setmetatile(9, 19, METATILE_TempleHermes_ScrollTable_EmptyR, TRUE)
    } else {
        setmetatile(8, 19, METATILE_TempleHermes_ScrollTable_FullL, TRUE)
        setmetatile(9, 19, METATILE_TempleHermes_ScrollTable_FullR, TRUE)
    }
    if (flag(FLAG_BADGE02_GET)) {
        setmetatile(7, 19, METATILE_TempleHermes_Props_Floor, TRUE)
    }
    return
}

script EmporionCity_TempleOfHermes_EventScript_DrawHermJ1 {
    if (flag(FLAG_ICHOR_HERALDS_RUN_DONE)) {
        if (flag(FLAG_ICHOR_HERMES_HERM_J1)) {
            setmetatile(13, 19, METATILE_TempleHermes_Herm_HeadOiledN, TRUE)
            return
        }
        setmetatile(13, 19, METATILE_TempleHermes_Herm_HeadN, TRUE)
        return
    }
    if (!flag(FLAG_ICHOR_HERMES_HERM_J1)) {
        setmetatile(13, 19, METATILE_TempleHermes_Herm_HeadS, TRUE)
        return
    }
    switch (var(VAR_TEMP_1)) {
        case 0: setmetatile(13, 19, METATILE_TempleHermes_Herm_HeadOiledE, TRUE)
        case 1: setmetatile(13, 19, METATILE_TempleHermes_Herm_HeadOiledW, TRUE)
        default: setmetatile(13, 19, METATILE_TempleHermes_Herm_HeadOiledW, TRUE)
    }
    return
}

