script ErymanthosPreserve_Oakwood_EventScript_Sign {
    msgbox(format("THE ERYMANTHIAN PRESERVE\nArtemis's own woods. Take only what she lets you catch."), MSGBOX_SIGN)
    end
}

script ErymanthosPreserve_Oakwood_EventScript_Bell {
    lockall
    msgbox(format("A bronze bell hangs from the post. Ring it, and the keeper comes to walk you out.\p"
                  "Ring the bell and end the hunt?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        playse(SE_DING_DONG)
        waitse
        goto(SafariZone_EventScript_Exit)
    }
    releaseall
}

script ErymanthosPreserve_Oakwood_EventScript_Spring {
    msgbox(format("A spring under the oaks, with a bow and a crescent cut in the stone above it. The water is very cold."), MSGBOX_SIGN)
    end
}

script ErymanthosPreserve_Oakwood_EventScript_Huntress {
    lock
    faceplayer
    msgbox(format("First hunt? Throw barley and it stays to eat, but it's harder to catch. Throw a stone "
                  "and it's easier to catch, and readier to run.\p"
                  "Owls and wolves come out at night. The meadow's cold birds, up top. And the river...\p"
                  "Fish the river at any hour. Somebody once pulled up something with more than one head."))
    release
}

script ErymanthosPreserve_Oakwood_EventScript_SignRiver {
    msgbox(format("TO THE RIVER\nThe Erymanthos, and the swans' shallows."), MSGBOX_SIGN)
    end
}
