text Olympus_SeatOfAthena_Text_Defeat { "That's an answer. I'll have to think about it." }

script Olympus_SeatOfAthena_EventScript_Hypatia {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameHypatia)
    if (flag(FLAG_ICHOR_BEAT_HYPATIA)) {
        msgbox(format("Most people answer with what they were told. You answered with what you did.\pOlympias waits beyond. She tells stories. Be careful which ones you believe."))
        release
        end
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    setspeaker(SP_NAME_NONE)
    msgbox(format("Hypatia rolls up the scroll she was reading. Somewhere above, an owl wakes."), MSGBOX_DEFAULT)
    closemessage
    playmoncry(SPECIES_SOPHOWL, CRY_MODE_NORMAL)
    waitmoncry
    fadescreenspeed(FADE_TO_WHITE, 2)
    setmetatile(5, 3, 0x255, TRUE)
    setmetatile(5, 4, 0x25D, TRUE)
    setmetatile(12, 3, 0x255, TRUE)
    setmetatile(12, 4, 0x25D, TRUE)
    setmetatile(6, 9, 0x255, TRUE)
    setmetatile(6, 10, 0x25D, TRUE)
    setmetatile(12, 9, 0x255, TRUE)
    setmetatile(12, 10, 0x25D, TRUE)
    setmetatile(6, 13, 0x255, TRUE)
    setmetatile(6, 14, 0x25D, TRUE)
    setmetatile(12, 13, 0x255, TRUE)
    setmetatile(12, 14, 0x25D, TRUE)
    setmetatile(6, 17, 0x255, TRUE)
    setmetatile(6, 18, 0x25D, TRUE)
    setmetatile(12, 17, 0x255, TRUE)
    setmetatile(12, 18, 0x25D, TRUE)
    setmetatile(6, 21, 0x255, TRUE)
    setmetatile(6, 22, 0x25D, TRUE)
    setmetatile(12, 21, 0x255, TRUE)
    setmetatile(12, 22, 0x25D, TRUE)
    special(DrawWholeMapView)
    fadescreenspeed(FADE_FROM_WHITE, 2)
    msgbox(format("Every lamp in the library brightens at once, as if the room were listening."), MSGBOX_DEFAULT)
    closemessage
    setspeaker(Ichor_League_Text_NameHypatia)
    message(format("A question first. The only one I ever ask. Who are you?"))
    waitmessage
    dynmultichoice(15, 6, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, Olympus_SeatOfAthena_Text_MyName, Olympus_SeatOfAthena_Text_WhatIDid, Olympus_SeatOfAthena_Text_DontKnow)
    setspeaker(Ichor_League_Text_NameHypatia)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("That's what they call you. I asked who you are."))
    } elif (var(VAR_RESULT) == 1) {
        msgbox(format("Hm. A better answer than most. Deeds can be argued with, though."))
    } else {
        msgbox(format("The only honest answer anyone has ever given me. Let's find out together."))
    }
    setspeaker(Ichor_League_Text_NameHypatia)
    msgbox(format("Every scroll in this room was written about someone. Every one of them has an ending.\pNot yours. No one wrote you.\pSo who are you? Answer in battle. It's quicker."))
    trainerbattle_no_intro(TRAINER_ICHOR_HYPATIA, Olympus_SeatOfAthena_Text_Defeat)
    setflag(FLAG_ICHOR_BEAT_HYPATIA)
    setvar(VAR_ELITE_4_STATE, 6)
    call(Olympus_SeatOfAthena_EventScript_SetOpen)
    call(Ichor_League_EventScript_DoorOpened)
    setspeaker(Ichor_League_Text_NameHypatia)
    msgbox(format("Most people answer with what they were told. You answered with what you did.\pOlympias waits beyond. She tells stories. Be careful which ones you believe."))
    release
}

script Olympus_SeatOfAthena_EventScript_ExitGate {
    lockall
    if (!flag(FLAG_ICHOR_BEAT_HYPATIA)) {
        releaseall
        end
    }
    playse(SE_DOOR)
    waitse
    warp(MAP_OLYMPUS_SEAT_OF_HERA, 0)
    waitstate
    releaseall
}

