    ]
}

script Olympus_SeatOfAthena_EventScript_FaceNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script Olympus_SeatOfAthena_EventScript_WalkIn {
    lockall
    call(Ichor_League_EventScript_WalkIn)
    call(Olympus_SeatOfAthena_EventScript_SetClosed)
    special(DrawWholeMapView)
    setvar(VAR_ELITE_4_STATE, 5)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, Olympus_SeatOfAthena_EventScript_Movement_CameraUp)
    waitmovement(0)
    delay(50)
    applymovement(OBJ_EVENT_ID_CAMERA, Olympus_SeatOfAthena_EventScript_Movement_CameraDown)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
}

movement Olympus_SeatOfAthena_EventScript_Movement_CameraUp { walk_up * 14 }
movement Olympus_SeatOfAthena_EventScript_Movement_CameraDown { walk_fast_down * 14 }

