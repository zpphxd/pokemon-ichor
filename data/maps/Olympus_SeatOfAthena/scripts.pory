script Olympus_SeatOfAthena_EventScript_FaceNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script Olympus_SeatOfAthena_EventScript_WalkIn {
    lockall
    call(Ichor_League_EventScript_WalkIn)
    call(Olympus_SeatOfAthena_EventScript_SetClosed)
    special(DrawWholeMapView)
    setvar(VAR_ELITE_4_STATE, 5)
    releaseall
}

script Olympus_SeatOfAthena_EventScript_SetClosed {
    setmetatile(9, 20, 0x200, TRUE)
    return
}

script Olympus_SeatOfAthena_EventScript_SetOpen {
    setmetatile(9, 2, 0x24D, FALSE)
    return
}

text Olympus_SeatOfAthena_Text_Defeat { "That's an answer. I'll have to think about it." }

script Olympus_SeatOfAthena_EventScript_Hypatia {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameHypatia)
    if (flag(FLAG_ICHOR_BEAT_HYPATIA)) {
        msgbox(format("Most people answer with what they were told. You answered with what you did.\pOlympias waits beyond. She tells stories. Be careful which ones you believe."))
        release
        end
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    msgbox(format("Every scroll in this room was written about someone. Every one of them has an ending.\pNot yours. No one wrote you.\pSo who are you? Answer in battle. It's quicker."))
    trainerbattle_no_intro(TRAINER_ICHOR_HYPATIA, Olympus_SeatOfAthena_Text_Defeat)
    setflag(FLAG_ICHOR_BEAT_HYPATIA)
    setvar(VAR_ELITE_4_STATE, 6)
    call(Olympus_SeatOfAthena_EventScript_SetOpen)
    call(Ichor_League_EventScript_DoorOpened)
    setspeaker(Ichor_League_Text_NameHypatia)
    msgbox(format("Most people answer with what they were told. You answered with what you did.\pOlympias waits beyond. She tells stories. Be careful which ones you believe."))
    release
}

script Olympus_SeatOfAthena_EventScript_ExitGate {
    lockall
    if (!flag(FLAG_ICHOR_BEAT_HYPATIA)) {
        releaseall
        end
    }
    playse(SE_DOOR)
    waitse
    warp(MAP_OLYMPUS_SEAT_OF_HERA, 0)
    waitstate
    releaseall
}
