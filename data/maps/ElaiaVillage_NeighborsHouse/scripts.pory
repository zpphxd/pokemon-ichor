// Kydippe's house: the old midwife, her Galekit, and two Oran Berries. (Galanthis,
// the servant who tricked Eileithyia at Herakles's birth, became the first weasel.)

mapscripts ElaiaVillage_NeighborsHouse_MapScripts {}

text ElaiaVillage_NeighborsHouse_Name_Kydippe { "KYDIPPE" }
text ElaiaVillage_NeighborsHouse_Name_Galekit { "GALEKIT" }

script ElaiaVillage_NeighborsHouse_EventScript_Kydippe {
    lock
    faceplayer
    setspeaker(ElaiaVillage_NeighborsHouse_Name_Kydippe)
    if (flag(FLAG_ICHOR_GOT_KYDIPPE_ORAN)) {
        msgbox(format("Every child I've delivered walks that road one day. Go well."))
    } else {
        msgbox(format("Melitta's child! Come here. I delivered you, you know.\pYou didn't cry. You just looked around, like you'd lost something.\pHere. For the road. Don't tell Philon, he'll want some."))
        giveitem(ITEM_ORAN_BERRY, 2)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_GOT_KYDIPPE_ORAN)
        }
    }
    release
}

script ElaiaVillage_NeighborsHouse_EventScript_Galekit {
    lock
    faceplayer
    playmoncry(SPECIES_GALEKIT, CRY_MODE_NORMAL)
    setspeaker(ElaiaVillage_NeighborsHouse_Name_Galekit)
    msgbox(format("Hee-hee-hee! It grins at the clay goddess in the niche."))
    waitmoncry
    release
}

script ElaiaVillage_NeighborsHouse_EventScript_Niche {
    msgbox(format("A clay Eileithyia stands in the niche. Kydippe never starts a delivery without her."), MSGBOX_SIGN)
}
