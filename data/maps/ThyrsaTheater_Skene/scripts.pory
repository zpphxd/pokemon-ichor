// Inside the skene, Thyrsa's stage building: the backstage corridor behind the
// three stage doors, Silenos's prop room through the arch, and the vestibule by
// the back door. Text from design/phase3/SCRIPT.md, beats 32 and 34 and Part 2.
// Layout and events are generated by tools/ichor/maps/theater.py.
//
// The doors' backs line up with the stage's doors outside (theater x = skene
// x + 10): ivy at (4,2), the palace's at (9-10,2), the goat's at (15,2). During
// the Dionysia's entrances (VAR_ICHOR_DIONYSIA 3-5) their cells open and walking
// into one is an entrance: the player warps out onto the stage, wearing
// VAR_ICHOR_DIONYSIA_MASK, and the theater's script plays it. The rack Thespis
// uses is (6-7, 1-2).
//
// Stubs: ICHOR_STUB_MUSIC (the held drone plays the Hollow's cue, the satyr play
// Elaia's), ICHOR_STUB_KNUCKLEBONES (Silenos's bones are a scripted match, until
// the knucklebones game is on main). The Girdle is the engine's relic, given with
// giveitem (EventScript_IchorAct2_ReceiveGirdle, data/scripts/ichor_act2.pory).

mapscripts ThyrsaTheater_Skene_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(ThyrsaTheater_Skene_EventScript_Setup)
    }
    MAP_SCRIPT_ON_LOAD {
        call(ThyrsaTheater_Skene_EventScript_DrawRoom)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: ThyrsaTheater_Skene_EventScript_OnFrame
    ]
}

text ThyrsaTheater_Skene_Name_Thespis { "THESPIS" }
text ThyrsaTheater_Skene_Name_Silenos { "SILENOS" }
text ThyrsaTheater_Skene_Name_Alethea { "ALETHEA" }
text ThyrsaTheater_Skene_Name_Stagehand { "STAGEHAND" }

script ThyrsaTheater_Skene_EventScript_Setup {
    clearflag(FLAG_DONT_TRANSITION_MUSIC)
    setflag(FLAG_TEMP_11)
    setflag(FLAG_TEMP_12)
    setflag(FLAG_TEMP_13)
    setflag(FLAG_TEMP_14)
    if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_BACKSTAGE && var(VAR_ICHOR_DIONYSIA) <= DIONYSIA_ENTRANCE_3) {
        clearflag(FLAG_ICHOR_HIDE_THESPIS_SKENE)
        clearflag(FLAG_TEMP_11)
    } else {
        setflag(FLAG_ICHOR_HIDE_THESPIS_SKENE)
        // leaving the skene hangs the mask back on the rack
        setvar(VAR_ICHOR_DIONYSIA_MASK, DIONYSIA_MASK_NONE)
    }
    if (var(VAR_ICHOR_DIONYSIA) == DIONYSIA_BACKSTAGE) {
        clearflag(FLAG_TEMP_12)
        savebgm(MUS_ICHOR_HOLLOW)   // ICHOR_STUB_MUSIC: the held drone
    }
    if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_ENTRANCE_1 && var(VAR_ICHOR_DIONYSIA) <= DIONYSIA_ENTRANCE_3) {
        setvar(VAR_TEMP_1, 1)       // the doors are entrances
        if (var(VAR_ICHOR_DIONYSIA) == DIONYSIA_ENTRANCE_1) {
            savebgm(MUS_ICHOR_HOLLOW)   // ICHOR_STUB_MUSIC: the held drone
        } else {
            savebgm(MUS_ICHOR_ELAIA)    // ICHOR_STUB_MUSIC: MUS_ICHOR_SATYR_PLAY
        }
    }
    if (flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        clearflag(FLAG_TEMP_13)
        clearflag(FLAG_TEMP_14)
    }
}

script ThyrsaTheater_Skene_EventScript_DrawRoom {
    switch (var(VAR_ICHOR_DIONYSIA)) {
        case DIONYSIA_BACKSTAGE:
            call(ThyrsaTheater_Skene_EventScript_RackTwoMasks)
        case DIONYSIA_ENTRANCE_1:
        case DIONYSIA_ENTRANCE_2:
        case DIONYSIA_ENTRANCE_3:
            call(ThyrsaTheater_Skene_EventScript_RackThreeMasks)
            // the doors' cells open: walking into one is an entrance
            setmetatile(SKENE_DOOR_IVY_X, SKENE_DOOR_Y, METATILE_Skene_DoorIvy, FALSE)
            setmetatile(SKENE_DOOR_CROWN_X, SKENE_DOOR_Y, METATILE_Skene_DoorCrownL, FALSE)
            setmetatile(10, SKENE_DOOR_Y, METATILE_Skene_DoorCrownR, FALSE)
            setmetatile(SKENE_DOOR_GOAT_X, SKENE_DOOR_Y, METATILE_Skene_DoorGoat, FALSE)
    }
    if (flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        // the masks came home by themselves: Prosomime on every peg
        setmetatile(6, 1, METATILE_Skene_RackFull_TL, TRUE)
        setmetatile(7, 1, METATILE_Skene_RackFull_TR, TRUE)
        setmetatile(6, 2, METATILE_Skene_RackFull_BL, TRUE)
        setmetatile(7, 2, METATILE_Skene_RackFull_BR, TRUE)
        setmetatile(12, 1, METATILE_Skene_RackFull_TL, TRUE)
        setmetatile(13, 1, METATILE_Skene_RackFull_TR, TRUE)
        setmetatile(12, 2, METATILE_Skene_RackFull_BL, TRUE)
        setmetatile(13, 2, METATILE_Skene_RackFull_BR, TRUE)
    }
    if (flag(FLAG_ICHOR_GOT_GIRDLE_OF_HERAKLES)) {
        call(ThyrsaTheater_Skene_EventScript_GirdleGone)
        call(ThyrsaTheater_Skene_EventScript_PageGone)
    }
}

script ThyrsaTheater_Skene_EventScript_RackTwoMasks {
    setmetatile(6, 1, METATILE_Skene_RackTwo_TL, TRUE)
    setmetatile(7, 1, METATILE_Skene_RackTwo_TR, TRUE)
    setmetatile(6, 2, METATILE_Skene_RackTwo_BL, TRUE)
    setmetatile(7, 2, METATILE_Skene_RackTwo_BR, TRUE)
}

script ThyrsaTheater_Skene_EventScript_RackThreeMasks {
    setmetatile(6, 1, METATILE_Skene_RackThree_TL, TRUE)
    setmetatile(7, 1, METATILE_Skene_RackThree_TR, TRUE)
    setmetatile(6, 2, METATILE_Skene_RackThree_BL, TRUE)
    setmetatile(7, 2, METATILE_Skene_RackThree_BR, TRUE)
}

script ThyrsaTheater_Skene_EventScript_GirdleGone {
    setmetatile(2, 7, METATILE_Skene_GirdleEmpty_Upper, TRUE)
    setmetatile(2, 8, METATILE_Skene_GirdleEmpty_Lower, TRUE)
}

script ThyrsaTheater_Skene_EventScript_PageGone {
    setmetatile(7, 7, METATILE_Skene_Winch_TL, TRUE)
    setmetatile(8, 7, METATILE_Skene_Winch_TR, TRUE)
    setmetatile(7, 8, METATILE_Skene_Winch_BL, TRUE)
    setmetatile(8, 8, METATILE_Skene_Winch_BR, TRUE)
}

script ThyrsaTheater_Skene_EventScript_OnFrame {
    setvar(VAR_TEMP_0, 1)
    if (var(VAR_ICHOR_DIONYSIA) == DIONYSIA_BACKSTAGE) {
        goto(ThyrsaTheater_Skene_EventScript_Backstage)
    }
}

// ---------------------------------------------------------------------------
// Beat 32, backstage: Thespis at the empty rack
// ---------------------------------------------------------------------------

script ThyrsaTheater_Skene_EventScript_Backstage {
    lockall
    hidefollower
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    applymovement(LOCALID_SKENE_THESPIS, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("You're awake. Good. Then I'm not mad."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("Those are my masks on their faces. My Prosomime. I raised every one."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("Someone's taught them a new trick. They show the audience what it wants."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("And what Thyrsa wants is an ending. A real one. Nothing after it."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("That's what this play is selling, child. An ending."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("A tragedy with no satyr play after it is just a funeral."))
    closemessage
    // he takes a mask from under his robe and hangs it beside the other two
    applymovement(LOCALID_SKENE_THESPIS, Common_Movement_FaceUp)
    waitmovement(0)
    playse(SE_SELECT)
    call(ThyrsaTheater_Skene_EventScript_RackThreeMasks)
    special(DrawWholeMapView)
    delay(20)
    applymovement(LOCALID_SKENE_THESPIS, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("The satyr mask. The play forgot it. Thyrsa didn't. Not yet."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("Three entrances, like my temple. Make them laugh, and the masks let go."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("Comedy first, to wake them. Then tragedy, played so badly it hurts."))
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("Then the satyrs. The ending they left out."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("I'll bring the chorus. Well. I'll bring me. I'm the chorus."))
    setspeaker(ThyrsaTheater_Skene_Name_Alethea)
    msgbox(format("I'll be in the seats. Watching the masks. Somebody should."))
    closemessage
    // Alethea goes back out to her seat
    applymovement(LOCALID_SKENE_ALETHEA, ThyrsaTheater_Skene_Movement_AletheaToSeat)
    waitmovement(0)
    removeobject(LOCALID_SKENE_ALETHEA)
    setflag(FLAG_TEMP_12)
    setvar(VAR_ICHOR_DIONYSIA, DIONYSIA_ENTRANCE_1)
    setvar(VAR_ICHOR_DIONYSIA_MASK, DIONYSIA_MASK_NONE)
    setvar(VAR_TEMP_1, 1)
    setmetatile(SKENE_DOOR_IVY_X, SKENE_DOOR_Y, METATILE_Skene_DoorIvy, FALSE)
    setmetatile(SKENE_DOOR_CROWN_X, SKENE_DOOR_Y, METATILE_Skene_DoorCrownL, FALSE)
    setmetatile(10, SKENE_DOOR_Y, METATILE_Skene_DoorCrownR, FALSE)
    setmetatile(SKENE_DOOR_GOAT_X, SKENE_DOOR_Y, METATILE_Skene_DoorGoat, FALSE)
    releaseall
}

// ---------------------------------------------------------------------------
// The rack and the doors: the entrances
// ---------------------------------------------------------------------------

text ThyrsaTheater_Skene_Text_Comic { "COMIC" }
text ThyrsaTheater_Skene_Text_Tragic { "TRAGIC" }
text ThyrsaTheater_Skene_Text_Satyr { "SATYR" }
text ThyrsaTheater_Skene_Text_None { "NONE" }

script ThyrsaTheater_Skene_EventScript_Rack {
    lock
    if (var(VAR_ICHOR_DIONYSIA) >= DIONYSIA_ENTRANCE_1 && var(VAR_ICHOR_DIONYSIA) <= DIONYSIA_ENTRANCE_3) {
        message(format("A rack of masks: one laughing, one weeping, one with goat's ears.\pWhich will you wear?"))
        waitmessage
        dynmultichoice(20, 2, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, ThyrsaTheater_Skene_Text_Comic,
                       ThyrsaTheater_Skene_Text_Tragic, ThyrsaTheater_Skene_Text_Satyr, ThyrsaTheater_Skene_Text_None)
        switch (var(VAR_RESULT)) {
            case 0:
                setvar(VAR_ICHOR_DIONYSIA_MASK, DIONYSIA_MASK_COMIC)
                playse(SE_SELECT)
                msgbox(format("{PLAYER} put on the comic mask."))
            case 1:
                setvar(VAR_ICHOR_DIONYSIA_MASK, DIONYSIA_MASK_TRAGIC)
                playse(SE_SELECT)
                msgbox(format("{PLAYER} put on the tragic mask."))
            case 2:
                setvar(VAR_ICHOR_DIONYSIA_MASK, DIONYSIA_MASK_SATYR)
                playse(SE_SELECT)
                msgbox(format("{PLAYER} put on the satyr mask."))
            case 3:
                setvar(VAR_ICHOR_DIONYSIA_MASK, DIONYSIA_MASK_NONE)
                msgbox(format("{PLAYER} hung the mask back on its peg."))
        }
        release
        end
    }
    if (flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        goto(ThyrsaTheater_Skene_EventScript_RackAfter)
    }
    msgbox(format("Empty pegs. Every mask in the skene went missing before the festival."), MSGBOX_DEFAULT)
    release
}

// After the Dionysia, in the evening and at night, one mask a day isn't a mask.
script ThyrsaTheater_Skene_EventScript_RackAfter {
    gettimeofday
    if ((var(VAR_0x8000) == TIME_EVENING || var(VAR_0x8000) == TIME_NIGHT) && !flag(FLAG_DAILY_ICHOR_SKENE_MASK)) {
        msgbox(format("A tragic mask on a peg. Its eyes follow you down the rack."))
        msgbox(format("…It's not a mask."))
        closemessage
        setflag(FLAG_DAILY_ICHOR_SKENE_MASK)
        setwildbattle(SPECIES_PROSOMIME, 26)
        dowildbattle
        release
        end
    }
    msgbox(format("Masks on pegs. Every one of them is looking at the door."))
    release
}

script ThyrsaTheater_Skene_EventScript_RackTwo {
    if (flag(FLAG_ICHOR_DIONYSIA_DONE)) {
        goto(ThyrsaTheater_Skene_EventScript_RackAfter)
    }
    msgbox(format("Empty pegs. Every mask in the skene went missing before the festival."), MSGBOX_SIGN)
}

// Walking into a stage door from the wings is an entrance: out onto the stage
// through the matching door outside, wearing the mask.
script ThyrsaTheater_Skene_EventScript_Entrance {
    lockall
    getplayerxy(VAR_0x8004, VAR_0x8005)
    playse(SE_DOOR)
    setflag(FLAG_DONT_TRANSITION_MUSIC)
    fadescreen(FADE_TO_BLACK)
    switch (var(VAR_0x8004)) {
        case SKENE_DOOR_IVY_X:
            warpsilent(MAP_THYRSA_THEATER, THEATER_DOOR_IVY_X, THEATER_DOOR_Y)
        case SKENE_DOOR_CROWN_X:
            warpsilent(MAP_THYRSA_THEATER, THEATER_DOOR_CROWN_X, THEATER_DOOR_Y)
        case 10:
            warpsilent(MAP_THYRSA_THEATER, 20, THEATER_DOOR_Y)
        default:
            warpsilent(MAP_THYRSA_THEATER, THEATER_DOOR_GOAT_X, THEATER_DOOR_Y)
    }
    waitstate
}

// Mid-play, the back door is not the way.
script ThyrsaTheater_Skene_EventScript_NotThatWay {
    lockall
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Not that way! The stage is through the doors!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
    waitmovement(0)
    releaseall
}

script ThyrsaTheater_Skene_EventScript_Thespis {
    setspeaker(ThyrsaTheater_Skene_Name_Thespis)
    msgbox(format("Comedy first, to wake them. Then tragedy, played so badly it hurts.\pThen the satyrs. The ending they left out."), MSGBOX_NPC)
}

script ThyrsaTheater_Skene_EventScript_SilenosWings {
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("I'll bring the chorus. Well. I'll bring me. I'm the chorus."), MSGBOX_NPC)
}

script ThyrsaTheater_Skene_EventScript_AletheaWings {
    setspeaker(ThyrsaTheater_Skene_Name_Alethea)
    msgbox(format("I'll be in the seats. Watching the masks. Somebody should."), MSGBOX_NPC)
}

script ThyrsaTheater_Skene_EventScript_Stagehand {
    setspeaker(ThyrsaTheater_Skene_Name_Stagehand)
    msgbox(format("The masks came home by themselves. Floated in over the orchestra."), MSGBOX_NPC)
    setspeaker(ThyrsaTheater_Skene_Name_Stagehand)
    msgbox(format("Thespis counted them twice. Then he sat down and cried."))
    setspeaker(ThyrsaTheater_Skene_Name_Stagehand)
    msgbox(format("Actors. You'd think they'd be used to it."))
}

// ---------------------------------------------------------------------------
// Beat 34: Silenos's contest, the Girdle of Herakles
// ---------------------------------------------------------------------------

text ThyrsaTheater_Skene_Text_Bones { "BONES" }
text ThyrsaTheater_Skene_Text_Riddle { "A RIDDLE" }
text ThyrsaTheater_Skene_Text_Fight { "A FIGHT" }
text ThyrsaTheater_Skene_Text_NotNow { "NOT NOW" }

script ThyrsaTheater_Skene_EventScript_Silenos {
    lock
    if (flag(FLAG_ICHOR_GOT_GIRDLE_OF_HERAKLES)) {
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("Herakles had twelve labors, they say. I only ever had the one. Staying upright."))
        release
        end
    }
    if (!flag(FLAG_ICHOR_SILENOS_MET)) {
        setflag(FLAG_ICHOR_SILENOS_MET)
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("Ah! The goat-door hero. Sit. Mind the lion. It's a costume. Mostly."))
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("You want the belt. Everyone who sees it wants the belt."))
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("Herakles's own. He bet it on a drinking match with the god himself."))
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("Herakles drank a river. The god drank the sea. Herakles lost."))
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("Lost his shirt too, but that's another play."))
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("I've kept it since. I keep everything. Ask the actors."))
        setspeaker(ThyrsaTheater_Skene_Name_Silenos)
        msgbox(format("Win it off me. Two out of three. Bones, a riddle, or a fight."))
    }
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    message(format("Pick one. Lose, and pick again. I've nowhere to be. Ever."))
    waitmessage
    // each contest won leaves the menu
    if (!flag(FLAG_ICHOR_SILENOS_WON_BONES)) {
        dynmultipush(ThyrsaTheater_Skene_Text_Bones, 0)
    }
    if (!flag(FLAG_ICHOR_SILENOS_WON_RIDDLE)) {
        dynmultipush(ThyrsaTheater_Skene_Text_Riddle, 1)
    }
    if (!flag(FLAG_ICHOR_SILENOS_WON_FIGHT)) {
        dynmultipush(ThyrsaTheater_Skene_Text_Fight, 2)
    }
    dynmultipush(ThyrsaTheater_Skene_Text_NotNow, 3)
    dynmultistack(20, 2, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    switch (var(VAR_RESULT)) {
        case 0:
            call(ThyrsaTheater_Skene_EventScript_Bones)
        case 1:
            call(ThyrsaTheater_Skene_EventScript_Riddle)
        case 2:
            call(ThyrsaTheater_Skene_EventScript_Fight)
        default:
            release
            end
    }
    // two wins of three: the girdle
    setvar(VAR_0x8006, 0)
    if (flag(FLAG_ICHOR_SILENOS_WON_BONES)) {
        addvar(VAR_0x8006, 1)
    }
    if (flag(FLAG_ICHOR_SILENOS_WON_RIDDLE)) {
        addvar(VAR_0x8006, 1)
    }
    if (flag(FLAG_ICHOR_SILENOS_WON_FIGHT)) {
        addvar(VAR_0x8006, 1)
    }
    if (var(VAR_0x8006) >= 2) {
        goto(ThyrsaTheater_Skene_EventScript_TheGirdle)
    }
    release
}

// Bones. ICHOR_STUB_KNUCKLEBONES: a scripted match until the knucklebones game is
// on main. His bones are loaded: a six comes up three times in ten. Two of his
// sixes running put LOADED! in the menu, and calling it wins at once.
text ThyrsaTheater_Skene_Text_Throw { "THROW" }
text ThyrsaTheater_Skene_Text_Loaded { "LOADED!" }

script ThyrsaTheater_Skene_EventScript_Bones {
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("My bones. Old and lucky. Don't look at them too closely."))
    setvar(VAR_TEMP_2, 0)   // his sixes running
    setvar(VAR_TEMP_3, 0)   // throws you've won
    setvar(VAR_TEMP_4, 0)   // throws he's won
    while (var(VAR_TEMP_3) < 2 && var(VAR_TEMP_4) < 2) {
        setspeaker(SP_NAME_NONE)
        message(format("Your throw."))
        waitmessage
        dynmultipush(ThyrsaTheater_Skene_Text_Throw, 0)
        if (var(VAR_TEMP_2) >= 2) {
            dynmultipush(ThyrsaTheater_Skene_Text_Loaded, 1)
        }
        dynmultistack(20, 2, TRUE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
        if (var(VAR_RESULT) == 1) {
            closemessage
            setspeaker(ThyrsaTheater_Skene_Name_Silenos)
            msgbox(format("…Ha! Ha ha! You caught me! Nobody catches me!"))
            setspeaker(ThyrsaTheater_Skene_Name_Silenos)
            msgbox(format("Your point. Fair's fair. Well. Unfair's unfair."))
            setflag(FLAG_ICHOR_SILENOS_WON_BONES)
            return
        }
        playse(SE_BALL)
        random(10)
        if (var(VAR_RESULT) < 3) {
            addvar(VAR_TEMP_2, 1)
            msgbox(format("Silenos throws. Sixes! He beams at them."))
            random(10)
            if (var(VAR_RESULT) < 2) {
                addvar(VAR_TEMP_3, 1)
                msgbox(format("…And yours beat them anyway."))
            } else {
                addvar(VAR_TEMP_4, 1)
                msgbox(format("Yours don't come close."))
            }
        } else {
            setvar(VAR_TEMP_2, 0)
            msgbox(format("Silenos throws. He frowns at them."))
            random(10)
            if (var(VAR_RESULT) < 6) {
                addvar(VAR_TEMP_3, 1)
                msgbox(format("Yours beat his."))
            } else {
                addvar(VAR_TEMP_4, 1)
                msgbox(format("His still beat yours."))
            }
        }
    }
    closemessage
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    if (var(VAR_TEMP_3) >= 2) {
        msgbox(format("Beat loaded bones, fair and square? The god's looking after you."))
        setflag(FLAG_ICHOR_SILENOS_WON_BONES)
    } else {
        msgbox(format("The bones love me. They always have. Again?"))
    }
}

// A riddle: three tries, a new riddle after each miss. A loss starts again at
// the first.
text ThyrsaTheater_Skene_Text_ARoad { "A ROAD" }
text ThyrsaTheater_Skene_Text_ARiver { "A RIVER" }
text ThyrsaTheater_Skene_Text_ADonkey { "A DONKEY" }
text ThyrsaTheater_Skene_Text_APoet { "A POET" }
text ThyrsaTheater_Skene_Text_Wine { "WINE" }
text ThyrsaTheater_Skene_Text_Years { "YEARS" }
text ThyrsaTheater_Skene_Text_Footsteps { "FOOTSTEPS" }
text ThyrsaTheater_Skene_Text_Bread { "BREAD" }
text ThyrsaTheater_Skene_Text_TheSea { "THE SEA" }
text ThyrsaTheater_Skene_Text_ATowel { "A TOWEL" }
text ThyrsaTheater_Skene_Text_SilenosChoice { "SILENOS" }
text ThyrsaTheater_Skene_Text_TheSun { "THE SUN" }

script ThyrsaTheater_Skene_EventScript_Riddle {
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("A riddle! Not the Sphinx's. Everyone knows that one."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("She sat on a rock outside this city and ate everyone who got it wrong."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("I just take your belt. Much nicer."))
    // 1
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    message(format("“I've a mouth that never eats, a bed I never sleep in, and I run with no legs.”"))
    waitmessage
    dynmultichoice(20, 2, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, ThyrsaTheater_Skene_Text_ARoad,
                   ThyrsaTheater_Skene_Text_ARiver, ThyrsaTheater_Skene_Text_ADonkey, ThyrsaTheater_Skene_Text_APoet)
    if (var(VAR_RESULT) == 1) {
        goto(ThyrsaTheater_Skene_EventScript_RiddleRight)
    }
    call(ThyrsaTheater_Skene_EventScript_RiddleWrong)
    // 2
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    message(format("“The more of me you take, the more of me you leave behind.”"))
    waitmessage
    dynmultichoice(20, 2, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, ThyrsaTheater_Skene_Text_Wine,
                   ThyrsaTheater_Skene_Text_Years, ThyrsaTheater_Skene_Text_Footsteps, ThyrsaTheater_Skene_Text_Bread)
    if (var(VAR_RESULT) == 2) {
        goto(ThyrsaTheater_Skene_EventScript_RiddleRight)
    }
    call(ThyrsaTheater_Skene_EventScript_RiddleWrong)
    // 3
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    message(format("“What gets wetter, the more it dries?”"))
    waitmessage
    dynmultichoice(20, 2, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, ThyrsaTheater_Skene_Text_TheSea,
                   ThyrsaTheater_Skene_Text_ATowel, ThyrsaTheater_Skene_Text_SilenosChoice, ThyrsaTheater_Skene_Text_TheSun)
    if (var(VAR_RESULT) == 1) {
        goto(ThyrsaTheater_Skene_EventScript_RiddleRight)
    }
    closemessage
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Three wrong! Come back when you're sober. I mean when I am."))
}

script ThyrsaTheater_Skene_EventScript_RiddleWrong {
    closemessage
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Wrong! Have another. I've hundreds. Mostly about wine."))
}

script ThyrsaTheater_Skene_EventScript_RiddleRight {
    closemessage
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Ha! Clever thing. Your point."))
    setflag(FLAG_ICHOR_SILENOS_WON_RIDDLE)
    return
}

script ThyrsaTheater_Skene_EventScript_Fight {
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("A fight? At my age? …Lovely. I've been bored since Herakles."))
    closemessage
    trainerbattle_no_intro(TRAINER_ICHOR_SILENOS, ThyrsaTheater_Skene_Text_SilenosDefeat)
    setflag(FLAG_ICHOR_SILENOS_WON_FIGHT)
}

text ThyrsaTheater_Skene_Text_SilenosDefeat {
    format("Oof. Somebody fetch my donkey. …Oh. That was my donkey.")
}

// The second win: the girdle, Daedalus's page, and what Kleon asked him.
script ThyrsaTheater_Skene_EventScript_TheGirdle {
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Two! Two of three! The belt's yours."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Herakles won't mind. He's a constellation now. Very hard to reach."))
    closemessage
    // he lifts the girdle off its peg and buckles it round the player
    applymovement(LOCALID_SKENE_SILENOS, Common_Movement_FaceUp)
    waitmovement(0)
    playse(SE_SELECT)
    call(ThyrsaTheater_Skene_EventScript_GirdleGone)
    special(DrawWholeMapView)
    applymovement(LOCALID_SKENE_SILENOS, Common_Movement_FacePlayer)
    waitmovement(0)
    call(EventScript_IchorAct2_ReceiveGirdle)
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Put your back into a thing with that on, and the thing moves."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Fallen drums, old columns. Thyrsa's full of them. So's the road west."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("There's one in the west gate right now, I hear. The god's cart."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("He drives like he drinks."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("And take this, will you? It's pinned to the crane."))
    closemessage
    // he unpins a sheet of ruled parchment from the god-machine's hook
    applymovement(LOCALID_SKENE_SILENOS, Common_Movement_FaceRight)
    waitmovement(0)
    playse(SE_SELECT)
    call(ThyrsaTheater_Skene_EventScript_PageGone)
    special(DrawWholeMapView)
    applymovement(LOCALID_SKENE_SILENOS, Common_Movement_FacePlayer)
    waitmovement(0)
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Your Daedalus drew our crane. Take it, it frightens the actors."))
    call(EventScript_IchorAct2_ReceiveDaedalusPage3)
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Your Lakonian friend came by, before the play."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Asked if it was true, what they say I said once. To King Midas."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("“Best of all is never to be born. Second best is to die young.”"))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("I told him I was drunk when I said it. He didn't laugh."))
    setspeaker(ThyrsaTheater_Skene_Name_Silenos)
    msgbox(format("Odd boy. Most people laugh."))
    release
}

// ---------------------------------------------------------------------------
// The prop room's things (Part 2)
// ---------------------------------------------------------------------------

script ThyrsaTheater_Skene_EventScript_CrownOfStars {
    msgbox(format("A crown of stars, for the play where the princess is left on a beach.\pIt ends well. Eventually."), MSGBOX_SIGN)
}

script ThyrsaTheater_Skene_EventScript_Sickle {
    msgbox(format("A painted wooden sickle. It's much lighter than it looked on stage."), MSGBOX_SIGN)
}

script ThyrsaTheater_Skene_EventScript_GoldMask {
    msgbox(format("A gold mask with its eyes shut, as if it were asleep.\pThe actor who wore it ran off without it."), MSGBOX_SIGN)
}

script ThyrsaTheater_Skene_EventScript_LionSkin {
    msgbox(format("A lion skin with the head still on. The mouth is the eyehole.\pA label on the paw: HERAKLES. DO NOT WEAR. IT BITES."), MSGBOX_SIGN)
}

script ThyrsaTheater_Skene_EventScript_Winch {
    if (flag(FLAG_ICHOR_GOT_GIRDLE_OF_HERAKLES)) {
        msgbox(format("The god-machine's winch. Its rope runs up through a hatch to the crane on the roof."), MSGBOX_SIGN)
    } else {
        msgbox(format("The god-machine's winch. Its rope runs up through a hatch to the crane on the roof.\pA sheet of old parchment is pinned to the hook."), MSGBOX_SIGN)
    }
}

script ThyrsaTheater_Skene_EventScript_GirdlePeg {
    if (flag(FLAG_ICHOR_GOT_GIRDLE_OF_HERAKLES)) {
        msgbox(format("An empty peg, and a pale stripe on the wall where a belt hung for an age."), MSGBOX_SIGN)
    } else {
        msgbox(format("A great leather girdle studded with bronze, hanging on a peg."), MSGBOX_SIGN)
    }
}

script ThyrsaTheater_Skene_EventScript_WineJar {
    msgbox(format("A wine jar painted with dancing satyrs. It's full. It's always full."), MSGBOX_SIGN)
}

script ThyrsaTheater_Skene_EventScript_Barrel {
    msgbox(format("A water barrel and a dipper, for the chorus's throats."), MSGBOX_SIGN)
}

script ThyrsaTheater_Skene_EventScript_Rail {
    msgbox(format("Robes on a rail: for kings, for Fates, for satyrs."), MSGBOX_SIGN)
}

// Alethea from the wings, (11,5), out through the vestibule's doorway
movement ThyrsaTheater_Skene_Movement_AletheaToSeat {
    walk_right * 3
    walk_down * 5
}
