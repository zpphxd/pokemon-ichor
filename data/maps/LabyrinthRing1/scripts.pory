// Ring I, the Threshold (design/LABYRINTH.md §6 Ring I; design/maps/LabyrinthRing1.md).
// Hestia's verb, carry the flame: the threshold hearth's fire lasts 30 steps on the
// torch (36 Mortal, 26 Spartan), the five braziers take only that fire, and a lit
// brazier hands it back. The layout and the generated block below come from
// tools/ichor/maps/labyrinth_ring1.py.

mapscripts LabyrinthRing1_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        call(LabyrinthRing1_EventScript_Register)
        call(LabyrinthRing1_EventScript_DrawState)
        special(Ichor_DrawThread)
    }
}

text LabyrinthRing1_Name_Akakallis { "AKAKALLIS" }
text LabyrinthRing1_Name_Xenodike { "XENODIKE" }

// --- The threshold fire ---------------------------------------------------------------------

// VAR_0x8005: the threshold fire's steps for this difficulty (Mortal 36, Hero 30, Spartan 26).
script LabyrinthRing1_EventScript_FlameBudget {
    specialvar(VAR_RESULT, Ichor_GetStepGlassLimit)
    if (var(VAR_RESULT) == 150) {
        setvar(VAR_0x8005, 36)
    } elif (var(VAR_RESULT) == 100) {
        setvar(VAR_0x8005, 26)
    } else {
        setvar(VAR_0x8005, 30)
    }
}

script LabyrinthRing1_EventScript_Hearth {
    lockall
    call(LabyrinthRing1_EventScript_FlameBudget)
    setvar(VAR_0x8004, FLAME_THRESHOLD)
    special(Ichor_TakeFlame)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("The threshold hearth. The house's oldest fire, low and steady.\p"
                      "It has never gone out. A lit torch could carry it."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("You hold the torch to the hearth. The threshold fire takes.\p"
                      "It won't last long away from home."), MSGBOX_DEFAULT)
    }
    releaseall
}

// A lit brazier hands its fire back to a lit torch.
script LabyrinthRing1_EventScript_Relight {
    call(LabyrinthRing1_EventScript_FlameBudget)
    setvar(VAR_0x8004, FLAME_THRESHOLD)
    special(Ichor_TakeFlame)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("The brazier's fire leaps to your torch."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("The brazier burns steadily."), MSGBOX_DEFAULT)
    }
}

script LabyrinthRing1_EventScript_Draught {
    call(EventScript_IchorDraught)
}

// --- The thread lesson -------------------------------------------------------------------------

script LabyrinthRing1_EventScript_TieLesson {
    setvar(VAR_TEMP_1, 1)
    if (!flag(FLAG_ICHOR_R1_TIE_TAUGHT)) {
        lockall
        setflag(FLAG_ICHOR_R1_TIE_TAUGHT)
        msgbox(format("A bronze ring is set in the floor.\p"
                      "You remember Ariadne's voice on the stair: TIE IT HERE.\p"
                      "(Stand on a ring, open the Relic Ring with SELECT, choose THREAD, then TIE OFF.)"),
               MSGBOX_DEFAULT)
        releaseall
    }
}

// --- The hole down -----------------------------------------------------------------------------

script LabyrinthRing1_EventScript_Hole {
    lockall
    msgbox(format("The rock crumbles under your feet!"), MSGBOX_DEFAULT)
    closemessage
    playse(SE_FALL)
    warp(MAP_LABYRINTH_RING2, 3)
    waitstate
}

// --- Priestesses of the Mistress ---------------------------------------------------------------

script LabyrinthRing1_EventScript_Akakallis {
    trainerbattle_single(TRAINER_ICHOR_AKAKALLIS, LabyrinthRing1_Text_AkakallisIntro, LabyrinthRing1_Text_AkakallisDefeat)
    setspeaker(LabyrinthRing1_Name_Akakallis)
    msgbox(format("Every brazier down here takes only the hearth's fire. Mind the draughts."), MSGBOX_AUTOCLOSE)
}

text LabyrinthRing1_Text_AkakallisIntro {
    format("Ariadne sent you with her thread. So I test you. That's the rule.")
}

text LabyrinthRing1_Text_AkakallisDefeat {
    format("You'll do. Carry the fire carefully. It's older than the walls.")
}

script LabyrinthRing1_EventScript_Xenodike {
    trainerbattle_single(TRAINER_ICHOR_XENODIKE, LabyrinthRing1_Text_XenodikeIntro, LabyrinthRing1_Text_XenodikeDefeat)
    setspeaker(LabyrinthRing1_Name_Xenodike)
    msgbox(format("My sister tests the brave. I test the nosy. You're both."), MSGBOX_AUTOCLOSE)
}

text LabyrinthRing1_Text_XenodikeIntro {
    format("You found my corner. Nobody finds my corner. Battle, then.")
}

text LabyrinthRing1_Text_XenodikeDefeat {
    format("Take the scroll. I was only guarding it from boredom.")
}

// --- Things on the walls -----------------------------------------------------------------------

script LabyrinthRing1_EventScript_Shrine {
    msgbox(format("A little clay goddess in a niche, arms raised, snakes in her hands.\p"
                  "Someone left a smear of honey on her ledge."), MSGBOX_SIGN)
}

script LabyrinthRing1_EventScript_FrescoBulls {
    msgbox(format("A fresco: bulls running nose to tail in a ring.\p"
                  "Under them, a red line runs all the way round, like a thread."), MSGBOX_SIGN)
}

