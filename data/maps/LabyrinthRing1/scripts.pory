script LabyrinthRing1_EventScript_BrazierG {
    lockall
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x35)) {
        call(LabyrinthRing1_EventScript_Relight)
        releaseall
        end
    }
    specialvar(VAR_RESULT, Ichor_GetFlameKind)
    if (var(VAR_RESULT) != FLAME_THRESHOLD) {
        msgbox(format("A cold bronze brazier. The torch's own flame just slides off the ash.\pIt wants the threshold fire."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    if (!flag(FLAG_ICHOR_BRAZIERS_START + 0x30) || !flag(FLAG_ICHOR_BRAZIERS_START + 0x31) || !flag(FLAG_ICHOR_BRAZIERS_START + 0x32) || !flag(FLAG_ICHOR_BRAZIERS_START + 0x33) || !flag(FLAG_ICHOR_BRAZIERS_START + 0x34)) {
        msgbox(format("The gate brazier won't take the fire.\pIts five sisters are still dark."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    setvar(VAR_0x8004, FLAG_ICHOR_BRAZIERS_START + 0x35)
    setvar(VAR_0x8005, FALSE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_ICHOR_RING1_GATE)
        call(LabyrinthRing1_EventScript_DrawState)
        special(DrawWholeMapView)
        setflag(FLAG_ICHOR_RING1_GATE)
        if (var(VAR_ICHOR_KNOSSA) < 6) {
            setvar(VAR_ICHOR_KNOSSA, 6)
        }
        playse(SE_DOOR)
        msgbox(format("Under the gate brazier, the grate grinds up into the stone.\pThe stair down is open."), MSGBOX_DEFAULT)
        call(LabyrinthRing1_EventScript_Relight)
    }
    releaseall
    end
}

script LabyrinthRing1_EventScript_Remains1 {
    msgbox(format("Scratched in the plaster, a row of marks: days, counted.\pThey stop at nine."), MSGBOX_SIGN)
}

script LabyrinthRing1_EventScript_Remains2 {
    msgbox(format("Cut small in the gypsum: SEVEN TURNED LEFT. I TURNED RIGHT.\pThe hand is Athenian."), MSGBOX_SIGN)
}

script LabyrinthRing1_EventScript_Remains3 {
    msgbox(format("A torch, burned out and snapped in two, wedged in a crack in the rock."), MSGBOX_SIGN)
}
