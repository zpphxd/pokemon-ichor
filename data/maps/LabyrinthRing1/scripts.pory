    setvar(VAR_0x8005, 0x321)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x32B)
    setvar(VAR_0x8005, 0x32C)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x2E8)
    setvar(VAR_0x8005, 0x2E9)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x2F3)
    setvar(VAR_0x8005, 0x2F4)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 21)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, THREAD_ANCHOR_R1_THRESHOLD)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 30)
    setvar(VAR_0x8005, 26)
    setvar(VAR_0x8006, THREAD_ANCHOR_R1_GATE)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 8)
    setvar(VAR_0x8005, 16)
    setvar(VAR_0x8006, THREAD_ANCHOR_R1_FRESCO)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 38)
    setvar(VAR_0x8005, 6)
    setvar(VAR_0x8006, THREAD_ANCHOR_R1_CLEFT)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 2)
    setvar(VAR_0x8005, 19)
    setvar(VAR_0x8006, THREAD_ANCHOR_UNNAMED)
    special(Ichor_AddThreadAnchor)
}

// The ring's state, drawn on load and after every change: lit braziers, opened
// doors and gates. Ichor_DrawThread goes after it.
script LabyrinthRing1_EventScript_DrawState {
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x30)) {
        setmetatile(10, 2, 0x33D, TRUE)
        setmetatile(10, 3, 0x345, TRUE)
        setmetatile(11, 2, 0x33E, TRUE)
        setmetatile(11, 3, 0x346, TRUE)
        setmetatile(9, 8, 0x255, TRUE)
        setmetatile(10, 8, 0x320, FALSE)
        setmetatile(11, 8, 0x32B, FALSE)
        setmetatile(12, 8, 0x257, TRUE)
        setmetatile(9, 9, 0x25D, TRUE)
        setmetatile(10, 9, 0x32B, FALSE)
        setmetatile(11, 9, 0x320, FALSE)
        setmetatile(12, 9, 0x24C, TRUE)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x31)) {
        setmetatile(34, 10, 0x33D, TRUE)
        setmetatile(34, 11, 0x345, TRUE)
        setmetatile(35, 10, 0x33E, TRUE)
        setmetatile(35, 11, 0x346, TRUE)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x33)) {
        setmetatile(2, 30, 0x33D, TRUE)
        setmetatile(2, 31, 0x345, TRUE)
        setmetatile(3, 30, 0x33E, TRUE)
        setmetatile(3, 31, 0x346, TRUE)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x34)) {
        setmetatile(14, 30, 0x33D, TRUE)
        setmetatile(14, 31, 0x345, TRUE)
        setmetatile(15, 30, 0x33E, TRUE)
        setmetatile(15, 31, 0x346, TRUE)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x32)) {
        setmetatile(6, 14, 0x33D, TRUE)
        setmetatile(6, 15, 0x345, TRUE)
        setmetatile(7, 14, 0x33E, TRUE)
        setmetatile(7, 15, 0x346, TRUE)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x35)) {
        setmetatile(30, 27, 0x362, TRUE)
        setmetatile(30, 28, 0x36A, TRUE)
        setmetatile(31, 27, 0x363, TRUE)
        setmetatile(31, 28, 0x36B, TRUE)
    }
    if (!flag(FLAG_ICHOR_RING1_GATE)) {
        setmetatile(30, 25, 0x3CB, TRUE)
        setmetatile(31, 25, 0x3CB, TRUE)
    } else {
        setmetatile(30, 25, 0x234, FALSE)
        setmetatile(31, 25, 0x235, FALSE)
    }
}

script LabyrinthRing1_EventScript_BrazierB1 {
    lockall
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x30)) {
        call(LabyrinthRing1_EventScript_Relight)
        releaseall
        end
    }
    specialvar(VAR_RESULT, Ichor_GetFlameKind)
    if (var(VAR_RESULT) != FLAME_THRESHOLD) {
        msgbox(format("A cold bronze brazier. The torch's own flame just slides off the ash.\pIt wants the threshold fire."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    setvar(VAR_0x8004, FLAG_ICHOR_BRAZIERS_START + 0x30)
    setvar(VAR_0x8005, FALSE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        call(LabyrinthRing1_EventScript_DrawState)
        special(DrawWholeMapView)
        msgbox(format("In the new light, a seam shows in the wall to the south.\pA painted door. It swings in at a touch."), MSGBOX_DEFAULT)
        call(LabyrinthRing1_EventScript_Relight)
    }
    releaseall
    end
}

