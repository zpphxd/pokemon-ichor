script Route13_HighlandRoad_EventScript_Beekeeper {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_R13_BEEKEEPER_GIFT)) {
        msgbox(format("Aristaios taught my grandmother's grandmother to keep bees, they say.\pTake a berry from the hedge. The bees won't miss it."))
        giveitem(ITEM_SITRUS_BERRY)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_R13_BEEKEEPER_GIFT)
        }
        release
        end
    }
    msgbox(format("Don't swat. They remember faces."))
    release
}
