// The Leuke snowfield (design/maps/Ascent_Snowfield.md): deep snow and firs above the cloud
// ledges, the Mirror Tarn, the Icefall's mouth in the cliff.
// Generated by tools/ichor/maps/oros_maps.py: edit the builder, not this file.

mapscripts Ascent_Snowfield_MapScripts {}

// Sisyphus's boulder: push it uphill and it rolls back. Every time.
script Ascent_Snowfield_EventScript_Sisyphus {
    lockall
    msgbox(format("A round boulder at the foot of the slope, worn smooth by somebody's hands.\p"
                  "Push it up the hill?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_STRENGTH)
        waitse
        delay(20)
        playse(SE_M_ROCK_THROW)
        msgbox(format("It goes up a step, and another, and then it rolls right back to where it was.\p"
                      "Somewhere above, someone laughs. It isn't a kind laugh."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_Snowfield_EventScript_RopedCave {
    lockall
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        msgbox(format("The Archon's rope is gone, cut through with one clean stroke.\p"
                      "The cave goes down into the mountain, dark and deep, and very cold.\p"
                      "Not a road for today. But it's open now."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("A rope across an icy cave mouth, and a tablet hung from it:\p"
                      "CLOSED BY ORDER OF THE ARCHON.\p"
                      "Cold air breathes out of the dark, as if the mountain were asleep."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_Snowfield_EventScript_BronzeDoor {
    lockall
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        msgbox(format("A bronze door in the cliff, twelve marks round its keyhole.\p"
                      "Since the summit, one mark has warmed: Hestia's. Eleven to go."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("A bronze door set into the cliff. Twelve marks run round its keyhole:\p"
                      "a flame, wings, a sheaf, a cup, a bow, a hammer,\p"
                      "a shell, a lyre, a spear, a trident, an owl, a peacock's eye.\p"
                      "It doesn't so much as rattle."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_Snowfield_EventScript_Leukippos {
    trainerbattle_single(TRAINER_ICHOR_SNOWFIELD_LEUKIPPOS,
        format("The stair's the only way up off the snowfield.\pTheonoe holds the right of it. I hold the left."),
        format("Hold, I said. Not fold."))
    msgbox(format("Cross the tarn up there and don't stop. Or do stop, but on the right rock."), MSGBOX_AUTOCLOSE)
}

script Ascent_Snowfield_EventScript_Theonoe {
    trainerbattle_single(TRAINER_ICHOR_SNOWFIELD_THEONOE,
        format("You waded all that way through the deep snow just to meet me?\pFlattering."),
        format("I'm still flattered."))
    msgbox(format("The ice on the tarn is clear as glass. On a still day you can see the rocks going down."), MSGBOX_AUTOCLOSE)
}

script Ascent_Snowfield_EventScript_Poppy {
    msgbox(format("A red poppy, blooming in the snow where nothing should.\pDemeter's flower: she wore them looking for her daughter. It doesn't care that it's winter."), MSGBOX_SIGN)
}

script Ascent_Snowfield_EventScript_Arrow {
    msgbox(format("A silver arrow sunk to the fletching in a fir's trunk. Nobody here could have shot it.\pArtemis never misses. So whatever it was aimed at, it's not here any more."), MSGBOX_SIGN)
}

script Ascent_Snowfield_EventScript_Wine {
    msgbox(format("A drift stained purple, and a smell like a festival.\pSomeone spilled a whole krater of wine up here. Dionysus doesn't do anything by halves."), MSGBOX_SIGN)
}

script Ascent_Snowfield_EventScript_Sign {
    msgbox(format("THE LEUKE SNOWFIELD\nThe road wades north. Mind the deep snow.\pAbove the stair: the Mirror Tarn, then the Icefall."), MSGBOX_SIGN)
}

script Ascent_Snowfield_EventScript_Tarn {
    msgbox(format("THE MIRROR TARN\nOnce you step on the ice you won't stop till a rock stops you.\pLook before you slide. The mouth of the Icefall is on the far shore."), MSGBOX_SIGN)
}
