script Route23_CretanSea_EventScript_Wreck {
    msgbox(format("The ribs of an old ship, sticking out of the reef like a fish's bones.\p"
                  "Somebody's ship. Somebody's cargo. Somebody's very bad afternoon."), MSGBOX_SIGN)
}

// In the lee of the ribs, half-buried: Skyllias's box (the divers' house reads
// FLAG_ICHOR_SAW_GEAR_BOX). It isn't taken: too heavy, and not yours.
script Route23_CretanSea_EventScript_GearBox {
    lock
    msgbox(format("A lump of green bronze the size of a loaf, cracked open like a nut.\p"
                  "Inside: gears. Dozens of them. Every tooth cut by hand.\p"
                  "On the face, dials. One counts the days. One, the moon.\p"
                  "One counts the games.\p"
                  "Somebody built a box that counted the hours.\p"
                  "The sea got into it. It's stopped."))
    setflag(FLAG_ICHOR_SAW_GEAR_BOX)
    release
}

script Route23_CretanSea_EventScript_SignAntikythera {
    msgbox(format("ANTIKYTHERA. Kythera's little sister, the sailors call her.\p"
                  "Mind the reef. It's had a ship already."), MSGBOX_SIGN)
}

script Route23_CretanSea_EventScript_SignSkandeia {
    msgbox(format("ROUTE 23\pSouth-east: Antikythera, and Knossa beyond."), MSGBOX_SIGN)
}

script Route23_CretanSea_EventScript_SignOpenSea {
    msgbox(format("The open sea. Without a ship, it's a long way to anywhere."), MSGBOX_SIGN)
}
