// Route 23, the Cretan Sea: the western stretch from Skandeia's east bay to
// Antikythera, optional, by Surf (design/phase4/SCRIPT.md Part 2 and "Optional.
// Antikythera: the box of gears"). Layout: tools/ichor/maps/kythera_seas.py.
//
// TODO(act3, Knossa): the east edge is open water where the lane goes on along
// Knossa's coast to Amnisos (Open questions 16); its 8 columns nearest the seam
// are aethos-only, ready for the Knossa writer's eastern map.
// Hidden items: a Star Piece in the wreck's ribs (47,34); a Pearl at the tip
// of Bathyllos's sandbar (16,6).
// Music: MUS_ICHOR_FOAM_ROAD isn't written yet; Act I's road theme stands in.

mapscripts Route23_CretanSea_MapScripts {}

script Route23_CretanSea_EventScript_Bathyllos {
    trainerbattle_single(TRAINER_ICHOR_BATHYLLOS, Kythera_Text_BathyllosIntro, Kythera_Text_BathyllosDefeat)
    setspeaker(Kythera_Text_SpeakerBathyllos)
    msgbox(Kythera_Text_BathyllosAfter, MSGBOX_AUTOCLOSE)
}

