mapscripts Kirrha_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_KIRRHA)
    }
}

// Generated by tools/ichor/maps/gulf.py; edit the builder, not this file.

script Kirrha_EventScript_Stair {
    msgbox(format("The Sacred Way's stair climbs into the falls and is gone.\pAbove the water, the mountain. Above the mountain, Delphoi."), MSGBOX_SIGN)
    end
}

script Kirrha_EventScript_Stele {
    msgbox(format("KIRRHA\nHere the Sacred Way begins. Go up clean.\nTrireme to Aigion from the quay."), MSGBOX_SIGN)
    end
}

script Kirrha_EventScript_Altar {
    msgbox(format("Apollo Delphinios's altar. He came ashore here as a dolphin,\pleading a ship of Knossian sailors to be his priests."), MSGBOX_SIGN)
    end
}

script Kirrha_EventScript_Shrine {
    msgbox(format("Lamps and doves in the rock. Someone keeps the lamps full."), MSGBOX_SIGN)
    end
}

script Kirrha_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_KIRRHA_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}

script Kirrha_EventScript_Merchant {
    goto(ArkadiaApproach_EventScript_Merchant)
}

script Kirrha_EventScript_Guide {
    lock
    faceplayer
    msgbox(format("Delphoi's up there. You can see the roofs when the cloud lifts.\pThe falls took the old stair. You'll need another way.\pArkadia? Cross the Gulf. The captain's on the quay."))
    release
}

script Kirrha_EventScript_Captain {
    lock
    faceplayer
    msgbox(format("Across to Aigion? There's room on the Euploia."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setvar(VAR_ICHOR_GULF_DEST, 0)
        warp(MAP_GULF_TRIREME, 13, 4)
        waitstate
        releaseall
        end
    }
    release
}

script Kirrha_EventScript_Fisher {
    lock
    faceplayer
    msgbox(format("See the islet? The best pearls in the Gulf grow off it.\pYou'd need to swim like a dolphin to get there, mind."))
    release
}

script Kirrha_EventScript_Pilgrim {
    lock
    faceplayer
    msgbox(format("We camp here till the falls drop. Some of us have camped a year.\pThe god will open the way when he means to."))
    release
}
