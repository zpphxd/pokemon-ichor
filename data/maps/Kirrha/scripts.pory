// Kirrha, Delphoi's harbor (SCRIPT.md beat 37A; Part 2's Kirrha roster; Part 6's items).
// Layout and events are generated by tools/ichor/maps/harbors.py (harbors_kirrha.py).
//
// Scene state:
//   VAR_TEMP_1 == 0     Alethea's arrival lines wait across the road from Route 9 (row 2)
//   FLAG_TEMP_2         hides Alethea's copy for the pilgrims' gate scene
//   FLAG_TEMP_3         hides Alethea's copy for the arrival on the road
//   FLAG_ICHOR_HIDE_ALETHEA_KIRRHA  Alethea on the quay: shown from the arrival until the
//                       ferry sails (beat 37B)
// ICHOR_STUB_MUSIC: MUS_ICHOR_ROAD, the road west's theme (Part 9), until Kirrha has a cue.

mapscripts Kirrha_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_ICHOR_VISITED_KIRRHA)
        setflag(FLAG_TEMP_2)
        setflag(FLAG_TEMP_3)
        if (flag(FLAG_ICHOR_ARRIVED_KIRRHA)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            // she arrives with you: not on the quay until the scene sends her down
            setflag(FLAG_ICHOR_HIDE_ALETHEA_KIRRHA)
        }
    }
}

text Kirrha_Name_Alethea { "ALETHEA" }
text Kirrha_Name_Guard { "TEMPLE GUARD" }
text Kirrha_Name_Kronist { "KRONIST" }
text Kirrha_Name_Panopeus { "PANOPEUS" }
text Kirrha_Name_Pilgrim { "PILGRIM" }
text Kirrha_Name_Fishwife { "FISHWIFE" }
text Kirrha_Name_Beggar { "BEGGAR" }
text Kirrha_Name_OldMan { "OLD MAN" }

// ---------------------------------------------------------------------------
// Beat 37A: the arrival. Down the road from the Split Road, Kirrha opens below:
// the harbor full of pilgrims, the ferry at the quay's end. Alethea, walking with
// you, stops beside you; then she goes on down to the quay.
// ---------------------------------------------------------------------------

script Kirrha_EventScript_Arrival {
    lockall
    setvar(VAR_TEMP_1, 1)
    setflag(FLAG_ICHOR_ARRIVED_KIRRHA)
    setflag(FLAG_ICHOR_VISITED_KIRRHA)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) <= 28) {
        addvar(VAR_0x8004, 1)
    } else {
        subvar(VAR_0x8004, 1)
    }
    setobjectxyperm(LOCALID_KIRRHA_ALETHEA_ROAD, VAR_0x8004, 2)
    clearflag(FLAG_TEMP_3)
    addobject(LOCALID_KIRRHA_ALETHEA_ROAD)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    applymovement(LOCALID_KIRRHA_ALETHEA_ROAD, Common_Movement_FaceDown)
    waitmovement(0)
    delay(20)
    setspeaker(Kirrha_Name_Alethea)
    msgbox(format("All these people came by boat to ask Delphoi something.\p"
                  "And the god's not answering. So they're stuck. In a harbor.\p"
                  "The ferry's at the end. There. With the patched sail."))
    closemessage
    applymovement(LOCALID_KIRRHA_ALETHEA_ROAD, Kirrha_Movement_AletheaDownTheRoad)
    waitmovement(0)
    removeobject(LOCALID_KIRRHA_ALETHEA_ROAD)
    setflag(FLAG_TEMP_3)
    clearflag(FLAG_ICHOR_HIDE_ALETHEA_KIRRHA)
    addobject(LOCALID_KIRRHA_ALETHEA)
    releaseall
}

movement Kirrha_Movement_AletheaDownTheRoad { walk_down * 5 }

// Alethea on the quay, by the fish market, until the ferry sails.
script Kirrha_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Alethea)
    if (flag(FLAG_ICHOR_KIRRHA_GATE_SEEN)) {
        msgbox(format("Soon. Truthfully, it's the worst word in the language.\p"
                      "The ferry's at the end. There. With the patched sail."))
    } else {
        msgbox(format("The ferry's at the end. There. With the patched sail."))
    }
    release
}

// ---------------------------------------------------------------------------
// The pilgrims' gate on the sacred road (Route 28, closed until Act III). The
// guards stand in the road's two cells; the player meets them from below, at
// (5,10) or (6,10). The first time, while Alethea is still with you, she comes
// up the road and stands at your other side.
// ---------------------------------------------------------------------------

script Kirrha_EventScript_TempleGuard {
    lock
    faceplayer
    if (flag(FLAG_ICHOR_KIRRHA_GATE_SEEN) || flag(FLAG_ICHOR_GULF_CROSSED)) {
        setspeaker(Kirrha_Name_Guard)
        msgbox(format("The sacred road's shut. By the Pythia's own word.\p"
                      "The god isn't answering questions. Come back when he is."))
        setflag(FLAG_ICHOR_KIRRHA_GATE_SEEN)
        release
        end
    }
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 5) {
        setobjectxyperm(LOCALID_KIRRHA_ALETHEA_GATE, 4, 11)
        setvar(VAR_0x8006, 0)
    } else {
        setobjectxyperm(LOCALID_KIRRHA_ALETHEA_GATE, 7, 11)
        setvar(VAR_0x8006, 1)
    }
    clearflag(FLAG_TEMP_2)
    addobject(LOCALID_KIRRHA_ALETHEA_GATE)
    applymovement(LOCALID_KIRRHA_ALETHEA_GATE, Kirrha_Movement_AletheaUpToGate)
    waitmovement(0)
    setspeaker(Kirrha_Name_Guard)
    msgbox(format("The sacred road's shut. By the Pythia's own word.\p"
                  "The god isn't answering questions. Come back when he is."))
    setspeaker(Kirrha_Name_Alethea)
    msgbox(format("When will that be?"))
    setspeaker(Kirrha_Name_Guard)
    msgbox(format("Ask the Pythia."))
    setspeaker(Kirrha_Name_Alethea)
    msgbox(format("I would. You've shut the road."))
    setspeaker(Kirrha_Name_Guard)
    msgbox(format("She only says one word now, anyway. “Soon.”\p"
                  "All day. Soon. To everyone."))
    closemessage
    delay(30)
    setspeaker(Kirrha_Name_Alethea)
    msgbox(format("Soon. Soon what? Soon when?\p"
                  "Truthfully, it's the worst word in the language."))
    closemessage
    setflag(FLAG_ICHOR_KIRRHA_GATE_SEEN)
    applymovement(LOCALID_KIRRHA_ALETHEA_GATE, Kirrha_Movement_AletheaBackDown)
    waitmovement(0)
    removeobject(LOCALID_KIRRHA_ALETHEA_GATE)
    setflag(FLAG_TEMP_2)
    release
}

movement Kirrha_Movement_AletheaUpToGate { walk_up face_up }
movement Kirrha_Movement_AletheaBackDown { walk_down walk_down }

script Kirrha_EventScript_GateSign {
    msgbox(format("THE SACRED ROAD TO DELPHOI. Closed by order of the Pythia. Soon."), MSGBOX_SIGN)
}

// ---------------------------------------------------------------------------
// The Kronist on the crate at the quay's head (STORY.md §5: unarmed, friendly,
// never battles). Every later YES gets "Come back at noon," whatever the hour.
// ---------------------------------------------------------------------------

script Kirrha_EventScript_Kronist {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Kronist)
    msgbox(format("Delphoi's shut? We're open. Bread, friend. It's free.\p"
                  "And a true reading, if you like. No god required.\p"
                  "The god up there's tired. A thousand years of reading threads.\p"
                  "We read them better. And kinder. May your thread never be cut."))
    msgbox(format("Ask for a reading?"), MSGBOX_YESNO)
    setspeaker(Kirrha_Name_Kronist)
    if (var(VAR_RESULT) == YES) {
        if (flag(FLAG_ICHOR_KIRRHA_KRONIST_READ)) {
            msgbox(format("Come back at noon."))
        } else {
            msgbox(format("Lovely. Give me your hand. Where are you from?"))
            closemessage
            delay(60)
            setspeaker(Kirrha_Name_Kronist)
            msgbox(format("…Not much of a talker. Fine. Your thread's…\p"
                          "Hm. The light's bad on this quay.\p"
                          "Come back at noon. I'll do you properly at noon."))
            setflag(FLAG_ICHOR_KIRRHA_KRONIST_READ)
        }
    } else {
        msgbox(format("Suit yourself. The bread's free either way. That's the point."))
    }
    if (!flag(FLAG_ICHOR_GULF_CROSSED) && !flag(FLAG_ICHOR_KIRRHA_KRONIST_ALETHEA)) {
        setflag(FLAG_ICHOR_KIRRHA_KRONIST_ALETHEA)
        setspeaker(Kirrha_Name_Alethea)
        msgbox(format("“Kinder.” They always say kinder.\p"
                      "A kind lie is still a lie. It's just better dressed."))
    }
    release
}

// ---------------------------------------------------------------------------
// Beat 37B: Panopeus at the gangplank. YES: aboard, and the crossing of Route 10.
// After the first crossing he runs both ways; this is the same question.
// ---------------------------------------------------------------------------

script Kirrha_EventScript_Panopeus {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Panopeus)
    msgbox(format("Aigion, across the gulf. Half a day with a good wind.\p"
                  "A whole day with my brother's wind. He has the other boat.\p"
                  "We fought in the womb, my brother and I. We still fight. We take turns."))
    msgbox(format("Going across?"), MSGBOX_YESNO)
    setspeaker(Kirrha_Name_Panopeus)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The gulf will still be here. So will I, sadly."))
        release
        end
    }
    msgbox(format("Good. Mind the goats. They're paying passengers too."))
    closemessage
    setflag(FLAG_ICHOR_BOARDED_GULF_FERRY)
    clearflag(FLAG_ICHOR_FERRY_TO_KIRRHA)
    if (!flag(FLAG_ICHOR_GULF_CROSSED)) {
        // Alethea boards with you; she's at the stern for the crossing
        setflag(FLAG_ICHOR_HIDE_ALETHEA_KIRRHA)
    }
    fadescreen(FADE_TO_BLACK)
    warpsilent(MAP_GULF_FERRY_DECK, 11, 6)
    waitstate
    release
}

script Kirrha_EventScript_FerrySign {
    msgbox(format("FERRY TO ACHAEA. Captain Panopeus. Goats travel free. People don't."), MSGBOX_SIGN)
}

// ---------------------------------------------------------------------------
// The harbor's people (Part 2's roster)
// ---------------------------------------------------------------------------

script Kirrha_EventScript_Pilgrim1 {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Pilgrim)
    msgbox(format("I sailed from Kythera to ask the god if I should marry.\p"
                  "The god's not answering. So I'm still not married. It's very restful."))
    release
}

script Kirrha_EventScript_Pilgrim2 {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Pilgrim)
    msgbox(format("My whole village put money in for me to ask about the harvest.\p"
                  "I can't go home without an answer. I'll make one up. I've started."))
    release
}

script Kirrha_EventScript_Pilgrim3 {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Pilgrim)
    msgbox(format("Nine days I've waited. They say the Pythia only says “soon” now.\p"
                  "I've decided “soon” means “go home”. I'll go soon."))
    release
}

script Kirrha_EventScript_Fishwife {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Fishwife)
    msgbox(format("Pilgrims don't buy fish. They fast. Nine days of fasting, now.\p"
                  "I've started selling it to them as medicine. They buy medicine."))
    release
}

// The beggar by the fence: a theoxenia decoy (he has a shadow; your follower
// ignores him). Pay him 100 and he gives you his lucky stone. Zeus Favor +1.
script Kirrha_EventScript_Beggar {
    lock
    faceplayer
    setspeaker(Kirrha_Name_Beggar)
    if (flag(FLAG_ICHOR_DECOY_KIRRHA)) {
        msgbox(format("It never changed my luck once. That's the luck, see."))
        release
        end
    }
    msgbox(format("A coin for an old sailor? I'll drink it, I won't lie to you."))
    msgbox(format("Give him 100?"), MSGBOX_YESNO)
    setspeaker(Kirrha_Name_Beggar)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Fair. I'd have drunk it."))
        release
        end
    }
    checkmoney(100)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("Ha. You're as poor as me. Keep it."))
        release
        end
    }
    removemoney(100)
    playse(SE_SHOP)
    msgbox(format("Honest money for an honest drunk. Here, take my lucky stone."))
    giveitem(ITEM_EVERSTONE)
    if (var(VAR_RESULT) == FALSE) {
        call(Common_EventScript_ShowBagIsFull)
        addmoney(100)
        release
        end
    }
    setvar(VAR_0x8004, ICHOR_GOD_ZEUS)
    setvar(VAR_0x8005, 1)
    special(Ichor_AddFavor)
    setflag(FLAG_ICHOR_DECOY_KIRRHA)
    setspeaker(Kirrha_Name_Beggar)
    msgbox(format("It never changed my luck once. That's the luck, see."))
    release
}

script Kirrha_EventScript_FenceWatcher {
    lock
    faceplayer
    setspeaker(Kirrha_Name_OldMan)
    msgbox(format("That plain's Apollo's. Nobody's ploughed it in a thousand years.\p"
                  "Kirrha taxed the pilgrims once. Too much. The god had us pulled down.\p"
                  "Since then we've been very honest. Painfully honest.\p"
                  "That fishwife sells fish as medicine, but she tells you it's fish."))
    release
}

// ---------------------------------------------------------------------------
// Signs and the dig spot
// ---------------------------------------------------------------------------

script Kirrha_EventScript_TownSign {
    msgbox(format("KIRRHA, the harbor of Delphoi.\n"
                  "North-east: the Split Road. Ferry to Aigion from the quay."), MSGBOX_SIGN)
}

script Kirrha_EventScript_FenceSign {
    msgbox(format("THE PLAIN OF APOLLO. Do not plough, graze, build or argue."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: Kirrha's daily dig spot by the fence of Apollo's plain (Part 6). Digs
// aren't built; when they are: setvar(VAR_0x8004, <daily spot>), setvar(VAR_0x8005,
// ICHOR_DIG_ACT_II), goto(EventScript_IchorDigSpot).
script Kirrha_EventScript_DigFence {
    msgbox(format("Digging in the god's plain is forbidden. The edge is fine.\p"
                  "The earth along the fence has been turned over."), MSGBOX_SIGN)
}
