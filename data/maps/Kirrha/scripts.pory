mapscripts Kirrha_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_KIRRHA)
    }
}
script Kirrha_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_KIRRHA_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}
script Kirrha_EventScript_Merchant {
    goto(ArkadiaApproach_EventScript_Merchant)
}
script Kirrha_EventScript_Guide {
    lock
    faceplayer
    msgbox(format("Delphoi's up there. You can see the roofs when the cloud lifts.\p"
                  "The falls took the old stair. You'll need another way.\p"
                  "Arkadia? Cross the Gulf. The captain's at the pier."))
    release
}
script Kirrha_EventScript_Sign {
    msgbox(format("KIRRHA\nThe Gulf of Korinthos. Trireme to Aigion."), MSGBOX_SIGN)
    end
}
script Kirrha_EventScript_Captain {
    lock
    faceplayer
    msgbox(format("Across to Aigion? There's room on the Euploia."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setvar(VAR_ICHOR_GULF_DEST, 0)
        warp(MAP_GULF_TRIREME, 13, 4)
        waitstate
        releaseall
        end
    }
    release
}
