// Boreas's ridge (design/maps/Ascent_WindRidge.md): a wind-scoured spine over the cloud
// between the Glacier and the terraces above it; the Bellows of Boreas (rubble, two
// drums, two plates, the bar on the last stair).
// Generated by tools/ichor/maps/oros_maps.py: edit the builder, not this file.

mapscripts Ascent_WindRidge_MapScripts {
    MAP_SCRIPT_ON_LOAD: Ascent_WindRidge_EventScript_DrawState
}

script Ascent_WindRidge_EventScript_DrawState {
    if (flag(FLAG_ICHOR_WINDRIDGE_BAR_UP)) {
        setmetatile(22, 21, 0x29D, FALSE)
        setmetatile(19, 23, 0x29B, FALSE)
        setmetatile(25, 23, 0x29B, FALSE)
        setobjectxyperm(LOCALID_ASCENT_WIND_RIDGE_DRUM0, 19, 23)
        setobjectxyperm(LOCALID_ASCENT_WIND_RIDGE_DRUM1, 25, 23)
    }
}

// The Bellows of Boreas: both plates must hold a drum.
script Ascent_WindRidge_EventScript_Plates {
    if (flag(FLAG_ICHOR_WINDRIDGE_BAR_UP)) {
        end
    }
    setvar(VAR_TEMP_9, 0)
    getobjectxy(LOCALID_ASCENT_WIND_RIDGE_DRUM0, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 19 && var(VAR_0x8008) == 23) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 25 && var(VAR_0x8008) == 23) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_ASCENT_WIND_RIDGE_DRUM1, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 19 && var(VAR_0x8008) == 23) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 25 && var(VAR_0x8008) == 23) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_TEMP_9) == 2) {
        lockall
        setflag(FLAG_ICHOR_WINDRIDGE_BAR_UP)
        setmetatile(19, 23, 0x29B, FALSE)
        setmetatile(25, 23, 0x29B, FALSE)
        playse(SE_DOOR)
        special(DrawWholeMapView)
        delay(30)
        playse(SE_M_GUST)
        setmetatile(22, 21, 0x29D, FALSE)
        special(DrawWholeMapView)
        msgbox(format("Both plates sink, and the wind drops all at once, like a breath held.\p"
                      "The bronze bar swings up off the last stair."), MSGBOX_DEFAULT)
        releaseall
    }
}

script Ascent_WindRidge_EventScript_Lever {
    lockall
    if (flag(FLAG_ICHOR_WINDRIDGE_BAR_UP)) {
        msgbox(format("The bar's lever, rimed with frost. The stair is open."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A bronze lever by the stair, Boreas's puffed cheeks cast on it: the seal's reset.\p"
                  "Pull it and set both drums back where the storm left them?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        fadescreen(FADE_TO_BLACK)
        setobjectxyperm(LOCALID_ASCENT_WIND_RIDGE_DRUM0, 17, 29)
        setobjectxy(LOCALID_ASCENT_WIND_RIDGE_DRUM0, 17, 29)
        setobjectxyperm(LOCALID_ASCENT_WIND_RIDGE_DRUM1, 26, 29)
        setobjectxy(LOCALID_ASCENT_WIND_RIDGE_DRUM1, 26, 29)
        playse(SE_M_STRENGTH)
        fadescreen(FADE_FROM_BLACK)
        msgbox(format("Somewhere below, chains run. The drums roll back where the storm left them."), MSGBOX_DEFAULT)
    }
    releaseall
}

// Zeus's eagle on its crag: come close and it goes.
script Ascent_WindRidge_EventScript_EagleFlies {
    if (var(VAR_TEMP_2) == 1) {
        end
    }
    lockall
    setvar(VAR_TEMP_2, 1)
    playmoncry(SPECIES_AETARCH, CRY_MODE_NORMAL)
    applymovement(LOCALID_ASCENT_WIND_RIDGE_EAGLE, Ascent_WindRidge_Movement_EagleUp)
    waitmovement(0)
    removeobject(LOCALID_ASCENT_WIND_RIDGE_EAGLE)
    msgbox(format("The great eagle on the crag looks at you, once, the way a king looks at a coin.\p"
                  "Then it opens its wings and goes, straight up into the sky, toward the summit."), MSGBOX_DEFAULT)
    releaseall
}

movement Ascent_WindRidge_Movement_EagleUp { jump_in_place_down walk_faster_up * 4 }

script Ascent_WindRidge_EventScript_Eagle {
    lock
    msgbox(format("A great eagle, gold at the neck, a thunderbolt's zigzag in the feathers of its back.\p"
                  "It doesn't move. It doesn't need to."), MSGBOX_DEFAULT)
    release
}

script Ascent_WindRidge_EventScript_CloudBridge {
    lockall
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        msgbox(format("The span of cloud reaching east has firmed a little.\p"
                      "There are hoofprints in it now. Something winged has been crossing at night.\p"
                      "It still won't take your weight. Not yet."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("A span of cloud reaches out east from the ridge, flat as a road, toward a green far off.\p"
                      "It looks solid. It isn't. Not yet."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_WindRidge_EventScript_Nephele {
    trainerbattle_single(TRAINER_ICHOR_GLACIER_NEPHELE,
        format("I'm named for the cloud. Up here I can touch it.\pWant to see what's on top of it? Earn it."),
        format("You've earned it."))
    msgbox(format("Walk up the ridge into the white. Keep walking. You'll see."), MSGBOX_AUTOCLOSE)
}

script Ascent_WindRidge_EventScript_Oreithyia {
    trainerbattle_single(TRAINER_ICHOR_WINDRIDGE_OREITHYIA,
        format("Boreas carried off a princess called Oreithyia once. I took the name to annoy him.\pHe's been blowing at me ever since."),
        format("He's laughing at me now."))
    msgbox(format("The drums under the rubble are the bellows' weights. Put them where the wind can't lift them."), MSGBOX_AUTOCLOSE)
}

script Ascent_WindRidge_EventScript_Kalais {
    trainerbattle_single(TRAINER_ICHOR_WINDRIDGE_KALAIS,
        format("Kalais, son of the north wind. Or so my mother says.\pThe spine's narrow. Mind your feet."),
        format("My feet were the problem."))
    msgbox(format("The bar on the last stair is Herakles's kind of lock. Two weights, two plates."), MSGBOX_AUTOCLOSE)
}

script Ascent_WindRidge_EventScript_Lyre {
    msgbox(format("The wind sings through a split in this rock, three notes, then three more, like a lyre being tuned.\pApollo's, they say. He left it here to keep the mountain in tune."), MSGBOX_SIGN)
}

script Ascent_WindRidge_EventScript_Sign {
    msgbox(format("BOREAS'S RIDGE\nThe north wind's road. Above: the terraces, and the Pantheon's gate.\pThe last stair is barred. Mind the drums under the rubble."), MSGBOX_SIGN)
}
