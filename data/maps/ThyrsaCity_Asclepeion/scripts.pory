// The Asclepeion of Thyrsa, built round the spring of Dirke (SCRIPT.md Part 2, Thyrsa).
// Room: tools/ichor/maps/thyrsa_rooms.py. The healer stands at (7,2) behind the carved
// counter, the player at (7,4); the healing basin is at her x-2..x-1, y-1..y, where
// FLDEFF_POKECENTER_HEAL drops the party's balls, as in Akti's.
//
// The healer and the Pithos are Akti's shared scripts (Ichor_EventScript_AsclepeionHealer
// in data/maps/AktiTown_Asclepeion/scripts.pory). The Pithos's menu is written out here,
// because the shared one names Akti's jar.

mapscripts ThyrsaCity_Asclepeion_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_THYRSA_CITY)
    }
}

script ThyrsaCity_Asclepeion_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_THYRSA_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}

script ThyrsaCity_Asclepeion_EventScript_Pithos {
    lockall
    setvar(VAR_0x8004, PC_LOCATION_OTHER)
    msgbox(Ichor_Text_PithosLook)
    msgbox(Ichor_Text_PithosLift)
    goto(ThyrsaCity_Asclepeion_EventScript_PithosMenu)
}

script ThyrsaCity_Asclepeion_EventScript_PithosMenu {
    message(Ichor_Text_PithosReach)
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, Ichor_Text_PithosOptionPokemon,
                   Ichor_Text_PithosOptionThings, Ichor_Text_PithosOptionClose)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("The Pithos of Thyrsa opened."))
            msgbox(Ichor_Text_PithosPokemonRest)
            special(ShowPokemonStorageSystemPC)
            goto(ThyrsaCity_Asclepeion_EventScript_PithosMenu)
        case 1:
            msgbox(Ichor_Text_PithosThings)
            special(PlayerPC)
            goto(ThyrsaCity_Asclepeion_EventScript_PithosMenu)
    }
    msgbox(Ichor_Text_PithosClose)
    releaseall
    end
}

text ThyrsaCity_Asclepeion_Name_Panacoil { "PANACOIL" }

script ThyrsaCity_Asclepeion_EventScript_Panacoil {
    lock
    faceplayer
    setspeaker(ThyrsaCity_Asclepeion_Name_Panacoil)
    msgbox(format("Hss."))
    setspeaker(SP_NAME_NONE)
    msgbox(format("It dips its tail in the spring, then flicks water at you. Diagnosis complete."))
    release
}

script ThyrsaCity_Asclepeion_EventScript_SatyrActor {
    msgbox(format("Sprained it doing the kordax. The satyrs' dance.\p"
                  "It's very undignified. That's the point. I'm still proud."), MSGBOX_NPC)
}

script ThyrsaCity_Asclepeion_EventScript_Pilgrim {
    msgbox(format("Came for the festival. Drank for the festival.\p"
                  "Now I'm here for the festival's consequences."), MSGBOX_NPC)
}

script ThyrsaCity_Asclepeion_EventScript_YoungHealer {
    msgbox(format("Dirke's spring. She was a queen who was very cruel to Antiope.\p"
                  "Her sons tied her to a bull. The gods made her a spring. It's very good for bruises."),
           MSGBOX_NPC)
}

script ThyrsaCity_Asclepeion_EventScript_Statue {
    msgbox(format("Asclepius, his staff wound with a serpent. And, for Thyrsa, a little ivy."), MSGBOX_SIGN)
}

script ThyrsaCity_Asclepeion_EventScript_Spring {
    msgbox(format("The spring of Dirke wells up clear and cold. A runnel carries it under the counter."),
           MSGBOX_SIGN)
}
