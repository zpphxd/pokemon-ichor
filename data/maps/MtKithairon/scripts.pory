// Mt. Kithairon, the maenads' pass: beat 28 (the dancing floor, the shepherds'
// fold) and the mountain's landmarks and trainers. Text from
// design/phase3/SCRIPT.md: beat 28, Part 2 (Mt. Kithairon) and Part 3
// (Kithairon trainers). Layout and events are generated by
// tools/ichor/maps/kithairon.py.
//
// Staging: the road climbs out of the fir clearing's band into the glade at
// (14-15, 36), the trigger. The ring dances on the trampled floor round
// (15, 33): three maenads and two Botrykit, with Euia at the foot of the glade's
// stair, the only way north (26, 32), and Bromia at the glade's back (31, 34).

mapscripts MtKithairon_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_ICHOR_SAW_MAENADS)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            setvar(VAR_TEMP_1, 0)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        // the shrine, once cleansed (desecrated altar 8), shows its clean cup
        if (flag(FLAG_ICHOR_ALTARS_START + 8)) {
            setmetatile(31, 7, METATILE_KithaironPass_Shrine_Top, FALSE)
            setmetatile(31, 8, METATILE_KithaironPass_Shrine, TRUE)
        }
    }
}

text MtKithairon_Text_SpeakerMaenad { "MAENAD" }
text MtKithairon_Text_SpeakerPhorbas { "PHORBAS" }
text MtKithairon_Text_SpeakerLykidas { "LYKIDAS" }
text MtKithairon_Text_SpeakerEuia { "EUIA" }
text MtKithairon_Text_SpeakerBromia { "BROMIA" }
text MtKithairon_Text_SpeakerArimnestos { "ARIMNESTOS" }
text MtKithairon_Text_SpeakerIlys { "ILYS" }
text MtKithairon_Text_IDont { "I DON'T" }
text MtKithairon_Text_GoOn { "GO ON" }

// --- beat 28: the dancing floor ---------------------------------------------------------
script MtKithairon_EventScript_DancingFloor {
    lockall
    hidefollower
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    // Drums; the ring turns twice, a drum on each beat.
    call(MtKithairon_EventScript_RingTurn)
    call(MtKithairon_EventScript_RingTurn)
    setspeaker(MtKithairon_Text_SpeakerMaenad)
    msgbox(format("Euoi! Euoi! The god is coming down the mountain!"))
    msgbox(format("Dance, stranger! Nobody on Kithairon walks. We run, or we dance."))
    closemessage
    // The ring breaks and scatters into the firs, laughing. Euia and Bromia stay.
    playse(SE_M_ENCORE)
    applymovement(LOCALID_KITHAIRON_MAENAD_1, MtKithairon_Movement_ScatterWest)
    applymovement(LOCALID_KITHAIRON_MAENAD_2, MtKithairon_Movement_ScatterNorth)
    applymovement(LOCALID_KITHAIRON_MAENAD_3, MtKithairon_Movement_ScatterEast)
    applymovement(LOCALID_KITHAIRON_BOTRYKIT_1, MtKithairon_Movement_ScatterWest)
    applymovement(LOCALID_KITHAIRON_BOTRYKIT_2, MtKithairon_Movement_ScatterEast)
    waitmovement(0)
    removeobject(LOCALID_KITHAIRON_MAENAD_1)
    removeobject(LOCALID_KITHAIRON_MAENAD_2)
    removeobject(LOCALID_KITHAIRON_MAENAD_3)
    removeobject(LOCALID_KITHAIRON_BOTRYKIT_1)
    removeobject(LOCALID_KITHAIRON_BOTRYKIT_2)
    setflag(FLAG_ICHOR_SAW_MAENADS)
    setvar(VAR_TEMP_1, 1)
    releaseall
}

script MtKithairon_EventScript_RingTurn {
    playse(SE_M_BELLY_DRUM)
    applymovement(LOCALID_KITHAIRON_MAENAD_1, MtKithairon_Movement_DanceA)
    applymovement(LOCALID_KITHAIRON_MAENAD_2, MtKithairon_Movement_DanceB)
    applymovement(LOCALID_KITHAIRON_MAENAD_3, MtKithairon_Movement_DanceC)
    applymovement(LOCALID_KITHAIRON_BOTRYKIT_1, MtKithairon_Movement_DanceB)
    applymovement(LOCALID_KITHAIRON_BOTRYKIT_2, MtKithairon_Movement_DanceA)
    waitmovement(0)
    playse(SE_M_BELLY_DRUM)
    delay(8)
}

movement MtKithairon_Movement_DanceA {
    face_up
    jump_in_place_up
    face_right
    jump_in_place_right
    face_down
    jump_in_place_down
    face_left
    jump_in_place_left
}

movement MtKithairon_Movement_DanceB {
    face_left
    jump_in_place_left
    face_up
    jump_in_place_up
    face_right
    jump_in_place_right
    face_down
    jump_in_place_down
}

movement MtKithairon_Movement_DanceC {
    face_down
    jump_in_place_down
    face_left
    jump_in_place_left
    face_up
    jump_in_place_up
    face_right
    jump_in_place_right
}

movement MtKithairon_Movement_ScatterWest {
    walk_fast_left * 8
}

movement MtKithairon_Movement_ScatterEast {
    walk_fast_right * 8
}

movement MtKithairon_Movement_ScatterNorth {
    walk_fast_up * 2
    walk_fast_left * 6
}

script MtKithairon_EventScript_Maenad {
    lock
    faceplayer
    setspeaker(MtKithairon_Text_SpeakerMaenad)
    msgbox(format("Euoi! Euoi! The god is coming down the mountain!"))
    release
}

script MtKithairon_EventScript_Botrykit {
    lock
    faceplayer
    playmoncry(SPECIES_BOTRYKIT, CRY_MODE_NORMAL)
    waitmoncry
    release
}

// --- beat 28: the shepherds' fold (the rest point) ----------------------------------------
script MtKithairon_EventScript_Phorbas {
    lock
    faceplayer
    setspeaker(MtKithairon_Text_SpeakerPhorbas)
    if (flag(FLAG_ICHOR_PHORBAS_STORY)) {
        msgbox(format("Sit a while. Milk's free. Prophecies, I don't do."))
        call(MtKithairon_EventScript_Heal)
        release
        end
    }
    msgbox(format("Sit. Kithairon's long. My fold's the halfway."))
    msgbox(format("Here. Milk, warm from the ewe. Your Pokémon too."))
    call(MtKithairon_EventScript_Heal)
    setspeaker(MtKithairon_Text_SpeakerPhorbas)
    msgbox(format("My grandfather's grandfather kept this fold. Summer pasture."))
    msgbox(format("The Thyrsa flocks came up this side. The Korinthos flocks, the other."))
    msgbox(format("Two shepherds, one spring. They got on."))
    msgbox(format("One summer the Thyrsa shepherd came up with a baby in his cloak."))
    msgbox(format("Feet pinned together. King's orders. Leave it on the mountain."))
    msgbox(format("There'd been a prophecy. The child would kill its father."))
    msgbox(format("He couldn't do it. So he gave the baby to the Korinthos shepherd."))
    msgbox(format("The boy grew up a prince over there. Then he heard the prophecy too."))
    msgbox(format("So he ran. As far from Korinthos as his legs would go."))
    msgbox(format("Met an old man at a crossroads, under Parnassos. They argued about the road."))
    message(format("You know the rest. Everyone does."))
    waitmessage
    dynmultichoice(20, 6, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, MtKithairon_Text_IDont, MtKithairon_Text_GoOn)
    setspeaker(MtKithairon_Text_SpeakerPhorbas)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("Then I won't spoil it. Ask at the split road, west of Thyrsa."))
        msgbox(format("They'll show you the stone."))
    } else {
        msgbox(format("He ran from his fate, and straight into it."))
        msgbox(format("Ran from the one place it couldn't happen, to the one place it could."))
        msgbox(format("My grandfather said that's what prophecies are for. Making people run."))
    }
    setflag(FLAG_ICHOR_PHORBAS_STORY)
    release
}

script MtKithairon_EventScript_Heal {
    closemessage
    fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    fadescreen(FADE_FROM_BLACK)
}

script MtKithairon_EventScript_Sheep {
    lock
    faceplayer
    playmoncry(SPECIES_WOOLOO, CRY_MODE_NORMAL)
    msgbox(format("Baa."))
    waitmoncry
    release
}

// --- trainers -----------------------------------------------------------------------------------
script MtKithairon_EventScript_Lykidas {
    trainerbattle_single(TRAINER_ICHOR_LYKIDAS, MtKithairon_Text_LykidasIntro, MtKithairon_Text_LykidasDefeat)
    setspeaker(MtKithairon_Text_SpeakerLykidas)
    msgbox(format("Kithairon eats people, they say. It's never eaten me. I taste of goat."), MSGBOX_AUTOCLOSE)
}

text MtKithairon_Text_LykidasIntro {
    format("My goats climbed this mountain before your grandmother did. So did I. Battle!")
}

text MtKithairon_Text_LykidasDefeat {
    format("Beaten by a lowlander! Don't tell the goats.")
}

script MtKithairon_EventScript_Euia {
    trainerbattle_single(TRAINER_ICHOR_EUIA, MtKithairon_Text_EuiaIntro, MtKithairon_Text_EuiaDefeat)
    setspeaker(MtKithairon_Text_SpeakerEuia)
    msgbox(format("The god's coming down the mountain tonight.\pWe're going to meet him. Barefoot."), MSGBOX_AUTOCLOSE)
}

text MtKithairon_Text_EuiaIntro {
    format("Euoi! You're in our circle! Dance or fight!")
}

text MtKithairon_Text_EuiaDefeat {
    format("Euoi… oi.")
}

script MtKithairon_EventScript_Bromia {
    trainerbattle_single(TRAINER_ICHOR_BROMIA, MtKithairon_Text_BromiaIntro, MtKithairon_Text_BromiaDefeat)
    setspeaker(MtKithairon_Text_SpeakerBromia)
    msgbox(format("My mother was a maenad. Her mother too. All the way back to Kadmos's daughters."), MSGBOX_AUTOCLOSE)
}

text MtKithairon_Text_BromiaIntro {
    format("Bromios! The roaring one! That's the god. I'm Bromia. Roar!")
}

text MtKithairon_Text_BromiaDefeat {
    format("…roar.")
}

script MtKithairon_EventScript_Arimnestos {
    trainerbattle_single(TRAINER_ICHOR_ARIMNESTOS, MtKithairon_Text_ArimnestosIntro, MtKithairon_Text_ArimnestosDefeat)
    setspeaker(MtKithairon_Text_SpeakerArimnestos)
    msgbox(format("Grandfather fought the Persians here. Father fought Thyrsa.\pI fought you. Progress."), MSGBOX_AUTOCLOSE)
}

text MtKithairon_Text_ArimnestosIntro {
    format("This boundary's been argued over for four hundred years. Argue with me.")
}

text MtKithairon_Text_ArimnestosDefeat {
    format("Fine. It's Eleutherai's. For today.")
}

script MtKithairon_EventScript_Ilys {
    trainerbattle_single(TRAINER_ICHOR_GRUNT_ILYS, MtKithairon_Text_IlysIntro, MtKithairon_Text_IlysDefeat)
    setspeaker(MtKithairon_Text_SpeakerIlys)
    msgbox(format("They said scratch the god's cup. So I scratched it. It didn't feel cool."), MSGBOX_AUTOCLOSE)
}

text MtKithairon_Text_IlysIntro {
    format("My friends joined up. The helmets are cool. …Is that not a reason?")
}

text MtKithairon_Text_IlysDefeat {
    format("The helmet's too big anyway. It keeps falling over my eyes.")
}

// --- the ivy shrine, desecrated (desecrated altar 8) ---------------------------
// Ilys guards it. Once he is beaten, the engine's desecrated-altar rite takes
// over: the first prayer cleanses it (+3 Dionysus Favor, FLAG_ICHOR_ALTARS_START
// + 8), and after that it is Dionysus's ordinary altar.
script MtKithairon_EventScript_Shrine {
    lockall
    if (!flag(FLAG_ICHOR_ALTARS_START + 8)) {
        msgbox(format("A little rock shrine of Dionysus, carved with ivy. A stone cup sits in the niche.\pSomeone has scratched a sickle across the cup."))
    }
    if (!defeated(TRAINER_ICHOR_GRUNT_ILYS)) {
        releaseall
        end
    }
    setvar(VAR_0x8004, ICHOR_GOD_DIONYSUS)
    setvar(VAR_0x8005, 8)
    goto(EventScript_IchorDesecratedAltar)
}

// --- the drum on the ledge path (the Girdle) -----------------------------------
// A column drum (EventScript_StrengthBoulder). Once it has been pushed off the
// path and the player stands where it lay, it stays moved.
script MtKithairon_EventScript_DrumMoved {
    setflag(FLAG_ICHOR_HIDE_KITHAIRON_DRUM)
}

// --- landmarks ----------------------------------------------------------------------------------
script MtKithairon_EventScript_PentheusFir {
    msgbox(format("An enormous fir. One great branch is torn away, high up.\pThey say King Pentheus climbed it to spy on the maenads.\pThe maenads saw him. That's the end of that story."), MSGBOX_SIGN)
}

script MtKithairon_EventScript_Spring {
    msgbox(format("A clear pool under the firs. A rock beside it, worn smooth, like a seat."), MSGBOX_SIGN)
}

script MtKithairon_EventScript_SpringSeat {
    msgbox(format("Scratched in the rock: TURN YOUR EYES AWAY. SHE BATHES HERE."), MSGBOX_SIGN)
}

script MtKithairon_EventScript_Arrow {
    msgbox(format("An arrow with silver fletching, driven deep into the bark.\pSilver is the Huntress's. Somebody was hunting here, from a long way south."), MSGBOX_SIGN)
}

script MtKithairon_EventScript_BoundaryStone {
    msgbox(format("A worn boundary stone. One side says THYRSA. The other side says THYRSA.\pSomeone has scratched out one of them and written ELEUTHERAI. Twice.\pNorth: down to Thyrsa. East: the spring. South: Eleutherai."), MSGBOX_SIGN)
}

// The marked ivy of the Thyrsus walls (Dionysus's gift II, a late-game return).
script MtKithairon_EventScript_MarkedIvy {
    msgbox(format("Ivy climbs the rock here, its leaves marked with gold.\pHigh above, on a ledge, something glints."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: a daily dig spot on the high meadow. Its index comes from the
// ichor-engine session; then this becomes:
//   setvar(VAR_0x8004, <spot>)  setvar(VAR_0x8005, ICHOR_DIG_ACT_II)
//   goto(EventScript_IchorDigSpot)
script MtKithairon_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: the fixed find by Aktaion's spring, the Silver Owl (SCRIPT.md
// Part 2). It needs a fixed-dig index (FLAG_ICHOR_DIG_FIXED_START + 0x14 is
// proposed) and the Silver Owl item; then this becomes:
//   setvar(VAR_0x8004, 0x14)  setvar(VAR_0x8005, ITEM_SILVER_OWL)
//   goto(EventScript_IchorDigFixed)
script MtKithairon_EventScript_SpringDig {
    msgbox(format("The earth by the spring has been turned. Something might be buried."), MSGBOX_SIGN)
}

script MtKithairon_EventScript_SignSouth {
    msgbox(format("MT. KITHAIRON · THE MAENADS' PASS\pSouth: Eleutherai. North: over the pass, down to Thyrsa."), MSGBOX_SIGN)
}

script MtKithairon_EventScript_SignFold {
    msgbox(format("PHORBAS'S FOLD. Milk for the tired. Mind the dogs. There are no dogs."), MSGBOX_SIGN)
}

script MtKithairon_EventScript_SignNorth {
    msgbox(format("Below: Route 7, the Asopos plain, and Thyrsa beyond the feast."), MSGBOX_SIGN)
}
