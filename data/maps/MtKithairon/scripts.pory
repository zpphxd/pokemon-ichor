mapscripts MtKithairon_MapScripts {}

script MtKithairon_EventScript_AKTAIOS {
    trainerbattle_single(TRAINER_ICHOR_AKTAIOS, format("At the pass, even a whisper carries."), format("So does a defeat."))
    msgbox(format("So does a defeat."), MSGBOX_AUTOCLOSE)
    end
}

script MtKithairon_EventScript_NYSA {
    trainerbattle_single(TRAINER_ICHOR_NYSA, format("Don't pick the ivy. It picks back."), format("You've met it before."))
    msgbox(format("You've met it before."), MSGBOX_AUTOCLOSE)
    end
}

script MtKithairon_EventScript_BROMIOS {
    trainerbattle_single(TRAINER_ICHOR_BROMIOS, format("The mountain answers a shout."), format("It answered yours."))
    msgbox(format("It answered yours."), MSGBOX_AUTOCLOSE)
    end
}

script MtKithairon_EventScript_CHARINOS {
    trainerbattle_single(TRAINER_ICHOR_CHARINOS, format("The god came here dressed as a stranger."), format("I'd have offered him a seat."))
    msgbox(format("I'd have offered him a seat."), MSGBOX_AUTOCLOSE)
    end
}

script MtKithairon_EventScript_KLEITO {
    trainerbattle_single(TRAINER_ICHOR_KLEITO, format("Up here the wine needs no water."), format("I need some, though."))
    msgbox(format("I need some, though."), MSGBOX_AUTOCLOSE)
    end
}

script MtKithairon_EventScript_EUPHRON {
    trainerbattle_single(TRAINER_ICHOR_EUPHRON, format("Thyrsa's just beyond the next ridge."), format("A ridge and a battle."))
    msgbox(format("A ridge and a battle."), MSGBOX_AUTOCLOSE)
    end
}

script MtKithairon_EventScript_SouthSign {
    msgbox(format("South: Eleutherai road.\nNorth: Kronia grounds."), MSGBOX_SIGN)
    end
}

script MtKithairon_EventScript_NorthSign {
    msgbox(format("South: Eleutherai road.\nNorth: Kronia grounds."), MSGBOX_SIGN)
    end
}

script MtKithairon_EventScript_Spring {
    lock
    faceplayer
    msgbox(format("Water first. The god can wait."))
    special(HealPlayerParty)
    release
}
