script LabyrinthRing7_EventScript_Hole2 {
    lockall
    msgbox(format("The floor is only a crust of flowstone over a hole. It gives!"), MSGBOX_DEFAULT)
    closemessage
    playse(SE_FALL)
    warp(MAP_LABYRINTH_RING7, 9)
    waitstate
    releaseall
}

script LabyrinthRing7_EventScript_Remains1 {
    msgbox(format("A girl's sandal, very small, and a string of clay beads.\pFourteen came down each year, the old songs say. This one danced."), MSGBOX_SIGN)
}

script LabyrinthRing7_EventScript_Remains2 {
    msgbox(format("A name half-cut in the rock: THESE-. The rest is a gouge, as if the cutter was pulled away."), MSGBOX_SIGN)
}

script LabyrinthRing7_EventScript_Remains3 {
    msgbox(format("A Titan's lantern and a scrawl: The priestess's floor won't light.\pKronos says leave it. The stars do the work below."), MSGBOX_SIGN)
}
