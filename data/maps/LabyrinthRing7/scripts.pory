script LabyrinthRing7_EventScript_Step {
    lockall
    switch (var(VAR_TEMP_1)) {
        case 0:
            if (var(VAR_0x8008) != 24) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 1:
            if (var(VAR_0x8008) != 19) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 2:
            if (var(VAR_0x8008) != 14) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 3:
            if (var(VAR_0x8008) != 9) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 4:
            if (var(VAR_0x8008) != 8) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 5:
            if (var(VAR_0x8008) != 7) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 6:
            if (var(VAR_0x8008) != 6) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 7:
            if (var(VAR_0x8008) != 11) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
        case 8:
            if (var(VAR_0x8008) != 12) {
                goto(LabyrinthRing7_EventScript_Wrong)
            }
    }
    switch (var(VAR_0x8008)) {
        case 0:
            setmetatile(14, 16, METATILE_Astra_DanceSLit, FALSE)
            playse(SE_NOTE_A)
        case 1:
            setmetatile(15, 16, METATILE_Astra_DanceXLit, FALSE)
            playse(SE_NOTE_D)
        case 2:
            setmetatile(16, 16, METATILE_Astra_DanceWLit, FALSE)
            playse(SE_NOTE_E)
        case 3:
            setmetatile(17, 16, METATILE_Astra_DanceRLit, FALSE)
            playse(SE_NOTE_G)
        case 4:
            setmetatile(18, 16, METATILE_Astra_DanceLLit, FALSE)
            playse(SE_NOTE_F)
        case 5:
            setmetatile(14, 17, METATILE_Astra_DanceLLit, FALSE)
            playse(SE_NOTE_F)
        case 6:
            setmetatile(15, 17, METATILE_Astra_DanceRLit, FALSE)
            playse(SE_NOTE_G)
        case 7:
            setmetatile(16, 17, METATILE_Astra_DanceLLit, FALSE)
            playse(SE_NOTE_F)
        case 8:
            setmetatile(17, 17, METATILE_Astra_DanceWLit, FALSE)
            playse(SE_NOTE_E)
        case 9:
            setmetatile(18, 17, METATILE_Astra_DanceRLit, FALSE)
            playse(SE_NOTE_G)
        case 10:
            setmetatile(14, 18, METATILE_Astra_DanceRLit, FALSE)
            playse(SE_NOTE_G)
        case 11:
            setmetatile(15, 18, METATILE_Astra_DanceWLit, FALSE)
            playse(SE_NOTE_E)
        case 12:
            setmetatile(16, 18, METATILE_Astra_DanceSLit, FALSE)
            playse(SE_NOTE_A)
        case 13:
