            playse(SE_NOTE_E)
        case 21:
            setmetatile(15, 20, METATILE_Astra_DanceXLit, FALSE)
            playse(SE_NOTE_D)
        case 22:
            setmetatile(16, 20, METATILE_Astra_DanceWLit, FALSE)
            playse(SE_NOTE_E)
        case 23:
            setmetatile(17, 20, METATILE_Astra_DanceLLit, FALSE)
            playse(SE_NOTE_F)
        case 24:
            setmetatile(18, 20, METATILE_Astra_DanceXLit, FALSE)
            playse(SE_NOTE_D)
    }
    special(DrawWholeMapView)
    addvar(VAR_TEMP_1, 1)
    if (var(VAR_TEMP_1) == 9) {
        goto(LabyrinthRing7_EventScript_Danced)
    }
    releaseall
}

