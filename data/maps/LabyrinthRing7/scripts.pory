// Ring VII, the Choros (design/LABYRINTH.md §5.7, §6 Ring VII, Scene I; LABYRINTH_MAZE.md;
// design/phase4/SCRIPT.md beat III-3L; design/maps/LabyrinthRing7.md).
// Layout and events: tools/ichor/maps/labyrinth_heart.py (32 x 32, astra, starlit).
//
// Homer's dancing floor, the one Daedalus made for Ariadne, lies under a natural dome
// whose rock is set with crystal stars. Round the dome the cave is a braided maze.
// A shaft in the dome's roof drops one beam (sunlight by day, starlight by night) on
// the first of three bronze mirrors; turned right (down, right, up), they carry it to
// a crystal at the floor's edge, and the floor's blank squares show their signs. The
// crane dance (X W L R W L R W S, from E5 spiralling in to C3) opens the stair down.
// The teaching mirror sits alone in the north-east antechamber, one beam, one disc.
//
// Warps: 0-1 up to Ring VI, 2 the stair the dance opens (C3), down to the Starry Chamber.

mapscripts LabyrinthRing7_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // the dance's squares are live only while the floor is lit and not yet danced
        setvar(VAR_TEMP_3, 1)
        if (flag(FLAG_ICHOR_RING7_BEAM_DONE) && !flag(FLAG_ICHOR_DANCE_DONE)) {
            setvar(VAR_TEMP_3, 0)
        }
        setvar(VAR_TEMP_1, 0)
        setvar(VAR_TEMP_2, 0)
        if (flag(FLAG_ICHOR_ARIADNE_JOINED)) {
            setflag(FLAG_ICHOR_HIDE_GIGAS_RING7)
        }
        if (flag(FLAG_ICHOR_ARIADNE_JOINED) && !flag(FLAG_ICHOR_DANCE_DONE)) {
            clearflag(FLAG_ICHOR_HIDE_ARIADNE_RING7)
        } else {
            setflag(FLAG_ICHOR_HIDE_ARIADNE_RING7)
        }
        // the mirrors keep the facings that solved the beam
        if (flag(FLAG_ICHOR_RING7_BEAM_DONE)) {
            setobjectmovementtype(LOCALID_RING7_M1, MOVEMENT_TYPE_ICHOR_MIRROR)
            setobjectmovementtype(LOCALID_RING7_M2, MOVEMENT_TYPE_ICHOR_MIRROR_RIGHT)
            setobjectmovementtype(LOCALID_RING7_M3, MOVEMENT_TYPE_ICHOR_MIRROR_UP)
        }
        if (flag(FLAG_ICHOR_RING7_DISC)) {
            setobjectmovementtype(LOCALID_RING7_TEACH, MOVEMENT_TYPE_ICHOR_MIRROR_UP)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        // ---- BEGIN GENERATED by tools/ichor/maps/labyrinth_heart.py: do not edit ----
    setvar(VAR_0x8004, 0x240)
    setvar(VAR_0x8005, 0x241)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x24B)
    setvar(VAR_0x8005, 0x24C)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x268)
    setvar(VAR_0x8005, 0x269)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 0x258)
    setvar(VAR_0x8005, 0x259)
    special(Ichor_AddThreadFloor)
    setvar(VAR_0x8004, 15)
    setvar(VAR_0x8005, 3)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING7_STAIR)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 16)
    setvar(VAR_0x8005, 12)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING7_DOME)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 7)
    setvar(VAR_0x8005, 13)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING7_MIRRORS)
    special(Ichor_AddThreadAnchor)
    setvar(VAR_0x8004, 11)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, THREAD_ANCHOR_RING7_DEEP)
    special(Ichor_AddThreadAnchor)
    call(LabyrinthRing7_EventScript_OnLoadExtra)
    // ---- END GENERATED ----
    }
}

text LabyrinthRing7_Text_NameAriadne { "ARIADNE" }
text LabyrinthRing7_Text_NamePorphyrion { "PORPHYRION" }

script LabyrinthRing7_EventScript_OnLoadExtra {
    if (flag(FLAG_ICHOR_RING7_BEAM_DONE)) {
        call(LabyrinthRing7_EventScript_RevealFloor)
        call(LabyrinthRing7_EventScript_RevealFresco)
    }
    if (flag(FLAG_ICHOR_DANCE_DONE)) {
        call(LabyrinthRing7_EventScript_LightDance)
        setmetatile(16, 18, METATILE_Astra_DanceStair, FALSE)
    }
}

// ---------------------------------------------------------------------------
// Scene I: Ariadne joins (LABYRINTH §8 Scene I), and the double battle
// ---------------------------------------------------------------------------

script LabyrinthRing7_EventScript_SceneI {
    lockall
    playse(SE_M_STRENGTH)
    msgbox(format("A panel of the fresco slides aside."))
    clearflag(FLAG_ICHOR_HIDE_ARIADNE_RING7)
    addobject(LOCALID_RING7_ARIADNE)
    applymovement(LOCALID_RING7_ARIADNE, LabyrinthRing7_Movement_AriadneComes)
    waitmovement(0)
    setspeaker(LabyrinthRing7_Text_NameAriadne)
    msgbox(format("The servants' stair. My grandmother's. Don't tell the Titans."))
    msgbox(format("I followed your thread. You walk in circles when you think."))
    msgbox(format("I saw them. The goads. The fire. I saw."))
    msgbox(format("He was crying. Bulls don't cry. He was."))
    msgbox(format("Their master can mend whatever he likes. Not my brother. Not like that."))
    setspeaker(SP_NAME_NONE)
    applymovement(LOCALID_RING7_PORPHYRION, LabyrinthRing7_Movement_Notice)
    waitmovement(0)
    setspeaker(LabyrinthRing7_Text_NamePorphyrion)
    msgbox(format("Priestess. The master said you'd stay above."))
    setspeaker(LabyrinthRing7_Text_NameAriadne)
    msgbox(format("The master says a great many things. {PLAYER}, stand with me."))
    closemessage
    setspeaker(SP_NAME_NONE)
    // Enkelados waits here only if you passed his checkpoint without a fight (SCRIPT.md beat
    // III-3L); if you beat him in Ring IV, Klytios takes his place. LabyrinthRing7_EventScript_
    // EnkeladosFought is the one place that asks Ring IV (the Labyrinth I build) which it was.
    call(LabyrinthRing7_EventScript_EnkeladosFought)
    if (var(VAR_RESULT) == TRUE) {
        setmultitrainerbattle(TRAINER_ICHOR_PORPHYRION, LabyrinthRing7_Text_PorphyrionDefeat, TRAINER_ICHOR_KLYTIOS, LabyrinthRing7_Text_KlytiosDefeat, PARTNER_ICHOR_ARIADNE)
    } else {
        setmultitrainerbattle(TRAINER_ICHOR_PORPHYRION, LabyrinthRing7_Text_PorphyrionDefeat, TRAINER_ICHOR_ENKELADOS_CHOROS, LabyrinthRing7_Text_EnkeladosDefeat, PARTNER_ICHOR_ARIADNE)
    }
    removeobject(LOCALID_RING7_PORPHYRION)
    removeobject(LOCALID_RING7_GIGAS2)
    setflag(FLAG_ICHOR_HIDE_GIGAS_RING7)
    setflag(FLAG_ICHOR_ARIADNE_JOINED)
    if (var(VAR_ICHOR_KNOSSA) < 15) {
        setvar(VAR_ICHOR_KNOSSA, 15)
    }
    call(LabyrinthRing7_EventScript_AriadneAfter)
    releaseall
}

// TRUE when Enkelados was beaten at his Ring IV checkpoint. Until Ring IV lands, nobody
// has fought him there, so he always stands here.
script LabyrinthRing7_EventScript_EnkeladosFought {
    setvar(VAR_RESULT, FALSE)
}

script LabyrinthRing7_EventScript_AriadneAfter {
    setspeaker(LabyrinthRing7_Text_NameAriadne)
    msgbox(format("This is the Choros. Daedalus made it for me when I was little."))
    msgbox(format("There's a dance that opens it. It goes the way the house goes."))
    msgbox(format("I'm not doing it for you. My knees are older than they look."))
    msgbox(format("The walls have been showing you the steps all the way down."))
    if (!flag(FLAG_ICHOR_RING7_BEAM_DONE)) {
        msgbox(format("It won't show its signs in the dark, though. The mirrors want turning."))
    }
    setspeaker(SP_NAME_NONE)
}

script LabyrinthRing7_EventScript_Ariadne {
    lock
    faceplayer
    setspeaker(LabyrinthRing7_Text_NameAriadne)
    if (!flag(FLAG_ICHOR_RING7_BEAM_DONE)) {
        msgbox(format("Three mirrors. One beam. Daedalus liked a thing to be fiddly."))
    } else {
        msgbox(format("Axe, wave, lily. Then it goes round. Like the house."))
    }
    setspeaker(SP_NAME_NONE)
    release
}

text LabyrinthRing7_Text_PorphyrionDefeat { format("PORPHYRION: The master said a lot of things. You were right about that.") }
text LabyrinthRing7_Text_KlytiosDefeat { format("KLYTIOS: …Put it out. Please. I'll go.") }
text LabyrinthRing7_Text_EnkeladosDefeat { format("ENKELADOS: Buried again. Story of my life.") }

movement LabyrinthRing7_Movement_Notice {
    emote_exclamation_mark
}

movement LabyrinthRing7_Movement_AriadneComes {
    walk_down
    walk_right
    face_right
}

// ---------------------------------------------------------------------------
// The mirrors and the beam (E9, Ichor_TraceBeam)
// ---------------------------------------------------------------------------

// Turn a mirror a quarter clockwise (VAR_0x8008: its local id), then trace the beam.
script LabyrinthRing7_EventScript_TurnMirror {
    lockall
    if (flag(FLAG_ICHOR_RING7_BEAM_DONE)) {
        msgbox(format("A bronze mirror. The beam runs off it like water."))
        releaseall
        end
    }
    msgbox(format("A bronze mirror on a pivot. Turn it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    playse(SE_M_STRENGTH)
    call(LabyrinthRing7_EventScript_RotateMirror)
    call(LabyrinthRing7_EventScript_Trace)
    releaseall
}

script LabyrinthRing7_EventScript_RotateMirror {
    getobjectfacingdirection(VAR_0x8008, VAR_TEMP_4)
    switch (var(VAR_TEMP_4)) {
        case DIR_SOUTH:
            turnobject(VAR_0x8008, DIR_WEST)
            setobjectmovementtype(VAR_0x8008, MOVEMENT_TYPE_ICHOR_MIRROR_LEFT)
        case DIR_WEST:
            turnobject(VAR_0x8008, DIR_NORTH)
            setobjectmovementtype(VAR_0x8008, MOVEMENT_TYPE_ICHOR_MIRROR_UP)
        case DIR_NORTH:
            turnobject(VAR_0x8008, DIR_EAST)
            setobjectmovementtype(VAR_0x8008, MOVEMENT_TYPE_ICHOR_MIRROR_RIGHT)
        default:
            turnobject(VAR_0x8008, DIR_SOUTH)
            setobjectmovementtype(VAR_0x8008, MOVEMENT_TYPE_ICHOR_MIRROR)
    }
}

script LabyrinthRing7_EventScript_Trace {
    setvar(VAR_0x8004, LOCALID_RING7_M1)
    gettimeofday
    if (var(VAR_0x8000) == TIME_NIGHT) {
        setvar(VAR_0x8005, METATILE_Astra_BeamStarEW)
    } else {
        setvar(VAR_0x8005, METATILE_Astra_BeamSunEW)
    }
    special(Ichor_TraceBeam)
    if (var(VAR_RESULT) == LOCALID_RING7_CRYSTAL) {
        playse(SE_SUCCESS)
        msgbox(format("The beam strikes the crystal at the floor's edge.\pLight runs out across the dancing floor."))
        setflag(FLAG_ICHOR_RING7_BEAM_DONE)
        call(LabyrinthRing7_EventScript_RevealFloor)
        call(LabyrinthRing7_EventScript_RevealFresco)
        special(DrawWholeMapView)
        msgbox(format("Every square shows a sign now: axes, waves, lilies, rosettes, stars."))
        setvar(VAR_TEMP_3, 0)
    }
}

script LabyrinthRing7_EventScript_Mirror1 {
    setvar(VAR_0x8008, LOCALID_RING7_M1)
    goto(LabyrinthRing7_EventScript_TurnMirror)
}

script LabyrinthRing7_EventScript_Mirror2 {
    setvar(VAR_0x8008, LOCALID_RING7_M2)
    goto(LabyrinthRing7_EventScript_TurnMirror)
}

script LabyrinthRing7_EventScript_Mirror3 {
    setvar(VAR_0x8008, LOCALID_RING7_M3)
    goto(LabyrinthRing7_EventScript_TurnMirror)
}

script LabyrinthRing7_EventScript_Crystal {
    msgbox(format("A crystal on a bronze foot, waiting for light."), MSGBOX_SIGN)
}

// The teaching mirror: one beam, one disc
script LabyrinthRing7_EventScript_TeachMirror {
    lockall
    if (flag(FLAG_ICHOR_RING7_DISC)) {
        msgbox(format("The little mirror holds its beam on the disc."))
        releaseall
        end
    }
    msgbox(format("A small bronze mirror under a crack of light. Turn it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    playse(SE_M_STRENGTH)
    setvar(VAR_0x8008, LOCALID_RING7_TEACH)
    call(LabyrinthRing7_EventScript_RotateMirror)
    setvar(VAR_0x8004, LOCALID_RING7_TEACH)
    setvar(VAR_0x8005, METATILE_Astra_BeamSunEW)
    special(Ichor_TraceBeam)
    if (var(VAR_RESULT) == LOCALID_RING7_DISC) {
        playse(SE_SUCCESS)
        setflag(FLAG_ICHOR_RING7_DISC)
        msgbox(format("The beam finds the disc. It glows, and a stone drawer slides out of the wall."))
        giveitem(ITEM_STAR_PIECE)
    }
    releaseall
}

script LabyrinthRing7_EventScript_Disc {
    msgbox(format("A bronze disc set in a stone foot, polished like a plate."), MSGBOX_SIGN)
}

script LabyrinthRing7_EventScript_Fresco {
    if (flag(FLAG_ICHOR_RING7_BEAM_DONE)) {
        msgbox(format("The whole dance, nine dancers in a line, clear now in the light:\p"
                      "axe, wave, lily, rosette, wave, lily, rosette, wave, and the star."), MSGBOX_SIGN)
    } else {
        msgbox(format("A long fresco of dancers, too faded to read in this dark."), MSGBOX_SIGN)
    }
}

script LabyrinthRing7_EventScript_RevealFresco {
    // the faded bays become the clear frescoes of the dance's three thirds
    setvar(VAR_0x8004, 3)
    call(LabyrinthRing7_EventScript_Bays)
}

// ---------------------------------------------------------------------------
// The crane dance (LABYRINTH §5.7)
// ---------------------------------------------------------------------------

script LabyrinthRing7_EventScript_Wrong {
    playse(SE_FAILURE)
    call(LabyrinthRing7_EventScript_RevealFloor)
    special(DrawWholeMapView)
    setvar(VAR_TEMP_1, 0)
    addvar(VAR_TEMP_2, 1)
    if (var(VAR_TEMP_2) >= 3 && flag(FLAG_ICHOR_ARIADNE_JOINED)) {
        setspeaker(LabyrinthRing7_Text_NameAriadne)
        msgbox(format("…Fine. Watch my feet."))
        setspeaker(SP_NAME_NONE)
        msgbox(format("Ariadne steps onto the axe in the south-east corner, and dances.\p"
                      "Up the east side, along the second row, down, and in to the star.\p"
                      "You follow her feet, square for square."))
        call(LabyrinthRing7_EventScript_LightDance)
        special(DrawWholeMapView)
        goto(LabyrinthRing7_EventScript_Danced)
    }
    msgbox(format("A sour chord. The floor's light dims.\pStep off at the south edge and start again."))
    setvar(VAR_TEMP_3, 2)
    releaseall
}

script LabyrinthRing7_EventScript_Rearm {
    if (flag(FLAG_ICHOR_RING7_BEAM_DONE) && !flag(FLAG_ICHOR_DANCE_DONE)) {
        setvar(VAR_TEMP_3, 0)
    }
}

script LabyrinthRing7_EventScript_Danced {
    setvar(VAR_TEMP_3, 1)
    setflag(FLAG_ICHOR_DANCE_DONE)
    playse(SE_NOTE_A)
    waitse
    playse(SE_SUCCESS)
    delay(30)
    playse(SE_M_EARTHQUAKE)
    setmetatile(16, 18, METATILE_Astra_DanceStair, FALSE)
    special(DrawWholeMapView)
    msgbox(format("The star at the floor's heart sinks away, step by step.\pA stair spirals down into the dark."))
    setvar(VAR_0x8004, 7)    // Corona Borealis: Ariadne's crown, set in the sky
    specialvar(VAR_RESULT, Ichor_PlaceConstellation)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("Somewhere far above, a crown of stars takes its place in the sky."))
    }
    if (var(VAR_ICHOR_KNOSSA) < 16) {
        setvar(VAR_ICHOR_KNOSSA, 16)
    }
    if (flag(FLAG_ICHOR_ARIADNE_JOINED)) {
        setspeaker(LabyrinthRing7_Text_NameAriadne)
        msgbox(format("He's down there. Go first. I'll be on the stair. I can't watch it."))
        setspeaker(SP_NAME_NONE)
        applymovement(LOCALID_RING7_ARIADNE, Common_Movement_FaceDown)
        waitmovement(0)
        removeobject(LOCALID_RING7_ARIADNE)
        setflag(FLAG_ICHOR_HIDE_ARIADNE_RING7)
    }
    releaseall
}

