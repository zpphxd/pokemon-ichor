// Nyktimos's hall: Arkadia's xenia host (SCRIPT.md Part 2, Arkadia interiors; SYSTEMS.md
// §10). Room: tools/ichor/maps/arkrooms.py. Nyktimos (5,3) by his hearth heals the party
// every visit and offers a bed till a time you choose; after the Moon Laurel he gives Black
// Glasses, once. His mother (13,3) is at her loom. The long table's last place (9,5) is laid
// for a guest who has never come.
//
// ICHOR_STUB_XENIA_REST: resting moves the clock forward (SYSTEMS.md §10); until the
// engine's rest call exists the menu fades and the clock stays.
// ICHOR_STUB_KEY_ITEMS: the Split Coin's link 3 (a stretch) needs ITEM_HALF_COIN (Phase 2's
// key item) and the xenia chain's flag FLAG_ICHOR_SPLIT_COIN_3 in the engine's xenia range;
// its lines are in SCRIPT.md and wait for both.
// ICHOR_STUB_MUSIC: Arkadia's own cue.

mapscripts Arkadia_NyktimosHall_MapScripts {}

text Arkadia_NyktimosHall_Name_Nyktimos { "NYKTIMOS" }
text Arkadia_NyktimosHall_Name_Mother { "OLD WOMAN" }

script Arkadia_NyktimosHall_EventScript_Nyktimos {
    lock
    faceplayer
    setspeaker(Arkadia_NyktimosHall_Name_Nyktimos)
    msgbox(format("Sit. Eat first.\p"
                  "Then tell me who you are. Not before."))
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    if (flag(FLAG_BADGE05_GET) && !flag(FLAG_ICHOR_GOT_BLACK_GLASSES)) {
        setspeaker(Arkadia_NyktimosHall_Name_Nyktimos)
        msgbox(format("Kallisto's laurel! She was a girl in this hall, once. Ate everything.\p"
                      "Here. For hunters who work at night. They help you see what's there."))
        giveitem(ITEM_BLACK_GLASSES)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_GOT_BLACK_GLASSES)
        }
    } elif (!flag(FLAG_ICHOR_NYKTIMOS_STORY)) {
        setspeaker(Arkadia_NyktimosHall_Name_Nyktimos)
        msgbox(format("My family's been very careful hosts for a very long time.\p"
                      "My ancestor, Lykaon, once served a guest something he shouldn't have.\p"
                      "The guest was Zeus. The ancestor became a wolf. That's him on the wall.\p"
                      "So we lay one more place than we need. Every night. Just in case."))
        setflag(FLAG_ICHOR_NYKTIMOS_STORY)
    } else {
        setspeaker(Arkadia_NyktimosHall_Name_Nyktimos)
        msgbox(format("So we lay one more place than we need. Every night. Just in case."))
    }
    goto(Arkadia_NyktimosHall_EventScript_Rest)
}

// The rest menu (SYSTEMS.md §10): only the times still ahead today are offered.
script Arkadia_NyktimosHall_EventScript_Rest {
    gettime
    setspeaker(Arkadia_NyktimosHall_Name_Nyktimos)
    if (var(VAR_0x8000) >= 20) {
        msgbox(format("It's late. The loft's warm. Mind the ladder."))
        release
        end
    }
    message(format("Stay, if you like. Rest till you want to wake."))
    waitmessage
    if (var(VAR_0x8000) < 6) {
        dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE, Arkadia_NyktimosHall_Text_Dawn,
                       Arkadia_NyktimosHall_Text_Noon, Arkadia_NyktimosHall_Text_Dusk,
                       Arkadia_NyktimosHall_Text_Night, Arkadia_NyktimosHall_Text_NotNow)
        if (var(VAR_RESULT) >= 4) {
            goto(Arkadia_NyktimosHall_EventScript_NoRest)
        }
    } elif (var(VAR_0x8000) < 12) {
        dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE, Arkadia_NyktimosHall_Text_Noon,
                       Arkadia_NyktimosHall_Text_Dusk, Arkadia_NyktimosHall_Text_Night,
                       Arkadia_NyktimosHall_Text_NotNow)
        if (var(VAR_RESULT) >= 3) {
            goto(Arkadia_NyktimosHall_EventScript_NoRest)
        }
    } elif (var(VAR_0x8000) < 19) {
        dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE, Arkadia_NyktimosHall_Text_Dusk,
                       Arkadia_NyktimosHall_Text_Night, Arkadia_NyktimosHall_Text_NotNow)
        if (var(VAR_RESULT) >= 2) {
            goto(Arkadia_NyktimosHall_EventScript_NoRest)
        }
    } else {
        dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE, Arkadia_NyktimosHall_Text_Night,
                       Arkadia_NyktimosHall_Text_NotNow)
        if (var(VAR_RESULT) >= 1) {
            goto(Arkadia_NyktimosHall_EventScript_NoRest)
        }
    }
    closemessage
    fadescreen(FADE_TO_BLACK)
    // ICHOR_STUB_XENIA_REST: move the clock forward to the chosen hour here.
    delay(60)
    fadescreen(FADE_FROM_BLACK)
    setspeaker(SP_NAME_NONE)
    msgbox(format("{PLAYER} slept in the loft. Below, the extra bowl stayed empty."))
    release
}

script Arkadia_NyktimosHall_EventScript_NoRest {
    setspeaker(Arkadia_NyktimosHall_Name_Nyktimos)
    msgbox(format("Then go well. There's always a place."))
    release
}

text Arkadia_NyktimosHall_Text_Dawn { "DAWN" }
text Arkadia_NyktimosHall_Text_Noon { "NOON" }
text Arkadia_NyktimosHall_Text_Dusk { "DUSK" }
text Arkadia_NyktimosHall_Text_Night { "NIGHT" }
text Arkadia_NyktimosHall_Text_NotNow { "NOT NOW" }

script Arkadia_NyktimosHall_EventScript_Mother {
    lock
    faceplayer
    setspeaker(Arkadia_NyktimosHall_Name_Mother)
    msgbox(format("I set the extra bowl. Every night for sixty years.\p"
                  "Nobody's ever sat there. Not once.\p"
                  "I'd still rather set it. You never know who's at the door."))
    release
}

script Arkadia_NyktimosHall_EventScript_EmptyPlace {
    msgbox(format("A clean bowl and a cup, set out at an empty place. Waiting."), MSGBOX_SIGN)
}

script Arkadia_NyktimosHall_EventScript_Pelt {
    msgbox(format("A great grey wolf pelt hangs over the hearth. Nobody sits under it."), MSGBOX_SIGN)
}

script Arkadia_NyktimosHall_EventScript_Ladder {
    msgbox(format("A ladder up to the sleeping loft. It's warm up there, from the hearth."), MSGBOX_SIGN)
}
