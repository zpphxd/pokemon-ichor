script LakoniaOrthia_EventScript_AltarBare {
    setmetatile(5, 3, 0x26A, TRUE)
    setmetatile(7, 3, 0x25E, TRUE)
    setmetatile(9, 3, 0x26B, TRUE)
    return
}

