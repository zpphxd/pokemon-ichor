// The Temple of Artemis at Arkadia: the Hunt for the Hind, Phylonoe, the three huntresses and
// Hierophant Kallisto (design/phase3/SCRIPT.md beat 44 and Part 5).
//
// The garden is designed in tools/ichor/maps/temple_artemis.py, which writes map.json's events
// and the garden scripts below (between the markers). Three walled gardens climb north from the
// porch, each entered by a hunters' arch; at the top, a stair climbs Kallisto's rock. Seven
// temple hounds patrol the gardens (objects with trainer sight and this map's Hound script, so
// the engine's own trainer approach is their "seen": src/trainer_see.c). A hound that sees the
// player walks them back to the current stage's arch; nothing else is lost.
//
// The hunt's state:
//   VAR_ICHOR_HUNT   tens: 0 not yet welcomed, 10 Stage I, 20 Stage II (SCRIPT.md's
//                    FLAG_ICHOR_HUNT_STAGE_1), 30 Stage III with the hind in clearing A
//                    (FLAG_ICHOR_HUNT_STAGE_2), 40 the hind in B (FLAG_ICHOR_HIND_TOUCH_1), 50 in C
//                    (FLAG_ICHOR_HIND_TOUCH_2), 60 the third touch (FLAG_ICHOR_HUNT_DONE: Sagitta,
//                    the stair's hedge down), 70 the Moon Laurel given.
//                    units: the times a hound has walked the player back in this stage, 0-3, for
//                    Phylonoe's direct hint (SCRIPT.md's VAR_TEMP_1, which a same-map warp would
//                    clear); it counts again from nothing when the player comes in by the door.
//   Anthia's shortcut (SCRIPT.md's FLAG_ICHOR_ANTHIA_GATE) is her trainer flag.
//   The hounds: the seven awake ones hide at FLAG_BADGE05_GET; the seven asleep in their places
//   show then (FLAG_ICHOR_HIDE_TEMPLE_HOUNDS_ASLEEP, set here until the laurel).
//   VAR_TEMP_5, _6, _4: the second arch's, the third arch's and the rock's triggers live (0).
//   (Never VAR_TEMP_2 and _3 together: main's carried-flame code reads that pair as a torch.)
//
// ICHOR_STUB_MUSIC: map.json plays MUS_ICHOR_TEMPLE until MUS_ICHOR_HUNT (SCRIPT.md Part 9, cue
// 20) exists; the hound's bay is a Lykopup's cry until the sound effect is made.

mapscripts Arkadia_TempleOfArtemis_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_ICHOR_HUNT) < 20) {
            setvar(VAR_TEMP_5, 0)
        } else {
            setvar(VAR_TEMP_5, 1)
        }
        if (var(VAR_ICHOR_HUNT) < 30) {
            setvar(VAR_TEMP_6, 0)
        } else {
            setvar(VAR_TEMP_6, 1)
        }
        if (flag(FLAG_BADGE05_GET)) {
            setvar(VAR_TEMP_4, 1)
            clearflag(FLAG_ICHOR_HIDE_TEMPLE_HOUNDS_ASLEEP)
        } else {
            setvar(VAR_TEMP_4, 0)
            setflag(FLAG_ICHOR_HIDE_TEMPLE_HOUNDS_ASLEEP)
        }
        call(Arkadia_TempleOfArtemis_EventScript_PlaceHind)
    }
    MAP_SCRIPT_ON_LOAD {
        call(Arkadia_TempleOfArtemis_EventScript_DrawGarden)
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_0, 0: Arkadia_TempleOfArtemis_EventScript_WarpIn
    ]
}

// In by the door, the returns count again; walked back by a hound, face into the garden.
// Kallisto sits on her rock facing the sky (her sprite's sitting pose is her up-facing one).
script Arkadia_TempleOfArtemis_EventScript_WarpIn {
    setvar(VAR_TEMP_0, 1)
    turnobject(LOCALID_ARTEMIS_KALLISTO, DIR_NORTH)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8005) == 49) {
        call(Arkadia_TempleOfArtemis_EventScript_ResetReturns)
    } else {
        turnobject(LOCALID_PLAYER, DIR_NORTH)
    }
    end
}

// --- Garden scripts: generated by tools/ichor/maps/temple_artemis.py from the plan. Do not edit. ---

// The garden from the hunt's state: the stair's hedge down from the hind's third
// touch, Anthia's gate open once she is beaten.
script Arkadia_TempleOfArtemis_EventScript_DrawGarden {
    if (var(VAR_ICHOR_HUNT) >= 60) {
        setmetatile(14, 8, METATILE_TempleArtemis_StairHedge_Lowered_L, FALSE)
        setmetatile(15, 8, METATILE_TempleArtemis_StairHedge_Lowered_R, FALSE)
    }
    if (defeated(TRAINER_ICHOR_ANTHIA)) {
        setmetatile(2, 27, METATILE_TempleArtemis_GateTop_Open, FALSE)
        setmetatile(2, 28, METATILE_TempleArtemis_Gate_Open, FALSE)
    }
    return
}

// The hind in the clearing she last ran to (A again once the hunt is over).
script Arkadia_TempleOfArtemis_EventScript_PlaceHind {
    if (var(VAR_ICHOR_HUNT) >= 50 && var(VAR_ICHOR_HUNT) < 60) {
        setobjectxyperm(LOCALID_ARTEMIS_HIND, 23, 12)
    } elif (var(VAR_ICHOR_HUNT) >= 40 && var(VAR_ICHOR_HUNT) < 60) {
        setobjectxyperm(LOCALID_ARTEMIS_HIND, 4, 11)
    }
    return
}

// A hound walked the player back: one more return in this stage (up to 3).
script Arkadia_TempleOfArtemis_EventScript_AddReturn {
    if (var(VAR_ICHOR_HUNT) >= 10 && var(VAR_ICHOR_HUNT) < 13) {
        addvar(VAR_ICHOR_HUNT, 1)
        return
    }
    if (var(VAR_ICHOR_HUNT) >= 20 && var(VAR_ICHOR_HUNT) < 23) {
        addvar(VAR_ICHOR_HUNT, 1)
        return
    }
    if (var(VAR_ICHOR_HUNT) >= 30 && var(VAR_ICHOR_HUNT) < 33) {
        addvar(VAR_ICHOR_HUNT, 1)
        return
    }
    if (var(VAR_ICHOR_HUNT) >= 40 && var(VAR_ICHOR_HUNT) < 43) {
        addvar(VAR_ICHOR_HUNT, 1)
        return
    }
    if (var(VAR_ICHOR_HUNT) >= 50 && var(VAR_ICHOR_HUNT) < 53) {
        addvar(VAR_ICHOR_HUNT, 1)
        return
    }
    if (var(VAR_ICHOR_HUNT) >= 60 && var(VAR_ICHOR_HUNT) < 63) {
        addvar(VAR_ICHOR_HUNT, 1)
        return
    }
    return
}

// In by the door: the returns count again from nothing (SCRIPT.md: VAR_TEMP_1's reset).
script Arkadia_TempleOfArtemis_EventScript_ResetReturns {
    if (var(VAR_ICHOR_HUNT) > 10 && var(VAR_ICHOR_HUNT) < 20) {
        setvar(VAR_ICHOR_HUNT, 10)
    }
    if (var(VAR_ICHOR_HUNT) > 20 && var(VAR_ICHOR_HUNT) < 30) {
        setvar(VAR_ICHOR_HUNT, 20)
    }
    if (var(VAR_ICHOR_HUNT) > 30 && var(VAR_ICHOR_HUNT) < 40) {
        setvar(VAR_ICHOR_HUNT, 30)
    }
    if (var(VAR_ICHOR_HUNT) > 40 && var(VAR_ICHOR_HUNT) < 50) {
        setvar(VAR_ICHOR_HUNT, 40)
    }
    if (var(VAR_ICHOR_HUNT) > 50 && var(VAR_ICHOR_HUNT) < 60) {
        setvar(VAR_ICHOR_HUNT, 50)
    }
    if (var(VAR_ICHOR_HUNT) > 60 && var(VAR_ICHOR_HUNT) < 70) {
        setvar(VAR_ICHOR_HUNT, 60)
    }
    return
}

// Back to the current stage's arch, facing in (the screen is already black).
script Arkadia_TempleOfArtemis_EventScript_ReturnToArch {
    if (var(VAR_ICHOR_HUNT) >= 30) {
        warpsilent(MAP_ARKADIA_TEMPLE_OF_ARTEMIS, 6, 21)
    } elif (var(VAR_ICHOR_HUNT) >= 20) {
        warpsilent(MAP_ARKADIA_TEMPLE_OF_ARTEMIS, 22, 34)
    } elif (var(VAR_ICHOR_HUNT) >= 10) {
        warpsilent(MAP_ARKADIA_TEMPLE_OF_ARTEMIS, 14, 43)
    } else {
        warpsilent(MAP_ARKADIA_TEMPLE_OF_ARTEMIS, 14, 43)
    }
    waitstate
    return
}

// The hind bolts from clearing A to clearing B.
movement Arkadia_TempleOfArtemis_Movement_HindToB {
    walk_faster_left
    walk_faster_left
    walk_faster_left
    walk_faster_left
    walk_faster_left
    walk_faster_left
    walk_faster_left
    walk_faster_up
    walk_faster_left
    walk_faster_left
    walk_faster_up
    walk_faster_up
    walk_faster_up
    walk_faster_up
    walk_faster_up
    walk_faster_right
    face_down
}

// The hind bolts from clearing B to clearing C.
movement Arkadia_TempleOfArtemis_Movement_HindToC {
    walk_faster_down
    walk_faster_down
    walk_faster_left
    walk_faster_down
    walk_faster_down
    walk_faster_down
    walk_faster_right
    walk_faster_down
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_right
    walk_faster_down
    walk_faster_right
    walk_faster_right
    walk_faster_up
    walk_faster_up
    walk_faster_up
    walk_faster_up
    walk_faster_up
    walk_faster_up
    walk_faster_right
    walk_faster_right
    face_down
}

// --- End of generated garden scripts. ---

// --- Phylonoe, the temple guide -----------------------------------------------------------

script Arkadia_TempleOfArtemis_EventScript_Welcome {
    lockall
    applymovement(LOCALID_ARTEMIS_PHYLONOE, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_ARTEMIS_PHYLONOE, Common_Movement_FaceLeft)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    call(Arkadia_TempleOfArtemis_EventScript_WelcomeLines)
    releaseall
    end
}

script Arkadia_TempleOfArtemis_EventScript_WelcomeLines {
    setspeaker(Arkadia_TempleOfArtemis_Text_NamePhylonoe)
    msgbox(format("Welcome to the goddess's garden. It's always night here. Always.\p"
                  "I'm a little bear. That's what she calls the girls who serve her.\p"
                  "I'm not a real bear. I'm nine. I'll be a real bear later.\p"
                  "The Huntress is at the far end, on her rock. You have to reach her.\p"
                  "Her hounds guard the garden. If one sees you, you start that part again.\p"
                  "Stay behind things. Walk when they look away. They always walk the same way.\p"
                  "If you get lost, come back and ask me. I watch everything. I'm very good."))
    closemessage
    setvar(VAR_ICHOR_HUNT, 10)
    return
}

script Arkadia_TempleOfArtemis_EventScript_Phylonoe {
    lock
    faceplayer
    if (var(VAR_ICHOR_HUNT) == 0) {
        call(Arkadia_TempleOfArtemis_EventScript_WelcomeLines)
        release
        end
    }
    setspeaker(Arkadia_TempleOfArtemis_Text_NamePhylonoe)
    if (flag(FLAG_BADGE05_GET)) {
        msgbox(format("You looked at her and she looked at you. I saw. I see everything.\p"
                      "The doe's in her clearing. You can stroke her now. She likes it."))
        release
        end
    }
    call(Arkadia_TempleOfArtemis_EventScript_PhylonoeHint)
    message(format("What do you want to know?"))
    waitmessage
    dynmultichoice(13, 3, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        Arkadia_TempleOfArtemis_Text_HowWorks, Arkadia_TempleOfArtemis_Text_WhereGoing,
        Arkadia_TempleOfArtemis_Text_Nothing)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("A hound sees straight ahead. Not round corners. Not through bushes.\p"
                          "In the dark it sees three steps. In the moonlight, six.\p"
                          "The ones that turn round hear you run. So don't. Walk.\p"
                          "If one sees you, it takes you back to the arch. It doesn't bite."))
        case 1:
            call(Arkadia_TempleOfArtemis_EventScript_PhylonoeWhere)
        default:
            msgbox(format("Okay. I'll be watching. I'm very good at watching."))
    }
    release
    end
}

script Arkadia_TempleOfArtemis_EventScript_PhylonoeWhere {
    if (var(VAR_ICHOR_HUNT) >= 60) {
        msgbox(format("The hedge on the stair is down! Go up. The Huntress is waiting."))
    } elif (var(VAR_ICHOR_HUNT) >= 30) {
        msgbox(format("The gold doe. Touch her, three times. She's shy."))
    } elif (var(VAR_ICHOR_HUNT) >= 20) {
        msgbox(format("Up through the moon gardens to the third arch. It's on the left."))
    } else {
        msgbox(format("Past the big bush to the next arch. Kyrene's there. She'll fight you."))
    }
    return
}

// After three returns in one stage, the direct hint (SCRIPT.md Part 5, the safety valve).
script Arkadia_TempleOfArtemis_EventScript_PhylonoeHint {
    if (var(VAR_ICHOR_HUNT) == 13) {
        msgbox(format("The white one walks to the end, then back. Wait by the big bush.\p"
                      "When it shows you its tail, go! …That's how I'd do it. I'm nine."))
    } elif (var(VAR_ICHOR_HUNT) == 23) {
        msgbox(format("That big one in the middle turns every four steps. Count with me.\p"
                      "One. Two. Three. Four. Go! …That's how I'd do it. I'm nine."))
    } elif (var(VAR_ICHOR_HUNT) == 33 || var(VAR_ICHOR_HUNT) == 43 || var(VAR_ICHOR_HUNT) == 53 || var(VAR_ICHOR_HUNT) == 63) {
        msgbox(format("Don't chase her. Watch the dogs first. Then walk.\p"
                      "The one in the moonlight turns every four steps, like the middle one."))
    }
    return
}

// --- The hounds ------------------------------------------------------------------------------
// A hound's sight is a trainer's: it sees the player along its facing (3 tiles in the shade, 6
// on moonlit ground), walls and bushes in the way, and the engine walks it to the player and
// runs this script. Talking to one is being seen by it.

script Arkadia_TempleOfArtemis_EventScript_Hound {
    if (flag(FLAG_BADGE05_GET)) {
        end
    }
    lockall
    // ICHOR_STUB_MUSIC: a hound's bay (SCRIPT.md Part 9's sound effects) is a Lykopup's cry.
    playmoncry(SPECIES_LYKOPUP, CRY_MODE_NORMAL)
    setspeaker(SP_NAME_NONE)
    msgbox(format("The hound bays! Somewhere in the dark, a huntress whistles."))
    waitmoncry
    msgbox(format("The hound trots you back to the arch, very pleased with itself."))
    closemessage
    call(Arkadia_TempleOfArtemis_EventScript_AddReturn)
    fadescreen(FADE_TO_BLACK)
    call(Arkadia_TempleOfArtemis_EventScript_ReturnToArch)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SleepingHound {
    msgbox(format("The hound is asleep. One ear twitches."), MSGBOX_SIGN)
    end
}

// --- The arches: each stage begins as the player passes through ---------------------------

script Arkadia_TempleOfArtemis_EventScript_ArchII {
    setvar(VAR_TEMP_5, 1)
    if (var(VAR_ICHOR_HUNT) < 20) {
        setvar(VAR_ICHOR_HUNT, 20)
    }
    end
}

script Arkadia_TempleOfArtemis_EventScript_ArchIII {
    setvar(VAR_TEMP_6, 1)
    if (var(VAR_ICHOR_HUNT) < 30) {
        setvar(VAR_ICHOR_HUNT, 30)
    }
    end
}

// --- The huntresses (Part 3). The hounds never see them. ----------------------------------

script Arkadia_TempleOfArtemis_EventScript_Kyrene {
    trainerbattle_single(TRAINER_ICHOR_KYRENE,
        format("You waited behind the bush. Good. Now you can't wait behind me."),
        format("Taught, then tested. You passed the first part. Mine was the test."))
    setspeaker(Arkadia_TempleOfArtemis_Text_NameKyrene)
    msgbox(format("The next garden has moonlight. A hound sees twice as far in the light."),
        MSGBOX_AUTOCLOSE)
    end
}

script Arkadia_TempleOfArtemis_EventScript_Anthia {
    trainerbattle_single(TRAINER_ICHOR_ANTHIA,
        format("Oh! You found my grove. Nobody finds my grove. Battle, then. Quietly."),
        format("Hush. The hounds. …Fine. Take the gate. It saves you a whole clearing."),
        Arkadia_TempleOfArtemis_EventScript_AnthiaGate)
    setspeaker(Arkadia_TempleOfArtemis_Text_NameAnthia)
    msgbox(format("The hind's next. She's gold. She never lets anyone touch her twice in one place."),
        MSGBOX_AUTOCLOSE)
    end
}

// Anthia's hedge gate swings open after her battle: a shortcut past the second clearing.
script Arkadia_TempleOfArtemis_EventScript_AnthiaGate {
    lockall
    playse(SE_DOOR)
    call(Arkadia_TempleOfArtemis_EventScript_DrawGarden)
    special(DrawWholeMapView)
    waitse
    setspeaker(SP_NAME_NONE)
    msgbox(format("Somewhere behind the bench, a gate in the hedge creaks open."))
    releaseall
    end
}

script Arkadia_TempleOfArtemis_EventScript_Prokris {
    trainerbattle_single(TRAINER_ICHOR_PROKRIS,
        format("Three times you touched her. Three times she ran. Now there's me."),
        format("Go up. She's been looking at the sky all night. Make her look at you."))
    setspeaker(Arkadia_TempleOfArtemis_Text_NameProkris)
    msgbox(format("My hound never misses. I've never seen it miss. Kallisto has."), MSGBOX_AUTOCLOSE)
    end
}

script Arkadia_TempleOfArtemis_EventScript_ItemPrettyFeather {
    finditem(ITEM_PRETTY_FEATHER)
}

// --- The golden hind ------------------------------------------------------------------------

script Arkadia_TempleOfArtemis_EventScript_Hind {
    lock
    setspeaker(SP_NAME_NONE)
    if (var(VAR_ICHOR_HUNT) >= 60) {
        msgbox(format("The golden hind lets you stroke her neck. She smells of cold grass."))
        release
        end
    }
    msgbox(format("A golden hind, grazing in the moonlight. Her antlers shine like coins.\p"
                  "You reach out and touch one."))
    if (var(VAR_ICHOR_HUNT) >= 50) {
        msgbox(format("The hind doesn't run. She lowers her head, and lets your hand rest on the gold.\p"
                      "Above the garden, a line of stars draws itself across the sky: an arrow."))
        // The Star Chart's Sagitta, constellation 5 (SYSTEMS.md §8: the Artemis trial).
        setflag(FLAG_ICHOR_CONSTELLATIONS_START + 4)
        playse(SE_SHINY)
        msgbox(format("The Star Chart shows a new shape: Sagitta, the Arrow."))
        waitse
        setflag(FLAG_ICHOR_HUNT_DONE)
        setvar(VAR_ICHOR_HUNT, 60)
        playse(SE_M_CUT)
        call(Arkadia_TempleOfArtemis_EventScript_DrawGarden)
        special(DrawWholeMapView)
        waitse
        msgbox(format("Across the stair to the rock, the laurel hedge sinks down to its roots."))
        release
        end
    }
    closemessage
    // her head comes up, and she bolts
    applymovement(LOCALID_ARTEMIS_HIND, Arkadia_TempleOfArtemis_Movement_HeadUp)
    waitmovement(0)
    playse(SE_M_DOUBLE_TEAM)
    if (var(VAR_ICHOR_HUNT) >= 40) {
        applymovement(LOCALID_ARTEMIS_HIND, Arkadia_TempleOfArtemis_Movement_HindToC)
        waitmovement(0)
        setvar(VAR_ICHOR_HUNT, 50)
    } else {
        applymovement(LOCALID_ARTEMIS_HIND, Arkadia_TempleOfArtemis_Movement_HindToB)
        waitmovement(0)
        setvar(VAR_ICHOR_HUNT, 40)
    }
    // where she stands now is where she reappears when she scrolls back into view
    copyobjectxytoperm(LOCALID_ARTEMIS_HIND)
    msgbox(format("She bolts, and is gone into the dark of the garden."))
    release
    end
}

// --- Kallisto on her rock -------------------------------------------------------------------

script Arkadia_TempleOfArtemis_EventScript_Rock {
    lockall
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 14) {
        applymovement(LOCALID_PLAYER, Arkadia_TempleOfArtemis_Movement_StepUnderRock)
        waitmovement(0)
    }
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    goto(Arkadia_TempleOfArtemis_EventScript_KallistoScene)
}

script Arkadia_TempleOfArtemis_EventScript_KallistoScene {
    setspeaker(Arkadia_TempleOfArtemis_Text_NameKallisto)
    msgbox(format("You came through my hounds and none of them saw you.\p"
                  "Most people leave a track. A smell. A shadow. You don't leave much.\p"
                  "…"))
    closemessage
    // She looks down at the player for the first time (her sprite holds the look).
    applymovement(LOCALID_ARTEMIS_KALLISTO, Arkadia_TempleOfArtemis_Movement_LookDown)
    waitmovement(0)
    delay(40)
    msgbox(format("I'm Kallisto. I hunt for the goddess. I'm good at it.\p"
                  "I was a girl who ran these hills, once. Now I'm the one who waits on the rock.\p"
                  "Come up, then. I'll look at you. I promise."))
    closemessage
    trainerbattle_no_intro(TRAINER_ICHOR_KALLISTO_1, format("…Clean. Like an arrow you never heard."))
    goto(Arkadia_TempleOfArtemis_EventScript_KallistoDefeated)
}

script Arkadia_TempleOfArtemis_EventScript_KallistoDefeated {
    setvar(VAR_TEMP_4, 1)
    // She climbs down off the rock.
    applymovement(LOCALID_ARTEMIS_KALLISTO, Arkadia_TempleOfArtemis_Movement_ClimbDown)
    waitmovement(0)
    setspeaker(Arkadia_TempleOfArtemis_Text_NameKallisto)
    msgbox(format("The Moon Laurel. Silver leaves. They look gray by day. Don't worry."))
    setflag(FLAG_BADGE05_GET)
    setvar(VAR_ICHOR_HUNT, 70)
    setvar(VAR_0x8004, ICHOR_GOD_ARTEMIS)
    setvar(VAR_0x8005, ICHOR_FAVOR_LAUREL)
    special(Ichor_AddFavor)
    setspeaker(SP_NAME_NONE)
    message(format("{PLAYER} received the Moon Laurel from Kallisto!"))
    waitmessage
    call(Common_EventScript_PlayGymBadgeFanfare)
    // The Star Chart's Ursa Major, constellation 3 (SYSTEMS.md §8: Laurel 5).
    setflag(FLAG_ICHOR_CONSTELLATIONS_START + 2)
    playse(SE_SHINY)
    msgbox(format("The Star Chart shows a new shape: Ursa Major, the Great Bear."))
    waitse
    setspeaker(Arkadia_TempleOfArtemis_Text_NameKallisto)
    msgbox(format("And this. It's how a hunter waits in the dark and still strikes first."))
    // ICHOR_STUB_TMS: giveitem(ITEM_TM_DARK_PULSE) once Balance gives Dark Pulse a TM number.
    setflag(FLAG_ICHOR_GOT_TM_DARK_PULSE)
    msgbox(format("Artemis takes the first of every hunt. The first feather from the first bird."))
    // Artemis's rite (SYSTEMS.md §3): the Hierophant's one loved offering, a Pretty Feather.
    setvar(VAR_0x8004, ICHOR_GOD_ARTEMIS)
    call(EventScript_IchorHierophantRite)
    setspeaker(Arkadia_TempleOfArtemis_Text_NameKallisto)
    msgbox(format("Leave her one at her altar, and she'll keep an eye on you at night."))
    setflag(FLAG_ICHOR_KALLISTO_RITE)
    closemessage
    // She looks past the player, toward the garden's gate and the Cypress Wood.
    applymovement(LOCALID_ARTEMIS_KALLISTO, Common_Movement_FaceLeft)
    waitmovement(0)
    msgbox(format("There was a boy here at sunset. Lakonian. Red cloak.\p"
                  "I fought the new moon, as I was told. I didn't see his face.\p"
                  "…"))
    closemessage
    applymovement(LOCALID_ARTEMIS_KALLISTO, Common_Movement_FaceDown)
    waitmovement(0)
    msgbox(format("Go on. The east road is open now. My huntresses will let you through."))
    closemessage
    // Back up on her rock, looking at the sky.
    turnobject(LOCALID_ARTEMIS_KALLISTO, DIR_NORTH)
    // Arkadia's cordon (FLAG_ICHOR_HIDE_ARKADIA_CORDON) clears with FLAG_BADGE05_GET; the
    // Skylaps and Kerdovix roamers start with it too (ICHOR_STUB_AETHOS_DEX, SCRIPT.md Part 4).
    setflag(FLAG_ICHOR_HUNT_DONE)
    releaseall
    end
}

// After the laurel she stays on her rock. (Never faceplayer: her sitting pose is facing up,
// and nurse_joy_bow is how she looks down.)
script Arkadia_TempleOfArtemis_EventScript_Kallisto {
    lock
    if (!flag(FLAG_BADGE05_GET)) {
        goto(Arkadia_TempleOfArtemis_EventScript_KallistoScene)
    }
    applymovement(LOCALID_ARTEMIS_KALLISTO, Arkadia_TempleOfArtemis_Movement_LookDown)
    waitmovement(0)
    setspeaker(Arkadia_TempleOfArtemis_Text_NameKallisto)
    msgbox(format("My reading said, show no mercy at the new moon. So I didn't.\p"
                  "A reading is a reading. You don't argue with Delphoi.\p"
                  "…Do you?"))
    // Prophecy tablet #5 (FLAG_ICHOR_PROPHECY_START + 4; read at + 12), once.
    if (flag(FLAG_ICHOR_PROPHECY_START + 4) && !flag(FLAG_ICHOR_KALLISTO_TABLET)) {
        setflag(FLAG_ICHOR_KALLISTO_TABLET)
        msgbox(format("Where did you get that? I buried that. At my own tomb. As a joke.\p"
                      "Lead doesn't lie. That's what they told me, when they brought it."))
        if (flag(FLAG_ICHOR_PROPHECY_START + 12)) {
            msgbox(format("Your friend, the one who digs, she read it? What's underneath?\p"
                          "…“Show mercy.”\p"
                          "Keep it. I don't want to look at it. Not yet."))
        } else {
            msgbox(format("Keep it. I don't want to look at it again."))
        }
    }
    // Gift I at Artemis Favor 30: the Hierophant teaches Night Slash, and Orion goes up.
    setvar(VAR_0x8004, ICHOR_GOD_ARTEMIS)
    call(EventScript_IchorHierophantGift)
    if (var(VAR_RESULT) == TRUE) {
        setspeaker(Arkadia_TempleOfArtemis_Text_NameKallisto)
        msgbox(format("She put a hunter in the sky for less. Look up tonight."))
        // The Star Chart's Orion, constellation 4 (SYSTEMS.md §8: Artemis Favor 30).
        setflag(FLAG_ICHOR_CONSTELLATIONS_START + 3)
        setspeaker(SP_NAME_NONE)
        playse(SE_SHINY)
        msgbox(format("The Star Chart shows a new shape: Orion, the Hunter."))
        waitse
    }
    closemessage
    // back to the sky (the engine's gift call turns her to the player after a lesson)
    turnobject(LOCALID_ARTEMIS_KALLISTO, DIR_NORTH)
    release
    end
}

// --- The porch and the garden's things ------------------------------------------------------

script Arkadia_TempleOfArtemis_EventScript_Altar {
    goto(EventScript_IchorTempleAltar_Artemis)
}

script Arkadia_TempleOfArtemis_EventScript_Statue {
    msgbox(format("Artemis, drawing an arrow from her quiver. A bronze hound looks up at her."),
        MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_Kennel {
    msgbox(format("A hound's kennel. It smells of dog and cold straw. Nobody's home."), MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_Pool {
    msgbox(format("A basin cut in the rock, full of still water. The moon lies in it, perfectly round."),
        MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SteleHound {
    msgbox(format("A hound carved in the stone, one ear up. Someone has rubbed its nose smooth for luck."),
        MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SteleBears {
    msgbox(format("Girls in bear masks, dancing in a ring. The goddess's little bears."), MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SteleAktaion {
    msgbox(format("Aktaion, who saw the goddess bathing. His own hounds didn't know him after."),
        MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SteleAtalanta {
    msgbox(format("A she-bear nursing a baby girl. Atalanta, left on these hills to die. She didn't."),
        MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SteleKeryneia {
    msgbox(format("A doe with golden antlers. Under her: KERYNEIA. Even Herakles took a year."),
        MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SteleWorn {
    msgbox(format("The stele the hound circles. Its name is worn away. Only a bow is left."),
        MSGBOX_SIGN)
    end
}

script Arkadia_TempleOfArtemis_EventScript_SteleOrion {
    msgbox(format("Orion, who swore he'd hunt every beast on earth. The earth sent a scorpion."),
        MSGBOX_SIGN)
    end
}

