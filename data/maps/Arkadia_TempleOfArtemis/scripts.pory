movement Arkadia_TempleOfArtemis_Movement_StepUnderRock {
    walk_right
}

movement Arkadia_TempleOfArtemis_Movement_ClimbDown {
    jump_in_place_down
    face_down
}

// Kallisto looks down from the sky (SPRITES.md: her sprite holds the look).
movement Arkadia_TempleOfArtemis_Movement_LookDown {
    nurse_joy_bow
}

// The golden hind throws her head up.
movement Arkadia_TempleOfArtemis_Movement_HeadUp {
    nurse_joy_bow
}
