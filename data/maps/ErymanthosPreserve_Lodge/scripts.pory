mapscripts ErymanthosPreserve_Lodge_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SAFARI_ZONE_STATE, 1: ErymanthosPreserve_Lodge_EventScript_Back
    ]
}

// Generated by tools/ichor/maps/erymanthos.py; edit the builder, not this file.

script ErymanthosPreserve_Lodge_EventScript_Drawing {
    msgbox(format("An old drawing of the mountain burned onto a board: the oaks, the meadow, the river, and up in one corner, a boar."), MSGBOX_SIGN)
    end
}

script ErymanthosPreserve_Lodge_EventScript_Sacks {
    msgbox(format("Sacks of barley for the hunt, and a basket of throwing stones."), MSGBOX_SIGN)
    end
}

script ErymanthosPreserve_Lodge_EventScript_Rake {
    msgbox(format("Hunting spears, and a net with a tear in it the shape of a tusk."), MSGBOX_SIGN)
    end
}

text ErymanthosPreserve_Lodge_EventScript_Name { "MELANIPPE" }

script ErymanthosPreserve_Lodge_EventScript_Keeper {
    lock
    faceplayer
    setspeaker(ErymanthosPreserve_Lodge_EventScript_Name)
    msgbox(format("This is the Erymanthian Preserve, Artemis's own hunting ground. I keep it for her.\p"
                  "For ¥500 you may hunt it. You take 30 Pan Balls and no Pokémon of your own: "
                  "the goddess's animals are caught, not beaten.\p"
                  "You have 500 steps before I ring you out."))
    showmoneybox(0, 0)
    msgbox(format("Will you hunt?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        hidemoneybox
        msgbox(format("Then go gently. She sees who comes and goes."))
        release
        end
    }
    getpartysize
    if (var(VAR_RESULT) == PARTY_SIZE) {
        specialvar(VAR_RESULT, ScriptCheckFreePokemonStorageSpace)
        if (var(VAR_RESULT) == FALSE) {
            hidemoneybox
            msgbox(format("Your party's full and so is your Pithos. Where would you put a catch? "
                          "Make room first."))
            release
            end
        }
    }
    checkmoney(500)
    if (var(VAR_RESULT) == FALSE) {
        hidemoneybox
        msgbox(format("That's not enough. The goddess doesn't haggle, and neither do I."))
        release
        end
    }
    removemoney(500)
    updatemoneybox
    playse(SE_SHOP)
    msgbox(format("Here: 30 Pan Balls. Pan made the first nets for her, they say.\p"
                  "Barley brings them close and slow. A stone makes them easier to take, and quicker to bolt.\p"
                  "When you want to come back, ring the bell at the gate."))
    hidemoneybox
    special(EnterSafariMode)
    setvar(VAR_SAFARI_ZONE_STATE, 2)
    closemessage
    warp(MAP_ERYMANTHOS_PRESERVE_OAKWOOD, 19, 30)
    waitstate
    release
}

script ErymanthosPreserve_Lodge_EventScript_Back {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    setspeaker(ErymanthosPreserve_Lodge_EventScript_Name)
    msgbox(format("Back in one piece. Whatever you caught, treat it well. It was hers first."))
    setvar(VAR_SAFARI_ZONE_STATE, 0)
    releaseall
}
