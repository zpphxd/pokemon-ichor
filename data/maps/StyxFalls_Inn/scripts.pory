// The Inn at the Falls, Nonakris (ported from claude/world-act2-0a92e7). Aroanios (13,3) by his
// cup shelf heals the party and offers the engine's xenia rest; Eubouleus (14,6), the swineherd,
// has walked here with Gryllos the Kaplet in a basket (15,6) and asks you to raise him.
// The branch's Alethea at the long table (beat 39) is left out: her visit waits on the branch's
// Oath Stone scene, which main's story doesn't have.
// ICHOR_STUB_GIFT_NAME: Gryllos should carry the nickname GRYLLOS and the OT EUBOULEUS.

mapscripts StyxFalls_Inn_MapScripts {}

text StyxFalls_Inn_Name_Aroanios { "AROANIOS" }
text StyxFalls_Inn_Name_Eubouleus { "EUBOULEUS" }
text StyxFalls_Inn_Name_Gryllos { "GRYLLOS" }

script StyxFalls_Inn_EventScript_Aroanios {
    lock
    faceplayer
    setspeaker(StyxFalls_Inn_Name_Aroanios)
    msgbox(format("Welcome to the last inn before the gods' own water. Don't drink from the pool.\p"
                  "Well. You can. You'd only do it once.\p"
                  "My family's kept this inn since before anyone swore by anything.\p"
                  "Demeter came through once, looking for her girl. We gave her a bed.\p"
                  "She gave us beans.\p"
                  "A bed, then? And bread. Not beans. Never beans."))
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    goto(StyxFalls_Inn_EventScript_Rest)
}

// ---------------------------------------------------------------------------
// Eubouleus and Gryllos
// ---------------------------------------------------------------------------

script StyxFalls_Inn_EventScript_Eubouleus {
    lock
    faceplayer
    setspeaker(StyxFalls_Inn_Name_Eubouleus)
    if (flag(FLAG_ICHOR_GOT_GRYLLOS)) {
        if (!flag(FLAG_ICHOR_GRYLLOS_SHOWN)) {
            checkspecies(SPECIES_KAPRODON)
            if (var(VAR_RESULT) == TRUE) {
                goto(StyxFalls_Inn_EventScript_GryllosShown)
            }
            msgbox(format("Bring him back to show me. When he's got his tusks. I'll cry."))
        } else {
            msgbox(format("A boar's a boar to me, I'll be honest. But that one looked at me like Gryllos."))
        }
        release
        end
    }
    msgbox(format("You! From Eleusa! You were at the Mysteries!\p"
                  "I walked here. All of it. My knees have stopped speaking to me.\p"
                  "This is Gryllos. He's a Kaplet. He won't grow up.\p"
                  "Pigs like him only grow up in Arkadia. Under the oaks. Everybody knows that.\p"
                  "I can't do the mountain. Not on these knees.\p"
                  "Would you take him? Let him grow up there. He deserves to be a boar."))
    setspeaker(SP_NAME_NONE)
    msgbox(format("Take Gryllos?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        setspeaker(StyxFalls_Inn_Name_Eubouleus)
        msgbox(format("No, it's a lot to ask. He's a lot of pig. I'll ask again tomorrow."))
        release
        end
    }
    // ICHOR_STUB_GIFT_NAME: nickname GRYLLOS, OT EUBOULEUS.
    givemon(SPECIES_KAPLET, 28, ITEM_ORAN_BERRY, move1=MOVE_TAKE_DOWN, move2=MOVE_STOMPING_TANTRUM,
            move3=MOVE_AMNESIA, move4=MOVE_REST)
    copyvar(VAR_0x8004, VAR_RESULT)
    if (var(VAR_0x8004) == MON_CANT_GIVE) {
        setspeaker(StyxFalls_Inn_Name_Eubouleus)
        msgbox(format("You've no room anywhere? Not even in a jar? Then he'll wait with me."))
        release
        end
    }
    setspeaker(StyxFalls_Inn_Name_Eubouleus)
    msgbox(format("Thank you. Thank you. He likes acorns. He likes everything."))
    removeobject(LOCALID_STYX_INN_GRYLLOS)
    setflag(FLAG_ICHOR_GOT_GRYLLOS)
    playfanfare(MUS_OBTAIN_ITEM)
    setspeaker(SP_NAME_NONE)
    message(format("{PLAYER} received Gryllos the Kaplet!"))
    waitfanfare
    waitmessage
    if (var(VAR_0x8004) == MON_GIVEN_TO_PC) {
        msgbox(format("Gryllos was set down in the Pithos."))
    }
    setspeaker(StyxFalls_Inn_Name_Eubouleus)
    msgbox(format("Bring him back to show me. When he's got his tusks. I'll cry."))
    release
}

script StyxFalls_Inn_EventScript_GryllosShown {
    setspeaker(StyxFalls_Inn_Name_Eubouleus)
    msgbox(format("Is that- Gryllos? Look at you! Look at those tusks!\p"
                  "I'm crying. I said I'd cry. Here. The best thing a pig ever found me."))
    giveitem(ITEM_BALM_MUSHROOM)
    setflag(FLAG_ICHOR_GRYLLOS_SHOWN)
    setspeaker(StyxFalls_Inn_Name_Eubouleus)
    msgbox(format("Under an oak in Eleusa. He sniffed it out as a piglet. Now look at him."))
    release
}

script StyxFalls_Inn_EventScript_Gryllos {
    lock
    faceplayer
    setspeaker(StyxFalls_Inn_Name_Gryllos)
    msgbox(format("Hnk."))
    setspeaker(SP_NAME_NONE)
    msgbox(format("A small round pig in a basket of straw. It's chewing the basket."))
    release
}


// ---------------------------------------------------------------------------
// The room
// ---------------------------------------------------------------------------

script StyxFalls_Inn_EventScript_Hoof {
    msgbox(format("A horse's hoof on a nail. The only thing in the house the black water couldn't eat."),
           MSGBOX_SIGN)
}

script StyxFalls_Inn_EventScript_Window {
    msgbox(format("Across the pool, the Styx falls and falls, and never seems to land."), MSGBOX_SIGN)
}

script StyxFalls_Inn_EventScript_Hearth {
    msgbox(format("A hearth cut into the cliff. The cauldron smells of beans. Then of bread, quickly."),
           MSGBOX_SIGN)
}

script StyxFalls_Inn_EventScript_Rock {
    msgbox(format("The back wall is the cliff itself, black and running wet. It's cold to the touch."),
           MSGBOX_SIGN)
}

script StyxFalls_Inn_EventScript_Rest {
    setspeaker(StyxFalls_Inn_Name_Aroanios)
    msgbox(format("Sleep till when?"))
    call(EventScript_IchorXeniaRest)
    if (var(VAR_RESULT) == TRUE) {
        setspeaker(SP_NAME_NONE)
        msgbox(format("{PLAYER} slept on a bench by the rock. Outside, the falls made no sound at all."))
    } else {
        setspeaker(StyxFalls_Inn_Name_Aroanios)
        msgbox(format("The bed'll keep. Beds do."))
    }
    release
}
