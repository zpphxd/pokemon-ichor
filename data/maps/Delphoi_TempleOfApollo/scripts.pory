            if (var(VAR_TEMP_4) >= 4) {
                setvar(VAR_TEMP_4, 0)
            }
            call(Delphoi_TempleOfApollo_EventScript_FaceM3B)
        case LOCALID_APOLLO_M4:
            addvar(VAR_TEMP_5, 1)
            if (var(VAR_TEMP_5) >= 4) {
                setvar(VAR_TEMP_5, 0)
            }
            call(Delphoi_TempleOfApollo_EventScript_FaceM4)
        case LOCALID_APOLLO_M5:
            addvar(VAR_TEMP_6, 1)
            if (var(VAR_TEMP_6) >= 4) {
                setvar(VAR_TEMP_6, 0)
            }
            call(Delphoi_TempleOfApollo_EventScript_FaceM5)
        case LOCALID_APOLLO_M6:
            addvar(VAR_TEMP_7, 1)
            if (var(VAR_TEMP_7) >= 4) {
                setvar(VAR_TEMP_7, 0)
            }
            call(Delphoi_TempleOfApollo_EventScript_FaceM6)
        case LOCALID_APOLLO_M7:
            addvar(VAR_TEMP_8, 1)
            if (var(VAR_TEMP_8) >= 4) {
                setvar(VAR_TEMP_8, 0)
            }
            call(Delphoi_TempleOfApollo_EventScript_FaceM7)
        case LOCALID_APOLLO_M8:
            addvar(VAR_TEMP_9, 1)
            if (var(VAR_TEMP_9) >= 4) {
                setvar(VAR_TEMP_9, 0)
            }
            call(Delphoi_TempleOfApollo_EventScript_FaceM8)
    }
    if (var(VAR_LAST_TALKED) == LOCALID_APOLLO_M1) {
        call(Delphoi_TempleOfApollo_EventScript_TracePronaos)
    } else {
        call(Delphoi_TempleOfApollo_EventScript_TraceCella)
    }
    return
}

script Delphoi_TempleOfApollo_EventScript_LightTiles {
    if (flag(FLAG_ICHOR_APOLLO_DISC_0)) {
        setmetatile(18, 43, METATILE_APOLLO_WALL_DISC_LIT, TRUE)
        setmetatile(9, 40, METATILE_APOLLO_GATE_OPEN, FALSE)
    }
    if (flag(FLAG_ICHOR_APOLLO_DISC_1)) {
        setmetatile(0, 37, METATILE_APOLLO_WALL_DISC_LIT, TRUE)
        setmetatile(9, 33, METATILE_APOLLO_GATE_OPEN, FALSE)
    }
    if (flag(FLAG_ICHOR_APOLLO_DISC_2)) {
        setmetatile(18, 30, METATILE_APOLLO_WALL_DISC_LIT, TRUE)
        setmetatile(5, 26, METATILE_APOLLO_GATE_OPEN, FALSE)
    }
    if (flag(FLAG_ICHOR_APOLLO_DISC_3)) {
        setmetatile(2, 26, METATILE_APOLLO_SCREEN_DISC_LIT, TRUE)
        setmetatile(2, 18, METATILE_APOLLO_GATE_OPEN, FALSE)
    }
    if (flag(FLAG_ICHOR_APOLLO_DISC_4)) {
        setmetatile(12, 11, METATILE_APOLLO_GATE_OPEN, FALSE)
    }
    if (flag(FLAG_ICHOR_APOLLO_BRAZIER)) {
        setmetatile(16, 8, METATILE_APOLLO_BRAZIER_LIT, TRUE)
    }
    if (flag(FLAG_ICHOR_PYTHIAN_LIGHT_DONE)) {
        setmetatile(7, 2, METATILE_APOLLO_TRIPOD_LIT_TL, TRUE)
        setmetatile(8, 2, METATILE_APOLLO_TRIPOD_LIT_TC, TRUE)
        setmetatile(9, 2, METATILE_APOLLO_TRIPOD_LIT_TR, TRUE)
        setmetatile(7, 3, METATILE_APOLLO_TRIPOD_LIT_BL, TRUE)
        setmetatile(8, 3, METATILE_APOLLO_TRIPOD_LIT_BC, TRUE)
        setmetatile(9, 3, METATILE_APOLLO_TRIPOD_LIT_BR, TRUE)
    }
    return
}

script Delphoi_TempleOfApollo_EventScript_CheckCella {
    switch (var(VAR_RESULT)) {
        case LOCALID_APOLLO_DISC_1:
            if (!flag(FLAG_ICHOR_APOLLO_DISC_1)) {
                setflag(FLAG_ICHOR_APOLLO_DISC_1)
                call(Delphoi_TempleOfApollo_EventScript_DiscBlazes)
            }
        case LOCALID_APOLLO_DISC_2:
            if (!flag(FLAG_ICHOR_APOLLO_DISC_2)) {
                setflag(FLAG_ICHOR_APOLLO_DISC_2)
                call(Delphoi_TempleOfApollo_EventScript_DiscBlazes)
            }
        case LOCALID_APOLLO_DISC_3:
            if (!flag(FLAG_ICHOR_APOLLO_DISC_3)) {
                setflag(FLAG_ICHOR_APOLLO_DISC_3)
                call(Delphoi_TempleOfApollo_EventScript_DiscBlazes)
            }
        case LOCALID_APOLLO_DISC_4:
            if (!flag(FLAG_ICHOR_APOLLO_DISC_4)) {
                setflag(FLAG_ICHOR_APOLLO_DISC_4)
                call(Delphoi_TempleOfApollo_EventScript_DiscBlazes)
                removeobject(LOCALID_APOLLO_DISC_4)
            }
        case LOCALID_APOLLO_BRAZIER:
            if (!flag(FLAG_ICHOR_APOLLO_BRAZIER)) {
                setflag(FLAG_ICHOR_APOLLO_BRAZIER)
                call(Delphoi_TempleOfApollo_EventScript_BrazierCatches)
            }
    }
    return
}

