script Delphoi_TempleOfApollo_EventScript_FaceM8 {
    switch (var(VAR_TEMP_9)) {
        case 0:
            turnobject(LOCALID_APOLLO_M8, DIR_SOUTH)
            setobjectmovementtype(LOCALID_APOLLO_M8, MOVEMENT_TYPE_ICHOR_MIRROR)
        case 1:
            turnobject(LOCALID_APOLLO_M8, DIR_WEST)
            setobjectmovementtype(LOCALID_APOLLO_M8, MOVEMENT_TYPE_ICHOR_MIRROR_LEFT)
        case 2:
            turnobject(LOCALID_APOLLO_M8, DIR_NORTH)
            setobjectmovementtype(LOCALID_APOLLO_M8, MOVEMENT_TYPE_ICHOR_MIRROR_UP)
        case 3:
            turnobject(LOCALID_APOLLO_M8, DIR_EAST)
            setobjectmovementtype(LOCALID_APOLLO_M8, MOVEMENT_TYPE_ICHOR_MIRROR_RIGHT)
    }
    return
}

