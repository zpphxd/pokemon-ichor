// The Icefall (design/maps/Ascent_Icefall.md): ice caves behind a waterfall that
// froze. Generated by tools/ichor/maps/ascent_snow.py: edit the builder, not this file.

mapscripts Ascent_Icefall_MapScripts {
    MAP_SCRIPT_ON_LOAD: Ascent_Icefall_EventScript_DrawState
}

// The grate stays up once the drum has sat on its plate; the drum stays on it.
script Ascent_Icefall_EventScript_DrawState {
    if (flag(FLAG_ICHOR_ICEFALL_GRATE_OPEN)) {
        setmetatile(19, 8, 0x36F, FALSE)
        setmetatile(16, 11, 0x36D, FALSE)
        setobjectxyperm(LOCALID_ASCENT_ICEFALL_DRUM, 16, 11)
    }
}

// Herakles's floor seal: one drum onto one plate raises the grate (the teach).
script Ascent_Icefall_EventScript_Plates {
    if (flag(FLAG_ICHOR_ICEFALL_GRATE_OPEN)) {
        end
    }
    getobjectxy(LOCALID_ASCENT_ICEFALL_DRUM, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 16 && var(VAR_0x8008) == 11) {
        lockall
        setflag(FLAG_ICHOR_ICEFALL_GRATE_OPEN)
        setmetatile(16, 11, 0x36D, FALSE)
        playse(SE_DOOR)
        delay(20)
        setmetatile(19, 8, 0x36F, FALSE)
        special(DrawWholeMapView)
        msgbox(format("The plate sinks under the drum. Somewhere a chain runs, and the bronze grate rises."), MSGBOX_DEFAULT)
        releaseall
    }
}

script Ascent_Icefall_EventScript_Lever {
    lockall
    if (flag(FLAG_ICHOR_ICEFALL_GRATE_OPEN)) {
        msgbox(format("A bronze lever, frozen in the up position. The grate is open."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A bronze lever by the plate, the Girdle's knot cast in its handle: the seal's reset.\pPull it and put the drum back?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        warpsilent(MAP_ASCENT_ICEFALL, 13, 10)
        waitstate
    }
    releaseall
}

script Ascent_Icefall_EventScript_Chione {
    trainerbattle_single(TRAINER_ICHOR_ICEFALL_CHIONE,
        format("The snow nymph keeps this gut. I keep it for her.\pYou'll have to come through both of us."),
        format("Melted."))
    msgbox(format("Chione was Boreas's daughter. The north wind's.\pHer children are still in the walls here, if you listen."), MSGBOX_AUTOCLOSE)
}

script Ascent_Icefall_EventScript_Arktos {
    trainerbattle_single(TRAINER_ICHOR_ICEFALL_ARKTOS,
        format("The Archon's guard holds the Icefall. Nobody slips past."),
        format("…Nobody but you, then."))
    msgbox(format("Up past the grate there's a drum and a plate. Herakles's sort of lock.\pPut the weight where the weight goes."), MSGBOX_AUTOCLOSE)
}

script Ascent_Icefall_EventScript_Boreades {
    trainerbattle_single(TRAINER_ICHOR_ICEFALL_BOREADES,
        format("I read the wind for omens. It stopped telling me anything.\pSo now I just fight in it."),
        format("Cold comfort."))
    msgbox(format("The glacier's up through that mouth. Mind the ice field.\pA wrong push and it carries you right across."), MSGBOX_AUTOCLOSE)
}

script Ascent_Icefall_EventScript_Shrine {
    msgbox(format("A stele of Hestia, cut into the ice. Fragment III of the Olympian hymn:\p“Hestia took the first seat at the hearth and the last at the feast.\pWhen the Twelve were too many by one, she gave her throne away, and kept the fire.”"), MSGBOX_SIGN)
}

script Ascent_Icefall_EventScript_FrozenFall {
    msgbox(format("A waterfall frozen solid in mid-pour. It hasn't moved in a thousand years.\pSomething glints behind the ice, high up. No way to reach it."), MSGBOX_SIGN)
}

script Ascent_Icefall_EventScript_IceSign {
    msgbox(format("THE ICEFALL\nThe floor is ice. You won't stop till something stops you.\pCrystals and pillars will. Plan the slide before you take it."), MSGBOX_SIGN)
}

script Ascent_Icefall_EventScript_VaultDoor {
    msgbox(format("A door of black ice, bound with a bronze chain thick as an arm.\pCut into the lintel: ICHOR, WHAT THE GODS BLED."), MSGBOX_SIGN)
}

script Ascent_Icefall_EventScript_Ichor {
    msgbox(format("The crystals here are full of light, gold at the heart.\pOld climbers said the gods bled here in the war with the Giants,\pand the blood froze where it fell."), MSGBOX_SIGN)
}

// --- the gods' easter eggs (tools/ichor/maps/ascent_eggs.py) ---
script Ascent_Icefall_EventScript_EggHammer {
    msgbox(format("A smith's hammer is frozen into the ice here, haft up.\pThe haft is warm. It shouldn't be. Hephaestus never could keep track of his tools."), MSGBOX_SIGN)
}

script Ascent_Icefall_EventScript_EggBoreas {
    msgbox(format("The frost on the wall has made a face: cheeks puffed out, mid-blow.\pThe north wind came through here once and left his likeness behind."), MSGBOX_SIGN)
}
