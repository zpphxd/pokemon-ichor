// Daedalus's floor seal Sun: the TM room's way on is grated until a drum sits on its plate (Ring II teaches the idea)
script LabyrinthRing2_EventScript_PlatesSun {
    if (flag(FLAG_TEMP_4)) {
        end
    }
    setvar(VAR_TEMP_9, 0)
    getobjectxy(LOCALID_LABYRINTHRING2_Sun_DRUM0, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 8 && var(VAR_0x8008) == 18) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_TEMP_9) == 1) {
        lockall
        setflag(FLAG_TEMP_4)
        call(LabyrinthRing2_EventScript_DrawState)
        special(DrawWholeMapView)
        playse(SE_DOOR)
        msgbox(format("Bronze clanks deep in the wall. Something has opened."), MSGBOX_DEFAULT)
        releaseall
    }
}

script LabyrinthRing2_EventScript_LeverSun {
    lockall
    msgbox(format("A bronze lever with a double axe for a handle: Daedalus's reset.\pPull it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        warpsilent(MAP_LABYRINTH_RING2, 9, 15)
        waitstate
    }
    releaseall
}

// Daedalus's floor seal Moon: the Moon Room's way on: two drums, two plates
