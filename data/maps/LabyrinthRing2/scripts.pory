        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 25 && var(VAR_0x8008) == 14) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_LABYRINTHRING2_Moon_DRUM1, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 23 && var(VAR_0x8008) == 14) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 25 && var(VAR_0x8008) == 14) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_TEMP_9) == 2) {
        lockall
        setflag(FLAG_TEMP_5)
        call(LabyrinthRing2_EventScript_DrawState)
