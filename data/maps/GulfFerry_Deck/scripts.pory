// The Gulf ferry, Route 10 (SCRIPT.md beat 37B; Part 2's ferry roster; Part 3's two
// trainers; Part 4's fishing from the rail; Part 6's items). Reached only by Panopeus's
// scripted warps from Kirrha's quay and Aigion's. Layout and events are generated by
// tools/ichor/maps/harbors.py (harbors_deck.py).
//
//   FLAG_ICHOR_FERRY_TO_KIRRHA  set when boarding at Aigion: this run lands at Kirrha
//   FLAG_ICHOR_NO_RELICS        set on every arrival: nobody surfs or flies off a ferry
//                               under way (the water around stays fishable)

mapscripts GulfFerry_Deck_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_ICHOR_NO_RELICS)
        setflag(FLAG_ICHOR_BOARDED_GULF_FERRY)
        if (flag(FLAG_ICHOR_GULF_CROSSED)) {
            setflag(FLAG_ICHOR_HIDE_ALETHEA_GULF_FERRY)
        }
    }
}

text GulfFerry_Deck_Name_Panopeus { "PANOPEUS" }
text GulfFerry_Deck_Name_Alethea { "ALETHEA" }
text GulfFerry_Deck_Name_Goat { "GOAT" }
text GulfFerry_Deck_Name_Kephisios { "KEPHISIOS" }
text GulfFerry_Deck_Name_Lamprias { "LAMPRIAS" }

// ---------------------------------------------------------------------------
// Panopeus at the steering oar: when the player says so, the crossing ends.
// NO lets the player keep fishing; YES lands (beat 37C at Aigion the first time).
// ---------------------------------------------------------------------------

script GulfFerry_Deck_EventScript_Panopeus {
    lock
    faceplayer
    setspeaker(GulfFerry_Deck_Name_Panopeus)
    if (!flag(FLAG_ICHOR_GULF_CROSSED)) {
        msgbox(format("A Lakonian boy crossed with me two days back. Red cloak.\p"
                      "Paid me extra to row faster. I said it's a sail.\p"
                      "He said, “Then blow on it.”"))
    }
    msgbox(format("Ready to land?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        release
        end
    }
    closemessage
    fadescreen(FADE_TO_BLACK)
    if (flag(FLAG_ICHOR_FERRY_TO_KIRRHA)) {
        clearflag(FLAG_ICHOR_FERRY_TO_KIRRHA)
        warpsilent(MAP_KIRRHA, 22, 23)
        waitstate
        release
        end
    }
    setflag(FLAG_ICHOR_GULF_CROSSED)
    setflag(FLAG_ICHOR_VISITED_AIGION)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_GULF_FERRY)
    warpsilent(MAP_AIGION, 17, 4)
    waitstate
    release
}

// ---------------------------------------------------------------------------
// Alethea at the stern, watching the water (once, before landing)
// ---------------------------------------------------------------------------

script GulfFerry_Deck_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(GulfFerry_Deck_Name_Alethea)
    if (flag(FLAG_ICHOR_FERRY_ALETHEA_SPOKE)) {
        msgbox(format("I hope she's kind to him."))
        release
        end
    }
    msgbox(format("Kleon's gone to fight Kallisto. The Huntress.\p"
                  "The whole theater was talking about her.\p"
                  "Nobody's beaten her this month.\p"
                  "They say she never looks at you. The whole battle. Just at the sky.\p"
                  "He's going to hate that. He wants to be looked at."))
    closemessage
    applymovement(LOCALID_GULF_FERRY_ALETHEA, Common_Movement_FaceRight)
    waitmovement(0)
    delay(30)
    setspeaker(GulfFerry_Deck_Name_Alethea)
    msgbox(format("I hope she's kind to him.\p"
                  "…That's not a thing I've ever hoped about a battle before."))
    setflag(FLAG_ICHOR_FERRY_ALETHEA_SPOKE)
    release
}

// ---------------------------------------------------------------------------
// The goats, the rail, the deckhouse
// ---------------------------------------------------------------------------

script GulfFerry_Deck_EventScript_Goat {
    lock
    faceplayer
    // ICHOR_STUB_AETHOS_DEX: Kerazap (the goats) cries as its stand-in until the dex lands
    playmoncry(SPECIES_KERAZAP, CRY_MODE_NORMAL)
    setspeaker(GulfFerry_Deck_Name_Goat)
    msgbox(format("Mehh."))
    waitmoncry
    setspeaker(0)
    msgbox(format("The goat is chewing a corner of your cloak, thoughtfully."))
    release
}

script GulfFerry_Deck_EventScript_Rail {
    msgbox(format("The gulf is deep here. The water is the color of wine."), MSGBOX_SIGN)
}

script GulfFerry_Deck_EventScript_Deckhouse {
    msgbox(format("Panopeus's deckhouse. A cloak on a peg, a jug, a lot of goat."), MSGBOX_SIGN)
}

// ---------------------------------------------------------------------------
// Trainers (Part 3, the Gulf ferry, level 31): both optional
// ---------------------------------------------------------------------------

script GulfFerry_Deck_EventScript_Kephisios {
    trainerbattle_single(TRAINER_ICHOR_KEPHISIOS, GulfFerry_Deck_Text_KephisiosIntro,
                         GulfFerry_Deck_Text_KephisiosDefeat)
    setspeaker(GulfFerry_Deck_Name_Kephisios)
    msgbox(format("The gulf's deep enough to hide anything. Even a ray that bites back."),
           MSGBOX_AUTOCLOSE)
}

text GulfFerry_Deck_Text_KephisiosIntro {
    format("Something big's been nibbling my line all crossing. Is it you?")
}

text GulfFerry_Deck_Text_KephisiosDefeat {
    format("It wasn't you. It's still nibbling.")
}

script GulfFerry_Deck_EventScript_Lamprias {
    trainerbattle_single(TRAINER_ICHOR_LAMPRIAS, GulfFerry_Deck_Text_LampriasIntro,
                         GulfFerry_Deck_Text_LampriasDefeat)
    setspeaker(GulfFerry_Deck_Name_Lamprias)
    msgbox(format("My donkey ate a gold coin once, and came out like this. Shiny.\p"
                  "I've been feeding it coins since. Nothing."), MSGBOX_AUTOCLOSE)
}

text GulfFerry_Deck_Text_LampriasIntro {
    format("I'm taking grain to Arkadia. They eat acorns there. Let's battle.")
}

text GulfFerry_Deck_Text_LampriasDefeat {
    format("My donkey's worth more than my grain. And it lost.")
}
