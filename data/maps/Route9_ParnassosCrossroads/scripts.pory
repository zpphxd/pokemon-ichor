script Route9_ParnassosCrossroads_EventScript_POLYON {
    trainerbattle_single(TRAINER_ICHOR_R9_POLYON, format("The three roads meet here. So do we."), format("Fair. Take the south road."))
    msgbox(format("A king died at this crossing once. He wouldn't give way either."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_ParnassosCrossroads_EventScript_MNASON {
    trainerbattle_single(TRAINER_ICHOR_R9_MNASON, format("The olives below are mine. The view's free."), format("Keep the view. I'll keep the olives."))
    msgbox(format("Mind the grass at the stair. It's thick this year."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_ParnassosCrossroads_EventScript_AKESON {
    trainerbattle_single(TRAINER_ICHOR_R9_AKESON, format("I walked from Thyrsa to ask the god one question."), format("Now I have two."))
    msgbox(format("Delphoi's up there, past the falls. The way is shut, they say."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_ParnassosCrossroads_EventScript_ERYX {
    trainerbattle_single(TRAINER_ICHOR_R9_ERYX, format("Apollo's olives. Walk softly under them."), format("Softly enough."))
    msgbox(format("The harbor's just past the trees. Kirrha."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_ParnassosCrossroads_EventScript_PHILTA {
    trainerbattle_single(TRAINER_ICHOR_R9_PHILTA, format("My flock grazes up to the cave and no farther."), format("Smart flock."))
    msgbox(format("Pan lives in the cave up the goat path. He plays at noon, they say."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_ParnassosCrossroads_EventScript_DEINON {
    trainerbattle_single(TRAINER_ICHOR_R9_DEINON, format("Crows over the cave mouth. That's a sign."), format("Of you, it seems."))
    msgbox(format("Take a light into the cave. The nymphs keep it dark."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_ParnassosCrossroads_EventScript_THEANO {
    trainerbattle_single(TRAINER_ICHOR_R9_THEANO, format("From here you can see the temple roofs, when the cloud lets you."), format("The cloud let you win."))
    msgbox(format("One day the falls will let you up. Not today."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_ParnassosCrossroads_EventScript_NorthSign {
    msgbox(format("Route 9, the Schiste.\nNorth: Lebadeia. South: Kirrha and the Gulf."), MSGBOX_SIGN)
    end
}

script Route9_ParnassosCrossroads_EventScript_SouthSign {
    msgbox(format("Route 9, the Schiste.\nSouth: Kirrha. North: Lebadeia."), MSGBOX_SIGN)
    end
}

script Route9_ParnassosCrossroads_EventScript_Delphoi {
    msgbox(format("Delphoi is above the falls. The water has taken the stair.\pThe road continues south to Kirrha."), MSGBOX_SIGN)
    end
}

script Route9_ParnassosCrossroads_EventScript_Tomb {
    msgbox(format("An old king's tomb at the three-ways.\pSomeone has left a chariot's linchpin on it."), MSGBOX_SIGN)
    end
}

script Route9_ParnassosCrossroads_EventScript_Milestone {
    msgbox(format("DAULIS, the stone says. The road west is lost in thorns."), MSGBOX_SIGN)
    end
}

script Route9_ParnassosCrossroads_EventScript_Cave {
    msgbox(format("The Korykian Cave: Pan's, and the nymphs'.\nBring a light."), MSGBOX_SIGN)
    end
}

script Route9_ParnassosCrossroads_EventScript_Spring {
    lock
    faceplayer
    msgbox(format("Drink. It comes off the mountain cold enough to wake the dead."))
    special(HealPlayerParty)
    if (!flag(FLAG_ICHOR_R9_SPRING_GIFT)) {
        msgbox(format("Take a skin of it for the road down. Kirrha's water tastes of boats."))
        giveitem(ITEM_FRESH_WATER, 2)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_R9_SPRING_GIFT)
        }
        release
        end
    }
    msgbox(format("There. The rest of the way is downhill."))
    release
}
