mapscripts Route9_ParnassosCrossroads_MapScripts {}

script Route9_ParnassosCrossroads_EventScript_POLYON {
    trainerbattle_single(TRAINER_ICHOR_R9_POLYON,
        format("A long road. Let's make it worth remembering."),
        format("Worth the walk."))
    msgbox(format("There's a healer at the next hamlet."), MSGBOX_AUTOCLOSE)
    end
}

