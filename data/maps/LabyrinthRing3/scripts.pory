// The ring's state, drawn on load and after every change: lit braziers, opened
// doors and gates. Ichor_DrawThread goes after it.
script LabyrinthRing3_EventScript_DrawState {
    if (flag(FLAG_TEMP_4)) {
        setmetatile(30, 37, 0x21C, FALSE)
    } else {
        setmetatile(30, 37, 0x3CA, TRUE)
    }
}

// Daedalus's floor seal Door: the workshop's front door is sealed: three drums onto three plates
script LabyrinthRing3_EventScript_PlatesDoor {
    if (flag(FLAG_TEMP_4)) {
        end
    }
    setvar(VAR_TEMP_9, 0)
    getobjectxy(LOCALID_LABYRINTHRING3_Door_DRUM0, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 28 && var(VAR_0x8008) == 42) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 33 && var(VAR_0x8008) == 42) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 31 && var(VAR_0x8008) == 39) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_LABYRINTHRING3_Door_DRUM1, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 28 && var(VAR_0x8008) == 42) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 33 && var(VAR_0x8008) == 42) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 31 && var(VAR_0x8008) == 39) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_LABYRINTHRING3_Door_DRUM2, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 28 && var(VAR_0x8008) == 42) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 33 && var(VAR_0x8008) == 42) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 31 && var(VAR_0x8008) == 39) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_TEMP_9) == 3) {
        lockall
        setflag(FLAG_TEMP_4)
        call(LabyrinthRing3_EventScript_DrawState)
        special(DrawWholeMapView)
        playse(SE_DOOR)
        msgbox(format("Bronze clanks deep in the wall. Something has opened."), MSGBOX_DEFAULT)
        releaseall
    }
}

script LabyrinthRing3_EventScript_LeverDoor {
    lockall
    msgbox(format("A bronze lever with a double axe for a handle: Daedalus's reset.\pPull it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        warpsilent(MAP_LABYRINTH_RING3, 32, 42)
        waitstate
    }
    releaseall
}

script LabyrinthRing3_EventScript_Remains1 {
    msgbox(format("Bones under a drift of old web. A bronze pin in the dust: a girl's."), MSGBOX_SIGN)
}

script LabyrinthRing3_EventScript_Remains2 {
    msgbox(format("Scratched deep: THE BRONZE MEN DROVE IT AT US WITH FIRE.\pIT DID NOT WANT TO."), MSGBOX_SIGN)
}

script LabyrinthRing3_EventScript_Remains3 {
    msgbox(format("An explorer's satchel, rotted through. A map inside, every line crossed out."), MSGBOX_SIGN)
}

// Hook for later (the Three-Flamed Torch (post-game)): the spiders' mother-nest behind a thornweb only the Three-Flamed Torch burns (post-game)
script LabyrinthRing3_EventScript_Lair3 {
    lockall
    if (!flag(FLAG_ICHOR_R3_STATIC)) {
        msgbox(format("Something shifts in the dark at the end of the passage."), MSGBOX_DEFAULT)
        closemessage
        setwildbattle(SPECIES_HYPHANTIS, 55)
        dowildbattle
        setflag(FLAG_ICHOR_R3_STATIC)
    } else {
        msgbox(format("Old scratches on the rock. Whatever lived here has gone."), MSGBOX_DEFAULT)
    }
    releaseall
}

