script LabyrinthRing3_EventScript_TurningBreak0 {
    lockall
    setvar(VAR_TEMP_D, 1)
    playse(SE_M_EARTHQUAKE)
    msgbox(format("The wall ahead grinds shut across the passage."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_0x8004, 2)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, 10)
    setvar(VAR_0x8007, 3)
    special(ShakeCamera)
    waitstate
    playse(SE_M_MEGA_KICK)
    setmetatile(20, 41, 0x25E, TRUE)
    setmetatile(21, 41, 0x25E, TRUE)
    setmetatile(22, 41, 0x25E, TRUE)
    setmetatile(23, 41, 0x25E, TRUE)
    setmetatile(21, 42, 0x32B, FALSE)
    setmetatile(22, 42, 0x320, FALSE)
    setmetatile(21, 43, 0x320, FALSE)
    setmetatile(22, 43, 0x32B, FALSE)
    setmetatile(21, 44, 0x251, TRUE)
    setmetatile(22, 44, 0x255, TRUE)
    special(Ichor_DrawThread)
    special(DrawWholeMapView)
    msgbox(format("Then it bursts. Horns, a tail, a cloud of dust, and Asterion is gone ahead.\pHe's clearing the way."), MSGBOX_DEFAULT)
    closemessage
    releaseall
}

