// Ring III, the Mysteries (design/LABYRINTH.md §6 Ring III; design/maps/LabyrinthRing3.md).
// Demeter's verb, dark and light: webs on the front way to the workshop's front door,
// and Daedalus's glow-paint labrys signs on the back way, seen only with the torch
// doused (the labyrinth tileset's glow set, src/data/ichor_glow.h). The layout and the
// generated block come from tools/ichor/maps/labyrinth_ring3.py.

mapscripts LabyrinthRing3_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        call(LabyrinthRing3_EventScript_Register)
        call(LabyrinthRing3_EventScript_DrawState)
        special(Ichor_DrawThread)
    }
}

script LabyrinthRing3_EventScript_Web {
    goto(EventScript_IchorCobweb)
}

script LabyrinthRing3_EventScript_GlowSign {
    msgbox(format("A double axe is scratched into the stone, small, where a hand would rest.\p"
                  "The paint in the cut has a faint sheen. Paint like that is meant for the dark."),
           MSGBOX_SIGN)
}

script LabyrinthRing3_EventScript_Hole {
    lockall
    msgbox(format("Webs give under your feet. There was never any floor here!"), MSGBOX_DEFAULT)
    closemessage
    playse(SE_FALL)
    warp(MAP_LABYRINTH_RING4, 3)
    waitstate
}

script LabyrinthRing3_EventScript_Automaton3 {
    trainerbattle_single(TRAINER_ICHOR_AUTOMATON_3, LabyrinthRing3_Text_Automaton3Intro, LabyrinthRing3_Text_Automaton3Defeat)
    msgbox(format("NO. 3: …CLICK."), MSGBOX_AUTOCLOSE)
}

text LabyrinthRing3_Text_Automaton3Intro {
    format("NO. 3: CLICK. INTRUDER. CLICK. WIND ME. NO. BATTLE.")
}

text LabyrinthRing3_Text_Automaton3Defeat {
    format("NO. 3: WHIRR… RUN… DOWN…")
}

script LabyrinthRing3_EventScript_Automaton7 {
    trainerbattle_single(TRAINER_ICHOR_AUTOMATON_7, LabyrinthRing3_Text_Automaton7Intro, LabyrinthRing3_Text_Automaton7Defeat)
    msgbox(format("NO. 7: CLICK. GOOD. CLICK."), MSGBOX_AUTOCLOSE)
}

text LabyrinthRing3_Text_Automaton7Intro {
    format("AUTOMATON 7: CLICK. WHIRR. CHALLENGE. CHALLENGE. CHALLENGE.")
}

text LabyrinthRing3_Text_Automaton7Defeat {
    format("NO. 7: CHALLENGE… MET.")
}

