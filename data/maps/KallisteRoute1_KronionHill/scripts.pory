// Kronion Hill, the summit of the ruins: beat 5's summit cutscene. Text from
// design/phase1/SCRIPT.md, Part 1 (beat 5), Part 2 (Kronion Hill) and Part 3
// (Titanborn grunts). Layout and events are generated by tools/ichor/maps/route1.py.
//
// Staging (map coordinates): the player tops the upper stair at (13,10), the
// trigger, and joins Alethea on the grass below the stylobate's south step:
// she stands at (9,9), the player at (10,9). Petros (9,7) and Amathos (10,7)
// dig in the pit behind the step, facing the broken altar. Each climbs out
// onto the step to fight, and the grunts flee down the stair. The tablet
// object waits hidden at (10,8), on the step where Amathos stood.
//
// The dark stair (design/SYSTEMS.md, relic gates; decision D10): once the
// grunts are gone, the pit's lower row shows cut steps going down into the
// dark, Hecate's Torch's second gate. It leads to the Kronion crypt, which is
// not built yet; for now the steps only answer with a line.

mapscripts KallisteRoute1_KronionHill_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // The tablet only shows while it lies on the ground mid-scene.
        setflag(FLAG_ICHOR_HIDE_TITAN_TABLET)
        if (flag(FLAG_ICHOR_RUINS_CLEARED)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            setvar(VAR_TEMP_1, 0)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_RUINS_CLEARED)) {
            call(KallisteRoute1_KronionHill_EventScript_SetDarkStair)
        }
    }
}

// The pit's lower row (9,7)-(10,7) becomes the mouth of the dark stair.
script KallisteRoute1_KronionHill_EventScript_SetDarkStair {
    setmetatile(9, 7, METATILE_Agros_PitStair_Left, TRUE)
    setmetatile(10, 7, METATILE_Agros_PitStair_Right, TRUE)
}

text KallisteRoute1_KronionHill_Text_SpeakerAlethea { "ALETHEA" }
text KallisteRoute1_KronionHill_Text_SpeakerPetros { "PETROS" }
text KallisteRoute1_KronionHill_Text_SpeakerAmathos { "AMATHOS" }

script KallisteRoute1_KronionHill_EventScript_SummitScene {
    lockall
    hidefollower
    // A low rumble under the hill.
    playse(SE_M_EARTHQUAKE)
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 1)
    setvar(VAR_0x8006, 6)
    setvar(VAR_0x8007, 5)
    special(ShakeCamera)
    waitstate
    delay(20)
    applymovement(LOCALID_KRONION_ALETHEA, Common_Movement_FaceRight)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("{PLAYER}! Good timing. Did you feel that?"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, KallisteRoute1_KronionHill_Movement_PlayerJoin)
    waitmovement(0)
    // Lift the view so the altar and the pit are in frame.
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, KallisteRoute1_KronionHill_Movement_CameraUp)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("These two have been digging up the shrine all morning."))
    closemessage
    applymovement(LOCALID_KRONION_PETROS, Common_Movement_FaceDown)
    applymovement(LOCALID_KRONION_AMATHOS, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Dig site's closed, kid. Titanborn business."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("We're only taking back what belongs to our lord."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("Nothing here belongs to you. That stone's ancient."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Yeah. That's the point."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("I'm a scholar, not a brawler. {PLAYER}, help?"))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, KallisteRoute1_KronionHill_Movement_CameraDown)
    waitmovement(0)
    special(RemoveCameraObject)

    // Battle 1: Petros climbs out of the pit. Skipped if he was beaten on an
    // earlier attempt (the player then lost to Amathos and whited out).
    if (!defeated(TRAINER_ICHOR_GRUNT_RUINS_PETROS)) {
        applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_PetrosApproach)
        waitmovement(0)
        trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_RUINS_PETROS, KallisteRoute1_KronionHill_Text_PetrosDefeat)
    } else {
        applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_PetrosApproach)
        waitmovement(0)
    }
    applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_PetrosStepAside)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)

    // Battle 2: Amathos.
    applymovement(LOCALID_KRONION_AMATHOS, KallisteRoute1_KronionHill_Movement_AmathosApproach)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("Useless. Watch how it's done."))
    closemessage
    trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_RUINS_AMATHOS, KallisteRoute1_KronionHill_Text_AmathosDefeat)

    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("Fine. FINE. There's nothing down there anyway."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Pebblith hasn't twitched once. I told you it was wrong hill."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("Stop talking about the Pebblith."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Hyperion's going to roast us."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("He'll roast us literally. Move!"))
    closemessage
    // They run for the stair and leap off the rock band below it.
    applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_PetrosFlee)
    applymovement(LOCALID_KRONION_AMATHOS, KallisteRoute1_KronionHill_Movement_AmathosFlee)
    waitmovement(0)
    removeobject(LOCALID_KRONION_PETROS)
    removeobject(LOCALID_KRONION_AMATHOS)
    setflag(FLAG_ICHOR_HIDE_RUINS_GRUNTS)

    // The tablet they dropped, where Amathos stood.
    clearflag(FLAG_ICHOR_HIDE_TITAN_TABLET)
    addobject(LOCALID_KRONION_TABLET)
    playse(SE_LEDGE)
    delay(24)
    applymovement(LOCALID_KRONION_ALETHEA, KallisteRoute1_KronionHill_Movement_AletheaToTablet)
    waitmovement(0)
    delay(16)
    playse(SE_SELECT)
    removeobject(LOCALID_KRONION_TABLET)
    setflag(FLAG_ICHOR_HIDE_TITAN_TABLET)
    setflag(FLAG_ICHOR_FOUND_TITAN_TABLET)
    applymovement(LOCALID_KRONION_ALETHEA, KallisteRoute1_KronionHill_Movement_AletheaBack)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("They dropped this. A clay tablet. Sickle stamped on top.\pIt's a list of places. “Kalliste” is scratched out.\pThen: “The fragment of the Harpe lies…\p…where the grain goes underground.”"))
    msgbox(format("A riddle. I hate riddles. They're just lies wearing hats."))
    // The tablet's last legible line (design/LABYRINTH.md §14 item 11): Knossa,
    // the house of the labrys, seeded here for the late game.
    msgbox(format("…And at the bottom: “Last, the house of the double axe.”"))
    msgbox(format("That's not a riddle. That's just rude."))
    msgbox(format("The Harpe… that's Kronos's sickle. From the old stories.\pThe one he used to overthrow his own father.\pWhy would anyone dig for a story?"))
    closemessage
    delay(30)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("…Unless it isn't one."))
    closemessage
    delay(40)

    // Alethea's gift: the Augur's Eye (the expansion's DexNav).
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("Here. Take my old Augur's Eye. I built a better one."))
    setspeaker(SP_NAME_NONE)
    setflag(FLAG_ICHOR_DEXNAV_GET)
    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} received the Augur's Eye!"))
    waitmessage
    waitfanfare
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("Augurs read birds. This reads grass. Want the short version?"), MSGBOX_YESNO)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    if (var(VAR_RESULT) == YES) {
        msgbox(format("Open it from your menu. Pick a Pokémon you've already seen.\pIt'll show you where one's hiding. Creep up slowly.\pPokémon hate being stared at. So do I, for the record."))
    } else {
        msgbox(format("Good. I'd have explained it badly. Truthfully, but badly."))
    }
    msgbox(format("I'm taking this tablet to Daphne. You go on to Akti.\pThe Hearthkeeper's waiting. I'll catch up. I'm fast.\pThat's a lie, actually. I'm slow. But I'll catch up."))
    closemessage

    // Alethea goes down the stair and off the hill.
    applymovement(LOCALID_KRONION_ALETHEA, KallisteRoute1_KronionHill_Movement_AletheaLeave)
    waitmovement(0)
    removeobject(LOCALID_KRONION_ALETHEA)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_RUINS)
    setflag(FLAG_ICHOR_RUINS_CLEARED)
    // With the grunts gone, the pit shows where they had got to.
    call(KallisteRoute1_KronionHill_EventScript_SetDarkStair)
    special(DrawWholeMapView)
    setflag(FLAG_ICHOR_HIDE_ROUTE1_FLOCK)
    setvar(VAR_TEMP_1, 1)
    releaseall
}

text KallisteRoute1_KronionHill_Text_PetrosDefeat {
    format("Hrk! Amathos, your turn. I'm on break.")
}

text KallisteRoute1_KronionHill_Text_AmathosDefeat {
    format("The earth remembers, child. It remembers everything.")
}

// From the stair top (13,10) to Alethea's side at (10,9), facing the pit.
movement KallisteRoute1_KronionHill_Movement_PlayerJoin {
    walk_left * 3
    walk_up
    face_up
}

movement KallisteRoute1_KronionHill_Movement_CameraUp {
    walk_slow_up * 2
}

movement KallisteRoute1_KronionHill_Movement_CameraDown {
    walk_slow_down * 2
}

// Petros climbs out of the pit, (9,7) onto the step at (9,8), then over to
// (10,8), just above the player at (10,9).
movement KallisteRoute1_KronionHill_Movement_PetrosApproach {
    jump_in_place_down
    walk_down
    walk_right
    face_down
}

// Off along the step to (11,8), watching Amathos.
movement KallisteRoute1_KronionHill_Movement_PetrosStepAside {
    walk_right
    face_left
}

// Amathos climbs out, (10,7) to (10,8).
movement KallisteRoute1_KronionHill_Movement_AmathosApproach {
    jump_in_place_down
    walk_down
    face_down
}

// (11,8) along the step to its east gap (13,8), down the stair (13,11) and
// off the lower band, out of sight.
movement KallisteRoute1_KronionHill_Movement_PetrosFlee {
    walk_fast_right * 2
    walk_fast_down * 5
    jump_2_down
    walk_fast_down
}

// (10,8) one step behind Petros.
movement KallisteRoute1_KronionHill_Movement_AmathosFlee {
    walk_fast_right * 3
    walk_fast_down * 5
    jump_2_down
    walk_fast_down
}

// From (9,9) up onto the step at (9,8), beside the tablet at (10,8).
movement KallisteRoute1_KronionHill_Movement_AletheaToTablet {
    walk_up
    face_right
}

// Back down to (9,9), facing the player.
movement KallisteRoute1_KronionHill_Movement_AletheaBack {
    walk_down
    face_right
}

// (9,9) around the player to the stair top (13,10), down to the shelf, west
// along it to (6,13), and down the lower stair (6,15) to the hill foot.
movement KallisteRoute1_KronionHill_Movement_AletheaLeave {
    walk_down
    walk_right * 4
    walk_down * 3
    walk_left * 7
    walk_down * 3
}

// --- people, if the player talks to them before the scene plays ------------
script KallisteRoute1_KronionHill_EventScript_Alethea {
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("These two have been digging up the shrine all morning."), MSGBOX_NPC)
}

script KallisteRoute1_KronionHill_EventScript_Grunt {
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Dig site's closed, kid. Titanborn business."), MSGBOX_NPC)
}

// --- the ruins ----------------------------------------------------------------
script KallisteRoute1_KronionHill_EventScript_Stele {
    msgbox(format("KRONION HILL. An old shrine, older than the olives.\pSomeone has scratched a sickle into the stone. Recently."), MSGBOX_SIGN)
}

script KallisteRoute1_KronionHill_EventScript_Altar {
    msgbox(format("A cracked altar. The stone is warm, like a sleeping animal."), MSGBOX_SIGN)
}

script KallisteRoute1_KronionHill_EventScript_DigShrine {
    setvar(VAR_0x8004, 6)
    setvar(VAR_0x8005, ICHOR_DIG_ACT_I | ICHOR_DIG_SHERDS(ICHOR_AMPHORA_KRONOS))
    goto(EventScript_IchorDigSpot)
}

// Before the scene the grunts stand in the pit; after it, the pit is the
// mouth of the dark stair (Hecate's Torch opens it later).
script KallisteRoute1_KronionHill_EventScript_Pit {
    if (flag(FLAG_ICHOR_RUINS_CLEARED)) {
        msgbox(format("Stone steps go down into the dark. You can't see a thing.\p…It still feels like something's looking up."), MSGBOX_SIGN)
    }
}

// --- the high pastures, the hill's south flank (a branch off the hill foot) ----
// Herders from Theocritus: Menalkas, Thyrsis and Lykidas keep the hill's goats.
text KallisteRoute1_KronionHill_Text_SpeakerMenalkas { "MENALKAS" }
text KallisteRoute1_KronionHill_Text_SpeakerThyrsis { "THYRSIS" }
text KallisteRoute1_KronionHill_Text_SpeakerLykidas { "LYKIDAS" }

script KallisteRoute1_KronionHill_EventScript_HermFork {
    msgbox(format("Up: the old shrine. Down: the high pastures."), MSGBOX_SIGN)
}

// At the foot of the goat path, in plain view: the branch's first trainer.
script KallisteRoute1_KronionHill_EventScript_Menalkas {
    trainerbattle_single(TRAINER_ICHOR_MENALKAS, KallisteRoute1_KronionHill_Text_MenalkasIntro, KallisteRoute1_KronionHill_Text_MenalkasDefeat)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerMenalkas)
    msgbox(format("The goats won't graze near the old shrine. They never have."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_KronionHill_Text_MenalkasIntro {
    format("These are the high pastures. There's a toll. It's a battle.")
}

text KallisteRoute1_KronionHill_Text_MenalkasDefeat {
    format("Toll paid. Mind the fold gate, it sticks.")
}

// He sings to the spring with his back to the path: battling him is a choice.
script KallisteRoute1_KronionHill_EventScript_Thyrsis {
    trainerbattle_single(TRAINER_ICHOR_THYRSIS, KallisteRoute1_KronionHill_Text_ThyrsisIntro, KallisteRoute1_KronionHill_Text_ThyrsisDefeat)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerThyrsis)
    msgbox(format("I know one song. It's about Daphnis, who died of love.\pIt's very long. You're lucky you won."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_KronionHill_Text_ThyrsisIntro {
    format("Shh. I'm singing to the spring. …It says it wants a battle.")
}

text KallisteRoute1_KronionHill_Text_ThyrsisDefeat {
    format("The spring liked that better than my song. Rude.")
}

// Above the only stair down to the lookout shelf: past him, the Everstone.
script KallisteRoute1_KronionHill_EventScript_Lykidas {
    trainerbattle_single(TRAINER_ICHOR_LYKIDAS, KallisteRoute1_KronionHill_Text_LykidasIntro, KallisteRoute1_KronionHill_Text_LykidasDefeat)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerLykidas)
    msgbox(format("Kronos swallowed a stone instead of his son, they say.\pMy goats keep finding stones like that. Down by the edge."), MSGBOX_AUTOCLOSE)
}

text KallisteRoute1_KronionHill_Text_LykidasIntro {
    format("My goats found the best rock on the hill. Want it? Get past me.")
}

text KallisteRoute1_KronionHill_Text_LykidasDefeat {
    format("Ha! Go on, then. Mind the edge.")
}

script KallisteRoute1_KronionHill_EventScript_PanShrine {
    msgbox(format("A little shrine to Pan, the shepherds' god.\pSomeone left him a cheese. Something has nibbled it."), MSGBOX_SIGN)
}

script KallisteRoute1_KronionHill_EventScript_FoldGoat {
    lock
    faceplayer
    playmoncry(SPECIES_KERAZAP, CRY_MODE_NORMAL)
    msgbox(format("Meh-eh?"))
    waitmoncry
    release
}

script KallisteRoute1_KronionHill_EventScript_FoldKid {
    lock
    faceplayer
    playmoncry(SPECIES_ERIPIP, CRY_MODE_NORMAL)
    msgbox(format("Mee-eh! Its fleece crackles."))
    waitmoncry
    release
}

script KallisteRoute1_KronionHill_EventScript_Goat {
    lock
    faceplayer
    playmoncry(SPECIES_KERAZAP, CRY_MODE_NORMAL)
    msgbox(format("Meh-eh! It's chewing the thyme."))
    waitmoncry
    release
}
