// Kronion Hill, the summit of the ruins: beat 5's summit cutscene. Text from
// design/phase1/SCRIPT.md, Part 1 (beat 5), Part 2 (Kronion Hill) and Part 3
// (Titanborn grunts). Layout and events are generated by tools/ichor/maps/route1.py.
//
// Staging (map coordinates): the player tops the stair at (5,11), the trigger.
// Alethea stands at the pit's lip (9,8); Petros (10,8) and Amathos (11,8) dig
// in the pit, facing the broken altar. The tablet object waits hidden at (8,11).

mapscripts KallisteRoute1_KronionHill_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // The tablet only shows while it lies on the ground mid-scene.
        setflag(FLAG_ICHOR_HIDE_TITAN_TABLET)
        if (flag(FLAG_ICHOR_RUINS_CLEARED)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            setvar(VAR_TEMP_1, 0)
        }
    }
}

text KallisteRoute1_KronionHill_Text_SpeakerAlethea { "ALETHEA" }
text KallisteRoute1_KronionHill_Text_SpeakerPetros { "PETROS" }
text KallisteRoute1_KronionHill_Text_SpeakerAmathos { "AMATHOS" }

script KallisteRoute1_KronionHill_EventScript_SummitScene {
    lockall
    hidefollower
    // A low rumble under the hill.
    playse(SE_M_EARTHQUAKE)
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 1)
    setvar(VAR_0x8006, 6)
    setvar(VAR_0x8007, 5)
    special(ShakeCamera)
    waitstate
    delay(20)
    applymovement(LOCALID_KRONION_ALETHEA, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("{PLAYER}! Good timing. Did you feel that?"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, KallisteRoute1_KronionHill_Movement_PlayerJoin)
    waitmovement(0)
    // Lift the view so the altar and the pit are in frame.
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, KallisteRoute1_KronionHill_Movement_CameraUp)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("These two have been digging up the shrine all morning."))
    closemessage
    applymovement(LOCALID_KRONION_PETROS, Common_Movement_FaceDown)
    applymovement(LOCALID_KRONION_AMATHOS, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Dig site's closed, kid. Titanborn business."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("We're only taking back what belongs to our lord."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("Nothing here belongs to you. That stone's ancient."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Yeah. That's the point."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("I'm a scholar, not a brawler. {PLAYER}, help?"))
    closemessage
    applymovement(OBJ_EVENT_ID_CAMERA, KallisteRoute1_KronionHill_Movement_CameraDown)
    waitmovement(0)
    special(RemoveCameraObject)

    // Battle 1: Petros climbs out of the pit. Skipped if he was beaten on an
    // earlier attempt (the player then lost to Amathos and whited out).
    if (!defeated(TRAINER_ICHOR_GRUNT_RUINS_PETROS)) {
        applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_PetrosApproach)
        waitmovement(0)
        trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_RUINS_PETROS, KallisteRoute1_KronionHill_Text_PetrosDefeat)
    } else {
        applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_PetrosApproach)
        waitmovement(0)
    }
    applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_PetrosStepAside)
    waitmovement(0)

    // Battle 2: Amathos.
    applymovement(LOCALID_KRONION_AMATHOS, KallisteRoute1_KronionHill_Movement_AmathosApproach)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("Useless. Watch how it's done."))
    closemessage
    trainerbattle_no_intro(TRAINER_ICHOR_GRUNT_RUINS_AMATHOS, KallisteRoute1_KronionHill_Text_AmathosDefeat)

    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("Fine. FINE. There's nothing down there anyway."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Nosepass hasn't twitched once. I told you it was wrong hill."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("Stop talking about the Nosepass."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Hyperion's going to roast us."))
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAmathos)
    msgbox(format("He'll roast us literally. Move!"))
    closemessage
    // They run down the far side of the hill.
    applymovement(LOCALID_KRONION_PETROS, KallisteRoute1_KronionHill_Movement_GruntFlee)
    applymovement(LOCALID_KRONION_AMATHOS, KallisteRoute1_KronionHill_Movement_GruntFlee)
    waitmovement(0)
    removeobject(LOCALID_KRONION_PETROS)
    removeobject(LOCALID_KRONION_AMATHOS)
    setflag(FLAG_ICHOR_HIDE_RUINS_GRUNTS)

    // The tablet they dropped, where Amathos stood.
    clearflag(FLAG_ICHOR_HIDE_TITAN_TABLET)
    addobject(LOCALID_KRONION_TABLET)
    playse(SE_LEDGE)
    delay(24)
    applymovement(LOCALID_KRONION_ALETHEA, KallisteRoute1_KronionHill_Movement_AletheaToTablet)
    waitmovement(0)
    delay(16)
    playse(SE_SELECT)
    removeobject(LOCALID_KRONION_TABLET)
    setflag(FLAG_ICHOR_HIDE_TITAN_TABLET)
    setflag(FLAG_ICHOR_FOUND_TITAN_TABLET)
    applymovement(LOCALID_KRONION_ALETHEA, Common_Movement_FaceLeft)
    applymovement(OBJ_EVENT_ID_PLAYER, KallisteRoute1_KronionHill_Movement_FaceUpRight)
    waitmovement(0)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("They dropped this. A clay tablet. Sickle stamped on top.\pIt's a list of places. “Kalliste” is scratched out.\pThen: “The fragment of the Harpe lies…\p…where the grain goes underground.”"))
    msgbox(format("A riddle. I hate riddles. They're just lies wearing hats.\pThe Harpe… that's Kronos's sickle. From the old stories.\pThe one he used to overthrow his own father.\pWhy would anyone dig for a story?"))
    closemessage
    delay(30)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("…Unless it isn't one."))
    closemessage
    delay(40)

    // Alethea's gift: the Augur's Eye (the expansion's DexNav).
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("Here. Take my old Augur's Eye. I built a better one."))
    setspeaker(SP_NAME_NONE)
    setflag(FLAG_ICHOR_DEXNAV_GET)
    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} received the Augur's Eye!"))
    waitmessage
    waitfanfare
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("Augurs read birds. This reads grass. Want the short version?"), MSGBOX_YESNO)
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    if (var(VAR_RESULT) == YES) {
        msgbox(format("Open it from your menu. Pick a Pokémon you've already seen.\pIt'll show you where one's hiding. Creep up slowly.\pPokémon hate being stared at. So do I, for the record."))
    } else {
        msgbox(format("Good. I'd have explained it badly. Truthfully, but badly."))
    }
    msgbox(format("I'm taking this tablet to Daphne. You go on to Akti.\pThe Hearthkeeper's waiting. I'll catch up. I'm fast.\pThat's a lie, actually. I'm slow. But I'll catch up."))
    closemessage

    // Alethea goes down the stair and off the hill.
    applymovement(LOCALID_KRONION_ALETHEA, KallisteRoute1_KronionHill_Movement_AletheaLeave)
    waitmovement(0)
    removeobject(LOCALID_KRONION_ALETHEA)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_RUINS)
    setflag(FLAG_ICHOR_RUINS_CLEARED)
    setflag(FLAG_ICHOR_HIDE_ROUTE1_FLOCK)
    setvar(VAR_TEMP_1, 1)
    releaseall
}

text KallisteRoute1_KronionHill_Text_PetrosDefeat {
    format("Hrk! Amathos, your turn. I'm on break.")
}

text KallisteRoute1_KronionHill_Text_AmathosDefeat {
    format("The earth remembers, child. It remembers everything.")
}

// The player steps up beside the pit.
movement KallisteRoute1_KronionHill_Movement_PlayerJoin {
    walk_right * 2
    face_up
}

movement KallisteRoute1_KronionHill_Movement_FaceUpRight {
    face_right
}

movement KallisteRoute1_KronionHill_Movement_CameraUp {
    walk_slow_up * 2
}

movement KallisteRoute1_KronionHill_Movement_CameraDown {
    walk_slow_down * 2
}

// Petros climbs out of the pit, (10,8) to (8,11), next to the player at (7,11).
movement KallisteRoute1_KronionHill_Movement_PetrosApproach {
    jump_in_place_down
    walk_down * 3
    walk_left * 2
    face_left
}

movement KallisteRoute1_KronionHill_Movement_PetrosStepAside {
    walk_up
    face_down
}

// Amathos climbs out, (11,8) to (8,11).
movement KallisteRoute1_KronionHill_Movement_AmathosApproach {
    jump_in_place_down
    walk_down * 3
    walk_left * 3
    face_left
}

movement KallisteRoute1_KronionHill_Movement_GruntFlee {
    face_right
    walk_fast_right * 11
}

// From the lip of the pit (9,8) to stand over the tablet at (8,11).
movement KallisteRoute1_KronionHill_Movement_AletheaToTablet {
    walk_down * 2
    walk_left
    face_down
}

// (8,10) down the upper stair (5,12), across, down the lower stair (3,15)
// and out along the hill foot to the west edge (0,16).
movement KallisteRoute1_KronionHill_Movement_AletheaLeave {
    walk_left * 3
    walk_down * 4
    walk_left * 2
    walk_down * 2
    walk_left * 3
}

// --- people, if the player talks to them before the scene plays ------------
script KallisteRoute1_KronionHill_EventScript_Alethea {
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerAlethea)
    msgbox(format("These two have been digging up the shrine all morning."), MSGBOX_NPC)
}

script KallisteRoute1_KronionHill_EventScript_Grunt {
    setspeaker(KallisteRoute1_KronionHill_Text_SpeakerPetros)
    msgbox(format("Dig site's closed, kid. Titanborn business."), MSGBOX_NPC)
}

// --- the ruins ----------------------------------------------------------------
script KallisteRoute1_KronionHill_EventScript_Stele {
    msgbox(format("KRONION HILL. An old shrine, older than the olives.\pSomeone has scratched a sickle into the stone. Recently."), MSGBOX_SIGN)
}

script KallisteRoute1_KronionHill_EventScript_Altar {
    msgbox(format("A cracked altar. The stone is warm, like a sleeping animal."), MSGBOX_SIGN)
}

script KallisteRoute1_KronionHill_EventScript_Pit {
    if (flag(FLAG_ICHOR_RUINS_CLEARED)) {
        msgbox(format("A fresh hole, dug in a hurry. There's nothing in it.\p…It still feels like something's looking up."), MSGBOX_SIGN)
    }
}
