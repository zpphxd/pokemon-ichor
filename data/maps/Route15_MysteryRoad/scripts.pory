    end
}

script Route15_MysteryRoad_EventScript_PRAXON {
    trainerbattle_single(TRAINER_ICHOR_R15_PRAXON, format("The birds over Daphni fly east today. Toward the city. Toward trouble."), format("The birds were right."))
    msgbox(format("Apollo's laurels. Go and see the god's house."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_KERKOPS {
    trainerbattle_single(TRAINER_ICHOR_R15_KERKOPS, format("Hey, pilgrim! Your hat's a disgrace and your Pokémon smell of goat!\pThat's the custom. Insult me back!"), format("Ha! That stung. The goddess laughed, at least."))
    msgbox(format("When Demeter grieved, old Iambe made her laugh with filth. So we jest at the bridge."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_SIMMIAS {
    trainerbattle_single(TRAINER_ICHOR_R15_SIMMIAS, format("This marble built half the city. The other half's in my boots."), format("Cracked like a bad block."))
    msgbox(format("The good stone's deep. Mind the face on your way up."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_THEOXENOS {
    trainerbattle_single(TRAINER_ICHOR_R15_THEOXENOS, format("I hopped the ledge to skip the climb. Don't tell the procession."), format("Caught out."))
    msgbox(format("The ledge is a shortcut home. Not a shortcut up."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_LAMPON {
    trainerbattle_single(TRAINER_ICHOR_R15_LAMPON, format("In the Mysteries we carry Iakchos by torchlight. Carry this battle!"), format("My torch is out."))
    msgbox(format("That stand held Iakchos's torch. It's gone cold since the Titans came."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_KALLIDIKE {
    trainerbattle_single(TRAINER_ICHOR_R15_KALLIDIKE, format("King Keleos's daughters met Demeter at a well. I met you at an altar."), format("Mother will hear of this."))
