script Route15_MysteryRoad_EventScript_TIMON {
    trainerbattle_single(TRAINER_ICHOR_R15_TIMON, format("Eleusa's east watch. Everyone on the Mysteries' road gets one look from me."), format("Go on, then. The lakes are just past the olives."))
    msgbox(format("Daphni's healer tends travelers at the top of the pass."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_HEGESO {
    trainerbattle_single(TRAINER_ICHOR_R15_HEGESO, format("Salt on the wind, salt in the grass. My Pokémon love it out here."), format("Ugh. Briny luck."))
    msgbox(format("Only the priests may fish the Rheitoi. The fish are the goddesses'."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_POLEMON {
    trainerbattle_single(TRAINER_ICHOR_R15_POLEMON, format("The procession climbs this stair every autumn. Show me you can climb it."), format("You'll do."))
    msgbox(format("Up top there's a spring. Drink before you pray."), MSGBOX_AUTOCLOSE)
    end
}

script Route15_MysteryRoad_EventScript_PHILA {
    trainerbattle_single(TRAINER_ICHOR_R15_PHILA, format("Aphrodite's niches are just ahead. No rushing past the goddess."), format("...Fine. Rush."))
    msgbox(format("People leave little clay doves in the rock up there."), MSGBOX_AUTOCLOSE)
