script Route15_MysteryRoad_EventScript_Bridge {
    msgbox(format("The procession's bridge. Its middle span lies in the lake.\pOn the islet across the gap, a masked man is shouting at everyone who passes.\pWith a way over the water, you could shout back."), MSGBOX_SIGN)
    end
}

script Route15_MysteryRoad_EventScript_Herm {
    goto(EventScript_IchorGreatHerm)
}

script Route15_MysteryRoad_EventScript_Niches {
    msgbox(format("Niches cut in the living rock, full of clay doves and little offerings.\pAphrodite's shrine on the Sacred Way. The procession stops here to rest."), MSGBOX_SIGN)
    end
}

script Route15_MysteryRoad_EventScript_Altar {
    msgbox(format("A wayside altar of Demeter and Kore, sheaves carved on its sides.\pSomeone has kept it swept, even here."), MSGBOX_SIGN)
    end
}

script Route15_MysteryRoad_EventScript_Torch {
    setvar(VAR_0x8004, FLAG_ICHOR_R15_IAKCHOS_LIT)
    setvar(VAR_0x8005, FALSE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("The old stand catches. Iakchos's torch burns over the glade again,\p"
                      "the way it burned every autumn when the procession sang its way to Eleusis."), MSGBOX_DEFAULT)
    }
    if (flag(FLAG_ICHOR_R15_IAKCHOS_LIT) && !flag(FLAG_ICHOR_R15_IAKCHOS_GIFT)) {
        msgbox(format("Under the flame, in the stand's bronze cup, a stone has warmed red.\pYou take it."), MSGBOX_DEFAULT)
        giveitem(ITEM_FIRE_STONE)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_R15_IAKCHOS_GIFT)
        }
    }
    releaseall
}

script Route15_MysteryRoad_EventScript_Priest {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_R15_PRIEST_GIFT)) {
        msgbox(format("The Rheitoi's fish belong to Demeter and Kore. Only we priests may take them.\pYou walk the goddesses' road, though. Take this. The lake gives it up now and then."))
        giveitem(ITEM_DIVE_BALL)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_R15_PRIEST_GIFT)
        }
        release
        end
    }
    msgbox(format("Salt water and sweet water meet under the causeway. The fish like it there."))
    release
}

script Route15_MysteryRoad_EventScript_SpringKeeper {
    lock
    faceplayer
    msgbox(format("Rest a while. The procession always drinks here before it goes down.\pWater first. The god can wait."))
    special(HealPlayerParty)
    msgbox(format("There. Daphni's laurels are an hour down the far side."))
    release
}

script Route15_MysteryRoad_EventScript_Stair {
    setmetatile(50, 11, 0x1D1, FALSE)
    setmetatile(50, 12, 0x2BD, FALSE)
    setmetatile(50, 13, 0x1E1, FALSE)
    return
}

script Route15_MysteryRoad_EventScript_DrawSeal {
    if (flag(FLAG_ICHOR_R15_SHRINE_STAIR)) {
        call(Route15_MysteryRoad_EventScript_Stair)
        setobjectxyperm(LOCALID_ROUTE15_MYSTERY_ROAD_DRUM1, 47, 9)
        setobjectxyperm(LOCALID_ROUTE15_MYSTERY_ROAD_DRUM2, 53, 9)
    }
    return
}

script Route15_MysteryRoad_EventScript_Plates {
    if (flag(FLAG_ICHOR_R15_SHRINE_STAIR)) {
        end
    }
    getobjectxy(LOCALID_ROUTE15_MYSTERY_ROAD_DRUM1, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    getobjectxy(LOCALID_ROUTE15_MYSTERY_ROAD_DRUM2, CURRENT_POSITION, VAR_0x8009, VAR_0x800A)
    if (var(VAR_0x8007) == 47 && var(VAR_0x8008) == 9 && var(VAR_0x8009) == 53 && var(VAR_0x800A) == 9) {
        lockall
        setflag(FLAG_ICHOR_R15_SHRINE_STAIR)
        playse(SE_DOOR)
        delay(20)
        call(Route15_MysteryRoad_EventScript_Stair)
        special(DrawWholeMapView)
        playse(SE_M_STRENGTH)
        msgbox(format("Both drums sit true on their plates. Under the court, stone grinds on stone,\p"
                      "and steps open down the scarp to a hollow in the rock."), MSGBOX_DEFAULT)
        releaseall
    } elif (var(VAR_0x8007) == 47 && var(VAR_0x8008) == 9) {
        msgbox(format("The drum settles on a worn plate with a click. One plate to go."), MSGBOX_AUTOCLOSE)
    } elif (var(VAR_0x8009) == 53 && var(VAR_0x800A) == 9) {
        msgbox(format("The drum settles on a worn plate with a click. One plate to go."), MSGBOX_AUTOCLOSE)
    }
}

script Route15_MysteryRoad_EventScript_ResetPost {
    lockall
    if (flag(FLAG_ICHOR_R15_SHRINE_STAIR)) {
        msgbox(format("A post with the Girdle's knot carved in it. The stair below is open."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A post with the Girdle's knot carved in it. Two plates, two drums.\p"
                  "Roll the drums back where they lay?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        warpsilent(MAP_ROUTE15_MYSTERY_ROAD, 50, 8)
        waitstate
    }
    releaseall
}
