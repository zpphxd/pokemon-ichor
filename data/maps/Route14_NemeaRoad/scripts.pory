script Route14_NemeaRoad_EventScript_Herdsman {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_R14_HERDSMAN_GIFT)) {
        msgbox(format("My sheep graze these hills, and the lion hasn't had one in three generations.\pStill, I carry this when I go near the Tretos. Here, you take it."))
        giveitem(ITEM_LUM_BERRY)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_R14_HERDSMAN_GIFT)
        }
        release
        end
    }
    msgbox(format("Sheep don't fear the dark. Shepherds do."))
    release
}

