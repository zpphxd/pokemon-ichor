// Minos's tomb (design/LABYRINTH.md §8 scene F; SCRIPT.md beat III-3J;
// design/maps/LabyrinthMinosTomb.md), behind Ring V's cracked wall %1.
// Layout and generated block from tools/ichor/maps/labyrinth_tomb.py.

mapscripts LabyrinthMinosTomb_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        call(LabyrinthMinosTomb_EventScript_Register)
        call(LabyrinthMinosTomb_EventScript_DrawState)
        special(Ichor_DrawThread)
    }
}

script LabyrinthMinosTomb_EventScript_Bier {
    lockall
    if (flag(FLAG_ICHOR_GOT_HELM_OF_DARKNESS)) {
        msgbox(format("The judge's bier. A faded purple cloth, and the dent where the cap lay."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A low tomb behind the broken wall."))
    msgbox(format("Painted pillars. Dust older than the palace."))
    msgbox(format("Carved over the bier: MINOS, WHO JUDGES. WHAT IS HIDDEN, HE SEES."))
    msgbox(format("On the bier lies a dark leather cap, plain as a farmer's."))
    msgbox(format("It's cold. Colder than the room."))
    giveitem(ITEM_HELM_OF_DARKNESS)
    setflag(FLAG_ICHOR_GOT_HELM_SCENE)
    call(LabyrinthMinosTomb_EventScript_DrawState)
    special(DrawWholeMapView)
    if (var(VAR_ICHOR_KNOSSA) < 11) {
        setvar(VAR_ICHOR_KNOSSA, 11)
    }
    releaseall
}

