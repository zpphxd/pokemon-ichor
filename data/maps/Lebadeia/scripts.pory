// Lebadeia, between the two springs: beat 35B and the hamlet's roster. Text from
// design/phase3/SCRIPT.md: beat 35B and Part 2 (Lebadeia). Layout and events are
// generated by tools/ichor/maps/parnassos.py.
//
// Staging (map coordinates): the road crosses the gorge on rows 12-13. The
// precinct is at the west end under the oracle's rock: Lethe at (3-4,3-4), the
// stone chair at (6,3) under the bronze grille (6,2, warp 3), Mnemosyne at
// (8-9,3-4) under its spout. Saon stands at (5,3), the priest at (7,4), Alethea
// sits on Mnemosyne's rim at (9,5), the pilgrims sit on the steps (row 6). The
// springs talk fires on the steps; the arrival pan fires on the first frame.
// After beat 35C the trophonios agent's script warps the player onto the chair,
// (6,3), in front of the grille.

mapscripts Lebadeia_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_ICHOR_LEBADEIA_SPRINGS_TALK) || flag(FLAG_ICHOR_HIDE_ALETHEA_LEBADEIA)) {
            setvar(VAR_TEMP_1, 1)
        } else {
            setvar(VAR_TEMP_1, 0)
        }
        if (flag(FLAG_ICHOR_VISITED_LEBADEIA)) {
            setvar(VAR_TEMP_2, 1)
        } else {
            setvar(VAR_TEMP_2, 0)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        call(Lebadeia_EventScript_SetGrille)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_2, 0: Lebadeia_EventScript_Arrival
    ]
}

// The grille: shut (it blocks) until Saon opens it; then the cave's door.
script Lebadeia_EventScript_SetGrille {
    if (flag(FLAG_ICHOR_TROPHONIOS_GRILLE_OPEN)) {
        setmetatile(6, 2, METATILE_Parnassos_GrilleOpen, FALSE)
    } else {
        setmetatile(6, 2, METATILE_Parnassos_Grille, TRUE)
    }
}

text Lebadeia_Text_SpeakerAlethea { "ALETHEA" }
text Lebadeia_Text_SpeakerSaon { "SAON" }
text Lebadeia_Text_SpeakerPriest { "PRIEST" }
text Lebadeia_Text_SpeakerFarmer { "FARMER" }
text Lebadeia_Text_SpeakerSailor { "SAILOR" }
text Lebadeia_Text_SpeakerOldWoman { "OLD WOMAN" }
text Lebadeia_Text_SpeakerPilgrim { "PILGRIM" }
text Lebadeia_Text_SpeakerOldMan { "OLD MAN" }
text Lebadeia_Text_SpeakerCakeSeller { "CAKE-SELLER" }
text Lebadeia_Text_SpeakerChild { "CHILD" }

// --- beat 35B: arrival --------------------------------------------------------------
// The first step into Lebadeia: the fly flag, and a look along the gorge to the
// springs, where Alethea is waiting.
script Lebadeia_EventScript_Arrival {
    lockall
    setflag(FLAG_ICHOR_VISITED_LEBADEIA)
    setvar(VAR_TEMP_2, 1)
    if (!flag(FLAG_ICHOR_HIDE_ALETHEA_LEBADEIA)) {
        special(SpawnCameraObject)
        applymovement(OBJ_EVENT_ID_CAMERA, Lebadeia_Movement_CameraToSprings)
        waitmovement(0)
        applymovement(LOCALID_LEBADEIA_ALETHEA, Lebadeia_Movement_Wave)
        waitmovement(0)
        setspeaker(Lebadeia_Text_SpeakerAlethea)
        msgbox(format("There you are! Did you bring bread?"))
        closemessage
        applymovement(OBJ_EVENT_ID_CAMERA, Lebadeia_Movement_CameraBack)
        waitmovement(0)
        special(RemoveCameraObject)
    }
    releaseall
}

movement Lebadeia_Movement_CameraToSprings {
    walk_fast_left * 20
    walk_fast_up * 6
}

movement Lebadeia_Movement_CameraBack {
    walk_fast_down * 6
    walk_fast_right * 20
}

movement Lebadeia_Movement_Wave {
    face_down
    jump_in_place_down
    jump_in_place_down
}

// --- beat 35B: between the two springs ------------------------------------------------
script Lebadeia_EventScript_SpringsTalk {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    call(Lebadeia_EventScript_AletheaSprings)
    releaseall
}

script Lebadeia_EventScript_AletheaSprings {
    setspeaker(Lebadeia_Text_SpeakerAlethea)
    if (flag(FLAG_ICHOR_READ_ALETHEA_NOTES)) {
        msgbox(format("You read my notes. Good. The eel was a bad day."))
    } else {
        msgbox(format("I left notes. On reeds. Never mind. They were very good notes."))
    }
    msgbox(format("This is Lebadeia. The oracle of Trophonios."))
    msgbox(format("You don't ask him a question. You go down and find out."))
    msgbox(format("Into the earth. On your back. Feet first, through a hole."))
    msgbox(format("Truthfully, it's the least dignified oracle in Aethos."))
    closemessage
    // She turns to the springs.
    applymovement(LOCALID_LEBADEIA_ALETHEA, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(Lebadeia_Text_SpeakerAlethea)
    msgbox(format("First you drink from that one. Lethe. Forgetting."))
    msgbox(format("So you go down empty. Nothing you know gets in the way."))
    applymovement(LOCALID_LEBADEIA_ALETHEA, Common_Movement_FaceUp)
    waitmovement(0)
    msgbox(format("Then that one. Mnemosyne. Memory."))
    msgbox(format("So you remember whatever you find down there."))
    msgbox(format("My name comes from this, you know. A-letheia."))
    msgbox(format("Not-forgetting. That's all truth is, really. Not forgetting."))
    closemessage
    delay(30)
    applymovement(LOCALID_LEBADEIA_ALETHEA, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(Lebadeia_Text_SpeakerAlethea)
    msgbox(format("I'm not drinking from Lethe. Not even a sip."))
    msgbox(format("…Some days I'd like to. Truthfully. Then I'd be wrong about things."))
    msgbox(format("People like you better when you're wrong about things."))
    msgbox(format("Anyway! Look at them."))
    closemessage
    // She nods at the pilgrims on the steps.
    applymovement(LOCALID_LEBADEIA_ALETHEA, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker(Lebadeia_Text_SpeakerAlethea)
    msgbox(format("Every one of them went down this week."))
    msgbox(format("And every one came up saying the same thing."))
    msgbox(format("The priests won't tell me what. Go and ask. They might tell you."))
    closemessage
    setflag(FLAG_ICHOR_LEBADEIA_SPRINGS_TALK)
    setvar(VAR_TEMP_1, 1)
    return
}

script Lebadeia_EventScript_Alethea {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_LEBADEIA_SPRINGS_TALK)) {
        call(Lebadeia_EventScript_AletheaSprings)
        release
        end
    }
    setspeaker(Lebadeia_Text_SpeakerAlethea)
    if (flag(FLAG_ICHOR_TROPHONIOS_READING)) {
        msgbox(format("I'm not going to say anything. Truthfully, I'm writing it down."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("The priests won't tell me what. Go and ask. They might tell you."), MSGBOX_DEFAULT)
    }
    release
}

// --- Saon and the descent -------------------------------------------------------------
script Lebadeia_EventScript_Saon {
    lock
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerSaon)
    if (flag(FLAG_ICHOR_TROPHONIOS_GRILLE_OPEN)) {
        msgbox(format("The grille is open whenever you're ready."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("Everyone who goes down this month comes up with the same words."))
    msgbox(format("Farmers. Sailors. A goat, nearly. It got as far as the hole."))
    msgbox(format("“The cloth runs out.” We don't know what it means."))
    msgbox(format("So we do what priests do. We write it down."))
    msgbox(format("Would you go down? Trophonios will see you. He sees everyone."))
    msgbox(format("Go down into the earth?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        setspeaker(Lebadeia_Text_SpeakerSaon)
        msgbox(format("Wise. Or frightened. From up here those look the same."))
        msgbox(format("The grille is open whenever you're ready."), MSGBOX_DEFAULT)
        release
        end
    }
    setspeaker(Lebadeia_Text_SpeakerSaon)
    msgbox(format("Then drink. Lethe first. Then Mnemosyne."))
    closemessage
    // The two drinks: the player turns to each spring in turn.
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    playse(SE_M_WATERFALL)
    msgbox(format("The water of Lethe is so cold it doesn't taste of anything."))
    closemessage
    waitse
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    playse(SE_M_SURF)
    msgbox(format("The water of Mnemosyne is warm, and it tastes of iron."))
    closemessage
    waitse
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerSaon)
    msgbox(format("Take this. For the snakes below. They prefer it to pilgrims."))
    checkitem(ITEM_HONEY)
    if (var(VAR_RESULT) == FALSE) {
        giveitem(ITEM_HONEY)
    }
    closemessage
    // He unlocks the grille.
    applymovement(LOCALID_LEBADEIA_SAON, Common_Movement_FaceUp)
    waitmovement(0)
    playse(SE_DOOR)
    setflag(FLAG_ICHOR_TROPHONIOS_GRILLE_OPEN)
    call(Lebadeia_EventScript_SetGrille)
    special(DrawWholeMapView)
    waitse
    applymovement(LOCALID_LEBADEIA_SAON, Common_Movement_FaceDown)
    waitmovement(0)
    release
}

script Lebadeia_EventScript_Priest {
    lock
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerPriest)
    msgbox(format("When they come up, we sit them in this chair and ask what they saw."))
    msgbox(format("Then we write it on a tablet and hang it on the wall. Every word."))
    msgbox(format("It's the only oracle where the god doesn't get to edit."), MSGBOX_DEFAULT)
    release
}

// --- the pilgrims on the steps ----------------------------------------------------------
script Lebadeia_EventScript_Farmer {
    lock
    faceplayer
    if (flag(FLAG_ICHOR_AKROPOLIS_RAID)) {
        setspeaker(Lebadeia_Text_SpeakerPilgrim)
        msgbox(format("The cloth runs out. Everyone says it now. Even in Astyra, they say."))
        msgbox(format("The Archon says meet it with dignity. I don't know how you meet cloth."), MSGBOX_DEFAULT)
        release
        end
    }
    setspeaker(Lebadeia_Text_SpeakerFarmer)
    msgbox(format("I went down to ask about the barley."))
    msgbox(format("I came up and said, “The cloth runs out.” I don't know why I said it."), MSGBOX_DEFAULT)
    release
}

script Lebadeia_EventScript_Sailor {
    lock
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerSailor)
    msgbox(format("Asked about a voyage. Came up saying the cloth runs out."))
    msgbox(format("I'm a sailor. I don't even own any cloth."), MSGBOX_DEFAULT)
    release
}

script Lebadeia_EventScript_OldWoman {
    lock
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerOldWoman)
    msgbox(format("The cloth runs out, dear. That's what he told me."))
    msgbox(format("I've been sitting here two days, waiting to understand it."), MSGBOX_DEFAULT)
    release
}

// --- the hamlet's people -------------------------------------------------------------------
script Lebadeia_EventScript_OldMan {
    lock
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerOldMan)
    msgbox(format("I came for an oracle. Forty years ago, I think."))
    msgbox(format("Drank from this one, and forgot what I came for."))
    msgbox(format("I've been very happy. I'm told I have a wife."), MSGBOX_DEFAULT)
    release
}

script Lebadeia_EventScript_CakeSeller {
    lock
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerCakeSeller)
    msgbox(format("Cakes for the snakes! Two for the way down!"))
    msgbox(format("The snakes don't eat them, mind. They just like to be asked."), MSGBOX_DEFAULT)
    release
}

script Lebadeia_EventScript_Child {
    lock
    faceplayer
    setspeaker(Lebadeia_Text_SpeakerChild)
    msgbox(format("The river comes out of the ground because of a goose."))
    msgbox(format("That's true. Herkyna told me. She's got a goose. Well. Sort of."), MSGBOX_DEFAULT)
    release
}

// --- signs and the springs -----------------------------------------------------------------
script Lebadeia_EventScript_SignEast {
    msgbox(format("LEBADEIA\pThe springs of Lethe and Mnemosyne. The oracle of Trophonios."), MSGBOX_SIGN)
}

script Lebadeia_EventScript_SignWest {
    msgbox(format("ROUTE 9 · THE SPLIT ROAD\pWest: the crossroads, Delphoi's cliffs and Kirrha."), MSGBOX_SIGN)
}

script Lebadeia_EventScript_SignSprings {
    msgbox(format("Cut into the rock:\pLETHE, forgetting. MNEMOSYNE, memory. In that order. Not the other way."), MSGBOX_SIGN)
}

script Lebadeia_EventScript_Grille {
    if (flag(FLAG_ICHOR_TROPHONIOS_GRILLE_OPEN)) {
        msgbox(format("Descend by permission of the priests. Feet first.\pThe bronze grille stands open."), MSGBOX_SIGN)
    } else {
        msgbox(format("Descend by permission of the priests. Feet first.\pThe bronze grille is locked."), MSGBOX_SIGN)
    }
}

script Lebadeia_EventScript_Lethe {
    msgbox(format("The spring of Lethe. Black water, so still it shows nothing back."), MSGBOX_SIGN)
}

script Lebadeia_EventScript_Mnemosyne {
    msgbox(format("The spring of Mnemosyne. It runs bright and quick out of the rock."), MSGBOX_SIGN)
}

script Lebadeia_EventScript_Tablets {
    msgbox(format("Little wooden tablets hang from pegs in the rock. Thanks, mostly."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: a daily dig spot under the plane trees by the river (SYSTEMS.md
// section 5). It needs a daily spot index from the world-act2 session; then this
// becomes setvar(VAR_0x8004, <spot>), setvar(VAR_0x8005, ICHOR_DIG_ACT_II),
// goto(EventScript_IchorDigSpot).
script Lebadeia_EventScript_DigSpot {
    msgbox(format("The earth under the planes has been turned. Something might be buried."), MSGBOX_SIGN)
}
