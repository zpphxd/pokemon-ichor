// The Glacier (design/maps/Ascent_Glacier.md): a river of ice under open sky, the Giants
// frozen in it, the frozen lake, and the Gate of the Winds (three drums on three plates).
// Generated by tools/ichor/maps/oros_maps.py: edit the builder, not this file.

mapscripts Ascent_Glacier_MapScripts {
    MAP_SCRIPT_ON_LOAD: Ascent_Glacier_EventScript_DrawState
}

script Ascent_Glacier_EventScript_DrawState {
    if (flag(FLAG_ICHOR_GLACIER_GATE_OPEN)) {
        setmetatile(22, 17, 0x29F, FALSE)
        setmetatile(18, 22, 0x29D, FALSE)
        setmetatile(22, 22, 0x29D, FALSE)
        setmetatile(26, 22, 0x29D, FALSE)
        setobjectxyperm(LOCALID_ASCENT_GLACIER_DRUM0, 18, 22)
        setobjectxyperm(LOCALID_ASCENT_GLACIER_DRUM1, 22, 22)
        setobjectxyperm(LOCALID_ASCENT_GLACIER_DRUM2, 26, 22)
    }
}

// Herakles's floor seal, the master: all three plates must hold a drum.
script Ascent_Glacier_EventScript_Plates {
    if (flag(FLAG_ICHOR_GLACIER_GATE_OPEN)) {
        end
    }
    setvar(VAR_TEMP_9, 0)
    getobjectxy(LOCALID_ASCENT_GLACIER_DRUM0, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 18 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 22 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 26 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_ASCENT_GLACIER_DRUM1, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 18 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 22 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 26 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    getobjectxy(LOCALID_ASCENT_GLACIER_DRUM2, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    if (var(VAR_0x8007) == 18 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 22 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_0x8007) == 26 && var(VAR_0x8008) == 22) {
        addvar(VAR_TEMP_9, 1)
    }
    if (var(VAR_TEMP_9) == 3) {
        lockall
        setflag(FLAG_ICHOR_GLACIER_GATE_OPEN)
        setmetatile(18, 22, 0x29D, FALSE)
        setmetatile(22, 22, 0x29D, FALSE)
        setmetatile(26, 22, 0x29D, FALSE)
        playse(SE_DOOR)
        special(DrawWholeMapView)
        delay(30)
        playse(SE_M_GUST)
        setmetatile(22, 17, 0x29F, FALSE)
        special(DrawWholeMapView)
        msgbox(format("All three plates sink. Wind comes howling down the stair as the bar lifts:\p"
                      "the Gate of the Winds is open."), MSGBOX_DEFAULT)
        releaseall
    }
}

script Ascent_Glacier_EventScript_Lever {
    lockall
    if (flag(FLAG_ICHOR_GLACIER_GATE_OPEN)) {
        msgbox(format("The gate's lever, frozen up. The way is open."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A bronze lever by the gate, the four winds cast on its handle: the seal's reset.\p"
                  "Pull it and set the three drums back where they stood?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        warpsilent(MAP_ASCENT_GLACIER, 22, 29)
        waitstate
    }
    releaseall
}

script Ascent_Glacier_EventScript_Niphon {
    trainerbattle_single(TRAINER_ICHOR_GLACIER_NIPHON,
        format("My flock wandered up onto the ice. I came after them.\pThey're fine. I'm not leaving till you've lost."),
        format("…All right. I'll leave."))
    msgbox(format("Sheep can't read omens either, and look at them. Perfectly happy."), MSGBOX_AUTOCLOSE)
}

script Ascent_Glacier_EventScript_Pholoe {
    trainerbattle_single(TRAINER_ICHOR_GLACIER_PHOLOE,
        format("Two of us at the stair, the way the Spartans stood at the hot gates.\pNobody walks round."),
        format("Round, no. Through, apparently."))
    msgbox(format("The lake above freezes smooth as a mirror. Slide wrong and it puts you right back on the shore."), MSGBOX_AUTOCLOSE)
}

script Ascent_Glacier_EventScript_Shrine {
    msgbox(format("A stele of Hephaestus, thrown down from the mountain. Fragment IV of the Olympian hymn:\p“He fell a whole day and landed lame, and climbed back up on a crutch he forged himself.\pThe Twelve laughed at him once. They stopped when they saw what he made.”"), MSGBOX_SIGN)
}

script Ascent_Glacier_EventScript_Sign {
    msgbox(format("THE GLACIER\nThe giants in the ice are not statues.\pDo not wake them. Do not try."), MSGBOX_SIGN)
}

script Ascent_Glacier_EventScript_Giant {
    msgbox(format("A Giant of the Gigantomachy, frozen in the ice where Zeus's thunderbolt caught him.\pHis hand is still raised. There's frost on his eyelashes."), MSGBOX_SIGN)
}

script Ascent_Glacier_EventScript_Shield {
    msgbox(format("A bronze shield half sunk in the snow, split clean in two. A boar is worked on it.\pAres lost a shield up here once, they say, to a man with a club. He never came back for it."), MSGBOX_SIGN)
}

script Ascent_Glacier_EventScript_Trident {
    msgbox(format("Three straight cuts go deep into this boulder, side by side.\pSomebody lost his temper with the mountain, and he had a trident."), MSGBOX_SIGN)
}

script Ascent_Glacier_EventScript_StormFace {
    lockall
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        msgbox(format("Handholds go straight up the crag into the storm, too far apart for hands.\p"
                      "Since the summit, the thunder up there sounds almost like a voice calling. Not yet."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("A crag goes straight up into the storm, handholds cut into it, too far apart for hands.\p"
                      "Something crackles up there: a flash in the cloud, and thunder that starts before the light."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_Glacier_EventScript_FrozenFall {
    lockall
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        msgbox(format("The frozen waterfall ticks and drips. Water runs behind the ice now.\p"
                      "The ledge above it isn't out of reach for much longer."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("A waterfall frozen solid down the crag. A ledge above it is out of reach.\p"
                      "Climbers say it runs again once the mountain has a new master."), MSGBOX_DEFAULT)
    }
    releaseall
}

script Ascent_Glacier_EventScript_Couloir {
    msgbox(format("A boulder the size of a house blocks a gully into the crag. Beyond it, bronze glints.\pNo ordinary hammer would touch this. It wants a smith's."), MSGBOX_SIGN)
}

script Ascent_Glacier_EventScript_Updraft {
    lockall
    if (!flag(FLAG_ICHOR_GOT_DAEDALUS_WINGS)) {
        msgbox(format("Wind roars straight up out of the cloud here, through a gap in the glacier's edge.\p"
                      "Across it, on a ledge, something has built a nest. Only wings would get you there."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("Wind roars straight up out of the gap, strong enough to lean on.\p"
                  "Spread Daedalus's Wings and ride it across to the ledge?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_FLY)
        fadescreen(FADE_TO_WHITE)
        warpsilent(MAP_ASCENT_GLACIER, 2, 11)
        waitstate
    }
    releaseall
}

script Ascent_Glacier_EventScript_UpdraftBack {
    lockall
    msgbox(format("The updraft howls up the gap. Ride it back across?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_FLY)
        fadescreen(FADE_TO_WHITE)
        warpsilent(MAP_ASCENT_GLACIER, 9, 11)
        waitstate
    }
    releaseall
}

script Ascent_Glacier_EventScript_Crevasse {
    lockall
    if (!flag(FLAG_ICHOR_GOT_ARIADNES_THREAD)) {
        msgbox(format("A crevasse goes down into the glacier, blue and then black.\p"
                      "Gold light glints far below. With a line to tie off, you could climb down."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A crevasse goes down into the glacier, with gold light far below.\p"
                  "Tie off Ariadne's Thread and climb down it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_BIND)
        fadescreen(FADE_TO_BLACK)
        warpsilent(MAP_ASCENT_CRYSTAL_VAULT, 4, 2)
        waitstate
    }
    releaseall
}

script Ascent_Glacier_EventScript_CloudSign {
    msgbox(format("ABOVE: BOREAS'S RIDGE\nWalk on into the white. The Pantheon is above the cloud."), MSGBOX_SIGN)
}
