    trainerbattle_single(TRAINER_ICHOR_R8_THYONE, format("The birds over Kopais all fly west tonight."), format("They were right."))
    msgbox(format("West is Lebadeia. Follow the birds."), MSGBOX_AUTOCLOSE)
