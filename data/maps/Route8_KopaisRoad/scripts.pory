script Route8_KopaisRoad_EventScript_ENCHELYS {
    trainerbattle_single(TRAINER_ICHOR_R8_ENCHELYS, format("Kopais eels! Best in Greece. Hold still, I'm counting the bucket."), format("There goes my count."))
    msgbox(format("The fat ones hide under the dike. The thin ones bite."), MSGBOX_AUTOCLOSE)
    end
}

script Route8_KopaisRoad_EventScript_PANOS {
    trainerbattle_single(TRAINER_ICHOR_R8_PANOS, format("The old kings built this dike. I just stand on it."), format("Worth the walk."))
    msgbox(format("The katavothres drink the lake. The road goes in after it."), MSGBOX_AUTOCLOSE)
    end
}

script Route8_KopaisRoad_EventScript_SCHOINIS {
    trainerbattle_single(TRAINER_ICHOR_R8_SCHOINIS, format("Reeds for roofs, reeds for flutes, reeds for you."), format("Cut short."))
    msgbox(format("Cut a reed, three grow back. Like trainers."), MSGBOX_AUTOCLOSE)
    end
}

script Route8_KopaisRoad_EventScript_AMPELIS {
    trainerbattle_single(TRAINER_ICHOR_R8_AMPELIS, format("The bank is soft. My footing isn't."), format("Sunk."))
    msgbox(format("Sunk."), MSGBOX_AUTOCLOSE)
    end
}

script Route8_KopaisRoad_EventScript_KEPHALOS {
    trainerbattle_single(TRAINER_ICHOR_R8_KEPHALOS, format("I walked the dike to see Gla. You can't get there from here."), format("Not from here, no."))
    msgbox(format("Someone who rides the water could reach the island."), MSGBOX_AUTOCLOSE)
    end
}

script Route8_KopaisRoad_EventScript_MEDA {
    trainerbattle_single(TRAINER_ICHOR_R8_MEDA, format("Out of the dark already? The god's cave is darker."), format("Bright enough."))
    msgbox(format("Lebadeia's temple takes in every traveler. Go and rest."), MSGBOX_AUTOCLOSE)
    end
}

