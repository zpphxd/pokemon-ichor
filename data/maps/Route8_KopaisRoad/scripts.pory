    msgbox(format("Route 8, the Kopais road.\nEast: Thyrsa. West: the dike, and Lebadeia."), MSGBOX_SIGN)
    end
}

script Route8_KopaisRoad_EventScript_WestSign {
    msgbox(format("Route 8, the Kopais road.\nWest: Lebadeia. East: the katavothres and Thyrsa."), MSGBOX_SIGN)
    end
}

script Route8_KopaisRoad_EventScript_Shrine {
    msgbox(format("A wayside altar. Two honey cakes sit on it, untouched.\pTHE ONE WHO GOES DOWN TO TROPHONIOS RETURNS, BUT DOES NOT LAUGH."), MSGBOX_SIGN)
    end
}

script Route8_KopaisRoad_EventScript_Katavothra {
    msgbox(format("A katavothra. Kopais drains into the rock here.\pThe road follows the water through."), MSGBOX_SIGN)
    end
}

script Route8_KopaisRoad_EventScript_Gla {
    msgbox(format("The tower of Gla. Its door is bricked up, and the bricks are newer than the tower."), MSGBOX_SIGN)
    end
}

script Route8_KopaisRoad_EventScript_Fisher {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_R8_FISHER_GIFT)) {
        msgbox(format("Eels, all day. The lake gives and the rock takes.\p"
                      "You fish? Take these. They like the water."))
        giveitem(ITEM_NET_BALL, 3)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_R8_FISHER_GIFT)
        }
        release
        end
    }
    msgbox(format("Cast off the boardwalk. The Kopais eels feed in the reeds."))
    release
}
