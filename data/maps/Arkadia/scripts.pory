// Arkadia, the hunters' town in the cypresses (design/phase3/SCRIPT.md beat 41 and
// Part 2's roster). Layout and events are generated by tools/ichor/maps/arkadia.py.
//
// The map: Route 12's road comes in at the north edge (columns 23-24) between the
// forest gate's two lamp-trees (20,6) and (26,6). The upper terrace holds the
// Asclepeion (door 15,11), the Agora round the great cypress (29,11) and Klymene's
// house at the head of the old racecourse (37,11); its wall runs along row 12 with
// stairs at 15, 23-24, 29 and 33. The square below, with more lamp-trees, Iamos's
// wall, the Cypress Wood's gate (9,17), Hippothoos's hut (11,21) and Nyktimos's hall
// (29,20). The main path runs on south between the temple hill and the waterfall
// to the temple road (row 34); the temple stair is (19-21, 31-33), the precinct gate
// (20,30). Krotos's house (38,29) and pasture are south-east. The east road (rows
// 23-24) is held by the huntresses' cordon, the south road (13-14) by the Lakonian
// hoplite, the west road (rows 36-37) by the Elean guards.
//
// Lamp-trees: every cypress on the main path. Their lamps are row 2 of each tree;
// ON_LOAD lights them in the evening and at night, once the dusk has played.
//
// Klymene's race (rooms3): coord triggers on the temple stair's first step,
// (19-21, 33), run Arkadia_KlymeneHouse_EventScript_RaceTurn on VAR_TEMP_1, which this
// map keeps at 0.
//
// Stubs: ICHOR_STUB_MUSIC (Arkadia's cues aren't composed; the road's day and night
// forms stand in), ICHOR_STUB_OMENS (Iamos), ICHOR_STUB_DIG (the dig spots).

mapscripts Arkadia_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(Arkadia_EventScript_Setup)
    }
    MAP_SCRIPT_ON_LOAD {
        call(Arkadia_EventScript_LightLamps)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: Arkadia_EventScript_OnFrame
    ]
}

text Arkadia_Name_Lamplighter { "LAMPLIGHTER" }
text Arkadia_Name_Huntress { "HUNTRESS" }
text Arkadia_Name_Alethea { "ALETHEA" }
text Arkadia_Name_Iamos { "IAMOS" }
text Arkadia_Name_Kronist { "KRONIST" }
text Arkadia_Name_Hunter { "HUNTER" }
text Arkadia_Name_Child { "CHILD" }
text Arkadia_Name_LostGirl { "LOST GIRL" }
text Arkadia_Name_Hoplite { "HOPLITE" }
text Arkadia_Name_Guard { "GUARD" }

script Arkadia_EventScript_Setup {
    if (flag(FLAG_ICHOR_ARRIVED_ARKADIA)) {
        setflag(FLAG_ICHOR_VISITED_ARKADIA)
        // Alethea waits at the Cypress Wood's gate until beat 42
        setobjectxyperm(LOCALID_ARKADIA_ALETHEA, 10, 18)
        setobjectmovementtype(LOCALID_ARKADIA_ALETHEA, MOVEMENT_TYPE_FACE_LEFT)
    } else {
        // beat 41: the lamplighter and the two huntresses are coming up the road
        setobjectxyperm(LOCALID_ARKADIA_LAMPLIGHTER, 24, 14)
        setobjectmovementtype(LOCALID_ARKADIA_LAMPLIGHTER, MOVEMENT_TYPE_FACE_UP)
        setobjectxyperm(LOCALID_ARKADIA_HUNTRESS_1, 23, 16)
        setobjectmovementtype(LOCALID_ARKADIA_HUNTRESS_1, MOVEMENT_TYPE_FACE_UP)
        setobjectxyperm(LOCALID_ARKADIA_HUNTRESS_2, 24, 17)
        setobjectmovementtype(LOCALID_ARKADIA_HUNTRESS_2, MOVEMENT_TYPE_FACE_UP)
        setobjectmovementtype(LOCALID_ARKADIA_ALETHEA, MOVEMENT_TYPE_FACE_UP)
    }
}

// Every lamp-tree's lamps, lit from dusk to dawn once the town has woken for you.
script Arkadia_EventScript_LightLamps {
    if (!flag(FLAG_ICHOR_ARRIVED_ARKADIA)) {
        end
    }
    gettimeofday
    if (var(VAR_0x8000) == TIME_EVENING || var(VAR_0x8000) == TIME_NIGHT) {
        call(Arkadia_EventScript_LampsGate)
        call(Arkadia_EventScript_LampsTown)
    }
}

script Arkadia_EventScript_LampsGate {
    setmetatile(20, 8, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(21, 8, METATILE_Arkadia_LampLit_R, TRUE)
    setmetatile(26, 8, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(27, 8, METATILE_Arkadia_LampLit_R, TRUE)
}

script Arkadia_EventScript_LampsTown {
    setmetatile(20, 15, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(21, 15, METATILE_Arkadia_LampLit_R, TRUE)
    setmetatile(26, 15, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(27, 15, METATILE_Arkadia_LampLit_R, TRUE)
    setmetatile(13, 16, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(14, 16, METATILE_Arkadia_LampLit_R, TRUE)
    setmetatile(31, 15, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(32, 15, METATILE_Arkadia_LampLit_R, TRUE)
}

script Arkadia_EventScript_OnFrame {
    if (flag(FLAG_ICHOR_ARRIVED_ARKADIA)) {
        setvar(VAR_TEMP_0, 1)
        end
    }
    goto(Arkadia_EventScript_Dusk)
}

// ---------------------------------------------------------------------------
// Beat 41: Arkadia, at dusk
// ---------------------------------------------------------------------------

script Arkadia_EventScript_Dusk {
    lockall
    hidefollower
    setvar(VAR_TEMP_0, 1)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_ICHOR_ARRIVED_ARKADIA)
    setflag(FLAG_ICHOR_VISITED_ARKADIA)
    // Dusk, whatever the clock says (Open questions 1). The hold lasts into the
    // Wood, where beat 42 turns it to night; beat 43 lets it go.
    setvar(VAR_0x8004, TIME_EVENING)
    special(Ichor_HoldTimeOfDay)
    // the player walks in between the gate's lamp-trees
    getplayerxy(VAR_0x8004, VAR_0x8005)
    while (var(VAR_0x8004) < 23) {
        applymovement(OBJ_EVENT_ID_PLAYER, Arkadia_Movement_StepRight)
        waitmovement(0)
        addvar(VAR_0x8004, 1)
    }
    while (var(VAR_0x8004) > 23) {
        applymovement(OBJ_EVENT_ID_PLAYER, Arkadia_Movement_StepLeft)
        waitmovement(0)
        subvar(VAR_0x8004, 1)
    }
    while (var(VAR_0x8005) < 6) {
        applymovement(OBJ_EVENT_ID_PLAYER, Arkadia_Movement_StepDown)
        waitmovement(0)
        addvar(VAR_0x8005, 1)
    }
    // the lamps down in the town are already lit; he's coming up the road
    call(Arkadia_EventScript_LampsTown)
    special(DrawWholeMapView)
    delay(30)
    fadescreen(FADE_FROM_BLACK)
    setspeaker(SP_NAME_NONE)
    msgbox(format("Dusk."))
    closemessage
    delay(20)
    setspeaker(Arkadia_Name_Lamplighter)
    msgbox(format("Lamps up! Lamps up! The Huntress has had her match!"))
    closemessage
    applymovement(LOCALID_ARKADIA_LAMPLIGHTER, Arkadia_Movement_LamplighterUp)
    waitmovement(0)
    // he lights the gate's trees, one and then the other
    applymovement(LOCALID_ARKADIA_LAMPLIGHTER, Common_Movement_FaceRight)
    waitmovement(0)
    delay(16)
    playse(SE_M_SWAGGER2)
    setmetatile(26, 8, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(27, 8, METATILE_Arkadia_LampLit_R, TRUE)
    special(DrawWholeMapView)
    delay(30)
    applymovement(LOCALID_ARKADIA_LAMPLIGHTER, Common_Movement_FaceLeft)
    waitmovement(0)
    delay(16)
    playse(SE_M_SWAGGER2)
    setmetatile(20, 8, METATILE_Arkadia_LampLit_L, TRUE)
    setmetatile(21, 8, METATILE_Arkadia_LampLit_R, TRUE)
    special(DrawWholeMapView)
    delay(20)
    applymovement(LOCALID_ARKADIA_LAMPLIGHTER, Arkadia_Movement_StepAside)
    waitmovement(0)
    // two huntresses come up the road from the temple, talking
    applymovement(LOCALID_ARKADIA_HUNTRESS_1, Arkadia_Movement_HuntressUp1)
    applymovement(LOCALID_ARKADIA_HUNTRESS_2, Arkadia_Movement_HuntressUp2)
    waitmovement(LOCALID_ARKADIA_HUNTRESS_1)
    waitmovement(LOCALID_ARKADIA_HUNTRESS_2)
    applymovement(LOCALID_ARKADIA_HUNTRESS_1, Common_Movement_FaceRight)
    applymovement(LOCALID_ARKADIA_HUNTRESS_2, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("Six to nothing. Did you see it? She never looked at him once."))
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("She looked at the sky the whole time. Like she was waiting for it."))
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("Poor thing. He's fated, you know. Young and glorious."))
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("Then he'll be fine. That's the glorious part, isn't it? Later."))
    closemessage
    // they walk on into town
    applymovement(LOCALID_ARKADIA_HUNTRESS_1, Arkadia_Movement_HuntressAway)
    applymovement(LOCALID_ARKADIA_HUNTRESS_2, Arkadia_Movement_HuntressAway)
    waitmovement(LOCALID_ARKADIA_HUNTRESS_1)
    waitmovement(LOCALID_ARKADIA_HUNTRESS_2)
    setobjectxyperm(LOCALID_ARKADIA_HUNTRESS_1, 16, 15)
    setobjectxyperm(LOCALID_ARKADIA_HUNTRESS_2, 17, 15)
    setobjectmovementtype(LOCALID_ARKADIA_HUNTRESS_1, MOVEMENT_TYPE_FACE_RIGHT)
    setobjectmovementtype(LOCALID_ARKADIA_HUNTRESS_2, MOVEMENT_TYPE_FACE_LEFT)
    setobjectxy(LOCALID_ARKADIA_HUNTRESS_1, 16, 15)
    setobjectxy(LOCALID_ARKADIA_HUNTRESS_2, 17, 15)
    // Alethea turns to the player
    applymovement(LOCALID_ARKADIA_ALETHEA, Common_Movement_FaceUp)
    waitmovement(0)
    setspeaker(Arkadia_Name_Alethea)
    msgbox(format("Kleon. That was Kleon."))
    setspeaker(Arkadia_Name_Alethea)
    msgbox(format("Six to nothing. Truthfully, I didn't know you could lose that much."))
    closemessage
    // the lamplighter reaches the gate's tree and stops beside them
    applymovement(LOCALID_ARKADIA_LAMPLIGHTER, Arkadia_Movement_LamplighterToPlayer)
    waitmovement(0)
    setspeaker(Arkadia_Name_Lamplighter)
    msgbox(format("Looking for the Lakonian? He went into the Cypress Wood."))
    setspeaker(Arkadia_Name_Lamplighter)
    msgbox(format("Straight from the temple. Hasn't come out."))
    setspeaker(Arkadia_Name_Lamplighter)
    msgbox(format("It's the new moon. Nobody goes in the Wood at the new moon."))
    setspeaker(Arkadia_Name_Lamplighter)
    msgbox(format("The wolves go in. That's how we know."))
    setspeaker(Arkadia_Name_Alethea)
    msgbox(format("He won't want company."))
    setspeaker(Arkadia_Name_Alethea)
    msgbox(format("Let's go anyway."))
    closemessage
    // she goes ahead to the Cypress Wood's gate, west of the square
    applymovement(LOCALID_ARKADIA_ALETHEA, Arkadia_Movement_AletheaToWood)
    waitmovement(0)
    setobjectxyperm(LOCALID_ARKADIA_ALETHEA, 10, 18)
    setobjectmovementtype(LOCALID_ARKADIA_ALETHEA, MOVEMENT_TYPE_FACE_LEFT)
    setobjectxy(LOCALID_ARKADIA_ALETHEA, 10, 18)
    setobjectxyperm(LOCALID_ARKADIA_LAMPLIGHTER, 25, 10)
    setobjectmovementtype(LOCALID_ARKADIA_LAMPLIGHTER, MOVEMENT_TYPE_WANDER_UP_AND_DOWN)
    releaseall
}

movement Arkadia_Movement_StepRight { walk_right }
movement Arkadia_Movement_StepLeft { walk_left }
movement Arkadia_Movement_StepDown { walk_down }
movement Arkadia_Movement_LamplighterUp { walk_up * 5 }
movement Arkadia_Movement_StepAside { walk_right face_left }
movement Arkadia_Movement_HuntressUp1 { walk_up * 6 }
movement Arkadia_Movement_HuntressUp2 { walk_up * 7 }
movement Arkadia_Movement_HuntressAway { walk_down * 7 }
movement Arkadia_Movement_LamplighterToPlayer { walk_left walk_up walk_up face_left }
movement Arkadia_Movement_AletheaToWood { walk_right walk_down * 6 }

// ---------------------------------------------------------------------------
// The town's people
// ---------------------------------------------------------------------------

script Arkadia_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Alethea)
    msgbox(format("He won't want company.\pLet's go anyway."))
    release
}

script Arkadia_EventScript_Lamplighter {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Lamplighter)
    msgbox(format("It's the new moon. Nobody goes in the Wood at the new moon.\p"
                  "The wolves go in. That's how we know."))
    release
}

script Arkadia_EventScript_Huntress1 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("Six to nothing. Did you see it? She never looked at him once."))
    release
}

script Arkadia_EventScript_Huntress2 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("Poor thing. He's fated, you know. Young and glorious."))
    release
}

// Until beat 42 the temple's gate is held: Kallisto isn't receiving challengers.
script Arkadia_EventScript_TempleClosed {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("The Huntress isn't receiving challengers tonight.\p"
                  "She's sitting on her rock. Looking at nothing."))
    release
}

script Arkadia_EventScript_Iamos {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Iamos)
    msgbox(format("My mother left me in the violets when I was born. Two snakes fed me honey."))
    setspeaker(Arkadia_Name_Iamos)
    msgbox(format("I don't remember it. But I can read a bird like a letter. Watch."))
    closemessage
    applymovement(LOCALID_ARKADIA_IAMOS, Common_Movement_FaceUp)
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_ARKADIA_IAMOS, Common_Movement_FacePlayer)
    waitmovement(0)
    // ICHOR_STUB_OMENS: the day's draw from Part 4's Arkadian entries isn't built
    // (ENGINE_API §7). Iamos reads one of the three; none has its effect yet.
    random(3)
    setspeaker(Arkadia_Name_Iamos)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("The sleepers are out on Kyllene tonight. Walk softly. They won't wake. They never do."))
        case 1:
            msgbox(format("A great boar was seen on the Huntress's tomb at dusk. Standing guard, or grieving."))
        default:
            msgbox(format("Thunder over Kyllene. The Kerazap will be dancing on the meadow. Mind your hair."))
    }
    setspeaker(Arkadia_Name_Iamos)
    msgbox(format("That's today. Tomorrow's tomorrow. The owls don't do tomorrow."))
    release
}

script Arkadia_EventScript_Kronist {
    lock
    faceplayer
    goto(Arkadia_EventScript_KronistAndHunter)
}

script Arkadia_EventScript_Hunter {
    lock
    faceplayer
    goto(Arkadia_EventScript_KronistAndHunter)
}

script Arkadia_EventScript_KronistAndHunter {
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("Friends! Hunters! What if nothing ever had to end?"))
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("Not you. Not your mother. Not even the deer."))
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("Kronos is coming back. No more cutting. Only the long, golden hour."))
    setspeaker(Arkadia_Name_Hunter)
    msgbox(format("No more deer ending? Then what do I have for supper?"))
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("In the golden age, friend, nobody's hungry."))
    setspeaker(Arkadia_Name_Hunter)
    msgbox(format("That's not an answer. That's a wish with a beard on."))
    release
}

script Arkadia_EventScript_Child1 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Child)
    msgbox(format("I'm a little bear! Like the girls at the temple! Grr!"))
    setspeaker(Arkadia_Name_Child)
    msgbox(format("Kallisto was a girl who turned into a bear. Then she turned into stars."))
    release
}

script Arkadia_EventScript_Child2 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Child)
    msgbox(format("I'm going to be stars. After bears. After my supper."))
    release
}

// A theoxenia decoy (SYSTEMS.md §10): a real girl, with a shadow.
script Arkadia_EventScript_LostGirl {
    lock
    faceplayer
    setspeaker(Arkadia_Name_LostGirl)
    msgbox(format("Do you know the way to the charcoal-burner's? My papa's kiln?"))
    setspeaker(Arkadia_Name_LostGirl)
    message(format("Is it west? Or east? I always forget which one the sun does."))
    waitmessage
    dynmultichoice(15, 4, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, Arkadia_Text_West, Arkadia_Text_East)
    setspeaker(Arkadia_Name_LostGirl)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("West! By the Wood! Thank you! Here, I found this in the moss."))
        giveitem(ITEM_TINY_MUSHROOM, 2)
        if (var(VAR_RESULT) == FALSE) {
            call(Common_EventScript_ShowBagIsFull)
            release
            end
        }
        setvar(VAR_0x8004, ICHOR_GOD_ZEUS)
        setvar(VAR_0x8005, 1)
        special(Ichor_AddFavor)
        closemessage
        applymovement(LOCALID_ARKADIA_LOST_GIRL, Arkadia_Movement_GirlRunsWest)
        waitmovement(0)
        removeobject(LOCALID_ARKADIA_LOST_GIRL)
        setflag(FLAG_ICHOR_THEOXENIA_START + 0x25)
    } else {
        msgbox(format("East? That's the road to the sea. …I'll ask someone with a kiln."))
    }
    release
}

text Arkadia_Text_West { "WEST" }
text Arkadia_Text_East { "EAST" }

movement Arkadia_Movement_GirlRunsWest { walk_fast_left * 5 }

script Arkadia_EventScript_Cordon {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("The Nemea road is closed while the goddess's hind runs.\p"
                  "Nobody passes east until the hunt is done. Finish it, or wait."))
    release
}

script Arkadia_EventScript_Hoplite {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Hoplite)
    msgbox(format("The road to Stymphalia's shut. Lakonia's border. They're keeping the Karneia."))
    setspeaker(Arkadia_Name_Hoplite)
    msgbox(format("No marching, no visitors, no nothing till the moon's full."))
    setspeaker(Arkadia_Name_Hoplite)
    msgbox(format("Lakonians missed a whole war once over the Karneia. They didn't mind."))
    release
}

// The road to Olympia (Route 32) waits for the post-game.
script Arkadia_EventScript_WestGuard {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Guard)
    msgbox(format("The Alpheios is over the road. Nobody walks to Olympia till it's down."))
    release
}

// One of Krotos's kids that didn't run: grazing in the pasture.
script Arkadia_EventScript_Grazer {
    lock
    playmoncry(SPECIES_KERAZAP, CRY_MODE_NORMAL)
    msgbox(format("A Kerazap kid, grazing. It ignores you completely."))
    waitmoncry
    release
}

// Krotos's three lost kids are objects here with rooms3's scripts
// (Arkadia_GoatherdHouse_EventScript_LostKid1-3) and hide flags (FLAG_ICHOR_KROTOS_KID_1-3).

// ---------------------------------------------------------------------------
// Signs, the grotto, the falls, the dig spots
// ---------------------------------------------------------------------------

script Arkadia_EventScript_SignForestGate {
    msgbox(format("ARKADIA\nLamps lit at dusk. Mind the wolves. Mind the goddess."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignAsclepeion {
    msgbox(format("ASCLEPEION. The spring runs through. Step over it."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignTemple {
    msgbox(format("TEMPLE OF ARTEMIS\nHierophant: Kallisto, the Moonlit Huntress."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignWoodGate {
    msgbox(format("THE CYPRESS WOOD. No moon tonight. No moon ever, in there."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignEastRoad {
    msgbox(format("East: Route 13, down out of the highlands to Nemea."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignAlpheios {
    msgbox(format("The Alpheios is in flood. The road to the west coast is under water."), MSGBOX_SIGN)
}

script Arkadia_EventScript_PansGrotto {
    lockall
    msgbox(format("A shallow grotto with a syrinx carved over the mouth. Pan's.\p"
                  "The reeds of the syrinx were a nymph once. She ran from him.\p"
                  "Now she sings for him."))
    closemessage
    playse(SE_M_SCREECH)
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 3)
    setvar(VAR_0x8006, 8)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    waitstate
    msgbox(format("Something rustles inside, and you feel a sudden, total panic. Then it's gone."))
    releaseall
}

script Arkadia_EventScript_Waterfall {
    msgbox(format("The falls drop straight from the cliff. Halfway up, there's a cave mouth.\p"
                  "Something glints in it. You'd have to climb the water itself to reach it."),
           MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: a daily dig spot behind the falls' pool (Part 6). The dig API
// replaces this: setvar(VAR_0x8004, <spot>), setvar(VAR_0x8005, ICHOR_DIG_ACT_II),
// goto(EventScript_IchorDigSpot).
script Arkadia_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: the Rare Bone, a fixed dig by the racecourse's finishing post
// (Part 6). The dig API replaces this with EventScript_IchorDigFixed.
script Arkadia_EventScript_TurnedEarth {
    msgbox(format("The ground by the finishing post has been turned. Something is buried here."),
           MSGBOX_SIGN)
}
