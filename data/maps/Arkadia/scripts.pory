mapscripts Arkadia_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        special(Ichor_ReleaseTimeOfDay)
        setrespawn(HEAL_LOCATION_ARKADIA)
        // the climax: the Measurer at the falls pool in the Frozen Hour (III-10D)
        call(Arkadia_EventScript_ClimaxObjects)
        setflag(FLAG_ICHOR_HIDE_IAPETOS_ARKADIA)
        removeobject(LOCALID_ARKADIA_IAPETOS)
        if (flag(FLAG_ICHOR_KLEON_JOINED_TITANS)) {
            setvar(VAR_TEMP_1, 1)
            removeobject(LOCALID_ARKADIA_KLEON)
        }
    }
}
script Arkadia_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_ARKADIA_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}
script Arkadia_EventScript_Merchant {
    goto(ArkadiaApproach_EventScript_Merchant)
}
script Arkadia_EventScript_Guide {
    lock
    faceplayer
    if (flag(FLAG_BADGE05_GET)) {
        msgbox(format("The east road descends through Nemea to Emporion.\p"
                      "Show the watch your Moon Laurel. They'll open the gate from this side."))
    } else {
        msgbox(format("Kallisto's been hunting the new moon. You won't find a kinder light in her grove.\p"
                      "A young Lakonian came to challenge her. He's down among the cypresses."))
    }
    release
}

script Arkadia_EventScript_NemeaRoad {
    lockall
    if (flag(FLAG_BADGE05_GET)) {
        setflag(FLAG_ICHOR_ARKADIA_NORTH_OPEN)
    } else {
        msgbox(format("Kallisto is waiting in the grove.\p"
                      "The road down to Nemea can wait until you have the Moon Laurel."))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Arkadia_Movement_LeaveNemeaRoad)
        waitmovement(0)
    }
    releaseall
    end
}

movement Arkadia_Movement_LeaveNemeaRoad {
    walk_left
}
script Arkadia_EventScript_Sign {
    msgbox(format("ARKADIA\nUnder the eyes of Artemis."), MSGBOX_SIGN)
    end
}
script Arkadia_EventScript_Kleon {
    lock
    faceplayer
    msgbox(format("Don't. Whatever you're going to say. Don't."))
    release
}
script Arkadia_EventScript_Alethea {
    lock
    faceplayer
    setspeaker(Arkadia_Text_NameAlethea)
    if (flag(FLAG_ICHOR_KLEON_JOINED_TITANS)) {
        msgbox(format("The wax was still soft. He knew. He took it anyway.\p"
                      "Kallisto's grove is ahead. I'm coming with you."))
    } else {
        msgbox(format("Give him a moment. That went very badly."))
    }
    release
}
script Arkadia_EventScript_Iapetos {
    end
}

text Arkadia_Text_NameKleon { "KLEON" }
text Arkadia_Text_NameAlethea { "ALETHEA" }
text Arkadia_Text_NameIapetos { "IAPETOS" }

script Arkadia_EventScript_Recruitment {
    lockall
    if (flag(FLAG_ICHOR_KLEON_JOINED_TITANS)) {
        releaseall
        end
    }
    setvar(VAR_TEMP_1, 1)
    setvar(VAR_0x8004, TIME_NIGHT)
    special(Ichor_HoldTimeOfDay)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    applymovement(LOCALID_ARKADIA_ALETHEA, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("Don't. Whatever you're going to say. Don't.\p"
                  "...She didn't even look at me. Kallisto. The whole match."))
    msgbox(format("She looked at the sky. And she won anyway. Six to nothing.\p"
                  "Six to nothing."))
    msgbox(format("You know what her acolytes said? “Poor thing. He's fated.”\p"
                  "Like it already happened. Like I'm a story they've heard."))
    msgbox(format("“Die young and glorious.” Well. I'm young.\p"
                  "Where's the glorious part? When does that start?"))
    setspeaker(Arkadia_Text_NameAlethea)
    msgbox(format("Kleon, she's beaten everyone this month. She's--"))
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("She beat everyone. She crushed me. There's a difference."))
    playbgm(MUS_ICHOR_TITAN, TRUE)
    setspeaker(SP_NAME_NONE)
    msgbox(format("A twig snaps. A white tragic mask moves between the cypresses.\p"
                  "The fingers of his right hand are stained with ink."))
    clearflag(FLAG_ICHOR_HIDE_IAPETOS_ARKADIA)
    addobject(LOCALID_ARKADIA_IAPETOS)
    applymovement(LOCALID_ARKADIA_IAPETOS, Common_Movement_FaceRight)
    applymovement(LOCALID_ARKADIA_KLEON, Common_Movement_FaceLeft)
    waitmovement(0)
    msgbox(format("Six to nothing. I watched. It was very hard to watch."))
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("Who are you?"))
    setspeaker(Arkadia_Text_NameIapetos)
    msgbox(format("A writer, of a sort. I write down what people are.\p"
                  "The Titans call me Iapetos. You can call me whatever helps."))
    setspeaker(Arkadia_Text_NameAlethea)
    msgbox(format("{PLAYER}. That's a Titan."))
    setspeaker(Arkadia_Text_NameIapetos)
    msgbox(format("And you're Daphne's girl. The one who digs. Hello.\p"
                  "Kleon. May I tell you something true?"))
    msgbox(format("The thread they read you was a poor one. Badly made.\p"
                  "“Young and glorious,” and nothing after. No deed. No place."))
    msgbox(format("That's not a fate. That's a shrug.\p"
                  "Kallisto's fate is better written. That's why she won."))
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("...What's that supposed to mean?"))
    setspeaker(Arkadia_Text_NameIapetos)
    msgbox(format("It means threads can be read again. Better. By someone careful.\p"
                  "Here's a better thread."))
    msgbox(format("“Kleon of Lakonia shall slay the starry bull beneath the house of the double axe,\p"
                  "and his glory shall never die.”"))
    delay(60)
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("Never die."))
    setspeaker(Arkadia_Text_NameIapetos)
    msgbox(format("Never."))
    setspeaker(Arkadia_Text_NameAlethea)
    msgbox(format("That's forged. Kleon, look at the wax. It's soft. He wrote it tonight.\p"
                  "Threads are read at Delphoi. Not by men in masks in the woods."))
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("And what did Delphoi read for me? “Die young.” Thanks, Delphoi."))
    setspeaker(Arkadia_Text_NameAlethea)
    msgbox(format("I'm telling you the truth."))
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("Everybody's telling me the truth! I'd like a better one!"))
    delay(45)
    applymovement(LOCALID_ARKADIA_KLEON, Common_Movement_FaceDown)
    waitmovement(0)
    msgbox(format("Everyone's got a story about you. Even the Titans. They wrote you a play.\p"
                  "I just want one that's mine."))
    setspeaker(SP_NAME_NONE)
    msgbox(format("Kleon takes the tablet."))
    setspeaker(Arkadia_Text_NameIapetos)
    msgbox(format("There. That wasn't hard. May your thread never be cut."))
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("...Nor yours?"))
    setspeaker(Arkadia_Text_NameIapetos)
    msgbox(format("Good. You'll pick it up."))
    applymovement(LOCALID_ARKADIA_IAPETOS, Arkadia_Movement_IntoCypresses)
    waitmovement(0)
    setflag(FLAG_ICHOR_HIDE_IAPETOS_ARKADIA)
    removeobject(LOCALID_ARKADIA_IAPETOS)
    setspeaker(Arkadia_Text_NameKleon)
    msgbox(format("Don't follow me. I mean it this time.\p"
                  "Next time we fight, it's written that I win."))
    applymovement(LOCALID_ARKADIA_KLEON, Arkadia_Movement_KleonLeaves)
    waitmovement(0)
    setflag(FLAG_ICHOR_KLEON_JOINED_TITANS)
    removeobject(LOCALID_ARKADIA_KLEON)
    setspeaker(Arkadia_Text_NameAlethea)
    msgbox(format("...He didn't believe me.\p"
                  "People don't. I'm used to it.\pTruthfully, I'm not."))
    setspeaker(SP_NAME_NONE)
    fadedefaultbgm
    special(Ichor_ReleaseTimeOfDay)
    releaseall
}

movement Arkadia_Movement_IntoCypresses { walk_up walk_up walk_up }
movement Arkadia_Movement_KleonLeaves { walk_up walk_left walk_left walk_up walk_up }

// ---------------------------------------------------------------------------
// The town's people, signs, grotto and falls, ported from claude/world-act2-0a92e7
// ---------------------------------------------------------------------------

text Arkadia_Name_Lamplighter { "LAMPLIGHTER" }

text Arkadia_Name_Huntress { "HUNTRESS" }

text Arkadia_Name_Iamos { "IAMOS" }

text Arkadia_Name_Kronist { "KRONIST" }

text Arkadia_Name_Hunter { "HUNTER" }

text Arkadia_Name_Child { "CHILD" }

text Arkadia_Name_Hoplite { "HOPLITE" }

script Arkadia_EventScript_Lamplighter {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Lamplighter)
    msgbox(format("It's the new moon. Nobody goes in the Wood at the new moon.\p"
                  "The wolves go in. That's how we know."))
    release
}

script Arkadia_EventScript_Huntress1 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("Six to nothing. Did you see it? She never looked at him once."))
    release
}

script Arkadia_EventScript_Huntress2 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Huntress)
    msgbox(format("Poor thing. He's fated, you know. Young and glorious."))
    release
}

script Arkadia_EventScript_Iamos {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Iamos)
    msgbox(format("My mother left me in the violets when I was born. Two snakes fed me honey."))
    setspeaker(Arkadia_Name_Iamos)
    msgbox(format("I don't remember it. But I can read a bird like a letter. Watch."))
    closemessage
    applymovement(LOCALID_ARKADIA_IAMOS, Common_Movement_FaceUp)
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_ARKADIA_IAMOS, Common_Movement_FacePlayer)
    waitmovement(0)
    // ICHOR_STUB_OMENS: the day's draw from Part 4's Arkadian entries isn't built
    // (ENGINE_API §7). Iamos reads one of the three; none has its effect yet.
    random(3)
    setspeaker(Arkadia_Name_Iamos)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("The sleepers are out on Kyllene tonight. Walk softly. They won't wake. They never do."))
        case 1:
            msgbox(format("A great boar was seen on the Huntress's tomb at dusk. Standing guard, or grieving."))
        default:
            msgbox(format("Thunder over Kyllene. The Kerazap will be dancing on the meadow. Mind your hair."))
    }
    setspeaker(Arkadia_Name_Iamos)
    msgbox(format("That's today. Tomorrow's tomorrow. The owls don't do tomorrow."))
    release
}

script Arkadia_EventScript_Kronist {
    lock
    faceplayer
    goto(Arkadia_EventScript_KronistAndHunter)
}

script Arkadia_EventScript_Hunter {
    lock
    faceplayer
    goto(Arkadia_EventScript_KronistAndHunter)
}

script Arkadia_EventScript_KronistAndHunter {
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("Friends! Hunters! What if nothing ever had to end?"))
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("Not you. Not your mother. Not even the deer."))
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("Kronos is coming back. No more cutting. Only the long, golden hour."))
    setspeaker(Arkadia_Name_Hunter)
    msgbox(format("No more deer ending? Then what do I have for supper?"))
    setspeaker(Arkadia_Name_Kronist)
    msgbox(format("In the golden age, friend, nobody's hungry."))
    setspeaker(Arkadia_Name_Hunter)
    msgbox(format("That's not an answer. That's a wish with a beard on."))
    release
}

script Arkadia_EventScript_Child1 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Child)
    msgbox(format("I'm a little bear! Like the girls at the temple! Grr!"))
    setspeaker(Arkadia_Name_Child)
    msgbox(format("Kallisto was a girl who turned into a bear. Then she turned into stars."))
    release
}

script Arkadia_EventScript_Child2 {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Child)
    msgbox(format("I'm going to be stars. After bears. After my supper."))
    release
}

script Arkadia_EventScript_Hoplite {
    lock
    faceplayer
    setspeaker(Arkadia_Name_Hoplite)
    msgbox(format("The road to Stymphalia's shut. Lakonia's border. They're keeping the Karneia."))
    setspeaker(Arkadia_Name_Hoplite)
    msgbox(format("No marching, no visitors, no nothing till the moon's full."))
    setspeaker(Arkadia_Name_Hoplite)
    msgbox(format("Lakonians missed a whole war once over the Karneia. They didn't mind."))
    release
}

// One of Krotos's kids that didn't run: grazing in the pasture.
script Arkadia_EventScript_Grazer {
    lock
    playmoncry(SPECIES_KERAZAP, CRY_MODE_NORMAL)
    msgbox(format("A Kerazap kid, grazing. It ignores you completely."))
    waitmoncry
    release
}

script Arkadia_EventScript_SignAsclepeion {
    msgbox(format("ASCLEPEION. The spring runs through. Step over it."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignTemple {
    msgbox(format("TEMPLE OF ARTEMIS\nHierophant: Kallisto, the Moonlit Huntress."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignWoodGate {
    msgbox(format("THE CYPRESS WOOD. No moon tonight. No moon ever, in there."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignEastRoad {
    msgbox(format("East: Route 13, down out of the highlands to Nemea."), MSGBOX_SIGN)
}

script Arkadia_EventScript_SignAlpheios {
    msgbox(format("The Alpheios is in flood. The road to the west coast is under water."), MSGBOX_SIGN)
}

// "Noon in Arkadia" (WORLD_EXPLORATION §2): after Laurel 5 Pan is asleep in here,
// his goats panicked onto the crag. New reeds from the falls pool make a pipe;
// piping wakes him, and he gives Pan's Crook. The crag's face is the first climb.
script Arkadia_EventScript_PansGrotto {
    lockall
    if (flag(FLAG_ICHOR_NOON_PAN_WOKEN)) {
        msgbox(format("A hoof print in the dust at the mouth, fresh.\p"
                      "Somewhere inside, someone is pretending to be asleep."))
        releaseall
        end
    }
    if (!flag(FLAG_BADGE05_GET)) {
        msgbox(format("A shallow grotto with a syrinx carved over the mouth. Pan's.\p"
                      "The reeds of the syrinx were a nymph once. She ran from him.\p"
                      "Now she sings for him."))
        closemessage
        call(Arkadia_EventScript_Panic)
        msgbox(format("Something rustles inside, and you feel a sudden, total panic. Then it's gone."))
        releaseall
        end
    }
    msgbox(format("Behind a curtain of dead reeds, something snores. Deep, slow, goatish.\p"
                  "The syrinx carved over the mouth is cracked through."))
    if (!flag(FLAG_ICHOR_NOON_REEDS)) {
        msgbox(format("Shepherds pipe to wake a god. Nobody dares at noon.\p"
                      "Fresh reeds would make a new pipe. Reeds grow by the falls pool."))
        releaseall
        end
    }
    msgbox(format("Pipe the new reeds at the grotto mouth?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        closemessage
        releaseall
        end
    }
    closemessage
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    call(Arkadia_EventScript_Panic)
    msgbox(format("The snoring stops. Then the whole hillside screams.\p"
                  "A boar bursts out of the reeds in a blind panic!"))
    closemessage
    setwildbattle(SPECIES_KAPRODON, 36)
    playmoncry(SPECIES_KAPRODON, CRY_MODE_ENCOUNTER)
    waitmoncry
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    lockall
    setflag(FLAG_ICHOR_NOON_PAN_WOKEN)
    msgbox(format("VOICE: Who pipes at noon?"))
    msgbox(format("VOICE: …Not badly. Not badly at all."))
    msgbox(format("VOICE: My goats are on the cliff. Fetch them down. Here. Goats don't fall."))
    giveitem(ITEM_PANS_CROOK)
    msgbox(format("A hoof print in the dust where the voice was. Nothing else."))
    msgbox(format("Handholds are cut up the crag beside the grotto.\p"
                  "Face them and climb with Pan's Crook, up or down."))
    releaseall
}

script Arkadia_EventScript_Panic {
    playse(SE_M_SCREECH)
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 3)
    setvar(VAR_0x8006, 8)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    waitstate
    return
}

// The reed bed where the falls run off toward the Ladon: Syrinx's reeds.
script Arkadia_EventScript_LadonReeds {
    lockall
    if (!flag(FLAG_BADGE05_GET)) {
        msgbox(format("Tall reeds where the falls run off toward the Ladon. They hiss in the wind."))
        releaseall
        end
    }
    setvar(VAR_0x8004, ITEM_DEMETERS_SICKLE)
    setvar(VAR_0x8005, 0)
    specialvar(VAR_RESULT, Ichor_CanUseRelic)
    if (var(VAR_RESULT) != ICHOR_RELIC_OK) {
        msgbox(format("Tall reeds, green and hollow. A good blade would cut a few."))
        releaseall
        end
    }
    msgbox(format("Tall reeds, green and hollow. The kind a pipe is made from.\p"
                  "Cut some with Demeter's Sickle?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        closemessage
        releaseall
        end
    }
    closemessage
    setvar(VAR_0x8004, ITEM_DEMETERS_SICKLE)
    call(EventScript_IchorRelicPose)
    playse(SE_M_CUT)
    removeobject(LOCALID_ARKADIA_LADON_REEDS)
    setflag(FLAG_ICHOR_NOON_REEDS)
    msgbox(format("{PLAYER} cut three fresh reeds, the length of a pipe."))
    releaseall
}

// Krotos's kid, stuck on the crag since the panic.
script Arkadia_EventScript_CragKid {
    lock
    faceplayer
    playmoncry(SPECIES_KERAZAP, CRY_MODE_NORMAL)
    msgbox(format("A Kerazap kid, stuck on the ledge, trembling. It sees the crook and bleats.\p"
                  "It skips down the handholds after you and runs for home."))
    waitmoncry
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_ARKADIA_CRAG_KID)
    setflag(FLAG_ICHOR_NOON_KID_FETCHED)
    fadescreen(FADE_FROM_BLACK)
    release
}

script Arkadia_EventScript_Waterfall {
    msgbox(format("The falls drop straight from the cliff. Halfway up, there's a cave mouth.\p"
                  "Something glints in it. You'd have to climb the water itself to reach it."),
           MSGBOX_SIGN)
}
