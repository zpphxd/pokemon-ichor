// Olympus_SeatOfAres: Brasidas's seat in the Pantheon (design/LEAGUE.md).
// Generated by tools/ichor/maps/league_seats.py: edit the generator, not this file.

mapscripts Olympus_SeatOfAres_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_BEAT_BRASIDAS)) {
            call(Olympus_SeatOfAres_EventScript_SetOpen)
        }
        if (var(VAR_ELITE_4_STATE) == 1 || var(VAR_ELITE_4_STATE) == 2) {
            call(Olympus_SeatOfAres_EventScript_SetClosed)
        }
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0: Olympus_SeatOfAres_EventScript_FaceNorth
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ELITE_4_STATE, 0: Olympus_SeatOfAres_EventScript_WalkIn
    ]
}

script Olympus_SeatOfAres_EventScript_FaceNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script Olympus_SeatOfAres_EventScript_WalkIn {
    lockall
    call(Ichor_League_EventScript_WalkIn)
    call(Olympus_SeatOfAres_EventScript_SetClosed)
    special(DrawWholeMapView)
    setvar(VAR_ELITE_4_STATE, 1)
    releaseall
}

script Olympus_SeatOfAres_EventScript_SetClosed {
    setmetatile(9, 19, 0x200, TRUE)
    setmetatile(10, 19, 0x200, TRUE)
    return
}

script Olympus_SeatOfAres_EventScript_SetOpen {
    setmetatile(9, 2, 0x21C, FALSE)
    return
}

text Olympus_SeatOfAres_Text_Defeat { "Well. That was well." }

script Olympus_SeatOfAres_EventScript_Brasidas {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameBrasidas)
    if (flag(FLAG_ICHOR_BEAT_BRASIDAS)) {
        msgbox(format("Go on. The admiral's next. Don't let him talk you into anything.\pIf you see Kleon, tell him the polemarch said: well."))
        release
        end
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    msgbox(format("Lakonians never asked how long. Only how well.\pI've held Ares's seat for twenty winters. Kleon wrote to me once. He was nine. He asked how to be glorious.\pI wrote back: stand where you're put, and don't look at the end of the line.\pShow me well."))
    trainerbattle_no_intro(TRAINER_ICHOR_BRASIDAS, Olympus_SeatOfAres_Text_Defeat)
    setflag(FLAG_ICHOR_BEAT_BRASIDAS)
    setvar(VAR_ELITE_4_STATE, 2)
    call(Olympus_SeatOfAres_EventScript_SetOpen)
    call(Ichor_League_EventScript_DoorOpened)
    setspeaker(Ichor_League_Text_NameBrasidas)
    msgbox(format("Go on. The admiral's next. Don't let him talk you into anything.\pIf you see Kleon, tell him the polemarch said: well."))
    release
}
