    setmetatile(7, 22, 0x281, TRUE)
    setmetatile(7, 23, 0x289, TRUE)
    setmetatile(11, 22, 0x281, TRUE)
    setmetatile(11, 23, 0x289, TRUE)
    return
}

text Olympus_SeatOfAres_Text_Defeat { "Well. That was well." }

script Olympus_SeatOfAres_EventScript_Brasidas {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameBrasidas)
    if (flag(FLAG_ICHOR_BEAT_BRASIDAS)) {
        msgbox(format("Go on. The admiral's next. Don't let him talk you into anything.\pIf you see Kleon, tell him the polemarch said: well."))
        release
        end
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    setspeaker(SP_NAME_NONE)
    msgbox(format("Brasidas raises his spear. Fire catches in the braziers at his side."), MSGBOX_DEFAULT)
    closemessage
    setmetatile(5, 3, 0x266, TRUE)
    setmetatile(6, 3, 0x267, TRUE)
    setmetatile(5, 4, 0x26E, TRUE)
    setmetatile(6, 4, 0x26F, TRUE)
    setmetatile(12, 3, 0x266, TRUE)
    setmetatile(13, 3, 0x267, TRUE)
    setmetatile(12, 4, 0x26E, TRUE)
    setmetatile(13, 4, 0x26F, TRUE)
    setmetatile(7, 22, 0x281, TRUE)
    setmetatile(7, 23, 0x289, TRUE)
    setmetatile(11, 22, 0x281, TRUE)
    setmetatile(11, 23, 0x289, TRUE)
    special(DrawWholeMapView)
    playse(SE_M_FLAMETHROWER)
    delay(20)
    playse(SE_M_STRENGTH)
    setvar(VAR_0x8004, 0)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, 3)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    waitstate
    delay(10)
    playse(SE_M_STRENGTH)
    setvar(VAR_0x8004, 0)
    setvar(VAR_0x8005, 2)
    setvar(VAR_0x8006, 3)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    waitstate
    delay(10)
    playse(SE_M_STRENGTH)
    setvar(VAR_0x8004, 0)
    setvar(VAR_0x8005, 3)
    setvar(VAR_0x8006, 4)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    waitstate
    msgbox(format("Spear on shield, three times, from every rack in the hall: the Lakonian salute."), MSGBOX_DEFAULT)
    closemessage
    setspeaker(Ichor_League_Text_NameBrasidas)
    msgbox(format("Lakonians never asked how long. Only how well.\pI've held Ares's seat for twenty winters. Kleon wrote to me once. He was nine. He asked how to be glorious.\pI wrote back: stand where you're put, and don't look at the end of the line.\pShow me well."))
    trainerbattle_no_intro(TRAINER_ICHOR_BRASIDAS, Olympus_SeatOfAres_Text_Defeat)
    setflag(FLAG_ICHOR_BEAT_BRASIDAS)
    setvar(VAR_ELITE_4_STATE, 2)
    call(Olympus_SeatOfAres_EventScript_SetOpen)
    call(Ichor_League_EventScript_DoorOpened)
    setspeaker(Ichor_League_Text_NameBrasidas)
    msgbox(format("Go on. The admiral's next. Don't let him talk you into anything.\pIf you see Kleon, tell him the polemarch said: well."))
    release
}
