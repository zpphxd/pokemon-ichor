text LabyrinthRing5_Text_NameKleon { "KLEON" }

script LabyrinthRing5_EventScript_OnLoadExtra {
    if (flag(FLAG_ICHOR_RING5_DOOR_BACK)) {
        setmetatile(53, 33, METATILE_Mychos_CaveFloor, FALSE)
    }
    if (!flag(FLAG_ICHOR_ASTERION_FREED)) {
        setvar(VAR_0x8004, LOCALID_RING5_ASTERION)
        setvar(VAR_0x8005, 0)
        special(Ichor_StartAsterion)
    }
}

// ---------------------------------------------------------------------------
// Asterion
// ---------------------------------------------------------------------------

script LabyrinthRing5_EventScript_Asterion {
    lock
    msgbox(format("The bull doesn't look at you. His breath smokes in the cold.\p"
                  "A bronze collar is riveted round his neck. The skin under it is raw."))
    release
}

// ---------------------------------------------------------------------------
// Scene E: pool 1, Kleon (LABYRINTH §8 Scene E)
// ---------------------------------------------------------------------------

script LabyrinthRing5_EventScript_SceneE {
    lockall
    removeobject(LOCALID_RING5_ASTERION)
    clearflag(FLAG_ICHOR_HIDE_KLEON_RING5)
    addobject(LOCALID_RING5_KLEON)
    addobject(LOCALID_RING5_BULL)
    playse(SE_BANG)
    msgbox(format("A clatter of bronze, somewhere below."))
    applymovement(LOCALID_RING5_KLEON, LabyrinthRing5_Movement_KleonSprints)
    waitmovement(LOCALID_RING5_KLEON)
    setspeaker(LabyrinthRing5_Text_NameKleon)
    msgbox(format("THERE you are, beast! Kleon of Lakonia! Face your-"))
    setspeaker(SP_NAME_NONE)
    playse(SE_M_TAKE_DOWN)
    applymovement(LOCALID_RING5_BULL, LabyrinthRing5_Movement_BullCharges)
    waitmovement(LOCALID_RING5_BULL)
    playse(SE_M_HEADBUTT)
    applymovement(LOCALID_RING5_KLEON, LabyrinthRing5_Movement_KleonFlung)
    waitmovement(LOCALID_RING5_KLEON)
    delay(30)
    applymovement(LOCALID_RING5_BULL, LabyrinthRing5_Movement_BullWalksOn)
    waitmovement(LOCALID_RING5_BULL)
    removeobject(LOCALID_RING5_BULL)
    delay(40)
    applymovement(LOCALID_RING5_KLEON, LabyrinthRing5_Movement_KleonComesUp)
    waitmovement(LOCALID_RING5_KLEON)
    setspeaker(LabyrinthRing5_Text_NameKleon)
    msgbox(format("…"))
    msgbox(format("Don't. Say. Anything."))
    msgbox(format("That was a tactical fall. Lakonians fall tactically."))
    msgbox(format("The prophecy says I slay the starry bull. It doesn't say first try."))
    msgbox(format("…Why are you sneaking? Heroes don't sneak."))
    msgbox(format("Fine. Sneak. I'll be the one they write songs about."))
    setspeaker(SP_NAME_NONE)
    applymovement(LOCALID_RING5_KLEON, LabyrinthRing5_Movement_KleonLimpsOff)
    waitmovement(LOCALID_RING5_KLEON)
    removeobject(LOCALID_RING5_KLEON)
    setflag(FLAG_ICHOR_HIDE_KLEON_RING5)
    setflag(FLAG_ICHOR_KLEON_HUMBLED)
    setvar(VAR_ICHOR_KNOSSA, 10)
    addobject(LOCALID_RING5_ASTERION)
    setvar(VAR_0x8004, LOCALID_RING5_ASTERION)
    setvar(VAR_0x8005, 0)
    special(Ichor_StartAsterion)
    releaseall
}

movement LabyrinthRing5_Movement_KleonSprints {
    walk_fast_right
    walk_fast_up * 4
    walk_fast_right * 3
    face_right
}

movement LabyrinthRing5_Movement_BullCharges {
    emote_exclamation_mark
    walk_faster_left * 6
}

movement LabyrinthRing5_Movement_KleonFlung {
    lock_facing_direction
    jump_2_left
    unlock_facing_direction
    face_right
}

movement LabyrinthRing5_Movement_BullWalksOn {
    face_right
    delay_16
    walk_right * 6
}

movement LabyrinthRing5_Movement_KleonComesUp {
    walk_left
    walk_up * 4
    face_up
}

movement LabyrinthRing5_Movement_KleonLimpsOff {
    walk_slow_down * 4
    walk_slow_down * 4
    walk_slow_left
}

// ---------------------------------------------------------------------------
// The south stair (VAR_ICHOR_KNOSSA 12: Ring V's south stair, SCRIPT.md Part 8)
// ---------------------------------------------------------------------------

script LabyrinthRing5_EventScript_SouthStair {
    if (var(VAR_ICHOR_KNOSSA) >= 10 && var(VAR_ICHOR_KNOSSA) < 12) {
        setvar(VAR_ICHOR_KNOSSA, 12)
    }
}

// ---------------------------------------------------------------------------
// Things to read and use
// ---------------------------------------------------------------------------

script LabyrinthRing5_EventScript_Notice {
    msgbox(format("A Titan notice, nailed to the grate:\p"
                  "TO ALL RANKS. Do not go down. Do not throw things at it.\n"
                  "Do not “have a look”. -H."), MSGBOX_SIGN)
}

script LabyrinthRing5_EventScript_Fresco {
    msgbox(format("Dancers on a blue ground, three of them, each holding a painted sign.\p"
                  "A rosette. A wave. A lily.\p"
                  "Their feet are caught mid-step, as if the next one matters."), MSGBOX_SIGN)
}

script LabyrinthRing5_EventScript_Spill {
    msgbox(format("The lake spills over a lip of rock into the dark.\p"
                  "Far below, water thunders on something hot."), MSGBOX_SIGN)
}

script LabyrinthRing5_EventScript_Bell {
    lock
    if (flag(FLAG_ICHOR_ASTERION_FREED)) {
        msgbox(format("A bronze bell on a yoke. Nobody in this ring needs it any more."))
        release
        end
    }
    msgbox(format("A bronze bell on a yoke, green with age.\nRing it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        release
        end
    }
    playse(SE_M_HEAL_BELL)
    waitse
    setvar(VAR_0x8004, 30)
    special(Ichor_AsterionRest)
    if (!flag(FLAG_ICHOR_RING5_BELL_RUNG)) {
        setflag(FLAG_ICHOR_RING5_BELL_RUNG)
        msgbox(format("The note runs round the lake and comes back softer.\p"
                      "Far off, the hooves slow. Something heavy settles to the floor."))
    } else {
        msgbox(format("The bell's note runs round the lake. The hooves stop."))
    }
    release
}

script LabyrinthRing5_EventScript_Grate {
    lock
    if (flag(FLAG_ICHOR_RING5_DOOR_BACK)) {
        msgbox(format("The bronze grate stands open. The way north runs back to the gallery."))
        release
        end
    }
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    if (var(VAR_TEMP_3) > 33) {
        msgbox(format("A bronze grate, barred on this side.\pYou lift the bar."))
        playse(SE_UNLOCK)
        setmetatile(53, 33, METATILE_Mychos_CaveFloor, FALSE)
        special(DrawWholeMapView)
        setflag(FLAG_ICHOR_RING5_DOOR_BACK)
        msgbox(format("The way back to the gallery is short now."))
    } else {
        msgbox(format("A bronze grate. It's barred from the other side."))
    }
    release
}
