mapscripts Route9_KorykianCave_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        call(Route9_KorykianCave_EventScript_Draw)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_9, 0: Route9_KorykianCave_EventScript_Redraw
    ]
}

// Generated by tools/ichor/maps/gulf.py; edit the builder, not this file.

// The hall's brazier and the burnt webs, drawn before the map shows.
script Route9_KorykianCave_EventScript_Draw {
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x2C)) {
        call(Route9_KorykianCave_EventScript_DrawBrazier)
    }
    if (flag(FLAG_ICHOR_KORYKIAN_WEB_BURNT)) {
        setmetatile(5, 16, 0x2FF, FALSE)
        setmetatile(5, 17, 0x307, FALSE)
    }
    if (flag(FLAG_ICHOR_KORYKIAN_THORNWEB_BURNT)) {
        setmetatile(17, 4, 0x2FF, FALSE)
        setmetatile(17, 5, 0x307, FALSE)
    }
    return
}

script Route9_KorykianCave_EventScript_DrawBrazier {
    setmetatile(21, 6, 0x2FA, TRUE)
    setmetatile(22, 6, 0x2FB, TRUE)
    setmetatile(21, 7, 0x302, TRUE)
    setmetatile(22, 7, 0x303, TRUE)
    return
}

script Route9_KorykianCave_EventScript_Redraw {
    setvar(VAR_TEMP_9, 1)
    call(Route9_KorykianCave_EventScript_Draw)
    special(DrawWholeMapView)
    end
}

script Route9_KorykianCave_EventScript_Web {
    setvar(VAR_TEMP_9, 0)
    goto(EventScript_IchorCobweb)
}

script Route9_KorykianCave_EventScript_Thornweb {
    setvar(VAR_TEMP_9, 0)
    goto(EventScript_IchorThornweb)
}

// Pan's brazier lights the whole cave beyond the mouth's daylight (ENGINE_API.md §2).
script Route9_KorykianCave_EventScript_Brazier {
    setvar(VAR_0x8004, FLAG_ICHOR_BRAZIERS_START + 0x2C)
    setvar(VAR_0x8005, TRUE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        call(Route9_KorykianCave_EventScript_DrawBrazier)
        special(DrawWholeMapView)
        msgbox(format("The brazier roars up. Stone teeth crowd the dark, all the way to the pool."))
    }
    releaseall
}

script Route9_KorykianCave_EventScript_EnterHall {
    lockall
    setvar(VAR_0x8004, FLAG_ICHOR_BRAZIERS_START + 0x2C)
    call(EventScript_IchorEnterLitZone)
    releaseall
    end
}

script Route9_KorykianCave_EventScript_LeaveHall {
    lockall
    call(EventScript_IchorLeaveLitZone)
    releaseall
    end
}

script Route9_KorykianCave_EventScript_Niche {
    lock
    if (!flag(FLAG_ICHOR_KIRRHA_BEE_FOUND) && flag(FLAG_ICHOR_KIRRHA_BEE_ASKED)) {
        msgbox(format("Pan's niche: pipes of reed, knucklebones, a clay goat.\p"
                      "Among them, a little gold bee on a broken thread."))
        setflag(FLAG_ICHOR_KIRRHA_BEE_FOUND)
        msgbox(format("You take the bee for Hesychia."))
        release
        end
    }
    msgbox(format("Pan's niche: pipes of reed, knucklebones, a clay goat.\p"
                  "The knucklebones are loaded. Pan doesn't lose."))
    release
}

script Route9_KorykianCave_EventScript_Altar {
    msgbox(format("A rough altar. Honey and milk, long dried, for the nymphs."), MSGBOX_SIGN)
    end
}

script Route9_KorykianCave_EventScript_Stele {
    msgbox(format("THE KORYKIAN CAVE\nSacred to Pan and the nymphs. Leave what you find."), MSGBOX_SIGN)
    end
}

script Route9_KorykianCave_EventScript_TITYROS {
    trainerbattle_single(TRAINER_ICHOR_KORYKIAN_TITYROS, format("Hear that? Pipes. Every noon, from nowhere."), format("Even Pan stopped to listen."))
    msgbox(format("The pool goes deeper than any light I've carried."), MSGBOX_AUTOCLOSE)
    end
}

script Route9_KorykianCave_EventScript_KORYKIA {
    trainerbattle_single(TRAINER_ICHOR_KORYKIAN_KORYKIA, format("I'm named for the nymph of this cave. She lends me her bees."), format("They sting for her, not me."))
    msgbox(format("Past the thorn curtain north is the nymphs' own grotto. No flame I have will burn it."), MSGBOX_AUTOCLOSE)
    end
}
