// The Asclepeion, Lakonia (design/phase4/SCRIPT.md, Part 2): a bare stone room
// with one long bench and nothing on the walls. The counter is a plank on two
// stones; a bowl of cold water stands on it. The least comfortable Asclepeion
// in Aethos, and the cleanest. The healer is a Lakonian of very few words.
// Room: tools/ichor/maps/lakonia_rooms.py. The healer stands at (4,2) with the
// spring trough at (2..3, 1..2) for the heal animation; the player talks from
// (4,4). The mat is (3..4, 6), warps 0 and 1 to MAP_LAKONIA warp 0.
//
// "Again? Fight better." is for a second heal in a row: VAR_TEMP_1 counts heals
// this visit.

mapscripts Lakonia_Asclepeion_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_LAKONIA)
    }
}

text Lakonia_Asclepeion_Name_Healer { "HEALER" }

script Lakonia_Asclepeion_EventScript_Healer {
    lock
    faceplayer
    setspeaker(Lakonia_Asclepeion_Name_Healer)
    if (var(VAR_TEMP_1) != 0) {
        msgbox(format("Again?"))
    } else {
        msgbox(format("Wounds?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == NO) {
            msgbox(format("Good."))
            release
            end
        }
    }
    incrementgamestat(GAME_STAT_USED_POKECENTER)
    call(EventScript_PkmnCenterNurse_TakeAndHealPkmn)
    applymovement(LOCALID_LAKONIA_HEALER, Movement_PkmnCenterNurse_Bow)
    waitmovement(0)
    setspeaker(Lakonia_Asclepeion_Name_Healer)
    if (var(VAR_TEMP_1) != 0) {
        msgbox(format("Fight better."))
    } else {
        msgbox(format("Done."))
    }
    setvar(VAR_TEMP_1, 1)
    release
}

script Lakonia_Asclepeion_EventScript_Panacoil {
    lock
    faceplayer
    playmoncry(SPECIES_PANACOIL, CRY_MODE_NORMAL)
    msgbox(format("The Panacoil looks at you. It doesn't say anything either."))
    waitmoncry
    release
}

script Lakonia_Asclepeion_EventScript_Basin {
    msgbox(format("Cold spring water in a stone trough. Very cold.\p"
                  "There's no other kind in Lakonia."), MSGBOX_SIGN)
}

script Lakonia_Asclepeion_EventScript_Pithos {
    lockall
    setvar(VAR_0x8004, PC_LOCATION_OTHER)
    msgbox(Ichor_Text_PithosLook)
    msgbox(Ichor_Text_PithosLift)
    goto(Lakonia_Asclepeion_EventScript_PithosMenu)
}

script Lakonia_Asclepeion_EventScript_PithosMenu {
    message(Ichor_Text_PithosReach)
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, Ichor_Text_PithosOptionPokemon,
                   Ichor_Text_PithosOptionThings, Ichor_Text_PithosOptionClose)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("The Pithos of Lakonia opened."))
            msgbox(Ichor_Text_PithosPokemonRest)
            special(ShowPokemonStorageSystemPC)
            goto(Lakonia_Asclepeion_EventScript_PithosMenu)
        case 1:
            msgbox(Ichor_Text_PithosThings)
            special(PlayerPC)
            goto(Lakonia_Asclepeion_EventScript_PithosMenu)
    }
    msgbox(Ichor_Text_PithosClose)
    releaseall
    end
}
