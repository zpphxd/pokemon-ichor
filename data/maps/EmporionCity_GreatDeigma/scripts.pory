mapscripts EmporionCity_GreatDeigma_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (!flag(FLAG_DAILY_ICHOR_DEIGMA_RARE)) {
            setflag(FLAG_DAILY_ICHOR_DEIGMA_RARE)
            switch (var(VAR_ICHOR_DEIGMA_RARE)) {
            case 0:
                random(5)
                if (var(VAR_RESULT) >= 0) {
                    addvar(VAR_RESULT, 1)
                }
            case 1:
                random(5)
                if (var(VAR_RESULT) >= 1) {
                    addvar(VAR_RESULT, 1)
                }
            case 2:
                random(5)
                if (var(VAR_RESULT) >= 2) {
                    addvar(VAR_RESULT, 1)
                }
            case 3:
                random(5)
                if (var(VAR_RESULT) >= 3) {
                    addvar(VAR_RESULT, 1)
                }
            case 4:
                random(5)
                if (var(VAR_RESULT) >= 4) {
                    addvar(VAR_RESULT, 1)
                }
            case 5:
                random(5)
                if (var(VAR_RESULT) >= 5) {
                    addvar(VAR_RESULT, 1)
                }
                default:
                    random(6)
            }
            copyvar(VAR_ICHOR_DEIGMA_RARE, VAR_RESULT)
        }
    }
}

