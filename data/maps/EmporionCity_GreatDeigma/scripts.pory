script EmporionCity_GreatDeigma_EventScript_Kallias {
    lock
    faceplayer
    setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NameKallias)
    msgbox(format("Kallias, curios and rarities. Never the same two days running.\p"
                  "Today, look at this!"))
    setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NameKallias)
    switch (var(VAR_ICHOR_DEIGMA_RARE)) {
        case 0:
            msgbox(format("An egg of beaten gold, they swear, laid by a goose in Lydia."))
        case 1:
            msgbox(format("A coin from Croesus's own treasury. Probably."))
        case 2:
            msgbox(format("A red thread from Aphrodite's sanctuary on Kythera. It ties two together."))
        case 3:
            msgbox(format("A sash a wrestler wore at Olympia. He never fell."))
        case 4:
            msgbox(format("A glass orb from Sidon with a light inside. It hums. Don't ask."))
        case 5:
            msgbox(format("A capsule from the far east. It changes a Pokémon's nature. Well, its gift."))
    }
    message(format("Buy it today. Tomorrow it's gone."))
    waitmessage
    switch (var(VAR_ICHOR_DEIGMA_RARE)) {
        case 0:
            if (flag(FLAG_BADGE07_GET)) {
                pokemart(EmporionCity_GreatDeigma_Mart_CuriosLate0)
            } else {
                pokemart(EmporionCity_GreatDeigma_Mart_Curios0)
            }
        case 1:
            if (flag(FLAG_BADGE07_GET)) {
                pokemart(EmporionCity_GreatDeigma_Mart_CuriosLate1)
            } else {
                pokemart(EmporionCity_GreatDeigma_Mart_Curios1)
            }
        case 2:
            if (flag(FLAG_BADGE07_GET)) {
                pokemart(EmporionCity_GreatDeigma_Mart_CuriosLate2)
            } else {
                pokemart(EmporionCity_GreatDeigma_Mart_Curios2)
            }
        case 3:
            if (flag(FLAG_BADGE07_GET)) {
                pokemart(EmporionCity_GreatDeigma_Mart_CuriosLate3)
            } else {
                pokemart(EmporionCity_GreatDeigma_Mart_Curios3)
            }
        case 4:
            if (flag(FLAG_BADGE07_GET)) {
                pokemart(EmporionCity_GreatDeigma_Mart_CuriosLate4)
            } else {
                pokemart(EmporionCity_GreatDeigma_Mart_Curios4)
            }
        case 5:
            if (flag(FLAG_BADGE07_GET)) {
                pokemart(EmporionCity_GreatDeigma_Mart_CuriosLate5)
            } else {
                pokemart(EmporionCity_GreatDeigma_Mart_Curios5)
            }
    }
    setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NameKallias)
    msgbox(format("Come back tomorrow. I'll have something else. I always do."))
    release
}

text EmporionCity_GreatDeigma_EventScript_Text_NamePhormion { "PHORMION" }

script EmporionCity_GreatDeigma_EventScript_Phormion {
    lock
    faceplayer
    setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NamePhormion)
    msgbox(format("Phormion, at the trapeza. I learned the trade from old Pasion out in the Agora.\p"
                  "He gives a fifth over the market for old coins. I give more, and more\n"
                  "again for a Trainer the temples know."))
    goto(EmporionCity_GreatDeigma_EventScript_PhormionWeigh)
}

script EmporionCity_GreatDeigma_EventScript_PhormionWeigh {
    setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NamePhormion)
    message(format("Which coin shall I weigh?"))
    waitmessage
    multichoice(0, 0, MULTI_ICHOR_COINS, FALSE)
    if (var(VAR_RESULT) == 0) {
        setvar(VAR_0x8004, ITEM_RELIC_COPPER)
    } elif (var(VAR_RESULT) == 1) {
        setvar(VAR_0x8004, ITEM_RELIC_SILVER)
    } elif (var(VAR_RESULT) == 2) {
        setvar(VAR_0x8004, ITEM_RELIC_GOLD)
    } else {
        setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NamePhormion)
        msgbox(format("Another day, then. The trapeza is always here."))
        release
        end
    }
    checkitem(VAR_0x8004)
    if (var(VAR_RESULT) == FALSE) {
        setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NamePhormion)
        msgbox(format("You don't have one of those. Find an old coin and come back."))
        goto(EmporionCity_GreatDeigma_EventScript_PhormionWeigh)
    }
    if (flag(FLAG_BADGE07_GET)) {
        setvar(VAR_0x8005, 60)
    } elif (flag(FLAG_BADGE04_GET)) {
        setvar(VAR_0x8005, 40)
    } else {
        setvar(VAR_0x8005, 25)
    }
    specialvar(VAR_RESULT, Ichor_QuoteToMoneychanger)
    if (var(VAR_RESULT) == FALSE) {
        setspeaker(EmporionCity_GreatDeigma_EventScript_Text_NamePhormion)
        msgbox(format("Your purse can't hold the price. Spend some first."))
        release
        end
    }
    bufferitemname(STR_VAR_2, VAR_0x8004)
    msgbox("Sell the {STR_VAR_2}\nfor ¥{STR_VAR_1}?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        specialvar(VAR_RESULT, Ichor_SellToMoneychanger)
        if (var(VAR_RESULT) == TRUE) {
            playse(SE_SHOP)
            msgbox(format("Phormion rings it on the stone.\nHe pays you ¥{STR_VAR_1}."))
        }
    }
    goto(EmporionCity_GreatDeigma_EventScript_PhormionWeigh)
}

script EmporionCity_GreatDeigma_EventScript_Agoranomos {
    lock
    faceplayer
    msgbox(format("I'm the agoranomos. I check the weights against the city's measures.\pShort a sixth of an obol on a scale of figs? I'll know."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Haggler {
    lock
    faceplayer
    msgbox(format("Two obols for that? At home I'd pay half! ...At home they don't have it."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Sailor {
    lock
    faceplayer
    msgbox(format("Four months at sea, and the first thing I buy is figs. Every time."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Child {
    lock
    faceplayer
    msgbox(format("The Scythian has a gold deer! A real gold deer! Mama says it's not for children."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Elder {
    lock
    faceplayer
    msgbox(format("I come every day to see what the curio-seller has. Kallias never has the same thing twice."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Student {
    lock
    faceplayer
    msgbox(format("Sophron's tablets taught my Pokémon a new move. And then another. I'm broke."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Pilgrim {
    lock
    faceplayer
    msgbox(format("I came for the Isthmian Games and stayed for the market. Don't tell my wife."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Porter {
    lock
    faceplayer
    msgbox(format("Bales up from the harbor all day. The Scythian's furs weigh the most. And smell the most."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Donkey {
    lock
    faceplayer
    msgbox(format("The donkey is loaded with a bale of wool. It flicks an ear at you."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Spicer {
    lock
    faceplayer
    msgbox(format("Saffron from Lydia, cumin from Kypros, salt from the pans at Megara.\pI sell to cooks, not to Trainers. But smell this. Go on."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Potter {
    lock
    faceplayer
    msgbox(format("Real Athenian ware, black-figure and red. The owl on the bottom says so.\pEuphronios up the hill paints better. Don't tell him I said that."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Mother {
    lock
    faceplayer
    msgbox(format("Stay where I can see you! ...Has anyone seen a small boy with a fig?"))
    release
}

script EmporionCity_GreatDeigma_EventScript_Boy {
    lock
    faceplayer
    msgbox(format("Mmf. I'm not lost. I'm eating a fig."))
    release
}

script EmporionCity_GreatDeigma_EventScript_Taster {
    lock
    faceplayer
    msgbox(format("Melia lets you taste a berry if you smile. I've smiled nine times."))
    release
}

script EmporionCity_GreatDeigma_EventScript_NoticeWest {
    msgbox(format("THE GREAT DEIGMA. Every trader from every sea, under one roof.\pWeights checked by the agoranomoi. Old coins at Phormion's trapeza."), MSGBOX_SIGN)
    end
}

script EmporionCity_GreatDeigma_EventScript_NoticeEast {
    msgbox(format("Notice: Kallias's curio stall changes its wares each day.\pShips in from Sidon, Naukratis and the Euxine. More goods after the season."), MSGBOX_SIGN)
    end
}

script EmporionCity_GreatDeigma_EventScript_Measures {
    msgbox(format("The city's measures in bronze: a balance, a set of weights,\na measure of grain. Stamped with Hermes of the Agora."), MSGBOX_SIGN)
    end
}

script EmporionCity_GreatDeigma_EventScript_Fountain {
    msgbox(format("A lion's head spills cold water into the basin.\pSomeone has dropped an obol in it for luck."), MSGBOX_SIGN)
    end
}
