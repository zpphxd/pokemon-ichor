mapscripts Kaldera_Asclepeion_MapScripts {}
script Kaldera_Asclepeion_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_KALDERA_ASCLEPEION_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}
script Kaldera_Asclepeion_EventScript_Pithos {
    lockall
    setvar(VAR_0x8004, PC_LOCATION_OTHER)
    msgbox(Ichor_Text_PithosLook)
    call(Ichor_EventScript_PithosLiftLid)
    special(ShowPokemonStorageSystemPC)
    releaseall
}
