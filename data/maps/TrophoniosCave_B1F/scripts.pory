// Trophonios's cave, B1F: the descent (SCRIPT.md Part 5; beats 35B-35C).
// Layout and events are generated by tools/ichor/maps/trophonios.py; the
// fixed points below (the grille's steps (9,3), the throne's seat (12,5), the
// ladder at x 9, brazier 1 at (14,13)) are that builder's.
//
// The upper chamber inside the grille holds the throne of Mnemosyne, where the
// reading (beat 35C) plays: the hole on B2F warps the player onto the seat, and
// ON_TRANSITION, finding them there, shows Saon, a priest and Alethea.
// Deviation (TILES_trophonios.md): SCRIPT.md sets the chair between the springs
// in Lebadeia; the reading plays here, on the cave's own throne, so it needs no
// objects on another agent's map. Afterwards the hole is the way out (B2F).
//
// ICHOR_STUB_MUSIC: MUS_ICHOR_HOLLOW is the cave's cue (Part 9); no music plays
// under the throne.

const BRAZIER_FLAG = FLAG_ICHOR_BRAZIERS_START + 0x21
const LADDER_X = 9

mapscripts TrophoniosCave_B1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_TEMP_11)                      // the reading's three stay hidden
        setvar(VAR_TEMP_0, 0)
        setvar(VAR_TEMP_1, 0)
        setvar(VAR_TEMP_2, 0)
        getplayerxy(VAR_TEMP_4, VAR_TEMP_5)
        if (var(VAR_TEMP_4) == 12 && var(VAR_TEMP_5) == 5) {
            // up through the hole, onto the throne: beat 35C
            clearflag(FLAG_TEMP_11)
            setvar(VAR_TEMP_0, 1)
            setvar(VAR_TEMP_1, 1)
            setflashlevel(0)
            setvar(VAR_TEMP_2, 1)
        } elif (var(VAR_TEMP_5) < 10) {
            // the upper chamber: the day comes in through the grille
            setflashlevel(0)
            setvar(VAR_TEMP_2, 1)
        } elif (flag(BRAZIER_FLAG)) {
            // the stream chamber, and the pillar room open off its south bank
            if (var(VAR_TEMP_5) < 18) {
                setflashlevel(0)
                setvar(VAR_TEMP_2, 1)
            } elif (var(VAR_TEMP_4) > 6 && var(VAR_TEMP_4) < 14 && var(VAR_TEMP_5) < 22) {
                setflashlevel(0)
                setvar(VAR_TEMP_2, 1)
            }
        }
        if (var(VAR_TEMP_4) == 27 && var(VAR_TEMP_5) == 21) {
            setvar(VAR_TEMP_1, 1)                  // up from B2F: no line at the ladder's foot
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(BRAZIER_FLAG)) {
            call(TrophoniosCave_B1F_EventScript_SetBrazierLit)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 1: TrophoniosCave_B1F_EventScript_Reading
    ]
}

script TrophoniosCave_B1F_EventScript_SetBrazierLit {
    setmetatile(14, 13, METATILE_Trophonios_Brazier_LitTop, TRUE)
    setmetatile(14, 14, METATILE_Trophonios_Brazier_Lit, TRUE)
}

text TrophoniosCave_B1F_Text_SpeakerSaon { "SAON" }
text TrophoniosCave_B1F_Text_SpeakerPriest { "PRIEST" }
text TrophoniosCave_B1F_Text_SpeakerAlethea { "ALETHEA" }
text TrophoniosCave_B1F_Text_SpeakerPhilomelos { "PHILOMELOS" }

// --- the upper chamber ------------------------------------------------------------

script TrophoniosCave_B1F_EventScript_Tablets {
    msgbox(format("Wax tablets on pegs, each in a priest's hand: what a pilgrim said, word for word.\p"
                  "The newest ones all say the same four words."), MSGBOX_SIGN)
}

script TrophoniosCave_B1F_EventScript_Lamp {
    msgbox(format("A clay lamp burns in a niche. Someone keeps it full."), MSGBOX_SIGN)
}

script TrophoniosCave_B1F_EventScript_Throne {
    if (flag(FLAG_ICHOR_TROPHONIOS_READING)) {
        msgbox(format("The throne of Mnemosyne. You've sat in it.\pYou still don't remember anything."), MSGBOX_SIGN)
    } else {
        msgbox(format("A chair of white stone. Pilgrims are set in it when they come up, and asked what they saw."), MSGBOX_SIGN)
    }
}

script TrophoniosCave_B1F_EventScript_Bread {
    msgbox(format("Round loaves in a basket, stale as stones. Bread for the god below."), MSGBOX_SIGN)
}

script TrophoniosCave_B1F_EventScript_Cakes {
    msgbox(format("Honey cakes on a clay dish, gone hard. For the snakes, someone has written."), MSGBOX_SIGN)
}

// --- the ladder and the stream chamber ------------------------------------------

script TrophoniosCave_B1F_EventScript_LadderFoot {
    lockall
    setvar(VAR_TEMP_1, 1)
    msgbox(format("The ladder ends in the dark. Water is running somewhere close."))
    closemessage
    releaseall
}

// Lit zones (ENGINE_API section 2): stepping into a zone lights it if its fire is lit,
// else the torch's circle. VAR_TEMP_2 is 1 while the map is fully lit: the engine's
// EventScript_IchorEnterLitZone never finishes if the light is already full (its
// animateflash eases from radius 200 to 200 the wrong way), so each script checks first.
script TrophoniosCave_B1F_EventScript_EnterUpper {
    if (var(VAR_TEMP_2) == 0) {
        setvar(VAR_0x8004, FLAG_ICHOR_TROPHONIOS_GRILLE_OPEN)    // the day through the grille
        call(EventScript_IchorEnterLitZone)
        setvar(VAR_TEMP_2, 1)
    }
}

script TrophoniosCave_B1F_EventScript_EnterStream {
    if (flag(BRAZIER_FLAG)) {
        if (var(VAR_TEMP_2) == 0) {
            setvar(VAR_0x8004, BRAZIER_FLAG)
            call(EventScript_IchorEnterLitZone)
            setvar(VAR_TEMP_2, 1)
        }
    } elif (var(VAR_TEMP_2) == 1) {
        call(EventScript_IchorLeaveLitZone)
        setvar(VAR_TEMP_2, 0)
    }
}

script TrophoniosCave_B1F_EventScript_LeaveStream {
    if (var(VAR_TEMP_2) == 1) {
        call(EventScript_IchorLeaveLitZone)
        setvar(VAR_TEMP_2, 0)
    }
}

script TrophoniosCave_B1F_EventScript_Brazier {
    setvar(VAR_0x8004, BRAZIER_FLAG)
    setvar(VAR_0x8005, TRUE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        setvar(VAR_TEMP_2, 1)
        call(TrophoniosCave_B1F_EventScript_SetBrazierLit)
        special(DrawWholeMapView)
    }
    releaseall
}

// The first chalk hand: it teaches that the marks exist (Part 5, step 3).
// Deviation: the chalk is drawn faint in torchlight, as Phase 2's Hecate's chalk is,
// because the engine's glow copy isn't loaded on douse yet (TILES_trophonios.md).
script TrophoniosCave_B1F_EventScript_Handprint {
    if (flag(FLAG_ICHOR_TORCH_DOUSED)) {
        msgbox(format("A small hand, drawn in chalk that glows in the dark. Then another, smaller.\p"
                      "Pilgrims have been marking the way down for a very long time."), MSGBOX_SIGN)
    } else {
        msgbox(format("Rough rock. Something pale is smeared on it, too faint to read by torchlight."), MSGBOX_SIGN)
    }
}

// Herkyna's goose (Part 2, Lebadeia): a Halcyling standing in the stream.
script TrophoniosCave_B1F_EventScript_Goose {
    lock
    faceplayer
    msgbox(format("A Halcyling, soaked, standing in the underground stream. It looks very pleased with itself."))
    msgbox(format("Send it home?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        closemessage
        release
        end
    }
    closemessage
    playmoncry(SPECIES_HALCYLING, CRY_MODE_NORMAL)
    applymovement(LOCALID_TROPHONIOS_GOOSE, TrophoniosCave_B1F_Movement_GooseShakes)
    waitmovement(0)
    waitmoncry
    msgbox(format("It shakes itself, hops off up the stream toward the ladder, and is gone."))
    closemessage
    removeobject(LOCALID_TROPHONIOS_GOOSE)    // sets FLAG_ICHOR_FOUND_HERKYNAS_GOOSE
    setflag(FLAG_ICHOR_FOUND_HERKYNAS_GOOSE)
    release
}

movement TrophoniosCave_B1F_Movement_GooseShakes {
    jump_in_place_left
    jump_in_place_right
    face_left
}

// --- Philomelos, at the stair's foot (Part 3) ---------------------------------------

script TrophoniosCave_B1F_EventScript_Philomelos {
    trainerbattle_single(TRAINER_ICHOR_PHILOMELOS, TrophoniosCave_B1F_Text_PhilomelosIntro, TrophoniosCave_B1F_Text_PhilomelosDefeat)
    setspeaker(TrophoniosCave_B1F_Text_SpeakerPhilomelos)
    msgbox(format("Everyone gets the same four words. I wanted five."), MSGBOX_AUTOCLOSE)
}

text TrophoniosCave_B1F_Text_PhilomelosIntro {
    format("Go back up! It said the cloth runs out. I want a second opinion.")
}

text TrophoniosCave_B1F_Text_PhilomelosDefeat {
    format("Fine. That's two opinions. Neither of them good.")
}

// --- beat 35C: the throne of Mnemosyne ------------------------------------------------

script TrophoniosCave_B1F_EventScript_Reading {
    lockall
    setvar(VAR_TEMP_0, 2)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
    delay(40)
    setspeaker(TrophoniosCave_B1F_Text_SpeakerSaon)
    msgbox(format("Sit. Don't stand yet. Everyone falls over."))
    msgbox(format("You were down there a long time."))
    msgbox(format("Now. What did you see? What did he say?"))
    closemessage
    delay(60)
    applymovement(OBJ_EVENT_ID_PLAYER, TrophoniosCave_B1F_Movement_LookLeftRight)
    waitmovement(0)
    setspeaker(TrophoniosCave_B1F_Text_SpeakerSaon)
    msgbox(format("…Nothing?"))
    msgbox(format("No cloth? No voice? Not even the snakes?"))
    closemessage
    // the two priests look at each other, then back; nobody speaks
    turnobject(LOCALID_TROPHONIOS_SAON, DIR_WEST)
    turnobject(LOCALID_TROPHONIOS_PRIEST, DIR_EAST)
    delay(40)
    turnobject(LOCALID_TROPHONIOS_SAON, DIR_NORTH)
    turnobject(LOCALID_TROPHONIOS_PRIEST, DIR_NORTH)
    delay(60)
    setspeaker(TrophoniosCave_B1F_Text_SpeakerSaon)
    msgbox(format("Write it down."))
    setspeaker(TrophoniosCave_B1F_Text_SpeakerPriest)
    msgbox(format("Write what?"))
    setspeaker(TrophoniosCave_B1F_Text_SpeakerSaon)
    msgbox(format("Write that we asked."))
    closemessage
    // the priests walk back to the grille
    applymovement(LOCALID_TROPHONIOS_PRIEST, TrophoniosCave_B1F_Movement_PriestOut)
    applymovement(LOCALID_TROPHONIOS_SAON, TrophoniosCave_B1F_Movement_SaonOut)
    waitmovement(LOCALID_TROPHONIOS_PRIEST)
    removeobject(LOCALID_TROPHONIOS_PRIEST)
    waitmovement(LOCALID_TROPHONIOS_SAON)
    removeobject(LOCALID_TROPHONIOS_SAON)
    turnobject(LOCALID_TROPHONIOS_ALETHEA, DIR_WEST)
    setspeaker(TrophoniosCave_B1F_Text_SpeakerAlethea)
    msgbox(format("Everyone else came up with the same four words. You came up with none."))
    msgbox(format("I'm not going to say anything. Truthfully, I'm writing it down."))
    closemessage
    applymovement(LOCALID_TROPHONIOS_ALETHEA, TrophoniosCave_B1F_Movement_AletheaOut)
    waitmovement(0)
    removeobject(LOCALID_TROPHONIOS_ALETHEA)
    setflag(FLAG_ICHOR_TROPHONIOS_READING)
    playbgm(MUS_ICHOR_HOLLOW, FALSE)          // ICHOR_STUB_MUSIC: the cave's cue comes back
    releaseall
}

movement TrophoniosCave_B1F_Movement_LookLeftRight {
    face_left
    delay_16
    delay_16
    face_right
    delay_16
    delay_16
    face_down
}

// (11,7) and (12,7) to the grille's steps (9,3), along the paving
movement TrophoniosCave_B1F_Movement_PriestOut {
    walk_left * 2
    walk_up * 4
}

movement TrophoniosCave_B1F_Movement_SaonOut {
    delay_16
    delay_16
    walk_left * 3
    walk_up * 4
}

movement TrophoniosCave_B1F_Movement_AletheaOut {
    walk_left * 5
    walk_up * 3
}

// The three are only here for the reading; talking to them in it isn't possible
// (lockall), but their objects need a script.
script TrophoniosCave_B1F_EventScript_Saon {
    end
}

script TrophoniosCave_B1F_EventScript_Priest {
    end
}

script TrophoniosCave_B1F_EventScript_Alethea {
    end
}
