mapscripts Olympus_SeatOfPoseidon_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_BEAT_THEMISTOKLES)) {
            call(Olympus_SeatOfPoseidon_EventScript_SetOpen)
        }
        if (var(VAR_ELITE_4_STATE) == 3 || var(VAR_ELITE_4_STATE) == 4) {
            call(Olympus_SeatOfPoseidon_EventScript_SetClosed)
        }
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0: Olympus_SeatOfPoseidon_EventScript_FaceNorth
