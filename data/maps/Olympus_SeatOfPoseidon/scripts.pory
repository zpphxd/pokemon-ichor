    ]
}

script Olympus_SeatOfPoseidon_EventScript_FaceNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script Olympus_SeatOfPoseidon_EventScript_WalkIn {
    lockall
    call(Ichor_League_EventScript_WalkIn)
    call(Olympus_SeatOfPoseidon_EventScript_SetClosed)
    special(DrawWholeMapView)
    setvar(VAR_ELITE_4_STATE, 3)
    releaseall
}

script Olympus_SeatOfPoseidon_EventScript_SetClosed {
    setmetatile(9, 20, 0x016, TRUE)
    setmetatile(10, 20, 0x016, TRUE)
    return
}

script Olympus_SeatOfPoseidon_EventScript_SetOpen {
    setmetatile(9, 2, 0x2BC, FALSE)
    setmetatile(10, 2, 0x2BD, FALSE)
    return
}

text Olympus_SeatOfPoseidon_Text_Defeat { "Read me right, didn't you." }

script Olympus_SeatOfPoseidon_EventScript_Themistokles {
    lock
    faceplayer
    setspeaker(Ichor_League_Text_NameThemistokles)
    if (flag(FLAG_ICHOR_BEAT_THEMISTOKLES)) {
        msgbox(format("Hypatia's next. She'll ask you a question. Don't answer with your name.\pTell Aristeides I said hello. He'll hate that."))
        release
        end
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    msgbox(format("The oracle told Astyra to trust its wooden wall. Everyone read walls.\pI read ships. We won at Salamis, and I keep that ship here so nobody forgets an oracle can be read two ways.\pI had Aristeides exiled once. Best thing I ever did for him. Nobody's too good to be wrong.\pLet's see which way you read me."))
    trainerbattle_no_intro(TRAINER_ICHOR_THEMISTOKLES, Olympus_SeatOfPoseidon_Text_Defeat)
    setflag(FLAG_ICHOR_BEAT_THEMISTOKLES)
    setvar(VAR_ELITE_4_STATE, 4)
    call(Olympus_SeatOfPoseidon_EventScript_SetOpen)
    call(Ichor_League_EventScript_DoorOpened)
    setspeaker(Ichor_League_Text_NameThemistokles)
    msgbox(format("Hypatia's next. She'll ask you a question. Don't answer with your name.\pTell Aristeides I said hello. He'll hate that."))
    release
}

script Olympus_SeatOfPoseidon_EventScript_ExitGate {
    lockall
    if (!flag(FLAG_ICHOR_BEAT_THEMISTOKLES)) {
        releaseall
        end
    }
    playse(SE_DOOR)
    waitse
    warp(MAP_OLYMPUS_SEAT_OF_ATHENA, 0)
    waitstate
    releaseall
}

script Olympus_SeatOfPoseidon_EventScript_WoodenWall {
    msgbox(format("TRUST THE WOODEN WALL\nThe oracle given to Astyra before Salamis.\pUnder it, in a newer hand: “Read it twice.”"), MSGBOX_SIGN)
}
