mapscripts Aigion_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_AIGION)
    }
}

// Generated by tools/ichor/maps/gulf.py; edit the builder, not this file.

script Aigion_EventScript_Sign {
    msgbox(format("AIGION\nSouth: the drum pass and Arkadia. Trireme to Kirrha."), MSGBOX_SIGN)
    end
}

script Aigion_EventScript_SouthSign {
    msgbox(format("South: Route 11, up the Selinous gorge to the drum pass."), MSGBOX_SIGN)
    end
}

script Aigion_EventScript_Altar {
    msgbox(format("The oath altar. Here the kings swore to sail for Troy,\nand here the towns of Achaea still swear."), MSGBOX_SIGN)
    end
}

script Aigion_EventScript_Oak {
    msgbox(format("Zeus's oak. Every acorn on it is somebody's promise."), MSGBOX_SIGN)
    end
}

script Aigion_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_AIGION_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}

script Aigion_EventScript_Merchant {
    goto(ArkadiaApproach_EventScript_Merchant)
}

script Aigion_EventScript_Guide {
    lock
    faceplayer
    msgbox(format("The pass is full of fallen column drums. Nothing wrong with the road under them.\pThere's an actor in Thyrsa with Herakles's girdle. Or so he says.\pGet those drums moving and it's Styx Falls, then Arkadia."))
    release
}

script Aigion_EventScript_Captain {
    lock
    faceplayer
    msgbox(format("Back to Kirrha? We sail when you're aboard."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setvar(VAR_ICHOR_GULF_DEST, 1)
        warp(MAP_GULF_TRIREME, 13, 4)
        waitstate
        releaseall
        end
    }
    release
}

script Aigion_EventScript_Fisher {
    lock
    faceplayer
    if (!flag(FLAG_ICHOR_AIGION_FISHER_GIFT)) {
        msgbox(format("On a still morning you can see Helike down there. Columns, roofs, a whole town.\pPoseidon took it in one night. Take these, for when you can follow the fish down."))
        giveitem(ITEM_DIVE_BALL)
        if (var(VAR_RESULT) == TRUE) {
            setflag(FLAG_ICHOR_AIGION_FISHER_GIFT)
        }
        release
        end
    }
    msgbox(format("Don't fish over Helike. Nets come up with lamps in them."))
    release
}

script Aigion_EventScript_Kid {
    lock
    faceplayer
    msgbox(format("The old men in the Homarion say the kings swore on that altar.\pI swore I'd swim to the islet. I didn't say when."))
    release
}
