// Aigion, the Achaean port across the gulf (SCRIPT.md beat 37C; Part 2's Aigion roster;
// Part 6's items). Layout and events are generated by tools/ichor/maps/harbors.py
// (harbors_aigion.py). A healer hamlet: the grove-keeper heals under the planes, and the
// grove is the heal location (HEAL_LOCATION_AIGION).
//
// Scene state:
//   VAR_TEMP_1 == 0     the landing: Alethea's lines on the quay (once, beat 37C)
//   FLAG_TEMP_1         hides Panopeus on the quay until the gulf has been crossed
//   FLAG_TEMP_2         hides Alethea's quay copy once she has gone on to the south road
//   FLAG_ICHOR_HIDE_ALETHEA_AIGION  Alethea waiting at the south road, shown from the
//                       landing until she goes on into Route 11 (batch 3 sets it)
// ICHOR_STUB_MUSIC: MUS_ICHOR_ROAD, the road west's theme (Part 9), until Aigion has a cue.

mapscripts Aigion_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_ICHOR_VISITED_AIGION)
        if (!flag(FLAG_ICHOR_GULF_CROSSED)) {
            setflag(FLAG_TEMP_1)
        }
        if (flag(FLAG_ICHOR_AIGION_ARRIVAL_SEEN)) {
            setflag(FLAG_TEMP_2)
            setvar(VAR_TEMP_1, 1)
        } else {
            setflag(FLAG_ICHOR_HIDE_ALETHEA_AIGION)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: Aigion_EventScript_Landing
    ]
}

text Aigion_Name_Alethea { "ALETHEA" }
text Aigion_Name_Panopeus { "PANOPEUS" }
text Aigion_Name_GroveKeeper { "GROVE-KEEPER" }
text Aigion_Name_Fisher { "FISHER" }
text Aigion_Name_Child { "CHILD" }

// ---------------------------------------------------------------------------
// Beat 37C: the landing. Alethea steps off first; then she goes up the street to
// the south road and waits for you at the edge of the map.
// ---------------------------------------------------------------------------

script Aigion_EventScript_Landing {
    lockall
    setvar(VAR_TEMP_1, 1)
    setflag(FLAG_ICHOR_GULF_CROSSED)
    setflag(FLAG_ICHOR_VISITED_AIGION)
    applymovement(LOCALID_AIGION_ALETHEA_QUAY, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    delay(20)
    setspeaker(Aigion_Name_Alethea)
    msgbox(format("Achaea. The other side of the gulf.\p"
                  "Agamemnon called every king in Greece to that grove once. For Troy.\p"
                  "Arkadia's up there. Somewhere in all those mountains.\p"
                  "Kleon's two days ahead of us. Come on."))
    closemessage
    applymovement(LOCALID_AIGION_ALETHEA_QUAY, Aigion_Movement_AletheaUpTheStreet)
    waitmovement(0)
    removeobject(LOCALID_AIGION_ALETHEA_QUAY)
    setflag(FLAG_TEMP_2)
    setflag(FLAG_ICHOR_AIGION_ARRIVAL_SEEN)
    clearflag(FLAG_ICHOR_HIDE_ALETHEA_AIGION)
    addobject(LOCALID_AIGION_ALETHEA)
    releaseall
}

movement Aigion_Movement_AletheaUpTheStreet {
    walk_down walk_down walk_left walk_left walk_down walk_down
}

// Alethea at the south road, waiting to go on into the gorge (Route 11, batch 3).
script Aigion_EventScript_AletheaRoad {
    lock
    faceplayer
    setspeaker(Aigion_Name_Alethea)
    msgbox(format("Kleon's two days ahead of us. Come on."))
    release
}

// ---------------------------------------------------------------------------
// Panopeus on the quay, after the crossing: the ferry back to Kirrha.
// ---------------------------------------------------------------------------

script Aigion_EventScript_Panopeus {
    lock
    faceplayer
    setspeaker(Aigion_Name_Panopeus)
    msgbox(format("Kirrha, across the gulf. Half a day with a good wind.\p"
                  "A whole day with my brother's wind. He has the other boat."))
    msgbox(format("Going across?"), MSGBOX_YESNO)
    setspeaker(Aigion_Name_Panopeus)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The gulf will still be here. So will I, sadly."))
        release
        end
    }
    msgbox(format("Good. Mind the goats. They're paying passengers too."))
    closemessage
    setflag(FLAG_ICHOR_FERRY_TO_KIRRHA)
    fadescreen(FADE_TO_BLACK)
    warpsilent(MAP_GULF_FERRY_DECK, 11, 6)
    waitstate
    release
}

// ---------------------------------------------------------------------------
// The grove of Zeus the Assembler: the keeper heals; the altar is Zeus's.
// ---------------------------------------------------------------------------

script Aigion_EventScript_GroveKeeper {
    lock
    faceplayer
    setspeaker(Aigion_Name_GroveKeeper)
    msgbox(format("Agamemnon stood here and called every king in Greece. And they came.\p"
                  "Ten years at Troy, all because of a meeting under these trees.\p"
                  "We still hold meetings here. Shorter ones.\p"
                  "Sit under the trees a while. Nobody's hurried here since Troy."))
    closemessage
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    setrespawn(HEAL_LOCATION_AIGION)
    release
}

script Aigion_EventScript_Altar {
    lockall
    msgbox(format("An altar of Zeus the Assembler, ringed by old plane trees."))
    closemessage
    releaseall
    goto(EventScript_IchorAltar_Zeus)
}

// ICHOR_STUB_DIG: Aigion's daily dig spot at the edge of the grove (Part 6). Digs aren't
// built; when they are: setvar(VAR_0x8004, <daily spot>), setvar(VAR_0x8005,
// ICHOR_DIG_ACT_II), goto(EventScript_IchorDigSpot).
script Aigion_EventScript_DigGrove {
    msgbox(format("The earth at the grove's edge has been turned over."), MSGBOX_SIGN)
}

// ---------------------------------------------------------------------------
// The town's people and signs
// ---------------------------------------------------------------------------

script Aigion_EventScript_Fisher {
    lock
    faceplayer
    setspeaker(Aigion_Name_Fisher)
    msgbox(format("See those, under the water? Roofs. A whole town.\p"
                  "Helike. The sea god took it in one night. Bell tower and all.\p"
                  "On a still day you can hear the bell. That's what my grandfather said.\p"
                  "My grandfather said a lot of things. I've still never heard it."))
    release
}

script Aigion_EventScript_Child {
    lock
    faceplayer
    setspeaker(Aigion_Name_Child)
    msgbox(format("A Lakonian went up the gorge two days ago, running.\p"
                  "He asked me which way Arkadia was. I pointed. He didn't say thank you.\p"
                  "The pass is full of fallen drums. He just climbed over them."))
    release
}

script Aigion_EventScript_QuaySign {
    msgbox(format("AIGION. Ferry to Kirrha. The grove of Zeus the Assembler above."), MSGBOX_SIGN)
}

script Aigion_EventScript_SouthSign {
    msgbox(format("South: Route 11, the gorge of the Krathis, and the mountains of Arkadia."),
           MSGBOX_SIGN)
}
