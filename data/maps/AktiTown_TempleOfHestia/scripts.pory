// The Temple of Hestia in Akti: the Hearth Trial and Hierophant Ione (SCRIPT.md beat 7, Part 5).
//
// VAR_ICHOR_HEARTH_TRIAL: 0 no flame, 1 carrying, 2 Door lit, 3 Table lit, 4 Loom lit,
// 5 Bed lit, 6 the last flame went home (FLAG_ICHOR_HEARTH_TRIAL_DONE is set with it).
//
// The room is designed in tools/ichor/maps/temple.py, which also writes the brazier
// scripts below. Its four stations stand out of hymn order, each brazier beside its piece
// of the household: Table back left (3,3), Door back right (13,3) by the side door, Loom
// front left (3,16), Bed front right (13,16). A brazier is a bowl over its plaque legs,
// and a lit one warms the floor around it. The dais pair stands at (7,7) and (9,7), with
// the cord between them at (8,7).

mapscripts AktiTown_TempleOfHestia_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // A torch never survives the trip outside, so a half-done trial starts over.
        if (var(VAR_ICHOR_HEARTH_TRIAL) >= 1 && var(VAR_ICHOR_HEARTH_TRIAL) <= 5) {
            setvar(VAR_ICHOR_HEARTH_TRIAL, 0)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        call(AktiTown_TempleOfHestia_EventScript_DrawBraziers)
    }
}

// --- Brazier scripts: generated by tools/ichor/maps/temple.py from the room. Do not edit. ---

// Draws every brazier, its light and the cord from the trial's state.
script AktiTown_TempleOfHestia_EventScript_DrawBraziers {
    if (flag(FLAG_ICHOR_HEARTH_TRIAL_DONE)) {
        call(AktiTown_TempleOfHestia_EventScript_LightDoor)
        call(AktiTown_TempleOfHestia_EventScript_LightTable)
        call(AktiTown_TempleOfHestia_EventScript_LightLoom)
        call(AktiTown_TempleOfHestia_EventScript_LightBed)
        call(AktiTown_TempleOfHestia_EventScript_LightDais)
        return
    }
    if (var(VAR_ICHOR_HEARTH_TRIAL) >= 2) {
        call(AktiTown_TempleOfHestia_EventScript_LightDoor)
    } else {
        call(AktiTown_TempleOfHestia_EventScript_DouseDoor)
    }
    if (var(VAR_ICHOR_HEARTH_TRIAL) >= 3) {
        call(AktiTown_TempleOfHestia_EventScript_LightTable)
    } else {
        call(AktiTown_TempleOfHestia_EventScript_DouseTable)
    }
    if (var(VAR_ICHOR_HEARTH_TRIAL) >= 4) {
        call(AktiTown_TempleOfHestia_EventScript_LightLoom)
    } else {
        call(AktiTown_TempleOfHestia_EventScript_DouseLoom)
    }
    if (var(VAR_ICHOR_HEARTH_TRIAL) >= 5) {
        call(AktiTown_TempleOfHestia_EventScript_LightBed)
    } else {
        call(AktiTown_TempleOfHestia_EventScript_DouseBed)
    }
    return
}

script AktiTown_TempleOfHestia_EventScript_LightDoor {
    setmetatile(13, 3, METATILE_TempleHestia_BrazierTop_Lit, TRUE)
    setmetatile(13, 4, METATILE_TempleHestia_BrazierDoor_Lit, TRUE)
    setmetatile(12, 3, METATILE_TempleHestia_BrazierLight_Left0, FALSE)
    setmetatile(14, 3, METATILE_TempleHestia_BrazierLight_Right0, FALSE)
    setmetatile(12, 4, METATILE_TempleHestia_BrazierLight_Left1, FALSE)
    setmetatile(14, 4, METATILE_TempleHestia_BrazierLight_Right1, FALSE)
    setmetatile(12, 5, METATILE_TempleHestia_BrazierLight_BelowLeft, FALSE)
    setmetatile(13, 5, METATILE_TempleHestia_BrazierLight_Below, FALSE)
    setmetatile(14, 5, METATILE_TempleHestia_BrazierLight_BelowRight, FALSE)
    return
}

script AktiTown_TempleOfHestia_EventScript_DouseDoor {
    setmetatile(13, 3, METATILE_TempleHestia_BrazierTop_Cold, TRUE)
    setmetatile(13, 4, METATILE_TempleHestia_BrazierDoor_Cold, TRUE)
    setmetatile(12, 3, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(14, 3, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(12, 4, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(14, 4, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(12, 5, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(13, 5, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(14, 5, METATILE_TempleHestia_Floor, FALSE)
    return
}

script AktiTown_TempleOfHestia_EventScript_LightTable {
    setmetatile(3, 3, METATILE_TempleHestia_BrazierTop_Lit, TRUE)
    setmetatile(3, 4, METATILE_TempleHestia_BrazierTable_Lit, TRUE)
    setmetatile(4, 3, METATILE_TempleHestia_BrazierLight_Right0, FALSE)
    setmetatile(4, 4, METATILE_TempleHestia_BrazierLight_Right1, FALSE)
    setmetatile(2, 5, METATILE_TempleHestia_BrazierLight_BelowLeft, FALSE)
    setmetatile(3, 5, METATILE_TempleHestia_BrazierLight_Below, FALSE)
    setmetatile(4, 5, METATILE_TempleHestia_BrazierLight_BelowRight, FALSE)
    return
}

script AktiTown_TempleOfHestia_EventScript_DouseTable {
    setmetatile(3, 3, METATILE_TempleHestia_BrazierTop_Cold, TRUE)
    setmetatile(3, 4, METATILE_TempleHestia_BrazierTable_Cold, TRUE)
    setmetatile(4, 3, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(4, 4, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(2, 5, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(3, 5, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(4, 5, METATILE_TempleHestia_Floor, FALSE)
    return
}

script AktiTown_TempleOfHestia_EventScript_LightLoom {
    setmetatile(3, 16, METATILE_TempleHestia_BrazierTop_Lit, TRUE)
    setmetatile(3, 17, METATILE_TempleHestia_BrazierLoom_Lit, TRUE)
    setmetatile(4, 16, METATILE_TempleHestia_BrazierLight_Right0, FALSE)
    setmetatile(4, 17, METATILE_TempleHestia_BrazierLight_Right1, FALSE)
    setmetatile(2, 18, METATILE_TempleHestia_BrazierLight_BelowLeft, FALSE)
    setmetatile(3, 18, METATILE_TempleHestia_BrazierLight_Below, FALSE)
    return
}

script AktiTown_TempleOfHestia_EventScript_DouseLoom {
    setmetatile(3, 16, METATILE_TempleHestia_BrazierTop_Cold, TRUE)
    setmetatile(3, 17, METATILE_TempleHestia_BrazierLoom_Cold, TRUE)
    setmetatile(4, 16, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(4, 17, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(2, 18, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(3, 18, METATILE_TempleHestia_Floor, FALSE)
    return
}

script AktiTown_TempleOfHestia_EventScript_LightBed {
    setmetatile(13, 16, METATILE_TempleHestia_BrazierTop_Lit, TRUE)
    setmetatile(13, 17, METATILE_TempleHestia_BrazierBed_Lit, TRUE)
    setmetatile(12, 16, METATILE_TempleHestia_BrazierLight_Left0, FALSE)
    setmetatile(12, 17, METATILE_TempleHestia_BrazierLight_Left1, FALSE)
    setmetatile(13, 18, METATILE_TempleHestia_BrazierLight_Below, FALSE)
    setmetatile(14, 18, METATILE_TempleHestia_BrazierLight_BelowRight, FALSE)
    return
}

script AktiTown_TempleOfHestia_EventScript_DouseBed {
    setmetatile(13, 16, METATILE_TempleHestia_BrazierTop_Cold, TRUE)
    setmetatile(13, 17, METATILE_TempleHestia_BrazierBed_Cold, TRUE)
    setmetatile(12, 16, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(12, 17, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(13, 18, METATILE_TempleHestia_Floor, FALSE)
    setmetatile(14, 18, METATILE_TempleHestia_Floor, FALSE)
    return
}

// The dais pair flares when the last flame goes home, and the cord burns away.
script AktiTown_TempleOfHestia_EventScript_LightDais {
    setmetatile(7, 7, METATILE_TempleHestia_BrazierTop_Lit, TRUE)
    setmetatile(7, 8, METATILE_TempleHestia_BrazierHearth_Lit, TRUE)
    setmetatile(6, 7, METATILE_TempleHestia_BrazierLight_Left0, FALSE)
    setmetatile(6, 8, METATILE_TempleHestia_BrazierLight_Left1, FALSE)
    setmetatile(6, 9, METATILE_TempleHestia_BrazierLight_BelowLeft, FALSE)
    setmetatile(7, 9, METATILE_TempleHestia_BrazierLight_Below, FALSE)
    setmetatile(9, 7, METATILE_TempleHestia_BrazierTop_Lit, TRUE)
    setmetatile(9, 8, METATILE_TempleHestia_BrazierHearth_Lit, TRUE)
    setmetatile(10, 7, METATILE_TempleHestia_BrazierLight_Right0, FALSE)
    setmetatile(10, 8, METATILE_TempleHestia_BrazierLight_Right1, FALSE)
    setmetatile(9, 9, METATILE_TempleHestia_BrazierLight_Below, FALSE)
    setmetatile(10, 9, METATILE_TempleHestia_BrazierLight_BelowRight, FALSE)
    setmetatile(8, 7, METATILE_TempleHestia_Runner, FALSE)
    return
}

// --- End of generated brazier scripts. ---

// --- People -----------------------------------------------------------------------------

script AktiTown_TempleOfHestia_EventScript_Euboulos {
    lock
    faceplayer
    setspeaker(AktiTown_TempleOfHestia_Text_NameEuboulos)
    if (flag(FLAG_BADGE01_GET)) {
        msgbox(format("The house is warm, and so are you. Hestia keep you, guest."))
    } elif (flag(FLAG_ICHOR_HEARTH_TRIAL_DONE)) {
        msgbox(format("Welcome, guest. In Hestia's house, every stranger is a guest."))
    } elif (var(VAR_ICHOR_HEARTH_TRIAL) == 5) {
        msgbox(format("You took the first flame. Hestia is owed the last."))
    } else {
        msgbox(format(
            "Welcome, guest. In Hestia's house, every stranger is a guest.\p"
            "The Hearthkeeper will see you once the house is warm.\p"
            "Read the hymn on the stele. Then carry the fire as it says.\p"
            "Lampon keeps the great hearth. Prove yourself to him first."))
    }
    release
    end
}

script AktiTown_TempleOfHestia_EventScript_Kanthos {
    lock
    faceplayer
    setspeaker(AktiTown_TempleOfHestia_Text_NameEuboulos)
    msgbox(format(
        "Mind Kanthos. He brays at anyone sneaking about.\p"
        "Once saved the goddess's dignity that way, they say. Good donkey."))
    setspeaker(AktiTown_TempleOfHestia_Text_NameKanthos)
    playmoncry(SPECIES_MUDBRAY, CRY_MODE_NORMAL)
    msgbox(format("HRRRNK!"))
    waitmoncry
    release
    end
}

script AktiTown_TempleOfHestia_EventScript_Lampon {
    trainerbattle_single(TRAINER_ICHOR_LAMPON,
        format("Nobody touches the hearth until they've faced its keeper!"),
        format("Fine. Fine! Carry the flame. Carefully. CAREFULLY."))
    setspeaker(AktiTown_TempleOfHestia_Text_NameLampon)
    msgbox(format("Read the hymn by the door. Twice. I had to read it nine times."), MSGBOX_AUTOCLOSE)
    end
}

script AktiTown_TempleOfHestia_EventScript_Pyrrha {
    trainerbattle_single(TRAINER_ICHOR_PYRRHA,
        format("Ooh, a challenger! I've been itching for a fight all week!"),
        format("Burned out. Ugh. That never happens to me."))
    setspeaker(AktiTown_TempleOfHestia_Text_NamePyrrha)
    msgbox(format("Hestia gets the first cup and the last one. Always. Remember the last."), MSGBOX_AUTOCLOSE)
    end
}

script AktiTown_TempleOfHestia_EventScript_Aithra {
    trainerbattle_single(TRAINER_ICHOR_AITHRA,
        format("I keep the night watch. I haven't slept since spring. Battle?"),
        format("Counting Wooloo doesn't help. I've tried. Thousands."))
    setspeaker(AktiTown_TempleOfHestia_Text_NameAithra)
    msgbox(format(
        "Old Kronos swallowed Hestia first and coughed her up last.\p"
        "Patient lady.\p"
        "The bed's always last before home. Everyone ends up in bed. Eventually."), MSGBOX_AUTOCLOSE)
    end
}

// Ione stands behind the inner hearth's counter; the cord keeps everyone off the dais
// until the trial is done, so the battle always follows it.
script AktiTown_TempleOfHestia_EventScript_Ione {
    if (flag(FLAG_BADGE01_GET)) {
        lock
        faceplayer
        if (!flag(FLAG_ICHOR_GOT_TM_FACADE)) {
            goto(AktiTown_TempleOfHestia_EventScript_GiveFacade)
        }
        setspeaker(AktiTown_TempleOfHestia_Text_NameIone)
        msgbox(format(
            "The trireme sails for the mainland when the winds turn.\p"
            "Kerykos keeps the temple at Emporion. He'll talk your ear off.\p"
            "Come back whenever you're cold. The door doesn't lock."))
        release
        end
    }
    setspeaker(AktiTown_TempleOfHestia_Text_NameIone)
    trainerbattle_single(TRAINER_ICHOR_IONE_1, AktiTown_TempleOfHestia_Text_IoneIntro,
        format("There. Warm all the way through."), AktiTown_TempleOfHestia_EventScript_IoneDefeated, NO_MUSIC)
    // Beaten already, yet the laurel never changed hands: give it now.
    lock
    faceplayer
    goto(AktiTown_TempleOfHestia_EventScript_IoneDefeated)
}

script AktiTown_TempleOfHestia_EventScript_IoneDefeated {
    setspeaker(AktiTown_TempleOfHestia_Text_NameIone)
    msgbox(format(
        "Well fought. Hestia doesn't hand out her fire to just anyone.\p"
        "Take this. The Hearth Laurel. The first leaf of your crown."))
    setflag(FLAG_BADGE01_GET)
    setspeaker(SP_NAME_NONE)
    message(format("{PLAYER} received the Hearth Laurel from Ione!"))
    waitmessage
    call(Common_EventScript_PlayGymBadgeFanfare)
    goto(AktiTown_TempleOfHestia_EventScript_GiveFacade)
}

script AktiTown_TempleOfHestia_EventScript_GiveFacade {
    setspeaker(AktiTown_TempleOfHestia_Text_NameIone)
    msgbox(format(
        "And this. Facade. A hearth burns hotter when it's fed.\p"
        "Hurt, burned or poisoned, it hits twice as hard. Hardship is fuel."))
    checkitemspace(ITEM_TM42)
    if (var(VAR_RESULT) == FALSE) {
        setspeaker(SP_NAME_NONE)
        goto(Common_EventScript_ShowBagIsFull)
    }
    setvar(VAR_0x8006, ITEM_TM42)
    additem(ITEM_TM42)
    setflag(FLAG_ICHOR_GOT_TM_FACADE)
    setspeaker(SP_NAME_NONE)
    playfanfare(MUS_OBTAIN_TMHM)
    message(format("{PLAYER} received TM42, Facade!"))
    waitmessage
    showitemdescription
    waitfanfare
    waitbuttonpress
    hideitemdescription
    setspeaker(AktiTown_TempleOfHestia_Text_NameIone)
    msgbox(format(
        "Halia sent word that you'd come. Her gull beat you by an hour.\p"
        "She said you'd come. She didn't say how it would go.\p"
        "That isn't like her. Halia always says how it'll go.\p"
        "Ah, but you won. So it went well. Now, eat something."))
    release
    end
}

// --- The Hearth Trial --------------------------------------------------------------------

script AktiTown_TempleOfHestia_EventScript_Stele {
    msgbox(format(
        "HYMN OF THE HEARTH\p"
        "Hestia, first and last of every feast.\p"
        "From your fire, carry fire.\p"
        "First to the door, that greets the stranger.\p"
        "Then to the table, where the bread is shared.\p"
        "Then to the loom, where the cloak is woven.\p"
        "Then to the bed, where the house lies sleeping.\p"
        "And bring the last flame home to you."), MSGBOX_SIGN)
    end
}

script AktiTown_TempleOfHestia_EventScript_GreatHearth {
    lockall
    if (flag(FLAG_ICHOR_HEARTH_TRIAL_DONE)) {
        msgbox(format("The great hearth of Hestia. It has never once gone out."))
        if (!flag(FLAG_ICHOR_GOT_CHARCOAL)) {
            call(AktiTown_TempleOfHestia_EventScript_GiveCharcoal)
        }
        releaseall
        end
    }
    if (!defeated(TRAINER_ICHOR_LAMPON)) {
        setspeaker(AktiTown_TempleOfHestia_Text_NameLampon)
        msgbox(format("Hands off! Face me first."))
        releaseall
        end
    }
    switch (var(VAR_ICHOR_HEARTH_TRIAL)) {
        case 0:
            msgbox(format(
                "The great hearth of Hestia. It has never once gone out.\p"
                "Take a flame from the hearth?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                closemessage
                setvar(VAR_ICHOR_HEARTH_TRIAL, 1)
                playse(SE_M_EMBER)
                waitse
                msgbox(format("{PLAYER} lit a torch from the hearth. Walk carefully."))
            }
        case 5:
            msgbox(format("Give the last flame back to the hearth?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                goto(AktiTown_TempleOfHestia_EventScript_ReturnLastFlame)
            }
        default:
            msgbox(format("The great hearth of Hestia. It has never once gone out."))
    }
    releaseall
    end
}

script AktiTown_TempleOfHestia_EventScript_ReturnLastFlame {
    closemessage
    setvar(VAR_ICHOR_HEARTH_TRIAL, 6)
    setflag(FLAG_ICHOR_HEARTH_TRIAL_DONE)
    playse(SE_M_SACRED_FIRE)
    fadescreenspeed(FADE_TO_WHITE, 2)
    call(AktiTown_TempleOfHestia_EventScript_DrawBraziers)
    special(DrawWholeMapView)
    fadescreenspeed(FADE_FROM_WHITE, 2)
    waitse
    msgbox(format("The hearth roars up, gold and tall. Every brazier in the hall answers."))
    closemessage
    // Show the dais: the player stands somewhere around the hearth (y 11-15), so look
    // up until the view is centred on the braziers and the burnt cord at y 7.
    getplayerxy(VAR_0x8004, VAR_0x8005)
    special(SpawnCameraObject)
    switch (var(VAR_0x8005)) {
        case 11: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraUp4)
        case 12: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraUp5)
        case 13: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraUp6)
        case 14: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraUp7)
        default: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraUp8)
    }
    waitmovement(0)
    msgbox(format("The braziers by the dais flare. The way to the Hearthkeeper is open."))
    closemessage
    switch (var(VAR_0x8005)) {
        case 11: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraDown4)
        case 12: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraDown5)
        case 13: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraDown6)
        case 14: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraDown7)
        default: applymovement(OBJ_EVENT_ID_CAMERA, AktiTown_TempleOfHestia_Movement_CameraDown8)
    }
    waitmovement(0)
    special(RemoveCameraObject)
    msgbox(format("Something tumbles out of the ashes at your feet."))
    call(AktiTown_TempleOfHestia_EventScript_GiveCharcoal)
    releaseall
    end
}

script AktiTown_TempleOfHestia_EventScript_GiveCharcoal {
    checkitemspace(ITEM_CHARCOAL)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(gText_TooBadBagIsFull)
        return
    }
    setvar(VAR_0x8006, ITEM_CHARCOAL)
    additem(ITEM_CHARCOAL)
    setflag(FLAG_ICHOR_GOT_CHARCOAL)
    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} found a piece of Charcoal from Hestia's hearth!"))
    waitmessage
    showitemdescription
    waitfanfare
    waitbuttonpress
    hideitemdescription
    return
}

// A brazier shows its plaque. With a torch in hand and the brazier still cold, it asks
// to be lit: the next one in the hymn catches, any other puts every hall brazier out.
// VAR_0x8004 holds the brazier's place in the hymn: 1 Door, 2 Table, 3 Loom, 4 Bed.
script AktiTown_TempleOfHestia_EventScript_BrazierDoor {
    lockall
    msgbox(format("A bronze brazier. Its plaque shows a carved doorway."))
    setvar(VAR_0x8004, 1)
    goto(AktiTown_TempleOfHestia_EventScript_TryLightBrazier)
}

script AktiTown_TempleOfHestia_EventScript_BrazierTable {
    lockall
    msgbox(format("A bronze brazier. Its plaque shows a loaf of bread."))
    setvar(VAR_0x8004, 2)
    goto(AktiTown_TempleOfHestia_EventScript_TryLightBrazier)
}

script AktiTown_TempleOfHestia_EventScript_BrazierLoom {
    lockall
    msgbox(format("A bronze brazier. Its plaque shows a spindle."))
    setvar(VAR_0x8004, 3)
    goto(AktiTown_TempleOfHestia_EventScript_TryLightBrazier)
}

script AktiTown_TempleOfHestia_EventScript_BrazierBed {
    lockall
    msgbox(format("A bronze brazier. Its plaque shows a couch."))
    setvar(VAR_0x8004, 4)
    goto(AktiTown_TempleOfHestia_EventScript_TryLightBrazier)
}

script AktiTown_TempleOfHestia_EventScript_TryLightBrazier {
    // No torch (0), or every hall brazier already burns (5 and up): the plaque is all.
    if (var(VAR_ICHOR_HEARTH_TRIAL) == 0 || var(VAR_ICHOR_HEARTH_TRIAL) >= 5) {
        releaseall
        end
    }
    // Var 1-4 means (var - 1) braziers are lit, so this one burns already if var > place.
    if (var(VAR_ICHOR_HEARTH_TRIAL) > VAR_0x8004) {
        releaseall
        end
    }
    msgbox(format("Light it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    closemessage
    if (var(VAR_ICHOR_HEARTH_TRIAL) == VAR_0x8004) {
        addvar(VAR_ICHOR_HEARTH_TRIAL, 1)
        playse(SE_M_FLAME_WHEEL)
        call(AktiTown_TempleOfHestia_EventScript_DrawBraziers)
        special(DrawWholeMapView)
        waitse
        msgbox(format("The brazier catches with a soft WHUMPF."))
    } else {
        setvar(VAR_ICHOR_HEARTH_TRIAL, 0)
        playse(SE_M_HAZE)
        call(AktiTown_TempleOfHestia_EventScript_DrawBraziers)
        special(DrawWholeMapView)
        waitse
        msgbox(format(
            "The flame gutters and dies. All the braziers go dark.\p"
            "Somewhere, an acolyte sighs."))
    }
    releaseall
    end
}

// The two braziers flanking the dais steps wait for the hearth, not for the torch.
script AktiTown_TempleOfHestia_EventScript_BrazierDais {
    msgbox(format("A bronze brazier. Its plaque shows a flame."), MSGBOX_SIGN)
    end
}

// Stepping onto the door mat with a torch (coord events, var 1-5).
script AktiTown_TempleOfHestia_EventScript_TorchSputters {
    lockall
    msgbox(format("The torch sputters out in the sea wind. Hestia keeps her fire at home."))
    setvar(VAR_ICHOR_HEARTH_TRIAL, 0)
    call(AktiTown_TempleOfHestia_EventScript_DrawBraziers)
    special(DrawWholeMapView)
    releaseall
    end
}

// --- Text and movement -------------------------------------------------------------------

text AktiTown_TempleOfHestia_Text_IoneIntro {
    format(
        "Come in, come in. Sit by the fire. You look half frozen.\p"
        "You carried the flame well. The house is warm because of you.\p"
        "I'm Ione. I keep this hearth, as my mother did, and hers.\p"
        "Have you eaten? No? Afterward, then. I feed everyone either way.\p"
        "A hearth isn't the fire, you know. It's what you come back to.\p"
        "Every house has a guard, a hungry mouth, and a flame.\p"
        "Let me show you mine.")
}

