// The Icefall's deep (design/maps/Ascent_IcefallDeep.md): the coldest dark under the
// ice caves, lit only by Hecate's Torch; a black tarn (Poseidon's Conch).
// Generated by tools/ichor/maps/ascent_glacier.py: edit the builder, not this file.

mapscripts Ascent_IcefallDeep_MapScripts {}

script Ascent_IcefallDeep_EventScript_Hesychios {
    trainerbattle_single(TRAINER_ICHOR_DEEP_HESYCHIOS,
        format("Shh. I came down here for the quiet.\pYou brought a fire and a fight. Fine. Only the fight."),
        format("…That was loud."))
    msgbox(format("The water's the Styx's, they say. A trickle of it, come up under the mountain.\pThe gods swore by it. Don't swear by anything down here."), MSGBOX_AUTOCLOSE)
}

script Ascent_IcefallDeep_EventScript_Styx {
    msgbox(format("A drowned shrine to Styx, the river the gods swore their oaths on.\pWords half under the ice:\p“Whoever breaks an oath sworn on my water lies a year without breath,\pand nine more without a seat at the feast.”"), MSGBOX_SIGN)
}

script Ascent_IcefallDeep_EventScript_Meltfall {
    msgbox(format("Meltwater pours down the ice here, loud in the dark: a spring from under the cone\pthat the cold never stopped. Something glints at the top.\pA river god's horn could climb water like this."), MSGBOX_SIGN)
}

// --- the gods' easter eggs (tools/ichor/maps/ascent_eggs.py) ---
script Ascent_IcefallDeep_EventScript_EggOwl {
    msgbox(format("Two round eyes shine back at you from a ledge above the tarn.\pAn owl, Athena's kind. It has watched everything you did in the dark, and it isn't telling."), MSGBOX_SIGN)
}

script Ascent_IcefallDeep_EventScript_EggFerry {
    msgbox(format("A coin lies on the tarn's shore, set there on purpose: a fare for a ferryman.\pCharon never comes this far up. Somebody hoped anyway."), MSGBOX_SIGN)
}
