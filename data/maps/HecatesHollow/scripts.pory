// ICHOR_STUB_SFX: the hound's cry, echoing, for the panned bark SCRIPT.md Part 9 wants.
script HecatesHollow_EventScript_DistantBark {
    playmoncry(SPECIES_LYKOPUP, CRY_MODE_ECHO_END)
    waitmoncry
    delay(20)
    return
}

// ---------------------------------------------------------------------------
// The Hekataion: beat 18's offering, then Hecate's altar; its spring is the
// midpoint rest (SCRIPT.md Part 5)
// ---------------------------------------------------------------------------

script HecatesHollow_EventScript_Hekataion {
    lockall
    if (flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        goto(EventScript_IchorAltar_Hecate)
    }
    msgbox(format("A pillar with three faces, looking down three roads. An altar of Hecate.\p"
                  "A barley cake sits on the ledge, as if someone left it for you."), MSGBOX_DEFAULT)
    msgbox(format("Leave Hecate her supper at the crossroads?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("The torches stay cold. Somewhere, very close, a dog sighs."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("You set the barley cake on the altar."), MSGBOX_DEFAULT)
    closemessage
    // a single bark, very close; silence; then the left face's torch, the right's, the middle's
    playmoncry(SPECIES_LYKOPUP, CRY_MODE_NORMAL)
    waitmoncry
    delay(60)
    call(HecatesHollow_EventScript_LightTorchW)
    delay(30)
    call(HecatesHollow_EventScript_LightTorchE)
    delay(30)
    call(HecatesHollow_EventScript_LightTorchS)
    animateflash(HH_LIT)
    setflashlevel(HH_LIT)
    // Favor: the myth-quest and a loved offering for Hecate; Hestia's share of any offering
    setvar(VAR_0x8004, ICHOR_GOD_HECATE)
    setvar(VAR_0x8005, ICHOR_FAVOR_MYTH_QUEST + 5)
    special(Ichor_AddFavor)
    setvar(VAR_0x8004, ICHOR_GOD_HESTIA)
    setvar(VAR_0x8005, 1)
    special(Ichor_AddFavor)
    msgbox(format("The middle face's torch comes loose in your hand. It's warm."), MSGBOX_DEFAULT)
    call(HecatesHollow_EventScript_TakeTorch)
    giveitem(ITEM_HECATES_TORCH)
    msgbox(format("Something brushes past your legs. Something warm, with a cold nose.\p"
                  "Then it's gone."), MSGBOX_DEFAULT)
    releaseall
}

script HecatesHollow_EventScript_Spring {
    lockall
    msgbox(format("Cold water runs down the pillar's three faces. You feel rested."), MSGBOX_DEFAULT)
    special(HealPlayerParty)
    releaseall
}

script HecatesHollow_EventScript_ChalkWheel {
    msgbox(format("A wheel is chalked on the rock, a spiral inside it.\p"
                  "The chalk is faint, but someone keeps renewing it."), MSGBOX_SIGN)
}

// After 20:00, three black hounds sit at the pillar's feet. Two fade into the walls
// as the player comes in; the third stays (beat 18, "At night").
script HecatesHollow_EventScript_HoundsFade {
    if (flag(FLAG_TEMP_3)) {
        return
    }
    lockall
    delay(16)
    msgbox(format("Black hounds sit at the pillar's feet."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_HOLLOW_HOUND_W, HecatesHollow_Movement_FadeWest)
    applymovement(LOCALID_HOLLOW_HOUND_E, HecatesHollow_Movement_FadeEast)
    waitmovement(0)
    removeobject(LOCALID_HOLLOW_HOUND_W)
    removeobject(LOCALID_HOLLOW_HOUND_E)
    if (flag(FLAG_TEMP_2)) {
        msgbox(format("They walk into the rock as if it were mist."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Two of them walk into the rock as if it were mist. The third stays."), MSGBOX_DEFAULT)
    }
    closemessage
    releaseall
    return
}

movement HecatesHollow_Movement_FadeWest { walk_slow_left * 2 set_invisible }
movement HecatesHollow_Movement_FadeEast { walk_slow_right * 2 set_invisible }

// The faded hounds can't be spoken to (they're gone); this is for safety only.
script HecatesHollow_EventScript_HoundFading {
    end
}

// The hound that stays: Lykopup, Lv 20, one only (FLAG_ICHOR_HECATES_HOUND once
// caught or beaten; running leaves it for another night).
script HecatesHollow_EventScript_Hound {
    lock
    faceplayer
    msgbox(format("The black hound looks at you, then at the dark behind you. It doesn't fade."), MSGBOX_DEFAULT)
    closemessage
    setwildbattle(SPECIES_LYKOPUP, 20)
    playmoncry(SPECIES_LYKOPUP, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(20)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_ICHOR_HECATES_HOUND)
    }
    release
}

// ---------------------------------------------------------------------------
// The webs (SYSTEMS.md §2: webs burn). Each web is two invisible objects that run
// the engine's cobweb; once it burns, ON_FRAME swaps in the torn web.
// ---------------------------------------------------------------------------

script HecatesHollow_EventScript_Web {
    setvar(VAR_TEMP_3, 0)
    goto(EventScript_IchorCobweb)
}

script HecatesHollow_EventScript_RedrawWebs {
    setvar(VAR_TEMP_3, 1)
    call(HecatesHollow_EventScript_DrawWebs)
    special(DrawWholeMapView)
    end
}

script HecatesHollow_EventScript_WebPictures {
    msgbox(format("Old webs hang here in sheets, with pictures woven into them.\p"
                  "A loom. A goddess with a spear. A spider."), MSGBOX_SIGN)
}

// Raknit hangs from the ceiling once the Arachne amphora is done (SCRIPT.md Part 2):
// Lv 20, with its hidden ability.
script HecatesHollow_EventScript_Raknit {
    lock
    faceplayer
    msgbox(format("A small spider hangs from a thread, mid-stitch.\p"
                  "Its web shows a picture: a goddess, tearing up a tapestry."), MSGBOX_DEFAULT)
    closemessage
    setwildbattle(SPECIES_RAKNIT, 20)
    createmon(1, 0, SPECIES_RAKNIT, 20, abilityNum=2)
    playmoncry(SPECIES_RAKNIT, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(20)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_ICHOR_HOLLOW_RAKNIT)
    }
    release
}

// ---------------------------------------------------------------------------
// The braziers: each lights its hall for good (ENGINE_API.md §2)
// ---------------------------------------------------------------------------

script HecatesHollow_EventScript_Brazier1 {
    setvar(VAR_0x8004, HH_BRAZIER_1)
    setvar(VAR_0x8005, FALSE)          // ICHOR_STUB_DARKNESS: the hall is lit to HH_LIT here, not 0
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        call(HecatesHollow_EventScript_DrawBrazier1Lit)
        special(DrawWholeMapView)
        animateflash(HH_LIT)
        setflashlevel(HH_LIT)
        msgbox(format("The brazier catches. Its light reaches every corner of the passage."), MSGBOX_DEFAULT)
    }
    releaseall
}

script HecatesHollow_EventScript_Brazier2 {
    setvar(VAR_0x8004, HH_BRAZIER_2)
    setvar(VAR_0x8005, FALSE)          // ICHOR_STUB_DARKNESS: the hall is lit to HH_LIT here, not 0
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        call(HecatesHollow_EventScript_DrawBrazier2Lit)
        special(DrawWholeMapView)
        animateflash(HH_LIT)
        setflashlevel(HH_LIT)
        msgbox(format("The brazier catches. Its light reaches every corner of the passage."), MSGBOX_DEFAULT)
    }
    releaseall
}

// ---------------------------------------------------------------------------
// The people (SCRIPT.md Part 3; Phaino and Battos are the map's own)
// ---------------------------------------------------------------------------

// HEKABE, by the first brazier; her sight covers the only way west. Pilgrims
// carry Hecate's suppers, and she gives the player one.
script HecatesHollow_EventScript_Hekabe {
    trainerbattle_single(TRAINER_ICHOR_HEKABE,
        format("Hecate's light is on you, I see. Let's see if it's earned."),
        format("Earned."),
        HecatesHollow_EventScript_HekabeSupper)
    if (!flag(FLAG_ICHOR_GOT_HEKABE_SUPPER)) {
        goto(HecatesHollow_EventScript_HekabeSupper)
    }
    setspeaker(HecatesHollow_Text_NameHekabe)
    msgbox(format("The weasel was a girl once. She laughed at a goddess.\p"
                  "Hecate took her in anyway. Hecate takes everyone in."), MSGBOX_AUTOCLOSE)
    end
}

script HecatesHollow_EventScript_HekabeSupper {
    lock
    faceplayer
    setspeaker(HecatesHollow_Text_NameHekabe)
    msgbox(format("Here. Supper for the road.\p"
                  "Leave it on her ledge as you pass. She'll know whose it was."))
    giveitem(ITEM_BARLEY_CAKE)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_ICHOR_GOT_HEKABE_SUPPER)
    }
    release
    end
}

// INITIATE KALLIAS sits in the dark of the side passage, so he sees the player only
// up close. ICHOR_STUB_SPRITE: the initiate's walker and portrait aren't drawn; he
// is an acolyte until they are.
script HecatesHollow_EventScript_Kallias {
    trainerbattle_single(TRAINER_ICHOR_KALLIAS,
        format("My family carries the Mysteries' torches! I forgot mine. Cheer me up."),
        format("I feel worse."))
    setspeaker(HecatesHollow_Text_NameKallias)
    msgbox(format("Don't tell my father. He's the Torchbearer. Officially. He has a hat."), MSGBOX_AUTOCLOSE)
    end
}

// PILGRIM PHAINO, lost at fork 2's dead end with her supper dish.
script HecatesHollow_EventScript_Phaino {
    trainerbattle_single(TRAINER_ICHOR_PHAINO,
        format("Oh! I thought you were her dog. I'm not scared. I'm cold."),
        format("Still cold."))
    setspeaker(HecatesHollow_Text_NamePhaino)
    msgbox(format("I bring her supper every new moon. It's always gone by morning.\p"
                  "I sat up once to see who eats it. I fell asleep. It was gone anyway."), MSGBOX_AUTOCLOSE)
    end
}

// GOATHERD BATTOS, at the west mouth with his back to the cave. In the myth he saw
// Hermes steal the cattle, swore to say nothing, told anyway, and was turned to stone.
script HecatesHollow_EventScript_Battos {
    trainerbattle_single(TRAINER_ICHOR_BATTOS,
        format("Goats? What goats? I saw nothing. I always see nothing."),
        format("Didn't see that either."))
    setspeaker(HecatesHollow_Text_NameBattos)
    msgbox(format("A traveler paid me once to keep quiet about what I saw.\p"
                  "I didn't. My knees have been stiff ever since. Like stone."), MSGBOX_AUTOCLOSE)
    end
}

