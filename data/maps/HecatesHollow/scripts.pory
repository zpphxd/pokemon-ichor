// Hecate's Hollow: the cave under the pass of Mount Aigaleos, between Route 4 (the
// Isthmus) and Route 5 (the Skironian cliffs). Beat 18 and Part 5's "Three Roads"
// in design/phase2/SCRIPT.md; its people are Part 3's "Hecate's Hollow trainers".
//
// The cave is laid out by tools/ichor/maps/hecates_hollow.py, which also writes
// map.json's events and the generated block at the end of this file. It is a dark
// map ("cave": true): the engine gives the Torch's light (ENGINE_API.md §2).
//
// The light: VAR_TEMP_2 is the region the player stands in (0 the dark, 1 the east
// mouth's daylight, 2 the Hekataion, 3 Hekabe's hall, 4 hall 2, 5 the west mouth's
// daylight). Every edge cell has a trigger per neighbouring region that runs the new
// region's Enter script, which sets the light once.
//
// Temp vars: VAR_TEMP_0/1 the player's cell on arrival; VAR_TEMP_2 the region;
// VAR_TEMP_3 is 0 when the webs need redrawing (a web's script sets it, ON_FRAME
// redraws); VAR_TEMP_5/6/7 the barks at forks 1/2/3, once a visit.
// Temp flags: FLAG_TEMP_1 hides Raknit, FLAG_TEMP_2 the hound that stays, FLAG_TEMP_3
// and _4 the two that fade (all set or cleared in ON_TRANSITION).
//
// Stubs:
//   ICHOR_STUB_DARKNESS  lit places are flash 1, not 0 (HH_LIT, below).
//   ICHOR_STUB_SFX       SCRIPT.md Part 9 asks for a dog's bark panned left, right and
//                        centre; until it exists the barks are the hound's own cry.
//   ICHOR_STUB_AMPHORA   the Arachne amphora's completion flag (SYSTEMS.md §5, the
//                        third amphora: FLAG_ICHOR_AMPHORAE_START + 2) gates Raknit.
//   ICHOR_STUB_AETHOS_DEX  Lykopup and Raknit are stand-ins (ichor_species_stubs.h);
//                        Raknit's "hidden ability" is the stand-in's until the dex lands.

const HH_BRAZIER_1 = FLAG_ICHOR_BRAZIERS_START + 0x14
const HH_BRAZIER_2 = FLAG_ICHOR_BRAZIERS_START + 0x15
const HH_ARACHNE_AMPHORA = FLAG_ICHOR_AMPHORAE_START + 2    // ICHOR_STUB_AMPHORA
const HH_SKYLIGHT = 4          // the Hekataion before the Torch: faint light from above (3 tiles)
// ICHOR_STUB_DARKNESS: two limits of the engine's flash effect (AnimateFlash and its task
// in src/field_screen_effect.c, which vanilla only ever used to grow Flash's light):
//   - light can grow but not shrink: a darker level ends the task after one step, so
//     the window stays as wide as it was;
//   - flash 0 ends with ScanlineEffect_Stop (and a map loaded at 0 never starts it), so
//     after full light the dark never comes back.
// So a lit place here is flash 1 (four and a half tiles), never 0; and stepping from
// the light into the dark without the Torch reloads the map where the player stands,
// which draws the dark afresh (ReloadInTheDark). With the Torch the difference is 72 px
// against 56, and the map lets the light stay wide until the next load or battle. Once
// the engine can shrink the light, set HH_LIT to 0 and let EnterDark use
// EventScript_IchorLeaveLitZone alone.
const HH_LIT = 1

mapscripts HecatesHollow_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(HecatesHollow_EventScript_SetUpCave)
    }
    MAP_SCRIPT_ON_LOAD {
        call(HecatesHollow_EventScript_DrawCave)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_3, 0: HecatesHollow_EventScript_RedrawWebs
    ]
}

text HecatesHollow_Text_NameOldWoman { "OLD WOMAN" }
text HecatesHollow_Text_NameHekabe { "HEKABE" }
text HecatesHollow_Text_NameKallias { "KALLIAS" }
text HecatesHollow_Text_NamePhaino { "PHAINO" }
text HecatesHollow_Text_NameBattos { "BATTOS" }

// The statics (the hounds after 20:00, Raknit once the Arachne amphora is done), then
// the light where the player arrives.
script HecatesHollow_EventScript_SetUpCave {
    setflag(FLAG_TEMP_1)
    if (flag(HH_ARACHNE_AMPHORA) && !flag(FLAG_ICHOR_HOLLOW_RAKNIT)) {
        clearflag(FLAG_TEMP_1)
    }
    setflag(FLAG_TEMP_2)
    setflag(FLAG_TEMP_3)
    setflag(FLAG_TEMP_4)
    gettime
    if (var(VAR_0x8000) >= 20 || var(VAR_0x8000) < 4) {
        clearflag(FLAG_TEMP_3)
        clearflag(FLAG_TEMP_4)
        if (!flag(FLAG_ICHOR_HECATES_HOUND)) {
            clearflag(FLAG_TEMP_2)
        }
    }
    call(HecatesHollow_EventScript_FindRegion)
    return
}

// ---------------------------------------------------------------------------
// The light (SYSTEMS.md §2): what each region does when the player arrives in it
// (Light*, from ON_TRANSITION) or steps into it (Enter*, from its edge triggers).
// ---------------------------------------------------------------------------

script HecatesHollow_EventScript_LightDaylightEast {
    setflashlevel(HH_LIT)
    return
}

script HecatesHollow_EventScript_LightDaylightWest {
    setflashlevel(HH_LIT)
    return
}

script HecatesHollow_EventScript_LightHekataion {
    if (flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        setflashlevel(HH_LIT)
    } else {
        setflashlevel(HH_SKYLIGHT)
    }
    return
}

script HecatesHollow_EventScript_LightBrazier1 {
    if (flag(HH_BRAZIER_1)) {
        setflashlevel(HH_LIT)
    }
    return
}

script HecatesHollow_EventScript_LightBrazier2 {
    if (flag(HH_BRAZIER_2)) {
        setflashlevel(HH_LIT)
    }
    return
}

script HecatesHollow_EventScript_EnterDark {
    setvar(VAR_TEMP_2, 0)
    if (!flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        goto(HecatesHollow_EventScript_ReloadInTheDark)
    }
    call(EventScript_IchorLeaveLitZone)
    end
}

// ICHOR_STUB_DARKNESS: the light can't shrink, so reload the map on this very cell; it
// loads at the dark's own level (flash 7 without the Torch).
script HecatesHollow_EventScript_ReloadInTheDark {
    lockall
    getplayerxy(VAR_0x8008, VAR_0x8009)
    warpsilent(MAP_HECATES_HOLLOW, VAR_0x8008, VAR_0x8009)
    waitstate
    releaseall
    end
}

script HecatesHollow_EventScript_EnterDaylightEast {
    setvar(VAR_TEMP_2, 1)
    animateflash(HH_LIT)
    setflashlevel(HH_LIT)
    end
}

script HecatesHollow_EventScript_EnterDaylightWest {
    setvar(VAR_TEMP_2, 5)
    animateflash(HH_LIT)
    setflashlevel(HH_LIT)
    end
}

// The round chamber is lit faintly from above until the Hekataion's torches burn.
script HecatesHollow_EventScript_EnterHekataion {
    setvar(VAR_TEMP_2, 2)
    if (flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        animateflash(HH_LIT)
        setflashlevel(HH_LIT)
    } else {
        animateflash(HH_SKYLIGHT)
        setflashlevel(HH_SKYLIGHT)
    }
    call(HecatesHollow_EventScript_HoundsFade)
    end
}

script HecatesHollow_EventScript_EnterBrazier1 {
    setvar(VAR_TEMP_2, 3)
    if (flag(HH_BRAZIER_1)) {
        animateflash(HH_LIT)
        setflashlevel(HH_LIT)
    } else {
        call(EventScript_IchorLeaveLitZone)
    }
    end
}

script HecatesHollow_EventScript_EnterBrazier2 {
    setvar(VAR_TEMP_2, 4)
    if (flag(HH_BRAZIER_2)) {
        animateflash(HH_LIT)
        setflashlevel(HH_LIT)
    } else {
        call(EventScript_IchorLeaveLitZone)
    }
    end
}

// ---------------------------------------------------------------------------
// The east mouth
// ---------------------------------------------------------------------------

script HecatesHollow_EventScript_SignEast {
    msgbox(format("HECATE'S HOLLOW\n"
                  "Three roads meet beneath the mountain. Hecate keeps them all."), MSGBOX_SIGN)
}

script HecatesHollow_EventScript_SignWest {
    msgbox(format("HECATE'S HOLLOW\n"
                  "West: Route 5 and the Skironian Cliffs, and on to Eleusa."), MSGBOX_SIGN)
}

// Beat 18: the old woman by the mouth, her covered dish at her feet.
script HecatesHollow_EventScript_OldWoman {
    lock
    faceplayer
    setspeaker(HecatesHollow_Text_NameOldWoman)
    if (flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        msgbox(format("So she gave you her light. She doesn't, often.\p"
                      "Feed her when you pass. She remembers who does."))
    } elif (!flag(FLAG_ICHOR_MET_HOLLOW_CRONE)) {
        msgbox(format("No light? Then you're braver than you look. Or sillier.\p"
                      "Three roads meet in there. In the dark, every one looks right.\p"
                      "Listen for the dog. Hecate's dogs always know the way.\p"
                      "I leave her supper at the crossroads every new moon. She never eats it.\p"
                      "Somebody does."))
        setflag(FLAG_ICHOR_MET_HOLLOW_CRONE)
    } else {
        msgbox(format("Listen for the dog. Hecate's dogs always know the way."))
    }
    release
}

