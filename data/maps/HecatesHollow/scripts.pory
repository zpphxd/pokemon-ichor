    return
}

script HecatesHollow_EventScript_DrawBrazier2Lit {
    setmetatile(6, 22, METATILE_CaveDark_Brazier_Lit_00, TRUE)
    setmetatile(7, 22, METATILE_CaveDark_Brazier_Lit_10, TRUE)
    setmetatile(6, 23, METATILE_CaveDark_Brazier_Lit_01, TRUE)
    setmetatile(7, 23, METATILE_CaveDark_Brazier_Lit_11, TRUE)
    return
}

// Burnt webs: torn shreds you can walk through. Each web's second object shares
// its flag, so it goes too.
script HecatesHollow_EventScript_DrawWebs {
    if (flag(FLAG_ICHOR_HIDE_HOLLOW_WEB_WEST)) {
        setmetatile(13, 10, METATILE_CaveDark_Web1_Torn_0, FALSE)
        setmetatile(13, 11, METATILE_CaveDark_Web1_Torn_1, FALSE)
        removeobject(LOCALID_HOLLOW_WEB_WEST_1)
        removeobject(LOCALID_HOLLOW_WEB_WEST_2)
    }
    if (flag(FLAG_ICHOR_HIDE_HOLLOW_WEB_CHAMBER)) {
        setmetatile(5, 8, METATILE_CaveDark_Web1_Torn_0, FALSE)
        setmetatile(5, 9, METATILE_CaveDark_Web1_Torn_1, FALSE)
        removeobject(LOCALID_HOLLOW_WEB_CHAMBER_1)
        removeobject(LOCALID_HOLLOW_WEB_CHAMBER_2)
    }
    if (flag(FLAG_ICHOR_HIDE_HOLLOW_WEB_SHORTCUT)) {
        setmetatile(40, 9, METATILE_CaveDark_Web1_Torn_0, FALSE)
        setmetatile(40, 10, METATILE_CaveDark_Web1_Torn_1, FALSE)
        removeobject(LOCALID_HOLLOW_WEB_SHORTCUT_1)
        removeobject(LOCALID_HOLLOW_WEB_SHORTCUT_2)
    }
    return
}

// ON_TRANSITION: the region the player arrives in (VAR_TEMP_2) and its light.
script HecatesHollow_EventScript_FindRegion {
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    setvar(VAR_TEMP_2, 0)
    if (var(VAR_TEMP_0) >= 41 && var(VAR_TEMP_0) <= 47 && var(VAR_TEMP_1) >= 32 && var(VAR_TEMP_1) <= 36) {
        setvar(VAR_TEMP_2, 1)
        call(HecatesHollow_EventScript_LightDaylightEast)
    }
    elif (var(VAR_TEMP_0) >= 16 && var(VAR_TEMP_0) <= 33 && var(VAR_TEMP_1) >= 2 && var(VAR_TEMP_1) <= 12) {
        setvar(VAR_TEMP_2, 2)
        call(HecatesHollow_EventScript_LightHekataion)
    }
    elif (var(VAR_TEMP_0) >= 1 && var(VAR_TEMP_0) <= 14 && var(VAR_TEMP_1) >= 12 && var(VAR_TEMP_1) <= 17) {
        setvar(VAR_TEMP_2, 3)
        call(HecatesHollow_EventScript_LightBrazier1)
    }
    elif (var(VAR_TEMP_0) >= 0 && var(VAR_TEMP_0) <= 3 && var(VAR_TEMP_1) >= 24 && var(VAR_TEMP_1) <= 29) {
        setvar(VAR_TEMP_2, 5)
        call(HecatesHollow_EventScript_LightDaylightWest)
    }
    elif (var(VAR_TEMP_0) >= 3 && var(VAR_TEMP_0) <= 12 && var(VAR_TEMP_1) >= 22 && var(VAR_TEMP_1) <= 32) {
        setvar(VAR_TEMP_2, 4)
        call(HecatesHollow_EventScript_LightBrazier2)
    }
    return
}

