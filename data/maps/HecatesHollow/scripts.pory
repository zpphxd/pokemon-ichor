// The cave as the story has left it: the Hekataion once the Torch is taken,
// the lit braziers, the burnt webs. ON_LOAD calls it before the map is drawn.
script HecatesHollow_EventScript_DrawCave {
    if (flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        call(HecatesHollow_EventScript_DrawHekataionLit)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x14)) {
        call(HecatesHollow_EventScript_DrawBrazier1Lit)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x15)) {
        call(HecatesHollow_EventScript_DrawBrazier2Lit)
    }
    call(HecatesHollow_EventScript_DrawWebs)
    return
}

script HecatesHollow_EventScript_DrawHekataionLit {
    setmetatile(24, 5, METATILE_CaveDark_Hekataion_TorchW_Lit, FALSE)
    setmetatile(25, 5, METATILE_CaveDark_Hekataion_TorchS_Gone, FALSE)
    setmetatile(26, 5, METATILE_CaveDark_Hekataion_TorchE_Lit, FALSE)
    setmetatile(25, 8, METATILE_CaveDark_Hekataion_NoCake, TRUE)
    setmetatile(27, 2, METATILE_CaveDark_Niche_Empty_1, TRUE)
    return
}

