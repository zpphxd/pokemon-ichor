    setvar(VAR_TEMP_6, 1)
    if (flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        end
    }
    lockall
    call(HecatesHollow_EventScript_DistantBark)
    msgbox(format("Somewhere ahead, a dog barks. The barking comes from your right."), MSGBOX_DEFAULT)
    releaseall
    end
}

script HecatesHollow_EventScript_BarkAhead {
    setvar(VAR_TEMP_7, 1)
    if (flag(FLAG_ICHOR_GOT_HECATES_TORCH)) {
        end
    }
    lockall
    call(HecatesHollow_EventScript_DistantBark)
