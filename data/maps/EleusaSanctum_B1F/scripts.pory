// On arrival in a lit stretch (the stair hall, the Ploutonion's landing, the apse):
// full light at once, as ENGINE_API.md §2 asks of ON_TRANSITION.
script EleusaSanctum_B1F_EventScript_LightOnArrival {
    getplayerxy(VAR_TEMP_C, VAR_TEMP_D)
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x18) && var(VAR_TEMP_C) >= 2 && var(VAR_TEMP_C) <= 10 && var(VAR_TEMP_D) >= 3 && var(VAR_TEMP_D) <= 7) {
        setflashlevel(0)
        setvar(VAR_TEMP_8, 1)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x19) && var(VAR_TEMP_C) >= 13 && var(VAR_TEMP_C) <= 23 && var(VAR_TEMP_D) >= 4 && var(VAR_TEMP_D) <= 9) {
        setflashlevel(0)
        setvar(VAR_TEMP_8, 1)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x1A) && var(VAR_TEMP_C) >= 26 && var(VAR_TEMP_C) <= 33 && var(VAR_TEMP_D) >= 3 && var(VAR_TEMP_D) <= 16) {
        setflashlevel(0)
        setvar(VAR_TEMP_8, 1)
    }
    if (flag(FLAG_ICHOR_BRAZIERS_START + 0x1B) && var(VAR_TEMP_C) >= 26 && var(VAR_TEMP_C) <= 32 && var(VAR_TEMP_D) >= 22 && var(VAR_TEMP_D) <= 24) {
        setflashlevel(0)
        setvar(VAR_TEMP_8, 1)
    }
    return
}

