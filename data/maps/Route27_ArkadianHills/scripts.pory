script Route27_ArkadianHills_EventScript_Spring {
    lockall
    msgbox(format("A cold spring under walnut trees.\pGirls from Karyai danced here once, for Artemis.\p"
                  "Builders liked the dance so much they carved the girls as pillars.\pYou drink. You feel better."), MSGBOX_DEFAULT)
    closemessage
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    releaseall
}

script Route27_ArkadianHills_EventScript_Herm {
    lockall
    msgbox(format("EAST: STYMPHALIA. NORTH: ARKADIA.\pA herm of Hermes on the old border, where Lakonia ends and Arkadia begins."))
    call(EventScript_IchorAnointHerm)
    releaseall
}

script Route27_ArkadianHills_EventScript_EastSign {
    msgbox(format("ROUTE 27\nOver the hills into Arkadia. Scouts on the heights."), MSGBOX_SIGN)
    end
}

script Route27_ArkadianHills_EventScript_ForkSign {
    msgbox(format("EAST: STYMPHALIA. NORTH: ARKADIA.\nEAST, UP THE SPUR: the lookout."), MSGBOX_SIGN)
    end
}

script Route27_ArkadianHills_EventScript_NorthSign {
    msgbox(format("ROUTE 27\nSouth: the Karyai spring, Lake Stymphalia and Lakonia."), MSGBOX_SIGN)
    end
}

script Route27_ArkadianHills_EventScript_Tower {
    msgbox(format("From up here you can see the lake, the road, and all of Lakonia. No walls.\pA scout's carved a line on the parapet: WE SEE THEM FIRST."), MSGBOX_SIGN)
    end
}

script Route27_ArkadianHills_EventScript_AresGully {
    msgbox(format("A gully runs down through the ridge toward the lower road.\pSpear-butts have worn the rock smooth. Somebody waits down there, some nights, to ambush the columns."), MSGBOX_SIGN)
    end
}
