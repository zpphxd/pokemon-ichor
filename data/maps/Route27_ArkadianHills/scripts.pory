script Route27_ArkadianHills_EventScript_CacheWatch {
    if (flag(FLAG_ICHOR_HELM_ON) || flag(FLAG_ICHOR_ACT3_COMPLETE)) {
        end
    }
    lockall
    playse(SE_PIN)
    msgbox(format("WATCHMAN: Halt. The column's stores.\pNobody comes in here that I can see. Back to the road."), MSGBOX_DEFAULT)
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
    waitmovement(0)
    releaseall
}

script Route27_ArkadianHills_EventScript_Plank {
    setmetatile(33, 9, 0x36C, FALSE)
    setmetatile(33, 10, 0x374, FALSE)
    setmetatile(33, 11, 0x37C, FALSE)
    return
}

script Route27_ArkadianHills_EventScript_DrawSeal {
    if (flag(FLAG_ICHOR_R27_LOOKOUT_PLANK)) {
        call(Route27_ArkadianHills_EventScript_Plank)
        setobjectxyperm(LOCALID_ROUTE27_ARKADIAN_HILLS_DRUM1, 31, 12)
        setobjectxyperm(LOCALID_ROUTE27_ARKADIAN_HILLS_DRUM2, 35, 12)
    }
}

script Route27_ArkadianHills_EventScript_Sills {
    if (flag(FLAG_ICHOR_R27_LOOKOUT_PLANK)) {
        end
    }
    getobjectxy(LOCALID_ROUTE27_ARKADIAN_HILLS_DRUM1, CURRENT_POSITION, VAR_0x8007, VAR_0x8008)
    getobjectxy(LOCALID_ROUTE27_ARKADIAN_HILLS_DRUM2, CURRENT_POSITION, VAR_0x8009, VAR_0x800A)
    if (var(VAR_0x8007) == 31 && var(VAR_0x8008) == 12 && var(VAR_0x8009) == 35 && var(VAR_0x800A) == 12) {
        lockall
        setflag(FLAG_ICHOR_R27_LOOKOUT_PLANK)
        playse(SE_DOOR)
        delay(20)
        call(Route27_ArkadianHills_EventScript_Plank)
        special(DrawWholeMapView)
        playse(SE_M_STRENGTH)
        msgbox(format("Both drums sit true on their sills. Somewhere a rope runs out,\p"
                      "and an old plank swings down across the chasm to the watchtower."), MSGBOX_DEFAULT)
        releaseall
    } elif (var(VAR_0x8007) == 31 && var(VAR_0x8008) == 12) {
        msgbox(format("The drum settles on the grooved sill. One sill to go."), MSGBOX_AUTOCLOSE)
    } elif (var(VAR_0x8009) == 35 && var(VAR_0x800A) == 12) {
        msgbox(format("The drum settles on the grooved sill. One sill to go."), MSGBOX_AUTOCLOSE)
    }
}

script Route27_ArkadianHills_EventScript_Lever {
    lockall
    if (flag(FLAG_ICHOR_R27_LOOKOUT_PLANK)) {
        msgbox(format("A scouts' post with a rope knotted round it. The plank's down."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("A scouts' post, the Girdle's knot carved in it: the old drill's reset.\pRoll the drums back where they lay?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_CLICK)
        warpsilent(MAP_ROUTE27_ARKADIAN_HILLS, 28, 13)
        waitstate
    }
    releaseall
}

script Route27_ArkadianHills_EventScript_Cascade {
    lockall
    if (!flag(FLAG_ICHOR_GOT_HORN_OF_ACHELOUS)) {
        msgbox(format("The Karyai spring's overflow falls down the rock in a white rope.\p"
                      "Something glints in the basin at the top. A river god's horn could climb water like this."), MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox(format("The spring's overflow falls in a white rope.\pSound the Horn of Achelous and climb it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_WATERFALL)
        fadescreen(FADE_TO_WHITE)
        warpsilent(MAP_ROUTE27_ARKADIAN_HILLS, 2, 8)
        waitstate
    }
    releaseall
}

script Route27_ArkadianHills_EventScript_CascadeDown {
    lockall
    msgbox(format("The fall drops away to the pool below. Ride it down?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        playse(SE_M_WATERFALL)
        fadescreen(FADE_TO_WHITE)
        warpsilent(MAP_ROUTE27_ARKADIAN_HILLS, 2, 15)
        waitstate
    }
