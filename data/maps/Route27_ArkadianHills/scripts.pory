script Route27_ArkadianHills_EventScript_TITYOS {
    trainerbattle_single(TRAINER_ICHOR_TITYOS, format("My goats climb better than you. They battle better too. Watch."), format("The goats are disappointed in me."))
    msgbox(format("There's a watchtower past the spring, over a chasm.\pOld scouts' drums lie about the yard. Only a strong back moves those."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_KORE {
    trainerbattle_single(TRAINER_ICHOR_R27_KORE, format("One of my kids went into the cave. Nobody goes into the cave."), format("Fine. You go into the cave."))
    msgbox(format("The scouts' cave climbs to a terrace over the road. It's dark as a pocket in there."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_LOCHAGOS {
    trainerbattle_single(TRAINER_ICHOR_R27_LOCHAGOS, format("The narrows are mine. The Skiritai held them for Lakonia since before your grandmother."), format("Held, and lost. Pass."))
    msgbox(format("Othryades keeps the ravine bridge. He hasn't stepped off it in a week."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_OTHRYADES {
    trainerbattle_single(TRAINER_ICHOR_OTHRYADES, format("One bridge. One scout. That's me, and that's the bridge."), format("Still standing. Mostly. Fine. Cross."))
    msgbox(format("A strap from Gylippos? Give it here. My staff's his twin."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_AGRIA {
    trainerbattle_single(TRAINER_ICHOR_R27_AGRIA, format("Artemis's border. The Karyai maidens danced here. I fight here. Same thing, she says."), format("She'll forgive me. She forgives hunters."))
    msgbox(format("Arkadia's over the pass. Walk soft in the cypresses; the Huntress listens."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_KARYATIS {
    trainerbattle_single(TRAINER_ICHOR_R27_KARYATIS, format("I came for the spring. Everybody comes for the spring. Battle while you drink?"), format("Spilled it."))
    msgbox(format("The builders carved the Karyai girls as pillars. Holding up a roof forever.\pI'd rather dance."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_PHOROS {
    trainerbattle_single(TRAINER_ICHOR_R27_PHOROS, format("I'm not a deserter. I'm resting. In the opposite direction."), format("Resting harder now."))
    msgbox(format("There's a crack in the ravine with a ring at its lip. Somebody tied off down there once."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_SKOPOS {
    trainerbattle_single(TRAINER_ICHOR_R27_SKOPOS, format("This is the watchtower's yard. You want the tower, you move the drums. That's the test."), format("You passed the other test. The battle one."))
    msgbox(format("Two sills, two drums. The old scouts dropped the plank when both sat true."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_ANABATES {
    trainerbattle_single(TRAINER_ICHOR_R27_ANABATES, format("You took the stair! Nobody takes the stair. It's all knees."), format("All knees, and now no battle."))
    msgbox(format("From up here you can count the helmets on the lower road. I stopped at a thousand."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_STHENELAIDAS {
    trainerbattle_single(TRAINER_ICHOR_STHENELAIDAS, format("Last scout on the road. I'll keep it short. Battle."), format("Short. Like I said."))
    msgbox(format("Arkadia's over the rise. Cypresses. Wolves at night. Mind both."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_ArkadianHills_EventScript_R27_KYNEGOS {
    trainerbattle_single(TRAINER_ICHOR_R27_KYNEGOS, format("Wolf tracks in the pines. I'm following them. You're in the way."), format("The wolves can wait."))
    msgbox(format("Lykanax hunt these pines after dark. Arkadia's wolves, come down for the border."), MSGBOX_AUTOCLOSE)
    end
}

