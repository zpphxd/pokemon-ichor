// Akti Town: the harbor of Kalliste. SCRIPT.md beats 6 and 8, and the Akti roster.
//
// Scene state lives in flags, and the coord triggers are gated by temp vars that
// ON_TRANSITION sets from them:
//   VAR_TEMP_1 == 0  the arrival scene (beat 6) waits on the south road
//   VAR_TEMP_2 == 1  beat 8 part 1 plays as soon as the player steps out of the temple
//   VAR_TEMP_2 == 2  ...or, if they came in another way, on the temple doorstep (19,17)
//   VAR_TEMP_3 == 1  beat 8 part 2 waits on the quay, on the line x = 10 (rows 9-11),
//                    the only way into the trireme's end of the quay
//   VAR_TEMP_4 == 1  Phase 2 beat 9B: the wind turns as soon as the player arrives
//   VAR_TEMP_4 == 2  ...and the quay scene waits on the same line, x = 10 (rows 9-11)
// FLAG_ICHOR_HIDE_ALETHEA_AKTI doubles as "part 1 has not played yet": it is set
// until the Hearth Laurel and cleared by part 1. After the slice Alethea waits on
// the quay (the pointer to Halia) until she boards in beat 9B.

mapscripts AktiTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_ICHOR_VISITED_AKTI)
        // Kapra the goat is loose until the player sends her home.
        if (flag(FLAG_ICHOR_AKTI_GOAT_HOME)) {
            setflag(FLAG_ICHOR_HIDE_AKTI_LOOSE_GOAT)
        } else {
            clearflag(FLAG_ICHOR_HIDE_AKTI_LOOSE_GOAT)
        }
        if (flag(FLAG_ICHOR_ARRIVED_AKTI)) {
            setvar(VAR_TEMP_1, 1)
        }
        if (flag(FLAG_ICHOR_SLICE_COMPLETE)) {
            setflag(FLAG_ICHOR_HIDE_KLEON_AKTI)
            if (flag(FLAG_ICHOR_WINDS_TURNED)) {
                setflag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)
            } else {
                clearflag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)
            }
        } elif (!flag(FLAG_BADGE01_GET)) {
            setflag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)
        } elif (flag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)) {
            setvar(VAR_TEMP_2, 1)
        } else {
            setvar(VAR_TEMP_3, 1)
        }
        call(AktiTown_EventScript_SetUpPhase2)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_2, 1: AktiTown_EventScript_HarborPart1Check
        VAR_TEMP_4, 1: AktiTown_EventScript_WindsTurn
    ]
}

// ---------------------------------------------------------------------------
// Speakers
// ---------------------------------------------------------------------------

text AktiTown_Text_NameDiktys { "DIKTYS" }
text AktiTown_Text_NameNausikles { "NAUSIKLES" }
text AktiTown_Text_NameKleon { "KLEON" }
text AktiTown_Text_NameAlethea { "ALETHEA" }
text AktiTown_Text_NameHydna { "HYDNA" }

// ---------------------------------------------------------------------------
// Beat 6: arriving in Akti. Diktys gets up from his nets and meets the player
// on the south road. One trigger per seam column, so he walks to the right spot.
// ---------------------------------------------------------------------------

script AktiTown_EventScript_ArrivalX10 {
    setvar(VAR_0x8008, 10)
    goto(AktiTown_EventScript_Arrival)
}

script AktiTown_EventScript_ArrivalX11 {
    setvar(VAR_0x8008, 11)
    goto(AktiTown_EventScript_Arrival)
}

script AktiTown_EventScript_ArrivalX12 {
    setvar(VAR_0x8008, 12)
    goto(AktiTown_EventScript_Arrival)
}

script AktiTown_EventScript_ArrivalX13 {
    setvar(VAR_0x8008, 13)
    goto(AktiTown_EventScript_Arrival)
}

script AktiTown_EventScript_Arrival {
    lockall
    setvar(VAR_TEMP_1, 1)
    setflag(FLAG_ICHOR_ARRIVED_AKTI)
    // No setrespawn here: per SCRIPT.md beat 6, only the Asclepeion makes Akti the
    // respawn point.
    playse(SE_PIN)
    applymovement(LOCALID_AKTI_DIKTYS, Common_Movement_ExclamationMark)
    waitmovement(0)
    switch (var(VAR_0x8008)) {
        case 10: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysToX10)
        case 11: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysToX11)
        case 12: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysToX12)
        default: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysToX13)
    }
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_FaceUp)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameDiktys)
    msgbox(format("A traveler! From the festival, by the look of those sandals.\p"
                  "Welcome to Akti. Here's the whole town in one breath:\p"
                  "Asclepeion on your left, for tired Pokémon.\p"
                  "Temple of Hestia on your right, for tired challengers.\p"
                  "Agora up the hill. And the sea straight ahead. Can't miss it.\p"
                  "I tried once. Fell right in."))
    closemessage
    switch (var(VAR_0x8008)) {
        case 10: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysFromX10)
        case 11: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysFromX11)
        case 12: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysFromX12)
        default: applymovement(LOCALID_AKTI_DIKTYS, AktiTown_Movement_DiktysFromX13)
    }
    waitmovement(0)
    releaseall
}

// Diktys sits by his boat at (9,25); he stops just north of the player on the road.
movement AktiTown_Movement_DiktysToX10 { walk_right walk_down }
movement AktiTown_Movement_DiktysToX11 { walk_right * 2 walk_down }
movement AktiTown_Movement_DiktysToX12 { walk_right * 3 walk_down }
movement AktiTown_Movement_DiktysToX13 { walk_right * 4 walk_down }
movement AktiTown_Movement_DiktysFromX10 { walk_up walk_left face_right }
movement AktiTown_Movement_DiktysFromX11 { walk_up walk_left * 2 face_right }
movement AktiTown_Movement_DiktysFromX12 { walk_up walk_left * 3 face_right }
movement AktiTown_Movement_DiktysFromX13 { walk_up walk_left * 4 face_right }
movement AktiTown_Movement_FaceUp { face_up }
movement AktiTown_Movement_FaceDown { face_down }
movement AktiTown_Movement_FaceLeft { face_left }
movement AktiTown_Movement_FaceRight { face_right }

// ---------------------------------------------------------------------------
// Beat 8, part 1: Alethea finds the player on the temple doorstep.
// ---------------------------------------------------------------------------

script AktiTown_EventScript_HarborPart1Check {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 19 && var(VAR_0x8005) == 17) {
        goto(AktiTown_EventScript_HarborPart1)
    }
    // Not fresh out of the temple (a whiteout, say): wait on the doorstep instead.
    setvar(VAR_TEMP_2, 2)
    end
}

script AktiTown_EventScript_HarborPart1 {
    lockall
    setvar(VAR_TEMP_2, 0)
    clearflag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)
    setobjectxyperm(LOCALID_AKTI_ALETHEA, 12, 27)
    addobject(LOCALID_AKTI_ALETHEA)
    applymovement(LOCALID_AKTI_ALETHEA, AktiTown_Movement_AletheaRunsToTemple)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_FaceDown)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameAlethea)
    msgbox(format("{PLAYER}! You did it! Let me see the laurel.\p"
                  "…It smells like woodsmoke. And soup?\p"
                  "I showed Daphne the tablet. She went very quiet.\p"
                  "She thinks “where the grain goes underground” means Eleusa.\p"
                  "On the mainland. Where they keep the Mysteries.\p"
                  "So, truthfully? We need a ship. Come on, the quay!"))
    closemessage
    applymovement(LOCALID_AKTI_ALETHEA, AktiTown_Movement_AletheaHeadsForQuay)
    waitmovement(0)
    // She is off screen now: put her by the trireme, where part 2 finds her.
    // removeobject sets her hide flag, so clear it again before addobject: the
    // flag is how ON_TRANSITION tells part 1 from part 2 after a trip indoors.
    removeobject(LOCALID_AKTI_ALETHEA)
    setobjectxyperm(LOCALID_AKTI_ALETHEA, 7, 10)
    clearflag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)
    addobject(LOCALID_AKTI_ALETHEA)
    setvar(VAR_TEMP_3, 1)
    releaseall
}

// From the south road (12,27), just off screen, across the plaza and up to the
// foot of the temple stairs (19,18), below the player.
movement AktiTown_Movement_AletheaRunsToTemple {
    walk_fast_up * 8
    walk_fast_right * 7
    walk_fast_up
    face_up
}

// Back across the plaza and up the harbor street, out of sight of the temple.
movement AktiTown_Movement_AletheaHeadsForQuay {
    walk_down
    walk_left * 6
    walk_up * 7
}

// ---------------------------------------------------------------------------
// Beat 8, part 2: the trireme that sails when the winds turn.
// The player crosses x = 10 on the quay and walks up to the group: Nausikles on
// the trireme's steps at (7,9) with the rower beside him at (8,9), Alethea at
// (7,10) and Kleon at (5,10). The player ends at (8,10), beside Alethea.
// ---------------------------------------------------------------------------

script AktiTown_EventScript_HarborPart2Row9 {
    setvar(VAR_0x8008, 9)
    goto(AktiTown_EventScript_HarborPart2)
}

script AktiTown_EventScript_HarborPart2Row10 {
    setvar(VAR_0x8008, 10)
    goto(AktiTown_EventScript_HarborPart2)
}

script AktiTown_EventScript_HarborPart2Row11 {
    setvar(VAR_0x8008, 11)
    goto(AktiTown_EventScript_HarborPart2)
}

// Talking to the group first (the player is already beside them).
script AktiTown_EventScript_HarborPart2Talk {
    setvar(VAR_0x8008, 0)
    goto(AktiTown_EventScript_HarborPart2)
}

script AktiTown_EventScript_HarborPart2 {
    lockall
    setvar(VAR_TEMP_3, 0)
    switch (var(VAR_0x8008)) {
        case 9: applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_PlayerToQuayFrom9)
        case 10: applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_PlayerToQuayFrom10)
        case 11: applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_PlayerToQuayFrom11)
    }
    waitmovement(0)
    applymovement(LOCALID_AKTI_ALETHEA, AktiTown_Movement_FaceUp)
    applymovement(LOCALID_AKTI_NAUSIKLES, AktiTown_Movement_FaceDown)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameAlethea)
    msgbox(format("Captain! Two for the mainland. Emporion, please."))
    setspeaker(AktiTown_Text_NameNausikles)
    msgbox(format("Gladly. The Euploia sails the moment the winds turn."))
    setspeaker(AktiTown_Text_NameAlethea)
    msgbox(format("And when will that be?"))
    setspeaker(AktiTown_Text_NameNausikles)
    msgbox(format("Ha! It's halcyon days, girl. The kingfishers are nesting.\p"
                  "Aeolus keeps the sea flat as a plate until they're done.\p"
                  "A few days. A week. Ask the birds, not me.\p"
                  "Strange year, though. They nested early.\p"
                  "And the tide's been running backward at night. Never seen it."))
    applymovement(LOCALID_AKTI_KLEON, AktiTown_Movement_FaceRight)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameKleon)
    msgbox(format("A week?! I'll have beaten Ione three times by then.\p"
                  "…You've got the laurel. Already.\p"
                  "Of course you do.\p"
                  "Fine. I'll win mine tomorrow. Then we race to the mainland.\p"
                  "First to the next laurel wins. Deal?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox(format("Ha! Deal. Try to keep up, shipmate."))
    } else {
        msgbox(format("Too bad. It's a deal anyway. Lakonians don't take “no.”"))
    }
    closemessage
    applymovement(LOCALID_AKTI_KLEON, AktiTown_Movement_KleonLeaves)
    waitmovement(0)
    removeobject(LOCALID_AKTI_KLEON)
    setflag(FLAG_ICHOR_HIDE_KLEON_AKTI)
    applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_FaceUp)
    waitmovement(0)
    delay(60)
    msgbox(format("The ribbon on the trireme's mast hangs perfectly still.\p"
                  "Across the flat water, the mainland waits."))
    closemessage
    setflag(FLAG_ICHOR_SLICE_COMPLETE)
    // Phase 2 (SCRIPT.md beat 9A, the pointer): Alethea has news from Elaia.
    applymovement(LOCALID_AKTI_ALETHEA, AktiTown_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_FaceLeft)
    waitmovement(0)
    call(AktiTown_EventScript_AletheaPointer)
    releaseall
}

script AktiTown_EventScript_AletheaPointer {
    setspeaker(AktiTown_Text_NameAlethea)
    msgbox(format("Halia sent a gull. She wants to see you before we sail.\p"
                  "Truthfully, she wrote “NOW.” In very big letters."))
    closemessage
}

movement AktiTown_Movement_PlayerToQuayFrom9 { walk_down walk_left * 2 face_left }
movement AktiTown_Movement_PlayerToQuayFrom10 { walk_left * 2 face_left }
movement AktiTown_Movement_PlayerToQuayFrom11 { walk_up walk_left * 2 face_left }

// Off toward the Asclepeion: along the back of the quay and down the harbor street.
movement AktiTown_Movement_KleonLeaves {
    walk_down
    walk_right * 6
    walk_down * 5
}

// ---------------------------------------------------------------------------
// The people of Akti
// ---------------------------------------------------------------------------

script AktiTown_EventScript_Diktys {
    lock
    faceplayer
    setspeaker(AktiTown_Text_NameDiktys)
    msgbox(format("Mending nets. Mending boats. Mostly mending my pride.\p"
                  "My grandfather pulled a whole chest out of the sea once.\p"
                  "Had a woman and a baby in it. Or so he said. He drank."))
    release
}

script AktiTown_EventScript_Nausikles {
    if (flag(FLAG_BADGE01_GET) && !flag(FLAG_ICHOR_SLICE_COMPLETE) && !flag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)) {
        goto(AktiTown_EventScript_HarborPart2Talk)
    }
    if (flag(FLAG_ICHOR_CROSSING_DONE)) {
        setvar(VAR_0x8004, 0)
        goto(Ichor_EventScript_FerryQuay)
    }
    if (flag(FLAG_ICHOR_WINDS_TURNED)) {
        goto(AktiTown_EventScript_Board)
    }
    lock
    faceplayer
    setspeaker(AktiTown_Text_NameNausikles)
    if (flag(FLAG_ICHOR_SLICE_COMPLETE)) {
        msgbox(format("Still flat. Still waiting. Go catch something, I'll shout."))
    } elif (flag(FLAG_BADGE01_GET)) {
        msgbox(format("We sail when the winds turn, and they haven't."))
    } else {
        msgbox(format("The mainland? Not without a laurel, young one.\p"
                      "Emporion won't let you off the dock without one.\p"
                      "Besides. We sail when the winds turn, and they haven't."))
    }
    release
}

script AktiTown_EventScript_Kleon {
    if (flag(FLAG_BADGE01_GET) && !flag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)) {
        goto(AktiTown_EventScript_HarborPart2Talk)
    }
    lock
    faceplayer
    setspeaker(AktiTown_Text_NameKleon)
    msgbox(format("Don't ask how it went with Ione.\p"
                  "…Fine. She beat me. Then she fed me soup.\p"
                  "Soup! I've never been so insulted in my life.\p"
                  "Tomorrow I'll beat her. Then I'll eat the soup. Out of respect."))
    release
}

script AktiTown_EventScript_Alethea {
    if (!flag(FLAG_ICHOR_SLICE_COMPLETE)) {
        goto(AktiTown_EventScript_HarborPart2Talk)
    }
    lock
    faceplayer
    if (flag(FLAG_ICHOR_HALIA_SECOND_LOOK)) {
        setspeaker(AktiTown_Text_NameAlethea)
        msgbox(format("The kingfishers can't sit on those eggs forever. Can they?"))
    } else {
        call(AktiTown_EventScript_AletheaPointer)
    }
    release
}

script AktiTown_EventScript_Rower {
    msgbox(format("Wind.\p"
                  "…None.\p"
                  "That was a whole Lakonian weather report."), MSGBOX_NPC)
}

script AktiTown_EventScript_Hydna {
    lock
    faceplayer
    setspeaker(AktiTown_Text_NameHydna)
    if (flag(FLAG_ICHOR_GOT_MYSTIC_WATER)) {
        msgbox(format("The water's been strange at night. Too still. Even for halcyon days."))
        release
        end
    }
    msgbox(format("I dive for sponges. Holding my breath is the easy part.\p"
                  "Found this on the seabed yesterday. Bad luck to keep sea-gifts."))
    setspeaker(SP_NAME_NONE)
    giveitem(ITEM_MYSTIC_WATER)
    if (var(VAR_RESULT) == FALSE) {
        call(Common_EventScript_ShowBagIsFull)
        release
        end
    }
    setflag(FLAG_ICHOR_GOT_MYSTIC_WATER)
    setspeaker(AktiTown_Text_NameHydna)
    msgbox(format("Give it to your Water Pokémon. The sea likes to be shared."))
    release
}

script AktiTown_EventScript_Fishwife {
    msgbox(format("Octopus! Fresh octopus! Still arguing!"), MSGBOX_NPC)
}

script AktiTown_EventScript_OldWoman {
    msgbox(format("Ione keeps the fire. Her mother kept it. Her mother's mother.\p"
                  "It hasn't gone out in three hundred years.\p"
                  "Well. Once. But we don't talk about that."), MSGBOX_NPC)
}

script AktiTown_EventScript_Pilgrim {
    msgbox(format("I'm just back from Delphoi. Long way to go for so little.\p"
                  "The Pythia used to give whole verses. Riddles, rhymes.\p"
                  "Now it's one word. Sometimes only “soon.”"), MSGBOX_NPC)
}

script AktiTown_EventScript_Kid {
    msgbox(format("When I grow up I'm going to be a Hierophant. Of fish.\p"
                  "There's no temple for fish. That's why it's a good idea."), MSGBOX_NPC)
}

// ---------------------------------------------------------------------------
// Signs and scenery
// ---------------------------------------------------------------------------

script AktiTown_EventScript_TownSign {
    msgbox(format("AKTI TOWN\nHarbor of Kalliste. Mind the nets."), MSGBOX_SIGN)
}

script AktiTown_EventScript_TempleSign {
    msgbox(format("TEMPLE OF HESTIA\nHierophant: Ione, the Hearthkeeper.\p"
                  "All guests welcome. All guests fed."), MSGBOX_SIGN)
}

script AktiTown_EventScript_AsclepeionSign {
    msgbox(format("ASCLEPEION\nRest for Pokémon and the weary, by the grace of Asclepius."), MSGBOX_SIGN)
}

script AktiTown_EventScript_AgoraSign {
    msgbox(format("AGORA\nFair goods at fair prices. Mostly fair."), MSGBOX_SIGN)
}

script AktiTown_EventScript_QuaySign {
    msgbox(format("THE QUAY\nTrireme to the mainland sails when the winds turn."), MSGBOX_SIGN)
}

script AktiTown_EventScript_FishersHouseSign {
    msgbox(format("GLAUKOS. Gone fishing.\n(Not really. Knock.)"), MSGBOX_SIGN)
}

// The goats in Aigon's pen.
script AktiTown_EventScript_Goat {
    lock
    faceplayer
    playmoncry(SPECIES_SKIDDO, CRY_MODE_NORMAL)
    msgbox(format("Mehhh! It's chewing a clothes peg."))
    waitmoncry
    release
}

// Kapra, Aigon's escape artist, eating the Fisher's washing. Talking to her sends
// her home to the pen (Aigon then gives her old bell in his farmhouse).
script AktiTown_EventScript_LooseGoat {
    lock
    faceplayer
    playmoncry(SPECIES_SKIDDO, CRY_MODE_NORMAL)
    msgbox(format("Mehhh! It has a wet sock in its mouth.\p"
                  "It looks at you. It looks at the goat pen.\p"
                  "It trots off home, sock and all."))
    waitmoncry
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_AKTI_KAPRA)
    setflag(FLAG_ICHOR_AKTI_GOAT_HOME)
    fadescreen(FADE_FROM_BLACK)
    release
}

// ---------------------------------------------------------------------------
// Relic gates (SYSTEMS.md §1, D10): seen in the slice, opened later. Only the
// locked side exists yet.
// - The rubble grotto on the tide rocks opens with the Bronze Hammer (Act I).
//   Inside: a Kalliste amphora sherd spot, a Pearl and a rare shore Pokémon.
// - The islet shrine opens with Poseidon's Conch (Act II, Surf). On it: a
//   Poseidon altar, a Water-type rare and a hidden Big Pearl.
// ---------------------------------------------------------------------------

script AktiTown_EventScript_GrottoRubble {
    msgbox(format("Broken marble chokes the mouth of a sea grotto.\p"
                  "Something glints in the dark behind it.\p"
                  "The blocks won't shift by hand. A good hammer would break them."), MSGBOX_SIGN)
}

script AktiTown_EventScript_IsletFisher {
    msgbox(format("That white shrine out on the islet is Poseidon's.\p"
                  "No one's set foot on it since the storm.\p"
                  "Row for it, and the current turns you right round.\p"
                  "The gulls get all his offerings now."), MSGBOX_NPC)
}

// ---------------------------------------------------------------------------
// Phase 2 beat 9B: the winds turn, and Mom (design/phase2/SCRIPT.md).
// After Halia's second look (beat 9A), Mom waits on the quay at (4,11) and
// Kleon by the Temple of Hestia's door at (20,17). Entering Akti, the wind
// comes back (on frame); the quay scene plays on the line x = 10, rows 9-11,
// which every way to the trireme crosses. The player is walked to (10,10).
// ---------------------------------------------------------------------------

text AktiTown_Text_NameMom { "MOM" }

script AktiTown_EventScript_SetUpPhase2 {
    if (flag(FLAG_ICHOR_HALIA_SECOND_LOOK) && !flag(FLAG_ICHOR_BOARDED_EUPLOIA)) {
        clearflag(FLAG_ICHOR_HIDE_MOM_AKTI)
    } else {
        setflag(FLAG_ICHOR_HIDE_MOM_AKTI)
    }
    if (flag(FLAG_ICHOR_HALIA_SECOND_LOOK) && !flag(FLAG_ICHOR_WINDS_TURNED)) {
        clearflag(FLAG_ICHOR_HIDE_KLEON_AKTI_DOOR)
        setvar(VAR_TEMP_4, 1)
    } else {
        setflag(FLAG_ICHOR_HIDE_KLEON_AKTI_DOOR)
    }
}

script AktiTown_EventScript_WindsTurn {
    lockall
    setvar(VAR_TEMP_4, 2)
    delay(20)
    playmoncry(SPECIES_HALCYLING, CRY_MODE_NORMAL)
    waitmoncry
    playse(SE_M_GUST)
    waitse
    setspeaker(AktiTown_Text_NameNausikles)
    msgbox(format("WIND! Wind from the south!\p"
                  "Everyone aboard who's coming aboard!"))
    closemessage
    releaseall
}

script AktiTown_EventScript_WindsQuayRow9 {
    setvar(VAR_0x8008, 9)
    goto(AktiTown_EventScript_WindsQuay)
}

script AktiTown_EventScript_WindsQuayRow10 {
    setvar(VAR_0x8008, 10)
    goto(AktiTown_EventScript_WindsQuay)
}

script AktiTown_EventScript_WindsQuayRow11 {
    setvar(VAR_0x8008, 11)
    goto(AktiTown_EventScript_WindsQuay)
}

script AktiTown_EventScript_WindsQuay {
    lockall
    setvar(VAR_TEMP_4, 3)
    switch (var(VAR_0x8008)) {
        case 9: applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_WindsPlayerFrom9)
        case 10: applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_FaceLeft)
        case 11: applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_WindsPlayerFrom11)
    }
    waitmovement(0)
    // Alethea runs up from the quay and stops in front of the player.
    applymovement(LOCALID_AKTI_ALETHEA, AktiTown_Movement_WindsAletheaRuns)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameAlethea)
    msgbox(format("{PLAYER}! Did you hear? The kingfishers are done nesting!\p"
                  "The halcyon days are over. We're sailing!"))
    closemessage
    // Kleon runs out of the Temple of Hestia, waving something green. He comes
    // up the harbor street (off screen until then) to stop beside Alethea.
    setobjectxyperm(LOCALID_AKTI_KLEON_DOOR, 12, 16)
    removeobject(LOCALID_AKTI_KLEON_DOOR)
    clearflag(FLAG_ICHOR_HIDE_KLEON_AKTI_DOOR)
    addobject(LOCALID_AKTI_KLEON_DOOR)
    setspeaker(AktiTown_Text_NameKleon)
    msgbox(format("WAIT! Wait for me! Look at this!"))
    closemessage
    applymovement(LOCALID_AKTI_KLEON_DOOR, AktiTown_Movement_WindsKleonRuns)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_FaceDown)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameKleon)
    msgbox(format("The Hearth Laurel. I beat her. Last night. By lamplight.\p"
                  "Ione got up specially. In her nightdress. Then she fed me soup.\p"
                  "I ate the soup. Out of respect."))
    applymovement(OBJ_EVENT_ID_PLAYER, AktiTown_Movement_FaceLeft)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameAlethea)
    msgbox(format("Congratulations, Kleon. Truthfully."))
    setspeaker(AktiTown_Text_NameKleon)
    msgbox(format("So we're even. One laurel each. The race starts now!"))
    closemessage
    // Up the gangplank, and aboard.
    applymovement(LOCALID_AKTI_ALETHEA, AktiTown_Movement_WindsAletheaBoards)
    applymovement(LOCALID_AKTI_KLEON_DOOR, AktiTown_Movement_WindsKleonBoards)
    waitmovement(0)
    removeobject(LOCALID_AKTI_ALETHEA)
    removeobject(LOCALID_AKTI_KLEON_DOOR)
    setflag(FLAG_ICHOR_HIDE_ALETHEA_AKTI)
    setflag(FLAG_ICHOR_HIDE_KLEON_AKTI_DOOR)
    // Mom walks over from the quay's edge.
    applymovement(LOCALID_AKTI_MOM, AktiTown_Movement_WindsMomComes)
    waitmovement(0)
    setspeaker(AktiTown_Text_NameMom)
    msgbox(format("There you are. I brought bread. And honey. Not from that jar.\p"
                  "Don't look at me like that. I'm not crying. It's the wind.\p"
                  "I'm not coming across. I don't cross water. You know that.\p"
                  "…\p"
                  "Wherever you end up, come back up the hill. That's all."))
    setspeaker(SP_NAME_NONE)
    giveitem(ITEM_HONEY, 2)
    setflag(FLAG_ICHOR_MOM_HARBOR)
    setspeaker(AktiTown_Text_NameMom)
    msgbox(format("Go on. That Lakonian boy's already halfway up the mast."))
    closemessage
    applymovement(LOCALID_AKTI_MOM, AktiTown_Movement_WindsMomGoes)
    waitmovement(0)
    setflag(FLAG_ICHOR_WINDS_TURNED)
    releaseall
}

// From the line x = 10 to (10,10), facing the trireme's end of the quay.
movement AktiTown_Movement_WindsPlayerFrom9 { walk_down face_left }
movement AktiTown_Movement_WindsPlayerFrom11 { walk_up face_left }
// Alethea (7,10) to (9,10), in front of the player.
movement AktiTown_Movement_WindsAletheaRuns { walk_fast_right * 2 face_right }
// Kleon from the harbor street (12,16) up to the quay and round to (9,11).
movement AktiTown_Movement_WindsKleonRuns { walk_fast_up * 5 walk_fast_left * 3 face_right }
// Both up the gangplank at x = 6, onto the trireme.
movement AktiTown_Movement_WindsAletheaBoards { walk_left * 3 walk_up * 2 }
movement AktiTown_Movement_WindsKleonBoards { delay_16 delay_16 walk_left * 3 walk_up * 3 }
// Mom from (4,11) to (9,10), and back to face the sea.
movement AktiTown_Movement_WindsMomComes { walk_right * 5 walk_up face_right }
movement AktiTown_Movement_WindsMomGoes { walk_down walk_left * 5 face_up }

script AktiTown_EventScript_Mom {
    lock
    faceplayer
    setspeaker(AktiTown_Text_NameMom)
    if (flag(FLAG_ICHOR_WINDS_TURNED)) {
        msgbox(format("Go. Before I change my mind for you."))
    } else {
        msgbox(format("I came down to see the boat. Just the boat. Don't fuss."))
    }
    release
}

script AktiTown_EventScript_KleonDoor {
    lock
    faceplayer
    setspeaker(AktiTown_Text_NameKleon)
    msgbox(format("Don't look in my bag. There's nothing in my bag.\p"
                  "Go down to the harbor. Go on. I'll be along. Casually."))
    release
}

script AktiTown_EventScript_Board {
    lock
    faceplayer
    setspeaker(AktiTown_Text_NameNausikles)
    msgbox(format("All aboard for Emporion? Once we're out, we don't turn back."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Don't be long. Wind's like a cat. It leaves when it likes."))
        release
        end
    }
    msgbox(format("Good. Mind the oars. They don't mind you."))
    closemessage
    setflag(FLAG_ICHOR_BOARDED_EUPLOIA)
    // Mom goes back up the hill once the Euploia has sailed.
    setflag(FLAG_ICHOR_HIDE_MOM_AKTI)
    clearflag(FLAG_ICHOR_HIDE_MOM_HOME)
    playse(SE_EXIT)
    fadescreen(FADE_TO_BLACK)
    // The deck's boarding tile (design/phase2/BUILD.md's arrival table).
    warp(MAP_TRIREME_EUPLOIA_DECK, 0)
    waitstate
    release
}
