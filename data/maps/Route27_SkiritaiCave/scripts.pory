const SK_BRAZIER = FLAG_ICHOR_BRAZIERS_START + 0x60
mapscripts Route27_SkiritaiCave_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(SK_BRAZIER)) {
            call(Route27_SkiritaiCave_EventScript_Lit)
        }
    }
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(SK_BRAZIER)) {
            setflashlevel(0)
        }
    }
}

// Generated by tools/ichor/maps/stymphalia.py; edit the builder, not this file.

script Route27_SkiritaiCave_EventScript_SKIRITAI_KRYPTE {
    trainerbattle_single(TRAINER_ICHOR_SKIRITAI_KRYPTE, format("Krypteia. We train in the dark. You're the night's exercise."), format("Exercised."))
    msgbox(format("The old scouts kept a store up the west climb. Bronze chains on it, stamped with an axe."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_SkiritaiCave_EventScript_SKIRITAI_ARKTOS {
    trainerbattle_single(TRAINER_ICHOR_SKIRITAI_ARKTOS, format("Nobody passes the climb's top without a word from Lakonia."), format("That'll do for a word."))
    msgbox(format("Out the high mouth there's a terrace over the valley. Drop off its wall and you're home."), MSGBOX_AUTOCLOSE)
    end
}

script Route27_SkiritaiCave_EventScript_Chains {
    goto(EventScript_IchorLabrysSeal)
}

script Route27_SkiritaiCave_EventScript_Stele {
    msgbox(format("THE SKIRITAI. FIRST INTO BATTLE, LAST OUT.\nThe scouts' names follow, too many to read."), MSGBOX_SIGN)
    end
}

script Route27_SkiritaiCave_EventScript_Arrow {
    msgbox(format("A chalk arrow, pointing up the climb. Under it, in a boy's hand: NOT FAR NOW."), MSGBOX_SIGN)
    end
}

script Route27_SkiritaiCave_EventScript_Brazier {
    setvar(VAR_0x8004, SK_BRAZIER)
    setvar(VAR_0x8005, TRUE)
    call(EventScript_IchorBrazier)
    if (flag(SK_BRAZIER)) {
        call(Route27_SkiritaiCave_EventScript_Lit)
        special(DrawWholeMapView)
    }
    releaseall
}

script Route27_SkiritaiCave_EventScript_Lit {
    setmetatile(14, 6, 0x2FA, TRUE)
    setmetatile(15, 6, 0x2FB, TRUE)
    setmetatile(14, 7, 0x302, TRUE)
    setmetatile(15, 7, 0x303, TRUE)
    return
}
