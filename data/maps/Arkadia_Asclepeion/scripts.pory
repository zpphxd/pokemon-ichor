// The Asclepeion of Arkadia, built against the outcrop round its cave spring (SCRIPT.md
// Part 2, Arkadia interiors). Room: tools/ichor/maps/arkrooms.py. The healer stands at (7,2)
// behind the limestone counter, the player at (7,4); the spring's basin is at her x-2..x-1,
// y-1..y, where FLDEFF_POKECENTER_HEAL sets the party's balls, and the rod of Asclepius is
// cut into the rock above her at (7,1), where its glow lights.
//
// The healer is Akti's shared script (Ichor_EventScript_AsclepeionHealer). The Pithos's
// menu is written out here, because the shared one names Akti's jar.

mapscripts Arkadia_Asclepeion_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_ARKADIA)
    }
}

script Arkadia_Asclepeion_EventScript_Healer {
    setvar(VAR_0x800B, LOCALID_ARKADIA_ASCLEPEION_HEALER)
    call(Ichor_EventScript_AsclepeionHealer)
    waitmessage
    waitbuttonpress
    release
}

script Arkadia_Asclepeion_EventScript_Pithos {
    lockall
    setvar(VAR_0x8004, PC_LOCATION_OTHER)
    msgbox(Ichor_Text_PithosLook)
    msgbox(Ichor_Text_PithosLift)
    goto(Arkadia_Asclepeion_EventScript_PithosMenu)
}

script Arkadia_Asclepeion_EventScript_PithosMenu {
    message(Ichor_Text_PithosReach)
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, Ichor_Text_PithosOptionPokemon,
                   Ichor_Text_PithosOptionThings, Ichor_Text_PithosOptionClose)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox(format("The Pithos of Arkadia opened."))
            msgbox(Ichor_Text_PithosPokemonRest)
            special(ShowPokemonStorageSystemPC)
            goto(Arkadia_Asclepeion_EventScript_PithosMenu)
        case 1:
            msgbox(Ichor_Text_PithosThings)
            special(PlayerPC)
            goto(Arkadia_Asclepeion_EventScript_PithosMenu)
    }
    msgbox(Ichor_Text_PithosClose)
    releaseall
    end
}

text Arkadia_Asclepeion_Name_Panacoil { "PANACOIL" }

script Arkadia_Asclepeion_EventScript_Panacoil {
    lock
    faceplayer
    setspeaker(Arkadia_Asclepeion_Name_Panacoil)
    msgbox(format("Hss."))
    setspeaker(SP_NAME_NONE)
    msgbox(format("It lifts its head out of the water to look at you."))
    release
}

script Arkadia_Asclepeion_EventScript_Huntress {
    msgbox(format("Lykopup bite. My own fault. I put my hand in a hollow tree.\p"
                  "There was a Lykopup asleep in it. He's still angry."), MSGBOX_NPC)
}

script Arkadia_Asclepeion_EventScript_Charcoaler {
    msgbox(format("Smoke in my chest. Forty years of it.\p"
                  "The healer says stop burning charcoal. I said, then what do I breathe?"), MSGBOX_NPC)
}

script Arkadia_Asclepeion_EventScript_YoungHealer {
    msgbox(format("We get bites, falls and thorns. And hunters who swear it was a bear.\p"
                  "It's never a bear. It's always a bramble."), MSGBOX_NPC)
}

script Arkadia_Asclepeion_EventScript_Channel {
    msgbox(format("The spring runs out of the rock and across the floor in a stone channel.\p"
                  "The whole room sounds of water."), MSGBOX_SIGN)
}

script Arkadia_Asclepeion_EventScript_Grating {
    msgbox(format("The channel ends in an iron grating. The water goes down into the hill."), MSGBOX_SIGN)
}

script Arkadia_Asclepeion_EventScript_Herbs {
    msgbox(format("Hunters' herbs, drying under the beam: yarrow for cuts, sage, a twist of willow bark."),
           MSGBOX_SIGN)
}
