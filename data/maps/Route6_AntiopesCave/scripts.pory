// Antiope's cave, off Route 6's spur: a dark dead end that pays (SCRIPT.md Part 2,
// Route 6; Part 5, Antiope's cave). Layout and events are generated by
// tools/ichor/maps/kithairon.py.

mapscripts Route6_AntiopesCave_MapScripts {}

script Route6_AntiopesCave_EventScript_Carving {
    msgbox(format("Two boys are carved into the rock. One holds a lyre. One holds a club.\pScratched under them: AMPHION. ZETHOS. BORN HERE.\pUnder that, smaller: ASK THYRSA WHO BUILT ITS WALLS."), MSGBOX_SIGN)
}

// ICHOR_STUB_RELICS: once the relics land, this is EventScript_IchorBrazier with
// the cave's brazier flag (FLAG_ICHOR_BRAZIERS_START's range), swapping to
// METATILE_KithaironCave_Brazier_LitTop and _Lit, and lit again on load.
script Route6_AntiopesCave_EventScript_Brazier {
    msgbox(format("A bronze brazier, cold. Old ash lies in the bowl."), MSGBOX_SIGN)
}

// ICHOR_STUB_DIG: the fixed dig for the Rare Bone (FLAG_ICHOR_DIG_FIXED_START's range).
script Route6_AntiopesCave_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

// The marked ivy of the Thyrsus walls (Dionysus's gift II, a late-game return).
script Route6_AntiopesCave_EventScript_MarkedIvy {
    msgbox(format("Ivy climbs the rock here, its leaves marked with gold.\pAbove, on a ledge, something glints."), MSGBOX_SIGN)
}
