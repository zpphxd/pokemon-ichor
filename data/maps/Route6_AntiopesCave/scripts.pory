// Antiope's cave, off Route 6's spur: a dark dead end that pays (SCRIPT.md Part 2,
// Route 6; Part 5, Antiope's cave). Layout and events are generated by
// tools/ichor/maps/kithairon.py.

mapscripts Route6_AntiopesCave_MapScripts {
    // The brazier lights the whole cave, for good (FLAG_ICHOR_BRAZIERS_START + 0x20).
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_ICHOR_BRAZIERS_START + 0x20)) {
            setflashlevel(0)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ICHOR_BRAZIERS_START + 0x20)) {
            call(Route6_AntiopesCave_EventScript_SetBrazierLit)
        }
    }
}

script Route6_AntiopesCave_EventScript_SetBrazierLit {
    setmetatile(4, 8, METATILE_KithaironCave_Brazier_LitTop, TRUE)
    setmetatile(4, 9, METATILE_KithaironCave_Brazier_Lit, TRUE)
}

script Route6_AntiopesCave_EventScript_Carving {
    msgbox(format("Two boys are carved into the rock. One holds a lyre. One holds a club.\pScratched under them: AMPHION. ZETHOS. BORN HERE.\pUnder that, smaller: ASK THYRSA WHO BUILT ITS WALLS."), MSGBOX_SIGN)
}

// The cave's one brazier (FLAG_ICHOR_BRAZIERS_START + 0x20): Hecate's Torch lights
// it, and the whole cave is its lit zone.
script Route6_AntiopesCave_EventScript_Brazier {
    setvar(VAR_0x8004, FLAG_ICHOR_BRAZIERS_START + 0x20)
    setvar(VAR_0x8005, TRUE)
    call(EventScript_IchorBrazier)
    if (var(VAR_RESULT) == TRUE) {
        call(Route6_AntiopesCave_EventScript_SetBrazierLit)
        special(DrawWholeMapView)
    }
    releaseall
}

// ICHOR_STUB_DIG: the fixed find in the cave floor, the Rare Bone. It needs a
// fixed-dig index (FLAG_ICHOR_DIG_FIXED_START + 0x15 is proposed); then this becomes:
//   setvar(VAR_0x8004, 0x15)  setvar(VAR_0x8005, ITEM_RARE_BONE)
//   goto(EventScript_IchorDigFixed)
script Route6_AntiopesCave_EventScript_DigSpot {
    msgbox(format("The earth here has been turned. Something might be buried."), MSGBOX_SIGN)
}

// The marked ivy of the Thyrsus walls (Dionysus's gift II, a late-game return).
script Route6_AntiopesCave_EventScript_MarkedIvy {
    msgbox(format("Ivy climbs the rock here, its leaves marked with gold.\pAbove, on a ledge, something glints."), MSGBOX_SIGN)
}
