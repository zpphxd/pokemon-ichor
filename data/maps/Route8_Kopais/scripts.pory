// Route 8, the Kopais shore: beat 35A ("a trail of holes") and the road's roster.
// Text from design/phase3/SCRIPT.md: beat 35A, Part 2 (Route 8), Part 3 (Route 8's
// trainers) and Part 4 (the Enigmaw). Layout and events are generated by
// tools/ichor/maps/kopais.py; the tileset by tools/ichor/art/kopais_build.py.
//
// Staging (map coordinates, x 0 at Lebadeia, 63 at Thyrsa): the road enters from
// Thyrsa's Neistan Gate on rows 14-15 and leaves for Lebadeia on rows 12-13.
// Alethea's five notes run east to west: by the east sign (54,13), on the dike
// (35,14), at the foot of the Sphinx's rocks (23,19), on the reed-boat shore
// looking at Gla (12,6), at the west sign (6,11). The great herm (24,14) stands
// at the spur fork; the goat path climbs to the Sphinx's ledge (23-25, 24-25)
// and comes back down east over three ledges to the eel-smoker's fire.
//
// Stubs, by tag:
//   ICHOR_STUB_DIG   the daily dig spots (notes 1 and 2, Onchestos, the Sphinx's
//                    ledge) and the fixed finds (the Treasury of Minyas
//                    FLAG_ICHOR_DIG_FIXED_START + 0x10, Gla + 0x11) show their text
//                    until the dig API lands (ENGINE_API.md section 8).
//   ICHOR_STUB_TMS   the Treasury's item ball holds TM Rock Tomb (ITEM_TM_ROCK_TOMB)
//                    as a stand-in for TM Ancient Power, which Balance hasn't numbered.
//   ICHOR_STUB_AETHOS_DEX  Enigmaw and the trainers' species are stand-ins.

mapscripts Route8_Kopais_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(Route8_Kopais_EventScript_PlaceEnigmaw)
    }
}

// The Enigmaw sits on the Sphinx's ledge by day (morning, day and evening) and is
// gone at night; caught or beaten, it's gone for good. Its object's flag is a temp
// flag, set here each time the map loads.
script Route8_Kopais_EventScript_PlaceEnigmaw {
    setflag(FLAG_TEMP_11)
    if (!flag(FLAG_ICHOR_ROUTE8_ENIGMAW)) {
        gettimeofday
        if (var(VAR_0x8000) != TIME_NIGHT) {
            clearflag(FLAG_TEMP_11)
        }
    }
}

text Route8_Kopais_Text_SpeakerGorgidas { "GORGIDAS" }
text Route8_Kopais_Text_SpeakerIsmenias { "ISMENIAS" }
text Route8_Kopais_Text_SpeakerTimoxena { "TIMOXENA" }
text Route8_Kopais_Text_SpeakerPerses { "PERSES" }
text Route8_Kopais_Text_SpeakerEuphrosyne { "EUPHROSYNE" }
text Route8_Kopais_Text_SpeakerEelSmoker { "EEL-SMOKER" }
text Route8_Kopais_Text_SpeakerTraveler { "TRAVELER" }
text Route8_Kopais_Text_SpeakerBoy { "BOY" }

// --- Alethea's notes (beat 35A) -------------------------------------------------------

script Route8_Kopais_EventScript_Note1 {
    msgbox(format("A neat hole, filled back in. A note is pinned to a reed.\p"
                  "“DUG HERE. A BUTTON. NOT EVEN A NICE ONE. -A”"), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_Note2 {
    msgbox(format("“DUG HERE. AN EEL. IT BIT ME. I PUT IT BACK. -A”"), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_Note3 {
    msgbox(format("“DID NOT DIG HERE. A SIGN SAYS A SPHINX LIVES UP THERE.\p"
                  "I DON'T ANSWER RIDDLES. I DIG UNDER THEM. -A”"), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_Note4 {
    msgbox(format("“CAN'T REACH THE ISLAND. THERE'S A WALL ON IT. OLD. YOU TRY. -A”"), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_Note5 {
    msgbox(format("“LEBADEIA. WAITING AT THE SPRINGS. BRING BREAD. -A”"), MSGBOX_SIGN)
    setflag(FLAG_ICHOR_READ_ALETHEA_NOTES)
}

// --- Dig spots (ICHOR_STUB_DIG) ---------------------------------------------------------
// The daily spots become, when the dig API lands:
//     setvar(VAR_0x8004, <daily spot index from the world-act2 session>)
//     setvar(VAR_0x8005, ICHOR_DIG_ACT_II)
//     goto(EventScript_IchorDigSpot)
// Notes 1 and 2's spots are already dug and flattened on the first visit (SYSTEMS.md
// section 5): the API's first-visit state, or a flag set by the dig API itself.

script Route8_Kopais_EventScript_DigEast {
    msgbox(format("Someone has dug here and flattened the earth again. Neatly."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_DigDike {
    msgbox(format("Someone has dug between the paving and flattened the earth again."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_DigOnchestos {
    msgbox(format("The earth by the racing post has been turned. Something might be buried."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_DigSphinx {
    msgbox(format("Grit has been scraped up on the ledge. Something might be under it."), MSGBOX_SIGN)
}

// The fixed finds become:
//     setvar(VAR_0x8004, 0x10)            // the Treasury of Minyas; Gla is 0x11
//     setvar(VAR_0x8005, <the find>)      // an Ostrakon ("ORCHOMENOS. You know what you
//                                         // did."); Gla's is ITEM_RARE_BONE
//     goto(EventScript_IchorDigFixed)
script Route8_Kopais_EventScript_DigTreasury {
    if (flag(FLAG_ICHOR_DIG_FIXED_START+0x10)) {
        msgbox(format("The floor here has been dug up and put back."), MSGBOX_SIGN)
    } else {
        msgbox(format("The tomb's floor is soft here, as if something was buried and left."), MSGBOX_SIGN)
    }
}

script Route8_Kopais_EventScript_DigGla {
    if (flag(FLAG_ICHOR_DIG_FIXED_START+0x11)) {
        msgbox(format("The ground inside the wall has been dug up and put back."), MSGBOX_SIGN)
    } else {
        msgbox(format("The ground inside the old wall is soft. Something might be buried."), MSGBOX_SIGN)
    }
}

// --- People -------------------------------------------------------------------------------

// The eel-smoker: the road's rest point.
script Route8_Kopais_EventScript_EelSmoker {
    lock
    faceplayer
    setspeaker(Route8_Kopais_Text_SpeakerEelSmoker)
    msgbox(format("Sit. Eel. Don't argue."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    fadescreen(FADE_FROM_BLACK)
    setspeaker(Route8_Kopais_Text_SpeakerEelSmoker)
    msgbox(format("Kopais eels. The fat ones go to Astyra, for rich men's fingers."))
    setspeaker(Route8_Kopais_Text_SpeakerEelSmoker)
    msgbox(format("These are the thin ones. They're better. Don't tell Astyra."))
    release
}

// The traveler with a pack, by the herm: a theoxenia decoy (SYSTEMS.md section 10).
// He has a shadow, and a follower ignores him. His flag is the decoy's,
// FLAG_ICHOR_THEOXENIA_START+0x22 (BUILD.md's index block).
script Route8_Kopais_EventScript_Traveler {
    lock
    faceplayer
    setspeaker(Route8_Kopais_Text_SpeakerTraveler)
    msgbox(format("Is there water anywhere on this road that isn't marsh?"))
    setspeaker(Route8_Kopais_Text_SpeakerTraveler)
    msgbox(format("I tried the lake. It tastes like an eel's bathwater."))
    checkitem(ITEM_FRESH_WATER)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("Give him Fresh Water?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            removeitem(ITEM_FRESH_WATER)
            setspeaker(Route8_Kopais_Text_SpeakerTraveler)
            msgbox(format("Gods bless you. Here. It's all I've got that isn't eel."))
            giveitem(ITEM_BARLEY_CAKE)
            if (var(VAR_RESULT) == FALSE) {
                additem(ITEM_FRESH_WATER)
                goto(Common_EventScript_ShowBagIsFull)
            }
            setvar(VAR_0x8004, ICHOR_GOD_ZEUS)
            setvar(VAR_0x8005, 1)
            special(Ichor_AddFavor)
            setflag(FLAG_ICHOR_THEOXENIA_START+0x22)
            // He goes on his way: hidden from now on by the decoy flag.
            closemessage
            removeobject(LOCALID_ROUTE8_TRAVELER)
            release
            end
        }
    }
    setspeaker(Route8_Kopais_Text_SpeakerTraveler)
    msgbox(format("No, no. I'll find a spring. Thyrsa can't be far. Or can it."))
    release
}

// The reed-boat boy, sitting in his boat pulled up on the shore near Gla.
script Route8_Kopais_EventScript_ReedBoatBoy {
    lock
    faceplayer
    setspeaker(Route8_Kopais_Text_SpeakerBoy)
    msgbox(format("That's Gla. The wall goes all the way round. Nobody knows who built it."))
    setspeaker(Route8_Kopais_Text_SpeakerBoy)
    msgbox(format("My uncle swam out once. He says there's a door, and no handle."))
    setspeaker(Route8_Kopais_Text_SpeakerBoy)
    msgbox(format("My uncle says a lot of things."))
    release
}

// The Enigmaw on the Sphinx's ledge (SCRIPT.md Part 4): by day, Lv 30.
script Route8_Kopais_EventScript_Enigmaw {
    lock
    faceplayer
    msgbox(format("A sphinx sits on the ledge with its paws crossed, watching you.\p"
                  "It doesn't ask you anything at all."))
    closemessage
    playmoncry(SPECIES_ENIGMAW, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_ENIGMAW, 30)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
        setflag(FLAG_ICHOR_ROUTE8_ENIGMAW)
        removeobject(LOCALID_ROUTE8_ENIGMAW)
    } elif (var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_ICHOR_ROUTE8_ENIGMAW)
        removeobject(LOCALID_ROUTE8_ENIGMAW)
        msgbox(format("The ledge is empty. A few feathers turn over in the wind."))
    }
    release
}

// --- Trainers (SCRIPT.md Part 3, levels 30-31) ---------------------------------------------

script Route8_Kopais_EventScript_Gorgidas {
    trainerbattle_single(TRAINER_ICHOR_GORGIDAS, Route8_Kopais_Text_GorgidasIntro, Route8_Kopais_Text_GorgidasDefeat)
    setspeaker(Route8_Kopais_Text_SpeakerGorgidas)
    msgbox(format("Kopais birds go to Astyra in cages. They sing better in the city."))
    setspeaker(Route8_Kopais_Text_SpeakerGorgidas)
    msgbox(format("I wouldn't. I'd sing worse."), MSGBOX_AUTOCLOSE)
}

text Route8_Kopais_Text_GorgidasIntro {
    format("Shh! I've got a net out. Battle quietly.")
}

text Route8_Kopais_Text_GorgidasDefeat {
    format("You scared off every bird on the lake. Well done.")
}

script Route8_Kopais_EventScript_Ismenias {
    trainerbattle_single(TRAINER_ICHOR_ISMENIAS, Route8_Kopais_Text_IsmeniasIntro, Route8_Kopais_Text_IsmeniasDefeat)
    setspeaker(Route8_Kopais_Text_SpeakerIsmenias)
    msgbox(format("A Kopais eel is worth a whole fish anywhere else."))
    setspeaker(Route8_Kopais_Text_SpeakerIsmenias)
    msgbox(format("Astyra pays in silver for them. Thyrsa pays in insults."), MSGBOX_AUTOCLOSE)
}

text Route8_Kopais_Text_IsmeniasIntro {
    format("Eels, eels, Kopais eels! The best in Aethos! Also, battle!")
}

text Route8_Kopais_Text_IsmeniasDefeat {
    format("Slippery. Like my stock.")
}

script Route8_Kopais_EventScript_Timoxena {
    trainerbattle_single(TRAINER_ICHOR_TIMOXENA, Route8_Kopais_Text_TimoxenaIntro, Route8_Kopais_Text_TimoxenaDefeat)
    setspeaker(Route8_Kopais_Text_SpeakerTimoxena)
    msgbox(format("The kingfishers nest out on Gla. Nobody can get to them. Lucky birds."), MSGBOX_AUTOCLOSE)
}

text Route8_Kopais_Text_TimoxenaIntro {
    format("You stepped on my decoy. That was my best decoy.")
}

text Route8_Kopais_Text_TimoxenaDefeat {
    format("And now you've stepped on me.")
}

script Route8_Kopais_EventScript_Perses {
    trainerbattle_single(TRAINER_ICHOR_PERSES, Route8_Kopais_Text_PersesIntro, Route8_Kopais_Text_PersesDefeat)
    setspeaker(Route8_Kopais_Text_SpeakerPerses)
    msgbox(format("My brother wrote me a whole poem about working. Very long."))
    setspeaker(Route8_Kopais_Text_SpeakerPerses)
    msgbox(format("I haven't read it. That's work."), MSGBOX_AUTOCLOSE)
}

text Route8_Kopais_Text_PersesIntro {
    format("I'm going to ask the oracle whether I really have to work.")
}

text Route8_Kopais_Text_PersesDefeat {
    format("That was a lot of effort. I'm going to need a sit.")
}

script Route8_Kopais_EventScript_Euphrosyne {
    trainerbattle_single(TRAINER_ICHOR_EUPHROSYNE, Route8_Kopais_Text_EuphrosyneIntro, Route8_Kopais_Text_EuphrosyneDefeat)
    setspeaker(Route8_Kopais_Text_SpeakerEuphrosyne)
    msgbox(format("Pan made his pipes out of a girl who turned into reeds."))
    setspeaker(Route8_Kopais_Text_SpeakerEuphrosyne)
    msgbox(format("I try not to think about that while I'm cutting."), MSGBOX_AUTOCLOSE)
}

text Route8_Kopais_Text_EuphrosyneIntro {
    format("Reeds for roofs, reeds for pipes, reeds for battles!")
}

text Route8_Kopais_Text_EuphrosyneDefeat {
    format("Ha! Cut down. Like a reed.")
}

// --- The great herm, signs, landmarks ------------------------------------------------------

// The great herm at the spur fork doubles as its sign (ENGINE_API.md section 4: a herm
// with its own line calls EventScript_IchorAnointHerm after it). Anointing it sets
// FLAG_ICHOR_HERMS_START + HERM_AETHOS_ROUTE_8.
script Route8_Kopais_EventScript_GreatHerm {
    lockall
    msgbox(format("A great herm, hung with reed garlands. Hermes's face, worn smooth.\p"
                  "“East: Thyrsa City. West: Lebadeia. Up: the Sphinx's rock. Mind it.”"))
    call(EventScript_IchorAnointHerm)
    releaseall
}

script Route8_Kopais_EventScript_SignEast {
    msgbox(format("ROUTE 8 · THE KOPAIS SHORE\p"
                  "East: Thyrsa City. West: Lebadeia and the road to Parnassos."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_SignDike {
    msgbox(format("THE DIKE OF THE MINYANS. They drained the lake. The lake came back."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_SignSphinx {
    msgbox(format("Here the Sphinx sat and asked her one riddle.\p"
                  "Everyone got it wrong, until somebody didn't. She took it very badly."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_SignTomb {
    msgbox(format("THE TREASURY OF MINYAS. A king so rich he built his gold a house."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_SignOnchestos {
    msgbox(format("ONCHESTOS. Here Atalanta raced for a husband, and lost.\p"
                  "She stopped three times, for three golden apples. She said it was worth it."), MSGBOX_SIGN)
}

script Route8_Kopais_EventScript_SignWest {
    msgbox(format("LEBADEIA. The oracle of Trophonios. Pilgrims, this way. Bring cakes."), MSGBOX_SIGN)
}
