@ Ichor: the Asclepeion's healer, in the same words as Ichor_EventScript_AsclepeionHealer.
gText_WouldYouLikeToRestYourPkmn::
	.string "Welcome to the Asclepeion.\p"
	.string "We tend tired Pokémon by the\n"
	.string "sacred spring.\p"
	.string "Shall we tend yours?$"

gText_IllTakeYourPkmn::
	.string "Rest them here a moment.$"

gText_RestoredPkmnToFullHealth::
